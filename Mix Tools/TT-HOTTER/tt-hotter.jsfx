// GENERIERT von build_hotter.py. Nicht von Hand aendern.
function hr_fnames() (
  tt_pb_fname(0, "Init");
  tt_pb_fname(1, "Classic OTT");
  tt_pb_fname(2, "OTT 30 Parallel");
  tt_pb_fname(3, "Gentle Glue");
  tt_pb_fname(4, "Master Polish");
  tt_pb_fname(5, "Drum Bus Punch");
  tt_pb_fname(6, "Bass Smash");
  tt_pb_fname(7, "Acid Squash");
  tt_pb_fname(8, "Vocal Upfront");
  tt_pb_fname(9, "Synth Hype");
  tt_pb_fname(10, "Air");
  tt_pb_fname(11, "Mid Push");
  tt_pb_fname(12, "Upward Only");
  tt_pb_fname(13, "Downward Only");
  tt_pb_fname(14, "Dirty OTT");
  tt_pb_fname(15, "Bass Body");
  tt_pb_fname(16, "Techno Kick Punch");
  tt_pb_fname(17, "Techno Rumble Bus");
  tt_pb_fname(18, "Hypnotic Tops");
  tt_pb_fname(19, "Warehouse Drums");
  tt_pb_fname(20, "Industrial Crush");
  tt_pb_fname(21, "Dub Techno Stabs");
  tt_pb_fname(22, "Techno Master");
);
// Preset-Kleber. Werksdaten kommen aus hr_fload (hr24, erzeugt).

// 0.6.0 (Codex C05): @gfx nimmt die Sperre atomar (Wert 2) und wartet dafuer hoechstens kurz, bis ein laufendes
// hr_params im Audio-Thread fertig ist. Laeuft die Grenze ab, geht es wie bisher weiter (nie haengen bleiben).
// 15.11.2026: hr_uilock/hr_uiunlock stehen jetzt in hr14_engine (hr_uithr in hr23 braucht sie vorher).

function hr_pbapplypv() local(n, ch) (
  hr_uilock();
  n = 1;
  ch = 0;
  while (n <= 62) (
    ch |= hr_slqg(n, hr_pv[n]);
    n += 1;
  );
  n = 0;
  while (n < 40) (
    hr_exp[n] = hr_px[n];
    n += 1;
  );
  hr_expp = hr_pv[hr_smode] >= 0.5;
  hr_focp = 0 - 1;
  hr_uiunlock();
  tt_sldirty = 1;
);

function hr_pbapply() local(n, ch, v) (
  hr_uilock();
  n = 1;
  ch = 0;
  while (n <= 62) (
    v = tt_pb_buf[n];   // 0.6.0 (Codex C06): Bereich aus hr_spec (hr_srng, generiert), ungueltig -> Vorgabe
    v = ((v > -1000000000 && v < 1000000000) ? max(hr_srng[n], min(hr_srng[64 + n], v)) : hr_srng[128 + n]);
    ch |= hr_slqg(n, v);
    n += 1;
  );
  n = 0;
  while (n < 40) (
    hr_exp[n] = tt_pb_buf[63 + n];
    n += 1;
  );
  hr_exprange();
  hr_expp = slider(hr_smode) >= 0.5;
  hr_focp = 0 - 1;
  hr_uiunlock();
  tt_sldirty = 1;
);

function hr_pbcapture() local(n) (
  hr_uilock();   // 15.11.2026 (Review Astra F1): Fokuswechsel in hr_params darf nicht dazwischenkommen
  hr_expnow ? hr_expsaveg(hr_foc);
  memset(tt_pb_buf, 0, hr_psw);
  tt_pb_buf[0] = 1;
  n = 1;
  while (n <= 62) (
    tt_pb_buf[n] = slider(n);
    n += 1;
  );
  n = 0;
  while (n < 40) (
    tt_pb_buf[63 + n] = hr_exp[n];
    n += 1;
  );
  hr_uiunlock();
);

function hr_pbinit() (
  hr_fload(0);
  hr_pbapplypv();
);

function hr_pbsum() local(s, n) (
  s = 0;
  n = 1;
  while (n <= 62) (
    s += slider(n) * n;
    n += 1;
  );
  n = 0;
  while (n < 40) (
    s += hr_exp[n] * (n + 3);
    n += 1;
  );
  s;
);

function hr_pbverify() local(n, bad) (
  hr_uilock();
  n = 1;
  bad = 0;
  while (n <= 62) (
    (abs(slider(n) - hr_pv[n]) > 0.0001 ? (
      hr_slqg(n, hr_pv[n]);
      bad += 1;
    ));
    n += 1;
  );
  n = 0;
  while (n < 40) (
    hr_exp[n] = hr_px[n];
    n += 1;
  );
  hr_uiunlock();
  bad ? tt_sldirty = 1;
);
// @init-Anweisungen. @init laeuft auch bei Transportstart. 0.6.0 (Codex C03): der Audiozustand wird jedes Mal
// geleert, weil ttsp_init die Eingangsringe und den Schreibzeiger ebenfalls jedes Mal zuruecksetzt (sonst lieferten
// alte OLA-Zellen Audio des vorigen Laufs). Analyzer-Mittel nur beim ersten Mal und bei Sampleratenwechsel.

pdc_bot_ch = 0;
pdc_top_ch = 2;

hr_first = hr_ini1 != 1;
hr_azrst = hr_first || srate != hr_srst;
hr_rst = 1;
hr_ini1 != 1 ? hr_ini1 = 1;

hr_filltaps();
tt_pb_init(hr_nfac, 32, hr_end, hr_psw);
hr_fnames();

hr_rst ? (
  hr_srst = srate;
  memset(hr_ola, 0, 10 * hr_olas);
  memset(hr_sco, 0, 10 * hr_olas);
  memset(hr_env, 0, 10);
  memset(hr_hb, 0, 520);
  memset(hr_pp, 0, 768);
  hr_ppn = 0;
  memset(hr_cdl, 0, 512);
  memset(hr_prs, 0, 10);
  hr_kz0 = 0; hr_kz1 = 0; hr_kz2 = 0; hr_kz3 = 0;   // 0.9.9 (Argon P1): Hochpass-Zustaende der AUTO-GAIN-Messung
  memset(hr_lim, 0, 2 * hr_lrw);
  memset(hr_tpb, 0, 4 * hr_tpn);
  memset(hr_met, 0, 56);
  memset(hr_lst, 0, 40);
  hr_j = 0;
  while (hr_j < 2 * hr_lrw) (
    (hr_lim + 2 * hr_lrw)[hr_j] = 1;
    hr_j += 1;
  );
  hr_j = 0;
  while (hr_j < 5) (
    (hr_lst + hr_j * 8)[0] = 0 - 200;
    (hr_lst + hr_j * 8)[1] = 0 - 200;
    hr_j += 1;
  );
  hr_cw = 0;
  hr_jdo = 24;
  hr_hpos = 0;
  hr_xf = 1;
  hr_armed = 0;
  hr_lsg = 0;
  hr_wsr = 0;
  hr_agI = 0;
  hr_agW = 0;
  hr_agG = 0;
  hr_agAm = 0;
  hr_lgn = 1;
  hr_lgf = 1;
  hr_lgs = 1;
  hr_lsum = 0;
  hr_lw = 0;
  hr_tpi = 0;
  hr_tpm = 0;
  hr_lonwas = 0;
  hr_tpa = 0;
  hr_lmn = 1;
  hr_hbclr = 1;
  hr_scu = 0;
  hr_usesc = 0;
  hr_ones = 0;
  hr_wready = 0;
  hr_wa = hr_wt;
  hr_wbld = hr_wtb;
  hr_azrst ? hz_clear();
);
hz_setup();

hr_first ? (
  hr_snapall(1);
  hr_focp = floor(slider(hr_sfoc) + 0.5);
  hr_expp = slider(hr_smode) >= 0.5;
);

ttsp_init(400000);
hr_params();
pdc_delay = hr_pdc;

hr_rst ? (
  hr_lsum = hr_lbn;   // 0.6.0 (Codex C09): Historie steht auf 1, die Summe muss dazu passen (0.9.9: Boxlaenge hr_lbn)
  hr_lgn = 1;
  hr_lgf = 1;
  hr_lgs = 1;
  hr_scu = hr_scm >= 1;   // 15.11.2026: Start mit EXT/LISTEN, alle Rahmen sind Sidechain-Rahmen, keine Wartezeit
  hr_scw = 0;
  hr_ia = hr_iaT;
  hr_oa = hr_oaT;
  hr_mix = hr_mixT;
  hr_bx = hr_bxT;
  hr_drvS = hr_drvT;
  hr_j = 0;
  while (hr_j < 5) (
    hr_smt[hr_j] = hr_smt[5 + hr_j];
    hr_bon[hr_j] = hr_bon[5 + hr_j];
    hr_j += 1;
  );
);
@slider
hr_params();
@block
tt_sldirty ? (
  tt_sldirty = 0;
  hr_params();
);
srate != hr_wsr ? hr_params();
@sample
// spl0/spl1 Programm, spl2/spl3 Sidechain. Detektor sieht das Band hr_lan Samples
// frueher als der Hoerweg. Dry bleibt L/R und ohne IN GAIN.

hr_x0 = (spl0 > -1000000 && spl0 < 1000000) ? spl0 : 0;
hr_x1 = (spl1 > -1000000 && spl1 < 1000000) ? spl1 : 0;
hr_s2 = (spl2 > -1000000 && spl2 < 1000000) ? spl2 : 0;
hr_s3 = (spl3 > -1000000 && spl3 < 1000000) ? spl3 : 0;

hr_ia += (hr_iaT - hr_ia) * hr_smc;
abs(hr_iaT - hr_ia) < 0.000001 ? hr_ia = hr_iaT;
hr_oa += (hr_oaT - hr_oa) * hr_smc;
abs(hr_oaT - hr_oa) < 0.000001 ? hr_oa = hr_oaT;
hr_mix += (hr_mixT - hr_mix) * hr_smc;
abs(hr_mixT - hr_mix) < 0.000001 ? hr_mix = hr_mixT;
hr_bx += (hr_bxT - hr_bx) * hr_bxc;
abs(hr_bxT - hr_bx) < 0.000001 ? hr_bx = hr_bxT;
hr_drvS += (hr_drvT - hr_drvS) * hr_bxc;
abs(hr_drvT - hr_drvS) < 0.000001 ? hr_drvS = hr_drvT;

hr_usesc = hr_scm >= 1;
// 15.11.2026 (Review Astra F3 + grok-bot F1): bei jedem Wechsel leeren und den laufenden Hop ohne Sidechain zu Ende
// rechnen (sonst fuellen seine Jobs den geleerten Ring wieder). Nach dem Einschalten liegen im Ring erst nach
// 2 * (hr_n + hr_span) Samples volle Sidechain-Rahmen; bis dahin hoert der Detektor das Programm (wie OFF), statt
// Stille zu sehen und UPWARD bis UP MAX anzuheben. hr_take raeumt die Sidechain-Zellen dabei weiter ab.
(hr_scu !== hr_usesc) ? (
  memset(hr_sco, 0, 10 * hr_olas);
  hr_scjob = 0;
  hr_scw = hr_usesc ? 2 * hr_n + 2 * hr_span : 0;
);
hr_scu = hr_usesc;
hr_scw > 0 ? hr_scw -= 1;

ttsp_feed(hr_x0, hr_x1, hr_s2, hr_s3);
(ttsp_wr & 1023) == 0 ? (
  hr_hpos = ttsp_wr;
  hr_jdo = 0;
  hr_wready ? (   // 0.6.0 (Codex C04): neue Weichengewichte nur zwischen zwei Rahmen
    hr_wsw = hr_wa; hr_wa = hr_wbld; hr_wbld = hr_wsw; hr_wready = 0;
  );
);
(ttsp_wr - hr_hpos) == hr_jdo * hr_jstep && hr_jdo < hr_nj ? (
  hr_job(hr_jdo);
  hr_jdo += 1;
);

hr_rp = hr_ring(hr_n + hr_span + hr_lan);
hr_dry0 = TTSP_INL[hr_rp];
hr_dry1 = TTSP_INR[hr_rp];
hr_scL = TTSP_ISL[hr_rp];
hr_rsc = TTSP_ISR[hr_rp];

hr_w0 = 0;
hr_w1 = 0;
hr_sb0 = 0;
hr_sb1 = 0;
hr_j = 0;
while (hr_j < 5) (
  // 0.9.9 (Argon P9): Detektor-Vorlauf je Band (hr_lab, hoechstens halbe Attack). LOOKAHEAD 0 = wie bisher.
  hr_dp = hr_ring(hr_n + hr_span + hr_lan - hr_lab[hr_j]);
  (hr_usesc ? (
    // Sidechain-Ring: lesen am Detektorpunkt, raeumen am Hoerpunkt (aeltester Lesepunkt, wie der Programm-Ring).
    hr_d0 = hr_peek(hr_sco + hr_j * 2 * hr_olas, hr_dp) * hr_ia;
    hr_d1 = hr_peek(hr_sco + hr_j * 2 * hr_olas + hr_olas, hr_dp) * hr_ia;
    hr_take(hr_sco + hr_j * 2 * hr_olas, hr_rp);
    hr_take(hr_sco + hr_j * 2 * hr_olas + hr_olas, hr_rp);
    hr_scw > 0 ? (
      hr_d0 = hr_peek(hr_ola + hr_j * 2 * hr_olas, hr_dp) * hr_ia;
      hr_d1 = hr_peek(hr_ola + hr_j * 2 * hr_olas + hr_olas, hr_dp) * hr_ia;
    );
  ) : (
    hr_d0 = hr_peek(hr_ola + hr_j * 2 * hr_olas, hr_dp) * hr_ia;
    hr_d1 = hr_peek(hr_ola + hr_j * 2 * hr_olas + hr_olas, hr_dp) * hr_ia;
  ));
  hr_a0 = hr_take(hr_ola + hr_j * 2 * hr_olas, hr_rp) * hr_ia;
  hr_a1 = hr_take(hr_ola + hr_j * 2 * hr_olas + hr_olas, hr_rp) * hr_ia;
  (hr_msm ? (
    hr_t0 = (hr_d0 + hr_d1) * hr_msf;
    hr_d1 = (hr_d0 - hr_d1) * hr_msf;
    hr_d0 = hr_t0;
    hr_t0 = (hr_a0 + hr_a1) * hr_msf;
    hr_a1 = (hr_a0 - hr_a1) * hr_msf;
    hr_a0 = hr_t0;
  ));
  hr_rb = hr_res + hr_j * hr_resw;
  hr_rbo = hr_reso + hr_j * hr_resw;
  hr_p0 = hr_d0 * hr_d0;
  hr_p1 = hr_d1 * hr_d1;
  // 0.9.9 (Argon P5/P2): Vorglaettung der Leistung (RMS-Mittelung bzw. Bass-Welligkeit), Koeffizient 1 = aus.
  hr_pc = hr_pcf[hr_j];
  (hr_pc < 1 ? (
    hr_ps = hr_prs + hr_j * 2;
    hr_ps[0] += hr_pc * (hr_p0 - hr_ps[0]);
    hr_ps[1] += hr_pc * (hr_p1 - hr_ps[1]);
    hr_p0 = hr_ps[0];
    hr_p1 = hr_ps[1];
  ));
  hr_pl = (hr_det ? max(hr_p0, hr_p1) : 0.5 * (hr_p0 + hr_p1));
  hr_ef = hr_env + hr_j * 2;
  hr_cf = hr_ecf + hr_j * 2;
  hr_lb = hr_lst + hr_j * 8;

  // 0.9.9 (Argon P2): Release unter der Upward-Schwelle gebremst (bis Faktor 0,35), Upward steigt in Pausen sanft.
  hr_pu = hr_pup[hr_j];
  hr_dd = hr_lk * hr_pl + (1 - hr_lk) * hr_p0;
  hr_ev = hr_ef[0];
  hr_ev += (hr_dd > hr_ev ? hr_cf[0] : hr_cf[1] * (0.35 + 0.65 * hr_ev / (hr_ev + hr_pu))) * (hr_dd - hr_ev);
  hr_ev = (hr_ev > hr_e30 ? hr_ev : 0);
  hr_ef[0] = hr_ev;
  hr_E = 10 * log10(max(hr_ev, hr_e20));
  hr_lb[0] = hr_E;
  hr_updn(hr_rb, hr_E);
  hr_G = max(hr_rb[7], hr_rb[10] + hr_up - hr_dn);
  (hr_xf < 1 ? (
    hr_updn(hr_rbo, hr_E);
    hr_Go = max(hr_rbo[7], hr_rbo[10] + hr_up - hr_dn) + hr_rbo[14];
    hr_G = hr_Go + (hr_G - hr_Go) * hr_xf;
  ));
  hr_lb[6] = hr_G;
  hr_g0 = 10 ^ (hr_G * 0.05);

  hr_dd = hr_lk * hr_pl + (1 - hr_lk) * hr_p1;
  hr_ev = hr_ef[1];
  hr_ev += (hr_dd > hr_ev ? hr_cf[0] : hr_cf[1] * (0.35 + 0.65 * hr_ev / (hr_ev + hr_pu))) * (hr_dd - hr_ev);
  hr_ev = (hr_ev > hr_e30 ? hr_ev : 0);
  hr_ef[1] = hr_ev;
  // 0.9.9 (Argon P3): gleiche Huellkurve wie Kanal 0 (LINK 100 %, Mono) ohne laufende Blende -> gleicher Gewinn, bitgleich.
  ((hr_ev === hr_ef[0] && hr_xf >= 1) ? (
    hr_lb[1] = hr_lb[0];
    hr_lb[7] = hr_lb[6];
    hr_g1 = hr_g0;
  ) : (
    hr_E = 10 * log10(max(hr_ev, hr_e20));
    hr_lb[1] = hr_E;
    hr_updn(hr_rb, hr_E);
    hr_G = max(hr_rb[7], hr_rb[10] + hr_up - hr_dn);
    (hr_xf < 1 ? (
      hr_updn(hr_rbo, hr_E);
      hr_Go = max(hr_rbo[7], hr_rbo[10] + hr_up - hr_dn) + hr_rbo[15];
      hr_G = hr_Go + (hr_G - hr_Go) * hr_xf;
    ));
    hr_lb[7] = hr_G;
    hr_g1 = 10 ^ (hr_G * 0.05);
  ));
  // 0.9.9 (Argon P10): im M/S-Betrieb hebt SUB die Seite nie ueber die Mitte (Sub bleibt mono).
  ((hr_msm && hr_j == 0) ? hr_g1 = min(hr_g1, hr_g0));

  hr_smt[hr_j] += (hr_smt[5 + hr_j] - hr_smt[hr_j]) * hr_smc;
  (abs(hr_smt[5 + hr_j] - hr_smt[hr_j]) < 0.000001 ? hr_smt[hr_j] = hr_smt[5 + hr_j]);
  hr_bon[hr_j] += (hr_bon[5 + hr_j] - hr_bon[hr_j]) * hr_smc;
  (abs(hr_bon[5 + hr_j] - hr_bon[hr_j]) < 0.000001 ? hr_bon[hr_j] = hr_bon[5 + hr_j]);

  hr_y0 = hr_a0 * hr_g0 * hr_smt[hr_j] * hr_bon[hr_j];
  hr_y1 = hr_a1 * hr_g1 * hr_smt[hr_j] * hr_bon[hr_j];
  hr_w0 += hr_y0;
  hr_w1 += hr_y1;
  // 0.9.9 (Argon P6): Sub-Anteil am Saettiger vorbei (SUB 50 %, LOW 25 %), linear und laufzeitgleich wieder dazu.
  (hr_j < 2 ? (
    hr_t0 = (hr_j == 0 ? 0.5 : 0.25);
    hr_sb0 += hr_t0 * hr_y0;
    hr_sb1 += hr_t0 * hr_y1;
  ));
  hr_mb = hr_met + hr_j * hr_metw;
  hr_mb[0] = hr_lb[0];
  hr_mb[1] = hr_lb[1];
  hr_mb[4] = hr_lb[6];
  hr_mb[5] = hr_lb[7];
  hr_j += 1;
);
// 0.3.1 (grok-Review F4): ungueltige Summe heilt die rueckgekoppelten Autogain-Zustaende, nicht nur den Ausgang.
(hr_w0 > -1000000 && hr_w0 < 1000000 && hr_w1 > -1000000 && hr_w1 < 1000000) ? 0 : (
  hr_w0 = 0; hr_w1 = 0;
  hr_agI = 0; hr_agW = 0; hr_agG = 0; hr_agAm = 0;
);
hr_xf < 1 ? hr_xf = min(1, hr_xf + hr_xfc);
hr_lsg = 1;

hr_msm ? (
  hr_t0 = (hr_w0 + hr_w1) * hr_msf;
  hr_w1 = (hr_w0 - hr_w1) * hr_msf;
  hr_w0 = hr_t0;
  hr_t0 = (hr_sb0 + hr_sb1) * hr_msf;
  hr_sb1 = (hr_sb0 - hr_sb1) * hr_msf;
  hr_sb0 = hr_t0;
);

hr_dwy0 = hr_cdelay(0, hr_w0);
hr_dwy1 = hr_cdelay(1, hr_w1);
hr_sbd0 = hr_cdelay(6, hr_sb0);   // 0.9.9 (Argon P6): Sub-Anteil, 48 Samples wie der Saettiger
hr_sbd1 = hr_cdelay(7, hr_sb1);
(hr_drvS > 0.000001 || hr_drvT > 0) ? (
  hr_kclip = 1 + 8 * max(hr_drvS, 0.0001);
  hr_c0 = hr_clipch(0, hr_w0 - hr_sb0, hr_kclip) + hr_sbd0;
  hr_c1 = hr_clipch(1, hr_w1 - hr_sb1, hr_kclip) + hr_sbd1;
  hr_ppn += 1;
  hr_ppn >= 1024 ? hr_ppn = 0;
  hr_hbclr = 0;
) : (
  hr_hbclr ? 0 : ( memset(hr_pp, 0, 768); hr_ppn = 0; hr_hbclr = 1; );
  hr_c0 = hr_dwy0;
  hr_c1 = hr_dwy1;
);
hr_w0 = hr_dwy0 + hr_drvS * (hr_c0 - hr_dwy0);
hr_w1 = hr_dwy1 + hr_drvS * (hr_c1 - hr_dwy1);
hr_dry0 = hr_cdelay(2, hr_dry0);
hr_dry1 = hr_cdelay(3, hr_dry1);
hr_scL = hr_cdelay(4, hr_scL);
hr_rsc = hr_cdelay(5, hr_rsc);

// 0.6.0 (Codex C01): Eingangsleistung aus dem verzoegerten Trockenweg (hr_dry, gleiche Lesestelle wie der Nassweg),
// sonst sieht AUTO GAIN nach Stille bis zu 5120 Samples Eingang ohne Ausgang und hebt den Pegel an.
// 0.9.9 (Argon P1): Messung HINTER DRIVE (gleicht den Pegelverlust der Saettigung aus, wie MODEL.md sagt) und
// beide Seiten durch einen Hochpass 120 Hz (Sub-Kick bestimmt die Messung nicht mehr). Trockenweg und Nassweg sind
// hier beide um die 48 Samples der Saettigung verzoegert.
hr_t0 = hr_dry0 * hr_ia;
hr_kz0 = hr_t0 + hr_kwc * (hr_kz0 - hr_t0);
hr_t0 -= hr_kz0;
hr_t1 = hr_dry1 * hr_ia;
hr_kz1 = hr_t1 + hr_kwc * (hr_kz1 - hr_t1);
hr_t1 -= hr_kz1;
hr_pin = 0.5 * (hr_t0 * hr_t0 + hr_t1 * hr_t1);
hr_kz2 = hr_w0 + hr_kwc * (hr_kz2 - hr_w0);
hr_t0 = hr_w0 - hr_kz2;
hr_kz3 = hr_w1 + hr_kwc * (hr_kz3 - hr_w1);
hr_t1 = hr_w1 - hr_kz3;
hr_pwe = 0.5 * (hr_t0 * hr_t0 + hr_t1 * hr_t1);
hr_agI += hr_aga * (hr_pin - hr_agI);
hr_agW += hr_aga * (hr_pwe - hr_agW);
hr_agfrz = hr_solo || (hr_bon[5] + hr_bon[6] + hr_bon[7] + hr_bon[8] + hr_bon[9] < 0.5) || (hr_agI < 0.000000001 && hr_agW < 0.000000001);
// 15.11.2026 (Review grok-bot F2): hr_agG laeuft auch bei AUTO OFF mit, sonst blendet das Wiedereinschalten auf einen
// veralteten Korrekturwert. Hoerbar bleibt nur hr_agAm (folgt bei AUTO OFF der 0).
!hr_agfrz ? (
  hr_t0 = 10 * log10(hr_agI / max(hr_agW, hr_e30));
  hr_t0 = min(24, max(0 - 24, hr_t0));
  hr_agG += hr_agc * (hr_t0 - hr_agG);
);
hr_agAm += ((hr_agon ? hr_agG : 0) - hr_agAm) * hr_smc;
abs((hr_agon ? hr_agG : 0) - hr_agAm) < 0.000001 ? hr_agAm = (hr_agon ? hr_agG : 0);
hr_agAm != 0 ? (
  hr_agf = 10 ^ (hr_agAm * 0.05);
  hr_w0 *= hr_agf;
  hr_w1 *= hr_agf;
);

hr_cw += 1;
hr_cw >= 64 ? hr_cw = 0;

hr_scm == 2 ? (
  hr_o0 = hr_scL * hr_ia * hr_oa;
  hr_o1 = hr_rsc * hr_ia * hr_oa;
) : hr_dlta ? (
  hr_o0 = (hr_w0 - hr_dry0) * hr_oa;
  hr_o1 = (hr_w1 - hr_dry1) * hr_oa;
) : (
  hr_o0 = (hr_dry0 * (1 - hr_mix) + hr_w0 * hr_mix) * hr_oa;
  hr_o1 = (hr_dry1 * (1 - hr_mix) + hr_w1 * hr_mix) * hr_oa;
);
hr_o0 = hr_o0 * (1 - hr_bx) + hr_dry0 * hr_bx;
hr_o1 = hr_o1 * (1 - hr_bx) + hr_dry1 * hr_bx;

hr_ceil();

hr_o0 = (hr_o0 > -1000000 && hr_o0 < 1000000) ? hr_o0 : 0;
hr_o1 = (hr_o1 > -1000000 && hr_o1 < 1000000) ? hr_o1 : 0;
spl0 = hr_o0;
spl1 = hr_o1;

hr_met[40] = max(hr_met[40] * hr_mdc, abs(hr_x0));
hr_met[41] = max(hr_met[41] * hr_mdc, abs(hr_x1));
hr_met[42] = max(hr_met[42] * hr_mdc, abs(spl0));
hr_met[43] = max(hr_met[43] * hr_mdc, abs(spl1));
hr_met[44] = hr_lmn < 0.999999 ? 20 * log10(max(hr_lmn, hr_e20)) : 0;
hr_lmn = 1 - (1 - hr_lmn) * hr_mdc;   // 15.11.2026 (Review Astra F4, grok-bot N1): hr_mdc ist Haltefaktor, nicht Schrittweite
hr_met[45] = hr_agAm;
hr_met[46] = hr_pdc * 1000 / srate;

// Analyzer-Ringe (hr22). Vorher = Trockenweg (gleiche Verzoegerung bis vor die Decke), nachher = Ausgang.
hz_w = (hz_w + 1) & 4095;
hz_t = 0.5 * (hr_dry0 + hr_dry1);
hz_rpre[hz_w] = hz_t;
hz_rpost[hz_w] = 0.5 * (spl0 + spl1);
hz_spa = max(hz_spa, abs(hz_t));
hz_spb = max(hz_spb, max(abs(spl0), abs(spl1)));
hz_sn += 1;
hz_sn >= hz_step ? (
  hz_sw = (hz_sw + 1) & 511;
  hz_spre[hz_sw] = hz_spa;
  hz_spost[hz_sw] = hz_spb;
  hz_spa = 0;
  hz_spb = 0;
  hz_sn = 0;
);
@serialize
// Version 1: 40 Expert-Worte (seit 0.3.0 tragen Wort 0/2 je Band die Bandschwellen in MACRO und EXPERT).
// Version 2 (0.3.0): + Zielkurve des BALANCE-Displays (hz_tsel), Merker hz_hasl, 192 Punkte der gelernten Kurve.
// Altstaende (Version 1) laden ohne Ziel. 0.3.1 (grok-Review F3): Werte nach dem Lesen auf ihren Bereich geklemmt
// (NaN/Inf -> Vorgabe), Zielwahl sauber gerundet, hr_loaded nur im Lesemodus.
hr_srd = file_avail(0) >= 0;
hr_sv = 2;
file_var(0, hr_sv);
hr_sv >= 1 ? (
  hr_j = 0;
  while (hr_j < 40) (
    file_var(0, hr_exp[hr_j]);
    hr_j += 1;
  );
);
hr_sv >= 2 ? (
  hr_tt = hz_tsel;
  hr_th = hz_hasl;
  file_var(0, hr_tt);
  file_var(0, hr_th);
  hr_j = 0;
  while (hr_j < 192) (
    file_var(0, hz_lrn[hr_j]);
    hr_j += 1;
  );
  hr_srd ? (
    hz_tsel = (hr_tt > -0.5 && hr_tt < 7.5) ? floor(hr_tt + 0.5) : 0;
    hz_hasl = hr_th > 0.5 ? 1 : 0;
  );
) : hr_srd ? (
  // Argon-Review B5: Altstand ohne Ziel -> Zielfelder zuruecksetzen statt Reste der laufenden Instanz zu behalten.
  hz_tsel = 0;
  hz_hasl = 0;
  memset(hz_lrn, 0, 192);
);
hr_srd ? (
  hr_exprange();
  hr_j = 0;
  while (hr_j < 192) (
    hr_v = hz_lrn[hr_j];
    hz_lrn[hr_j] = ((hr_v > -60.001 && hr_v < 60.001) ? hr_v : 0);   // 0.6.0 (Codex C08): Endpunkte +-60 gueltig
    hr_j += 1;
  );
  (hz_tsel == 7 && !hz_hasl) ? hz_tsel = 0;
  hz_learnon = 0;
  hr_expp = slider(hr_smode) >= 0.5;
  hr_loaded = 1;
);
tt_pb_serialize();
@gfx 1500 950

tth_pre();
tt_pb_pre();
tth_sync(slider63);
hr_sm0 = hr_pbsum();

uk_b1 = 30;   // 0.7.1: Schriftzug gross wie TT-HOTT (Zwillinge); vorher 22
uk_fsmax = 2;
uikit_begin(1200, 760);
uk_flat = 1;
uikit_ground2();
hr_zinit();   // 0.7.1: Bandfarben aus dem Schema-Akzent (wie TT-HOTT)

// 0.7.1: Kopf wie TT-HOTT: Schriftzug, darunter Produktart und Version. Historie: card(16, 6, 1168, 40), Schrift 22, vertag (168, 16).
card(16, 4, 1168, 50);
gfx_setfont(1);
colAcid(1);
xstr(26, 1, "TT-HOTTER");
gfx_setfont(5);
colDim(1);
xstr(28, 38, "5-BAND UP/DOWN COMPRESSOR");
tt_vertag(196, 39);

hr_uiseg(250, 10, 150, 24, hr_smode, slider(hr_smode), 2, "MACRO|EXPERT", "",
  "MACRO derives all 5 bands from the macro knobs. EXPERT edits the focused band. Returning to MACRO follows the macros again and does not fit them to the expert numbers.");
hr_uitg(410, 10, 62, 24, hr_sdelta, slider(hr_sdelta), "DELTA", "Output the wet signal minus the dry signal.");
hr_uitg(478, 10, 70, 24, hr_sbyp, slider(hr_sbyp), "BYPASS", "Bypass with the same latency.");

sprintf(#hr_ui3, "%.1f dB", hr_met[44]);
hr_uipill(558, 11, 74, 22, "LIM", #hr_ui3, hr_met[44] < -0.05);
tt_hov(558, 11, 74, 22, "Limiter reduction in dB. 0 means the ceiling is not reducing.");
slider(hr_sauto) >= 0.5 ? sprintf(#hr_ui3, "%+.1f dB", hr_met[45]) : strcpy(#hr_ui3, "OFF");
hr_uipill(638, 11, 78, 22, "AUTO", #hr_ui3, slider(hr_sauto) >= 0.5);
tt_hov(638, 11, 78, 22, "Autogain offset in dB. The switch sits in DETECTOR & ROUTING.");
sprintf(#hr_ui3, "%.1f ms", hr_met[46]);
hr_uipill(722, 11, 70, 22, "LAT", #hr_ui3, hr_met[46] > 0.05);
tt_hov(722, 11, 70, 22, "Plugin latency in milliseconds.");

hr_uiana(16, 58, 1168, 264);   // 0.7.1: 6 tiefer fuer den hoeheren Kopf (vorher 52, 270)

card(16, 328, 1168, 54);
hr_uiseg(28, 332, 108, 44, hr_sdet, slider(hr_sdet), 2, "RMS|PEAK", "DETECTOR", "RMS averages the band power over a few milliseconds and both channels; PEAK reacts with half the attack and takes the louder channel.");
hr_uiseg(144, 332, 104, 44, hr_sst, slider(hr_sst), 2, "L/R|M/S", "STEREO", "Left/right, or mid/side. The rings stay left and right.");
hr_uiseg(256, 332, 156, 44, hr_ssc, slider(hr_ssc), 3, "OFF|EXT|LISTEN", "SIDECHAIN", "OFF uses the input. EXT detects channels 3 and 4. LISTEN plays that sidechain.");
hr_uiseg(420, 332, 92, 44, hr_sauto, slider(hr_sauto), 2, "OFF|ON", "AUTO", "Slow level match, about 1.5 seconds, within plus or minus 24 dB.");
hr_uikn(552, 357, 11, hr_slink, slider(hr_slink), 0, 100, 100, 1, "LINK", "%.0f%%", "Detector link between the two channels, percent.");
hr_uikn(612, 357, 11, hr_sla, slider(hr_sla), 0, 10, 0, 0.1, "LOOK", "%.1f", "Lookahead in milliseconds, 0 to 10.");
hr_uikn(672, 357, 11, hr_sceil, slider(hr_sceil), -24, 0, 0, 0.1, "CEIL", "%.1f", "Output ceiling in dBFS. 0 keeps the limiter gain at unity. The delay stays.");
colBorder();
xrect(712, 336, 1, 40);
gfx_setfont(3);
colDim(0.85);
xstr(726, 336, "CROSSOVERS");
hr_uixkn(830, 357, 0);
hr_uixkn(890, 357, 1);
hr_uixkn(950, 357, 2);
hr_uixkn(1010, 357, 3);

hr_uiano = (slider(hr_ssolo) >= 0.5) || (slider(hr_ssolo + 1) >= 0.5) || (slider(hr_ssolo + 2) >= 0.5) || (slider(hr_ssolo + 3) >= 0.5) || (slider(hr_ssolo + 4) >= 0.5);
hr_uik = 0;
loop(5,
  hr_uicol(hr_uik, 16 + hr_uik * 234, 388, 228, 222);
  hr_uik += 1;
);

// Front 0.7.0 (15.11.2026): untere Reihe 136 hoch (vorher 154 mit leerem Kopf), Bandspalten dafuer 222 hoch.
slider(hr_smode) >= 0.5 ? (
  hr_uiexp(16, 616, 624, 136);
) : (
card(16, 616, 624, 136);
ukf_sec(28, 624, "MACRO DYNAMICS", "");
hr_uikn(66, 700, 24, hr_sdepth, slider(hr_sdepth), 0, 100, 25, 1, "DEPTH", "%.0f%%", "Macro depth in percent. 0 leaves the gain at unity before make-up.");
hr_uikn(146, 700, 24, hr_stime, slider(hr_stime), 25, 400, 100, 1, "TIME", "%.0f%%", "Scales attack and release. 100 is the nominal time. Range 25 to 400.");
hr_uikn(218, 704, 17, hr_sup, slider(hr_sup), 0, 200, 100, 1, "UP", "%.0f%%", "Upward amount in percent, scaled by DEPTH; it stops growing at 20:1, reached at UP x DEPTH of about 127 percent.");
hr_uikn(276, 704, 17, hr_sdn, slider(hr_sdn), 0, 200, 100, 1, "DOWN", "%.0f%%", "Downward amount in percent, scaled by DEPTH; it stops growing at a hard slope, reached at DOWN x DEPTH of about 118 percent.");
hr_uikn(334, 704, 17, hr_smkup, slider(hr_smkup), 0, 200, 100, 1, "MAKEUP", "%.0f%%", "Scales each band's macro make-up. 100 is the normal amount. Not a dB trim.");
gfx_setfont(3);
colDim(0.75);
xstr(376, 624, "5-BAND RESPONSE");
hr_uiresp(376, 640, 252, 104);
);

card(646, 616, 250, 136);
ukf_sec(658, 624, "CURVE & DRIVE", "");
hr_uikn(682, 704, 16, hr_sknee, slider(hr_sknee), 0, 100, 100, 1, "KNEE", "%.0f%%", "Soft-knee amount. 100 is the full macro knee.");
hr_uikn(732, 704, 16, hr_smax, slider(hr_smax), 0, 36, 24, 0.1, "UP MAX", "%.1f", "Caps the upward term in dB. Make-up is added after this cap.");
hr_uikn(782, 704, 16, hr_sdrv, slider(hr_sdrv), 0, 100, 0, 1, "DRIVE", "%.0f%%", "0 is a clean delay. Above 0 the tanh shaper is blended in by this amount.");
hr_uishaper(812, 640, 76, 104);

card(902, 616, 282, 136);
ukf_sec(914, 624, "MASTER", "");
hr_uikn(934, 704, 16, hr_sin, slider(hr_sin), -24, 24, 0, 0.1, "IN", "%+.1f", "Input trim in dB. It reaches the wet path and the detector, not the dry path.");
hr_uikn(984, 704, 16, hr_smix, slider(hr_smix), 0, 100, 100, 1, "MIX", "%.0f%%", "Dry/wet mix in percent.");
hr_uikn(1034, 704, 16, hr_sout, slider(hr_sout), -24, 24, 0, 0.1, "OUT", "%+.1f", "Output trim in dB.");

// Senkrechte LED-Meter: IN L/R, OUT L/R, Limiter-Reduktion (von oben, 0..12 dB).
hr_uivmeter(1066, 644, 12, 86, max(-60, hr_uidb(hr_met[40])), -60, 0, 0);
hr_uivmeter(1080, 644, 12, 86, max(-60, hr_uidb(hr_met[41])), -60, 0, 0);
hr_uivmeter(1102, 644, 12, 86, max(-60, hr_uidb(hr_met[42])), -60, 0, 0);
hr_uivmeter(1116, 644, 12, 86, max(-60, hr_uidb(hr_met[43])), -60, 0, 0);
