hr_px = hr_pv + 104;
hr_bdef = hr_px + 40;
hr_zcr = hr_bdef + 25;   // 0.7.1: Bandfarben R/G/B je 5 Worte (nur @gfx, hr_zinit)
hr_zcg = hr_zcr + 5;
hr_zcb = hr_zcg + 5;
hr_pp = hr_zcb + 5;      // 0.9.9 (Argon P3): Halbband-Ringe 2 Kanaele * 384 (U1 64, U2 64, D1 128, D2 128)
hr_prs = hr_pp + 768;    // 0.9.9 (Argon P2/P5): Detektor-Vorglaettung je Band und Kanal (10)
hr_pcf = hr_prs + 10;    // Koeffizient der Vorglaettung je Band (5), 1 = aus
hr_pup = hr_pcf + 5;     // Upward-Schwelle je Band als Leistung (5), Argon P2
hr_lab = hr_pup + 5;     // Detektor-Vorlauf je Band in Samples (5), Argon P9
hr_twh = hr_lab + 5;     // obere Flanke je Weiche in Hz (6), Argon P7
hr_end = hr_twh + 6;
// Bandvorgaben (Hygiene-Review B09): je Band 5 Worte: Up-Schwelle, Down-Schwelle, Attack ms, Release ms, Make-up dB.
// Tabelle statt Funktion hr_bdef[k * 5 + 0] usw.: deren Parameter k waere statisch und zwischen @gfx und Audio geteilt.
hr_bdfill();
hr_rngfill();   // generiert in hr06 aus hotter_dsp
// Klangkern. Formeln: MODEL.md und hotter_dsp.py (gemessen von hotter_check.py).

function hr_q(v, st) (
  floor(v / st + 0.5) * st;
);

// 0.6.0 (Codex C05): @gfx nimmt die Sperre atomar (Wert 2) und wartet dafuer hoechstens kurz, bis ein laufendes
// hr_params im Audio-Thread fertig ist. Laeuft die Grenze ab, geht es wie bisher weiter (nie haengen bleiben).
// 15.11.2026 aus hr27_preset hierher verlegt (Review Astra F1): auch hr_uithr und hr_pbcapture schreiben hr_exp.
function hr_uilock() local(i) (
  i = 0;
  while (atomic_setifequal(hr_lock, 0, 2) !== 0 && i < 2000000) (
    i += 1;
  );
  hr_lock = 2;
);
function hr_uiunlock() (
  atomic_set(hr_lock, 0);
);

// Weichengewichte, 5 * 4097. Summe je Bin = 1. Entspricht hotter_dsp.weights.
// 0.9.9 (Argon P7, Stufe A): Raised-Cosine ueber log(f), symmetrisch um die Weiche (-6 dB genau bei X). Die untere
// Flanke bleibt wie bis 0.7.1 (f - tw), die obere liegt log-symmetrisch bei f^2 / lo, hoechstens f + 0.45 * Abstand
// zur naechsten Weiche. Breitere Flanke = kuerzeres Vorschwingen (an X1 80 Hz: 44..145 statt 44..116 Hz). Summe = 1.
function hr_weights() local(i, j, b, hz, hold, lo, hi, a, x, gapl, gapr, tw) (
  hr_ft[0] = 0;
  hr_ft[1] = slider(hr_sx1);
  hr_ft[2] = slider(hr_sx2);
  hr_ft[3] = slider(hr_sx3);
  hr_ft[4] = slider(hr_sx4);
  hr_ft[5] = srate * 0.5;
  // Ordnung: jede Weiche mindestens Faktor 1.25 ueber der vorigen (hotter_dsp.XO_GAP). Faengt vertauschte Weichen ab.
  (hr_ft[1] < 1 ? hr_ft[1] = 1);
  i = 2;
  while (i < 5) (
    (hr_ft[i] < hr_ft[i - 1] * 1.25 ? hr_ft[i] = hr_ft[i - 1] * 1.25);
    i += 1;
  );
  (hr_ft[4] > srate * 0.5 / 1.25 ? hr_ft[4] = srate * 0.5 / 1.25);
  i = 4;
  while (i > 1) (
    (hr_ft[i] < hr_ft[i - 1] * 1.25 ? hr_ft[i - 1] = hr_ft[i] / 1.25);
    i -= 1;
  );
  i = 1;
  while (i < 5) (
    gapl = hr_ft[i] - hr_ft[i - 1];
    gapr = hr_ft[i + 1] - hr_ft[i];
    tw = min(min(max(40, hr_ft[i] * 0.35), 0.45 * gapl), 0.45 * gapr);
    (tw < 1 ? tw = 1);
    hr_tw[i] = tw;
    hr_twh[i] = min(hr_ft[i] * hr_ft[i] / (hr_ft[i] - tw), hr_ft[i] + 0.45 * gapr);
    i += 1;
  );
  j = 0;
  while (j < hr_wn) (
    hz = j * srate / hr_fft;
    hold = 1;
    b = 0;
    while (b < 4) (
      lo = hr_ft[b + 1] - hr_tw[b + 1];
      hi = hr_twh[b + 1];
      a = (hz <= lo ? 0 : (hz >= hi ? 1 : (
        x = log(hz / lo) / log(hi / lo);
        0.5 - 0.5 * cos(3.141592653589793 * x);
      )));
      (hr_wbld + b * hr_wn)[j] = hold * (1 - a);
      hold *= a;
      b += 1;
    );
    (hr_wbld + 4 * hr_wn)[j] = hold;
    j += 1;
  );
  hr_wready = 1;   // 0.6.0: in hr_wbld fertig, Tausch am naechsten Hop-Anfang (@sample)
);

function hr_applyw(fb, b) local(k, g, w) (
  w = hr_wa + b * hr_wn;
  fb[0] *= w[0];
  k = 1;
  while (k < 4096) (
    g = w[k];
    fb[2 * k] *= g;
    fb[2 * k + 1] *= g;
    k += 1;
  );
  fb[1] *= w[4096];
);

// Nur @gfx. Kein Aufruf anderer hr_-Funktionen (statische Locals, parallel zu @sample).
function hr_gdb(k, e) local(rb, z, w, up, dn) (
  rb = hr_res + k * hr_resw;
  w = rb[2];
  z = rb[0] - e;
  up = rb[1] * (w > 0 ? max(z, 0) + w * log(1 + exp(0 - abs(z) / w)) : max(z, 0));
  up = min(rb[3], up);
  e < -60 ? ( z = max(0, min(1, (e + 84) / 24)); up *= z * z * (3 - 2 * z); );   // 0.9.9 Argon P8, wie hr_updn
  w = rb[6];
  z = e - rb[4];
  dn = rb[5] * (w > 0 ? max(z, 0) + w * log(1 + exp(0 - abs(z) / w)) : max(z, 0));
  max(rb[7], rb[10] + up - dn);
);

function hr_updn(rb, e) local(z, w) (
  // 0.6.0 (Codex C13): Zweig mit Steigung 0 (oder UP MAX 0) rechnet kein exp/log.
  hr_up = 0;
  (rb[1] != 0 && rb[3] > 0) ? (
    w = rb[2];
    z = rb[0] - e;
    hr_up = rb[1] * (w > 0 ? max(z, 0) + w * log(1 + exp(0 - abs(z) / w)) : max(z, 0));
    hr_up = min(rb[3], hr_up);
    // 0.9.9 (Argon P8): unter -60 dB blendet Upward sanft aus (-72 dB halb, unter -84 dB 0). Kein Rausch-Hochziehen
    // in Pausen, kein voll aufgerissenes Band beim ersten Schlag nach Stille. Ab -60 dB unveraendert.
    e < -60 ? ( z = max(0, min(1, (e + 84) / 24)); hr_up *= z * z * (3 - 2 * z); );
  );
  hr_dn = 0;
  rb[5] != 0 ? (
    w = rb[6];
    z = e - rb[4];
    hr_dn = rb[5] * (w > 0 ? max(z, 0) + w * log(1 + exp(0 - abs(z) / w)) : max(z, 0));
  );
);

// full = 1: auch die Bandschwellen setzen (Erst-Init). Beim Wechsel nach EXPERT bleiben sie (0.3.0: Schwellen je Band
// gelten in MACRO und EXPERT, einstellbar in den Bandspalten).
function hr_snapall(full) local(k, d, tm, u, dn, eb, s) (
  d = max(0, min(1, slider(hr_sdepth) * 0.01));
  tm = max(0.25, slider(hr_stime) * 0.01);
  u = max(0, slider(hr_sup) * 0.01) * d;
  dn = max(0, slider(hr_sdn) * 0.01) * d;
  k = 0;
  while (k < 5) (
    eb = hr_exp + k * hr_expw;
    (full ? eb[0] = hr_q(hr_bdef[k * 5 + 0], 0.1));
    s = min(0.95, 0.75 * u);
    eb[1] = hr_q(s >= 0.95 ? 20 : (s <= 0.0001 ? 1 : 1 / (1 - s)), 0.01);
    (full ? eb[2] = hr_q(hr_bdef[k * 5 + 1], 0.1));
    s = min(1, dn * 0.85);
    eb[3] = hr_q(s >= 0.999 ? 1000 : (s <= 0.0001 ? 1 : 1 / (1 - s)), 0.01);
    eb[4] = hr_q(hr_bdef[k * 5 + 2] * tm, 0.1);
    eb[5] = hr_q(hr_bdef[k * 5 + 3] * tm, 1);
    eb[6] = hr_q(d * hr_bdef[k * 5 + 4] * slider(hr_smkup) * 0.01, 0.1);
    k += 1;
  );
);

function hr_expsave(k) local(eb) (
  eb = hr_exp + k * hr_expw;
  eb[0] = slider(hr_se0);
  eb[1] = slider(hr_se0 + 1);
  eb[2] = slider(hr_se0 + 2);
  eb[3] = slider(hr_se0 + 3);
  eb[4] = slider(hr_se0 + 4);
  eb[5] = slider(hr_se0 + 5);
  eb[6] = slider(hr_se0 + 6);
);

function hr_slq(n, v) (
  abs(slider(n) - v) > 0.0000001 ? (
    slider(n) = v;
    slider_automate(2 ^ (n - 1));
    1;
  ) : 0;
);

// 0.3.1 (grok-Review F5): Funktionsparameter und local() sind in EEL2 statisch und zwischen den Threads geteilt.
// hr_slq/hr_expsave laufen im Audio-Thread (hr_params, hr_expload); @gfx (Preset-Kleber hr27) nimmt diese Kopien.
function hr_slqg(n, v) (
  abs(slider(n) - v) > 0.0000001 ? (
    slider(n) = v;
    slider_automate(2 ^ (n - 1));
    1;
  ) : 0;
);
function hr_expsaveg(k) local(eb) (
  eb = hr_exp + k * hr_expw;
  eb[0] = slider(hr_se0);
  eb[1] = slider(hr_se0 + 1);
  eb[2] = slider(hr_se0 + 2);
  eb[3] = slider(hr_se0 + 3);
  eb[4] = slider(hr_se0 + 4);
  eb[5] = slider(hr_se0 + 5);
  eb[6] = slider(hr_se0 + 6);
);

// 0.3.1 (grok-Review F3): Expert-Worte nach dem Laden auf ihren Bereich pruefen; NaN/Inf/ausserhalb -> Vorgabe des Bands.
// Grenzabfrage nur mit > und < (NaN ist dort falsch, Leitfaden). Wort 7 ist unbenutzt und wird 0.
function hr_exprange() local(k, eb, v) (
  k = 0;
  while (k < 5) (
    eb = hr_exp + k * hr_expw;
    v = eb[0]; eb[0] = ((v > -80.001 && v < 0.001) ? v : hr_bdef[k * 5 + 0]);
    v = eb[1]; eb[1] = ((v > 0.999 && v < 20.001) ? v : 1);
    v = eb[2]; eb[2] = ((v > -80.001 && v < 0.001) ? v : hr_bdef[k * 5 + 1]);
    v = eb[3]; eb[3] = ((v > 0.999 && v < 1000.001) ? v : 1);
    v = eb[4]; eb[4] = ((v > 0.099 && v < 200.001) ? v : hr_bdef[k * 5 + 2]);
    v = eb[5]; eb[5] = ((v > 0.999 && v < 2000.001) ? v : hr_bdef[k * 5 + 3]);
    v = eb[6]; eb[6] = ((v > -24.001 && v < 24.001) ? v : 0);
    eb[7] = 0;
    k += 1;
  );
);

function hr_expload(k) local(eb, ch) (
  eb = hr_exp + k * hr_expw;
  ch = hr_slq(hr_se0, eb[0]);
  ch |= hr_slq(hr_se0 + 1, eb[1]);
  ch |= hr_slq(hr_se0 + 2, eb[2]);
  ch |= hr_slq(hr_se0 + 3, eb[3]);
  ch |= hr_slq(hr_se0 + 4, eb[4]);
  ch |= hr_slq(hr_se0 + 5, eb[5]);
  ch |= hr_slq(hr_se0 + 6, eb[6]);
  ch ? tt_sldirty = 1;
);

function hr_resolve() local(k, d, tm, u, dn, kn, rb, eb, s, upon, dnon) (
  d = max(0, min(1, slider(hr_sdepth) * 0.01));
  tm = max(0.25, slider(hr_stime) * 0.01);
  u = max(0, slider(hr_sup) * 0.01) * d;
  dn = max(0, slider(hr_sdn) * 0.01) * d;
  kn = max(0, slider(hr_sknee) * 0.01);
  k = 0;
  while (k < 5) (
    rb = hr_res + k * hr_resw;
    eb = hr_exp + k * hr_expw;
    upon = slider(hr_supon + k) >= 0.5;
    dnon = slider(hr_sdnon + k) >= 0.5;
    rb[12] = (upon ? 1 : 0);
    rb[13] = (dnon ? 1 : 0);
    rb[11] = slider(hr_sg + k);
    (slider(hr_smode) >= 0.5 ? (
      rb[0] = eb[0];
      s = max(1, eb[1]);
      rb[1] = upon ? 1 - 1 / s : 0;
      rb[2] = 6 * kn;
      rb[3] = slider(hr_smax);
      rb[4] = eb[2];
      s = max(1, eb[3]);
      rb[5] = dnon ? (s >= 1000 ? 1 : 1 - 1 / s) : 0;
      rb[6] = 6 * kn;
      rb[7] = 0 - 24;
      rb[8] = eb[4];
      rb[9] = eb[5];
      rb[10] = eb[6];
    ) : (
      rb[0] = eb[0];
      rb[1] = upon ? min(0.95, 0.75 * u) : 0;
      rb[2] = 6 * kn;
      rb[3] = slider(hr_smax);
      rb[4] = eb[2];
      rb[5] = dnon ? min(1, dn * 0.85) : 0;
      rb[6] = 6 * kn;
      rb[7] = 0 - 24;
      rb[8] = hr_bdef[k * 5 + 2] * tm;
      rb[9] = hr_bdef[k * 5 + 3] * tm;
      rb[10] = d * hr_bdef[k * 5 + 4] * slider(hr_smkup) * 0.01;
    ));
    k += 1;
  );
);

function hr_params() local(k, b, rb, t) (
  // Argon-Review B1: gesperrt (Preset-Kleber in @gfx) -> Auftrag nicht verlieren, im naechsten @block nachholen.
  // 0.6.0 (Codex C05): atomar nehmen (atomic_setifequal gibt den alten Wert zurueck: 0 = frei, jetzt unser).
  atomic_setifequal(hr_lock, 0, 1) !== 0 ? tt_sldirty = 1 : (
    hr_foc = floor(slider(hr_sfoc) + 0.5);
    hr_foc < 0 ? hr_foc = 0;
    hr_foc > 4 ? hr_foc = 4;
    hr_expnow = slider(hr_smode) >= 0.5;
    // Argon-Review B2: nach @serialize nie hr_expsave (die Slider koennten aelter sein als die geladenen/geklemmten
    // Expert-Worte); hr_expp traegt den geladenen Modus (gesetzt in @serialize), ein Wechsel nach EXPERT snappt trotzdem.
    hr_loaded ? (
      hr_loaded = 0;
      (hr_expnow && !hr_expp) ? hr_snapall(0);
      hr_focp = hr_foc;
      hr_expnow ? hr_expload(hr_foc);
    ) : (
      (hr_expnow && !hr_expp) ? (
        hr_snapall(0);
        hr_expload(hr_foc);
      );
      hr_foc != hr_focp ? (
        hr_focp = hr_foc;
        hr_expload(hr_foc);
      ) : (
        hr_expnow ? hr_expsave(hr_foc);
      );
    );
    hr_expp = hr_expnow;

    hr_det = slider(hr_sdet) >= 0.5;
    hr_msm = slider(hr_sst) >= 0.5;
    hr_scm = floor(slider(hr_ssc) + 0.5);
    hr_lk = slider(hr_slink) * 0.01;
    hr_agon = slider(hr_sauto) >= 0.5;
    hr_dlta = slider(hr_sdelta) >= 0.5;
    hr_bxT = slider(hr_sbyp) >= 0.5 ? 1 : 0;
    hr_lcv = slider(hr_sceil);
    hr_lon = hr_lcv < 0 - 0.05;
    hr_lcl = 10 ^ (hr_lcv * 0.05);
    hr_ld = floor(0.0015 * srate + 0.5);
    hr_ld < 8 ? hr_ld = 8;
    hr_ld > hr_lrw - 2 ? hr_ld = hr_lrw - 2;
    hr_le = hr_ld - hr_tpd;
    // 0.9.9 (Argon P4): Trapez statt Dreieck. Minimum-Fenster hr_lmw, Mittelung hr_lbn, (hr_lmw - 1) + (hr_lbn - 1) = 2 * hr_le
    // wie vorher (gleiche Latenz); die volle Reduktion liegt auf 5 Samples um die Spitze statt auf einem.
    hr_lbn = max(2, hr_le - 1);
    hr_lmw = 2 * hr_le + 2 - hr_lbn;
    // Zwei Release-Zweige: schnell 12 ms (Einzelspitzen), langsam 40 ms Angriff / 120 ms Release (Dauerbegrenzung).
    hr_lrf = 1 - exp(0 - 1 / (0.012 * srate));
    hr_lra = 1 - exp(0 - 1 / (0.040 * srate));
    hr_lrs = 1 - exp(0 - 1 / (0.120 * srate));
    hr_drvT = max(0, slider(hr_sdrv) * 0.01);

    hr_solo = 0;
    k = 0;
    while (k < 5) (
      (slider(hr_ssolo + k) >= 0.5 ? hr_solo = 1);
      k += 1;
    );
    k = 0;
    while (k < 5) (
      hr_bon[5 + k] = (hr_solo ? (slider(hr_ssolo + k) >= 0.5 ? 1 : 0)
                              : (slider(hr_smute + k) >= 0.5 ? 0 : 1));
      k += 1;
    );

    memcpy(hr_resp, hr_res, 5 * hr_resw);
    hr_resolve();
    hr_armed ? (
    t = 0;
    k = 0;
    while (k < 5 * hr_resw) (
      (hr_res[k] != hr_resp[k] ? t = 1);
      k += 1;
    );
    t ? (
      k = 0;
      while (k < 5 * hr_resw) (
        hr_reso[k] += (hr_resp[k] - hr_reso[k]) * hr_xf;
        k += 1;
      );
      hr_lsg ? (
        k = 0;
        while (k < 5) (
          rb = hr_reso + k * hr_resw;
          b = hr_lst + k * 8;
          hr_updn(rb, b[0]);
          rb[14] = b[6] - max(rb[7], rb[10] + hr_up - hr_dn);
          hr_updn(rb, b[1]);
          rb[15] = b[7] - max(rb[7], rb[10] + hr_up - hr_dn);
          k += 1;
        );
      );
      hr_xf = 0;
    );
    ) : (
      memcpy(hr_reso, hr_res, 5 * hr_resw);
      hr_xf = 1;
      hr_armed = 1;
    );

    (slider(hr_sx1) != hr_sa || slider(hr_sx2) != hr_sb || slider(hr_sx3) != hr_sc || slider(hr_sx4) != hr_sd || srate != hr_wsr) ? (
      hr_weights();
      hr_sa = slider(hr_sx1);
      hr_sb = slider(hr_sx2);
      hr_sc = slider(hr_sx3);
      hr_sd = slider(hr_sx4);
      hr_wsr = srate;
    );

    hr_aga = 1 - exp(0 - 1 / (1.5 * srate));
    hr_agc = 1 - exp(0 - 1 / (0.2 * srate));
    hr_smc = 1 - exp(0 - 1 / (0.005 * srate));
    hr_bxc = 1 - exp(0 - 1 / (0.010 * srate));
    hr_xfc = 1 / (0.010 * srate);
    hr_mdc = exp(0 - 1 / (0.3 * srate));
    hr_lan = floor(slider(hr_sla) * srate / 1000 + 0.5);
    hr_lan > 1920 ? hr_lan = 1920;
    hr_kwc = exp(0 - 6.283185307179586 * 120 / srate);   // 0.9.9 (Argon P1): Hochpass 120 Hz der AUTO-GAIN-Messung
    k = 0;
    while (k < 5) (
      rb = hr_res + k * hr_resw;
      // 0.9.9 (Argon P5): PEAK halbiert die Attack und laesst die RMS-Mittelung weg; RMS mittelt die Leistung vor.
      t = rb[8] * (hr_det ? 0.5 : 1);   // Ausdruck mit Klammer: ?: als Zuweisungswert ist kein Statement-Ternary
      hr_ecf[k * 2] = 1 - exp(0 - 1 / (max(0.00001, t * 0.001) * srate));
      // Vorglaettung (P5 RMS, P2 Bass-Welligkeit): RMS 5/5/3/2/2 ms, PEAK nur SUB 3 ms und LOW 1,2 ms.
      b = (hr_det ? (k == 0 ? 3 : (k == 1 ? 1.2 : 0)) : (k < 2 ? 5 : (k == 2 ? 3 : 2)));
      hr_pcf[k] = (b > 0 ? 1 - exp(0 - 1 / (b * 0.001 * srate)) : 1);
      // P2: Upward-Schwelle als Leistung (Release-Bremse darunter)
      hr_pup[k] = 10 ^ (max(-120, min(0, rb[0])) * 0.1);
      // P9: Vorlauf je Band hoechstens die halbe (wirksame) Attack
      hr_lab[k] = min(hr_lan, floor(0.5 * t * 0.001 * srate + 0.5));
      hr_ecf[k * 2 + 1] = 1 - exp(0 - 1 / (max(0.0001, rb[9] * 0.001) * srate));
      hr_smt[5 + k] = 10 ^ (rb[11] * 0.05);
      k += 1;
    );
    hr_iaT = 10 ^ (slider(hr_sin) * 0.05);
    hr_oaT = 10 ^ (slider(hr_sout) * 0.05);
    hr_mixT = slider(hr_smix) * 0.01;
    hr_pdc = hr_n + hr_span + hr_lan + hr_cld + hr_ld;
    pdc_delay != hr_pdc ? pdc_delay = hr_pdc;
    atomic_set(hr_lock, 0);
  );
);

function hr_synthband(fb, b, c, ola) (
  memcpy(hr_scr, fb, 8192);
  hr_applyw(hr_scr, b);
  ttsp_synth_zp(hr_scr, ola + (b * 2 + c) * hr_olas, hr_hpos);
);

function hr_job(j) local(b, c) (
  j == 0 ? (
    hr_scjob = hr_scm >= 1;
    ttsp_analyze_zp(TTSP_INL, TTSP_FBL, hr_hpos);
  ) : j == 1 ? (
    ttsp_analyze_zp(TTSP_INR, TTSP_FBR, hr_hpos);
  ) : j < 12 ? (
    b = floor((j - 2) * 0.5);
    c = (j - 2) - b * 2;
    hr_synthband(c == 0 ? TTSP_FBL : TTSP_FBR, b, c, hr_ola);
  ) : j == 12 ? (
    hr_scjob ? ( ttsp_analyze_zp(TTSP_ISL, TTSP_FBL, hr_hpos); );
  ) : j == 13 ? (
    hr_scjob ? ( ttsp_analyze_zp(TTSP_ISR, TTSP_FBR, hr_hpos); );
  ) : (
    hr_scjob ? (
      b = floor((j - 14) * 0.5);
      c = (j - 14) - b * 2;
      hr_synthband(c == 0 ? TTSP_FBL : TTSP_FBR, b, c, hr_sco);
    );
  );
);

function hr_ring(off) local(p) (
  p = ttsp_wr - 1 - off;
  while (p < 0) ( p += 8192; );
  p & hr_mask;
);

function hr_peek(base, p) (
  base[p] * TTSP_ONZP;
);
function hr_take(base, p) local(v) (
  v = base[p];
  base[p] = 0;
  v * TTSP_ONZP;
);

function hr_tanh(x) local(a, e) (
  a = min(30, max(-30, x + x));
  e = exp(-a);
  (1 - e) / (1 + e);
);

// 0.9.9 (Argon P3): Halbband polyphas mit Ringpuffern statt 65-Tap-Schiebe-FIR. Bitgleich zu 0.7.1: die geraden
// Taps (ausser der Mitte 32) sind exakt 0, die Nullstopf-Stellen der Aufwaertsstufen ebenfalls; die uebrigen Produkte
// werden in derselben aufsteigenden Tap-Reihenfolge summiert (x + 0 = x). Ringe je Kanal (hr_pp + ch * 384):
// U1 Eingang x (64), U2 Zwischenfolge u (64), D1 4x-Folge v (128), D2 2x-Folge w (128). Index n = hr_ppn + 1024
// (immer positiv, 1024 ist Vielfaches von 128). hr_ppn zaehlt @sample hoch.
function hr_hbsum(r, n) local(i, a) (
  // Abwaertsstufe: sum hbd[i] * r[n - i] ueber i = 1, 3 .. 31, 32, 33 .. 63 (aufsteigend wie hr_fir)
  a = 0;
  i = 1;
  loop(16, a += hr_hbd[i] * r[(n - i) & 127]; i += 2; );
  a += hr_hbd[32] * r[(n - 32) & 127];
  i = 33;
  loop(16, a += hr_hbd[i] * r[(n - i) & 127]; i += 2; );
  a;
);

function hr_clipch(ch, x, k) local(b, n, m, z0, z1, a0, a1, a2, a3, d0, d1, y) (
  b = hr_pp + ch * 384;
  n = hr_ppn + 1024;
  b[n & 63] = x;
  z0 = hr_hbu[32] * b[(n - 16) & 63];
  z1 = 0;
  m = 0;
  loop(32, z1 += hr_hbu[2 * m + 1] * b[(n - m) & 63]; m += 1; );
  b += 64;
  b[(2 * n) & 63] = z0;
  a0 = hr_hbu[32] * b[(2 * n - 16) & 63];
  a1 = 0;
  m = 0;
  loop(32, a1 += hr_hbu[2 * m + 1] * b[(2 * n - m) & 63]; m += 1; );
  b[(2 * n + 1) & 63] = z1;
  a2 = hr_hbu[32] * b[(2 * n - 15) & 63];
  a3 = 0;
  m = 0;
  loop(32, a3 += hr_hbu[2 * m + 1] * b[(2 * n + 1 - m) & 63]; m += 1; );
  a0 = hr_tanh(k * a0) / k;
  a1 = hr_tanh(k * a1) / k;
  a2 = hr_tanh(k * a2) / k;
  a3 = hr_tanh(k * a3) / k;
  b += 64;
  b[(4 * n) & 127] = a0;
  d0 = hr_hbsum(b, 4 * n);
  b[(4 * n + 1) & 127] = a1;
  b[(4 * n + 2) & 127] = a2;
  d1 = hr_hbsum(b, 4 * n + 2);
  b[(4 * n + 3) & 127] = a3;
  b += 128;
  b[(2 * n) & 127] = d0;
  y = hr_hbsum(b, 2 * n);
  b[(2 * n + 1) & 127] = d1;
  y;
);

function hr_cdelay(ch, x) local(p, q) (
  p = hr_cdl + ch * 64;
  p[hr_cw] = x;
  q = hr_cw - hr_cld;
  q < 0 ? q += 64;
  p[q];
);

// True-Peak-Decke, Koeffizienten wie TT-HOTT 0.6.0. Laeuft immer, damit die Latenz stehen bleibt.
// Bei ausgeschaltetem Ceiling ist der Gewinn 1.
function hr_ceil() local(hr_tpz, hr_tpw, hr_tpx, hr_tpy, hr_tla, hr_tlb, hr_tlc, hr_tra, hr_trb, hr_trc, hr_lp, hr_ln, hr_lq, hr_lm, hr_li, hr_lo, hr_lbx, hr_lr, hr_lg) (
  hr_tpi += 1;
  hr_tpi >= hr_tpn ? hr_tpi = 0;
  hr_tpb[hr_tpi] = hr_o0;
  hr_tpb[hr_tpi + hr_tpn] = hr_o0;
  (hr_tpb + 2 * hr_tpn)[hr_tpi] = hr_o1;
  (hr_tpb + 2 * hr_tpn)[hr_tpi + hr_tpn] = hr_o1;
  // Einschalten: das Fenster ist gefuellt, hr_tpm lief nur bei angeschaltetem Ceiling.
  // Historie: der erste Block nach dem Einschalten kannte die Spitzen der letzten Samples nicht.
  hr_lon && hr_lonwas < 0.5 ? (
    hr_tpw = hr_tpb + hr_tpi + 1;
    hr_tpx = hr_tpb + 2 * hr_tpn + hr_tpi + 1;
    hr_tpm = 0;
    loop(hr_tpn, hr_tpm = max(hr_tpm, max(abs(hr_tpw[0]), abs(hr_tpx[0]))); hr_tpw += 1; hr_tpx += 1; );
    hr_tpa = 0;
  );
  hr_lonwas = hr_lon ? 1 : 0;
  hr_lon ? (
    hr_tpz = max(abs(hr_o0), abs(hr_o1));
    hr_tpz >= hr_tpm ? ( hr_tpm = hr_tpz; hr_tpa = 0; ) : (
      hr_tpa += 1;
      hr_tpa >= hr_tpn ? (
        hr_tpw = hr_tpb + hr_tpi + 1;
        hr_tpx = hr_tpb + 2 * hr_tpn + hr_tpi + 1;
        hr_tpm = 0;
        loop(hr_tpn, hr_tpm = max(hr_tpm, max(abs(hr_tpw[0]), abs(hr_tpx[0]))); hr_tpw += 1; hr_tpx += 1; );
        hr_tpa = 0;
      );
    );
    hr_tpm * hr_tps <= hr_lcl ? ( hr_ln = 1; ) : (
      hr_tpw = hr_tpb + hr_tpi + 1;
      hr_tpx = hr_tpb + 2 * hr_tpn + hr_tpi + 1;
      hr_tpy = hr_tpk;
      hr_tla = 0; hr_tlb = 0; hr_tlc = 0; hr_tra = 0; hr_trb = 0; hr_trc = 0;
      loop(hr_tpn,
        hr_tla += hr_tpw[0] * hr_tpy[0];
        hr_tlb += hr_tpw[0] * hr_tpy[hr_tpn];
        hr_tlc += hr_tpw[0] * hr_tpy[2 * hr_tpn];
        hr_tra += hr_tpx[0] * hr_tpy[0];
        hr_trb += hr_tpx[0] * hr_tpy[hr_tpn];
        hr_trc += hr_tpx[0] * hr_tpy[2 * hr_tpn];
        hr_tpw += 1; hr_tpx += 1; hr_tpy += 1;
      );
      hr_lp = max(max(max(abs(hr_tla), abs(hr_tlb)), max(abs(hr_tlc), abs((hr_tpb + hr_tpi + 1)[hr_tpn / 2]))),
                  max(max(abs(hr_tra), abs(hr_trb)), max(abs(hr_trc), abs((hr_tpb + 2 * hr_tpn + hr_tpi + 1)[hr_tpn / 2]))));
      hr_ln = hr_lp > hr_lcl ? hr_lcl / hr_lp : 1;
    );
  ) : (
    hr_ln = 1;
  );
  hr_lq = hr_lw - hr_tpd;
  hr_lq < 0 ? hr_lq += hr_lrw;
  (hr_lim + 2 * hr_lrw)[hr_lq] = hr_ln;
  // 0.6.0 (Codex C14): hr_ones = Zahl der zuletzt geschriebenen exakten Einsen; deckt sie das Fenster, ist das Minimum 1.
  hr_ones = hr_ln === 1 ? min(1000000, hr_ones + 1) : 0;
  hr_lm = 1;
  hr_ones < hr_lmw ? (
    hr_li = hr_lq;
    loop(hr_lmw,
      hr_lm = min(hr_lm, (hr_lim + 2 * hr_lrw)[hr_li]);
      hr_li -= 1;
      hr_li < 0 ? hr_li += hr_lrw;
    );
  );
  hr_lo = hr_lq - hr_lbn;
  hr_lo < 0 ? hr_lo += hr_lrw;
  hr_lsum += hr_lm - (hr_lim + 3 * hr_lrw)[hr_lo];
  (hr_lim + 3 * hr_lrw)[hr_lq] = hr_lm;
  hr_lbx = hr_lsum / hr_lbn;
  // 0.9.9 (Argon P4): schneller Zweig folgt sofort und erholt sich in 12 ms, langsamer Zweig sinkt erst bei
  // anhaltender Begrenzung; der kleinere gilt. Ohne Begrenzung bleiben beide exakt 1.
  hr_lbx < hr_lgf ? hr_lgf = hr_lbx : hr_lgf += (hr_lbx - hr_lgf) * hr_lrf;
  hr_lgs += (hr_lbx - hr_lgs) * (hr_lbx < hr_lgs ? hr_lra : hr_lrs);
  hr_lgn = min(hr_lgf, hr_lgs);
  hr_lim[hr_lw] = hr_o0;
  (hr_lim + hr_lrw)[hr_lw] = hr_o1;
  hr_lr = hr_lw - hr_ld;
  hr_lr < 0 ? hr_lr += hr_lrw;
  // 0.6.0 (Codex C10): stetig mit der Bypass-Blende. 15.11.2026 (Review grok-bot F3): CEIL aus waehrend einer
  // Reduktion laesst hr_lgn nach 1 laufen statt zu springen: schnell 12 ms (hr_lrf), langsam 40 ms Angriff (hr_lra) und 120 ms Release (hr_lrs); hr_lgn ist das Minimum, danach exakt 1 (Durchgang bitgleich).
  // Historie: Reduktion laesst hr_lgn in der 80-ms-Release nach 1 laufen statt zu springen; danach exakt 1 (Durchgang bitgleich).
  hr_lg = (hr_lon || hr_lgn < 0.999999) ? hr_lgn + (1 - hr_lgn) * hr_bx : 1;
  hr_o0 = hr_lim[hr_lr] * hr_lg;
  hr_o1 = (hr_lim + hr_lrw)[hr_lr] * hr_lg;
  hr_lmn = min(hr_lmn, hr_lg);
  hr_lw += 1;
  hr_lw >= hr_lrw ? hr_lw = 0;
  hr_lq == hr_lrw - 1 ? (
    hr_lsum = 0;
    hr_li = 0;
    loop(hr_lbn, hr_lsum += (hr_lim + 3 * hr_lrw)[hr_lrw - 1 - hr_li]; hr_li += 1; );
  );
);
// GENERIERT von build_hotter.py. Nicht von Hand aendern.
