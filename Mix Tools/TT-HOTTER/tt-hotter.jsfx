function hr_fload(i) (
  hr_fdefaults();
  i == 0 ? (   // Init
    hr_pv[3] = 0;
    hr_px[1] = 1.00;
    hr_px[3] = 1.00;
    hr_px[6] = 0.0;
    hr_px[9] = 1.00;
    hr_px[11] = 1.00;
    hr_px[14] = 0.0;
