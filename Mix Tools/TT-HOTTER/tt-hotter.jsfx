    hr_pv[25] = 2500;
    hr_pv[26] = 2;
    hr_px[1] = 4.26;
    hr_px[3] = 1000.00;
    hr_px[4] = 21.0;
    hr_px[5] = 126;
    hr_px[6] = 3.0;
    hr_px[9] = 4.26;
    hr_px[11] = 1000.00;
    hr_px[12] = 12.6;
    hr_px[13] = 84;
    hr_px[14] = 1.7;
    hr_px[17] = 4.26;
