    hr_px[30] = 2.5;
    hr_px[33] = 4.00;
    hr_px[35] = 6.67;
    hr_px[38] = 4.0;
  ) :
  i == 2 ? (   // OTT 30 Parallel
    hr_pv[3] = 100;
    hr_pv[7] = 30;
    hr_pv[22] = 88;
    hr_pv[25] = 2500;
    hr_pv[27] = 1.5;
