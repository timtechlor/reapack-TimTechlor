xctrfit(1062, 732, 34, 12, "IN");
xctrfit(1098, 732, 34, 12, "OUT");
xctrfit(1136, 732, 34, 12, "LIM");
colInk(0.95);
sprintf(#hr_ui3, "%.0f", max(-60, max(hr_uidb(hr_met[40]), hr_uidb(hr_met[41]))));
xctrfit(1062, 628, 34, 12, #hr_ui3);
sprintf(#hr_ui3, "%.0f", max(-60, max(hr_uidb(hr_met[42]), hr_uidb(hr_met[43]))));
xctrfit(1098, 628, 34, 12, #hr_ui3);
sprintf(#hr_ui3, "%.1f", hr_met[44]);
hr_met[44] < -0.05 ? colAcid(1) : colInk(0.95);
xctrfit(1136, 628, 34, 12, #hr_ui3);
tt_hov(1062, 626, 70, 120, "Input and output peak, left and right, dBFS.");
tt_hov(1136, 626, 34, 120, "Limiter reduction, 0 to 12 dB, from the top.");

(hr_thpend && !uiLmb) ? ( tt_undo(); hr_thpend = 0; );
hr_pbsum() != hr_sm0 ? ( hr_vfy = 0; );
hr_pa = tt_pb_post(OX + 820 * SC, OY + 14 * SC, SC);
hr_pa == 1 ? ( hr_fload(tt_pb_arg); hr_pbapplypv(); tt_undo(); hr_vfy = time_precise() + 0.2; )
: hr_pa == 2 ? ( hr_vfy = 0; tt_pb_fetch(tt_pb_arg) > 0 ? ( hr_pbapply(); tt_undo(); ); )
: hr_pa == 3 ? ( hr_pbcapture(); tt_pb_commit(tt_pb_arg, hr_psw); )
: hr_pa == 4 ? ( hr_vfy = 0; hr_pbinit(); tt_undo(); );
tt_pb_track(hr_pbsum());
hr_vfy > time_precise() ? ( hr_pbverify(); );
hr_tc = tth_post(OX + 1104 * SC, OY + 14 * SC, SC);
hr_tc >= 0 ? ( tt_slset(63, hr_tc); );

tt_modtips();
tt_tipflush();
uikit_end();
