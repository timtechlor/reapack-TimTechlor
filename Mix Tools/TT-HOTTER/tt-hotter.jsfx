    hr_px[22] = 0.0;
    hr_px[25] = 1.00;
    hr_px[27] = 1.00;
    hr_px[30] = 0.0;
    hr_px[33] = 1.00;
    hr_px[35] = 1.00;
    hr_px[38] = 0.0;
  ) :
  i == 1 ? (   // Classic OTT
    hr_pv[3] = 100;
    hr_pv[22] = 88;
    hr_pv[23] = 250;
    hr_pv[24] = 800;
    hr_pv[25] = 2500;
    hr_px[1] = 4.00;
