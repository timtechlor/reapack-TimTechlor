);
@init

// Zeichenhilfe, kein @gfx. Koordinaten im Designraster (xrect/knob2st rechnen SC selbst).
// knob2st(id, x, y, r, wert, min, max, default, step). toggle/btn liefern 1 bei Klick, nicht den neuen Wert.
// Bereiche und Defaults stehen in hr_spec.py. Slider 59..62 bleiben aussen vor. #hr_ui1..3 sind die String-Slots.

function hr_uidb(v) (
  20 * log10(max(v, 0.000001));
);

// ---- 0.7.1 (15.11.2026): Bandfarben wie TT-HOTT (Zwillinge) ----
// Wie ht_zinit in TT-HOTT: Farben aus dem Schema-Akzent, im Farbkreis verschoben. HOTT: LOW -0,21 (Orange), MID = Akzent,
// HIGH +0,19 (Tuerkis). HOTTER verteilt fuenf Baender auf denselben Bogen: SUB -0,21, LOW -0,11, L-MID 0, MID +0,09, HIGH +0,19.
// Bei fast farblosem Akzent mindestens Saettigung 0,5. Nur @gfx.
hr_zk = -1;
function hr_hsv(h, s, v) local(i, f, p, q, t) (
  h = h - floor(h); h *= 6; i = floor(h); f = h - i;
  p = v * (1 - s); q = v * (1 - s * f); t = v * (1 - s * (1 - f));
  i == 0 ? ( hr_hcr = v; hr_hcg = t; hr_hcb = p; )
  : i == 1 ? ( hr_hcr = q; hr_hcg = v; hr_hcb = p; )
  : i == 2 ? ( hr_hcr = p; hr_hcg = v; hr_hcb = t; )
  : i == 3 ? ( hr_hcr = p; hr_hcg = q; hr_hcb = v; )
  : i == 4 ? ( hr_hcr = t; hr_hcg = p; hr_hcb = v; )
  : ( hr_hcr = v; hr_hcg = p; hr_hcb = q; );
);
function hr_zinit() local(mx, mn, d, h, s, v, k) (
  mx = max(accR, max(accG, accB)); mn = min(accR, min(accG, accB)); d = mx - mn;
  v = max(0.85, mx); s = max(0.50, mx > 0.0001 ? d / mx : 0);
  h = d < 0.0001 ? 0.58 : (mx === accR ? ((accG - accB) / d) / 6 : mx === accG ? (2 + (accB - accR) / d) / 6 : (4 + (accR - accG) / d) / 6);
  k = 0;
  loop(5,
    k == 2 ? (
      hr_zcr[k] = accR; hr_zcg[k] = accG; hr_zcb[k] = accB;
    ) : (
      hr_hsv(h + (k == 0 ? -0.21 : k == 1 ? -0.11 : k == 3 ? 0.09 : 0.19), s, v);
      hr_zcr[k] = hr_hcr; hr_zcg[k] = hr_hcg; hr_zcb[k] = hr_hcb;
    );
    k += 1;
  );
);
// Farbe des Bands k (0..4, sonst Akzent), hl (0..1) Richtung Weiss, Alpha al.
function hr_zc(k, hl, al) local(r, g, b) (
  k >= 0 && k <= 4 ? ( r = hr_zcr[k]; g = hr_zcg[k]; b = hr_zcb[k]; ) : ( r = accR; g = accG; b = accB; );
  gfx_set(r + (1 - r) * hl, g + (1 - g) * hl, b + (1 - b) * hl, al);
);
// Akzentfarbe der gerade gezeichneten Bandspalte (hr_zk), sonst Schema-Akzent.
function hr_zcol(a) (
  hr_zc(hr_zk, 0, a);
);

function hr_uibname(k) (
  k == 0 ? strcpy(#hr_ui2, "SUB")
  : k == 1 ? strcpy(#hr_ui2, "LOW")
  : k == 2 ? strcpy(#hr_ui2, "L-MID")
  : k == 3 ? strcpy(#hr_ui2, "MID")
  : strcpy(#hr_ui2, "HIGH");
);

function hr_uipill(x, y, w, h, lbl, val, act) (
  ukf_well(x, y, w, h);
  gfx_setfont(3);
  colDim(0.85);
  xstr(x + 6, y + h * 0.5 - 5, lbl);
  act ? colAcid(1) : colInk(0.95);
  xrfit(x, y, w - 4, h, val);
);

function hr_uikn(x, y, r, sl, v, lo, hi, df, st, lbl, fmt, tip) local(nv) (
  nv = knob2st(sl, x, y, r, v, lo, hi, df, st);
  nv != v ? tt_slset(sl, nv);
  gfx_setfont(3);
  colDim(0.85);
  xctrfit(x - 27, y - r - 14, 54, 12, lbl);
  sprintf(#hr_ui3, fmt, nv);
  colInk(0.95);
  xctrfit(x - 27, y + r + 2, 54, 12, #hr_ui3);
  tt_hov(x - r - 8, y - r - 16, r * 2 + 16, r * 2 + 34, tip);
);

function hr_uitg(x, y, w, h, sl, v, lbl, tip) (
  toggle(x, y, w, h, v >= 0.5, lbl) ? tt_slset(sl, v >= 0.5 ? 0 : 1);
  tt_hov(x, y, w, h, tip);
);

function hr_uiseg(x, y, w, h, sl, v, n, opts, lbl, tip) local(nv, ly, bh) (
  strlen(lbl) > 0 ? (
    gfx_setfont(3);
    colDim(0.85);
    xstr(x, y, lbl);
    ly = y + 12;
    bh = h - 12;
  ) : (
    ly = y;
    bh = h;
  );
  nv = floor(v + 0.5);
  nv = ukf_segrow(x, ly, w, bh, n, nv, opts);
  nv != floor(v + 0.5) ? tt_slset(sl, nv);
  tt_hov(x, y, w, h, tip);
);

function hr_uibar(x, y, w, h, db, lo, hi) local(t, fw) (
  ukf_well(x, y, w, h);
  t = max(0, min(1, (db - lo) / max(0.001, hi - lo)));
  fw = (w - 2) * t;
  fw > 0.4 ? (
    db > -3 ? colAcid(0.9) : colInk(0.5);
    xrect(x + 1, y + 1, fw, max(1, h - 2));
  );
);

function hr_uigbar(x, y, w, h, db, span) local(mid, t, fw) (
  ukf_well(x, y, w, h);
  mid = x + w * 0.5;
  colBorder();
  xrect(mid, y + 1, 1, max(1, h - 2));
  t = max(-1, min(1, db / max(0.1, span)));
  fw = abs(t) * (w * 0.5 - 2);
  fw > 0.4 ? (
    t >= 0 ? (
      hr_zcol(0.9);
      xrect(mid + 1, y + 1, fw, max(1, h - 2));
    ) : (
      colInk(0.55);
      xrect(mid - fw, y + 1, fw, max(1, h - 2));
    );
  );
);

// ---- Front 0.7.0 (15.11.2026): Eye-Candy fuer den unteren Teil ----

// Senkrechte LED-Kette. dir 0 = von unten (Pegel), 1 = von oben (Reduktion). Wert in dB, lo..hi.
function hr_uivmeter(x, y, w, h, db, lo, hi, dir) local(n, i, t, sy, lit, sh) (
  ukf_well(x, y, w, h);
  sh = 4;
  n = floor((h - 4) / sh);
  t = max(0, min(1, (db - lo) / max(0.001, hi - lo)));
  dir ? t = 1 - t;
  i = 0;
  loop(n,
    lit = (i + 0.5) / n < t;
    sy = dir ? y + 2 + i * sh : y + h - 2 - (i + 1) * sh;
    lit ? (
      dir ? colWhite(0.85) : (i >= n * 0.82 ? colAcid(1) : colAcid(0.25 + 0.55 * i / n));
    ) : colDim(0.12);
    xrect(x + 2, sy, w - 4, sh - 1);
    i += 1;
  );
);

// Waagerechte LED-Kette (Bandpegel).
function hr_uihled(x, y, w, h, db, lo, hi) local(n, i, t, sw) (
  ukf_well(x, y, w, h);
  sw = 5;
  n = floor((w - 4) / sw);
  t = max(0, min(1, (db - lo) / max(0.001, hi - lo)));
  i = 0;
  loop(n,
    (i + 0.5) / n < t ? (i >= n * 0.85 ? hr_zcol(1) : hr_zcol(0.25 + 0.55 * i / n)) : colDim(0.12);
    xrect(x + 2 + i * sw, y + 2, sw - 1, h - 4);
    i += 1;
  );
);

// Kennlinie eines Bandes: Gewinn (dB) ueber Eingangspegel -80..0 dB, Flaeche zur 0-dB-Linie, Live-Punkt mit Schein.
// a = Deckkraft (0..1), fill = Flaeche zeichnen, dot = Live-Punkt zeichnen.
function hr_uicline(x, y, w, h, k, a, fill, dot) local(i, n, y0, g0, g1, x0, x1, yy0, yy1, m, lv, gv, tx, ty, sp) (
  y0 = y + h * 0.5;
  sp = h * 0.46 / 24;
  n = 32;
  i = 0;
  loop(n,
    g0 = max(-24, min(24, hr_gdb(k, -80 + (i / n) * 80)));
    g1 = max(-24, min(24, hr_gdb(k, -80 + ((i + 1) / n) * 80)));
    x0 = x + (i / n) * w;
    x1 = x + ((i + 1) / n) * w;
    yy0 = y0 - g0 * sp;
    yy1 = y0 - g1 * sp;
    fill ? (
      g0 >= 0 ? hr_zc(k, 0, 0.16 * a) : colWhite(0.10 * a);
      xrect(x0, min(y0, yy0), max(1, x1 - x0), max(1, abs(yy0 - y0)));
    );
    hr_zc(k, 0, a);
    xline(x0, yy0, x1, yy1);
    i += 1;
  );
  dot ? (
    m = hr_met + k * hr_metw;
    lv = max(-80, min(0, 0.5 * (m[0] + m[1])));
    gv = max(-24, min(24, hr_gdb(k, lv)));
    tx = x + ((lv + 80) / 80) * w;
    ty = y0 - gv * sp;
    hr_zc(k, 0, 0.18 * a);
    xcirc(tx, ty, 6, 1);
    hr_zc(k, 0, 0.35 * a);
    xcirc(tx, ty, 3.6, 1);
    colWhite(a);
    xcirc(tx, ty, 1.8, 1);
  );
);

// Kleines Kennlinienfeld fuer die Bandspalte.
function hr_uiminic(x, y, w, h, k) local(b) (
  ukf_well(x, y, w, h);
  colBorder();
  xrect(x + 2, y + h * 0.5, w - 4, 1);
  b = hr_res + k * hr_resw;
  colDim(0.25);
  xrect(x + 3 + max(0, min(1, (b[0] + 80) / 80)) * (w - 6), y + 2, 1, h - 4);
  xrect(x + 3 + max(0, min(1, (b[4] + 80) / 80)) * (w - 6), y + 2, 1, h - 4);
  hr_uicline(x + 3, y + 2, w - 6, h - 4, k, 1, 1, 1);
  tt_hov(x, y, w, h, "Gain curve of this band over input level, -80 to 0 dB. The dot is the live input. The dim lines are the up and down thresholds.");
);

// Alle fuenf Kennlinien uebereinander, das fokussierte Band hell.
function hr_uiresp(x, y, w, h) local(k, foc, gy, d) (
  ukf_well(x, y, w, h);
  foc = floor(slider(hr_sfoc) + 0.5);
  colBorder();
  d = -24;
  loop(5,
    gy = y + 4 + (h - 8) * 0.5 - d * ((h - 8) * 0.46 / 24);
    xrect(x + 2, gy, w - 4, 1);
    d += 12;
  );
  k = 0;
  loop(5,
    k != foc ? hr_uicline(x + 4, y + 4, w - 8, h - 8, k, 0.32, 0, 1);
    k += 1;
  );
  hr_uicline(x + 4, y + 4, w - 8, h - 8, foc, 1, 1, 1);
  gfx_setfont(3);
  colDim(0.75);
  xstr(x + 6, y + 4, "+24");
  xstr(x + 6, y + h - 14, "-24");
  hr_uibname(foc);
  hr_zc(foc, 0, 1);
  xrfit(x, y + 4, w - 6, 12, #hr_ui2);
  colDim(0.6);
  xrfit(x, y + h - 14, w - 6, 12, "IN -80 .. 0 dB");
  tt_hov(x, y, w, h, "Gain curves of all five bands over input level. The focused band is bright; the dots show the live input of each band.");
);

// Saettiger: Ausgang ueber Eingang bei der aktuellen DRIVE-Stellung (tanh(k*x)/k, mit DRIVE eingeblendet).
// Nur @gfx. Kopie von hr_tanh (0.7.1, grok-bot F1): Parameter und local() sind in EEL2 statisch und waeren sonst
// mit hr_clipch (@sample) geteilt; ein Zeichenaufruf mitten im Audio-Aufruf gaebe einen falschen Sample-Wert.
function hr_gtanh(x) local(a, e) (
  a = min(30, max(-30, x + x));
  e = exp(-a);
  (1 - e) / (1 + e);
);

function hr_uishaper(x, y, w, h) local(d, k, i, n, a0, a1, y0, y1, cx, cy, s) (
  ukf_well(x, y, w, h);
  cx = x + w * 0.5;
  cy = y + h * 0.5;
  s = (min(w, h) - 8) * 0.25;
  colBorder();
  xrect(x + 2, cy, w - 4, 1);
  xrect(cx, y + 2, 1, h - 4);
  colDim(0.3);
  xline(cx - 2 * s, cy + 2 * s, cx + 2 * s, cy - 2 * s);
  d = max(0, min(1, slider(hr_sdrv) * 0.01));
  k = 1 + 8 * d;
  n = 40;
  i = 0;
  colAcid(d > 0.005 ? 1 : 0.5);
  loop(n,
    a0 = -2 + 4 * i / n;
    a1 = -2 + 4 * (i + 1) / n;
    y0 = (1 - d) * a0 + d * hr_gtanh(k * a0) / k;
    y1 = (1 - d) * a1 + d * hr_gtanh(k * a1) / k;
    xline(cx + a0 * s, cy - y0 * s, cx + a1 * s, cy - y1 * s);
    i += 1;
  );
  gfx_setfont(3);
  colDim(0.7);
  xstr(x + 4, y + 3, "SHAPE");
  tt_hov(x, y, w, h, "Drive shaper: output over input at the current DRIVE. The dim diagonal is clean.");
);

function hr_uicurve(x, y, w, h, k) local(i, n, db0, db1, g0, g1, gv, y0, x0, x1, yy0, yy1, m, lv, tx, ty, b, ut, dt) (
  ukf_well(x, y, w, h);
  b = hr_res + k * hr_resw;
  ut = b[0];
  dt = b[4];
  y0 = y + h * 0.56;
  colBorder();
  xrect(x + 2, y0, w - 4, 1);
  colDim(0.4);
  tx = x + 3 + max(0, min(1, (ut + 80) / 80)) * (w - 6);
  xrect(tx, y + 2, 1, h - 4);
  tx = x + 3 + max(0, min(1, (dt + 80) / 80)) * (w - 6);
  xrect(tx, y + 2, 1, h - 4);
  n = 24;
  i = 0;
  colAcid(0.92);
  loop(n,
    db0 = -80 + (i / n) * 80;
    db1 = -80 + ((i + 1) / n) * 80;
    g0 = max(-36, min(36, hr_gdb(k, db0)));
    g1 = max(-36, min(36, hr_gdb(k, db1)));
    x0 = x + 3 + (i / n) * (w - 6);
    x1 = x + 3 + ((i + 1) / n) * (w - 6);
    yy0 = y0 - (g0 / 36) * (h * 0.40);
    yy1 = y0 - (g1 / 36) * (h * 0.40);
    xline(x0, yy0, x1, yy1);
    i += 1;
  );
  m = hr_met + k * hr_metw;
  lv = max(-80, min(0, 0.5 * (m[0] + m[1])));
  gv = hr_gdb(k, lv);
  g0 = max(-36, min(36, gv));
  tx = x + 3 + ((lv + 80) / 80) * (w - 6);
  ty = y0 - (g0 / 36) * (h * 0.40);
  colWhite(1);
  xcirc(tx, ty, 2.2, 1);
  gfx_setfont(3);
  colDim(0.8);
  xstr(x + 4, y + 3, "CURVE");
  sprintf(#hr_ui3, "%+.1f dB", gv);
  xrfit(x, y + h - 14, w - 4, 12, #hr_ui3);
  tt_hov(x, y, w, h, "Gain curve of this band. The dot is the live input level.");
);

// Analyzer und Pegel-Scope (0.2.0; Zielkurven, LEARN, MATCH seit 0.3.0). Liegt im @init-Abschnitt von hr20 (Funktionen + Speicher).
// Speicher ab 917504 = 14 * 65536: der FFT-Puffer kreuzt keine 65536er-Grenze (Leitfaden C18).
// @sample schreibt nur die Ringe (hr50, Ende). Rechnen und Zeichnen nur in @gfx.
// FFT wie another TT plug-in (gemessen; Abstand 4 und Permutation mit 4096 sind dort im Simulator und in REAPER belegt): fft_real(buf, 4096) + fft_permute(buf, 4096), buf[4096..8191] = 0,
// Bin j (0..2047): re = buf[4j], im = buf[4j+1], Frequenz j * srate / 4096.
//
// Karte (Offsets ab hz_mem):
//   0      Ring vorher (Eingang, gleiche Verzoegerung wie der Trockenweg), 4096
//   4096   Ring nachher (Ausgang), 4096
//   16384  FFT-Arbeitspuffer, 8192
//   24576  Hann-Fenster, 4096
//   28672  Anzeige vorher, dB je Punkt, 256
//   28928  Anzeige nachher, dB je Punkt, 256
//   29184  erster Bin je Punkt, 256
//   29440  letzter Bin je Punkt, 256
//   29696  Mittel vorher (Leistung), 256
//   29952  Mittel nachher (Leistung), 256
//   30208  Langzeitmittel vorher (Leistung, ~5 s), 256
//   30464  Langzeitmittel nachher, 256
//   30720  gelernte Zielkurve (dB, geneigt), 256
//   30976  Genre-Tabellen, 6 x 10 Stuetzstellen
//   31232  Abweichung Eingang, 256;  31488  Abweichung Ausgang, 256
//   31744  Abweichung je Band, 5;  31760  MATCH-Vorschlag je Band (dB), 5;  31776  zuletzt angewandter MATCH, 5
//   (genutzt werden je Feld hz_np = 192 Punkte, Rest Reserve; hz_clear loescht Anzeige vorher+nachher am Stueck, 512)
//   32768  Scope vorher (Spitze je Spalte), 512
//   33280  Scope nachher, 512
//   Ende 33792

hz_mem = 917504;
hz_rpre = hz_mem;
hz_rpost = hz_mem + 4096;
hz_fb = hz_mem + 16384;
hz_win = hz_mem + 24576;
hz_dpre = hz_mem + 28672;
hz_dpost = hz_mem + 28928;
hz_blo = hz_mem + 29184;
hz_bhi = hz_mem + 29440;
hz_apre = hz_mem + 29696;
hz_apost = hz_mem + 29952;
hz_spre = hz_mem + 32768;
hz_spost = hz_mem + 33280;
hz_lpre = hz_mem + 30208;
hz_lpost = hz_mem + 30464;
hz_lrn = hz_mem + 30720;
hz_tab = hz_mem + 30976;
hz_dvi = hz_mem + 31232;
hz_dvo = hz_mem + 31488;
hz_bdv = hz_mem + 31744;
hz_sgv = hz_mem + 31760;
hz_mdone = hz_mem + 31776;
hz_np = 192;
hz_scn = 512;

// Fenster und Bin-Tabelle. Bei jedem @init (Samplerate kann wechseln); Ringe nur bei hr_rst leeren (hr28).
function hz_setup() local(i, p, flo, fhi, b0, b1) (
  i = 0;
  while (i < 4096) (
    hz_win[i] = 0.5 - 0.5 * cos(2 * $pi * i / 4096);
    i += 1;
  );
  p = 0;
  while (p < hz_np) (
    flo = 20 * 1000 ^ (p / hz_np);
    fhi = 20 * 1000 ^ ((p + 1) / hz_np);
    b0 = floor(flo * 4096 / srate + 0.5);
    b1 = floor(fhi * 4096 / srate + 0.5);
    (b0 < 1 ? b0 = 1);
    (b0 > 2047 ? b0 = 2047);
    (b1 < b0 ? b1 = b0);
    (b1 > 2047 ? b1 = 2047);
    hz_blo[p] = b0;
    hz_bhi[p] = b1;
    p += 1;
  );
  hz_step = max(64, floor(srate * 0.006 + 0.5));
);

function hz_clear() (
  memset(hz_rpre, 0, 8192);
  memset(hz_lpre, 0, 512);
  memset(hz_spre, 0, 1024);
  memset(hz_apre, 0, 512);
  hz_w = 0;
  hz_sw = 0;
  hz_sn = 0;
  hz_spa = 0;
  hz_spb = 0;
  hz_noval = 1;
  memset(hz_sgv, 0, 5);
  hz_j = 0;
  while (hz_j < 512) (
    hz_dpre[hz_j] = -120;
    hz_j += 1;
  );
);

// Ein Spektrum: juengste 4096 Samples aus ring -> Anzeige disp (dB, Neigung +4.5 dB/Okt um 1 kHz),
// Mittel avg (~0.5 s) und lng (~5 s) als Leistung. Anzeige: Spitze je Punkt, sofort, Abfall 0.25 je Frame.
// 0.3.1 (grok-Review F6/F12): Mittel ueber die Bins eines Punkts statt Maximum (das hob breite Punkte oben um
// einige dB an); Zeitkonstanten ueber hz_ca/hz_cl aus der echten Frame-Zeit (hr_uiana), nicht je Frame.
function hz_spec(ring, disp, avg, lng) local(i, p, b, bmax, bsum, nb, pw, pm, re, im, db, fc, e) (
  e = hz_w + 1;
  i = 0;
  while (i < 4096) (
    hz_fb[i] = ring[(e + i) & 4095] * hz_win[i];
    hz_fb[4096 + i] = 0;
    i += 1;
  );
  fft_real(hz_fb, 4096);
  fft_permute(hz_fb, 4096);
  p = 0;
  while (p < hz_np) (
    bmax = 0; bsum = 0; nb = 0;
    b = hz_blo[p];
    while (b <= hz_bhi[p]) (
      re = hz_fb[4 * b];
      im = hz_fb[4 * b + 1];
      pw = re * re + im * im;
      (pw > bmax ? bmax = pw);
      bsum += pw; nb += 1;
      b += 1;
    );
    // Sinus der Spitze A ergibt |X| = 1024 A (Hann-Summe 2048).
    pw = bmax / (1024 * 1024);
    fc = 20 * 1000 ^ ((p + 0.5) / hz_np);
    db = 10 * log10(max(pw, 0.000000000001)) + 4.5 * log(fc / 1000) / log(2);
    (db > disp[p] ? disp[p] = db : disp[p] += (db - disp[p]) * 0.25);
    pm = bsum / max(1, nb) / (1024 * 1024);
    avg[p] += (pm - avg[p]) * hz_ca;
    lng[p] += (pm - lng[p]) * hz_cl;
    p += 1;
  );
);

function hz_x(f, x, w) (
  x + (log10(max(20, min(20000, f))) - log10(20)) / 3 * w;
);
function hz_f(px, x, w) (
  10 ^ (log10(20) + max(0, min(1, (px - x) / w)) * 3);
);

// Raster: Frequenzlinien und Beschriftung.
function hz_grid(x, y, w, h) local(f, d, gx) (
  gfx_setfont(3);
  d = 10;
  while (d <= 10000) (
    f = d;
    loop(9,
      gx = hz_x(f, x, w);
      ((f == d) ? colBorder() : gfx_set(1, 1, 1, 0.035));
      xrect(gx, y, 1, h);
      f += d;
    );
    d *= 10;
  );
  colDim(0.55);
  xstr(hz_x(100, x, w) + 3, y + h - 13, "100");
  xstr(hz_x(1000, x, w) + 3, y + h - 13, "1k");
  xstr(hz_x(10000, x, w) + 3, y + h - 13, "10k");
);

// Spektrum vorher (Flaeche) und nachher (Linie). dB -90..+6.
function hz_drawspec(x, y, w, h) local(p, x0, x1, v0, v1, ya, yb) (
  hz_grid(x, y, w, h);
  p = 0;
  colInk(0.16);
  while (p < hz_np) (
    x0 = x + p / hz_np * w;
    x1 = x + (p + 1) / hz_np * w;
    v0 = max(0, min(1, (hz_dpre[p] + 90) / 96));
    ya = y + h - v0 * h;
    xrect(x0, ya, max(1, x1 - x0 + 0.5), y + h - ya);
    p += 1;
  );
  colInk(0.45);
  p = 0;
  while (p < hz_np - 1) (
    x0 = x + (p + 0.5) / hz_np * w;
    x1 = x + (p + 1.5) / hz_np * w;
    v0 = max(0, min(1, (hz_dpre[p] + 90) / 96));
    v1 = max(0, min(1, (hz_dpre[p + 1] + 90) / 96));
    xline(x0, y + h - v0 * h, x1, y + h - v1 * h);
    p += 1;
  );
  colAcid(1);
  p = 0;
  while (p < hz_np - 1) (
    x0 = x + (p + 0.5) / hz_np * w;
    x1 = x + (p + 1.5) / hz_np * w;
    v0 = max(0, min(1, (hz_dpost[p] + 90) / 96));
    v1 = max(0, min(1, (hz_dpost[p + 1] + 90) / 96));
    ya = y + h - v0 * h;
    yb = y + h - v1 * h;
    xline(x0, ya, x1, yb);
    xline(x0, ya + 1, x1, yb + 1);
    p += 1;
  );
);

// Klangbalance ohne Ziel: Mittel (~0.5 s, hz_apre/hz_apost) nachher minus vorher, +-12 dB. Glaettung ueber 5 Nachbarpunkte.
function hz_drawdiff(x, y, w, h) local(p, q, x0, x1, d0, d1, my, sa, sb, n) (
  hz_grid(x, y, w, h);
  my = y + h * 0.5;
  colDim(0.5);
  xrect(x, my, w, 1);
  gfx_set(1, 1, 1, 0.06);
  xrect(x, y + h * 0.25, w, 1);
  xrect(x, y + h * 0.75, w, 1);
  gfx_setfont(3);
  colDim(0.55);
  xstr(x + 4, y + h * 0.25 - 13, "+6 dB");
  xstr(x + 4, y + h * 0.75 + 2, "-6 dB");
  xstr(x + 4, my - 13, "0");
  colAcid(1);
  d0 = 0;
  p = 0;
  while (p < hz_np) (
    sa = 0; sb = 0; n = 0;
    q = max(0, p - 2);
    while (q <= min(hz_np - 1, p + 2)) (
      sa += hz_apre[q]; sb += hz_apost[q]; n += 1;
      q += 1;
    );
    d1 = 10 * log10(max(sb, 0.000000000001) / max(sa, 0.000000000001));
    (sa < 0.000000000001 ? d1 = 0);
    d1 = max(-12, min(12, d1));
    x1 = x + (p + 0.5) / hz_np * w;
    (p > 0 ? (
      xline(x0, my - d0 / 12 * h * 0.5, x1, my - d1 / 12 * h * 0.5);
      xline(x0, my - d0 / 12 * h * 0.5 + 1, x1, my - d1 / 12 * h * 0.5 + 1);
    ));
    x0 = x1;
    d0 = d1;
    p += 1;
  );
);

// Pegel-Scope: die letzten ~3 s, Spitze je Spalte in dB (-48..0), gespiegelt. Vorher Flaeche, nachher Linie.
function hz_drawscope(x, y, w, h) local(c, i, xc, v, va, vb, my, hh, x0, ya, yb) (
  my = y + h * 0.5;
  hh = h * 0.5 - 2;
  colBorder();
  xrect(x, my, w, 1);
  gfx_set(1, 1, 1, 0.05);
  xrect(x, my - hh * 0.5, w, 1);
  xrect(x, my + hh * 0.5, w, 1);
  gfx_setfont(3);
  colDim(0.55);
  xstr(x + 4, y + 2, "0 dB");
  xstr(x + 4, my - hh * 0.5 - 13, "-24");
  colInk(0.2);
  c = 0;
  while (c < hz_scn) (
    i = (hz_sw + 1 + c) & 511;
    xc = x + c / hz_scn * w;
    v = 20 * log10(max(hz_spre[i], 0.0000001));
    va = max(0, min(1, (v + 48) / 48)) * hh;
    xrect(xc, my - va, max(1, w / hz_scn + 0.5), 2 * va);
    c += 1;
  );
  colAcid(1);
  c = 0;
  while (c < hz_scn) (
    i = (hz_sw + 1 + c) & 511;
    xc = x + c / hz_scn * w;
    v = 20 * log10(max(hz_spost[i], 0.0000001));
    vb = max(0, min(1, (v + 48) / 48)) * hh;
    (c > 0 ? (
      xline(x0, my - ya, xc, my - vb);
      xline(x0, my + ya, xc, my + vb);
    ));
    x0 = xc;
    ya = vb;
    c += 1;
  );
);

// ---------------------------------------------------------------- Zielkurven (0.3.0)
// Stuetzstellen 30, 60, 120, 250, 500, 1k, 2k, 4k, 8k, 16k Hz; dB im geneigten Bild (+4.5 dB/Okt, rosa Rauschen = flach).
// GROBE STARTKURVEN, von Hand geschaetzt, KEINE gemessenen Referenzen. Echte Ziele: LEARN mit einem Referenztrack.
// hz_tsel: 0 OFF, 1 TECHNO, 2 ACID, 3 HOUSE, 4 DNB, 5 DUBSTEP, 6 TRANCE, 7 LEARNED (gespeichert in @serialize).
function hz_tabrow(t, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9) local(b) (
  b = hz_tab + (t - 1) * 10;
  b[0] = a0; b[1] = a1; b[2] = a2; b[3] = a3; b[4] = a4;
  b[5] = a5; b[6] = a6; b[7] = a7; b[8] = a8; b[9] = a9;
);
hz_tabrow(1, 5, 5, 2, 0, -1, -1, -1, -1.5, -3, -6);
hz_tabrow(2, 4, 4, 2, 0.5, 0, 0, 0, -0.5, -2, -5);
hz_tabrow(3, 3, 4, 2, 0, 0, -0.5, -0.5, -0.5, -2, -5);
hz_tabrow(4, 5, 4, 1, -1, -1, -1, -0.5, 0, -1.5, -4);
hz_tabrow(5, 6, 5, 1, -1, -1.5, -1, -0.5, 0, -1, -4);
hz_tabrow(6, 3, 3, 1, 0, 0, 0, 0, 0, -1, -3.5);

// Stuetzstelle i liegt bei log2(f / 30) = hz_tx(i): 30, 60, 120, 250, 500, 1k, 2k, 4k, 8k, 16k Hz.
function hz_tx(i) (
  i < 3 ? i : log((i == 3 ? 250 : i == 4 ? 500 : i == 5 ? 1000 : i == 6 ? 2000 : i == 7 ? 4000 : i == 8 ? 8000 : 16000) / 30) / log(2);
);

// Zielwert am Anzeigepunkt p (linear ueber log2 f zwischen den Stuetzstellen, ausserhalb gehalten).
function hz_target(t, p) local(f, l, i, a, b, x0, x1, row) (
  t == 7 ? hz_lrn[p] : (
    f = 20 * 1000 ^ ((p + 0.5) / hz_np);
    l = log(f / 30) / log(2);
    row = hz_tab + (t - 1) * 10;
    l <= 0 ? row[0] : l >= hz_tx(9) ? row[9] : (
      i = 0;
      while (i < 8 && l > hz_tx(i + 1)) ( i += 1; );
      x0 = hz_tx(i);
      x1 = hz_tx(i + 1);
      a = row[i];
      b = row[i + 1];
      a + (b - a) * (l - x0) / max(0.001, x1 - x0);
    );
  );
);

// Langzeitspektrum in dB (geneigt, ueber 5 Nachbarpunkte geglaettet).
function hz_ldb(lng, p) local(q, s, n, fc) (
  s = 0; n = 0;
  q = max(0, p - 2);
  while (q <= min(hz_np - 1, p + 2)) (
    s += lng[q]; n += 1;
    q += 1;
  );
  fc = 20 * 1000 ^ ((p + 0.5) / hz_np);
  10 * log10(max(s / n, 0.000000000001)) + 4.5 * log(fc / 1000) / log(2);
);

// Abweichung zum Ziel je Punkt nach dev (Pegel herausgerechnet: Mittel 100 Hz..10 kHz = 0).
function hz_devcalc(lng, dev, t) local(p, m, n, f) (
  m = 0; n = 0;
  p = 0;
  while (p < hz_np) (
    dev[p] = hz_ldb(lng, p) - hz_target(t, p);
    f = 20 * 1000 ^ ((p + 0.5) / hz_np);
    ((f >= 100 && f <= 10000) ? ( m += dev[p]; n += 1; ));
    p += 1;
  );
  m /= max(1, n);
  p = 0;
  while (p < hz_np) (
    dev[p] -= m;
    p += 1;
  );
);

// 0.3.1 (grok-Review F1): Gibt es ueberhaupt Signal? Leistungssumme der Langzeitmittel ueber alle Punkte
// (Stille, leere Ringe -> 0). Ohne Signal kein LEARN und kein MATCH-Vorschlag ("NO SIGNAL").
function hz_sig(lng) local(p, s) (
  s = 0;
  p = 0;
  while (p < hz_np) (
    s += lng[p];
    p += 1;
  );
  s > 0.0000000001;
);

// Weiche i (0..3) fuer die Anzeige (grok-Review F10): der Slider, solange er die Ordnung einhaelt (Bedienung ueber die
// Front tut das immer, und der Griff folgt dann sofort, auch wenn der Audio-Thread steht); sonst (Automation/Preset mit
// ungueltiger Folge) die vom Klangkern geordnete Weiche hr_ft[1..4].
// Argon-Review B6: Ordnung ueber alle vier Weichen pruefen, sonst mischen sich Slider und Kernwerte (nicht steigend).
function hz_xe(i) local(x1, x2, x3, x4, ok, e) (
  x1 = slider(hr_sx1); x2 = slider(hr_sx1 + 1); x3 = slider(hr_sx1 + 2); x4 = slider(hr_sx1 + 3);
  ok = x2 > x1 * 1.25 - 0.5 && x3 > x2 * 1.25 - 0.5 && x4 > x3 * 1.25 - 0.5 && x4 < srate * 0.5 / 1.25 + 0.5;
  e = hr_ft[i + 1];
  (ok || e < 1) ? slider(hr_sx1 + i) : e;
);

// LEARN: Langzeitspektrum des Eingangs als Ziel uebernehmen (Pegel herausgerechnet). Nur mit Signal (F1).
function hz_learn() local(p, m) (
  hz_sig(hz_lpre) ? (
    m = 0;
    p = 0;
    while (p < hz_np) (
      hz_lrn[p] = hz_ldb(hz_lpre, p);
      m += hz_lrn[p];
      p += 1;
    );
    m /= hz_np;
    p = 0;
    while (p < hz_np) (
      hz_lrn[p] = max(-60, min(60, hz_lrn[p] - m));
      p += 1;
    );
    hz_hasl = 1;
  );
);

// Ansicht BALANCE mit Ziel: 0 = Ziel, Eingang grau, Ausgang gruen, +-12 dB.
function hz_drawtarget(x, y, w, h, t) local(p, x0, x1, a0, a1, b0, b1, my) (
  hz_devcalc(hz_lpre, hz_dvi, t);
  hz_devcalc(hz_lpost, hz_dvo, t);
  hz_grid(x, y, w, h);
  my = y + h * 0.5;
  gfx_set(1, 1, 1, 0.06);
  xrect(x, y + h * 0.25, w, 1);
  xrect(x, y + h * 0.75, w, 1);
  colWhite(0.75);
  xrect(x, my, w, 1);
  gfx_setfont(3);
  colDim(0.55);
  xstr(x + 4, y + h * 0.25 - 13, "+6 dB");
  xstr(x + 4, y + h * 0.75 + 2, "-6 dB");
  colWhite(0.8);
  xstr(x + w - 56, my - 13, "TARGET");
  p = 1;
  while (p < hz_np) (
    x0 = x + (p - 0.5) / hz_np * w;
    x1 = x + (p + 0.5) / hz_np * w;
    a0 = max(-12, min(12, hz_dvi[p - 1]));
    a1 = max(-12, min(12, hz_dvi[p]));
    b0 = max(-12, min(12, hz_dvo[p - 1]));
    b1 = max(-12, min(12, hz_dvo[p]));
    colInk(0.45);
    xline(x0, my - a0 / 12 * h * 0.5, x1, my - a1 / 12 * h * 0.5);
    colAcid(1);
    xline(x0, my - b0 / 12 * h * 0.5, x1, my - b1 / 12 * h * 0.5);
    xline(x0, my - b0 / 12 * h * 0.5 + 1, x1, my - b1 / 12 * h * 0.5 + 1);
    p += 1;
  );
);

// Je Band: mittlere Abweichung des Ausgangs zum Ziel (hz_bdv) und der MATCH-Vorschlag fuer den GAIN-Trim (hz_sgv).
// 0.3.1 (grok-Review F1/F8/F10): ohne Signal, bei DELTA, LISTEN oder BYPASS kein Vorschlag (hz_noval = 1);
// Schritt hoechstens +-12 dB, Endwert im Reglerbereich +-24 dB; Bandgrenzen = wirksame Weichen.
// Setzt voraus, dass hz_dvo aktuell ist (hz_drawtarget oder hz_devcalc).
function hz_bandsug() local(k, p, f, lo, hi, s, n, st, g) (
  hz_noval = !(hz_sig(hz_lpre) && hz_sig(hz_lpost)) || slider(hr_sdelta) >= 0.5 || slider(hr_sbyp) >= 0.5
             || floor(slider(hr_ssc) + 0.5) == 2;
  k = 0;
  while (k < 5) (
    lo = (k == 0 ? 20 : hz_xe(k - 1));
    hi = (k == 4 ? 20000 : hz_xe(k));
    s = 0; n = 0;
    p = 0;
    while (p < hz_np) (
      f = 20 * 1000 ^ ((p + 0.5) / hz_np);
      ((f >= lo && f < hi) ? ( s += hz_dvo[p]; n += 1; ));
      p += 1;
    );
    hz_bdv[k] = (n > 0 && !hz_noval ? s / n : 0);
    st = max(-12, min(12, -0.8 * hz_bdv[k]));
    g = floor(max(-24, min(24, slider(hr_sg + k) + st)) * 10 + 0.5) / 10;
    hz_sgv[k] = (hz_noval ? 0 : g - slider(hr_sg + k));
    k += 1;
  );
);

// MATCH: Band-GAIN einmalig Richtung Ziel (80 % der mittleren Abweichung des Ausgangs im Band, Schritt +-12 dB, Endwert +-24 dB).
// MATCH uebernimmt die Vorschlaege, die hz_bandsug() im selben Frame unmittelbar vor dem Knopf berechnet (hz_sgv);
// hz_match rechnet sie nicht neu: Anzeige und Wirkung stimmen ueberein.
// Historie: MATCH uebernimmt genau die zuletzt angezeigten Vorschlaege (hz_sgv aus dem vorigen Frame, hz_bandsug in hr_uiana),
// Historie: keine Neuberechnung: Anzeige und Wirkung stimmen ueberein.
function hz_match() local(k, g) (
  hz_noval ? 0 : (
  k = 0;
  while (k < 5) (
    hz_mdone[k] = hz_sgv[k];
    g = floor(max(-24, min(24, slider(hr_sg + k) + hz_sgv[k])) * 10 + 0.5) / 10;
    (g != slider(hr_sg + k) ? tt_slset(hr_sg + k, g));
    k += 1;
  );
  hz_mtime = time_precise() + 2.5;
  );
);
// Front (0.2.0, Bandschwellen/Ziele seit 0.3.0): Display (Analyzer, Klangbalance, Scope) mit verschiebbaren Weichen, Bandspalten, EXPERT-Leiste.
// Koordinaten im Designraster. Nur @gfx ruft diese Funktionen.

// Grenzen der Weiche i (0..3): eigener Bereich und mindestens Faktor 1.25 Abstand zu den Nachbarn
// (gleiche Regel wie hr_weights/hotter_dsp.XO_GAP). Ergebnis in hr_xlo, hr_xhi, hr_xdf.
function hr_uixlim(i) local(lo, hi) (
  lo = i == 0 ? 20 : i == 1 ? 40 : i == 2 ? 100 : 400;
  hi = i == 0 ? 400 : i == 1 ? 1000 : i == 2 ? 4000 : 12000;
  hr_xdf = i == 0 ? 80 : i == 1 ? 250 : i == 2 ? 800 : 3000;
  i > 0 ? lo = max(lo, ceil(slider(hr_sx1 + i - 1) * 1.25));
  i < 3 ? hi = min(hi, floor(slider(hr_sx1 + i + 1) / 1.25));
  hr_xlo = lo;
  hr_xhi = hi < lo ? lo : hi;
);

function hr_uixset(i, f) (
  hr_uixlim(i);
  f = floor(max(hr_xlo, min(hr_xhi, f)) + 0.5);
  f != slider(hr_sx1 + i) ? tt_slset(hr_sx1 + i, f);
);

// Weichenregler: Werte ausserhalb der Nachbargrenzen werden abgefangen (auch der Doppelklick-Default).
function hr_uixkn(x, y, i) local(sl, v, nv) (
  sl = hr_sx1 + i;
  v = slider(sl);
  hr_uixlim(i);
  nv = knob2st(sl, x, y, 11, v, i == 0 ? 20 : i == 1 ? 40 : i == 2 ? 100 : 400,
               i == 0 ? 400 : i == 1 ? 1000 : i == 2 ? 4000 : 12000, hr_xdf, 1);
  nv != v ? hr_uixset(i, nv);
  gfx_setfont(3);
  colDim(0.85);
  sprintf(#hr_ui2, "X%d", i + 1);
  xctrfit(x - 27, y - 25, 54, 12, #hr_ui2);
  v = slider(sl);
  v >= 1000 ? sprintf(#hr_ui3, "%.2fk", v / 1000) : sprintf(#hr_ui3, "%.0f", v);
  colInk(0.95);
  xctrfit(x - 27, y + 13, 54, 12, #hr_ui3);
  tt_hov(x - 19, y - 27, 38, 52, "Crossover in Hz. Cannot pass its neighbours: keeps at least a third (x1.25) apart. Also draggable in the display.");
);

// Display. hz_view: 0 SPECTRUM, 1 BALANCE, 2 SCOPE (Bedienzustand, nicht gespeichert).
function hr_uiana(x, y, w, h) local(px, py, pw, ph, i, f, gx, hit, k, x0, x1, g, foc, nearx, tgt, my, yy, act, lgx, hy) (
  card(x, y, w, h);
  ukf_sec(x + 12, y + 6, "BEFORE / AFTER", "");
  hz_view = floor(max(0, min(2, hz_view)) + 0.5);
  hz_view = ukf_segrow(x + w - 312, y + 4, 300, 20, 3, hz_view, "SPECTRUM|BALANCE|SCOPE");
  tt_hov(x + w - 312, y + 4, 300, 20, "SPECTRUM: input (grey) and output (green). BALANCE: tonal change, output minus input, averaged. SCOPE: level over the last 3 seconds.");
  gfx_setfont(3);
  colInk(0.35);
  xrect(x + 200, y + 10, 14, 8);
  colDim(0.85);
  xstr(x + 218, y + 8, "BEFORE");
  colAcid(1);
  xrect(x + 280, y + 13, 14, 2);
  xstr(x + 298, y + 8, "AFTER");

  px = x + 12; py = y + 28; pw = w - 24; ph = h - 38;
  ukf_well(px, py, pw, ph);
  // Mittelungs-Zeitkonstanten aus der echten Frame-Zeit: avg ~0.5 s, lng ~5 s (grok-Review F12)
  hz_dt = time_precise() - hz_tlast;
  hz_tlast = time_precise();
  hz_dt = (hz_dt > 0 && hz_dt < 0.25) ? hz_dt : 0.033;
  hz_ca = 1 - exp(0 - hz_dt / 0.5);
  hz_cl = 1 - exp(0 - hz_dt / 5);
  hz_spec(hz_rpre, hz_dpre, hz_apre, hz_lpre);
  hz_spec(hz_rpost, hz_dpost, hz_apost, hz_lpost);
  hz_tsel = floor(max(0, min(7, hz_tsel)) + 0.5);
  (hz_tsel == 7 && !hz_hasl) ? hz_tsel = 0;
  hz_learnon ? ( hz_learn(); hz_hasl ? hz_tsel = 7; );
  hz_view == 0 ? hz_drawspec(px + 1, py + 1, pw - 2, ph - 2)
  : hz_view == 1 ? ( hz_tsel > 0 ? hz_drawtarget(px + 1, py + 1, pw - 2, ph - 2, hz_tsel) : hz_drawdiff(px + 1, py + 1, pw - 2, ph - 2); )
  : hz_drawscope(px + 1, py + 1, pw - 2, ph - 2);

  hz_view == 1 ? (
    // Ziel waehlen, LEARN, MATCH.
    k = ukf_segrow(x + 350, y + 4, w - 350 - 322, 20, 8, hz_tsel, "OFF|TECHNO|ACID|HOUSE|DNB|DUBSTEP|TRANCE|LEARNED");
    (k == 7 && !hz_hasl) ? k = hz_tsel;
    k != hz_tsel ? ( hz_tsel = k; tt_undo(); );
    tt_hov(x + 350, y + 4, w - 350 - 322, 20, "Target curve. OFF shows output minus input. Genre curves are rough hand-made starting points, not measured references. LEARNED is a curve taken from your own reference track (LEARN).");
    btn(px + 8, py + ph - 50, 70, 20, hz_learnon, hz_learnon ? "LEARNING" : "LEARN") ? (
      hz_learnon = !hz_learnon;
      !hz_learnon ? tt_undo();
    );
    tt_hov(px + 8, py + ph - 50, 70, 20, "Play a reference track through the plugin and press LEARN. Its long-term tonal balance (input side) becomes the LEARNED target. Press again to stop. Needs about 10 seconds of music with the window open.");
    // Argon-Review B4: Vorschlag dieses Frames vor MATCH rechnen (hz_noval aktuell), nicht nach dem Setzen der Gains.
    hz_tsel > 0 ? hz_bandsug();
    (hz_tsel > 0 && btn(px + 84, py + ph - 50, 70, 20, 0, "MATCH")) ? ( hz_match(); tt_undo(); );
    hz_tsel > 0 ? tt_hov(px + 84, py + ph - 50, 70, 20, "Applies the MATCH values shown above each band: the five band GAIN trims move 80 percent of the way to the target (limit plus or minus 12 dB). Let the music play a few seconds, then press again to refine. Undo with Ctrl+Z.");
  );

  hz_view < 2 ? (
    // Bandzonen: Name, gehoerte Aenderung, Klick = Fokus.
    foc = floor(slider(hr_sfoc) + 0.5);
    nearx = 0;
    // BALANCE mit Ziel: Vorschlag je Band (was MATCH taete) statt der gehoerten Aenderung.
    tgt = hz_view == 1 && hz_tsel > 0;
    k = 0;
    loop(5,
      x0 = k == 0 ? px + 1 : hz_x(hz_xe(k - 1), px + 1, pw - 2);
      x1 = k == 4 ? px + pw - 1 : hz_x(hz_xe(k), px + 1, pw - 2);
      // 0.7.1: Zonen in den Bandfarben (wie TT-HOTT): leichte Toenung, Farbstreifen oben, Name in der Bandfarbe.
      hr_zc(k, 0, foc == k ? 0.10 : 0.035); xrect(x0, py + 1, max(1, x1 - x0), ph - 2);
      hr_zc(k, 0, foc == k ? 0.95 : 0.55); xrect(x0, py + 1, max(1, x1 - x0), 2);
      gfx_setfont(3);
      foc == k ? hr_zc(k, 0.15, 1) : hr_zc(k, 0, 0.8);
      hr_uibname(k);
      xctrfit(x0, py + 4, max(8, x1 - x0), 12, #hr_ui2);
      gfx_setfont(2);
      tgt ? (
        // Abweichung des Bands als waagrechter Balken auf Hoehe der Abweichung (+-12 dB wie die Kurve), Pfeil zur Ziellinie.
        g = max(-12, min(12, hz_bdv[k]));
        my = py + 1 + (ph - 2) * 0.5;
        yy = my - g / 12 * (ph - 2) * 0.5;
        colWhite(0.85);
        xrect(x0 + 6, yy - 1, max(1, x1 - x0 - 12), 3);
        abs(g) > 0.3 ? ( colWhite(0.35); xrect((x0 + x1) * 0.5, min(yy, my), 1, abs(yy - my)); );
        hz_noval ? (
          colDim(0.7);
          strcpy(#hr_ui3, "NO SIGNAL");
        ) : hz_mtime > time_precise() ? (
          colAcid(1);
          sprintf(#hr_ui3, "SET %+.1f", hz_mdone[k]);
        ) : abs(hz_sgv[k]) < 0.3 ? (
          colDim(0.7);
          strcpy(#hr_ui3, "ON TARGET");
        ) : (
          colWhite(0.95);
          sprintf(#hr_ui3, "MATCH %+.1f", hz_sgv[k]);
        );
      ) : (
        g = 0.5 * (hr_met[k * hr_metw + 4] + hr_met[k * hr_metw + 5]);
        abs(g) < 0.2 ? colDim(0.7) : g > 0 ? colAcid(1) : colWhite(0.9);
        sprintf(#hr_ui3, "%+.1f", g);
      );
      xctrfit(x0, py + 17, max(8, x1 - x0), 16, #hr_ui3);
      k += 1;
    );
    // Weichen: Griff oben (Name + Frequenz), Linie ueber die ganze Hoehe, ziehbar, Rechtsklick = Default.
    !uiLmb ? hz_drag = 0;
    i = 0;
    lgx = -1000; hy = 38;
    loop(4,
      f = hz_xe(i);
      gx = hz_x(f, px + 1, pw - 2);
      // Griffe, die sich ueberdecken wuerden, eine Zeile tiefer (abwechselnd)
      hy = (gx - lgx < 50) ? (hy == 38 ? 60 : 38) : 38;
      lgx = gx;
      hit = inBox(gx - 24, py + hy - 2, 48, 22) || inBox(gx - 5, py + 58, 10, ph - 58);
      hit ? nearx = 1;
      act = hz_drag == i + 1 || hit;
      act ? colAcid(1) : colAcid(0.6);
      xrect(gx, py + 58, act ? 2 : 1, ph - 59);
      f >= 1000 ? sprintf(#hr_ui3, "X%d %.1fk", i + 1, f / 1000) : sprintf(#hr_ui3, "X%d %.0f", i + 1, f);
      act ? colAcid(1) : colAcid(0.75);
      xrrect(gx - 24, py + hy, 48, 18, 3, 1);
      gfx_setfont(3);
      colBG();
      xctrfit(gx - 24, py + hy, 48, 18, #hr_ui3);
      (uiClick && hit && hz_drag == 0) ? ( hz_drag = i + 1; dragId = 7100 + i; );
      (uiRClk && hit) ? ( hr_uixlim(i); hr_uixset(i, hr_xdf); );
      (hz_drag == i + 1 && uiLmb) ? hr_uixset(i, hz_f(mX, px + 1, pw - 2));
      i += 1;
    );
    // Klick in eine Zone (nicht auf einer Weiche) fokussiert das Band.
    (uiClick && !nearx && hz_drag == 0 && inBox(px, py, pw, ph)) ? (
      f = hz_f(mX, px + 1, pw - 2);
      k = f < hz_xe(0) ? 0 : f < hz_xe(1) ? 1 : f < hz_xe(2) ? 2 : f < hz_xe(3) ? 3 : 4;
      k != floor(slider(hr_sfoc) + 0.5) ? tt_slset(hr_sfoc, k);
    );
    tgt ? tt_hov(px, py + 60, pw, ph - 60, "White bar per band: how far the output sits above (+) or below (-) the target in that band. MATCH +x: the band GAIN change MATCH would make. Press MATCH to apply all five.")
        : tt_hov(px, py + 60, pw, ph - 60, "Drag the X handles (top) to move the crossovers, right-click: default. Click a band to focus it. Numbers on top: what each band does to the sound now, in dB.");
  ) : (
    tt_hov(px, py, pw, ph, "Peak level over the last 3 seconds. Grey: input. Green: output. Upward compression lifts the quiet parts, downward pulls the loud parts in.");
  );
);

// Argon-Review B8: Bandbereich aus hz_xe (folgt dem Slider auch bei stehendem Audio-Thread), von hr20 hierher verlegt.
function hr_uifreq(k) local(f1, f2, f3, f4) (
  f1 = hz_xe(0);
  f2 = hz_xe(1);
  f3 = hz_xe(2);
  f4 = hz_xe(3);
  k == 0 ? sprintf(#hr_ui1, "<%.0f Hz", f1)
  : k == 1 ? sprintf(#hr_ui1, "%.0f-%.0f Hz", f1, f2)
  : k == 2 ? sprintf(#hr_ui1, "%.0f-%.0f Hz", f2, f3)
  : k == 3 ? sprintf(#hr_ui1, "%.0f-%.0f Hz", f3, f4)
  : sprintf(#hr_ui1, ">%.0f Hz", f4);
);

// Bandschwellen (0.3.0): liegen im Expert-Speicher hr_exp (Wort 0 = UP THR, Wort 2 = DN THR je Band), gelten in
// MACRO und EXPERT, werden mit Projekt und Preset gespeichert. Im EXPERT-Modus spiegeln die Slider hr_se0/hr_se0+2
// das fokussierte Band; dort wird auch der Slider gesetzt, sonst ueberschreibt hr_expsave den Wert.
function hr_uithr(k, idx, v) local(eb) (
  eb = hr_exp + k * hr_expw;
  v = floor(max(-80, min(0, v)) * 10 + 0.5) / 10;
  hr_uilock();   // 15.11.2026 (Review Astra F1): hr_params schreibt hr_exp im Audio-Thread
  eb[idx] = v;
  (slider(hr_smode) >= 0.5 && floor(slider(hr_sfoc) + 0.5) == k) ? tt_slset(hr_se0 + idx, v);
  hr_uiunlock();
  tt_sldirty = 1;
  hr_thpend = 1;
);

function hr_uithk(k, idx, x, y) local(eb, v, nv) (
  eb = hr_exp + k * hr_expw;
  v = eb[idx];
  nv = knob2st(8000 + k * 4 + idx, x, y, 14, v, -80, 0, idx == 0 ? hr_bdef[k * 5 + 0] : hr_bdef[k * 5 + 1], 0.1);
  nv != v ? hr_uithr(k, idx, nv);
  gfx_setfont(3);
  colDim(0.85);
  xctrfit(x - 27, y - 28, 54, 12, idx == 0 ? "UP THR" : "DN THR");
  sprintf(#hr_ui3, "%.1f", eb[idx]);
  colInk(0.95);
  xctrfit(x - 27, y + 16, 54, 12, #hr_ui3);
  tt_hov(x - 22, y - 30, 44, 60, idx == 0
    ? "Upward threshold of this band, dB. Quiet parts below it are lifted. Double-click: default."
    : "Downward threshold of this band, dB. Loud parts above it are pulled down. Lower = more compression, darker if set low on the high bands.");
);

// Bandspalte k: Name, Bereich, was das Band gerade tut (gross), Pegel, GAIN, UP/DOWN/SOLO/MUTE.
function hr_uicol(k, x, y, w, h) local(m, foc, act, ldb, gdb, mute, solo) (
  m = hr_met + k * hr_metw;
  foc = floor(slider(hr_sfoc) + 0.5) == k;
  mute = slider(hr_smute + k) >= 0.5;
  solo = slider(hr_ssolo + k) >= 0.5;
  act = (slider(hr_sbyp) < 0.5) && !mute && (hr_uiano ? solo : 1);
  hr_zk = k;   // 0.7.1: Balken, LED-Kette und Kennlinie in der Bandfarbe (wie TT-HOTT)
  card(x, y, w, h);
  foc ? ( hr_zc(k, 0, slider(hr_smode) >= 0.5 ? 1 : 0.75); xrect(x, y, w, 3); );
  hr_zc(k, 0, act ? 1 : 0.4);
  xrect(x + 10, y + 9, 3, 15);

  gfx_setfont(2);
  foc ? hr_zc(k, 0.15, 1) : act ? colWhite(0.96) : colDim(0.55);
  hr_uibname(k);
  xstr(x + 19, y + 8, #hr_ui2);
  gfx_setfont(3);
  colDim(0.8);
  hr_uifreq(k);
  xstr(x + 19, y + 28, #hr_ui1);
  mute ? strcpy(#hr_ui1, "MUTED") : solo ? strcpy(#hr_ui1, "SOLO") : foc ? strcpy(#hr_ui1, "FOCUS") : strcpy(#hr_ui1, "");
  foc ? hr_zc(k, 0, 1) : colDim(0.8);
  xrfit(x, y + 8, w - 12, 14, #hr_ui1);
  (uiClick && inBox(x, y, w, 44) && !foc) ? tt_slset(hr_sfoc, k);
  tt_hov(x, y, w, 44, "Click to focus this band (EXPERT edits the focused band).");

  // Front 0.7.0: links die grosse Zahl mit Status und Aktionsbalken, rechts die Kennlinie mit Live-Punkt,
  // darunter eine LED-Kette fuer den Bandpegel (vorher drei duenne Zeilen mit viel Leerraum).
  gdb = 0.5 * (m[4] + m[5]);
  ldb = max(-60, min(0, 0.5 * (m[0] + m[1])));
  gfx_setfont(2);
  !act ? colDim(0.5) : abs(gdb) < 0.2 ? colDim(0.75) : gdb > 0 ? hr_zc(k, 0, 1) : colWhite(0.95);
  sprintf(#hr_ui3, "%+.1f", gdb);
  xstr(x + 12, y + 50, #hr_ui3);
  gfx_setfont(3);
  colDim(0.7);
  xstr(x + 12, y + 72, "dB");
  !act ? strcpy(#hr_ui1, "OFF") : gdb > 0.2 ? strcpy(#hr_ui1, "LIFTED") : gdb < -0.2 ? strcpy(#hr_ui1, "PULLED DOWN") : strcpy(#hr_ui1, "UNTOUCHED");
  gdb > 0.2 && act ? hr_zc(k, 0, 0.9) : colDim(0.85);
  xstr(x + 12, y + 86, #hr_ui1);
  hr_uigbar(x + 12, y + 102, 96, 10, gdb, 18);
  tt_hov(x + 8, y + 46, 104, 70, "What this band does to the sound right now: band colour lifts quiet detail, white pulls loud parts down.");
  hr_uiminic(x + 116, y + 46, w - 128, 66, k);

  colDim(0.7);
  xstr(x + 12, y + 120, "LEVEL");
  hr_uihled(x + 56, y + 120, w - 68, 10, ldb, -60, 0);
  tt_hov(x + 8, y + 116, w - 16, 18, "Band input level, -60 to 0 dB.");

  hr_uikn(x + 38, y + 160, 14, hr_sg + k, slider(hr_sg + k), -24, 24, 0, 0.1, "GAIN", "%+.1f", "Band output trim in dB.");
  hr_uithk(k, 0, x + w * 0.5, y + 160);
  hr_uithk(k, 2, x + w - 38, y + 160);
  hr_uitg(x + 10, y + 192, (w - 32) * 0.25, 22, hr_supon + k, slider(hr_supon + k), "UP", "Upward compression: lifts quiet parts of this band.");
  hr_uitg(x + 14 + (w - 32) * 0.25, y + 192, (w - 32) * 0.25, 22, hr_sdnon + k, slider(hr_sdnon + k), "DOWN", "Downward compression: pulls loud parts of this band down.");
  hr_uitg(x + 18 + (w - 32) * 0.5, y + 192, (w - 32) * 0.25, 22, hr_ssolo + k, slider(hr_ssolo + k), "SOLO", "Solo this band.");
  hr_uitg(x + 22 + (w - 32) * 0.75, y + 192, (w - 32) * 0.25, 22, hr_smute + k, slider(hr_smute + k), "MUTE", "Mute this band.");
  hr_zk = -1;
);

// EXPERT-Leiste fuer das fokussierte Band (ersetzt die Makros, die in EXPERT nicht wirken).
function hr_uiexp(x, y, w, h) local(k, eb, v0, v2) (
  k = floor(slider(hr_sfoc) + 0.5);
  card(x, y, w, h);
  hr_uibname(k);
  sprintf(#hr_ui1, "EXPERT // %s", #hr_ui2);
  ukf_sec(x + 12, y + 8, #hr_ui1, "");
  // Argon-Review B7: Vorgaben je Band; Schwellen zusaetzlich in hr_exp, damit die Bandspalte bei stehendem Audio mitgeht.
  eb = hr_exp + k * hr_expw;
  v0 = slider(hr_se0);
  v2 = slider(hr_se0 + 2);
  hr_uikn(x + 36, y + 92, 15, hr_se0, slider(hr_se0), -80, 0, hr_bdef[k * 5 + 0], 0.1, "UP THR", "%.1f", "Upward threshold of the focused band, dB. Below it the band is lifted.");
  hr_uikn(x + 96, y + 92, 15, hr_se0 + 1, slider(hr_se0 + 1), 1, 20, 1.23, 0.01, "UP RAT", "%.2f", "Upward ratio. 20 is the steepest slope.");
  hr_uikn(x + 156, y + 92, 15, hr_se0 + 2, slider(hr_se0 + 2), -80, 0, hr_bdef[k * 5 + 1], 0.1, "DN THR", "%.1f", "Downward threshold of the focused band, dB. Above it the band is pulled down.");
  hr_uikn(x + 216, y + 92, 15, hr_se0 + 3, slider(hr_se0 + 3), 1, 1000, 1.27, 0.01, "DN RAT", "%.2f", "Downward ratio. 1000 is a hard slope.");
  hr_uikn(x + 276, y + 92, 15, hr_se0 + 4, slider(hr_se0 + 4), 0.1, 200, hr_bdef[k * 5 + 2], 0.1, "ATTACK", "%.1f", "Attack of the focused band, milliseconds.");
  hr_uikn(x + 336, y + 92, 15, hr_se0 + 5, slider(hr_se0 + 5), 1, 2000, hr_bdef[k * 5 + 3], 1, "RELEASE", "%.0f", "Release of the focused band, milliseconds.");
  hr_uikn(x + 396, y + 92, 15, hr_se0 + 6, slider(hr_se0 + 6), -24, 24, hr_bdef[k * 5 + 4], 0.1, "MAKEUP", "%+.1f", "Make-up of the focused band, dB.");
  // 0.7.1 (grok-bot N2/N3): Doppelklick-Vorgabe = Band-Make-up; hr_exp unter der Sperre wie in hr_uithr.
  (slider(hr_se0) != v0 || slider(hr_se0 + 2) != v2) ? (
    hr_uilock();
    slider(hr_se0) != v0 ? ( eb[0] = slider(hr_se0); hr_thpend = 1; );
    slider(hr_se0 + 2) != v2 ? ( eb[2] = slider(hr_se0 + 2); hr_thpend = 1; );
    hr_uiunlock();
  );
  hr_uicurve(x + 432, y + 26, w - 444, h - 36, k);
);
