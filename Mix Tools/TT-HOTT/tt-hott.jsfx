// GENERIERT von build_hott.py aus ht_spec.py / presets.json - nicht von Hand aendern.
HT_NFAC = 30;
function ht_fnames() (
  tt_pb_fname(0, "Init");
  tt_pb_fname(1, "Classic 100");
  tt_pb_fname(2, "Gentle Lift");
  tt_pb_fname(3, "Bus Glue 30");
  tt_pb_fname(4, "Drum Smack");
  tt_pb_fname(5, "Kick Punch");
  tt_pb_fname(6, "Bass Tighten");
  tt_pb_fname(7, "Vocal Air");
  tt_pb_fname(8, "Synth Wide");
  tt_pb_fname(9, "Hat Shine");
  tt_pb_fname(10, "Pad Bloom");
  tt_pb_fname(11, "Parallel 50");
  tt_pb_fname(12, "Dubstep Growl");
  tt_pb_fname(13, "Transient Keep");
  tt_pb_fname(14, "Tame Harsh");
  tt_pb_fname(15, "Sidechain Duck");
  tt_pb_fname(16, "Mix Bus Gentle");
  tt_pb_fname(17, "Drum Bus Parallel");
  tt_pb_fname(18, "Acoustic Room");
  tt_pb_fname(19, "Vocal Even");
  tt_pb_fname(20, "Master Polish");
  tt_pb_fname(21, "Podcast Voice");
  tt_pb_fname(22, "Bass Mid Push");
  tt_pb_fname(23, "Bass Bus Split");
  tt_pb_fname(24, "Techno Kick Bus");
  tt_pb_fname(25, "Techno Rumble");
  tt_pb_fname(26, "Hypnotic Tops");
  tt_pb_fname(27, "Warehouse Smash");
  tt_pb_fname(28, "Dub Techno Space");
  tt_pb_fname(29, "Techno Master");
);
// ht28_init_core.jsfx — @init-Anweisungen des Klangkerns.
// Steht nach ht05/ht06/ht10/ht14/ht24/ht26 im @init-Abschnitt (alle Funktionen definiert).
// @init laeuft bei Instanziierung, Samplerate-Wechsel und jedem Transportstart erneut:
// Bedienzustand gibt es im Klangkern nicht, die Erst-Fuellung der Tabellen steht im Waechter.

// Konstanten (idempotente Zuweisungen)
ht_k   = sqrt(2);                        // Butterworth-Daempfung k = 1/Q (LR4, Orakel A9)
ht_msf = 0.70710678;                     // M/S-Matrixfaktor (MODEL.md 1)
DNRM   = 0.00000000000000000001;         // Denormal-Offset der SVF-Zustaende (Muster der Kick-Weiche der Serie)

// Erst-Init-Waechter (nur einmal je Instanz): CLASSIC-Tabellen aendern sich nie
ht_rst = ht_ini1 != 1 || srate != ht_srst;      // Zustaende nur beim ersten Lauf oder Samplerate-Wechsel leeren
ht_ini1 != 1 ? (
  ht_ini1 = 1;
  ht_consts();
);

// PDC-Meldung: nur die Ausgabekanaele 0/1; die Sidechain-Pins 3/4 laufen
// unverzoegert durch (pdc_top_ch exklusiv, Stereo = 2)
pdc_bot_ch = 0;
pdc_top_ch = 2;

// Zustaende zuruecksetzen NUR beim ersten Lauf oder Samplerate-Wechsel. @init laeuft aber bei jedem
// Transportstart (Suite-Regel P25 / Opus-Gegenpruefung 2026-10-07): sonst springt AUTO GAIN bei jedem Start auf 0 dB
// zurueck und Filter/Huellkurven/Ringe werden mitten im Klang geleert.
ht_rst ? (
  ht_srst = srate;
  ht_wp = 0; ht_laN = 0; ht_laW = 0;
  ht_f1 = 0; ht_f2 = 0; ht_srp = 0;        // erzwingt den Weichen-Neubau in ht_params
  ht_useSC = 0; ht_scu = 0;
  ht_agI = 0; ht_agW = 0; ht_agG = 0; ht_agAm = 0; ht_msk = 0;
  ht_pkI0 = 0; ht_pkI1 = 0; ht_pkO0 = 0; ht_pkO1 = 0; ht_ns = 0;
  ht_hI0 = 0; ht_hI1 = 0; ht_hO0 = 0; ht_hO1 = 0; ht_hLm = 1; ht_mack = 0; ht_lsg = 0;
  ht_scpk = 0; ht_scn = 0; ht_pdcP = -1; ht_lonP = -1; ht_lDP = -1; ht_lmn = 1; ht_lgn = 1; ht_lsum = 0; ht_lw = 0; ht_bmP = -1;
  memset(HT_SV, 0, 112);                   // 2 Kanaele x 7 Filter x 8 Slots
  memset(HT_SVS, 0, 112);
  memset(HT_SVD, 0, 112);
  memset(HT_DLY, 0, 8*HT_DLW);
  memset(HT_SCRING, 0, 2*HT_DLW);             // 0.3.0: SC-LISTEN-Ring (A1)
  memset(HT_BND, 0, 6);
  memset(HT_BNDD, 0, 6);
  memset(HT_BNDS, 0, 6);
  memset(HT_ENV, 0, 6);
  memset(HT_BON, 0, 3);
  memset(HT_BONS, 0, 3);
  memset(HT_SMT, 0, 6);
  memset(HT_BMS, 0, 3);
  memset(HT_LST, 0, 24);
  // Meter-Ruhepegel: E auf -200 dB (Boden aus MODEL.md 3), der Rest bleibt 0
  ht_j = 0;
  loop(3,
    ht_lb = HT_LST + ht_j*8;
    ht_lb[0] = -200; ht_lb[1] = -200;
    ht_j += 1;
  );
);

// Alle Slider -> Koeffizienten (baut Weiche/Zeiten/Ziele, meldet Latenz ueber ht_pdc)
ht_expP = 0;
ht_params();
ht_expP = ht_expert; ht_xf = 1;          // kein Ueberblenden beim Laden
pdc_delay = ht_pdcP;                     // @init-Neulauf: Latenzmeldung erneuern (ht_pdc setzt sie nur bei Aenderung)

// Geglaettete Groessen beim ersten Lauf/Samplerate-Wechsel sofort auf den Zielwert (kein Einblenden beim Laden)
ht_rst ? (
  ht_ia = ht_iaT; ht_oa = ht_oaT; ht_mix = ht_mixT; ht_bx = ht_bxT;
  HT_SMT[0] = HT_SMT[3]; HT_SMT[1] = HT_SMT[4]; HT_SMT[2] = HT_SMT[5];
  HT_BONS[0] = HT_BON[0]; HT_BONS[1] = HT_BON[1]; HT_BONS[2] = HT_BON[2];
  ht_msk = (HT_BON[0] + HT_BON[1] + HT_BON[2] < 2.5) ? 1 : 0;      // Codex-Befund: sonst kommt nach Samplerate-Wechsel kurz unmaskierter Eingang durch
);
// ht29_init_ui.jsfx — UI-Init der Front (laeuft im @init nach ht28_init_core).
// Einmaliges: Schema, Preset-Bank, Front-Speicher, Bedienzustand im Erst-Init-Waechter.

// Schema aus dem Farbslider anwenden (sliderCOLOR = slider63, Vertrag 5.1)
tth_sync(slider63);

// Preset-Bank hinter dem Klangkern-Speicher; tt_pb_init belegt die Bank und
// setzt tt_pb_end = erste freie Adresse (darauf baut die Front ihren Speicher).
HT_BANK = HT_END;
tt_pb_init(HT_NFAC, 32, HT_BANK, HT_PSW);
ht_fnames();

// Front-Speicher: Kurven-LUT, Anzeigezustand, Feld-Vorgaben (Karte siehe ht20_ui_funcs)
HT_CRV = tt_pb_end;
HT_UST = HT_CRV + 384;
HT_UDF = HT_UST + 40;
HT_HSH = HT_UDF + 21;                    // 3 x 14 Worte: zuletzt gebackene Aufloesung je Band (Kurven-LUT, wortweiser Vergleich)

// Bedienzustand nur beim ersten @init (der laeuft bei jedem Transportstart erneut): Tab-Wahl, Meter-/Kurven-Zustand,
// Feld-Vorgaben. ht_fdefaults() schreibt HT_PV und gehoert in den Waechter (sonst Mischpreset, wenn ein Transportstart
// zeitgleich zu ht_fload/ht_pbApplyPV im @gfx laeuft - Opus-Gegenpruefung).
ht_ui1 != 1 ? (
  ht_ui1 = 1;
  ht_tab = 0;                            // 0 = EXPERT VALUES, 1 = SYSTEM
  memset(HT_UST, 0, 40);
  HT_UST[6] = 0 - 120;                   // smE unter den Boden -> Anzeige startet leer
  HT_UST[14] = 0 - 120;
  HT_UST[22] = 0 - 120;
  ht_uk = 24;
  loop(12, HT_UST[ht_uk] = 0 - 120; ht_uk += 1; );   // IN/OUT-Pegel und Halte-Marken starten bei stumm, nicht bei 0 dBFS
  memset(HT_CRV, 0, 384);
  // Feld-Vorgaben je Band aus der generierten INIT-Tabelle spiegeln (kein Duplikat der Zahlen aus ht_spec.py)
  ht_fdefaults();
  ht_uk = 0;
  loop(3,
    ht_ub = HT_S_BAND0 + ht_uk*HT_S_BANDW;
    HT_UDF[ht_uk*7 + 0] = HT_PV[ht_ub + HT_F_UPTHR];
    HT_UDF[ht_uk*7 + 1] = HT_PV[ht_ub + HT_F_UPRATIO];
    HT_UDF[ht_uk*7 + 2] = HT_PV[ht_ub + HT_F_DNTHR];
    HT_UDF[ht_uk*7 + 3] = HT_PV[ht_ub + HT_F_DNRATIO];
    HT_UDF[ht_uk*7 + 4] = HT_PV[ht_ub + HT_F_ATTACK];
    HT_UDF[ht_uk*7 + 5] = HT_PV[ht_ub + HT_F_RELEASE];
    HT_UDF[ht_uk*7 + 6] = HT_PV[ht_ub + HT_F_MAKEUP];
    ht_uk += 1;
  );
);

// ---------- Preset-Kleber (Preset-Zustand = Slider 1..62 ohne Farbe, Tabelle HT_PV) ----------
// Anwenden laeuft NUR ueber tt_slset (setzt tt_sldirty -> @block ruft ht_params).

// HT_PV-Tabelle -> Slider 1..62 (Werks-Presets schreiben die Tabelle ueber ht_fload)
// 0.2.3 (B12): ht_slq schreibt wie tt_slset, setzt aber tt_sldirty NICHT; die Sammelfunktionen setzen es einmal am Ende,
// damit ein dazwischen laufender @block nie einen Mischzustand aus altem und neuem Preset sieht.
function ht_slq(n, v) (
  abs(slider(n) - v) > 0.0000001 ? ( slider(n) = v; slider_automate(2^(n - 1)); 1; ) : 0;
);

function ht_pbApplyPV() local(n, ch) (
  n = 1; ch = 0;
  loop(62, ch |= ht_slq(n, HT_PV[n]); n += 1; );
  ch ? ( tt_sldirty = 1; );   // 0.2.0: 10 = MAKEUP, 61 = BANDS ON, 62 = CEILING sind belegt
);

// Nach dem Laden eines Werks-Presets: prueft einige Frames lang, ob die Slider wirklich die Preset-Werte tragen, und schreibt
// abweichende nochmals (Absicherung gegen ein Zurueckschreiben durch den Host; Nutzerbefund 08.10.2026: Klang geaendert, Front nicht).
function ht_pbVerify() local(n, bad) (
  n = 1; bad = 0;
  loop(62,
    abs(slider(n) - HT_PV[n]) > 0.0001 ? ( ht_slq(n, HT_PV[n]); bad += 1; );
    n += 1;
  );
  bad ? ( tt_sldirty = 1; );
  bad;
);

// Anwender-Slot (tt_pb_buf, Layoutversion in [0]) -> Slider 1..62.
// tt_slset begrenzt nicht auf den Sliderbereich: die Presets liefern nur gueltige Werte.
// 0.9.10 (Review 14.11.2026): ein Slot mit einem nicht endlichen oder absurd grossen Wert (beschaedigter Chunk) wird ganz
// verworfen, bevor der erste Slider geschrieben ist. Grenzabfrage mit > und <, weil < und == mit NaN in EEL2 wahr sind.
// Die Bereiche der einzelnen Slider prueft das nicht; Verhaeltnis und Weichenfrequenz sichert der Klangkern selbst (ht_resband, ht_svc).
function ht_pbApply() local(n, ch, ok) (
  n = 1; ok = 1;
  loop(62, (tt_pb_buf[n] > -1000000 && tt_pb_buf[n] < 1000000) ? 0 : ( ok = 0; ); n += 1; );
  n = 1; ch = 0;
  ok ? (
  loop(62, ch |= ht_slq(n, tt_pb_buf[n]); n += 1; );
  // Anwender-Presets der Layoutversion 1 (0.1.x) kennen MAKEUP/BANDS ON/CEILING nicht: Vorgaben setzen
  tt_pb_buf[0] < 2 ? ( ch |= ht_slq(HT_S_MKUP, 100); ch |= ht_slq(HT_S_BANDS, 7); ch |= ht_slq(HT_S_CEIL, 0 - 0.3); );
  );
  ch ? ( tt_sldirty = 1; );
);

// Slider 1..62 -> tt_pb_buf (Wort 0 = Layoutversion 1)
function ht_pbCapture() local(n) (
  memset(tt_pb_buf, 0, HT_PSW);
  tt_pb_buf[0] = 2;
  n = 1;
  loop(62, tt_pb_buf[n] = slider(n); n += 1; );
);

// INIT des Preset-Menues: generierte Werkvorgaben anwenden
function ht_pbInit() (
  ht_fdefaults();
  ht_pbApplyPV();
);

// Pruefsumme des Preset-Zustands fuer den geaendert-Stern (tt_pb_track)
function ht_pbSum() local(s, n) (
  s = 0; n = 1;
  loop(62, s += slider(n)*n; n += 1; );
  s;
);

// ---------- 0.2.0 (P29-07): neue UI-Zustaende ----------
// HT_PKU (3 Worte direkt hinter HT_HSH): [0] PEAK IN, [1] PEAK OUT = hoechste Block-Spitze
// seit dem letzten Klick auf das Feld im IN/OUT-Panel (dBFS, beide Kanaele); [2] gehaltene
// Begrenzer-Reduktion LIM in dB (<= 0, Abfall 10 dB/s in ht_msmooth). Kein Preset-Inhalt.
HT_PKU = HT_HSH + 42;
ht_ui2 != 1 ? (
  ht_ui2 = 1;
  memset(HT_PKU, 0 - 120, 2);     // starten stumm -> Anzeige "-inf"
  HT_PKU[2] = 0;                  // keine Begrenzung
);

// ---------- 0.3.0: EIN Klang, zwei Ansichten (Nutzerbefund 15.10.2026) ----------
// Bis 0.2.7 waren CLASSIC und EXPERT zwei getrennte Wertesaetze: der Moduswechsel schaltete hart auf den anderen Satz
// um (anderer Klang), nur der Knopf SNAPSHOT kopierte CLASSIC -> EXPERT, zurueck ging nichts. Seit 0.3.0 traegt der
// Klick auf CLASSIC/EXPERT den Klang mit:
//   CLASSIC -> EXPERT: die aufgeloesten Zahlen der Makros wandern in die EXPERT-Felder (ht_snapshot, exakt bis auf UP MAX
//     <= 0,4 dB bei Extrempegeln). Kam man gerade aus EXPERT und hat die Makros nicht angefasst, kommen stattdessen die
//     vorigen EXPERT-Werte unveraendert zurueck (Sicherung, auch Attack/Weiche/Knie) - hin und her ist verlustfrei.
//   EXPERT -> CLASSIC: ht_tofit sucht die Makros (DEPTH, TIME, UP, DOWN, MAKEUP, THRESH je Band), die die EXPERT-Kennlinien
//     am besten treffen, und meldet die Restabweichung im HINT (CLASSIC hat weniger Freiheitsgrade: Attack, Knie und Weiche
//     sind dort fest, Verhaeltnisse gelten fuer alle Baender gemeinsam). Passen die Makros schon, bleiben sie stehen.
// Ein Moduswechsel per Automation/Host-Parameter (ohne Klick) schaltet weiter direkt um (Presets setzen MODE mit ihren Werten).
// THREAD-SICHERHEIT: alles hier laeuft nur im @gfx-Thread und nutzt eigene Helfer (wie ht_snapshot), nichts aus @sample/@block.
//
// HT_XBK (96 Worte, ht10_mem):
//   [0..20]  Sicherung EXPERT je Band k*7 + (up_thr, up_ratio, dn_thr, dn_ratio, attack, release, makeup)
//   [21..24] Sicherung KNEE, UP MAX, X1, X2
//   [32..39] Fingerabdruck der von ht_tofit geschriebenen Makros: DEPTH, TIME, UP, DOWN, MAKEUP, THRESH L/M/H
//   [40..55] Scratch-Aufloesung EXPERT, [56..71] Scratch-Aufloesung CLASSIC (HT_R_*-Indizes)
//   [72..92] Ziele je Band k*7 + (UT, DT, Upward-Slope, Downward-Slope, Release ms, Make-up dB, Attack ms)
//   [93..95] gefundene THRESH-Werte (%)
// ht_xbv = 1: Sicherung gueltig (geloescht bei Preset/INIT/Anwender-Preset und beim Projektladen).

function ht_gfd(x) local(i) (                     // fdstr (MODEL.md 6), stueckweise linear
  x <= HT_CFDX[0] ? HT_CFDY[0] : x >= HT_CFDX[6] ? HT_CFDY[6] : (
    i = 0;
    loop(5, x > HT_CFDX[i + 1] ? ( i += 1; ); );
    HT_CFDY[i] + (x - HT_CFDX[i])*(HT_CFDY[i + 1] - HT_CFDY[i])/(HT_CFDX[i + 1] - HT_CFDX[i]);
  );
);
function ht_gfdi(y) local(i) (                    // Umkehrung von fdstr (streng steigend)
  y <= HT_CFDY[0] ? HT_CFDX[0] : y >= HT_CFDY[6] ? HT_CFDX[6] : (
    i = 0;
    loop(5, y > HT_CFDY[i + 1] ? ( i += 1; ); );
    HT_CFDX[i] + (y - HT_CFDY[i])*(HT_CFDX[i + 1] - HT_CFDX[i])/(HT_CFDY[i + 1] - HT_CFDY[i]);
  );
);
function ht_gmk(k, d) local(p) ( p = HT_CMKSH + k*3; d*(p[0] + d*(p[1] + d*p[2])); );   // mkshape
function ht_gdn(k, d) local(p) ( p = HT_CDNSH + k*3; d*(p[0] + d*(p[1] + d*p[2])); );   // dnshape
function ht_gtr(k, tp) local(pct, p, tr) (        // CLASSIC-Release in ms bei TIME tp %
  pct = min(100, max(0, tp)); p = HT_CTR + k*3;
  tr = pct <= 50 ? p[0] + (p[1] - p[0])*pct/50 : p[1] + (p[2] - p[1])*(pct - 50)/50;
  tr*max(1, tp*0.01)*1000;
);
// Kennlinie gdb(E) einer Scratch-Aufloesung (gleiche Formel wie ht_gdb, MODEL.md 4)
function ht_ggr(rb, E) local(z, w, up, dn) (
  w = rb[HT_R_UPKNEE]; z = rb[HT_R_UPTHR] - E;
  up = rb[HT_R_UPSLOPE]*(w > 0 ? max(z, 0) + w*log(1 + exp(0 - abs(z)/w)) : max(z, 0));
  up = min(rb[HT_R_UPMAX], up);
  w = rb[HT_R_DNKNEE]; z = E - rb[HT_R_DNTHR];
  dn = rb[HT_R_DNSLOPE]*(w > 0 ? max(z, 0) + w*log(1 + exp(0 - abs(z)/w)) : max(z, 0));
  max(rb[HT_R_FLOOR], rb[HT_R_MAKEUP] + up - dn);
);
// EXPERT-Aufloesung von Band k aus den Slidern (wie ht_resband, expert = 1)
function ht_gxres(rb, k) local(b, s, kn) (
  b = HT_S_BAND0 + k*HT_S_BANDW; kn = slider(HT_S_KNEE)*0.01;
  rb[HT_R_UPTHR] = slider(b + HT_F_UPTHR);
  s = slider(b + HT_F_UPRATIO); rb[HT_R_UPSLOPE] = slider(b + HT_F_UPON) >= 0.5 ? 1 - 1/max(1, s) : 0;
  rb[HT_R_UPKNEE] = HT_CWU[k]*kn; rb[HT_R_UPMAX] = slider(HT_S_UPMAX);
  rb[HT_R_DNTHR] = slider(b + HT_F_DNTHR);
  s = slider(b + HT_F_DNRATIO); rb[HT_R_DNSLOPE] = slider(b + HT_F_DNON) >= 0.5 ? (s >= 1000 ? 1 : 1 - 1/max(1, s)) : 0;
  rb[HT_R_DNKNEE] = HT_CWD[k]*kn; rb[HT_R_FLOOR] = HT_CGM[k];
  rb[HT_R_MAKEUP] = slider(b + HT_F_MAKEUP);
);
// CLASSIC-Aufloesung von Band k fuer gegebene Makros (d 0..1, U/Dn/mk/pp in %; wie ht_resband, expert = 0)
function ht_gcres(rb, k, d, U, Dn, mk, pp) local(b, tsh) (
  b = HT_S_BAND0 + k*HT_S_BANDW; tsh = (pp*0.01 - 1)*HT_CTS[k];
  rb[HT_R_UPTHR] = HT_CTU[k] + tsh;
  rb[HT_R_UPSLOPE] = slider(b + HT_F_UPON) >= 0.5 ? max(0, d)*max(0, U*0.01)*HT_CSU[k] : 0;
  rb[HT_R_UPKNEE] = HT_CWU[k]; rb[HT_R_UPMAX] = HT_CCU[k];
  rb[HT_R_DNTHR] = HT_CTD[k] + tsh;
  rb[HT_R_DNSLOPE] = slider(b + HT_F_DNON) >= 0.5 ? min(1, ht_gdn(k, d)*ht_gfd(Dn*0.01)) : 0;
  rb[HT_R_DNKNEE] = HT_CWD[k]; rb[HT_R_FLOOR] = HT_CGM[k];
  rb[HT_R_MAKEUP] = ht_gmk(k, d)*HT_CMK[k]*mk*0.01;
);
// Fehlermass Makros <-> EXPERT-Ziele (dB^2): Make-up, Upward-Gewinn 24 dB unter der Schwelle, Downward-Abzug 12 dB darueber
function ht_gerr(d, U, Dn, mk) local(k, q, e, a, c) (
  e = 0; k = 0;
  loop(3,
    q = HT_XBK + 72 + k*7;
    a = ht_gmk(k, d)*HT_CMK[k]*mk*0.01 - q[5];
    c = 24*(max(0, d)*U*0.01*HT_CSU[k] - q[2]);
    e += a*a + c*c;
    c = 12*(min(1, ht_gdn(k, d)*ht_gfd(Dn*0.01)) - q[3]);
    e += c*c;
    k += 1;
  );
  e;
);
// Zu DEPTH d die bestpassenden UP/DOWN/MAKEUP (Slider-Raster 1 %) -> ht_fbU, ht_fbDn, ht_fbMk; Rueckgabe = Fehlermass
function ht_gbest(d) local(k, q, f, sm, sw, m) (
  d <= 0.0005 ? (
    ht_fbU = slider(HT_S_UP); ht_fbDn = slider(HT_S_DOWN); ht_fbMk = slider(HT_S_MKUP);
  ) : (
    f = 0; k = 0;
    loop(3, f += (HT_XBK + 72 + k*7)[2]/HT_CSU[k]; k += 1; );
    ht_fbU = min(200, max(0, floor(100*f/3/d + 0.5)));
    f = 0; k = 0;
    loop(3, f += (HT_XBK + 72 + k*7)[3]/max(0.000001, ht_gdn(k, d)); k += 1; );
    ht_fbDn = min(200, max(0, floor(100*ht_gfdi(f/3) + 0.5)));
    sm = 0; sw = 0; k = 0;
    loop(3,
      q = HT_XBK + 72 + k*7;
      m = ht_gmk(k, d)*HT_CMK[k];
      sm += m*q[5]; sw += m*m;
      k += 1;
    );
    ht_fbMk = sw > 0.000001 ? min(200, max(0, floor(100*sm/sw + 0.5))) : slider(HT_S_MKUP);
  );
  ht_gerr(d, ht_fbU, ht_fbDn, ht_fbMk);
);

// EXPERT -> CLASSIC: Makros anpassen, EXPERT-Werte sichern, Modus umschalten, Ergebnis in #ht_xm (HINT, 8 s)
function ht_tofit() local(k, b, q, s, d, d0, db, eb, e, tp, tpb, t0, r, pp, pc, sh, dv, lv, rel, att, xo, n) (
  // Sicherung der EXPERT-Werte (fuer verlustfreies Zurueckschalten) und Ziele
  k = 0;
  loop(3,
    b = HT_S_BAND0 + k*HT_S_BANDW; q = HT_XBK + k*7;
    q[0] = slider(b + HT_F_UPTHR); q[1] = slider(b + HT_F_UPRATIO); q[2] = slider(b + HT_F_DNTHR);
    q[3] = slider(b + HT_F_DNRATIO); q[4] = slider(b + HT_F_ATTACK); q[5] = slider(b + HT_F_RELEASE);
    q[6] = slider(b + HT_F_MAKEUP);
    // Ziele (Verhaeltnisse unabhaengig von UP ON / DOWN ON, wie ht_snapshot)
    q = HT_XBK + 72 + k*7;
    q[0] = slider(b + HT_F_UPTHR); q[1] = slider(b + HT_F_DNTHR);
    q[2] = 1 - 1/max(1, slider(b + HT_F_UPRATIO));
    s = slider(b + HT_F_DNRATIO); q[3] = s >= 1000 ? 1 : 1 - 1/max(1, s);
    q[4] = max(1, slider(b + HT_F_RELEASE)); q[5] = slider(b + HT_F_MAKEUP); q[6] = slider(b + HT_F_ATTACK);
    k += 1;
  );
  HT_XBK[21] = slider(HT_S_KNEE); HT_XBK[22] = slider(HT_S_UPMAX); HT_XBK[23] = slider(HT_S_X1); HT_XBK[24] = slider(HT_S_X2);

  // 1. THRESH je Band: mittlere Schwellenverschiebung beider Zweige (CLASSIC verschiebt sie gemeinsam); der aktuelle Wert
  //    bleibt, wenn er nicht schlechter trifft (kein Wackeln beim Hin-und-her-Schalten)
  k = 0;
  loop(3,
    b = HT_S_BAND0 + k*HT_S_BANDW; q = HT_XBK + 72 + k*7;
    sh = ((q[0] - HT_CTU[k]) + (q[1] - HT_CTD[k]))*0.5;           // gewuenschte Verschiebung in dB
    pp = min(200, max(0, floor(100*(1 + sh/HT_CTS[k]) + 0.5)));
    pc = slider(b + HT_F_THRESH);
    abs((pc*0.01 - 1)*HT_CTS[k] - sh) <= abs((pp*0.01 - 1)*HT_CTS[k] - sh) + 0.01 ? ( pp = pc; );
    HT_XBK[93 + k] = pp;
    k += 1;
  );

  // 2. TIME: kleinster quadratischer log-Fehler der drei Release-Zeiten (Raster 1 %)
  t0 = slider(HT_S_TIME);
  eb = 0; k = 0;
  loop(3, r = log(ht_gtr(k, t0)/(HT_XBK + 72 + k*7)[4]); eb += r*r; k += 1; );
  tpb = t0; tp = 0;
  loop(1001,
    e = 0; k = 0;
    loop(3, r = log(ht_gtr(k, tp)/(HT_XBK + 72 + k*7)[4]); e += r*r; k += 1; );
    e < eb - 0.000001 ? ( eb = e; tpb = tp; );
    tp += 1;
  );

  // 3. DEPTH (Raster 0,1 %) mit UP/DOWN/MAKEUP: aktueller Stand zuerst, ersetzt nur bei echter Verbesserung
  d0 = slider(HT_S_DEPTH)*0.01;
  db = d0; ht_tU = slider(HT_S_UP); ht_tDn = slider(HT_S_DOWN); ht_tMk = slider(HT_S_MKUP);
  eb = ht_gerr(d0, ht_tU, ht_tDn, ht_tMk);
  n = 0;
  loop(1001,
    d = n*0.001;
    e = ht_gbest(d);
    e < eb - 0.0001 ? ( eb = e; db = d; ht_tU = ht_fbU; ht_tDn = ht_fbDn; ht_tMk = ht_fbMk; );
    n += 1;
  );

  // 4. Restabweichung der Kennlinien (E = -90..0 dB, 3-dB-Raster) zwischen EXPERT und den neuen Makros
  dv = 0; rel = 0; att = 0; k = 0;
  loop(3,
    ht_gxres(HT_XBK + 40, k);
    ht_gcres(HT_XBK + 56, k, db, ht_tU, ht_tDn, ht_tMk, HT_XBK[93 + k]);
    lv = 0 - 90;                                                 // Pegel (nicht "E": EEL2 kennt keine Gross-/Kleinschreibung, e ist der Fehler)
    loop(31, dv = max(dv, abs(ht_ggr(HT_XBK + 40, lv) - ht_ggr(HT_XBK + 56, lv))); lv += 3; );
    q = HT_XBK + 72 + k*7;
    rel = max(rel, abs(ht_gtr(k, tpb)/q[4] - 1));
    abs(q[6] - HT_CTA[k]*1000) > 0.05 ? ( att = 1; );
    k += 1;
  );
  xo = abs(slider(HT_S_X1) - 88.3) > 0.05 || abs(slider(HT_S_X2) - 2500) > 0.5;

  // 5. Schreiben (erst die Makros, dann MODE: der Zwischenstand ist in EXPERT unhoerbar), Fingerabdruck merken
  ht_slq(HT_S_DEPTH, floor(db*1000 + 0.5)*0.1);
  ht_slq(HT_S_TIME, tpb);
  ht_slq(HT_S_UP, ht_tU); ht_slq(HT_S_DOWN, ht_tDn); ht_slq(HT_S_MKUP, ht_tMk);
  k = 0;
  loop(3, ht_slq(HT_S_BAND0 + k*HT_S_BANDW + HT_F_THRESH, HT_XBK[93 + k]); k += 1; );
  ht_slq(HT_S_MODE, 0);
  tt_sldirty = 1;
  HT_XBK[32] = slider(HT_S_DEPTH); HT_XBK[33] = slider(HT_S_TIME); HT_XBK[34] = slider(HT_S_UP);
  HT_XBK[35] = slider(HT_S_DOWN);  HT_XBK[36] = slider(HT_S_MKUP);
  k = 0;
  loop(3, HT_XBK[37 + k] = slider(HT_S_BAND0 + k*HT_S_BANDW + HT_F_THRESH); k += 1; );
  ht_xbv = 1;
  ht_xdv = dv; ht_xrel = rel; ht_xatt = att; ht_xxo = xo;      // Messwerte fuer Test-Kommando/Anzeige

  // 6. Meldung
  dv < 0.1 && rel < 0.03 && !att && !xo ? (
    strcpy(#ht_xm, "EXPERT -> CLASSIC: same sound - the macros reproduce your EXPERT values.");
  ) : (
    sprintf(#ht_xm, "EXPERT -> CLASSIC: closest macro match, curves within %.1f dB", dv);
    rel >= 0.03 ? ( sprintf(#ht_xs, ", release %.0f %%", rel*100); strcat(#ht_xm, #ht_xs); );
    att ? strcat(#ht_xm, ", attack fixed");
    xo ? strcat(#ht_xm, ", crossovers 88.3/2500 Hz");
    strcat(#ht_xm, ". EXPERT restores your values.");
  );
  ht_xmt = time_precise() + 8;
);

// CLASSIC -> EXPERT: Sicherung zurueck, wenn die Makros seit ht_tofit unveraendert sind, sonst SNAPSHOT der Makros
function ht_toexp() local(k, b, q, same) (
  same = ht_xbv;
  same ? (
    abs(slider(HT_S_DEPTH) - HT_XBK[32]) > 0.0001 || abs(slider(HT_S_TIME) - HT_XBK[33]) > 0.0001 ||
    abs(slider(HT_S_UP) - HT_XBK[34]) > 0.0001 || abs(slider(HT_S_DOWN) - HT_XBK[35]) > 0.0001 ||
    abs(slider(HT_S_MKUP) - HT_XBK[36]) > 0.0001 ? ( same = 0; );
    k = 0;
    loop(3, abs(slider(HT_S_BAND0 + k*HT_S_BANDW + HT_F_THRESH) - HT_XBK[37 + k]) > 0.0001 ? ( same = 0; ); k += 1; );
  );
  same ? (
    k = 0;
    loop(3,
      b = HT_S_BAND0 + k*HT_S_BANDW; q = HT_XBK + k*7;
      ht_slq(b + HT_F_UPTHR, q[0]); ht_slq(b + HT_F_UPRATIO, q[1]); ht_slq(b + HT_F_DNTHR, q[2]);
      ht_slq(b + HT_F_DNRATIO, q[3]); ht_slq(b + HT_F_ATTACK, q[4]); ht_slq(b + HT_F_RELEASE, q[5]);
      ht_slq(b + HT_F_MAKEUP, q[6]);
      k += 1;
    );
    ht_slq(HT_S_KNEE, HT_XBK[21]); ht_slq(HT_S_UPMAX, HT_XBK[22]); ht_slq(HT_S_X1, HT_XBK[23]); ht_slq(HT_S_X2, HT_XBK[24]);
    strcpy(#ht_xm, "CLASSIC -> EXPERT: your previous EXPERT values are back (macros were not touched).");
  ) : (
    ht_snapshot();
    ht_snc ? strcpy(#ht_xm, "CLASSIC -> EXPERT: upward ratio capped at 20:1, the upward branch is weaker than in CLASSIC - check by ear.")
           : strcpy(#ht_xm, "CLASSIC -> EXPERT: the current sound was copied into the EXPERT values - edit them freely.");
  );
  ht_slq(HT_S_MODE, 1);
  tt_sldirty = 1;
  ht_xmt = time_precise() + 8;
);
// Gefuehrte START-Ansicht (16.10.2026): vorhandene Slider, derselbe Klangkern.
// Redesign am selben Tag (Nutzerbefund: wirkte "leer", Texte zu klein, zu weit auseinander):
//   - Eigene Textgroessen in Rastereinheiten (Frage 22, Werte 20-26, Text 14-15 statt Kit-Slots 15/12),
//     gezeichnet ueber Slot 9 in der Family des Kit-Slots (ht_txt9) - OPTIONS > FONT SIZE wirkt weiter,
//     und zu lange Meldungen schrumpfen nur so weit wie noetig (die Leuchten der Hinweisleiste laeuft nie ueber).
//   - Fester Zeilenraster: Tabs 84, Frage 132, Inhalt ab 212, Hinweisleiste 512, Fussknöpfe 576.
//   - Schritt 1: Auswahl-Karten (Titel + DEPTH-Wert + Caption in einer Flaeche, ganze Karte klickbar),
//     CURRENT DEPTH als eigener Rahmen, die zwei Hinweise als Kasten - statt Knopf mit schwebender Zeile darunter.
//   - Schritt 3: ORIGINAL/HOTT als Karten, AUTO GAIN/MIX/OUT GAIN gross, Regler auf volle Breite.
// Nach ht29_init_ui einsortiert: ht_tofit ist hier bereits definiert.
// Reiner Ansichtswechsel schreibt keine Klangwerte; Schritte bleiben beim Transportstart stehen.
// Kein neuer Slider, Speicherbereich oder Serialize-Block. Projektladen startet mit der normalen Front.
ht_stini != 1 ? (
  ht_stini = 1;
  ht_stopen = 0;
  ht_stpage = 0;
  ht_stsource = -1;
);

function ht_start_view(on) (
  ht_stopen = on != 0;
  dragId = 0;
);

function ht_start_page(p) (
  ht_stpage = min(2, max(0, floor(p)));
  dragId = 0;
);

// Bewusst nur DEPTH: ein Startvorschlag ist kein Preset und setzt keine anderen Werte zurueck.
// EXPERT bleibt gesperrt, bis der Nutzer den bereits vorhandenen CLASSIC-Fit ausdruecklich waehlt.
function ht_start_source(s) (
  slider(HT_S_MODE) < 0.5 && s >= 0 && s <= 2 ? (
    ht_stsource = floor(s);
    ht_vfy = 0; // eine unmittelbar zuvor geladene Werksvorgabe darf den Griff nicht zurueckschreiben
    tt_slset(HT_S_DEPTH, ht_stsource == 0 ? 15 : ht_stsource == 1 ? 25 : 10);
  );
);

// Spezial-Abhoeren verhindert einen irrefuehrenden Vergleich "Original / HOTT".
function ht_start_special() local(k, b, special) (
  special = slider(HT_S_DELTA) > 0.5 || slider(HT_S_SC) >= 1.5;
  k = 0;
  loop(3,
    b = HT_S_BAND0 + k*HT_S_BANDW;
    special |= slider(b + HT_F_SOLO) > 0.5 || slider(b + HT_F_MUTE) > 0.5;
    k += 1;
  );
  special;
);

function ht_start_compare(original) (
  !ht_start_special() ? (
    ht_vfy = 0;
    tt_slset(HT_S_BYP, original != 0);
  );
);

function ht_start_button(x, y, w, h, on, label, tip) local(hit) (
  gfx_setfont(4);
  ht_ci = 0 - 1;
  hit = ht_seg(x, y, w, h, on, label);
  tt_hov(x, y, w, h, tip);
  hit;
);

// Zentrierter Text in der Family/Farbe des Kit-Slots f, aber in eigener Groesse (Rastereinheiten).
// OPTIONS > FONT SIZE skaliert mit (1.08^Stufe); passt der Text nicht, schrumpft nur er - wie uk_fit,
// nur auch bei Schriftstufe 0, weil die START-Seite eine Textflaeche ist und nichts ueberlaufen darf.
function ht_txt9(f, sz, x, y, w, h, s) local(k, e, tw, th) (
  e = f == 1 ? uk_e1 : uk_e2;
  k = max(9, floor(sz*SC*1.08^e));
  uk_fset9(f, k);
  gfx_measurestr(s, tw, th);
  tw > w*SC ? (
    k = max(9, floor(k*w*SC/tw));
    uk_fset9(f, k);
    gfx_measurestr(s, tw, th);
  );
  gfx_x = OX + x*SC + max(0, (w*SC - tw)*0.5);
  gfx_y = OY + y*SC + max(0, (h*SC - th)*0.5);
  uk_txtf(f);
  gfx_drawstr(s);
  gfx_setfont(f);
);

// Schritt-Tab: Fuellung und Rahmen wie btn, aber hoeher und in Slot-9-Groesse.
function ht_start_tab(x, y, w, h, on, s, tip) local(hov, hit) (
  hov = inBox(x, y, w, h);
  hit = uiClick && hov;
  on ? (
    colAcid(0.88); xrrect(x, y, w, h, 4, 1);
    gfx_set(0, 0, 0, 1);
  ) : (
    colPanel(); xrrect(x, y, w, h, 4, 1);
    hov ? tth_tn(0.30, 0.46, 0.26, 1) : colBorder();
    xrrect(x, y, w, h, 4, 0);
    hov ? tth_tn(0.85, 0.95, 0.82, 1) : colInk(0.85);
  );
  ht_txt9(4, 16, x, y, w, h, s);
  tt_hov(x, y, w, h, tip);
  hit;
);

// Auswahl-Karte (Schritt 1: Startquelle, Schritt 3: Vergleichsseite): die ganze Flaeche klickt,
// Titel, Grosser Wert und Caption stehen in der Karte - gewaehlt = Saeure-Fuellung mit schwarzer Schrift.
function ht_start_card(x, y, w, h, on, title, value, cap, tsz, vsz, tip) local(hit) (
  on ? (
    colAcid(0.88); xrrect(x, y, w, h, 4, 1);
  ) : (
    colPanel(); xrrect(x, y, w, h, 4, 1);
    colBorder(); xrrect(x, y, w, h, 4, 0);
  );
  on ? gfx_set(0, 0, 0, 0.92) : colInk(0.95);
  ht_txt9(2, tsz, x, y + 10, w, 20, title);
  on ? gfx_set(0, 0, 0, 1) : colAcid(1);
  ht_txt9(2, vsz, x, y + 32, w, 28, value);
  on ? gfx_set(0, 0, 0, 0.8) : colInk(0.7);
  ht_txt9(2, 14, x, y + h - 24, w, 18, cap);
  hit = uiClick && inBox(x, y, w, h);
  tt_hov(x, y, w, h, tip);
  hit;
);

function ht_start_draw() local(special, ex) (
  ex = slider(HT_S_MODE) >= 0.5;
  special = ht_start_special();
  ht_card(8, 52, 984, 600); ht_ctitle(8, 52, 0 - 1, "START / GUIDED SETUP");   // 0.7.0 (Historie: panel2)

  ht_start_tab(24, 84, 304, 38, !ex && ht_stpage == 0, "1 / STARTING POINT",
    "Shows suggested starting strengths; navigating the tour does not change any sound parameter.") ? ht_start_page(0);
  ht_start_tab(340, 84, 304, 38, !ex && ht_stpage == 1, "2 / SHAPE THE SOUND",
    "Opens the real DEPTH, UP and DOWN controls with a short explanation of each.") ? ht_start_page(1);
  ht_start_tab(656, 84, 304, 38, !ex && ht_stpage == 2, "3 / COMPARE",
    "Opens the original/processed comparison, AUTO GAIN, MIX and OUT GAIN controls.") ? ht_start_page(2);

  ex ? (
    colAcid(1); ht_txt9(2, 22, 24, 132, 936, 44, "Your current setting uses EXPERT.");
    colInk(0.95); ht_txt9(2, 15, 24, 192, 936, 24, "START teaches the CLASSIC macros. Opening it has not changed your sound.");
    colInk(0.85); ht_txt9(2, 15, 24, 222, 936, 24, "CLASSIC can approximate your EXPERT setting, but cannot represent every curve and timing exactly.");
    colInk(0.85); ht_txt9(2, 15, 24, 252, 936, 24, "Use the existing conversion below, or close START and keep editing in EXPERT.");
    ht_start_button(240, 300, 520, 52, 0, "CONVERT TO CLASSIC / CLOSEST MATCH",
      "Uses the existing EXPERT-to-CLASSIC conversion; it may change the sound and reports the remaining difference.") ? (
      ht_vfy = 0; ht_tofit(); ht_stsource = -1;
    );
    colInk(0.7); ht_txt9(2, 14, 240, 360, 520, 18, "The hint line reports the remaining difference after the conversion.");
  ) : (
    ht_stpage == 0 ? (
      colAcid(1); ht_txt9(2, 22, 24, 132, 936, 44, "What are you working on?");
      colInk(0.85); ht_txt9(2, 15, 24, 178, 936, 22, "Choose a gentle starting strength, then listen. These are suggestions, not measured recipes.");
      // 25.10.2026 (Review hott-R001): Markierung nur, solange DEPTH dem Kartenwert entspricht -
      // sonst blieb die Karte gewaehlt markiert, obwohl der Nutzer/Automation DEPTH längst geaendert hatte.
      ht_start_card(24, 212, 304, 110, ht_stsource == 0 && abs(slider(HT_S_DEPTH) - 15) < 0.05, "DRUMS", "DEPTH 15 %", "Keep the impact", 16, 26,
        "Sets only DEPTH to 15 percent as a gentle drum starting point; all other parameters remain unchanged.") ? ht_start_source(0);
      ht_start_card(340, 212, 304, 110, ht_stsource == 1 && abs(slider(HT_S_DEPTH) - 25) < 0.05, "SYNTH / BASS", "DEPTH 25 %", "Bring out texture", 16, 26,
        "Sets only DEPTH to 25 percent as a synth or bass starting point; all other parameters remain unchanged.") ? ht_start_source(1);
      ht_start_card(656, 212, 304, 110, ht_stsource == 2 && abs(slider(HT_S_DEPTH) - 10) < 0.05, "MIX BUS", "DEPTH 10 %", "Start with less", 16, 26,
        "Sets only DEPTH to 10 percent as a gentle mix-bus starting point; all other parameters remain unchanged.") ? ht_start_source(2);
      gfx_set(0, 0, 0, 0.28); xrrect(24, 338, 936, 56, 4, 1);
      colBorder(); xrrect(24, 338, 936, 56, 4, 0);
      sprintf(#ht_sttext, "CURRENT DEPTH  %.1f %%", slider(HT_S_DEPTH));
      colAcid(1); ht_txt9(2, 26, 24, 338, 936, 56, #ht_sttext);
      tt_hov(24, 338, 936, 56, "Shows the current DEPTH value, including changes made by host automation.");
      gfx_set(0, 0, 0, 0.22); xrrect(24, 410, 936, 86, 4, 1);
      colBorder(); xrrect(24, 410, 936, 86, 4, 0);
      colInk(0.95); ht_txt9(2, 15, 24, 428, 936, 24, "You can also keep your current setting and go straight to step 2.");
      colInk(0.75); ht_txt9(2, 15, 24, 458, 936, 24, "No preset is loaded: thresholds, timing, band gains and listening modes are kept.");
    ) : ht_stpage == 1 ? (
      colAcid(1); ht_txt9(2, 22, 24, 132, 936, 44, "Find the amount that feels right.");
      colInk(0.85); ht_txt9(2, 15, 24, 178, 936, 22, "DEPTH changes compression strength and model make-up together. MIX is a separate control.");
      sprintf(#ht_sttext, "HOW MUCH HOTT?   DEPTH  %.1f %%", slider(HT_S_DEPTH));
      colAcid(1); ht_txt9(2, 24, 24, 214, 936, 34, #ht_sttext);
      ht_hsl(HT_S_DEPTH, 24, 254, 936, 28, 0, 100, 25, 0,
        "Scales upward strength, downward strength and model make-up together from 0 to 100 percent; this is not MIX.");
      colInk(0.75);
      ht_txt9(2, 14, 24, 288, 144, 16, "Subtle");
      ht_txt9(2, 14, 816, 288, 144, 16, "Over the top");
      sprintf(#ht_sttext, "QUIET DETAIL / UP  %.0f %%", slider(HT_S_UP));
      colAcid(1); ht_txt9(2, 20, 24, 322, 462, 30, #ht_sttext);
      ht_hsl(HT_S_UP, 24, 358, 462, 26, 0, 200, 100, 1,
        "Scales upward compression in all three bands from 0 to 200 percent; more may also raise noise and tails.");
      sprintf(#ht_sttext, "PEAK CONTROL / DOWN  %.0f %%", slider(HT_S_DOWN));
      colAcid(1); ht_txt9(2, 20, 498, 322, 462, 30, #ht_sttext);
      ht_hsl(HT_S_DOWN, 498, 358, 462, 26, 0, 200, 100, 1,
        "Scales downward compression in all three bands from 0 to 200 percent; more can reduce punch.");
      colInk(0.75);
      ht_txt9(2, 14, 24, 390, 462, 18, "More brings quiet tails and texture forward.");
      ht_txt9(2, 14, 498, 390, 462, 18, "More holds loud moments back.");
      colInk(0.9); ht_txt9(2, 15, 24, 424, 936, 24, "Start with DEPTH; change UP or DOWN only when you hear a reason to.");
    ) : (
      colAcid(1); ht_txt9(2, 22, 24, 132, 936, 44, "Does it sound better at similar loudness?");
      colInk(0.85); ht_txt9(2, 15, 24, 178, 936, 22, "Play the same passage. Listen for texture, punch and noise, not just a louder output.");
      special ? (
        gfx_set(0, 0, 0, 0.22); xrrect(24, 212, 936, 88, 4, 1);
        colBorder(); xrrect(24, 212, 936, 88, 4, 0);
        colInk(0.95); ht_txt9(2, 15, 24, 230, 936, 24, "Comparison paused: turn off DELTA, SC LISTEN and band SOLO/MUTE first.");
        colInk(0.75); ht_txt9(2, 15, 24, 260, 936, 24, "Use the header or close START to reach the band and SYSTEM controls.");
      ) : (
        ht_start_card(24, 212, 462, 88, slider(HT_S_BYP) > 0.5, "ORIGINAL", "the untouched input", "BYPASS on", 16, 22,
          "Sets BYPASS on for the untouched, latency-matched input; this selection remains when START is closed.") ? ht_start_compare(1);
        ht_start_card(498, 212, 462, 88, slider(HT_S_BYP) < 0.5, "HOTT", "your processed sound", "BYPASS off", 16, 22,
          "Sets BYPASS off to hear the processed signal with the current MIX and gain settings.") ? ht_start_compare(0);
      );
      gfx_setfont(4);
      ht_ftg(24, 320, 330, 30, slider(HT_S_AUTO) > 0.5, "MATCH LEVEL / AUTO GAIN") ? (
        tt_slset(HT_S_AUTO, slider(HT_S_AUTO) > 0.5 ? 0 : 1);
      );
      tt_hov(24, 320, 330, 30,
        "Matches wet level to input using the existing slow RMS AUTO GAIN; let it settle, then trim OUT GAIN if needed.");
      sprintf(#ht_sttext, "AUTO GAIN  %+.1f dB", HT_UST[36]);
      colAcid(1); ht_txt9(2, 20, 372, 320, 588, 30, #ht_sttext);
      tt_hov(372, 320, 588, 30, "Shows the existing AUTO GAIN correction in dB; this is not a loudness-quality score.");
      sprintf(#ht_sttext, "BLEND WITH ORIGINAL / MIX  %.1f %%", slider(HT_S_MIX));
      colAcid(1); ht_txt9(2, 20, 24, 366, 786, 30, #ht_sttext);
      ht_hsl(HT_S_MIX, 24, 402, 786, 28, 0, 100, 100, 0,
        "Blends original and processed signal from 0 to 100 percent processed; DEPTH remains unchanged.");
      ht_knob(HT_S_OUT, 900, 420, 24, -24, 24, 0, 0, 1, "OUT GAIN",
        "Trims the output from -24 to +24 dB; use it if AUTO GAIN does not give a convincing level match.");
      colInk(0.9); ht_txt9(2, 15, 24, 448, 780, 24, "AUTO GAIN needs time to settle; equal peak readings do not mean equal perceived loudness.");
    );
  );

  // Immer sichtbare Abhoerwarnungen haben Vorrang vor allgemeinen Einstelltipps.
  gfx_setfont(5); colInk(0.95);
  special ? strcpy(#ht_sttext, "SPECIAL MONITORING: DELTA / SC LISTEN / SOLO / MUTE is active - restore normal monitoring to judge the full sound.")
  : slider(HT_S_BYP) > 0.5 ? strcpy(#ht_sttext, "BYPASS ON: you are hearing the original. Select HOTT in step 3 (or BYPASS in the header) to hear your changes.")
  : ht_xmt > time_precise() ? strcpy(#ht_sttext, #ht_xm)
  : ex ? strcpy(#ht_sttext, "EXPERT is unchanged. Conversion is optional; closing START keeps your current setting.")
  : HT_PKU[2] < -1 ? sprintf(#ht_sttext, "LIMITER: %.1f dB reduction. If punch suffers, reduce DEPTH or OUT GAIN before comparing again.", HT_PKU[2])
  : slider(HT_S_UP) > 135 ? strcpy(#ht_sttext, "More UP may bring noise and tails forward. Check a quiet passage.")
  : slider(HT_S_DOWN) > 135 ? strcpy(#ht_sttext, "More DOWN can soften punch. Compare a clear kick or snare transient.")
  : strcpy(#ht_sttext, "Listen in context. Start gently, then compare at similar loudness.");
  gfx_set(0, 0, 0, 0.3); xrrect(24, 512, 936, 44, 4, 1);
  colBorder(); xrrect(24, 512, 936, 44, 4, 0);
  special || slider(HT_S_BYP) > 0.5 ? gfx_set(tth_alR, tth_alG, tth_alB, 0.95) : colInk(0.95);
  ht_txt9(2, 15, 36, 512, 912, 44, #ht_sttext);
  tt_hov(24, 512, 936, 44, #ht_sttext);

  ht_start_button(24, 576, 200, 36, 0, "CLOSE START",
    "Returns to the full front without changing sound parameters, including the current BYPASS selection.") ? ht_start_view(0);
  !ex ? (
    ht_stpage > 0 ? (
      ht_start_button(566, 576, 180, 36, 0, "BACK",
        "Returns to the previous tour step without changing sound parameters.") ? ht_start_page(ht_stpage - 1);
    );
    ht_stpage < 2 ? (
      ht_start_button(756, 576, 204, 36, 1, "NEXT",
        "Continues to the next tour step without changing sound parameters.") ? ht_start_page(ht_stpage + 1);
    ) : (
      ht_start_button(756, 576, 204, 36, 1, "KEEP / FULL FRONT",
        "Returns to the full front and keeps every setting exactly as it is, including BYPASS.") ? ht_start_view(0);
    );
  );
);
@slider
// Einzige Slider->Koeffizienten-Stelle (Vertrag 5.2). Deckt Host-/Automation-
// und Preset-Aenderungen ab; Front-Schreibzugriffe (tt_slset) laufen ueber
// tt_sldirty im @block. ht_params meldet ueber ht_pdc auch die Latenz.
ht_params();
@block
// Slider-Schreibzugriffe aus @gfx (tt_slset, z. B. ht_snapshot) loesen @slider
// nie aus (P25): Dirty-Flag hier abfragen und loeschen. Latenz-Aenderung geht
// ueber ht_params -> ht_pdc mit.
tt_sldirty ? (
  tt_sldirty = 0;
  ht_params();
);

// Messwerte des vergangenen Blocks fuer die Front (Vertrag 5.4 / MODEL.md 7)
ht_metwrite();
@sample
// Signalweg nach MODEL.md 1/3/4/5 (Orakel process()). Der Mode CLASSIC/EXPERT steckt
// ausschliesslich in HT_RES (ht_resolve); @sample kennt den Mode nicht (nur die 10-ms-Blende ht_xf beim Wechsel).
// spl0/spl1 = Ein-/Ausgang, spl2/spl3 = Sidechain-Eingaenge.
// Gegenpruefung Opus 5.5 (2026-10-07) eingearbeitet: Eingang saeubern, Lookahead-Ring ohne Leeren,
// Moduswechsel-Blende, AUTO GAIN friert bei Solo/Mute ein und blendet, Glaetter rasten exakt ein, Solo/Mute-Blende.

// ---- Eingang saeubern (NaN/Inf/Riesenwerte aus dem Host duerfen die Filter- und Huellkurvenzustaende nie erreichen) ----
ht_x0 = (spl0 > -1000000 && spl0 < 1000000) ? spl0 : 0;
ht_x1 = (spl1 > -1000000 && spl1 < 1000000) ? spl1 : 0;
ht_s2 = (spl2 > -1000000 && spl2 < 1000000) ? spl2 : 0;
ht_s3 = (spl3 > -1000000 && spl3 < 1000000) ? spl3 : 0;
ht_scpk = max(max(abs(ht_s2), abs(ht_s3)), ht_scpk*ht_scd);   // 0.2.3: Spitzenhalter des Sidechain-Eingangs (nur Anzeige "NO SC SIGNAL"); @gfx liest nur
ht_scn < 1000000000 ? ( ht_scn += 1; );                        // 0.2.4: Samples seit Reset; die Warnung schweigt in den ersten 2 s (Fenster offen, noch kein Audio)
// EXT/LISTEN nutzen den Sidechain immer (MODEL.md 3). Ein nicht geroutetes Sidechain ist Stille:
// Upward-Gain steht dann auf Maximum (Hinweis seit 0.2.2 im Tooltip und Manual). Historie: Devins Erstfassung fiel bei
// stillem SC auf den Programm-Detektor zurueck; das aenderte das Ducking in SC-Pausen (Orchestrator entfernt).
ht_useSC = ht_scm >= 1;
// 0.9.9: fallende Flanke loescht die Sidechain-Weiche. Sonst bleibt ein Impuls
// stehen, solange EXT/LISTEN aus ist, und kommt beim Wiedereinschalten zurueck.
// Die Weiche laeuft dabei nicht mit (das waere die zusaetzliche LR4 in jeder Pause).
// 0.9.10 (Review 14.11.2026): nur die Zustaende ic1/ic2 loeschen. Slots 2..4 jedes Filters sind die Koeffizienten
// (ht_svc), und ht_xcoef rechnet sie nur bei geaenderter Weiche oder Samplerate neu. Nach dem memset ueber alle 112 Worte
// sah der Detektor nach AUS -> EXT in LOW und MID Stille (Upward am Maximum) und in HIGH das Vollband.
// Historie (0.9.9): ht_scu > ht_useSC ? ( memset(HT_SVS, 0, 112); );
ht_scu > ht_useSC ? (
  ht_scj = 0;
  loop(14, ht_scq = HT_SVS + ht_scj*8; ht_scq[0] = 0; ht_scq[1] = 0; ht_scj += 1; );
);
ht_scu = ht_useSC;

// ---- 0.2.6: Weichenfrequenz gleitet (kein Sprung der Koeffizienten bei bestehenden Zustaenden) ----
ht_fgn += 1;
ht_fgn >= 16 ? ( ht_fgn = 0; (ht_f1 != ht_f1n || ht_f2 != ht_f2n) ? ( ht_xglide(); ); );

// ---- Glaettung (5 ms: IN/OUT/MIX/Band-Gain/Solo-Mute; BYPASS-Crossfade 10 ms); rastet exakt auf dem Ziel ein ----
ht_ia  += (ht_iaT  - ht_ia)*ht_smc;   abs(ht_iaT  - ht_ia)  < 0.000001 ? ( ht_ia  = ht_iaT; );
ht_oa  += (ht_oaT  - ht_oa)*ht_smc;   abs(ht_oaT  - ht_oa)  < 0.000001 ? ( ht_oa  = ht_oaT; );
ht_mix += (ht_mixT - ht_mix)*ht_smc;  abs(ht_mixT - ht_mix) < 0.000001 ? ( ht_mix = ht_mixT; );
ht_bx  += (ht_bxT  - ht_bx)*ht_bxc;   abs(ht_bxT  - ht_bx)  < 0.000001 ? ( ht_bx  = ht_bxT; );

// ---- nasser Eingang: IN_GAIN wirkt nur hier. M/S kommt erst hinter Weiche und Ring (0.9.9) ----
ht_xw0 = ht_x0*ht_ia; ht_xw1 = ht_x1*ht_ia;

// ---- LR4-Weiche Hauptweg (L/R; M/S erst nach dem Ring, siehe unten) ----
ht_split(HT_SV, ht_xw0);
HT_BND[0] = ht_b0; HT_BND[2] = ht_b1; HT_BND[4] = ht_b2;
ht_split(HT_SV + 56, ht_xw1);
HT_BND[1] = ht_b0; HT_BND[3] = ht_b1; HT_BND[5] = ht_b2;

// ---- LR4-Weiche Sidechain (eigene Instanz, gleiche f1/f2, IN_GAIN wie Hauptweg; M/S folgt unten) ----
ht_useSC ? (
  ht_sw0 = ht_s2*ht_ia; ht_sw1 = ht_s3*ht_ia;
  ht_split(HT_SVS, ht_sw0);
  HT_BNDS[0] = ht_b0; HT_BNDS[2] = ht_b1; HT_BNDS[4] = ht_b2;
  ht_split(HT_SVS + 56, ht_sw1);
  HT_BNDS[1] = ht_b0; HT_BNDS[3] = ht_b1; HT_BNDS[5] = ht_b2;
);

// ---- LOOKAHEAD: Baender + trockener Pfad um ht_laN Samples verzoegern (der Detektor sieht unverzoegert) ----
// Fester Ring mit Zeiger: erst schreiben, dann bei wp - la lesen (la = 0 -> bitgenau durchgereicht).
// Eine Aenderung von LOOKAHEAD leert den Ring NICHT (Opus-Befund: sonst Aussetzer auch im trockenen Pfad).
ht_p = HT_DLY + ht_wp;
ht_p[0] = HT_BND[0]; ht_p[HT_DLW] = HT_BND[1]; ht_p[2*HT_DLW] = HT_BND[2];
ht_p[3*HT_DLW] = HT_BND[3]; ht_p[4*HT_DLW] = HT_BND[4]; ht_p[5*HT_DLW] = HT_BND[5];
ht_p[6*HT_DLW] = ht_x0; ht_p[7*HT_DLW] = ht_x1;
ht_rp = ht_wp - ht_laN;
ht_rp < 0 ? ( ht_rp += HT_DLW; );
ht_q = HT_DLY + ht_rp;
HT_BNDD[0] = ht_q[0]; HT_BNDD[1] = ht_q[HT_DLW]; HT_BNDD[2] = ht_q[2*HT_DLW];
HT_BNDD[3] = ht_q[3*HT_DLW]; HT_BNDD[4] = ht_q[4*HT_DLW]; HT_BNDD[5] = ht_q[5*HT_DLW];
ht_dry0 = ht_q[6*HT_DLW]; ht_dry1 = ht_q[7*HT_DLW];
// 0.3.0 (A1): der Sidechain-Eingang laeuft durch einen eigenen Ring mit demselben Zeiger, damit SC LISTEN genau um die
// gemeldete PDC verzoegert ist (vorher unverzoegert: LISTEN lag um LOOKAHEAD vor dem Projekt). Der Detektor bleibt unverzoegert.
HT_SCRING[ht_wp] = ht_s2; HT_SCRING[HT_DLW + ht_wp] = ht_s3;
ht_sd0 = HT_SCRING[ht_rp]; ht_sd1 = HT_SCRING[HT_DLW + ht_rp];
ht_wp += 1;
ht_wp >= HT_DLW ? ( ht_wp = 0; );

// ---- TROCKENER PFAD ueber dieselbe Weiche (Nutzerbefund 08.10.2026: Phasing beim MIX-Regler) ----
// Der Nasspfad ist die Summe der LR4-Baender = ein Allpass mit Phasendrehung. Der rohe Eingang daneben ergibt beim Mischen
// Kammfilter. Darum geht der laufzeitgleiche trockene Eingang durch dieselbe Weiche (eigene Zustaende HT_SVD, gleiche
// Koeffizienten, kein IN_GAIN) und wird mit den Band-Masken (Solo/Mute) summiert. Nur bei MIX = 0 (ohne Solo/Mute) und BYPASS
// bleibt er der unveraenderte Eingang (bitgenau); dazwischen blendet w ueber MIX 0..5 % ein.
ht_split(HT_SVD, ht_dry0);
ht_dq0 = ht_b0*HT_BONS[0] + ht_b1*HT_BONS[1] + ht_b2*HT_BONS[2];
ht_split(HT_SVD + 56, ht_dry1);
ht_dq1 = ht_b0*HT_BONS[0] + ht_b1*HT_BONS[1] + ht_b2*HT_BONS[2];

// ---- M/S je Band, nach der Weiche und nach dem Ring (0.9.9) ----
// Die LR4 ist linear und je Kanal gleich, im eingeschwungenen Zustand also gleichwertig zum Kodieren vor der Weiche.
// Der Ring behaelt L/R: ein Umschalten STEREO/MID-SIDE wertet alte Samples nicht mehr in der falschen Basis um.
// Der trockene Pfad (ht_dry*, HT_SVD) bleibt L/R. Zurueck auf L/R geht nur die Nass-Summe, weiter unten.
ht_msm ? (
  ht_j = 0;
  loop(3,
    ht_t0 = (HT_BND[ht_j*2] + HT_BND[ht_j*2 + 1])*ht_msf;
    HT_BND[ht_j*2 + 1] = (HT_BND[ht_j*2] - HT_BND[ht_j*2 + 1])*ht_msf;
    HT_BND[ht_j*2] = ht_t0;
    ht_t0 = (HT_BNDD[ht_j*2] + HT_BNDD[ht_j*2 + 1])*ht_msf;
    HT_BNDD[ht_j*2 + 1] = (HT_BNDD[ht_j*2] - HT_BNDD[ht_j*2 + 1])*ht_msf;
    HT_BNDD[ht_j*2] = ht_t0;
    ht_useSC ? (
      ht_t0 = (HT_BNDS[ht_j*2] + HT_BNDS[ht_j*2 + 1])*ht_msf;
      HT_BNDS[ht_j*2 + 1] = (HT_BNDS[ht_j*2] - HT_BNDS[ht_j*2 + 1])*ht_msf;
      HT_BNDS[ht_j*2] = ht_t0;
    );
    ht_j += 1;
  );
);

// ---- je Band: Detektor -> Folger -> Gain -> Wet-Summe ----
ht_w0 = 0; ht_w1 = 0;

ht_j = 0;
loop(3,
  ht_rb = HT_RES + ht_j*HT_RESW;
  ht_rbo = HT_RESO + ht_j*HT_RESW;
  ht_db = (ht_useSC ? HT_BNDS : HT_BND) + ht_j*2;
  ht_p0 = ht_db[0]*ht_db[0];
  ht_p1 = ht_db[1]*ht_db[1];
  ht_pl = ht_det ? max(ht_p0, ht_p1) : 0.5*(ht_p0 + ht_p1);   // PEAK: max; RMS: Mittel (Modell)
  ht_ef = HT_ENV + ht_j*2;
  ht_cf = HT_ECF + ht_j*2;
  ht_lb = HT_LST + ht_j*8;
  // Kanal 0: Detektor-Input, umschaltender Ein-Pol-Folger, Pegel, Gain
  ht_dd = ht_lk*ht_pl + (1 - ht_lk)*ht_p0;
  ht_ev = ht_ef[0];
  ht_ev += (ht_dd > ht_ev ? ht_cf[0] : ht_cf[1])*(ht_dd - ht_ev);
  ht_ev = ht_ev > 0.000000000000000000000000000001 ? ht_ev : 0;   // e-Boden 1e-30 (MODEL.md 3)
  ht_ef[0] = ht_ev;
  ht_E = 10*log10(max(ht_ev, 0.00000000000000000001));           // 1e-20 -> E >= -200 dB
  ht_lb[0] = ht_E;
  ht_updn(ht_rb, ht_E);
  ht_lb[2] = ht_up; ht_lb[4] = ht_dn;
  ht_G = max(ht_rb[HT_R_FLOOR], ht_rb[HT_R_MAKEUP] + ht_up - ht_dn);
  ht_xf < 1 ? (                                                    // Moduswechsel: in dB von der alten zur neuen Aufloesung blenden
    ht_updn(ht_rbo, ht_E);
    ht_Go = max(ht_rbo[HT_R_FLOOR], max(ht_rbo[HT_R_FLOOR], ht_rbo[HT_R_MAKEUP] + ht_up - ht_dn) + ht_rbo[14]);
    ht_G = ht_Go + (ht_G - ht_Go)*ht_xf;
  );
  ht_lb[6] = ht_G;                                                 // gehoerter Gewinn, damit der Blenden-Neustart daran ansetzt
  ht_g0 = 10^(min(120, ht_G)*0.05);   // 0.9.11 (grok-bot R2 F1): Deckel, sonst Inf aus Fremdwert                                        // dB -> Amplitude (/20)
  // Kanal 1
  ht_dd = ht_lk*ht_pl + (1 - ht_lk)*ht_p1;
  ht_ev = ht_ef[1];
  ht_ev += (ht_dd > ht_ev ? ht_cf[0] : ht_cf[1])*(ht_dd - ht_ev);
  ht_ev = ht_ev > 0.000000000000000000000000000001 ? ht_ev : 0;
  ht_ef[1] = ht_ev;
  ht_E = 10*log10(max(ht_ev, 0.00000000000000000001));
  ht_lb[1] = ht_E;
  ht_updn(ht_rb, ht_E);
  ht_lb[3] = ht_up; ht_lb[5] = ht_dn;
  ht_G = max(ht_rb[HT_R_FLOOR], ht_rb[HT_R_MAKEUP] + ht_up - ht_dn);
  ht_xf < 1 ? (
    ht_updn(ht_rbo, ht_E);
    ht_Go = max(ht_rbo[HT_R_FLOOR], max(ht_rbo[HT_R_FLOOR], ht_rbo[HT_R_MAKEUP] + ht_up - ht_dn) + ht_rbo[15]);
    ht_G = ht_Go + (ht_G - ht_Go)*ht_xf;
  );
  ht_lb[7] = ht_G;
  ht_g1 = 10^(min(120, ht_G)*0.05);
  // Historie (0.6.0, zurueckgenommen): bei STEREO LINK 100 % Kanal 1 von Kanal 0 kopieren (bitgleich); REAPER-Messung (ht_t14_ab, q1823): kein CPU-Gewinn
  // (alt 7,5 / neu 8,2 % Kern, ohne Begrenzer 6,0 / 6,2); die Gain-Rechnung ist nicht der Engpass, und die Bedingung (neue gegen alte Huellkurve) griff bei Signal fast nie.
  // Bandgewinn und Solo/Mute geglaettet (5 ms), dann verzoegertes Band * Gain * GAIN_k aufsummieren
  HT_SMT[ht_j] += (HT_SMT[3 + ht_j] - HT_SMT[ht_j])*ht_smc;
  abs(HT_SMT[3 + ht_j] - HT_SMT[ht_j]) < 0.000001 ? ( HT_SMT[ht_j] = HT_SMT[3 + ht_j]; );
  HT_BONS[ht_j] += (HT_BON[ht_j] - HT_BONS[ht_j])*ht_smc;
  abs(HT_BON[ht_j] - HT_BONS[ht_j]) < 0.000001 ? ( HT_BONS[ht_j] = HT_BON[ht_j]; );
  ht_y0 = HT_BNDD[ht_j*2]*ht_g0*HT_SMT[ht_j]*HT_BONS[ht_j];
  ht_y1 = HT_BNDD[ht_j*2 + 1]*ht_g1*HT_SMT[ht_j]*HT_BONS[ht_j];
  ht_w0 += ht_y0; ht_w1 += ht_y1;
  HT_BMS[ht_j] += ht_y0*ht_y0 + ht_y1*ht_y1;                     // Mean-Square-Akku (Meter OUT)
  ht_j += 1;
);
ht_xf < 1 ? ( ht_xf = min(1, ht_xf + ht_xfc); );                 // Blende laeuft 10 ms
ht_lsg = 1;                                                          // ab hier steht in HT_LST der gehoerte Gewinn
ht_w0 = (ht_w0 > -1000000 && ht_w0 < 1000000) ? ht_w0 : 0;           // 0.9.11 (grok-bot R2 F1): Inf/NaN erreicht AUTO GAIN und Begrenzer nicht
ht_w1 = (ht_w1 > -1000000 && ht_w1 < 1000000) ? ht_w1 : 0;

// ---- M/S zurueck auf den Wet-Pfad ----
ht_msm ? (
  ht_t0 = (ht_w0 + ht_w1)*ht_msf;
  ht_w1 = (ht_w0 - ht_w1)*ht_msf;
  ht_w0 = ht_t0;
);

// ---- Trockenanteil fuer MIX/DELTA: ausgerichteter (Allpass) Trockenpfad mit Solo/Mute-Maske ----
// SOLO/MUTE gelten IMMER, auch bei MIX < 100 % (Nutzerbefund 07.10.2026). w = 1 bei Solo/Mute, DELTA und MIX >= 5 %.
ht_mskT = (HT_BON[0] + HT_BON[1] + HT_BON[2] < 2.5) ? 1 : 0;
ht_msk += (ht_mskT - ht_msk)*ht_smc;
abs(ht_mskT - ht_msk) < 0.000001 ? ( ht_msk = ht_mskT; );
ht_dyw = ht_dlta ? 1 : max(ht_msk, min(1, ht_mix*20));
ht_de0 = ht_dry0 + ht_dyw*(ht_dq0 - ht_dry0);
ht_de1 = ht_dry1 + ht_dyw*(ht_dq1 - ht_dry1);

// ---- AUTO GAIN (MODEL.md 5): langsamer Abgleich Eingang -> nasser Ausgang ----
// Leistungsmittel 1,5 s laufen immer mit; der dB-Wert (begrenzt +-24, geglaettet 200 ms) wird nur
// nachgefuehrt, wenn nicht eingefroren: bei Stille (beide Mittel < -90 dB = 1e-9), bei Solo und wenn alle
// Baender stumm sind (sonst laeuft AUTO GAIN davon, Opus-Befund). Ein/Aus blendet 5 ms (keine Spruenge).
ht_pin = 0.5*(ht_xw0*ht_xw0 + ht_xw1*ht_xw1);                    // x*IN_GAIN, M/S-invariant
ht_pwe = 0.5*(ht_w0*ht_w0 + ht_w1*ht_w1);                        // y-Summe vor AG
ht_agI += ht_aga*(ht_pin - ht_agI);
ht_agW += ht_aga*(ht_pwe - ht_agW);
ht_agfrz = ht_soloA || (HT_BON[0] + HT_BON[1] + HT_BON[2] < 0.5) || (ht_agI < 0.000000001 && ht_agW < 0.000000001);
ht_agon && !ht_agfrz ? (
  ht_t0 = 10*log10(ht_agI/max(ht_agW, 0.000000000000000000000000000001));
  ht_t0 = min(24, max(0 - 24, ht_t0));
  ht_agG += ht_agc*(ht_t0 - ht_agG);
);
ht_agAm += ((ht_agon ? ht_agG : 0) - ht_agAm)*ht_smc;
abs((ht_agon ? ht_agG : 0) - ht_agAm) < 0.000001 ? ( ht_agAm = (ht_agon ? ht_agG : 0); );
ht_agAm != 0 ? (
  ht_agf = 10^(ht_agAm*0.05);
  ht_w0 *= ht_agf; ht_w1 *= ht_agf;
);

// ---- Ausgabemodi, Vorrang BYPASS > LISTEN > DELTA > MIX (Orakel A4) ----
ht_scm == 2 && ht_useSC ? (
  // SC LISTEN: Quelle * IN_GAIN * OUT_GAIN, ohne Dynamik, um LOOKAHEAD verzoegert wie alle Ausgangspfade (MODEL.md 3, 0.3.0 A1)
  // Historie (bis 0.2.7): ht_o0 = ht_s2*ht_ia*ht_oa; ht_o1 = ht_s3*ht_ia*ht_oa; (unverzoegert, gemeldete PDC enthielt trotzdem den Lookahead)
  ht_o0 = ht_sd0*ht_ia*ht_oa;
  ht_o1 = ht_sd1*ht_ia*ht_oa;
) : ht_dlta ? (
  // DELTA: nur die Veraenderung (MIX ignoriert, Latenzen ausgeglichen)
  ht_o0 = (ht_w0 - ht_de0)*ht_oa;
  ht_o1 = (ht_w1 - ht_de1)*ht_oa;
) : (
  // MIX: trocken = unveraenderter, laufzeitgleicher Eingang (ohne IN_GAIN)
  ht_o0 = (ht_de0*(1 - ht_mix) + ht_w0*ht_mix)*ht_oa;
  ht_o1 = (ht_de1*(1 - ht_mix) + ht_w1*ht_mix)*ht_oa;
);
// BYPASS-Blend auf den trockenen, laufzeitgleichen Eingang (IN/OUT-Gain ignoriert).
// ht_bx -> 1 beim Einschalten: dann siegt BYPASS ueber alle Modi (bei ht_bx = 1 exakt, Glaetter rastet ein).
ht_o0 = ht_o0*(1 - ht_bx) + ht_dry0*ht_bx;
ht_o1 = ht_o1*(1 - ht_bx) + ht_dry1*ht_bx;

// ---- NaN/Inf-Schutz (Falle 5): NaN > x ist in EEL2 false -> der Vergleich faengt beides ----
spl0 = (ht_o0 > -1000000 && ht_o0 < 1000000) ? ht_o0 : 0;
spl1 = (ht_o1 > -1000000 && ht_o1 < 1000000) ? ht_o1 : 0;

// ---- AUSGANGSBEGRENZER CEILING (0.2.0, Algorithmus: auftraege/p29/07_v020_vertrag.md; aus bei CEILING 0 = bitgleich wie 0.1.0) ----
// Lookahead D = 1,5 ms: Gewinn = Mittel (E+1) ueber das gleitende Minimum (E+1) des benoetigten Gewinns, Release 80 ms; das Signal
// wird um D Samples verzoegert (zaehlt zur PDC). Bei BYPASS (ht_bx = 1) wird nie begrenzt.
// 0.9.9: die Samples sind vor dem Ring schon mit ht_bx gemischt. Den Pegel nicht noch einmal mit (1 - ht_bx)
// verkleinern, sonst liegt die Mischung in den 10 ms der Blende ueber dem Ceiling. Bei ht_bx = 1 ist need = 1,
// der Gewinn laeuft aus, und die Ausgabe bleibt der trockene Eingang.
// 0.6.0 TRUE PEAK: die Spitze einer Position p ist das Maximum aus |x[p]| und den drei Zwischenwerten bei 1/4, 1/2, 3/4 zwischen x[p-1]
// und x[p] (4-fach ueberabgetastet, 16-Tap-Interpolator HT_TPK, beide Kanaele). Der Interpolator braucht HT_TPD = 7 Samples Vorlauf; darum
// wird die need-Position um 7 hinter dem Schreibzeiger gefuehrt (ht_lq = ht_lw - HT_TPD) und die Fensterlaenge ist E = D - 7 (ht_lE).
// Die Ausgangsposition t = lw - D bekommt so das Mittel ueber die Minima der Positionen t .. t+E: jede Spitze wirkt auf t-E .. t+E.
// Historie (bis 0.5.0): ht_lp = max(abs(spl0), abs(spl1))*(1 - ht_bx); need an ht_lw; Fenster D+1 (nur Sample-Spitzen, ISP bis +2 dB darueber).
ht_lon ? (
  ht_lon != ht_lonP || ht_lD != ht_lDP ? (                       // Ein-/Ausschalten oder anderes D: Ringe neu fuellen
    ht_lonP = ht_lon; ht_lDP = ht_lD;
    memset(HT_LIM, 0, 2*HT_LRW);
    memset(HT_TPB, 0, 4*HT_TPN); ht_tpi = 0; ht_tpm = 0; ht_tpa = 0;                     // True-Peak-Fenster leeren
    ht_li = 0;
    loop(2*HT_LRW, (HT_LIM + 2*HT_LRW)[ht_li] = 1; ht_li += 1; );
    ht_lsum = ht_lE + 1; ht_lgn = 1; ht_lw = 0;
  );
  // True-Peak-Fenster: je Kanal ein doppelt geschriebener Ring (b[i] = b[i + N]), das Fenster liegt ab ht_tpi + 1 zusammenhaengend
  ht_tpi += 1; ht_tpi >= HT_TPN ? ( ht_tpi = 0; );
  HT_TPB[ht_tpi] = spl0; HT_TPB[ht_tpi + HT_TPN] = spl0;
  (HT_TPB + 2*HT_TPN)[ht_tpi] = spl1; (HT_TPB + 2*HT_TPN)[ht_tpi + HT_TPN] = spl1;
  // CPU (exakt, 0.6.0): Fenstermaximum ht_tpm (immer >= dem wahren Maximum der letzten HT_TPN Samples beider Kanaele; sinkt nur beim Neuberechnen).
  // Liegt ht_tpm x ht_tps (groesste Betragssumme einer Interpolatorphase) unter dem Ceiling, kann keine Spitze (auch keine Zwischenspitze) darueber
  // liegen: need = 1, die 3 x 2 x HT_TPN Multiplikationen entfallen. Ergebnis identisch zur vollen Rechnung (Orakel rechnet immer voll).
  ht_tpz = max(abs(spl0), abs(spl1));
  ht_tpz >= ht_tpm ? ( ht_tpm = ht_tpz; ht_tpa = 0; ) : (
    ht_tpa += 1;
    ht_tpa >= HT_TPN ? (                                          // das Maximum ist aus dem Fenster gelaufen: neu bilden (danach konservativ als frisch gezaehlt)
      ht_tpw = HT_TPB + ht_tpi + 1; ht_tpx = HT_TPB + 2*HT_TPN + ht_tpi + 1; ht_tpm = 0;
      loop(HT_TPN, ht_tpm = max(ht_tpm, max(abs(ht_tpw[0]), abs(ht_tpx[0]))); ht_tpw += 1; ht_tpx += 1; );
      ht_tpa = 0;
    );
  );
  ht_tpm*ht_tps <= ht_lcl || !(ht_bx < 1) ? ( ht_ln = 1; ) : (
    ht_tpw = HT_TPB + ht_tpi + 1; ht_tpx = HT_TPB + 2*HT_TPN + ht_tpi + 1; ht_tpy = HT_TPK;
    ht_tla = 0; ht_tlb = 0; ht_tlc = 0; ht_tra = 0; ht_trb = 0; ht_trc = 0;
    loop(HT_TPN,
      ht_tla += ht_tpw[0]*ht_tpy[0]; ht_tlb += ht_tpw[0]*ht_tpy[HT_TPN]; ht_tlc += ht_tpw[0]*ht_tpy[2*HT_TPN];
      ht_tra += ht_tpx[0]*ht_tpy[0]; ht_trb += ht_tpx[0]*ht_tpy[HT_TPN]; ht_trc += ht_tpx[0]*ht_tpy[2*HT_TPN];
      ht_tpw += 1; ht_tpx += 1; ht_tpy += 1;
    );
    ht_lp = max(max(max(abs(ht_tla), abs(ht_tlb)), max(abs(ht_tlc), abs((HT_TPB + ht_tpi + 1)[HT_TPN/2]))),
                max(max(abs(ht_tra), abs(ht_trb)), max(abs(ht_trc), abs((HT_TPB + 2*HT_TPN + ht_tpi + 1)[HT_TPN/2]))));
    ht_ln = (ht_bx < 1 && ht_lp > ht_lcl) ? ht_lcl/ht_lp : 1;
  );
  ht_lq = ht_lw - HT_TPD; ht_lq < 0 ? ( ht_lq += HT_LRW; );
  (HT_LIM + 2*HT_LRW)[ht_lq] = ht_ln;                            // need-Ring
  ht_lm = 1; ht_li = ht_lq;
  loop(ht_lE + 1,
    ht_lm = min(ht_lm, (HT_LIM + 2*HT_LRW)[ht_li]);
    ht_li -= 1; ht_li < 0 ? ( ht_li += HT_LRW; );
  );
  ht_lo = ht_lq - ht_lE - 1; ht_lo < 0 ? ( ht_lo += HT_LRW; );
  ht_lsum += ht_lm - (HT_LIM + 3*HT_LRW)[ht_lo];                 // Box-Summe: neuer Wert rein, der von vor E+1 Samples raus
  (HT_LIM + 3*HT_LRW)[ht_lq] = ht_lm;
  ht_lbx = ht_lsum/(ht_lE + 1);
  ht_lbx < ht_lgn ? ( ht_lgn = ht_lbx; ) : ( ht_lgn += (ht_lbx - ht_lgn)*ht_lrc; );
  HT_LIM[ht_lw] = spl0; (HT_LIM + HT_LRW)[ht_lw] = spl1;         // Verzoegerungsring schreiben, dann D zurueck lesen
  ht_lr = ht_lw - ht_lD; ht_lr < 0 ? ( ht_lr += HT_LRW; );
  ht_lg = ht_bx < 1 ? ht_lgn : 1;
  spl0 = HT_LIM[ht_lr]*ht_lg; spl1 = (HT_LIM + HT_LRW)[ht_lr]*ht_lg;
  ht_lmn = min(ht_lmn, ht_lg);
  ht_lw += 1;
  ht_lw >= HT_LRW ? ( ht_lw = 0; );
  ht_lq == HT_LRW - 1 ? (
    ht_lsum = 0; ht_li = 0;                                      // Summe einmal je Ringumlauf exakt neu bilden (kein Drift)
    loop(ht_lE + 1, ht_lsum += (HT_LIM + 3*HT_LRW)[HT_LRW - 1 - ht_li]; ht_li += 1; );
  );
) : (
  ht_lonP = 0;                                                   // aus: beim naechsten Einschalten Ringe neu fuellen (Fix 0.2.1, kein alter Inhalt)
);

// ---- Meter-Akkus (Block-Spitzen in dBFS) + Samplezaehler ----
ht_pkI0 = max(ht_pkI0, abs(ht_x0));
ht_pkI1 = max(ht_pkI1, abs(ht_x1));
ht_pkO0 = max(ht_pkO0, abs(spl0));
ht_pkO1 = max(ht_pkO1, abs(spl1));
ht_ns += 1;
@serialize
// Format v1: erstes Wort = serVer (1). Zustand ausser den Slidern gibt es derzeit
// nicht (Vertrag 5.2) — das Wort versioniert das Format fuer spaetere Bloecke.
// Leere/alte Staende: ht_ser bleibt dann != 1 bzw. die Bank liest selbst nur,
// wenn file_avail Daten meldet (Modul prueft Magic + file_avail selbst).
// tt_pb_serialize() kommt wie im Vertrag 5.1 zuletzt.
ht_vfy = 0;                        // 0.2.6: Laden/Undo-Rueckspielen beendet die Preset-Nachpruefung (sie wuerde sonst alte Werks-Werte zurueckschreiben)
file_avail(0) >= 0 ? ( ht_xbv = 0; );   // 0.3.0: Lesen (Projekt/Undo) verwirft die EXPERT-Sicherung des Moduswechsels
ht_ser = 1;
file_var(0, ht_ser);
ht_ser == 1 ? (
  tt_pb_serialize();
);
// ht70_gfx.jsfx — komplette Front von TT-HOTT (P29-03-D). Designraster 1000x660,
// Fenster 125 % = @gfx 1250 825 (Muster der Serien-Fronten). P25-Sollform:
// tth_pre -> tt_pb_pre -> tth_sync -> uikit_begin -> Inhalt -> tt_pb_post ->
// tth_post -> tt_modtips -> tt_tipflush -> uikit_end.
// Jeder Slider-Schreibzugriff laeuft ueber tt_slset; Bedienzustand in ht29_init_ui.

@gfx 1250 825

tth_pre();
tt_pb_pre();
tth_sync(slider63);
ht_sm0 = ht_pbSum();                               // Stand vor den Reglern dieses Frames
uk_fsmax = 2;
uikit_begin(1000, 660);
uikit_ground2();
ht_zinit();
ht_ci = 0 - 1;

ht_md  = slider(HT_S_MODE) >= 0.5;             // 1 = EXPERT
ht_df1 = ht_md ? slider(HT_S_X1) : 88.3;       // angezeigte Weichenfrequenzen
ht_df2 = ht_md ? slider(HT_S_X2) : 2500;
ht_msmooth();                                  // HT_MET -> HT_UST (Glaettung + Halten)

// ---------- Kopfzeile ----------
// 0.7.0: Kopfkarte; CLASSIC/EXPERT als Segmente. Historie: btn() des Kits ohne Karte.
ht_card(8, 3, 984, 46);
gfx_setfont(1); colAcid(1); xstr(16, 2, "TT-HOTT");
gfx_setfont(5); colDim(1); xstr(18, 36, "MULTIBAND UP/DOWN COMPRESSOR");
tt_vertag(214, 37);

gfx_setfont(5);
// 0.3.0: der Klick traegt den Klang mit (ht_tofit / ht_toexp in ht29_init_ui). Historie (bis 0.2.7):
//   btn(300, 10, 62, 18, !ht_md, "CLASSIC") ? ( tt_slset(HT_S_MODE, 0); );  btn(366, 10, 62, 18, ht_md, "EXPERT") ? ( tt_slset(HT_S_MODE, 1); );
ht_seg(300, 10, 62, 18, !ht_md, "CLASSIC") && ht_md ? ( ht_tofit(); );
tt_hov(300, 10, 62, 18,
  "Switches to CLASSIC and keeps the sound: the macros are set to the closest match of your EXPERT values (HINT shows any rest).");
ht_seg(366, 10, 62, 18, ht_md, "EXPERT") && !ht_md ? ( ht_toexp(); );
tt_hov(366, 10, 62, 18,
  "Switches to EXPERT and keeps the sound: the CLASSIC setting becomes editable per-band numbers (thresholds, ratios, times, make-up). Upward ratios above 20:1 are capped; HINT says so.");
ht_tog(HT_S_DELTA, 436, 10, 56, 18, "DELTA",
  "Outputs only the difference between processed and input signal, so you hear exactly what changes; MIX is ignored.");
ht_tog(HT_S_BYP,   500, 10, 66, 18, "BYPASS",
  "Crossfades to the untouched, latency-matched input over 10 ms; the gain computers keep running, so switching back is click-free.");
ht_start_button(574, 10, 66, 18, ht_stopen, "START",
  "Opens or closes the three-step guided setup; opening it never changes your sound.") ? ht_start_view(!ht_stopen);

ht_stopen ? ( ht_start_draw(); ) : (

// ---------- Spektrum + drei Band-Panels ----------
ht_spectrum();
ht_bpanel(0, 244, 126);
ht_bpanel(1, 492, 126);
ht_bpanel(2, 740, 126);

// ---------- Linke Spalte: MACROS ----------
// 0.2.0: obere Reihe IN GAIN / MIX / OUT GAIN (Pegelkette), untere Reihe UP / DOWN / MAKEUP.
ht_card(8, 52, 228, 336); ht_ctitle(8, 52, 0 - 1, "MACROS");
ht_knob(HT_S_IN,  50, 112, 18, -24, 24, 0, 0, 1, "IN GAIN",
  "Sets the input gain in dB (-24 to +24), applied to the wet path before the crossover; the dry share of MIX stays untouched.");
ht_knob(HT_S_MIX, 118, 112, 18, 0, 100, 100, 0, 9, "MIX",
  "Blends the untouched input (0 %, bit-exact) with the fully processed signal (100 %).");
ht_knob(HT_S_OUT, 186, 112, 18, -24, 24, 0, 0, 1, "OUT GAIN",
  "Sets the output gain in dB (-24 to +24), applied to the final mix of dry and wet signal.");
ht_md ? (
  sprintf(#ht_ss, "%.0f %%", slider(HT_S_DEPTH)); ht_ghost(62, 196, 30, "DEPTH", #ht_ss);
  sprintf(#ht_ss, "%.0f %%", slider(HT_S_TIME));  ht_ghost(174, 196, 30, "TIME", #ht_ss);
  tt_hov(28, 148, 180, 94, // Review zcode 17.10.2026 (F3: Hoehe +10 bis ueber die Wertzeile)
   
    "Inactive in EXPERT: DEPTH and TIME only drive the CLASSIC model; the resolved numbers show in each band.");
) : (
  ht_knob(HT_S_DEPTH, 62, 196, 30, 0, 100, 25, 0, 9, "DEPTH",
    "Scales the effect, not a dry/wet mix: sets upward strength, downward strength and make-up together (0-100 %; 0 % = neutral).");
  ht_knob(HT_S_TIME, 174, 196, 30, 0, 1000, 100, 0, 5, "TIME",
    "Scales the release times: 100 % = factory timing, 200 % = release twice as long (0-1000 %); attack stays fixed.");
);
// Wirkungszeile: was die Makros gerade aufloesen (LOW / MID / HIGH)
gfx_setfont(5); colInk(0.7);
sprintf(#ht_ss, "rel %.1f / %.1f / %.1f ms",
  HT_RES[HT_R_RELEASE], HT_RES[HT_RESW + HT_R_RELEASE], HT_RES[2*HT_RESW + HT_R_RELEASE]);
xstr(22, 240, #ht_ss);
sprintf(#ht_ss, "mk %+.1f / %+.1f / %+.1f dB",
  HT_RES[HT_R_MAKEUP], HT_RES[HT_RESW + HT_R_MAKEUP], HT_RES[2*HT_RESW + HT_R_MAKEUP]);
xstr(22, 252, #ht_ss);
tt_hov(16, 238, 208, 26,
  "Release times and make-up gains resolved per band (LOW / MID / HIGH) - exactly what the dynamics produce now.");
ht_md ? (
  sprintf(#ht_ss, "%.0f %%", slider(HT_S_UP));   ht_ghost(50, 306, 17, "UP", #ht_ss);
  sprintf(#ht_ss, "%.0f %%", slider(HT_S_DOWN)); ht_ghost(118, 306, 17, "DOWN", #ht_ss);
  tt_hov(24, 276, 140, 62, // Review zcode 17.10.2026 (F3)
   
    "Inactive in EXPERT: UP and DOWN only drive the CLASSIC model.");
  sprintf(#ht_ss, "%.0f %%", slider(HT_S_MKUP)); ht_ghost(186, 306, 17, "MAKEUP", #ht_ss);
  tt_hov(152, 276, 76, 62, // Review zcode 17.10.2026 (F3)
   
    "Scales the model's built-in make-up gain (100 % = factory, 0 % = none); raises the overall level to make up for what the compression takes away. In EXPERT use the per-band MAKEUP value.");
) : (
  ht_knob(HT_S_UP,   50, 306, 17, 0, 200, 100, 1, 5, "UP",
    "Scales the upward branch of every band: 100 % = factory strength, 0 % = branch off, up to 200 %.");
  ht_knob(HT_S_DOWN, 118, 306, 17, 0, 200, 100, 1, 5, "DOWN",
    "Scales the downward branch of every band: 100 % = factory strength, 0 % = branch off, up to 200 %.");
  ht_knob(HT_S_MKUP, 186, 306, 17, 0, 200, 85, 1, 5, "MAKEUP",
    "Scales the model's built-in make-up gain (100 % = factory, 0 % = none); raises the overall level to make up for what the compression takes away.");
);
ht_tog(HT_S_AUTO, 16, 348, 116, 16, "AUTO GAIN",
  "Matches the wet output level to the input level with a slow RMS average (1.5 s); helps when DEPTH lifts the level a lot.");
sprintf(#ht_ss, "%+.1f dB", HT_UST[36]);
gfx_setfont(5); colWhite(0.92); xstr(140, 350, #ht_ss);
tt_hov(136, 346, 92, 18,
  "Shows the gain AUTO GAIN currently applies in dB, from a slow level match of wet output against input.");

// ---------- Linke Spalte: globale Ein-/Ausgangsmeter ----------
// 0.2.0: Zahlen unter den Balken entfallen. Rechts PEAK IN/OUT (Halte seit Klick-Reset,
// beide Kanaele, -120 = "-inf") und CEILING; unten DIFF (PEAK OUT - PEAK IN) und LIM.
ht_card(8, 396, 228, 134); ht_ctitle(8, 396, 0 - 1, "IN / OUT");
gfx_setfont(5); colInk(0.75);
xstr(38, 424, "IN"); xstr(120, 424, "OUT");
ht_vbar(34, 436, 11, 72, 0);
ht_vbar(49, 436, 11, 72, 1);
ht_vbar(112, 436, 11, 72, 2);
ht_vbar(127, 436, 11, 72, 3);
gfx_setfont(5); colInk(0.5);
xstr(152, 434, "+12"); xstr(152, 444, "0"); xstr(152, 498, "-60");
tt_hov(28, 420, 40, 88,
  "Peak level of the input in dBFS with hold, before any processing; -120 means silence.");
tt_hov(106, 420, 40, 88,
  "Peak level of the output in dBFS with hold, after all bands and gains; -120 means silence.");
// PEAK IN / PEAK OUT: hoechste Block-Spitze seit dem letzten Reset, Klick auf das Feld = Reset
gfx_setfont(5); colDim(0.7);
xstr(176, 420, "PEAK IN");
HT_PKU[0] <= -100 ? strcpy(#ht_ss, "-inf") : sprintf(#ht_ss, "%.1f", HT_PKU[0]);
colWhite(0.9); xstr(176, 431, #ht_ss);
// 0.2.7 (Review 14.10.2026): Feld 27 statt 28 hoch - bei 28 ueberlappte es in Zeile y 442 mit PEAK OUT, ein Klick setzte beide zurueck.
// Historie: uiClick && inBox(170, 415, 60, 28) ? ( HT_PKU[0] = 0 - 120; ); tt_hov(170, 415, 60, 28, ...
uiClick && inBox(170, 415, 60, 27) ? ( HT_PKU[0] = 0 - 120; );
tt_hov(170, 415, 60, 27,
  "Highest input peak in dBFS since the last reset, both channels together. Click to reset.");
colDim(0.7); xstr(176, 447, "PEAK OUT");
HT_PKU[1] <= -100 ? strcpy(#ht_ss, "-inf") : sprintf(#ht_ss, "%.1f", HT_PKU[1]);
colWhite(0.9); xstr(176, 458, #ht_ss);
uiClick && inBox(170, 442, 60, 28) ? ( HT_PKU[1] = 0 - 120; );
tt_hov(170, 442, 60, 28,
  "Highest output peak in dBFS since the last reset, both channels together. Click to reset.");
// CEILING: Ausgangsbegrenzer (-12..0 dB, "OFF" ab -0.05)
ht_xknob(HT_S_CEIL, 202, 490, 11, 0 - 12, 0, 0 - 0.3, 0.1, 11, "CEILING",
  "True-peak output limiter: ceiling in dBFS with 1.5 ms lookahead (adds that latency); also catches the peaks between the samples; 0 = OFF; stops the peaks a strong DEPTH or AUTO GAIN would push over 0 dBFS.");
// DIFF = PEAK OUT - PEAK IN (gruen <= 0, gelb bis +3, orange darueber)
min(HT_PKU[0], HT_PKU[1]) <= -100 ? (
  strcpy(#ht_ss, "DIFF --"); colDim(0.7);
) : (
  ht_dif = HT_PKU[1] - HT_PKU[0];
  sprintf(#ht_ss, "DIFF %+.1f", ht_dif);
  ht_dif <= 0 ? colAcid(0.95)
  : ht_dif <= 3 ? tth_tn(1, 0.85, 0.15, 0.95)
  : gfx_set(tth_alR, tth_alG, tth_alB, 0.95);
);
gfx_setfont(5); xstr(30, 512, #ht_ss);
tt_hov(24, 508, 80, 18,
  "Difference of the held peaks in dB: PEAK OUT minus PEAK IN (positive = the processing pushed the highest peak up).");
// LIM: Begrenzer-Reduktion des Blocks (gehalten, faellt 10 dB/s zurueck)
HT_PKU[2] <= -0.05 ? sprintf(#ht_ss, "LIM %.1f", HT_PKU[2]) : strcpy(#ht_ss, "LIM -");
HT_PKU[2] <= -0.05 ? gfx_set(tth_alR, tth_alG, tth_alB, 0.9) : colDim(0.6);
xstr(110, 512, #ht_ss);
tt_hov(104, 508, 72, 18,
  "Gain reduction of the output limiter in dB ('-' = none at the moment); the ceiling and its lookahead are set by CEILING.");

// ---------- Untere Tabs ----------
gfx_setfont(5);
ht_seg(8, 534, 118, 20, ht_tab == 0, "EXPERT VALUES") ? ( ht_tab = 0; );
tt_hov(8, 534, 118, 20,
  "Opens the EXPERT values: per-band thresholds, ratios, attack, release, make-up, plus KNEE and UP MAX GAIN.");
ht_seg(130, 534, 76, 20, ht_tab == 1, "SYSTEM") ? ( ht_tab = 1; );
tt_hov(130, 534, 76, 20,
  "Opens the SYSTEM tab: detector, stereo link, stereo mode, sidechain, lookahead and the crossover frequencies.");
ht_seg(210, 534, 66, 20, ht_tab == 2, "GUIDE") ? ( ht_tab = 2; );
tt_hov(210, 534, 66, 20,
  "Opens a short guide to a good setting: start gentle, match the level, watch the U and D meters, balance the bands.");
// Live-Hinweis aus den Metern (immer sichtbar, rechts neben den Tabs)
ht_hint();
gfx_setfont(5); colAcid(0.9); xstr(290, 539, "HINT:");
colInk(0.95); xstr(326, 539, #ht_hn);
tt_hov(290, 534, 700, 20,
  "Live hint from the meters: what to change next for a better setting.");
ht_card(8, 556, 984, 98);       // 0.7.0 (Historie: Flaeche 50 % Panelfarbe mit Trennlinie)
ht_tab == 0 ? ( ht_tabx(); ) : ht_tab == 1 ? ( ht_tabs(); ) : ( ht_tabg(); );
); // Standardfront / START: nur die jeweils sichtbare Ansicht verarbeitet ihre Bedienelemente.

// ---------- Preset-Leiste, OPTIONS, Tooltips (P25-Sollform) ----------
ht_pbSum() != ht_sm0 ? ( ht_vfy = 0; );       // Reglergriff in diesem Frame gewinnt; die Host-Nachpruefung bleibt, wenn sich zwischen den Frames etwas geaendert hat
ht_pa = tt_pb_post(OX + 658*SC, OY + 8*SC, SC);
// 0.3.0: Laden/INIT verwirft die EXPERT-Sicherung des Moduswechsels (ht_xbv), sie gehoert zum vorigen Klang
ht_pa == 1 ? ( ht_xbv = 0; ht_fload(tt_pb_arg); ht_pbApplyPV(); tt_undo(); ht_toast = time_precise() + 3; ht_vfy = time_precise() + 0.2; )
: ht_pa == 2 ? ( ht_vfy = 0; ht_xbv = 0; tt_pb_fetch(tt_pb_arg) > 0 ? ( ht_pbApply(); tt_undo(); ); )
: ht_pa == 3 ? ( ht_pbCapture(); tt_pb_commit(tt_pb_arg, HT_PSW); )
: ht_pa == 4 ? ( ht_vfy = 0; ht_xbv = 0; ht_pbInit(); tt_undo(); );
tt_pb_track(ht_pbSum());
ht_vfy > time_precise() ? ( ht_pbVerify(); );      // nur 0,2 s nach dem Laden (Codex-Befund: kein Frame-Zaehler, der bei geschlossener Front stehen bleibt)
// Preset geladen: Banner mit den Makrowerten, damit sichtbar ist, was sich geaendert hat
ht_toast > time_precise() ? (
  slider(HT_S_MODE) < 0.5 ? (
    sprintf(#ht_ss, "PRESET LOADED   DEPTH %.0f %%   TIME %.0f %%   UP %.0f %%   DOWN %.0f %%   MIX %.0f %%",
      slider(HT_S_DEPTH), slider(HT_S_TIME), slider(HT_S_UP), slider(HT_S_DOWN), slider(HT_S_MIX));
  ) : (
    sprintf(#ht_ss, "PRESET LOADED   MODE EXPERT   MIX %.0f %%", slider(HT_S_MIX));
  );
  gfx_setfont(5); gfx_set(0, 0, 0, 0.75); xrect(240, 32, 420, 14);
  colAcid(1); xstr(246, 35, #ht_ss);
);
ht_tc = tth_post(OX + 912*SC, OY + 8*SC, SC);
ht_tc >= 0 ? ( tt_slset(HT_S_COLOR, ht_tc); );
tt_modtips();
tt_tipflush();
uikit_end();
