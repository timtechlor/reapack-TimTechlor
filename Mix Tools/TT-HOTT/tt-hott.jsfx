function ht_fload(i) (
  ht_fdefaults();
  i == 0 ? (   // Init
    0;   // nur Vorgaben (leere Klammer waere in EEL2 ein Syntaxfehler - Compile-Fail, Befund 2026-10-07)
  ) : 
  i == 1 ? (   // Classic 100
    HT_PV[3] = 100;
    HT_PV[10] = 100;
  ) : 
  i == 2 ? (   // Gentle Lift
    HT_PV[3] = 25;
    HT_PV[10] = 100;
  ) : 
  i == 3 ? (   // Bus Glue 30
    HT_PV[3] = 30;
    HT_PV[7] = 100;
    HT_PV[1] = -2;
    HT_PV[10] = 100;
  ) : 
  i == 4 ? (   // Drum Smack
    HT_PV[3] = 70;
    HT_PV[5] = 130;
    HT_PV[6] = 130;
    HT_PV[10] = 100;
  ) : 
  i == 5 ? (   // Kick Punch
    HT_PV[3] = 80;
