  xstr(730, 652, "for SHAPE, STEREO, BANDS and CC OUT.");
);

// ------------------------------ Tooltip zuletzt ------------------------------
// P25: Sollform der Suite - tt_modtips/tt_tipflush, Preset-Leiste, OPTIONS, uikit_end ZULETZT (vorher stand uikit_end vor den
// Overlays; das Verhalten ist gleich, die Overlays lesen die Rohkopien der Maus).
 
// OPTIONS-Button (Theme-Modul) ganz rechts in der Kopfzeile (Designraster 912/8, seit 0.5.0; davor 700/8); links daneben die Preset-Leiste; Box legt sich als Overlay darueber
// P25: Laden (Werks/Anwender) und INIT aendern Kurven-Slots ohne Slider -> tt_undo(). SAVE (3) meldet das Modul selbst (tt_pb_commit).
ks_pa = tt_pb_post(OX + 658*SC, OY + 8*SC, SC);
ks_pa == 1 ? ( ks_gloadPreset(tt_pb_arg); tt_undo(); )
: ks_pa == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( ks_gpbApply(); tt_undo(); ); )
: ks_pa == 3 ? ( ks_pbCapture(); tt_pb_commit(tt_pb_arg, KS_PSW); )
: ks_pa == 4 ? ( ks_gpbInit(); tt_undo(); );
tt_pb_track(ks_pbSum());
ks_tc = tth_post(OX + 912*SC, OY + 8*SC, SC);
ks_tc >= 0 ? ( slider58 = ks_tc; sliderchange(slider58); slider_automate(slider58); );
tt_modtips(); tt_tipflush(); // 02.10.2026: nach allen Overlays
uikit_end();
