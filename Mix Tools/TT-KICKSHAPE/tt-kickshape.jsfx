// ------------------------------ Tooltip last ------------------------------
// P25: target layout of the suite - tt_modtips/tt_tipflush, preset bar, OPTIONS, uikit_end LAST (previously uikit_end stood before the
// overlays; the behavior is the same, the overlays read the raw copies of the mouse).
 
// OPTIONS button (theme module) far right in the header bar (design grid 912/8, since 0.5.0; before that 700/8); the preset bar to its left; the box lays itself over it as an overlay
// P25: Load (factory/user) and INIT change curve slots without a slider -> tt_undo(). SAVE (3) reports it itself (tt_pb_commit).
ks_pa = tt_pb_post(OX + 658*SC, OY + 8*SC, SC);
ks_pa == 1 ? ( ks_gloadPreset(tt_pb_arg); tt_undo(); )
: ks_pa == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( ks_gpbApply(); tt_undo(); ); )
: ks_pa == 3 ? ( ks_pbCapture(); tt_pb_commit(tt_pb_arg, KS_PSW); )
: ks_pa == 4 ? ( ks_gpbInit(); tt_undo(); );
tt_pb_track(ks_pbSum());
ks_tc = tth_post(OX + 912*SC, OY + 8*SC, SC);
ks_tc >= 0 ? ( slider58 = ks_tc; sliderchange(slider58); slider_automate(slider58); );
tt_modtips(); tt_tipflush(); // 02.10.2026: after all overlays
uikit_end();
