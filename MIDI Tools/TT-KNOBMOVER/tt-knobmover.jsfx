    sprintf(#kv_s, "%d", kv_n + 1);  xstr(kv_x + 6, kv_y + 5, #kv_s);
    sprintf(#kv_s, "%d BARS", kv_p[KF_LEN]);  xstr(kv_x + 6, kv_y + 114, #kv_s);
    // 0.8.0 Runde 2: NOTE TRIGGER an -> die Trigger-Note des Pads unten rechts (Pads 1..16 = Noten BASE..BASE+15)
    (km_ntOn && kv_n < 16) ? (
      kv_nname(km_ntBase + kv_n);
