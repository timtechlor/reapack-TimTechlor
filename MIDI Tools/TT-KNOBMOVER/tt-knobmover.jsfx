function km_tpl_13_0() (      // Speed Bump 1 (1 Takte), Stil 0
  km_addSeg(2, 1, 0);
  (km_tgt + 0*KM_SS)[KF_ED] = 1; (km_tgt + 0*KM_SS)[KF_REL] = 0; (km_tgt + 0*KM_SS)[KF_SWA] = 0; (km_tgt + 0*KM_SS)[KF_RIDE] = 0;
  (km_tgt + 0*KM_SS)[KF_S] = 15; (km_tgt + 0*KM_SS)[KF_E] = 85;
  (km_tgt + 0*KM_SS)[KF_ON + 1] = 0;
  (km_tgt + 0*KM_SS)[KF_ON + 2] = 0;
  (km_tgt + 0*KM_SS)[KF_ON + 3] = 0;
  (km_tgt + 0*KM_SS)[KF_ON + 4] = 0;
  (km_tgt + 0*KM_SS)[KF_ON + 5] = 0;
  km_ptAdd((km_tgt + 0*KM_SS), 0, 0.25, 19.375);
  km_ptAdd((km_tgt + 0*KM_SS), 0, 0.5, 32.5);
  km_ptAdd((km_tgt + 0*KM_SS), 0, 0.75, 54.375);
);
