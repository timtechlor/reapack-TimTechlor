  km_fac(35, "Melodic Break Heavy 64", 1, 10, 100, 15, 1, 0, 4);
  km_fac(36, "Scream Break Heavy 64", 2, 10, 120, 0, 1, 0, 3);
  km_fac(37, "Low Break Heavy 64", 3, 10, 80, 15, 1, 0, 4);
  km_fac(38, "Driver Fill Storm 32", 0, 11, 100, 0, 1, 0, 3);
  km_fac(39, "Melodic Fill Storm 32", 1, 11, 110, 0, 1, 0, 6);
  km_fac(40, "Scream Fill Storm 32", 2, 11, 130, 0, 1, 0, 6);
  km_fac(41, "Low Fill Storm 32", 3, 11, 80, 0, 1, 0, 5);
  km_fac(42, "Driver Tease Intro 24", 0, 12, 100, 15, 1, 0, 4);
  km_fac(43, "Melodic Tease Intro 24", 1, 12, 100, 15, 1, 0, 4);
  km_fac(44, "Scream Tease Intro 24", 2, 12, 120, 0, 1, 0, 2);
  km_fac(45, "Low Tease Intro 24", 3, 12, 80, 15, 1, 0, 4);
  km_fac(46, "Driver Steps 32", 0, 0, 100, 0, 1, 0, 3);
  km_fac(47, "Melodic Steps 32", 1, 0, 100, 0, 1, 0, 3);
  km_fac(48, "Scream Steps 32", 2, 0, 120, 0, 1, 0, 3);
  km_fac(49, "Low Steps 32", 3, 0, 80, 0, 1, 0, 3);
  km_fac(50, "Driver Saw 32", 0, 0, 100, 0, 1, 0, 2);
  km_fac(51, "Melodic Saw 32", 1, 0, 100, 0, 1, 0, 2);
  km_fac(52, "Scream Saw 32", 2, 0, 120, 0, 1, 0, 2);
  km_fac(53, "Low Saw 32", 3, 0, 80, 0, 1, 0, 2);
  km_fac(54, "Driver Tri 64", 0, 2, 100, 0, 1, 0, 1);
  km_fac(55, "Melodic Tri 64", 1, 2, 100, 0, 1, 0, 1);
  km_fac(56, "Scream Tri 64", 2, 2, 120, 0, 1, 0, 1);
  km_fac(57, "Low Tri 64", 3, 2, 80, 0, 1, 0, 1);
  km_fac(58, "Driver Wub 48", 0, 4, 110, 0, 1, 0, 6);
  km_fac(59, "Melodic Wub 48", 1, 4, 110, 0, 1, 0, 6);
  km_fac(60, "Scream Wub 48", 2, 4, 130, 0, 1, 0, 6);
  km_fac(61, "Low Wub 48", 3, 4, 90, 0, 1, 0, 6);
  km_fac(62, "Speed Bump Open", 0, 13, 100, 0, 1, 1, 0);
  km_fac(63, "Evolve 4 Bars", 0, 14, 100, 0, 1, 1, 0);
);

// ==================== Klasse waehlen (0.9.0 hierher verschoben, braucht km_applyVar aus 25_templates) ====================
// Grenzen laden, nicht bearbeitete Segmente neu aus der Klassentabelle (bearbeitete bleiben, werden geklemmt). Nicht bearbeitete Abschnitte
// behalten ihre Preset-Variante (KF_VAR): sie wird fuer die neue Klasse neu angewendet (Schwingungsform, Punkte relativ zur Klassenspanne).
function km_applyClass(c) local(i, sg, ln, ty, vr) (
  km_cls = max(0, min(3, floor(c)));
  km_limInit();
  i = 0;
  loop(km_nseg,
    sg = M_SEG + i*KM_SS;
    sg[KF_ED] < 0.5 ? ( ln = sg[KF_LEN];  ty = sg[KF_TYPE];  vr = sg[KF_VAR];  km_segInit(sg, ty);  sg[KF_LEN] = ln;  sg[KF_VAR] = vr;  km_applyVar(sg, km_cls); );
    i += 1;
  );
  km_commit();
);
// Historie: bis 0.8.0 stand km_applyClass in 20_core.jsfx und kannte keine Varianten.

// Alt-Aufbau (bis 0.8.0: KM_SS_OLD = 32 Worte je Abschnitt, hintereinander ab src) in das aktuelle Modell M_SEG uebernehmen; Punkte/Verbindung/Variante = 0
function km_oldToNew(src, n) local(i) (
  i = 0;
  loop(n,
    memset(M_SEG + i*KM_SS, 0, KM_SS);
    memcpy(M_SEG + i*KM_SS, src + i*KM_SS_OLD, KM_SS_OLD);
    i += 1;
  );
);

// Layout 3 (0.9.6, KM_SS = 434) aus Layout 2 (KM_SS_V2 = 232 Worte je Abschnitt, hintereinander ab src): die ersten 232 Worte sind gleich, die LFO-Felder bleiben 0 (= Vorgabe)
function km_v2ToNew(src, n) local(i) (
  i = 0;
  loop(n,
    memset(M_SEG + i*KM_SS, 0, KM_SS);
    memcpy(M_SEG + i*KM_SS, src + i*KM_SS_V2, KM_SS_V2);
    i += 1;
  );
);

// ==================== Regler lesen ====================
function km_readSliders() local(nc, k) (
  km_follow = slider2 > 0.5;
  km_repeat = slider3 > 0.5;
  km_start = max(1, floor(slider4));
  nc = min(16, max(1, floor(slider5)));
  // Codex-Review 09.10.2026 (1): Kanalwechsel -> Sendecache ungueltig, sonst bekaeme der neue Kanal unveraenderte Werte nie
  nc != km_ch ? ( k = 0;  loop(KM_NL, M_OUT[k] = 0 - 1;  k += 1; ); );
  km_ch = nc;
  km_rate = min(3, max(0, floor(slider6)));
  km_pass = slider7 > 0.5;
  km_cc7 = slider8 > 0.5;
  km_intens = max(0, slider9)*0.01;
  km_smooth = max(0, min(100, slider10));
  // Codex-Review 0.8.0 (1): Klassenwechsel nur noch anfordern. Ausgefuehrt wird er von genau einem Schreiber: der Front, solange sie laeuft,
  // sonst vom Block (km_clsPoll). Historie: floor(slider1) != km_cls ? km_applyClass(floor(slider1));
  floor(slider1) != km_cls ? ( km_clsWant = floor(slider1);  km_clsReq = 1; ) : ( km_clsReq = 0; );
  km_view = max(0, min(4, floor(slider12)));     // 0.8.0: Ansicht (Reiter), reine Anzeige
  // 0.8.0 Runde 2: MOVE je Lane (Slider 13..17 -> Faktor 0..2; Lane 5 Volume schwingt nicht -> fest 1),
  // SCREAM (Slider 18 -> 0..1) und NOTE TRIGGER (Slider 19..21; Basis hoechstens 112, damit Basis + 15 <= 127)
  k = 0;  loop(5, M_MOVE[k] = max(0, min(200, slider(13 + k)))*0.01;  k += 1; );
  M_MOVE[5] = 1;
  km_scream = max(0, min(100, slider18))*0.01;
  km_ntOn = slider19 > 0.5;
  km_ntCh = min(16, max(1, floor(slider20)));
  km_ntBase = min(112, max(0, floor(slider21)));
  km_rndAmt = max(0, min(100, slider24))*0.01;      // 0.9.0: Randomize
  km_rndScope = max(0, min(3, floor(slider25)));
  // 0.9.0: Import aus REAPER-Regionen/Markern. Das ReaScript schreibt die Liste nach gmem[KM_IMPB..] und setzt dann den versteckten Regler IMPORT TOKEN (nur der
  // Regler DIESER Instanz aendert sich, so erreicht der Import genau eine Instanz). Beim ersten Lesen (Projekt laden) wird nichts importiert. Die Liste
  // wird sofort in die private Kopie M_IMP genommen und als verbraucht markiert (Undo des Reglers loest also keinen zweiten Import aus); eingefuegt
  // wird sie vom einen Schreiber (km_impPoll).
  km_impInit != 1 ? ( km_impInit = 1;  km_impSeen = slider22; ) : (
    slider22 != km_impSeen ? (
      km_impSeen = slider22;
      (slider22 > 0 && gmem[KM_IMPB] == slider22 && gmem[KM_IMPB + 1] >= 1) ? (
        km_impN = min(KM_MAXSEG, floor(gmem[KM_IMPB + 1]));
        M_IMP[0] = km_impN;  M_IMP[1] = max(1, floor(gmem[KM_IMPB + 2]));
        k = 0;
        loop(km_impN, M_IMP[2 + k*2] = max(1, min(KM_MAXBARS, floor(gmem[KM_IMPB + 10 + k*2])));  M_IMP[3 + k*2] = max(0, min(7, floor(gmem[KM_IMPB + 11 + k*2])));  k += 1; );
        km_impMode = gmem[KM_IMPB + 3];
        gmem[KM_IMPB] = 0;
        km_impReq = 1;
      );
    );
  );
  km_dirty = 1;  kv_gdirty = 1;
  km_force = 1;      // Codex-Review (5): im Stillstand sofort neu auswerten (SEND CC 7, START BAR, INTENSITY ...)
);

// ==================== Ausgabe: Abbildung Projekt-Beat -> Arrangement-Beat, CC-Warteschlange ====================
// FOLLOW SONG an: Arrangement ab START BAR. Aus: das gewaehlte Segment laeuft als Schleife (zum Einrichten/Ueben).
// 0.8.0: liest nur den Audio-Abzug (ke_SEG/ke_CUM); km_sel kommt von der Front und wird auf den Abzug begrenzt.
function km_mapBeat(tb) local(sg, sb, sl, i) (
  km_follow ? ( tb - km_startBeat; ) : (
    i = max(0, min(ke_nseg - 1, floor(km_sel)));
    sg = ke_SEG + i*KM_SS;
    sb = ke_CUM[i]*km_barBeats;
    sl = max(1, sg[KF_LEN])*km_barBeats;
    sb + (tb - floor(tb/sl)*sl);
  );
);
// Historie: sg = M_SEG + km_sel*KM_SS;  sb = M_CUM[km_sel]*km_barBeats;  sl = sg[KF_LEN]*km_barBeats;
function km_gridBeats() ( 4/(km_rate == 0 ? 32 : km_rate == 1 ? 64 : km_rate == 2 ? 128 : 256); );

// 0.8.0: vorgemerkte Abschnittswahl (PADS/DESK, QUANTIZE) am Rasterpunkt tb wirksam machen
// Codex-Review 0.8.0 (5): beim Ausfuehren erneut auf die Abschnittszahl begrenzen
function km_selTick(tb) ( (km_selQ >= 0 && tb >= km_selQB - 0.0000001) ? ( km_sel = max(0, min(km_nseg - 1, km_selQ));  km_selQ = 0 - 1;  km_smok = 0; ); );

// 0.8.0 Runde 2 (PADS): Trigger-Note waehlt Abschnitt n wie ein Pad (kv_padSel + die Behandlung von km_selReqN im Block), aber
// direkt hier im Block. tb = Beatposition der Note im laufenden Block. Wirkt hoerbar wie bei den Pads nur mit FOLLOW SONG aus
// (Schleife); die Note kommt fruehestens im naechsten Block zur Wirkung (die CC-Rasterpunkte des laufenden Blocks sind schon
// gerechnet), mit QUANTIZE am naechsten Takt ab der Notenposition.
function km_noteSel(n, offs) local(tb) (
  tb = bpos + offs/samplesblock*blen;
  (km_quant && isPlay) ? (
    km_selQ = n;
    km_selQB = km_startBeat + ceil((tb - km_startBeat)/km_barBeats - 0.0000001)*km_barBeats;
  ) : (
    km_sel = n;
    km_selQ = 0 - 1;
    km_force = 1;
  );
);

function km_qpush(off, st, d1, d2) local(p) (
  km_nq < 1024 ? (
    p = M_EVQ + km_nq*4;
    p[0] = off;  p[1] = st;  p[2] = d1;  p[3] = d2;
    km_nq += 1;  km_qtotal += 1;
  );
);
// alle eingereihten Ereignisse mit Offset <= upto senden
function km_qflush(upto) local(p) (
  while (km_qi < km_nq && M_EVQ[km_qi*4] <= upto) (
    p = M_EVQ + km_qi*4;
    midisend(p[0], p[1], p[2], p[3]);
    km_qi += 1;
  );
  km_qi >= km_nq ? ( km_nq = 0;  km_qi = 0; );
);

// Eingang durchreichen, die CCs in Zeitfolge dazwischen mischen (CC vor einer Note auf demselben Sample)
function km_midiEvent() (
  km_qflush(bk_offs);
  bk_st = bk_m1 & 240;
  bk_ix = (bk_m1 & 15)*128 + bk_m2;
  // 0.8.0 Runde 2 (NOTE TRIGGER): Noten BASE..BASE+15 auf dem Trigger-Kanal waehlen Abschnitt 1..16 wie die Pads und laufen
  // nicht weiter; ein Note-Off, dessen On vor dem Einschalten durchging (M_HELD = 1), wird durchgereicht - keine haengende Note.
  (km_ntOn && (bk_st == 144 || bk_st == 128) && (bk_m1 & 15) == km_ntCh - 1 && bk_m2 >= km_ntBase && bk_m2 < km_ntBase + 16) ? (
    (bk_st == 144 && bk_m3 > 0) ? (
      bk_n2 = bk_m2 - km_ntBase;
      (bk_n2 < ke_nseg && bk_n2 < km_nseg) ? ( bk_notePend = bk_n2;  bk_noteOff = bk_offs; );
      // Runde 2 (Review Devin, 14.10.2026): ging ein frueherer On dieser Taste durch (M_HELD = 1), das Off nachsenden, sonst haengt die Note
      M_HELD[bk_ix] == 1 ? ( midisend(bk_offs, 128 + (bk_m1 & 15), bk_m2, 0); );
      M_HELD[bk_ix] = 2;  km_ntCnt += 1;  km_ntLast = bk_n2;      // verworfen
    ) : (
      M_HELD[bk_ix] == 1 ? ( midisend(bk_offs, bk_m1, bk_m2, bk_m3); );
      M_HELD[bk_ix] = 0;
    );
  ) : (bk_st == 144 && bk_m3 > 0) ? (
    // M_HELD: 1 = Note-On wurde durchgereicht, 2 = Note-On wurde verworfen (PASS NOTES aus); Codex-Review (6)
    // Review 17.10.2026 (R002): ein ueberlappendes verworfenes On darf ein durchgereichtes (1) nicht auf 2 setzen, sonst bekommt dessen Off nie ein Ende.
    // Historie: km_pass ? ( ... ) : ( M_HELD[bk_ix] = 2; );
    km_pass ? ( M_HELD[bk_ix] = 1;  midisend(bk_offs, bk_m1, bk_m2, bk_m3); ) : ( M_HELD[bk_ix] != 1 ? ( M_HELD[bk_ix] = 2; ); );
  ) : (bk_st == 128 || bk_st == 144) ? (
    // Note-Off passiert auch bei PASS NOTES aus, wenn die Note vorher durchging (keine haengenden Noten)
    M_HELD[bk_ix] == 2 ? ( M_HELD[bk_ix] = 0; )      // dessen Note-On wurde verworfen: das Off auch
    : (km_pass || M_HELD[bk_ix] == 1) ? ( M_HELD[bk_ix] = 0;  midisend(bk_offs, bk_m1, bk_m2, bk_m3); );
  ) : (
    midisend(bk_offs, bk_m1, bk_m2, bk_m3);
  );
);
function km_midiUntil(upto) (
  while (bk_hasMidi && bk_offs < upto) (
    km_midiEvent();
    bk_hasMidi = midirecv(bk_offs, bk_m1, bk_m2, bk_m3);
  );
);

// Alle Lanes am Beat tb auswerten, glaetten und bei Wertaenderung einreihen. dts = Abstand zum letzten Tick in Steps (0 = sofort).
function km_emit(off, tb, dts) local(p, i, sg, k, tgt, al, v127, act, st) (
  p = km_mapBeat(tb);
  i = ke_eval(p, M_TMP);
  // Codex-Review (11): Anzeigeposition wie die Auswertung (REPEAT: zurueck an den Anfang, sonst am Ende festgehalten)
  km_uiPos = km_repeat ? max(0, p) - floor(max(0, p)/(ke_tot*km_barBeats))*ke_tot*km_barBeats : min(max(0, p), ke_tot*km_barBeats);      // Review R005: vor START BAR (p < 0) zuerst klemmen wie ke_eval
  km_curSeg = i;
  // Historie: km_curSeg = i;  km_uiPos = p;
  sg = ke_SEG + i*KM_SS;      // 0.8.0: Audio-Abzug (Historie: M_SEG + i*KM_SS)
  al = (dts > 0 && km_smooth > 0 && km_smok) ? 1 - exp(0 - dts/(km_smooth*0.08)) : 1;
  st = 175 + km_ch;
  k = 0;
  loop(KM_NL,
    tgt = M_TMP[k];
    M_OVR[k] >= 0 ? ( tgt = min(100, max(0, M_OVR[k])); );
    M_NOW[k] = min(100, max(0, M_NOW[k] + (tgt - M_NOW[k])*al));   // Historie: Codex-Review (3): auch nach einem Klassenwechsel in den Grenzen
    // R015: nach der Glaettung die Klasse einhalten; bearbeitete Abschnitte und aktive Live-Overrides behalten 0..100.
    (sg[KF_ED] <= 0.5 && M_OVR[k] < 0) ? ( M_NOW[k] = min(M_LIMA[k*2 + 1], max(M_LIMA[k*2], M_NOW[k])); );
    // 0.8.0: Grenzen aus dem Audio-Abzug (M_LIMA), Historie: M_LIM
    // Historie: M_NOW[k] += (tgt - M_NOW[k])*al;
    v127 = floor(M_NOW[k]*127/100 + 0.5);
    act = sg[KF_ON + k] > 0.5 && (k < 5 || km_cc7);
    (act && v127 != M_OUT[k]) ? ( km_qpush(off, st, M_CCN[k], v127);  M_OUT[k] = v127; );
    k += 1;
  );
  km_smok = 1;
);

// ==================== Zustand im Projekt (@serialize), Reihenfolge: eigene Daten, danach das Preset-Modul ====================
// 0.9.6: Layoutversion 3 = Version 2 plus je Abschnitt die LFO-Felder (KF_LFOW Worte ab KF_LU) und, je Lane 0..4 mit eigenen Punkten, deren Tiefen und Raten (je n Worte).
// Version 2 (0.9.0 bis 0.9.5) und 1 werden weiter gelesen (die LFO-Felder bleiben 0 = Vorgabe).
// 0.9.0: Layoutversion 2. Je Abschnitt die ersten KM_SER_H = 40 Worte (Kopf, Lanes, Punktzahlen, Verbindung, Variante), danach die Punkte der Lanes
// mit KF_NP > 0 (je 2*Zahl Worte) - ein Arrangement ohne eigene Punkte bleibt so klein wie bisher. Version 1 (32 Worte je Abschnitt) wird weiter gelesen.
// Der Lesezweig schreibt NICHT mehr in das Modell: er liest in eine eigene Kopie (M_SERB) und meldet sie an (km_serPend); uebernommen wird sie vom einen
// Schreiber (km_serPoll: die Front bei offenem Fenster, sonst der Block). Damit ist das Restrisiko "@serialize schreibt ohne Sperre" erledigt.
// Historie: der Lesezweig rief file_mem(0, M_SEG, n*KM_SS) und km_validate() selbst auf.
KM_SER_H = 40;
function km_serWrite() local(i, k, sg, n) (
  i = 0;
  loop(km_nseg,
    sg = M_SEG + i*KM_SS;
    file_mem(0, sg, KM_SER_H);
    k = 0;
    loop(KM_NL,
      n = max(0, min(KM_PTS, floor(sg[KF_NP + k])));
      n > 0 ? file_mem(0, sg + KF_PT + k*KM_PTS*2, n*2);
      k += 1;
    );
    file_mem(0, sg + KF_LU, KF_LFOW);
    k = 0;
    loop(5,
      n = max(0, min(KM_PTS, floor(sg[KF_NP + k])));
      n > 0 ? ( file_mem(0, sg + KF_PA + k*KM_PTS, n);  file_mem(0, sg + KF_PR + k*KM_PTS, n); );
      k += 1;
    );
    i += 1;
  );
);
// liest n Abschnitte (Version 2 oder 3) nach M_SERB; 1 bei vollstaendigem Lesen. ver >= 3: zusaetzlich die LFO-Felder
function km_serReadV2(n, ver) local(i, k, sg, m, ok, v3, lw) (
  ok = 1;  i = 0;
  v3 = ver >= 3 ? 1 : 0;  lw = v3*KF_LFOW;
  while (ok && i < n) (
    sg = M_SERB + i*KM_SS;
    memset(sg, 0, KM_SS);
    ok = file_mem(0, sg, KM_SER_H) == KM_SER_H;
    k = 0;
    while (ok && k < KM_NL) (
      m = max(0, min(KM_PTS, floor(sg[KF_NP + k])));
      ok = file_mem(0, sg + KF_PT + k*KM_PTS*2, m*2) == m*2;      // m = 0: file_mem liest 0 Worte und meldet 0 (strukturell ohne ?: im while-Body)
      k += 1;
    );
    ok = ok && file_mem(0, sg + KF_LU, lw) == lw;
    k = 0;
    while (ok && k < 5) (
      m = max(0, min(KM_PTS, floor(sg[KF_NP + k])))*v3;
      ok = file_mem(0, sg + KF_PA + k*KM_PTS, m) == m;
      ok = ok && file_mem(0, sg + KF_PR + k*KM_PTS, m) == m;
      k += 1;
    );
    i += 1;
  );
  ok;
);
function km_ser() local(rd, m, ver, n, sl, ok, i) (
  rd = file_avail(0) >= 0;
  rd ? (
    file_avail(0) > 0 ? (
      m = 0;  file_var(0, m);
      abs(m - KM_MAGIC) < 0.5 ? (
        ver = 0;  n = 0;  sl = 0;
        file_var(0, ver);  file_var(0, n);  file_var(0, sl);
        // Codex-Review (7): ganzzahlige Segmentzahl, Nutzdaten muessen folgen
        ((ver == KM_VER || ver == 2 || ver == 1) && n >= 1 && n <= KM_MAXSEG && n == floor(n) && file_avail(0) > 0) ? (
          // Review zcode 17.10.2026 (B1): file_mem-Rueckgabe pruefen (abgeschnittener Chunk -> Werksdaten statt Halbstand)
          ver == 1 ? (
            ok = file_mem(0, M_SERO, n*KM_SS_OLD) == n*KM_SS_OLD;
            ok ? (
              i = 0;
              loop(n, memset(M_SERB + i*KM_SS, 0, KM_SS);  memcpy(M_SERB + i*KM_SS, M_SERO + i*KM_SS_OLD, KM_SS_OLD);  i += 1; );
            );
          ) : ( ok = km_serReadV2(n, ver); );
          km_serN = ok ? n : 0;  km_serSel = sl;
          km_serPend = ok ? 1 : 2;      // 2 = abgeschnitten: Werksdaten (km_serPoll)
        );
      );
    );
  ) : (
    m = KM_MAGIC;  ver = KM_VER;  n = km_nseg;  sl = km_sel;
    file_var(0, m);  file_var(0, ver);  file_var(0, n);  file_var(0, sl);
    km_serWrite();
  );
);
// Der eine Schreiber uebernimmt die angemeldeten Projektdaten (Front am Anfang ihres Frames, sonst der Block)
function km_serPoll() (
  km_serPend == 1 ? (
    km_serPend = 0;
    memcpy(M_SEG, M_SERB, km_serN*KM_SS);
    km_nseg = km_serN;  km_sel = km_serSel;
    km_validate();
    km_serRead = 1;
    km_dirty = 1;      // Empfehlung aus den Reviews: nach dem Lesen die Uebernahme in den Audio-Abzug erzwingen
  ) : km_serPend == 2 ? (
    km_serPend = 0;
    km_loadFactoryData(0);   // abgeschnitten: Werksdaten statt Mischzustand
    // Review R007 (19.10.2026): Klassenzustand = slider1 UND die Klassentabelle samt Variante auf die nicht bearbeiteten Werksabschnitte anwenden
    // (km_loadFactoryData(0) hat sie mit Klasse DRIVER geladen). Historie: km_cls = max(0, min(3, floor(slider1)));  km_limInit();
    km_applyClass(max(0, min(3, floor(slider1))));
    km_validate();
    km_serRead = 1;
    km_dirty = 1;
  );
);

// ==================== Preset-Bank (tt_pb_*): Klasse, Wiedergabe-Regler, Arrangement ====================
// Zustand = nur Klangrelevantes (PRESETS.md): Klasse, REPEAT, START BAR, RATE, CC 7, INTENSITY, SMOOTH, Arrangement.
// Nicht: FOLLOW SONG, MIDI CH, PASS NOTES, Farbe, Auswahl, Override.
function km_pbCapture() local(k) (
  memset(tt_pb_buf, 0, KM_PSW);
  tt_pb_buf[0] = 1;
  tt_pb_buf[1] = km_cls;   tt_pb_buf[2] = slider3;  tt_pb_buf[3] = slider4;  tt_pb_buf[4] = slider6;
  tt_pb_buf[5] = slider8;  tt_pb_buf[6] = slider9;  tt_pb_buf[7] = slider10;
  tt_pb_buf[8] = km_nseg;
  tt_pb_buf[9] = 4;                                   // Marker: 0 = alt (ohne Erweiterung), 2 = 0.8.0 (32 Worte je Abschnitt, MOVE/SCREAM ab 2060), 3 = 0.9.0 (232 Worte je Abschnitt, Erweiterung ab 10 + 64*232), 4 = 0.9.6 (KM_SS Worte, Erweiterung ab KM_PBX)
  memcpy(tt_pb_buf + 10, M_SEG, km_nseg*KM_SS);
  // 0.8.0 Runde 2: MOVE je Lane und SCREAM sind klangrelevant und wandern ins Anwender-Preset (NOTE TRIGGER/CH/BASE nicht -
  // das ist Einrichtung wie MIDI CH). Seit 0.9.0 liegt die Erweiterung ab KM_PBX (Historie: Segmente belegten 10..2057, Erweiterung ab 2060).
  k = 0;  loop(5, tt_pb_buf[KM_PBX + k] = slider(13 + k);  k += 1; );
  tt_pb_buf[KM_PBX + 5] = slider18;
);
function km_pbApply() local(n, k, ex, old, mid) (
  n = floor(tt_pb_buf[8]);
  (tt_pb_buf[0] == 1 && n >= 1 && n <= KM_MAXSEG) ? (
    km_cls = max(0, min(3, floor(tt_pb_buf[1])));
    km_limInit();
    old = tt_pb_buf[9] < 2.5;                  // Slot aus 0.8.0 oder aelter: 32 Worte je Abschnitt
    mid = tt_pb_buf[9] > 2.5 && tt_pb_buf[9] < 3.5;      // Slot aus 0.9.0 bis 0.9.5: 232 Worte je Abschnitt
    old ? ( km_oldToNew(tt_pb_buf + 10, n); ) : mid ? ( km_v2ToNew(tt_pb_buf + 10, n); ) : ( memcpy(M_SEG, tt_pb_buf + 10, n*KM_SS); );
    ex = old ? 2060 : mid ? 10 + KM_MAXSEG*KM_SS_V2 : KM_PBX;
    km_nseg = n;  km_sel = 0;
    k = 0;  loop(KM_NL, M_OVR[k] = 0 - 1;  k += 1; );
    km_validate();
    tt_slset(1, km_cls);  tt_slset(3, tt_pb_buf[2]);  tt_slset(4, tt_pb_buf[3]);  tt_slset(6, tt_pb_buf[4]);
    tt_slset(8, tt_pb_buf[5]);  tt_slset(9, tt_pb_buf[6]);  tt_slset(10, tt_pb_buf[7]);
    // 0.8.0 Runde 2: Erweiterung nur anwenden, wenn der Marker steht (alte Slots ohne sie laden die Vorgaben MOVE 100 % / SCREAM 0)
    tt_pb_buf[9] > 1.5 ? (
      tt_slset(13, max(0, min(200, tt_pb_buf[ex])));  tt_slset(14, max(0, min(200, tt_pb_buf[ex + 1])));
      tt_slset(15, max(0, min(200, tt_pb_buf[ex + 2])));  tt_slset(16, max(0, min(200, tt_pb_buf[ex + 3])));
      tt_slset(17, max(0, min(200, tt_pb_buf[ex + 4])));  tt_slset(18, max(0, min(100, tt_pb_buf[ex + 5])));
    ) : (
      tt_slset(13, 100);  tt_slset(14, 100);  tt_slset(15, 100);  tt_slset(16, 100);  tt_slset(17, 100);
      tt_slset(18, 0);
    );
  );
);
// Werks-Preset n: Regler setzen (Klasse, Wiederholen, START BAR 1, Rate, CC 7 aus, Intensitaet, Glaettung) und Daten laden (km_loadFactoryData, generiert)
function km_slFactory(n) local(p) (
  p = M_FAC + n*8;
  tt_slset(1, p[0]);  tt_slset(3, p[5]);  tt_slset(4, 1);  tt_slset(6, p[4]);  tt_slset(8, 0);  tt_slset(9, p[2]);  tt_slset(10, p[3]);
  // 0.8.0 Runde 2: MOVE und SCREAM auf die Vorgaben zurueck (Werks-Presets kennen die Erweiterung nicht)
  tt_slset(13, 100);  tt_slset(14, 100);  tt_slset(15, 100);  tt_slset(16, 100);  tt_slset(17, 100);  tt_slset(18, 0);
);
function km_pbFactory(n) (
  km_loadFactoryData(n);
  km_slFactory(n);
);
// Pruefsumme fuer den Stern der Preset-Leiste. Jeden Frame direkt aus den Daten (bis 1024 Worte, billig): eine Summe, die erst
// ueber km_seq nachlaeuft, zeigte nach dem Laden eines Presets einen falschen Stern.
function km_pbSum() local(i, s, s2, x, nw) (
  nw = km_nseg*KM_SS;
  s = 0;  s2 = 0;  i = 0;
  // Codex-Review (8): zwei Summen (linear und quadratisch mit anderen Gewichten); eine gegenlaeufige Aenderung hebt die lineare auf, nicht beide
  loop(nw, x = M_SEG[i];  s += x*(i%97 + 1);  s2 += x*x*(i%89 + 1);  i += 1; );
  s + s2*0.001 + km_cls*1000003 + slider3*131 + slider4*17 + slider6*29 + slider8*7 + slider9*3 + slider10*5 + km_nseg*977
    + slider13*41 + slider14*43 + slider15*47 + slider16*53 + slider17*59 + slider18*61;   // 0.8.0 Runde 2: MOVE/SCREAM gehoeren zum Klangzustand
);

// ==================== 0.8.0: ein Schreiber fuer das Modell (Codex-Review 0.8.0, Befund 1) ====================
// Laeuft die Front (km_galive, vom Block aus km_ggen abgeleitet), aendert nur sie das Modell M_SEG: angeforderte Klassenwechsel (aus @slider,
// Automation) und Test-Kommandos fuehrt sie am Anfang ihres Frames aus. Ist das Fenster zu (oder die Front 0,25 s still), tut es der Block.
// ==================== Import aus REAPER-Regionen / Markern (0.9.0): vom einen Schreiber ausgefuehrt ====================
// M_IMP[0] = Zahl der Abschnitte, [1] = START BAR, danach je Abschnitt (Laenge in Takten, Typ). Ergibt ein neues Arrangement aus Abschnitten mit den Werten
// der Klassentabelle (km_addSeg, ohne Variante); Auswahl auf Abschnitt 0, START BAR gesetzt, FOLLOW SONG an. Die Front meldet das Ergebnis (km_impMsg).
function km_impPoll() local(n, i, tot, ln, ty, k) (
  km_impReq ? (
    km_impReq = 0;
    n = max(1, min(KM_MAXSEG, floor(M_IMP[0])));
    km_tgt = M_SEG;  km_tcls = km_cls;  km_tn = 0;
    tot = 0;  i = 0;
    loop(n,
      ln = min(max(1, floor(M_IMP[2 + i*2])), KM_MAXBARS - tot);
      ty = max(0, min(7, floor(M_IMP[3 + i*2])));
      ln >= 1 ? ( km_addSeg(ty, ln, 0);  tot += ln; );
      i += 1;
    );
    km_nseg = max(1, km_tn);
    km_sel = 0;  km_selQ = 0 - 1;
    k = 0;  loop(KM_NL, M_OVR[k] = 0 - 1;  k += 1; );
    km_validate();
    tt_slset(4, max(1, min(999, M_IMP[1])));
    tt_slset(2, 1);
    tt_undo();
    km_impMsg = km_nseg;  km_impTot = tot;
  );
);

function km_clsPoll() ( km_serPoll();  km_impPoll();  km_clsReq ? ( km_clsReq = 0;  km_clsWant != km_cls ? km_applyClass(km_clsWant); ); );   // 0.9.0: zuerst die angemeldeten Projektdaten (km_ser), dann die Klasse
// Test-Kommandos (nur mit Freigabe), Liste im Kopf von 50_block.jsfx; 16/26 (Spiegel) laufen immer im Block
// 25.10.2026: Abschnitts-Kommandos 7-15 mit geklemmtem Index (km_testExec klemmt a1 auf 0..km_nseg-1)
function km_tcDo(c, a1, a2) (
  c == 7 ? ( km_split(a1); )
  : c == 8 ? ( km_delete(a1); )
  : c == 9 ? ( km_add(a1); )
  : c == 10 ? ( km_setType(a1, a2); )
  : c == 11 ? ( km_moveEdge(a1, a2); )
  : c == 12 ? ( km_toggleBuildup(a1); )
  : c == 13 ? ( km_toggleFill(a1); )
  : c == 14 ? ( km_copy(a1); )
  : c == 15 ? ( km_paste(a1); );
);
function km_testExec(c, a1, a2, a3) local(p) (
  c == 1 ? ( km_pbFactory(a1); )                                           // Werks-Preset laden
  : c == 2 ? ( a1 = max(0, min(9, floor(a1)));  M_OVR[a1] = a2;  km_force = 1; )   // Override setzen (-1 = aus); Review (Runde 12): Index klemmen (M_OVR hat 10 Worte)
  : c == 3 ? ( km_setTotal(a1); )                                          // Gesamtlaenge
  : c == 4 ? ( a1 = max(0, min(KM_MAXSEG - 1, floor(a1)));  a2 = max(0, min(KM_SS - 1, floor(a2)));   // Review zcode 17.10.2026 (B3): Indexklemme
               p = M_SEG + a1*KM_SS;  p[a2] = a3;  km_commit(); )          // Rohfeld eines Segments
  : c == 5 ? ( km_panic = 1; )
  : c == 6 ? ( km_sel = max(0, min(KM_MAXSEG - 1, floor(a1)));  km_commit(); )   // Review zcode 17.10.2026 (B3): Indexklemme
  // 25.10.2026 (Review knobmover-R018): Kommandos 7-15 reichten a1 ungeklemmt - jetzt auf die reale Abschnittszahl
  : c >= 7 && c <= 15 ? ( a1 = max(0, min(km_nseg - 1, floor(a1)));  km_tcDo(c, a1, a2); )
  : c == 20 ? ( km_pbCapture();  tt_pb_defname(a1);  tt_pb_commit(a1, KM_PSW); )   // Anwender-Preset speichern
  : c == 21 ? ( tt_pb_fetch(a1) > 0 ? ( km_pbApply(); ); )                 // Anwender-Preset laden
  : c == 22 ? ( km_applyClass(a1); )
  : c == 23 ? ( km_setLen(a1, a2); )
  : c == 24 ? ( km_selReq = a1;  km_selReqN += 1; )
  : c == 25 ? ( km_quant = a1 > 0.5; )
  : c == 27 ? ( km_varOff = a1 > 0.5; );                                   // 0.9.0: Preset-Varianten aus (Regressionstest gegen 0.3.0)
);
function km_tcPoll() ( km_tcPend != 0 ? ( km_testExec(km_tcPend, km_tcA1, km_tcA2, km_tcA3);  km_tcPend = 0; ); );

// ==================== Randomize (0.9.0) ====================
// Wuerfelt Werte, die zum Abschnittstyp und zur Klasse passen, statt einfach irgendwelche Zahlen zu setzen:
//  - FROM / TO jeder Lane liegen um die Werte der Klassentabelle fuer den Typ herum (Abweichung bis 45 % der Klassenspanne mal Menge); hat der
//    Typ eine deutliche Richtung (BUILD steigt, RESET faellt), bleibt sie erhalten; BUILD / ROLL / BREAK schliessen mit 50 % Wahrscheinlichkeit an das
//    Ende des Vorgaengers an.
//  - Schwingung des Cutoff: Form (alle fuenf), Tiefe um den Tabellenwert, Periode nahe am Tabellenwert aus einer musikalischen Liste; Ride +-60 % mal Menge.
//  - Eigene Punkte: Cutoff mit Wahrscheinlichkeit 70 % mal Menge 1 bis 3 (Menge > 70 %: bis 4) Punkte, die anderen Lanes mit 25 % mal Menge 1 bis 2, auf Viertel-Takten;
//    Verbindung linear / weich / Treppe.
//  - LFO je Lane (0.9.6): Lane 0..4 bekommen mit Wahrscheinlichkeit 15 % + 110 % mal Menge einen eigenen LFO: Form (Lane 1..4), Einheit (SYNC, mit 35 % mal Menge HZ), Tiefe und Rate
//    am Start, an jedem eigenen Punkt und am Ende - jeder Knoten wird mit 35 % + 65 % mal Menge einzeln gewuerfelt, sonst traegt er den Wert des Starts. So wechseln Tiefe und Tempo der Fahrt von Punkt zu Punkt.
// Immer innerhalb der Klassengrenzen; Lane 5 (Volume) und die ON-Schalter bleiben unberuehrt. amt = Menge 0..1 (Regler RANDOM AMOUNT).
// Aufruf nur vom einen Schreiber (Front / Test-Kommando 27). EEL2: rand(x) liefert 0..x.
M_RPT[0] = 2;  M_RPT[1] = 3;  M_RPT[2] = 4;  M_RPT[3] = 6;  M_RPT[4] = 8;  M_RPT[5] = 12;  M_RPT[6] = 16;  M_RPT[7] = 24;  M_RPT[8] = 32;
function km_rr(a, b) ( a + rand(1)*(b - a); );
function km_rsign(x) ( x > 0 ? 1 : x < 0 ? 0 - 1 : 0; );
// naechste Periode aus der Liste 2 3 4 6 8 12 16 24 32 (M_RPT[0..8], im Erst-Init gefuellt)
function km_rper(x) local(i, b, d, bd) (
  b = M_RPT[0];  bd = abs(x - b);
  i = 1;
  loop(8, d = abs(x - M_RPT[i]);  d < bd ? ( bd = d;  b = M_RPT[i]; );  i += 1; );
  b;
);
// Schwingung und Ride des Abschnitts sg
function km_rndSwing(sg, ty, amt) local(t, r, base, d, per) (
  t = M_TAB + (km_cls*8 + (ty == 4 ? 1 : ty))*16;
  r = rand(1);
  rand(1) < min(1, amt*1.4) ? ( sg[KF_SHP] = r < 0.25 ? 0 : r < 0.50 ? 1 : r < 0.70 ? 2 : r < 0.80 ? 3 : 4; );
  base = ty == 4 ? 0 : t[2];
  d = base*(1 + (km_rr(0.55, 1.9) - 1)*amt);
  (base < 0.5 && amt > 0.55 && rand(1) < 0.35) ? ( d = km_rr(5, 12); );
  sg[KF_SWA] = max(0, min(72, floor(d + 0.5)));
  per = (ty == 4 ? 4 : t[3])*(rand(1) < 0.5 ? 1 : rand(1) < 0.5 ? 0.5 : 2);
  rand(1) < min(1, amt*1.4) ? ( sg[KF_SWP] = max(1, min(64, km_rper(per))); ) : ( sg[KF_SWP] = max(1, min(64, sg[KF_SWP])); );
  sg[KF_RIDE] = max(0, min(200, floor(100 + km_rr(0 - 1, 1)*amt*60 + 0.5)));
);
// Lane k des Abschnitts i: FROM / TO und eigene Punkte
function km_rndLane(i, k, amt) local(sg, ty, t, si, lo, hi, sp, bs, be, s, e, dev, big, pv, n, j, x, y, ln, r, md, pp, dup, q) (
  sg = M_SEG + i*KM_SS;  ty = sg[KF_TYPE];  ln = sg[KF_LEN];
  lo = M_LIM[k*2];  hi = M_LIM[k*2 + 1];  sp = hi - lo;
  sg[KF_REL] < 0.5 ? (
    t = M_TAB + (km_cls*8 + (ty == 4 ? 1 : ty))*16;
    si = k == 0 ? 0 : k == 1 ? 4 : k == 2 ? 6 : k == 3 ? 8 : 10;
    bs = t[si];  be = t[si + 1];
    dev = amt*0.45*sp;
    s = bs + km_rr(0 - dev, dev);  e = be + km_rr(0 - dev, dev);
    big = abs(be - bs) > 0.15*sp;
    (big && km_rsign(e - s) != km_rsign(be - bs)) ? ( x = s;  s = e;  e = x; );
    (i > 0 && (ty == 1 || ty == 2 || ty == 6) && rand(1) < 0.5) ? (
      pv = M_SEG + (i - 1)*KM_SS;
      pv[KF_REL] < 0.5 ? ( s = pv[KF_E + k]; );
      // der Anschluss darf die Richtung des Typs nicht kippen: dann wird das Ende von s aus neu gesetzt
      (big && km_rsign(e - s) != km_rsign(be - bs)) ? ( e = s + km_rsign(be - bs)*abs(be - bs)*km_rr(0.5, 1.2); );
    );
    s = min(hi, max(lo, floor(s + 0.5)));  e = min(hi, max(lo, floor(e + 0.5)));
    sg[KF_S + k] = s;  sg[KF_E + k] = e;
    km_ptClear(sg, k);
    sg[KF_PM + k] = 0;
    (ln >= 2 && rand(1) < (k == 0 ? amt*0.7 : amt*0.25)) ? (
      n = 1 + floor(rand(1)*(k == 0 ? (amt > 0.7 ? 4 : 3) : 2));
      r = rand(1);
      md = r < 0.5 ? 0 : r < 0.8 ? 1 : 2;
      sg[KF_PM + k] = md;
      pp = sg + KF_PT + k*KM_PTS*2;
      loop(n,
        x = floor(km_rr(0.15, 0.85)*ln*4 + 0.5)/4/ln;
        dup = 0;  q = 0;
        loop(sg[KF_NP + k], abs(pp[q*2] - x) < 0.01 ? ( dup = 1; );  q += 1; );
        y = s + (e - s)*x + km_rr(0 - 1, 1)*amt*0.4*sp;
        dup ? 0 : km_ptAdd(sg, k, x, min(hi, max(lo, floor(y + 0.5))));
      );
    );
  );
  sg[KF_ED] = 1;  sg[KF_VAR] = 0;
);
// ---------- LFO je Lane (0.9.6) ----------
// zufaellige Tiefe: Lane 0 um den Tabellenwert a0, die anderen Lanes zwischen 0,5 und 2 + 14 mal Menge Prozent (der Wobble der Vorgabe ist mit 1 bis 2 Prozent kaum zu hoeren)
function km_rndA(k, a0, amt) (
  k == 0 ? max(0, min(72, floor(a0*(1 + (km_rr(0.35, 2) - 1)*max(0.3, amt))*2 + 0.5)/2))
         : max(0, min(72, floor(km_rr(0.5, 2 + 14*amt)*2 + 0.5)/2));
);
// zufaellige Rate: SYNC = Periode in Steps (halb aus der musikalischen Liste, halb nahe am Wert r0), HZ = 0,1 bis 6 Hz (logarithmisch)
function km_rndR(hz, r0) (
  hz ? floor(exp(km_rr(log(0.1), log(6)))*100 + 0.5)/100
     : max(1, min(64, rand(1) < 0.5 ? M_RPT[floor(rand(1)*8.999)] : km_rper(r0*(rand(1) < 0.5 ? 1 : rand(1) < 0.5 ? 0.5 : 2))));
);
// LFO der Lane k im Abschnitt sg wuerfeln (nach km_rndLane, damit die Punkte schon stehen); ohne Treffer faellt die Lane auf die Vorgabe zurueck
function km_rndLfo(sg, k, amt) local(hz, j, n, pa, pr, q, a0, r0) (
  k < 5 ? (
    sg[KF_LU + k] = 0;
    rand(1) < min(1, 0.15 + amt*1.1) ? (
      km_lfoMat(sg, k);
      hz = rand(1) < amt*0.35 ? 1 : 0;
      hz ? km_lfoUnit(sg, k, 1);
      q = 0.35 + 0.65*amt;
      // Start: Lane 0 behaelt Tiefe/Rate/Form des Swing-Wuerfelns (KF_SWA/KF_SWP/KF_SHP), die anderen Lanes werden gewuerfelt
      k > 0 ? (
        sg[KF_LS + k] = rand(1) < 0.4 ? 0 : floor(rand(1)*4.999);
        sg[KF_LA + k] = km_rndA(k, 0, amt);
        sg[KF_LR + k] = km_rndR(hz, sg[KF_LR + k]);
      );
      a0 = k == 0 ? sg[KF_SWA] : sg[KF_LA + k];
      r0 = (k == 0 && !hz) ? sg[KF_SWP] : sg[KF_LR + k];
      // Ende und eigene Punkte
      sg[KF_LA2 + k] = rand(1) < q ? km_rndA(k, a0, amt) : a0;
      sg[KF_LR2 + k] = rand(1) < q ? km_rndR(hz, r0) : r0;
      n = max(0, min(KM_PTS, floor(sg[KF_NP + k])));
      pa = sg + KF_PA + k*KM_PTS;  pr = sg + KF_PR + k*KM_PTS;
      j = 0;
      loop(n,
        pa[j] = rand(1) < q ? km_rndA(k, a0, amt) : a0;
        pr[j] = rand(1) < q ? km_rndR(hz, r0) : r0;
        j += 1;
      );
      km_lfoFix(sg, k);
    );
  );
);
// scope 0 = gewaehlter Abschnitt (alle Lanes ausser Volume), 1 = Fokus-Lane in allen Abschnitten, 2 = alles,
// 3 = BLOCK (0.9.1): nur die Fokus-Lane im gewaehlten Abschnitt (z. B. nur Env Mod oder nur Resonanz dieses Abschnitts). Rueckgabe: Zahl der veraenderten Abschnitte
function km_randomize(scope, amt) local(a, b, i, k, sg, n, one) (
  one = scope == 1 || scope == 3;
  a = (scope == 0 || scope == 3) ? km_sel : 0;
  b = (scope == 0 || scope == 3) ? km_sel : km_nseg - 1;
  (one && kv_lane > 4) ? ( b = a - 1; );
  amt < 0.004 ? ( b = a - 1; );      // Menge 0: nichts aendern
  n = 0;
  i = a;
  loop(max(0, b - a + 1),
    sg = M_SEG + i*KM_SS;
    (!one || kv_lane == 0) ? ( km_rndSwing(sg, sg[KF_TYPE], amt); );
    k = 0;
    loop(5, (!one || k == kv_lane) ? ( km_rndLane(i, k, amt);  km_rndLfo(sg, k, amt); );  k += 1; );      // 0.9.6: dazu der LFO der Lane (Historie: nur km_rndLane)
    n += 1;
    i += 1;
  );
  n > 0 ? km_commit();
  n;
);
// ==================== Ansichten (Funktionen; die Fronten stehen im @gfx) ====================
// Raster 990 x 910 (Historie: 900 x 910, davor 900 x 700) fuer alle Ansichten (PLAN.md: die groesste bestimmt das Fenster). 0.8.0: fuenf Reiter in EINER Datei (All-in-One):
//   0 RACK+ (K6, enthaelt K1), 1 MAP (K2 FAHRTENBUCH), 2 DESK (K3), 3 PADS (K4), 4 TRACKER (K5); Auswahl ueber slider12 (versteckt).
// Drag-IDs: 1..6 Live-Regler, 11..16 FROM, 21..26 TO, 31..33 MOVEMENT, 41/42 INTENSITY/SMOOTH, 50..59 Combos, 61..72 DESK-Griffe (61 + Lane*2 + TO),
//   81/82 DESK RIDE/SWING, 90 PADS-XY, 91/92 PADS RIDE/SMOOTH, 93 PADS SCREAM, 94/95 PADS CH/BASE (0.8.0 Runde 2), 101..105 DESK MOVE,
//   3000 Kante der Kurvenkarte, 3100 Lane-Griffe, 3200 Rollbalken der Karte, 3300 Rollbalken TRACKER,
//   5000 + Zeile*16 + Spalte Zellen des TRACKER.
// M_SWT (Sweetspot je Lane, Anzeige, kein Grenzwert) steht in der Speicherkarte (05_consts). Historie: M_UIC (Takt-Summen der Front, bis 0.3.0;
// seit 0.8.0 liest die Front kg_CUM aus ihrem eigenen Bake).
M_SWT[0] = 0;   M_SWT[1] = 50;
M_SWT[2] = 80;  M_SWT[3] = 100;
M_SWT[4] = 0;   M_SWT[5] = 40;
M_SWT[6] = 5;   M_SWT[7] = 50;
M_SWT[8] = 40;  M_SWT[9] = 100;
M_SWT[10] = 0;  M_SWT[11] = 100;

function kv_tcode(ty) (
  ty == 0 ? strcpy(#kv_tc, "A0") : ty == 1 ? strcpy(#kv_tc, "A1") : ty == 2 ? strcpy(#kv_tc, "A2")
  : ty == 3 ? strcpy(#kv_tc, "A3") : ty == 4 ? strcpy(#kv_tc, "A4") : ty == 5 ? strcpy(#kv_tc, "A5")
  : ty == 6 ? strcpy(#kv_tc, "BRK") : strcpy(#kv_tc, "PRE");
);
function kv_tname(ty) (
  ty == 0 ? strcpy(#kv_tn, "A0 TEASE") : ty == 1 ? strcpy(#kv_tn, "A1 ROLL") : ty == 2 ? strcpy(#kv_tn, "A2 BUILD")
  : ty == 3 ? strcpy(#kv_tn, "A3 DROP") : ty == 4 ? strcpy(#kv_tn, "A4 FILL") : ty == 5 ? strcpy(#kv_tn, "A5 RESET")
  : ty == 6 ? strcpy(#kv_tn, "BRK BREAK") : strcpy(#kv_tn, "PRE PRE-DROP");
);
function kv_sname(ty) (
  ty == 0 ? strcpy(#kv_sn, "TEASE") : ty == 1 ? strcpy(#kv_sn, "ROLL") : ty == 2 ? strcpy(#kv_sn, "BUILD")
  : ty == 3 ? strcpy(#kv_sn, "DROP") : ty == 4 ? strcpy(#kv_sn, "FILL") : ty == 5 ? strcpy(#kv_sn, "RESET")
  : ty == 6 ? strcpy(#kv_sn, "BREAK") : strcpy(#kv_sn, "PRE-DROP");
);
function kv_lname(k) (
  k == 0 ? strcpy(#kv_ln, "CUTOFF") : k == 1 ? strcpy(#kv_ln, "RESONANCE") : k == 2 ? strcpy(#kv_ln, "ENV MOD")
  : k == 3 ? strcpy(#kv_ln, "DECAY") : k == 4 ? strcpy(#kv_ln, "ACCENT") : strcpy(#kv_ln, "VOLUME");
);
function kv_lshort(k) (
  k == 0 ? strcpy(#kv_ls, "CUT") : k == 1 ? strcpy(#kv_ls, "RES") : k == 2 ? strcpy(#kv_ls, "ENV")
  : k == 3 ? strcpy(#kv_ls, "DEC") : k == 4 ? strcpy(#kv_ls, "ACC") : strcpy(#kv_ls, "VOL");
);

// Notenname einer MIDI-Notennummer -> #kv_nn (0.8.0 Runde 2, PADS NOTE TRIGGER). REAPER-Vorgabe: 60 = C4 (Oktave = floor(n/12) - 1),
// also 36 = C2. Kein String in local() - die Tabelle liegt als Kette von Bedingungen vor, die Oktave wird angehaengt.
function kv_nname(n) local(o) (
  o = n - floor(n/12)*12;
  o == 0 ? strcpy(#kv_nn, "C") : o == 1 ? strcpy(#kv_nn, "C#") : o == 2 ? strcpy(#kv_nn, "D")
  : o == 3 ? strcpy(#kv_nn, "D#") : o == 4 ? strcpy(#kv_nn, "E") : o == 5 ? strcpy(#kv_nn, "F")
  : o == 6 ? strcpy(#kv_nn, "F#") : o == 7 ? strcpy(#kv_nn, "G") : o == 8 ? strcpy(#kv_nn, "G#")
  : o == 9 ? strcpy(#kv_nn, "A") : o == 10 ? strcpy(#kv_nn, "A#") : strcpy(#kv_nn, "B");
  sprintf(#kv_s, "%d", floor(n/12) - 1);
  strcat(#kv_nn, #kv_s);
);

// Abschnittsfarbe (folgt dem Akzent des Farbschemas); hell = dunkle Schrift darauf
function kv_secCol(ty, a) (
  ty == 0 ? gfx_set(accR*0.27, accG*0.27, accB*0.27, a)
  : ty == 1 ? gfx_set(accR*0.36, accG*0.36, accB*0.36, a)
  : ty == 2 ? gfx_set(accR*0.55, accG*0.55, accB*0.55, a)
  : ty == 3 ? gfx_set(accR, accG, accB, a)
  : ty == 4 ? gfx_set(accR + (1 - accR)*0.55, accG + (1 - accG)*0.55, accB + (1 - accB)*0.55, a)
  : ty == 5 ? gfx_set(0.10 + accR*0.10, 0.14 + accG*0.14, 0.10 + accB*0.10, a)
  : ty == 6 ? gfx_set(0.21, 0.24, 0.20, a)
  : gfx_set(0.85 + 0.15*accR, 0.85 + 0.15*accG, 0.85 + 0.15*accB, a);
);
function kv_isLight(ty) ( ty == 3 || ty == 4 || ty == 7; );

// ---------- Anzeige-Modell (0.8.0): Hauptmodell oder Preset-Vorschau, beide ueber die kg_-Zeiger ----------
function kv_useMain() (
  kg_SEG = M_SEG;  kg_ES = M_ES;  kg_EE = M_EE;  kg_CUM = M_CUM;  kg_LIM = M_LIM;  kg_PRV = M_PRV;
  kg_nseg = kv_mN;  kg_cls = km_cls;  kg_tot = kv_mTot;  kg_intens = km_intens;  kg_repeat = km_repeat;
  kg_MOVE = M_MOVE;  kg_scream = km_scream;        // 0.8.0 Runde 2: die Vorschau zeigt die Linien ohne MOVE/SCREAM (M_MOVE1 / 0)
);
function kv_usePv() (
  kg_SEG = M_PVSEG;  kg_ES = M_PVES;  kg_EE = M_PVEE;  kg_CUM = M_PVCUM;  kg_LIM = M_LIMT + kv_pvCls*12;  kg_PRV = M_PVPRV;
  kg_nseg = kv_pvN;  kg_cls = kv_pvCls;  kg_tot = kv_pvTot;  kg_intens = kv_pvInt;  kg_repeat = kv_pvRep;
  kg_MOVE = M_MOVE1;  kg_scream = 0;
);
// Hauptmodell neu backen (Front-Kopie kg_bake auf M_SEG; der Audio-Thread hat seinen eigenen Abzug)
function kv_bakeMain() (
  kv_mN = max(1, min(KM_MAXSEG, floor(km_nseg)));
  kv_useMain();
  kg_bake();
  kv_mTot = kg_tot;
);
// Werks-Preset n in die Vorschau rechnen (M_PVSEG ...), ohne das Arrangement oder die Ausgabe anzufassen
function kv_pvBuild(n) local(p) (
  p = M_FAC + n*8;
  kv_pvCls = p[0];  kv_pvInt = p[2]*0.01;  kv_pvRep = p[5];
  km_tgt = M_PVSEG;  km_tcls = kv_pvCls;
  km_template(p[1], p[6]);
  km_tgt = M_SEG;
  kv_pvN = max(1, km_tn);
  kv_usePv();
  kg_bake();
  kv_pvTot = kg_tot;
  kv_useMain();
);

// ---------- Waagerechte Ansicht der Kurvenkarte (0.8.0, aus TT-ACIDLAB): Zoom >= 1, erster sichtbarer Takt kv_b0 ----------
function kv_zmax() ( max(1, min(64, kv_tot/2)); );       // mindestens 2 Takte sichtbar
function kv_view() (
  kv_zoom = max(1, min(kv_zmax(), kv_zoom));
  kv_vis = kv_tot/kv_zoom;
  kv_b0 = max(0, min(kv_tot - kv_vis, kv_b0));
);
// frac = Lage des Ankers im sichtbaren Bereich (0..1), bleibt beim Zoomen an derselben Stelle
function kv_zoomBy(f, frac) local(anc) (
  kv_view();
  anc = kv_b0 + frac*kv_vis;
  kv_zoom = max(1, min(kv_zmax(), kv_zoom*f));
  kv_vis = kv_tot/kv_zoom;
  kv_b0 = anc - frac*kv_vis;
  kv_view();
);
function kv_fit() ( kv_zoom = 1;  kv_b0 = 0;  kv_view(); );
// Abschnitt i in den sichtbaren Bereich holen (Pfeiltasten)
function kv_showSeg(i) local(a, b) (
  a = kg_CUM[i];  b = kg_CUM[i + 1];
  a < kv_b0 ? ( kv_b0 = a; );
  b > kv_b0 + kv_vis ? ( kv_b0 = min(a, b - kv_vis); );
  kv_view();
);
// Takt -> x und zurueck (Kartenbereich kv_mx0 .. kv_mx0 + kv_mw)
function kv_bx(bar) ( kv_mx0 + (bar - kv_b0)/kv_vis*kv_mw; );
function kv_xbar(x) ( kv_b0 + (x - kv_mx0)/kv_mw*kv_vis; );

// Kurvenkarte neu rechnen (GFX-Thread, eigene Eval-Kopie kg_): 6 Lanes * KM_PLOTW Spalten ueber den sichtbaren Bereich
// Historie: pb = c/KM_PLOTW*tot ueber das ganze Stueck, 5 Lanes (bis 0.3.0)
function kv_plotFill(b0, vis) local(c, k, pb, pp, pmax) (
  pmax = (kg_tot - 0.0001)*km_barBeats;
  c = 0;
  loop(KM_PLOTW,
    pb = min(pmax, (b0 + c/(KM_PLOTW - 1)*vis)*km_barBeats);
    kg_eval(pb, M_TMPG);
    k = 0;
    loop(KM_NL, pp = M_PLOT + k*KM_PLOTW;  pp[c] = M_TMPG[k];  k += 1; );
    c += 1;
  );
);

// Winkel (Grad, 0 = oben) eines Wertes 0..100 am Regler
function kv_ang(v) ( 0 - 135 + 270*min(100, max(0, v))*0.01; );

// Sweetspot-Bogen, Klassengrenzen und die zwei Ringpunkte eines Reglers. Seit 0.3.0 zeigen die Punkte die Extreme, die der Regler im
// Abschnitt wirklich erreicht (Rampe sv -> ev plus Swing/Wobble, auf die Klassengrenzen geklemmt): TIEFSTWERT (hohl) und HOECHSTWERT (voll).
// 0.8.0 Runde 2: MOVE je Lane skaliert die Schwingung, SCREAM zieht Lane 1/2 affin zum Ziel (wie ke_eval) - beides auch in den Ringpunkten.
function kv_knobExtras(cx, cy, r, k, sv, ev) local(j, a, px, py, lo, hi, amp, vlo, vhi, sct, z, np, pp) (
  // 0.9.6: die groesste Tiefe aller LFO-Knoten (Start, eigene Punkte, Ende). Historie: amp = k == 0 ? kv_sg[KF_SWA]*km_intens : k < 5 ? M_WOA[k]*kv_sg[KF_RIDE]*0.01*km_intens : 0;
  amp = 0;
  k < 5 ? (
    amp = max(kg_lA0(kv_sg, k), kg_lA1(kv_sg, k));
    j = 0;  loop(kg_lN(kv_sg, k), amp = max(amp, kv_sg[KF_PA + k*KM_PTS + j]);  j += 1; );
    amp *= k == 0 ? km_intens : kv_sg[KF_RIDE]*0.01*km_intens;
  );
  amp *= M_MOVE[k];
  // 0.9.0: die eigenen Punkte des Abschnitts gehoeren zu den Extremen. Historie: vlo = min(sv, ev) - amp;  vhi = max(sv, ev) + amp;
  vlo = min(sv, ev);  vhi = max(sv, ev);
  np = kv_sg[KF_NP + k];  pp = kv_sg + KF_PT + k*KM_PTS*2;
  j = 0;  loop(np, vlo = min(vlo, pp[j*2 + 1]);  vhi = max(vhi, pp[j*2 + 1]);  j += 1; );
  vlo -= amp;  vhi += amp;
  (km_scream > 0 && (k == 1 || k == 2)) ? (
    sct = M_TAB + (2*8 + 3)*16;
    z = k == 1 ? (sct[4] + sct[5])*0.5 : (sct[6] + sct[7])*0.5;
    vlo += (z - vlo)*km_scream;  vhi += (z - vhi)*km_scream;
  );
  // 0.9.0 (22.10.): bearbeitete Abschnitte laufen ueber die ganze Lane (die Klassengrenzen bleiben als Striche sichtbar)
  kv_sg[KF_ED] > 0.5 ? ( vlo = max(0, vlo);  vhi = min(100, vhi); ) : ( vlo = max(M_LIM[k*2], vlo);  vhi = min(M_LIM[k*2 + 1], vhi); );
  // Historie: vlo = max(M_LIM[k*2], min(sv, ev) - amp);  vhi = min(M_LIM[k*2 + 1], max(sv, ev) + amp);
  kv_xlo = vlo;  kv_xhi = vhi;
  colDim(1);
  j = 0;
  loop(3, uk_arc(cx, cy, r + 3 + j*0.8, kv_ang(M_SWT[k*2]), kv_ang(M_SWT[k*2 + 1]));  j += 1; );
  colWhite(0.85);
  lo = M_LIM[k*2];  hi = M_LIM[k*2 + 1];
  lo > 0.5 ? (
    a = kv_ang(lo)*$pi/180;
    xline(cx + sin(a)*(r + 1), cy - cos(a)*(r + 1), cx + sin(a)*(r + 8), cy - cos(a)*(r + 8));
  );
  hi < 99.5 ? (
    a = kv_ang(hi)*$pi/180;
    xline(cx + sin(a)*(r + 1), cy - cos(a)*(r + 1), cx + sin(a)*(r + 8), cy - cos(a)*(r + 8));
  );
  colAcid(1);
  j = 0;
  loop(2, uk_arc(cx, cy, r + 7 + j*0.8, kv_ang(vlo), kv_ang(vhi));  j += 1; );
  a = kv_ang(vlo)*$pi/180;
  px = cx + sin(a)*(r - 1);  py = cy - cos(a)*(r - 1);
  gfx_set(0, 0, 0, 1);  xcirc(px, py, 3.6, 1);
  colWhite(1);  xcirc(px, py, 3.6, 0);
  a = kv_ang(vhi)*$pi/180;
  px = cx + sin(a)*(r - 1);  py = cy - cos(a)*(r - 1);
  colWhite(1);  xcirc(px, py, 3.6, 1);
  gfx_set(0, 0, 0, 1);  xcirc(px, py, 1.4, 1);
);

// Zeichnet eine Lane der Kurvenkarte: Sweetspot-Band, Klassengrenzen, Abschnitts-Trennlinien, Kurve (sichtbarer Bereich, kg_-Modell)
function kv_drawLane(k, x, y, w, h, ruler) local(pp, c, y0, y1, xa, xb, stp, s0, s1, lo, hi, i, ppb, bs, b, nb, lbl) (
  gfx_set(0.02, 0.03, 0.02, 1);  xrect(x, y, w, h);
  k == kv_lane ? colAcid(0.55) : colBorder();       // 0.8.0: Fokus-Lane der Pfeiltasten hat einen hellen Rahmen
  xrect(x, y, w, 1);  xrect(x, y + h - 1, w, 1);  xrect(x, y, 1, h);  xrect(x + w - 1, y, 1, h);
  // Sweetspot-Band
  s0 = y + h - M_SWT[k*2 + 1]*0.01*h;
  s1 = y + h - M_SWT[k*2]*0.01*h;
  colAcid(0.13);  xrect(x + 1, s0, w - 2, s1 - s0);
  // Klassengrenzen (duenne Linien)
  lo = kg_LIM[k*2];  hi = kg_LIM[k*2 + 1];
  colWhite(0.34);
  hi < 99.5 ? ( y0 = y + h - hi*0.01*h;  xrect(x + 1, y0, w - 2, 1); );
  lo > 0.5 ? ( y0 = y + h - lo*0.01*h;  xrect(x + 1, y0, w - 2, 1); );
  // 0.9.0 (22.10.): Wertraster (25/50/75 %; in einer hohen Lane alle 10 %) und Taktlinien, die mit dem Zoom feiner werden
  colWhite(0.05);
  i = 1;
  loop(h >= 120 ? 9 : 3, y0 = y + h - (h >= 120 ? i*10 : i*25)*0.01*h;  xrect(x + 1, y0, w - 2, 1);  i += 1; );
  ppb = w/max(0.001, kv_vis);               // Pixel je Takt
  bs = ppb >= 7 ? 1 : ppb >= 1.8 ? 4 : 16;  // Abstand der Taktlinien
  b = ceil(kv_b0/bs)*bs;
  nb = floor((kv_b0 + kv_vis - b)/bs) + 1;
  loop(max(0, min(300, nb)),
    xa = kv_bx(b);
    (xa > x + 1 && xa < x + w - 1) ? ( (b % 4) == 0 ? colWhite(0.085) : colWhite(0.04);  xrect(xa, y + 1, 1, h - 2); );
    b += bs;
  );
  // Lineal: Taktnummern am oberen Rand der ersten gezeichneten Lane (Abstand mindestens 38 Pixel)
  (ruler && h >= 40) ? (
    gfx_setfont(5);  colDim(0.9);
    lbl = 1;  loop(5, ppb*lbl < 38 ? ( lbl *= 2; ); );
    b = ceil(kv_b0/lbl)*lbl;
    nb = floor((kv_b0 + kv_vis - b)/lbl) + 1;
    loop(max(0, min(300, nb)),
      xa = kv_bx(b);
      (xa > x + 4 && xa < x + w - 24) ? ( sprintf(#kv_s, "%d", b + 1);  xstr(xa + 2, y + 2, #kv_s); );
      b += lbl;
    );
  );
  // Abschnitts-Trennlinien (nur im sichtbaren Bereich)
  gfx_set(0.11, 0.15, 0.10, 1);
  i = 1;
  loop(kg_nseg - 1, xa = kv_bx(kg_CUM[i]);  (xa > x && xa < x + w) ? xline(xa, y, xa, y + h);  i += 1; );
  // Kurve (zwei Linien uebereinander = etwa 1,6 Einheiten dick)
  kv_pvOn ? gfx_set(1, 0.72, 0.18, 1) : colAcid(1);
  pp = M_PLOT + k*KM_PLOTW;
  stp = 2;
  c = 0;
  loop(floor((KM_PLOTW - 1)/stp),
    y0 = y + h - pp[c]*0.01*h;  y1 = y + h - pp[c + stp]*0.01*h;
    xa = x + c/(KM_PLOTW - 1)*w;  xb = x + (c + stp)/(KM_PLOTW - 1)*w;
    // 0.9.0 (22.10.): schwache Flaeche unter der Kurve
    (c % 6) == 0 ? ( (kv_pvOn ? gfx_set(1, 0.72, 0.18, 0.07) : colAcid(0.07));  xrect(xa, y0, (xb - xa)*3 + 0.6, y + h - y0); );
    kv_pvOn ? gfx_set(1, 0.72, 0.18, 1) : colAcid(1);
    xline(xa, y0, xb, y1);  xline(xa, y0 + 0.7, xb, y1 + 0.7);
    c += stp;
  );
  // Wertbeschriftung am linken Rand einer hohen Lane
  h >= 120 ? (
    gfx_setfont(5);  colDim(0.8);
    xstr(x + 4, y + h - 14, "0");  xstr(x + 4, y + h*0.5 - 6, "50");  xstr(x + 4, y + 14, "100");
  );
);

// ---------- 0.9.6: LFO-Knoten der Fokus-Lane. Knoten: START = 0, eigene Punkte = 1..16, ENDE = 100 ----------
function kv_ndPick(nd) ( kv_nd = nd;  kv_ndKey = km_sel*8 + kv_lane; );
// Tiefe und Rate des Knotens nd der Lane k im Abschnitt sg -> kv_la / kv_lr (Rate in der Einheit der Lane: Steps oder Hz)
function kv_ndGet(sg, k, nd) local(lu) (
  lu = sg[KF_LU + k] > 0.5;
  nd >= 100 ? ( kv_la = kg_lA1(sg, k);  kv_lr = kg_lR1(sg, k); )
  : (nd > 0 && lu) ? ( kv_la = sg[KF_PA + k*KM_PTS + nd - 1];  kv_lr = sg[KF_PR + k*KM_PTS + nd - 1]; )
  : ( kv_la = kg_lA0(sg, k);  kv_lr = kg_lR0(sg, k); );
);
function kv_ndPut1(sg, k, nd, wh, v) (
  nd >= 100 ? ( wh == 0 ? ( sg[KF_LA2 + k] = v; ) : ( sg[KF_LR2 + k] = v; ); )
  : nd > 0 ? ( wh == 0 ? ( sg[KF_PA + k*KM_PTS + nd - 1] = v; ) : ( sg[KF_PR + k*KM_PTS + nd - 1] = v; ); )
  : k == 0 ? ( wh == 0 ? ( sg[KF_SWA] = v; ) : ( kg_lMd(sg, 0) > 0.5 ? ( sg[KF_LR] = v; ) : ( sg[KF_SWP] = v; ); ); )
  : ( wh == 0 ? ( sg[KF_LA + k] = v; ) : ( sg[KF_LR + k] = v; ); );
);
// Tiefe (wh 0) oder Rate (wh 1) des Knotens nd setzen; all = 1: alle Knoten der Lane im Abschnitt. Der Start der Lane 0 ohne eigenen LFO schreibt wie bisher KF_SWA/KF_SWP.
function kv_ndPut(sg, k, nd, wh, v, all) local(j, n) (
  (k == 0 && nd == 0 && !all && sg[KF_LU] < 0.5) ? ( kv_ndPut1(sg, 0, 0, wh, v); ) : (
    km_lfoMat(sg, k);
    all ? (
      kv_ndPut1(sg, k, 0, wh, v);  kv_ndPut1(sg, k, 100, wh, v);
      n = sg[KF_NP + k];  j = 1;  loop(n, kv_ndPut1(sg, k, j, wh, v);  j += 1; );
    ) : kv_ndPut1(sg, k, nd, wh, v);
    km_lfoFix(sg, k);
  );
);
// Griff (Halbrechteck) im eigenen Bereich eines Abschnitts: START hohl (rechts der Grenze), ENDE voll (links der Grenze). x = linke Kante, y = Mitte, sel = gewaehlter LFO-Knoten
function kv_hnd(x, y, w, hollow, sel) (
  hollow ? (
    gfx_set(0, 0, 0, 1);  xrect(x, y - 9, w, 18);
    colWhite(1);  xrect(x, y - 9, w, 1);  xrect(x, y + 8, w, 1);  xrect(x, y - 9, 1, 18);  xrect(x + w - 1, y - 9, 1, 18);
  ) : (
    colWhite(1);  xrect(x, y - 9, w, 18);
    gfx_set(0, 0, 0, 1);  xrect(x + w*0.5 - 0.5, y - 6, 1, 12);
  );
  sel ? ( colAcid(1);  xrect(x - 2, y - 11, w + 4, 1);  xrect(x - 2, y + 10, w + 4, 1);  xrect(x - 2, y - 11, 1, 22);  xrect(x + w + 1, y - 11, 1, 22); );
);
// LFO der Lane k im gewaehlten Abschnitt als Kurve (auf die groesste Tiefe normiert) mit den Knoten (Tiefenstriche); Klick waehlt den naechsten Knoten
function kv_lfoDraw(x, y, w, h, k) local(sg, ln, i, j, t, amx, yc, ex, nn, nn2, nd, px, a, pa, pp, np, lu, best, bd, d, xp, yp, ypv, ys, wv, rd2, sb0) (
  sg = kv_sg;
  ln = max(1, sg[KF_LEN])*km_barBeats*4;
  lu = sg[KF_LU + k] > 0.5;
  np = lu ? max(0, min(KM_PTS, sg[KF_NP + k])) : 0;
  pa = sg + KF_PA + k*KM_PTS;  pp = sg + KF_PT + k*KM_PTS*2;
  // 25.10.2026 (Review knobmover-R019): ohne eigenen LFO sendet die Lane die Wobble-Schwingung,
  // nicht kg_lfo - Vorschau und Skala folgen jetzt dem Engine-Pfad (Phase M_CCN[k] + absolute Steps)
  rd2 = sg[KF_RIDE]*0.01*kg_intens;
  sb0 = kg_CUM[km_sel]*km_barBeats*4;
  amx = lu ? max(kg_lA0(sg, k), kg_lA1(sg, k))
    : k == 0 ? sg[KF_SWA]*kg_intens : M_WOA[k]*rd2;
  j = 0;  loop(np, amx = max(amx, pa[j]);  j += 1; );
  amx = max(amx, 0.5);
  ukf_well(x, y, w, h);
  yc = y + h*0.5;  ex = h*0.5 - 5;
  gfx_set(1, 1, 1, 0.10);  xrect(x + 2, yc, w - 4, 1);
  nn = np + 2;
  // Knotenlage (M_DUM als Zwischenablage) und naechster Knoten zur Maus
  best = 0 - 1;  bd = 100;
  i = 0;
  loop(nn,
    M_DUM[i] = x + 3 + (w - 6)*(i == 0 ? 0 : i == nn - 1 ? 1 : pp[(i - 1)*2]);
    d = abs(mX - M_DUM[i]);
    d < bd ? ( bd = d;  best = i; );
    i += 1;
  );
  (uiClick && best >= 0 && inBox(x, y, w, h) && !kv_pvOn) ? ( kv_ndPick(best == 0 ? 0 : best == nn - 1 ? 100 : best); );
  // Kurve (Linie doppelt, etwa 1,6 Einheiten dick)
  colAcid(1);
  nn2 = floor((w - 6)/2);
  i = 0;
  loop(nn2 + 1,
    t = i/nn2;
    wv = lu ? kg_lfo(sg, k, t, ln)
      : k == 0 ? sg[KF_SWA]*kg_intens*kg_wave(sg[KF_SHP], t*ln/max(1, sg[KF_SWP]))
      : M_WOA[k]*rd2*sin(2*$pi*((sb0 + t*ln)/M_WOP[k]) + M_CCN[k]);
    ys = yc - wv/amx*ex;
    xp = x + 3 + (w - 6)*t;
    i > 0 ? ( xline(yp, ypv, xp, ys);  xline(yp, ypv + 0.7, xp, ys + 0.7); );
    yp = xp;  ypv = ys;
    i += 1;
  );
  // Knoten: Tiefenstrich (Tiefe des Knotens), Marke auf der Mittellinie; der gewaehlte Knoten weiss
  i = 0;
  loop(nn,
    nd = i == 0 ? 0 : i == nn - 1 ? 100 : i;
    a = i == 0 ? kg_lA0(sg, k) : i == nn - 1 ? kg_lA1(sg, k) : pa[i - 1];
    px = M_DUM[i];
    (kv_nd == nd && kv_ndKey == km_sel*8 + kv_lane) ? colWhite(1) : gfx_set(1, 0.72, 0.18, 0.85);
    xrect(px - 0.5, yc - a/amx*ex, 1, max(2, 2*a/amx*ex));
    xrect(px - 2.5, yc - 2.5, 5, 5);
    i += 1;
  );
  gfx_setfont(5);  colDim(0.9);
  sprintf(#kv_s, "MAX %.1f", amx);
  xstr(x + 5, y + 3, #kv_s);
);

// v0.3.0 (aus dem MOVER-Tab der TT-ACIDLAB): Treffer auf die Griffe (START links / ENDE rechts je Abschnitt) und die Linie dazwischen.
// 0.8.0: nl Lanes, Zoom (kv_bx). Ergebnis: kv_hW = 0 START, 1 ENDE, 2 Linienmitte, -1 kein Treffer; kv_hI = Abschnitt, kv_hK = Lane.
// 0.9.0: kv_hW = 3 = eigener Punkt (kv_hP = Index) des GEWAEHLTEN Abschnitts; Punkte haben Vorrang vor den Griffen.
// y0/st/h = obere Kante der ersten Lane, Lane-Abstand, Lanehoehe. Griffe haben Vorrang vor der Linie.
function kv_laneHit(mx, my, y0, st, h, nl) local(k, i, ly, xa, xb, ya, yb, d, bd, es, ee, yl, sg, pp, n, j, px, py, a0, ln, hc) (
  kv_hW = 0 - 1;  kv_hI = 0;  kv_hK = 0;  kv_hP = 0 - 1;
  bd = 64;
  sg = M_SEG + km_sel*KM_SS;
  a0 = kg_CUM[km_sel];  ln = kg_CUM[km_sel + 1] - a0;
  k = 0;
  loop(nl,
    ly = y0 + k*st;
    n = sg[KF_NP + k];
    pp = sg + KF_PT + k*KM_PTS*2;
    j = 0;
    loop(n,
      px = kv_bx(a0 + pp[j*2]*ln);  py = ly + h - pp[j*2 + 1]*0.01*h;
      d = (px - mx)*(px - mx) + (py - my)*(py - my);
      d <= bd ? ( bd = d;  kv_hW = 3;  kv_hI = km_sel;  kv_hK = k;  kv_hP = j; );
      j += 1;
    );
    k += 1;
  );
  bd = 200;      // 0.9.6: Griffe sind Halbrechtecke im eigenen Bereich des Abschnitts (START rechts, ENDE links der Grenze), Treffer = Rechteck
  kv_hW < 0 ? (
    k = 0;
    loop(nl,
      ly = y0 + k*st;
      (my >= ly - 8 && my <= ly + h + 8) ? (
        i = 0;
        loop(kg_nseg,
          es = kg_ES + i*8;  ee = kg_EE + i*8;
          xa = kv_bx(kg_CUM[i]);  xb = kv_bx(kg_CUM[i + 1]);
          ya = ly + h - es[k]*0.01*h;   yb = ly + h - ee[k]*0.01*h;
          hc = min(3, (xb - xa)*0.15);
          (xa >= kv_mx0 - 4 && xa <= kv_mx0 + kv_mw + 4 && abs(xa + hc - mx) <= hc + 2.5 && abs(ya - my) <= 11) ? (
            d = (xa + hc - mx)*(xa + hc - mx) + (ya - my)*(ya - my);
            d <= bd ? ( bd = d;  kv_hW = 0;  kv_hI = i;  kv_hK = k; );
          );
          (xb >= kv_mx0 - 4 && xb <= kv_mx0 + kv_mw + 4 && abs(xb - hc - mx) <= hc + 2.5 && abs(yb - my) <= 11) ? (
            d = (xb - hc - mx)*(xb - hc - mx) + (yb - my)*(yb - my);
            d <= bd ? ( bd = d;  kv_hW = 1;  kv_hI = i;  kv_hK = k; );
          );
          i += 1;
        );
      );
      k += 1;
    );
  );
  kv_hW < 0 ? (
    // Linie: der Abschnitt unter dem Zeiger, naechste Lane, Abstand bis 6 Pixel (0.9.0: mit eigenen Punkten der Streckenzug)
    k = floor((my - y0)/st);
    (k >= 0 && k < nl && my <= y0 + k*st + h + 6) ? (
      ly = y0 + k*st;
      i = 0;
      loop(kg_nseg,
        xa = kv_bx(kg_CUM[i]);  xb = kv_bx(kg_CUM[i + 1]);
        (mx >= xa && mx <= xb && xb > xa) ? (
          es = kg_ES + i*8;  ee = kg_EE + i*8;
          sg = M_SEG + i*KM_SS;
          n = sg[KF_NP + k];
          yl = n > 0.5 ? ly + h - kg_lane(es[k], ee[k], (mx - xa)/(xb - xa), n, sg + KF_PT + k*KM_PTS*2, sg[KF_PM + k])*0.01*h
                       : ly + h - (es[k] + (ee[k] - es[k])*(mx - xa)/(xb - xa))*0.01*h;
          abs(my - yl) <= 6 ? ( kv_hW = 2;  kv_hI = i;  kv_hK = k; );
        );
        i += 1;
      );
    );
  );
);

// ---------- Werte setzen (Front): Abschnitt i, Lane k, wh 0 = FROM (Start), 1 = TO (Ende); klemmt auf die Klassengrenzen ----------
function kv_setVal(i, k, wh, v) local(sg) (
  sg = M_SEG + i*KM_SS;
  v = min(100, max(0, floor(v + 0.5)));      // 0.9.0 (22.10.): die ganze Lane, nicht nur die Klassengrenzen
  km_unrel(i);
  wh == 1 ? ( sg[KF_E + k] = v; ) : ( sg[KF_S + k] = v; );
  sg[KF_ED] = 1;  km_commit();  tt_undo();
);
// wirksamer Wert (gebacken, Front-Kopie) von Abschnitt i, Lane k, FROM/TO
// Codex-Review 0.8.0 (7): nicht aus dem (erst im naechsten Frame neu gebackenen) M_ES/M_EE lesen, sonst zaehlten mehrere Tasten in einem Frame
// nur einmal. Feste Abschnitte: Rohwert geklemmt (= gebackener Wert); FILL (relativ): gebacken (km_unrel macht ihn beim Setzen fest).
// Historie: function kv_getVal(i, k, wh) ( wh == 1 ? M_EE[i*8 + k] : M_ES[i*8 + k]; );
function kv_getVal(i, k, wh) local(sg) (
  sg = M_SEG + i*KM_SS;
  (sg[KF_REL] > 0.5 && k < 5) ? ( wh == 1 ? M_EE[i*8 + k] : M_ES[i*8 + k]; )
  : sg[KF_ED] > 0.5 ? min(100, max(0, sg[(wh == 1 ? KF_E : KF_S) + k]))
  : min(M_LIM[k*2 + 1], max(M_LIM[k*2], sg[(wh == 1 ? KF_E : KF_S) + k]));
);

// ---------- Abschnittswahl ueber Pads (PADS/DESK): mit QUANTIZE am naechsten Takt (Block-Thread), sonst sofort ----------
function kv_padSel(i) ( km_selReq = i;  km_selReqN += 1;  (!km_quant || !(play_state & 1)) ? ( km_sel = i; ); );

// ---------- 0.9.0: Randomize aufrufen (Knopf RANDOM und Taste R); Menge = Regler RANDOM AMOUNT, Bereich = Auswahl SECTION / LANE / ALL ----------
function kv_doRandom() local(n) (
  kv_pvOn ? ( km_msgt = 90;  strcpy(#km_m, "PREVIEW: SWITCH IT OFF FIRST"); )
  : (kv_lane > 4 && (km_rndScope == 1 || km_rndScope == 3)) ? ( km_msgt = 90;  strcpy(#km_m, "THE VOLUME LANE IS NOT RANDOMIZED"); )
  : (
    n = km_randomize(km_rndScope, km_rndAmt);
    n > 0 ? (
      tt_undo();
      km_rndScope == 3 ? ( kv_lshort(kv_lane);  sprintf(#km_m, "RANDOM %s / SECTION %d (%d %%)", #kv_ls, km_sel + 1, slider24); )
      : n == 1 ? sprintf(#km_m, "RANDOMIZED 1 SECTION (%d %%)", slider24) : sprintf(#km_m, "RANDOMIZED %d SECTIONS (%d %%)", n, slider24);
      km_msgt = 90;
    );
  );
);
// ---------- Tastatur (0.8.0, wie der MOVER-Tab der TT-ACIDLAB) ----------
// Links/Rechts = Abschnitt waehlen (Alt: Laenge -/+ 1 Takt), Pos1/Ende = erster/letzter, [ ] = Fokus-Lane, Auf/Ab = TO der Fokus-Lane +-1
// (Alt: FROM), Bild auf/ab = +-10, O = Lane im Abschnitt an/aus, Entf = Abschnitt loeschen, + / - = Zoom, F = ganze Kette.
// Tastencodes von gfx_getchar: 1818584692 'left', 1919379572 'rght', 30064 'up', 1685026670 'down', 1885828464 'pgup', 1885824110 'pgdn',
// 1752132965 'home', 6647396 'end', 6579564 'del' (als Zahl, das Literal 'right' gibt es nicht).
function kv_key(c, cap) local(sg, d, wh, chg, busy) (
  sg = M_SEG + km_sel*KM_SS;
  // Codex-Review 0.8.0 (9)/(10): aendernde Tasten nicht waehrend der Preset-Vorschau (die Karte zeigt dann nicht das Arrangement) und nicht,
  // solange die Maus einen Griff, eine Kante oder eine Zelle zieht (sonst loeschte Entf den gezogenen Abschnitt)
  chg = c == 30064 || c == 1685026670 || c == 1885828464 || c == 1885824110 || c == 111 || c == 79 || c == 6579564 || c == 114 || c == 82
        || ((c == 1818584692 || c == 1919379572) && (cap & 16));
  busy = km_ld > 0 || km_edge >= 0 || dragId > 0;
  (chg && kv_pvOn) ? ( km_msgt = 90;  strcpy(#km_m, "PREVIEW: LOAD OR SWITCH IT OFF FIRST");  c = 0; );
  (chg && busy) ? ( c = 0; );
  wh = km_view == 4 ? kv_trW : 1;          // TRACKER: die Fokuszelle bestimmt FROM/TO
  (cap & 16) ? ( wh = 1 - wh; );            // Alt = das andere Ende
  d = c == 30064 ? 1 : c == 1685026670 ? 0 - 1 : c == 1885828464 ? 10 : c == 1885824110 ? 0 - 10 : 0;
  c == 1818584692 ? (
    (cap & 16) ? ( km_setLen(km_sel, sg[KF_LEN] - 1);  tt_undo(); ) : ( km_sel = max(0, km_sel - 1);  kv_showSeg(km_sel); );
  ) : c == 1919379572 ? (
    (cap & 16) ? ( km_setLen(km_sel, sg[KF_LEN] + 1);  tt_undo(); ) : ( km_sel = min(km_nseg - 1, km_sel + 1);  kv_showSeg(km_sel); );
  ) : c == 1752132965 ? ( km_sel = 0;  kv_showSeg(0); )
  : c == 6647396 ? ( km_sel = km_nseg - 1;  kv_showSeg(km_sel); )
  : c == 91 ? ( kv_lane = (kv_lane + 5) % 6; )
  : c == 93 ? ( kv_lane = (kv_lane + 1) % 6; )
  : d != 0 ? ( kv_setVal(km_sel, kv_lane, wh, kv_getVal(km_sel, kv_lane, wh) + d); )
  : (c == 111 || c == 79) ? ( sg[KF_ON + kv_lane] = sg[KF_ON + kv_lane] > 0.5 ? 0 : 1;  sg[KF_ED] = 1;  km_commit();  tt_undo(); )
  : (c == 114 || c == 82) ? ( kv_doRandom(); )
  : c == 6579564 ? ( km_delete(km_sel) ? tt_undo(); )
  : (c == 43 || c == 61) ? ( kv_zoomBy(1.25, 0.5); )
  : c == 45 ? ( kv_zoomBy(0.8, 0.5); )
  : (c == 102 || c == 70) ? ( kv_fit(); )
  : (c == 109 || c == 77) ? ( kv_lmax = kv_lmax ? 0 : 1; );   // 0.9.0 (22.10.): Lane maximieren
);

// ---------- Zahlenzelle (TRACKER): Ziehen senkrecht (3 Einheiten je Wertschritt, Umschalt fein), Rad +-1,
// Doppel-/Rechts-/Strg-Klick = def. Rueckgabe: neuer Wert (ganzzahlig, geklemmt). sel = Fokuszelle (heller Rahmen).
// Codex-Review 0.8.0: nur bei Bedienung (Klick-Reset, Ziehen, Rad) einen geklemmten neuen Wert liefern; sonst val unveraendert zurueck
// (vorher klemmte die Zelle einen Anzeigewert ausserhalb neuer Klassengrenzen und schrieb ihn zurueck, z. B. im Frame nach einem Klassenwechsel).
function kv_cell(id, x, y, w, h, val, vmn, vmx, def, sel) local(nv, hot, sh, act) (
  nv = val;  act = 0;
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = inBox(x, y, w, h);
  uiRClk && hot ? ( nv = def;  act = 1; )
  : uiClick && hot ? (
      ((mouse_cap & 4) || (clickId == id && clickWait > 0)) ? ( nv = def;  act = 1;  dragId = -1;  clickWait = 0; )
      : ( dragId = id;  dragY = mY;  dragV = val;  dragSh = sh;  clickId = id;  clickWait = 12; );
    );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh;  dragY = mY;  dragV = val; );
    nv = dragV + floor((dragY - mY)/(sh ? 12 : 3));
    act = 1;
  );
  hot && mouse_wheel != 0 ? ( nv = val + (mouse_wheel > 0 ? 1 : 0 - 1);  mouse_wheel = 0;  act = 1; );
  nv = act ? min(vmx, max(vmn, floor(nv + 0.5))) : val;
  (hot || dragId == id) ? gfx_set(0.10, 0.14, 0.09, 1) : gfx_set(0.035, 0.045, 0.035, 1);
  xrect(x, y, w, h);
  sel ? colAcid(0.9) : colBorder();
  xrect(x, y, w, 1);  xrect(x, y + h - 1, w, 1);  xrect(x, y, 1, h);  xrect(x + w - 1, y, 1, h);
  nv;
);

// ---------- Kurvenkarte mit Abschnittsband (RACK+ und MAP; 0.8.0 als Funktion, mit Zoom, Rollbalken und Vorschau) ----------
// x0/w = Kartenbereich, bandY = Oberkante des Abschnittsbands, ly0/st/lh = erste Lane, Lane-Abstand, Lanehoehe, nl = Anzahl Lanes (5 oder 6),
// sbY = Rollbalken (nur bei Zoom > 1). Bearbeiten nur am Hauptmodell (bei aktiver Vorschau nur ansehen, zoomen, rollen).
// Aus dem MOVER-Tab der TT-ACIDLAB (v0.3.0): Griff START (hohl) / ENDE (voll) ziehen = Wert, Linienmitte ziehen = beide gemeinsam (Abstand
// bleibt, die Klassengrenzen stoppen beide), Umschalt = fein (1/6 der Strecke). Ein FILL-Abschnitt wird dabei in feste Werte ueberfuehrt (km_unrel).
function kv_mapUI(x0, w, bandY, ly0, st, lh, nl, sbY) local(i, p, xa, xb, cx, cw, k, y, ya, yb, hs, best, bar, nv, sh, lo, hi, dv, dd, sgd, thx, thw, ph, es, ee, ah, xc, xd, np, pp, j, t0, t1, v0, v1, ci, ck, nx, ox, oy, ln, a0, dbl, px, py, ly, ry0, mx_on, bh, lit, hv, bb, hc) (
  kv_mx0 = x0;  kv_mw = w;
  ah = ly0 + (nl - 1)*st + lh;       // Unterkante der letzten Lane
  // 0.9.0 (22.10.): Lane maximieren: die Fokus-Lane belegt die ganze Hoehe, die anderen rutschen weit aus dem Bild (Abstand 1000); alle Treffer- und
  // Zeichenrechnungen laufen unveraendert ueber ly0 + k*st. ry0 = die echte Oberkante (fuer Kasten-Tests und Tooltips)
  ry0 = ly0;
  mx_on = kv_lmax && kv_lane < nl;
  mx_on ? ( lh = ah - ly0;  ly0 = ly0 - kv_lane*1000;  st = 1000; );
  // Auswahlspalte
  !kv_pvOn ? (
    xa = max(x0, kv_bx(kg_CUM[km_sel]));  xb = min(x0 + w, kv_bx(kg_CUM[km_sel + 1]));
    xb > xa ? ( colWhite(0.06);  xrect(xa, bandY - 2, xb - xa, ah - bandY + 2); );
  );
  // Abschnittsband (nur der sichtbare Teil)
  i = 0;
  loop(kg_nseg,
    p = kg_SEG + i*KM_SS;
    xa = kv_bx(kg_CUM[i]);  xb = kv_bx(kg_CUM[i + 1]);
    cx = max(x0, xa);  cw = min(x0 + w, xb) - cx;
    cw > 1 ? (
      kv_secCol(p[KF_TYPE], 1);
      xrect(cx + 1, bandY, max(1, cw - 2), 22);
      gfx_setfont(5);
      kv_isLight(p[KF_TYPE]) ? gfx_set(0.02, 0.06, 0.02, 1) : colInk(1);
      kv_tcode(p[KF_TYPE]);
      cw > 60 ? ( kv_sname(p[KF_TYPE]);  sprintf(#kv_s, "%s %s", #kv_tc, #kv_sn); ) : strcpy(#kv_s, #kv_tc);
      gfx_measurestr(#kv_s, kv_w1, kv_h1);
      kv_w1/SC < cw - 6 ? ( xstr(cx + 6, bandY + 5, #kv_s); );
    );
    i += 1;
  );
  // Auswahlrahmen
  !kv_pvOn ? (
    xa = kv_bx(kg_CUM[km_sel]);  xb = kv_bx(kg_CUM[km_sel + 1]);
    cx = max(x0, xa);  cw = min(x0 + w, xb) - cx;
    cw > 0 ? (
      colWhite(1);  xrect(cx, bandY - 1, cw, 2);  xrect(cx, bandY + 21, cw, 2);
      xa >= x0 ? xrect(xa, bandY - 1, 2, 24);
      xb <= x0 + w ? xrect(xb - 2, bandY - 1, 2, 24);
    );
  );
  // Lanes
  k = 0;
  loop(nl,
    y = ly0 + k*st;
    (!mx_on || k == kv_lane) ? (
      gfx_setfont(5);
      !mx_on ? (
        k == kv_lane ? colAcid(1) : colDim(1);
        kv_lshort(k);  sprintf(#kv_s, "%s - CC %d", #kv_ls, M_CCN[k]);  xstr(26, y + 2, #kv_s);
        (k == 5 && !km_cc7) ? ( colDim(0.8);  xstr(26, y + 15, "CC 7 OFF"); )
        : ( colAcid(1);  sprintf(#kv_s, "%d %%", floor(M_NOW[k] + 0.5));  xstr(26, y + 15, #kv_s); );
        // 0.9.0 (22.10.): Knopf "Lane maximieren" (zwei ineinanderliegende Rahmen) unter dem CC-Namen rechts
        hv = inBox(86, y + 14, 14, 12);
        hv ? colAcid(1) : colDim(1);
        xrect(86, y + 14, 14, 1);  xrect(86, y + 25, 14, 1);  xrect(86, y + 14, 1, 12);  xrect(99, y + 14, 1, 12);
        xrect(89, y + 17, 8, 1);   xrect(89, y + 22, 8, 1);   xrect(89, y + 17, 1, 6);   xrect(96, y + 17, 1, 6);
        (hv && uiClick) ? ( kv_lane = k;  kv_lmax = 1;  uiClick = 0; );
        tt_hov(86, y + 14, 14, 12, "Maximize this lane: it takes the whole height of the map (the other lanes are hidden) for finer editing. Key M, or the MAX button in the bar, brings the lanes back.");
      );
      kv_drawLane(k, x0, y, w, lh, k == (mx_on ? kv_lane : 0));
    );
    k += 1;
  );
  // 0.9.0 (22.10.): maximiert: links die Lane-Wahl (jede Lane ein Knopf mit ihrem Wert), erneuter Klick auf die gewaehlte Lane stellt alle wieder her
  mx_on ? (
    gfx_setfont(5);
    bh = min(26, (ah - ry0 - (nl - 1)*3)/nl);
    k = 0;
    loop(nl,
      y = ry0 + k*(bh + 3);
      kv_lshort(k);
      (k == 5 && !km_cc7) ? sprintf(#kv_s, "%s OFF", #kv_ls) : sprintf(#kv_s, "%s %d %%", #kv_ls, floor(M_NOW[k] + 0.5));
      btn(22, y, 78, bh, k == kv_lane, #kv_s) ? ( k == kv_lane ? ( kv_lmax = 0; ) : ( kv_lane = k; ); );
      k += 1;
    );
    tt_hov(22, ry0, 78, ah - ry0, "Choose the lane shown at full height (the value is the one being sent). Click the lit lane again, press M or use MAX in the bar to see all lanes.");
  );
  // Abspielkopf (Hauptmodell)
  !kv_pvOn ? (
    ph = kv_bx(max(0, km_uiPos)/km_barBeats);
    (ph >= x0 && ph <= x0 + w) ? ( colWhite(0.95);  xline(ph, bandY - 4, ph, ah + 2); );
  );
  // Vorschau-Hinweis
  kv_pvOn ? (
    gfx_setfont(5);
    gfx_set(0, 0, 0, 0.7);  xrect(x0 + w - 238, ry0 + 2, 234, 14);
    gfx_set(1, 0.72, 0.18, 1);  xstr(x0 + w - 232, ry0 + 4, "PREVIEW - NOT SENT, LOAD TO USE");
  );
  // Griffe des gewaehlten (bzw. gegriffenen) Abschnitts: START hohl, ENDE voll; die Linie dazwischen (auf den sichtbaren Teil gekappt)
  !kv_pvOn ? (
    hs = (km_ld > 0) ? km_ldI : km_sel;
    es = kg_ES + hs*8;  ee = kg_EE + hs*8;
    xa = kv_bx(kg_CUM[hs]);  xb = kv_bx(kg_CUM[hs + 1]);
    xc = max(x0, xa);  xd = min(x0 + w, xb);
    k = 0;
    loop(nl,
      y = ly0 + k*st;
      ya = y + lh - es[k]*0.01*lh;  yb = y + lh - ee[k]*0.01*lh;
      sgd = M_SEG + hs*KM_SS;
      np = sgd[KF_NP + k];
      np > 0.5 ? (
        // 0.9.0: Streckenzug FROM -> eigene Punkte -> TO (bei weicher Verbindung und Treppe in 64 Schritten abgetastet), nur der sichtbare Teil
        pp = sgd + KF_PT + k*KM_PTS*2;
        colWhite(0.9);
        t0 = 0;  v0 = es[k];
        j = 1;
        loop(64,
          t1 = j/64;  v1 = kg_lane(es[k], ee[k], t1 >= 1 ? 0.999999 : t1, np, pp, sgd[KF_PM + k]);
          cx = xa + (xb - xa)*t0;  cw = xa + (xb - xa)*t1;
          (cx >= x0 && cw <= x0 + w) ? xline(cx, y + lh - v0*0.01*lh, cw, y + lh - v1*0.01*lh);
          t0 = t1;  v0 = v1;  j += 1;
        );
        j = 0;
        loop(np,
          px = xa + (xb - xa)*pp[j*2];  py = y + lh - pp[j*2 + 1]*0.01*lh;
          (px >= x0 && px <= x0 + w) ? (
            km_ld == 3 && km_ldK == k && km_ldP == j ? colWhite(1) : colAcid(1);
            xcirc(px, py, 3.6, 1);  gfx_set(0, 0, 0, 1);  xcirc(px, py, 3.6, 0);
            (k == kv_lane && kv_nd == j + 1 && kv_ndKey == km_sel*8 + kv_lane) ? ( colWhite(1);  xcirc(px, py, 6.2, 0); );      // 0.9.6: gewaehlter LFO-Knoten
          );
          j += 1;
        );
      ) : (
        xd > xc ? ( colWhite(0.9);  xline(xc, ya + (yb - ya)*(xc - xa)/max(0.001, xb - xa), xd, ya + (yb - ya)*(xd - xa)/max(0.001, xb - xa)); );
      );
      // 0.9.6: Griffe als Halbrechtecke im eigenen Bereich des Abschnitts (sie ueberlappen nicht mit denen der Nachbarn und zeigen: nur senkrecht beweglich)
      hc = min(6, (xb - xa)*0.3);
      (xa >= x0 && xa <= x0 + w) ? kv_hnd(xa, ya, hc, 1, k == kv_lane && kv_nd == 0 && kv_ndKey == km_sel*8 + kv_lane);
      (xb >= x0 && xb <= x0 + w) ? kv_hnd(xb - hc, yb, hc, 0, k == kv_lane && kv_nd == 100 && kv_ndKey == km_sel*8 + kv_lane);
      k += 1;
    );
    // 0.9.0: eigene Punkte der uebrigen Abschnitte als kleine Marken
    i = 0;
    loop(kg_nseg,
      i != hs ? (
        sgd = M_SEG + i*KM_SS;
        a0 = kg_CUM[i];  ln = kg_CUM[i + 1] - a0;
        k = 0;
        loop(nl,
          np = sgd[KF_NP + k];
          np > 0.5 ? (
            pp = sgd + KF_PT + k*KM_PTS*2;
            colAcid(0.75);
            j = 0;
            loop(np,
              px = kv_bx(a0 + pp[j*2]*ln);  py = ly0 + k*st + lh - pp[j*2 + 1]*0.01*lh;
              (px >= x0 && px <= x0 + w) ? xrect(px - 1.5, py - 1.5, 3, 3);
              j += 1;
            );
          );
          k += 1;
        );
      );
      i += 1;
    );
    km_ld > 0 ? (
      gfx_setfont(5);
      km_ld == 3 ? sprintf(#kv_s, "BAR %.2f  %d %%", km_ldC2, floor(km_ldC + 0.5))
      : km_ld == 2 ? sprintf(#kv_s, "%d / %d %%", floor(km_ldC + 0.5), floor(km_ldC2 + 0.5))
                 : sprintf(#kv_s, "%d %%", floor(km_ldC + 0.5));
      colWhite(1);  xstr(min(mX + 12, x0 + w - 60), max(bandY + 4, mY - 16), #kv_s);
    );
  );

  // ---- Bedienung: Kante ziehen oder Abschnitt waehlen (Band) ----
  (!kv_pvOn && inBox(x0 - 4, bandY - 2, w + 8, 26) && uiClick) ? (
    best = -1;  i = 1;
    loop(kg_nseg - 1,
      xa = kv_bx(kg_CUM[i]);
      (xa >= x0 && xa <= x0 + w && abs(mX - xa) <= 4) ? ( best = i - 1; );
      i += 1;
    );
    best >= 0 ? (
      km_edge = best;  dragId = 3000;
    ) : (
      bar = kv_xbar(mX);
      i = 0;
      loop(kg_nseg, bar >= kg_CUM[i] ? ( km_sel = i; );  i += 1; );
    );
  );
  (km_ld > 0 && km_ldI > km_nseg - 1) ? ( km_ld = 0;  dragId = -1; );          // Codex-Review 0.8.0 (10): Abschnitt verschwunden -> Zug abbrechen
  km_edge > km_nseg - 2 ? ( km_edge = 0 - 1; );
  km_edge >= 0 ? (
    uiLmb ? (
      km_moveEdge(km_edge, kv_xbar(mX)) ? tt_undo();
    ) : ( km_edge = -1; );
  );
  // ---- Werte senkrecht in den Lanes bearbeiten ----
  // 0.9.0: Doppelklick auf die Linie / in die Lane setzt einen eigenen Punkt (Viertel-Takt-Raster, Umschalt = frei), ziehen verschiebt ihn, Rechtsklick oder
  // Alt+Klick loescht ihn. Griffe und Linienmitte wie bisher.
  kv_dcT > 0 ? ( kv_dcT -= 1; );
  (!kv_pvOn && km_ld == 0 && km_edge < 0) ? (
    kv_laneHit(mX, mY, ly0, st, lh, nl);
    dbl = 0;
    (uiClick && inBox(x0 - 6, ry0 - 6, w + 12, ah - ry0 + 12) && (kv_hW == 2 || kv_hW < 0)) ? (
      bar = kv_xbar(mX);  ci = 0;  i = 0;
      loop(kg_nseg, bar >= kg_CUM[i] ? ( ci = i; );  i += 1; );
      ck = max(0, min(nl - 1, floor((mY - ly0)/st)));
      (kv_dcT > 0 && kv_dcI == ci && kv_dcK == ck) ? ( dbl = 1;  kv_dcT = 0; ) : ( kv_dcT = 18;  kv_dcI = ci;  kv_dcK = ck; );
    );
    (kv_hW == 3 && inBox(x0 - 6, ry0 - 6, w + 12, ah - ry0 + 12) && (uiRClk || (uiClick && (mouse_cap & 16)))) ? (
      // Punkt loeschen
      sgd = M_SEG + kv_hI*KM_SS;
      km_ptDel(sgd, kv_hK, kv_hP) ? ( sgd[KF_ED] = 1;  km_commit();  tt_undo();  km_sel = kv_hI;  kv_lane = kv_hK; );
    ) : (kv_hW == 3 && inBox(x0 - 6, ry0 - 6, w + 12, ah - ry0 + 12) && uiClick) ? (
      // Punkt greifen
      km_sel = kv_hI;  kv_sg = M_SEG + km_sel*KM_SS;  kv_lane = kv_hK;
      kv_ndPick(kv_hP + 1);
      sgd = kv_sg;
      km_ld = 3;  km_ldI = kv_hI;  km_ldK = kv_hK;  km_ldP = kv_hP;  km_ldH = lh;  km_ldLy = ly0 + kv_hK*st;
      pp = sgd + KF_PT + kv_hK*KM_PTS*2;
      km_ldV = pp[kv_hP*2 + 1];  km_ldC = km_ldV;  km_ldC2 = kg_CUM[km_ldI] + pp[kv_hP*2]*sgd[KF_LEN];
      km_ldY = mY;  km_ldSh = (mouse_cap & 8) ? 1 : 0;
      dragId = 3100;
    ) : dbl ? (
      // neuen Punkt setzen und gleich weiterziehen
      sgd = M_SEG + ci*KM_SS;
      km_unrel(ci);
      ln = sgd[KF_LEN];
      bar = kv_xbar(mX) - kg_CUM[ci];
      (mouse_cap & 8) ? 0 : ( bar = floor(bar*4 + 0.5)/4; );
      ly = ly0 + ck*st;
      nv = min(100, max(0, floor((ly + lh - mY)/lh*100 + 0.5)));
      j = km_ptAdd(sgd, ck, bar/ln, nv);
      j >= 0 ? (
        sgd[KF_ED] = 1;  km_commit();  tt_undo();
        km_sel = ci;  kv_sg = sgd;  kv_lane = ck;
        kv_ndPick(j + 1);
        km_ld = 3;  km_ldI = ci;  km_ldK = ck;  km_ldP = j;  km_ldH = lh;  km_ldLy = ly;
        pp = sgd + KF_PT + ck*KM_PTS*2;
        km_ldV = nv;  km_ldC = nv;  km_ldC2 = kg_CUM[ci] + pp[j*2]*ln;
        km_ldY = mY;  km_ldSh = (mouse_cap & 8) ? 1 : 0;
        dragId = 3100;
      ) : ( km_msgt = 90;  strcpy(#km_m, "THIS LANE ALREADY HAS 16 POINTS IN THE SECTION"); );
    ) : (kv_hW >= 0 && inBox(x0 - 6, ry0 - 6, w + 12, ah - ry0 + 12) && uiClick) ? (
      km_sel = kv_hI;  kv_sg = M_SEG + km_sel*KM_SS;  kv_lane = kv_hK;
      kv_hW == 0 ? kv_ndPick(0) : kv_hW == 1 ? kv_ndPick(100);
      km_ld = kv_hW == 2 ? 2 : 1;  km_ldI = kv_hI;  km_ldK = kv_hK;  km_ldW = kv_hW;  km_ldH = lh;
      es = kg_ES + km_ldI*8;  ee = kg_EE + km_ldI*8;
      km_ldV = km_ldW == 1 ? ee[km_ldK] : es[km_ldK];
      km_ldV2 = ee[km_ldK];
      km_ldV3 = es[km_ldK];
      km_ldC = km_ldW == 1 ? km_ldV : km_ldV3;  km_ldC2 = km_ldV2;
      km_ldY = mY;  km_ldSh = (mouse_cap & 8) ? 1 : 0;
      dragId = 3100;
    );
  );
  km_ld > 0 ? (
    uiLmb ? (
      sh = (mouse_cap & 8) ? 1 : 0;
      sh != km_ldSh ? ( km_ldSh = sh;  km_ldY = mY;  km_ldV = km_ldC;  km_ldV3 = km_ldC;  km_ldV2 = km_ldC2; );
      lo = 0;  hi = 100;       // 0.9.0 (22.10.): die ganze Lane (Klassengrenzen = nur Anzeige)
      dv = (km_ldY - mY)/(km_ldH*(sh ? 6 : 1))*100;
      sgd = M_SEG + km_ldI*KM_SS;
      km_ld == 3 ? (
        // Punkt ziehen: x folgt der Maus (Viertel-Takte, Umschalt frei), y absolut (Umschalt: fein, relativ), zwischen den Nachbarn, in den Klassengrenzen
        sh != km_ldSh ? ( km_ldSh = sh;  km_ldY = mY;  km_ldV = km_ldC; );
        ln = max(1, sgd[KF_LEN]);
        bar = kv_xbar(mX) - kg_CUM[km_ldI];
        sh ? 0 : ( bar = floor(bar*4 + 0.5)/4; );
        nv = sh ? km_ldV + (km_ldY - mY)/(km_ldH*6)*100 : (km_ldLy + km_ldH - mY)/km_ldH*100;
        nv = min(hi, max(lo, floor(nv + 0.5)));
        pp = sgd + KF_PT + km_ldK*KM_PTS*2;
        km_ldP < sgd[KF_NP + km_ldK] ? (
          ox = pp[km_ldP*2];  oy = pp[km_ldP*2 + 1];
          km_ptMove(sgd, km_ldK, km_ldP, bar/ln, nv, lo, hi);
          (pp[km_ldP*2] != ox || pp[km_ldP*2 + 1] != oy) ? ( sgd[KF_ED] = 1;  km_commit();  tt_undo(); );
          km_ldC = pp[km_ldP*2 + 1];  km_ldC2 = kg_CUM[km_ldI] + pp[km_ldP*2]*ln;
        ) : ( km_ld = 0;  dragId = -1; );
      ) : km_ld == 1 ? (
        nv = min(hi, max(lo, floor(km_ldV + dv + 0.5)));
        nv != km_ldC ? (
          km_unrel(km_ldI);
          km_ldC = nv;
          km_ldW == 1 ? ( sgd[KF_E + km_ldK] = nv; ) : ( sgd[KF_S + km_ldK] = nv; );
          sgd[KF_ED] = 1;  km_commit();  tt_undo();
        );
      ) : (
        // beide: km_ldV3 = START, km_ldV2 = ENDE beim Greifen bzw. beim letzten Wechsel Umschalt
        dd = min(hi - max(km_ldV3, km_ldV2), max(lo - min(km_ldV3, km_ldV2), floor(dv + 0.5)));
        (km_ldV3 + dd != km_ldC || km_ldV2 + dd != km_ldC2) ? (
          km_unrel(km_ldI);
          km_ldC = km_ldV3 + dd;  km_ldC2 = km_ldV2 + dd;
          sgd[KF_S + km_ldK] = km_ldC;  sgd[KF_E + km_ldK] = km_ldC2;
          sgd[KF_ED] = 1;  km_commit();  tt_undo();
        );
      );
    ) : ( km_ld = 0;  dragId = -1; );
  );
  // Klick in eine Lane (ohne Griff) waehlt den Abschnitt und die Fokus-Lane
  (!kv_pvOn && inBox(x0, ry0, w, ah - ry0) && uiClick && km_edge < 0 && km_ld == 0 && !(kv_hW >= 0)) ? (
    bar = kv_xbar(mX);
    i = 0;
    loop(kg_nseg, bar >= kg_CUM[i] ? ( km_sel = i; );  i += 1; );
    kv_lane = max(0, min(nl - 1, floor((mY - ly0)/st)));
  );
  // 0.9.0 (22.10.): Fadenkreuz mit Takt und Wert unter dem Zeiger (nur ohne Ziehen), damit man den Zielwert vor dem Setzen eines Punktes sieht
  (!kv_pvOn && km_ld == 0 && km_edge < 0 && dragId <= 0 && inBox(x0, ry0, w, ah - ry0)) ? (
    ck = max(0, min(nl - 1, floor((mY - ly0)/st)));
    ly = ly0 + ck*st;
    (mY >= ly && mY <= ly + lh) ? (
      nv = max(0, min(100, (ly + lh - mY)/lh*100));
      bb = kv_xbar(mX);
      colWhite(0.2);  xrect(x0 + 1, mY, w - 2, 1);  xrect(mX, ly + 1, 1, lh - 2);
      sprintf(#kv_s, "BAR %d.%d  %d %%  CC %d", floor(bb) + 1, floor((bb - floor(bb))*km_barBeats) + 1, floor(nv + 0.5), floor(nv*1.27 + 0.5));
      gfx_setfont(5);
      px = min(mX + 12, x0 + w - 124);  py = max(ly + 2, mY - 18);
      gfx_set(0, 0, 0, 0.72);  xrect(px - 3, py - 1, 122, 13);
      colWhite(1);  xstr(px, py, #kv_s);
    );
  );
  // ---- Zoom und Rollen: Strg + Rad zoomt um den Zeiger, Rad rollt (nur gezoomt), Rollbalken ----
  (inBox(x0, bandY - 2, w, ah - bandY + 2) && mouse_wheel != 0) ? (
    (mouse_cap & 4) ? ( kv_zoomBy(exp(mouse_wheel/120*0.25), max(0, min(1, (mX - x0)/w))); )
    : kv_zoom > 1.0001 ? ( kv_b0 -= mouse_wheel/120*kv_vis*0.1;  kv_view(); );
    mouse_wheel = 0;
  );
  kv_zoom > 1.0001 ? (
    gfx_set(0.03, 0.04, 0.03, 1);  xrect(x0, sbY, w, 6);
    thw = max(14, kv_vis/kv_tot*w);
    thx = x0 + kv_b0/max(0.001, kv_tot - kv_vis)*(w - thw);
    (dragId == 3200 || inBox(thx, sbY - 2, thw, 10)) ? colAcid(0.9) : colAcid(0.5);
    xrect(thx, sbY, thw, 6);
    (uiClick && inBox(x0, sbY - 3, w, 12)) ? (
      inBox(thx, sbY - 3, thw, 12) ? ( dragId = 3200;  kv_sbX = mX;  kv_sbB = kv_b0; )
      : ( kv_b0 = (mX - x0 - thw/2)/max(1, w - thw)*(kv_tot - kv_vis);  kv_view(); );
    );
    (dragId == 3200 && uiLmb) ? ( kv_b0 = kv_sbB + (mX - kv_sbX)/max(1, w - thw)*(kv_tot - kv_vis);  kv_view(); );
    tt_hov(x0, sbY - 3, w, 12, "Scroll the zoomed map along the song (the mouse wheel over the map does the same).");
  );
  kv_pvOn ? tt_hov(x0, ry0, w, ah - ry0, "Preview of the chosen factory preset: shown only, nothing is sent to the TT-303. LOAD takes it over, OFF returns to your arrangement. Ctrl + wheel zooms, wheel scrolls.")
  : tt_hov(x0, ry0, w, ah - ry0, "Course of the CC lanes over the arrangement. Green band = sweet spot, thin lines = class limits (a guide only: the whole lane 0-100 can be used). Click selects a section and the lane for the arrow keys. Drag a dot (hollow = FROM, solid = TO of the ramp) up or down to change that value, drag the line between them to move both; Shift = fine. Ctrl + wheel zooms, wheel scrolls when zoomed.");
  tt_hov(x0, bandY - 2, w, 26, "Sections of the arrangement. Click selects, dragging an edge between two sections moves it by whole bars. Arrow keys: Left/Right select, Alt+Left/Right change the length.");
  !mx_on ? tt_hov(16, ry0, x0 - 18, ah - ry0, "Lane name, CC number and the value being sent right now. The lane in green is the one the Up/Down keys edit ([ and ] change it).");
);

// ---------- 0.9.0: Lane-Leiste (Verbindung der eigenen Punkte, Punkte loeschen) und Randomize, links in der Kopfleiste der Karte ----------
// Randomize: Menge = Regler RANDOM AMOUNT (Mausrad ueber dem Knopf), Bereich = Auswahl SECTION / LANE / ALL. Taste R wirkt genauso.
function kv_laneBar(y) local(k, sg, np, md, nv, n, i, p) (
  k = kv_lane;
  sg = M_SEG + km_sel*KM_SS;
  np = sg[KF_NP + k];  md = sg[KF_PM + k];
  kv_lshort(k);
  md < 0.5 ? strcpy(#kv_s, "LINEAR") : md < 1.5 ? strcpy(#kv_s, "SMOOTH") : strcpy(#kv_s, "STEPS");
  sprintf(#cmb_txt, "%s %dP %s", #kv_ls, np, #kv_s);
  nv = combo(58, 112, y, 130, 17, md, 3);
  nv != md ? ( !kv_pvOn ? ( sg[KF_PM + k] = nv;  sg[KF_ED] = 1;  km_commit();  tt_undo(); ); );
  tt_hov(112, y, 130, 17, "Focus lane, number of own points in the selected section, and how they are joined: LINEAR = straight segments, SMOOTH = eased curve, STEPS = holds each value until the next point. Double-click a lane to add a point, drag to move it, right-click (or Alt+click) to delete it.");
  gfx_setfont(5);
  btn(246, y, 46, 17, 0, "CLEAR") ? (
    !kv_pvOn ? (
      (mouse_cap & 8) ? (
        n = 0;  i = 0;
        loop(km_nseg, p = M_SEG + i*KM_SS;  p[KF_NP + k] > 0 ? ( km_ptClear(p, k);  p[KF_ED] = 1;  n += 1; );  i += 1; );
        n > 0 ? ( km_commit();  tt_undo();  km_msgt = 60;  sprintf(#km_m, "POINTS CLEARED IN %d SECTIONS", n); ) : ( km_msgt = 60;  strcpy(#km_m, "NO POINTS ON THIS LANE"); );
      ) : np > 0 ? (
        km_ptClear(sg, k);  sg[KF_ED] = 1;  km_commit();  tt_undo();  km_msgt = 60;  strcpy(#km_m, "POINTS CLEARED");
      ) : ( km_msgt = 60;  strcpy(#km_m, "NO POINTS ON THIS LANE"); );
    );
  );
  tt_hov(246, y, 46, 17, "Removes the own points of the focus lane in the selected section, so the line runs straight from FROM to TO again. Shift+click = in all sections.");
  // 0.9.0 (22.10.): Lane maximieren (Taste M)
  toggle(296, y, 46, 17, kv_lmax, "MAX") ? ( kv_lmax = kv_lmax ? 0 : 1; );
  tt_hov(296, y, 46, 17, "Maximize the focus lane: it takes the whole height of the map, the other lanes are hidden, so you can edit it much more precisely (also fine-drag with Shift). Choose the lane at the left, click MAX again or press M to bring all lanes back.");
  // zweite Zeile: RANDOM (Bereich, Knopf, Menge, Ziel)
  y += 21;
  km_rndScope == 0 ? strcpy(#cmb_txt, "RND: SECTION") : km_rndScope == 1 ? strcpy(#cmb_txt, "RND: LANE") : km_rndScope == 2 ? strcpy(#cmb_txt, "RND: ALL") : strcpy(#cmb_txt, "RND: BLOCK");
  nv = combo(59, 112, y, 130, 17, km_rndScope, 4);
  nv != km_rndScope ? ( tt_slset(25, nv); );
  tt_hov(112, y, 130, 17, "What RANDOM changes: SECTION = every lane of the selected section, LANE = the focus lane in all sections, ALL = the whole arrangement, BLOCK = only the focus lane in the selected section (e.g. just Env Mod or just Resonance of this section). The volume lane is never touched.");
  gfx_setfont(5);
  btn(246, y, 96, 17, 0, "RANDOM") ? ( kv_doRandom(); );
  tt_hov(246, y, 96, 17, "Rolls new values that fit the section type and the class: FROM / TO around the class table, swing shape, depth and period, ride and sometimes own points. Ctrl+Z undoes it. Key: R.");
  colDim(1);  xstr(352, y + 3, "AMOUNT");
  (inBox(352, y, 240, 17) && mouse_wheel != 0) ? ( tt_slset(24, max(0, min(100, slider24 + (mouse_wheel > 0 ? 5 : 0 - 5))));  mouse_wheel = 0; );
  kv_nv = hsliderst(60, 404, y + 3, 150, 11, slider24, 0, 100, 50, 1);
  kv_nv != slider24 ? ( tt_slset(24, kv_nv); );
  colAcid(1);  sprintf(#kv_s, "%d %%", slider24);  xstr(560, y + 3, #kv_s);
  tt_hov(352, y, 240, 17, "How far RANDOM strays from the class table: 0 = hardly any change, 100 = wild. Mouse wheel over the slider: +-5.");
  // Ziel des naechsten RANDOM in Worten (rechtsbuendig)
  kv_lshort(kv_lane);
  km_rndScope == 0 ? sprintf(#kv_s, "TARGET: ALL LANES / SECTION %d", km_sel + 1)
  : km_rndScope == 1 ? sprintf(#kv_s, "TARGET: %s / ALL SECTIONS", #kv_ls)
  : km_rndScope == 2 ? strcpy(#kv_s, "TARGET: THE WHOLE ARRANGEMENT")
  : sprintf(#kv_s, "TARGET: %s / SECTION %d", #kv_ls, km_sel + 1);
  gfx_measurestr(#kv_s, kv_w1, kv_h1);
  colDim(1);  xstr(964 - kv_w1/SC, y + 3, #kv_s);
);

// ---------- 0.9.6: Liste der Werks-Presets fuer PREVIEW (Overlay, am Ende des @gfx gezeichnet und ausgewertet) ----------
// Klick auf eine Zeile waehlt (0 = OFF), Klick daneben schliesst, Rad blaettert, Rechtsklick schliesst. Auf den Reitern ohne Karte schliesst sie sich selbst.
function kv_pvList() local(nr, rh, vis, x, y, w, h, r, hv, ry, sx, th, ty) (
  (kv_pvDrop && km_view > 1) ? ( kv_pvDrop = 0; );
  kv_pvDrop ? (
    nr = KM_NFAC + 1;  rh = 16;  vis = min(nr, 17);
    x = 346;  y = kv_pvY + 19;  w = 464;  h = vis*rh + 4;
    kv_pvScr = max(0, min(nr - vis, kv_pvScr));
    (inBox(x, y, w, h) && kv_dpW != 0) ? ( kv_pvScr = max(0, min(nr - vis, kv_pvScr - (kv_dpW > 0 ? 3 : 0 - 3))); );
    hv = (inBox(x, y + 2, w - 10, h - 4)) ? floor((mY - y - 2)/rh) : 0 - 1;
    hv >= vis ? ( hv = 0 - 1; );
    gfx_set(0, 0, 0, 0.5);  xrect(x + 3, y + 4, w, h);
    gfx_set(0.035, 0.045, 0.035, 1);  xrect(x, y, w, h);
    colAcid(0.9);  xrect(x, y, w, 1);  xrect(x, y + h - 1, w, 1);  xrect(x, y, 1, h);  xrect(x + w - 1, y, 1, h);
    gfx_setfont(5);
    r = 0;
    loop(vis,
      ry = y + 2 + r*rh;
      (kv_pvScr + r) == kv_pv ? ( colAcid(0.18);  xrect(x + 1, ry, w - 8, rh);  colAcid(1);  xrect(x + 1, ry, 3, rh); );
      r == hv ? ( colAcid(0.22);  xrect(x + 1, ry, w - 8, rh); );
      (kv_pvScr + r) == 0 ? strcpy(#kv_s, "OFF  (your arrangement)") : ( tt_pb_getname(kv_pvScr + r - 1);  sprintf(#kv_s, "%02d  %s", kv_pvScr + r, #tt_pb_s); );
      (kv_pvScr + r) == kv_pv ? colAcid(1) : colInk(0.95);
      xstrfit(x + 10, ry, w - 28, rh, #kv_s);
      r += 1;
    );
    // Rollbalken
    nr > vis ? (
      sx = x + w - 6;  th = max(10, (h - 4)*vis/nr);  ty = y + 2 + ((h - 4) - th)*kv_pvScr/max(1, nr - vis);
      gfx_set(1, 1, 1, 0.06);  xrect(sx, y + 2, 4, h - 4);
      colAcid(0.7);  xrect(sx, ty, 4, th);
    );
    kv_dpR ? ( kv_pvDrop = 0; );
    kv_dpC ? (
      inBox(x, y, w, h) ? (
        hv >= 0 ? ( kv_pv = kv_pvScr + hv;  kv_pvDrop = 0; )
        : ( mX >= x + w - 10 && nr > vis ? ( kv_pvScr = max(0, min(nr - vis, floor((mY - y)/h*(nr - vis + 1)))); ); );
      ) : ( kv_pvDrop = 0; );
      kv_dpC = 0;
    );
  );
);

// ---------- Kopfleiste der Karte: Vorschau-Auswahl, LOAD, Zoom (RACK+ und MAP) ----------
function kv_mapBar(y) local(nv, mid, rc) (
  // 0.9.6: Ist die Liste offen, gehoeren Klick, Rechtsklick und Rad ihr (sie wertet am Ende des Frames aus: kv_pvList)
  kv_pvDrop ? ( kv_dpC = uiClick;  kv_dpR = uiRClk;  kv_dpW = mouse_wheel;  uiClick = 0;  uiRClk = 0;  mouse_wheel = 0; );
  kv_laneBar(y);
  kv_pvY = y;
  kv_pv > 0 ? ( tt_pb_getname(kv_pv - 1);  sprintf(#cmb_txt, "PREVIEW: %s", #tt_pb_s); ) : strcpy(#cmb_txt, "PREVIEW: OFF");
  // Mitte = Liste oeffnen, Rechtsklick = zurueck auf OFF; Pfeile und Rad wie bisher
  mid = uiClick && inBox(346 + 24, y, 464 - 48, 17);
  rc = uiRClk && inBox(346, y, 464, 17);
  mid ? ( uiClick = 0;  kv_pvDrop = 1;  kv_dpC = 0;  kv_pvScr = max(0, kv_pv - 6); );
  rc ? ( uiRClk = 0;  kv_pv = 0;  kv_pvDrop = 0; );
  nv = combo(57, 346, y, 464, 17, kv_pv, KM_NFAC + 1);
  nv != kv_pv ? ( kv_pv = nv; );
  tt_hov(346, y, 464, 17, "Preview a factory preset in the map without loading it and without sending anything to the TT-303. Click the middle = list of all presets, arrows or wheel = next preset, right-click = back to OFF (your arrangement).");
  gfx_setfont(5);
  btn(814, y, 50, 17, 0, "LOAD") ? (
    kv_pv > 0 ? ( km_pbFactory(kv_pv - 1);  tt_pb_select(1, kv_pv - 1);  tt_undo();  km_msgt = 60;  strcpy(#km_m, "PRESET LOADED");  kv_pv = 0; )
    : ( km_msgt = 60;  strcpy(#km_m, "CHOOSE A PREVIEW FIRST"); );
  );
  tt_hov(814, y, 50, 17, "Loads the previewed factory preset into the arrangement (undo with Ctrl+Z).");
  btn(870, y, 22, 17, 0, "-") ? ( kv_zoomBy(0.8, 0.5); );
  tt_hov(870, y, 22, 17, "Zoom out: show more bars (Ctrl + mouse wheel over the map, or the - key).");
  btn(894, y, 22, 17, 0, "+") ? ( kv_zoomBy(1.25, 0.5); );
  tt_hov(894, y, 22, 17, "Zoom in: fewer bars, more detail (Ctrl + mouse wheel over the map, or the + key).");
  btn(918, y, 46, 17, kv_zoom > 1.0001, "FIT") ? ( kv_fit(); );
  tt_hov(918, y, 46, 17, "Show the whole arrangement again (F key). Lit while zoomed.");
);

// ==================== Erst-Init, Preset-Bank, Version ====================
// @init laeuft bei jedem Transportstart erneut: Bedien- und Nutzerzustand nur beim ersten Lauf (km_ini1).
strcpy(#tt_ver, "v1.1.1");
uk_fsmax = 2;
tt_pb_init(KM_NFAC, 32, KM_BANK, KM_PSW);
km_facAll();      // Werks-Presets (generiert in 25_templates): Daten in M_FAC und Namen fuer die Preset-Leiste

// 0.8.0: Modellzeiger der beiden Threads (Konstanten; bei jedem @init neu, harmlos). MUSS vor dem Erst-Init stehen:
// km_snapNow backt dort schon in den Audio-Abzug (sonst schriebe ke_bake mit Zeiger 0 ueber M_SEG, im Interpreter gefunden).
ke_SEG = M_SEGA;  ke_ES = M_ESA;  ke_EE = M_EEA;  ke_CUM = M_CUMA;  ke_LIM = M_LIMA;  ke_PRV = M_PRVA;
ke_MOVE = M_MOVE;      // 0.8.0 Runde 2: MOVE-Faktoren je Lane (Front waehlt M_MOVE/M_MOVE1 in kv_useMain/kv_usePv)
kg_MOVE = M_MOVE;  kg_scream = 0;      // Runde 2 (Review): vorbesetzen, falls ein Eval vor dem ersten kv_useMain laeuft (sonst Zeiger 0)
kv_pvOn != 1 ? ( kg_SEG = M_SEG;  kg_ES = M_ES;  kg_EE = M_EE;  kg_CUM = M_CUM;  kg_LIM = M_LIM;  kg_PRV = M_PRV; );

km_ini1 != 1 ? (
  km_ini1 = 1;
  dragId = -1;  km_edge = -1;  km_ld = 0;
  km_cls = 0;  km_limInit();
  km_barBeats = 4;  km_bbPrev = 4;      // Historie: km_totBars = 32; (0.8.0: ke_tot/kg_tot vom Bake)
  km_intens = 1;  km_start = 1;  km_ch = 1;  km_rate = 1;  km_pass = 1;  km_follow = 1;  km_repeat = 0;  km_cc7 = 0;  km_smooth = 0;
  km_scream = 0;  km_ntOn = 0;  km_ntCh = 16;  km_ntBase = 36;        // 0.8.0 Runde 2 (Vorgaben = Slider-Vorgaben)
  km_nseg = 0;  km_loadTemplate(0, 0);
  km_k = 0;
  loop(KM_NL, M_OVR[km_k] = 0 - 1;  M_OUT[km_k] = 0 - 1;  M_NOW[km_k] = 0;  M_MOVE1[km_k] = 1;  km_k += 1; );
  memset(M_HELD, 0, 2048);
  km_lastPos = 0 - 1000000;  km_smok = 0;  km_prevPlay = 0;  km_clipOK = 0;  km_expPos = 0;
  km_sel = 0;  km_curSeg = 0;  km_uiPos = 0;  km_msgt = 0;
  km_view = 0;  kv_zoom = 1;  kv_b0 = 0;  kv_lane = 0;  kv_lmax = 0;  kv_pv = 0;  kv_pvBuilt = -1;  km_selQ = 0 - 1;  km_selReq = 0;  km_selSeen = 0;  km_quant = 1;
  km_ggen = 0;  km_ggP = 0;  km_gidle = 1000000000;  km_galive = 0;  km_torn = 0;  km_waits = 0;  km_takes = 0;
  km_clsReq = 0;  km_clsWant = 0;  km_tcPend = 0;  kv_padPg = 0;  kv_dskPg = 0;  kv_pgSel = 0 - 1;
  kv_selP = 0;  km_ldP = 0;  km_ldLy = 0;  kv_dcT = 0;  kv_dcI = 0 - 1;  kv_dcK = 0 - 1;  km_varOff = 0;      // 0.9.0
  kv_svcB = 0;  kv_svcL = 0;  kv_svcT = 0;  kv_svcR = 0;  km_impTot = 0;  km_impCookie = 0;  km_impInit = 0;  km_impSeen = 0;  km_impReq = 0;  km_impN = 0;  km_impMsg = 0;  km_rndAmt = 0.5;  km_rndScope = 0;
  km_ntCnt = 0;  km_ntLast = 0 - 1;        // 0.8.0 Runde 2: Zaehler/letzte Trigger-Note (Test-Schnittstelle gmem 6180/6181)
  km_snapNow();  km_dirty = 0;  kv_gdirty = 1;
  // Historie: km_dirty = 0;  km_bake();
);
tth_sync(slider11);
km_readSliders();

// ---------- Regler lesen ----------
@slider
km_readSliders();

// ---------- MIDI und CC-Ausgabe ----------
@block
// Aenderung aus der Front (tt_slset) uebernehmen
tt_sldirty ? ( tt_sldirty = 0;  km_readSliders(); );

// Test-Schnittstelle (nur mit Freigabe gmem[5189] = 20261001): Kommando in gmem[6000], Argumente 6001..6003, Ergebnisse ab 6100.
// Kommandos (a1, a2, a3 = gmem[6001..6003]):  1 Werks-Preset a1 laden | 2 Override Lane a1 = a2 (-1 aus) | 3 Gesamtlaenge a1 |
//   4 Rohfeld: Segment a1, Feld a2 = a3 | 5 PANIC | 6 Auswahl a1 | 7 Segment a1 spalten | 8 Segment a1 loeschen | 9 Segment hinter a1 einfuegen |
//   10 Typ von Segment a1 = a2 | 11 Kante hinter Segment a1 auf Takt a2 | 12 BUILD-UP an Segment a1 umschalten | 13 FILL hinter Segment a1 umschalten |
//   14 Segment a1 kopieren | 15 in Segment a1 einfuegen | 16 Segmentdaten nach gmem[8000..] spiegeln | 20 Anwender-Preset a1 speichern |
//   21 Anwender-Preset a1 laden | 22 Klasse a1 anwenden | 23 Laenge von Segment a1 = a2 | 24 Abschnittswahl a1 vormerken (wie ein Pad, QUANTIZE)
//   25 QUANTIZE a1 (1 naechster Takt, 0 sofort) | 27 Preset-Varianten aus/an (a1 = 1 aus; 0.9.0) | 26 Abzug-Spiegel: Audio-Abzug (M_SEGA, ke_nseg) nach gmem[8000..] statt des Modells
//   Ausfuehrung (0.8.0): 16/26 im Block; alle anderen bei offenem Fenster durch die Front am Anfang ihres naechsten Frames (km_tcPoll), sonst im Block.
// Front-Testhaken (im @gfx, vor tth_pre; nur mit Freigabe, Fenster offen): gmem[7400] = 1 -> Maus aus gmem[7401]/[7402] (Designraster 900 x 910; Historie: 900 x 700),
//   mouse_cap aus [7403], Rad aus [7404] (danach 0); Taste: gmem[7405] = Code (z. B. 'left'), [7406] = Modifikator-Bits wie mouse_cap (danach 0).
//   Die Front meldet in gmem[7420..]: 7420 Ansicht, 7421 Zoom, 7422 erster sichtbarer Takt, 7423 Fokus-Lane, 7424 Vorschau (0 aus, n+1),
//   7425 Frames, 7426 Ziehzustand (km_ld), 7427 Auswahl, 7428 vorgemerkte Auswahl (km_selQ), 7429 sichtbare Takte, 7430 MAX, 7431 PREVIEW-Liste offen, 7432 gewaehlter LFO-Knoten (0.9.6)
// Ergebnisse: 6100 nseg, 6101 Gesamttakte (gebacken), 6102 aktuelles Segment, 6103 Klasse, 6104 Position (Beats), 6105 km_seq, 6106 Auswahl, 6107 CCs im Block,
//   6110+k NOW, 6120+k zuletzt gesendet, 6130+k Override, 6140 Summe der Daten, 6141 belegte Anwender-Slots, 6142 Stern, 6143/6144 aktuelles Preset,
//   6150..6152 Zeichenzeit (Mittel, Spitze, Frames), 6160 Abzug-Uebernahmen, 6161 verworfene (gerissene) Kopien, 6162 Warten auf die Front,
//   6163 ke_nseg, 6164 Summe des Audio-Abzugs (wie 6140 ueber M_SEGA)
//   6170+k MOVE-Faktor je Lane (0..2), 6176 km_scream, 6177 km_ntOn, 6178 km_ntCh, 6179 km_ntBase, 6180 km_ntCnt (gezaehlte
//   Trigger-Noten), 6181 km_ntLast
// 0.8.0 (Codex-Review 0.8.0, Befund 1): Lebt die Front? km_ggen aendert sich je Frame; 0,25 s ohne Aenderung = Fenster zu oder Front steht.
km_ggen != km_ggP ? ( km_ggP = km_ggen;  km_gidle = 0; ) : ( km_gidle += samplesblock; );
km_galive = km_gidle < srate*0.25;
tt_testok() ? (
  bk_cmd = gmem[6000];
  bk_cmd != 0 ? (
    gmem[6000] = 0;
    bk_a1 = gmem[6001];  bk_a2 = gmem[6002];  bk_a3 = gmem[6003];
    bk_cmd == 16 ? ( bk_i = 0;  loop(km_nseg*KM_SS, gmem[8000 + bk_i] = M_SEG[bk_i];  bk_i += 1; ); )   // Daten nach gmem[8000..] spiegeln
    : bk_cmd == 26 ? ( bk_i = 0;  loop(ke_nseg*KM_SS, gmem[8000 + bk_i] = M_SEGA[bk_i];  bk_i += 1; ); )  // Audio-Abzug spiegeln
    : km_galive ? ( km_tcA1 = bk_a1;  km_tcA2 = bk_a2;  km_tcA3 = bk_a3;  km_tcPend = bk_cmd; )   // die Front fuehrt es aus (ein Schreiber)
    : km_testExec(bk_cmd, bk_a1, bk_a2, bk_a3);
    // Historie: die Kommandos 1..25 liefen bis 0.8.0 (Entwurf) immer hier im Block (bk_cmd == 1 ? ( km_pbFactory(bk_a1); ) : ...)
  );
);
// Klassenwechsel aus @slider/Automation: ohne laufende Front fuehrt ihn der Block aus
!km_galive ? ( km_clsPoll();  km_tcPoll(); );

isPlay = play_state & 1;
km_barBeats = (ts_num > 0 && ts_denom > 0) ? ts_num*4/ts_denom : 4;
km_barBeats != km_bbPrev ? ( km_bbPrev = km_barBeats;  km_dirty = 1; );
// 0.8.0 (Codex-Befund 2): Daten der Front nur atomar uebernehmen (Seqlock). Die Front zaehlt km_ggen am Anfang und am Ende jedes
// @gfx-Durchlaufs hoch (ungerade = sie laeuft gerade). Kopiert wird nur bei geradem Zaehler, und nur wenn er sich waehrend des Kopierens
// nicht geaendert hat; sonst bleibt der alte Abzug und der naechste Block versucht es erneut (km_dirty bleibt 1).
// Historie: km_dirty ? ( km_dirty = 0;  km_bake(); );
km_dirty ? (
  bk_g1 = km_ggen;
  (bk_g1 & 1) == 0 ? (
    km_dirty = 0;
    bk_n = max(1, min(KM_MAXSEG, floor(km_nseg)));
    bk_c = km_cls;
    memcpy(M_STG, M_SEG, bk_n*KM_SS);
    memcpy(M_STGL, M_LIM, 12);
    // Codex-Review 0.8.0 (2): nach der Uebernahme neu senden (im Stillstand hatte km_force den alten Abzug schon verbraucht)
    km_ggen == bk_g1 ? ( km_take(bk_n, bk_c);  km_takes += 1;  km_force = 1; ) : ( km_dirty = 1;  km_torn += 1; );
  ) : ( km_waits += 1; );
);
ke_intens = km_intens;  ke_repeat = km_repeat;  ke_scream = km_scream;   // 0.8.0 Runde 2: SCREAM wie ke_intens je Block an die Auswertung
km_startBeat = (km_start - 1)*km_barBeats;
bpos = beat_position;
km_tempo = max(20, tempo);      // 0.9.6: fuer LFO-Raten in Hz (Block und Front rechnen damit)
blen = max(0.000001, samplesblock*tempo/(60*srate));
km_nq = 0;  km_qi = 0;  km_qtotal = 0;
bk_notePend = 0 - 1;
bk_hasMidi = midirecv(bk_offs, bk_m1, bk_m2, bk_m3);

// Neu gelesener Zustand (Projekt laden, Strg+Z): alle Lanes neu senden
km_serRead ? ( km_serRead = 0;  bk_k = 0;  loop(KM_NL, M_OUT[bk_k] = 0 - 1;  bk_k += 1; ); );

// PANIC: All Notes Off (CC 123) auf allen 16 Kanaelen, gemerkte Noten vergessen, Lanes neu senden
km_panic ? (
  km_panic = 0;
  bk_c = 0;  loop(16, km_qpush(0, 176 + bk_c, 123, 0);  bk_c += 1; );
  memset(M_HELD, 0, 2048);
  bk_k = 0;  loop(KM_NL, M_OUT[bk_k] = 0 - 1;  bk_k += 1; );
  km_force = 1;
);

// Wiedergabestart: alle Lanes neu senden, Glaettung neu ansetzen
isPlay && !km_prevPlay ? (
  bk_k = 0;  loop(KM_NL, M_OUT[bk_k] = 0 - 1;  bk_k += 1; );
  km_smok = 0;  km_expPos = bpos;
  // Codex-Review (4): Startwerte sofort am Blockanfang senden (nicht erst am naechsten Rasterpunkt, waehrend schon Noten laufen);
  // liegt ein Rasterpunkt genau hier, sendet er nichts mehr (nur bei Aenderung)
  km_emit(0, bpos, 0);
);
// Review R003 (19.10.2026): beim Stopp einmal neu auswerten, auch wenn der Cursor auf eine schon ausgewertete Position zurueckspringt
bk_stop = km_prevPlay && !isPlay;
km_prevPlay = isPlay;

// 0.8.0 (PADS/DESK): vorgemerkte Abschnittswahl. Die Front meldet eine Wahl ueber km_selReq/km_selReqN; mit QUANTIZE wird sie am naechsten
// Takt der Projektzeit (ab START BAR) wirksam, beim Stillstand oder ohne QUANTIZE sofort. Wirkt hoerbar nur bei FOLLOW SONG aus (Schleife).
km_selReqN != km_selSeen ? (
  km_selSeen = km_selReqN;
  (km_quant && isPlay) ? (
    km_selQ = max(0, min(ke_nseg - 1, floor(km_selReq)));
    km_selQB = km_startBeat + ceil((bpos - km_startBeat)/km_barBeats - 0.0000001)*km_barBeats;
  ) : ( km_sel = max(0, min(km_nseg - 1, floor(km_selReq)));  km_selQ = 0 - 1;  km_force = 1; );
);
(km_selQ >= 0 && !isPlay) ? ( km_sel = km_selQ;  km_selQ = 0 - 1;  km_force = 1; );

isPlay ? (
  // Sprung (Cursor, Loop): Glaettung neu ansetzen, sonst glitte der Wert ueber den Sprung
  // Codex-Review 0.8.0 (6): nach einem Sprung (Loop) den Takttermin einer vorgemerkten Wahl neu setzen, sonst wuerde er nie erreicht
  abs(bpos - km_expPos) > 0.02 ? ( km_smok = 0;  km_selQ >= 0 ? ( km_selQB = km_startBeat + ceil((bpos - km_startBeat)/km_barBeats - 0.0000001)*km_barBeats; ); );
  km_expPos = bpos + blen;
  bk_g = km_gridBeats();
  bk_n = ceil((bpos - km_startBeat)/bk_g - 0.0000001);
  bk_tb = km_startBeat + bk_n*bk_g;
  bk_end = bpos + blen;
  while (bk_tb < bk_end - 0.0000001) (
    bk_off = floor((bk_tb - bpos)/blen*samplesblock);
    bk_off = max(0, min(samplesblock - 1, bk_off));
    km_midiUntil(bk_off);
    km_selTick(bk_tb);   // vorgemerkte Wahl am Takt (Funktion: ?: im while-Body nur als letztes Statement)
    km_emit(bk_off, bk_tb, bk_g*4);
    km_qflush(bk_off);
    bk_n += 1;
    bk_tb = km_startBeat + bk_n*bk_g;
  );
  km_force = 0;
) : (
  // Stillstand: Position des Cursors einmal auswerten, wenn sie sich oder die Daten geaendert haben
  (bpos != km_lastPos || km_force || bk_stop) ? ( km_emit(0, bpos, 0);  km_lastPos = bpos;  km_force = 0; );
);

km_midiUntil(samplesblock + 1000000);
km_qflush(samplesblock + 1000000);
bk_notePend >= 0 ? km_noteSel(bk_notePend, bk_noteOff);

// Messwerte fuer Testskripte (nur mit Freigabe)
tt_testok() ? (
  gmem[6100] = km_nseg;  gmem[6101] = ke_tot;  gmem[6102] = km_curSeg;  gmem[6103] = km_cls;
  gmem[6104] = km_uiPos;  gmem[6105] = ke_bseq;  gmem[6106] = km_sel;  gmem[6107] = km_qtotal;
  // Historie: gmem[6101] = km_totBars;  gmem[6105] = km_seq;
  gmem[6160] = km_takes;  gmem[6161] = km_torn;  gmem[6162] = km_waits;  gmem[6163] = ke_nseg;
  bk_s = 0;  bk_i = 0;  loop(ke_nseg, bk_p = M_SEGA + bk_i*KM_SS;  bk_s += bk_p[KF_LEN];  bk_i += 1; );  gmem[6164] = bk_s;
  bk_k = 0;
  loop(KM_NL, gmem[6110 + bk_k] = M_NOW[bk_k];  gmem[6120 + bk_k] = M_OUT[bk_k];  gmem[6130 + bk_k] = M_OVR[bk_k];  gmem[6170 + bk_k] = M_MOVE[bk_k];  bk_k += 1; );
  gmem[6176] = km_scream;  gmem[6177] = km_ntOn;  gmem[6178] = km_ntCh;  gmem[6179] = km_ntBase;
  gmem[6180] = km_ntCnt;   gmem[6181] = km_ntLast;
  gmem[6140] = km_total();  gmem[6141] = tt_pb_count();  gmem[6142] = tt_pb_mod;  gmem[6143] = tt_pb_cur;  gmem[6144] = tt_pb_curKind;
);

// ---------- Zustand im Projekt ----------
@serialize
km_ser();
tt_pb_serialize();
// ---------- Geraetefront (All-in-One seit 0.8.0: fuenf Reiter RACK+ / MAP / DESK / PADS / TRACKER) ----------
// Raster 990 x 910 (bei 125 % UI-Groesse 1238 x 1138; Historie: 900 x 910 bis 22.10.2026 mittags, davor 900 x 700). Alle Regler des Plugins sind versteckt; bedient wird nur hier.
@gfx 1238 1138
km_ggen += 1;      // 0.8.0 Seqlock (Codex-Befund 2): ungerade = die Front laeuft, der Block uebernimmt dann keine Daten (50_block)
kv_tf0 = time_precise();
// Front-Testhaken (nur mit Freigabe): Maus spielen, VOR tth_pre, damit Theme- und Preset-Modul sie als rohe Maus sehen (Muster der Suite)
kv_inj = tt_testok() && gmem[7400] == 1;
kv_inj ? (
  tth_view(990, 910);
  mouse_x = OX + gmem[7401]*SC;  mouse_y = OY + gmem[7402]*SC;
  mouse_cap = gmem[7403];
  mouse_wheel = gmem[7404];  gmem[7404] = 0;
);
tth_pre(); tt_pb_pre(); tth_sync(slider11);
uikit_begin(990, 910);
uk_flat = 1;      // 0.9.5: Flat-Stil des UI-Kits 8 (Weiche): btn, toggle, combo, tabbar, padbtn, knob2st, hsliderst zeichnen flach
uikit_ground2();

// ---------- Zustand fuer diesen Frame ----------
// Codex-Review 0.8.0 (1): die Front ist bei offenem Fenster der einzige Schreiber: angeforderte Klassenwechsel und Test-Kommandos hier ausfuehren
km_clsPoll();
km_tcPoll();
km_sel = max(0, min(km_sel, km_nseg - 1));
// Review R004 (19.10.2026): jede Aenderung der Abschnittswahl (Karte, Tasten, TRACKER, Pads) bei FOLLOW SONG aus neu ausgeben (km_force), auch im Stillstand
km_sel != kv_selP ? ( kv_selP = km_sel;  !km_follow ? ( km_force = 1; ); );
// 0.8.0: die Front backt ihr eigenes Modell (kg_bake), sobald sich die Daten geaendert haben (km_commit setzt kv_gdirty).
// Historie: Rueckfall-Bake nach 15 Frames, falls der Audio-Thread nicht lief (km_dirty ? ( kv_dw += 1; ... km_bake(); ); bis 0.3.0)
kv_gdirty ? ( kv_gdirty = 0;  kv_bakeMain(); );
// Historie: Takt-Summen M_UIC je Frame aus M_SEG (bis 0.3.0), jetzt kg_CUM aus dem Bake
kv_sg = M_SEG + km_sel*KM_SS;
kv_ty = kv_sg[KF_TYPE];
kv_es = M_ES + km_sel*8;  kv_ee = M_EE + km_sel*8;
km_msgt > 0 ? ( km_msgt -= 1; );
// 0.9.0: Import aus Regionen/Markern fertig (Meldung nur in der Front) bzw. Antwort des Dienst-Skripts
km_impMsg > 0 ? ( km_impMsg == 1 ? sprintf(#km_m, "IMPORTED 1 SECTION (%d BARS)", km_impTot) : sprintf(#km_m, "IMPORTED %d SECTIONS (%d BARS)", km_impMsg, km_impTot);  km_msgt = 150;  km_impMsg = 0; );
kv_svcB = gmem[KM_SVCB + 2];
kv_svcB != kv_svcL ? ( kv_svcL = kv_svcB;  kv_svcT = 90; ) : ( kv_svcT > 0 ? ( kv_svcT -= 1; ); );
gmem[KM_SVCB + 4] != kv_svcR ? (
  kv_svcR = gmem[KM_SVCB + 4];
  gmem[KM_SVCB + 3] == 1 ? ( strcpy(#km_m, "NO REGIONS OR MARKERS IN THE PROJECT");  km_msgt = 120; )
  : gmem[KM_SVCB + 3] == 2 ? ( strcpy(#km_m, "IMPORT: INSTANCE NOT FOUND");  km_msgt = 120; );
);
km_view = max(0, min(4, floor(slider12)));
// Preset-Vorschau (nur in den Karten-Ansichten RACK+ und MAP)
kv_pvOn = kv_pv > 0 && km_view <= 1;
(kv_pvOn && kv_pvBuilt != kv_pv) ? ( kv_pvBuild(kv_pv - 1);  kv_pvBuilt = kv_pv; );
kv_pvOn ? ( kv_usePv();  kv_tot = kv_pvTot; ) : ( kv_useMain();  kv_tot = kv_mTot; );
kv_view();
// Kurvenkarte nur neu rechnen, wenn sich Modell, Ausschnitt oder Vorschau geaendert haben
(km_view <= 1 && (kg_bseq != kv_pk1 || kv_b0 != kv_pk2 || kv_vis != kv_pk3 || kv_pvOn*1000 + kv_pv != kv_pk4 || km_barBeats != kv_pk5 || km_tempo != kv_pk6)) ? (
  kv_pk1 = kg_bseq;  kv_pk2 = kv_b0;  kv_pk3 = kv_vis;  kv_pk4 = kv_pvOn*1000 + kv_pv;  kv_pk5 = km_barBeats;  kv_pk6 = km_tempo;
  kv_plotFill(kv_b0, kv_vis);
);

// ---------- Kopfzeile: Wortmarke, Untertitel + Version, Reiter, PANIC ----------
gfx_setfont(1);
kv_f = uk_fit(1, "TT-KNOBMOVER", 290*SC, 34*SC);
colWhite(0.96);  uk_txtf(1);  xat(14, 4);  gfx_drawstr("TT-");
colAcid(1);      uk_txtf(1);  gfx_drawstr("KNOBMOVER");
gfx_setfont(5);
colDim(1);
xstr(16, 36, "MIDI CC RIDE FOR THE TT-303");
gfx_measurestr("MIDI CC RIDE FOR THE TT-303", kv_w1, kv_h1);
tt_vertag(16 + kv_w1/SC + 8, 36);
screw(8, 8);  screw(982, 8);  screw(8, 902);  screw(982, 902);

// 0.8.0: Reiter der Ansichten (K1/K6 RACK+, K2 MAP, K3 DESK, K4 PADS, K5 TRACKER); die Wahl steht im versteckten slider12
kv_nv = tabbar(312, 8, 300, 20, km_view, 5, "RACK+|MAP|DESK|PADS|TRACKER", "Views of the same arrangement.");
kv_nv != km_view ? ( tt_slset(12, kv_nv);  km_view = kv_nv; );
tt_hov(312, 8, 58, 20, "RACK+: ride map, section knobs with FROM / TO, movement and section tools.");
tt_hov(372, 8, 58, 20, "MAP: the whole arrangement as a large map with all six lanes (incl. volume), zoom and preset preview.");
tt_hov(432, 8, 58, 20, "DESK: one channel strip per knob with the FROM / TO range of the selected section, live value and CC meter; scene pads.");
tt_hov(492, 8, 58, 20, "PADS: sections as big pads (quantized to the next bar) and an XY field to ride cutoff and resonance by hand.");
tt_hov(552, 8, 58, 20, "TRACKER: every section as a row of numbers (FROM / TO per knob, swing, period, ride); drag, wheel or keys to edit.");

gfx_setfont(5);
// 0.9.0: REGIONS - Projekt-Regionen/-Marker als Abschnitte (braucht das Dienst-Skript, sonst die Action "Import Regions")
btn(828, 28, 78, 17, 0, "REGIONS") ? (
  kv_svcT > 0 ? (
    km_impCookie = floor(rand(1)*15000000) + 1;
    tt_slset(23, km_impCookie);
    gmem[KM_SVCB + 1] = km_impCookie;
    gmem[KM_SVCB] = gmem[KM_SVCB] + 1;
    km_msgt = 60;  strcpy(#km_m, "READING THE PROJECT REGIONS...");
  ) : ( km_msgt = 150;  strcpy(#km_m, "RUN ACTION: KNOBMOVER IMPORT"); );
);
tt_hov(828, 28, 78, 17, "Imports the project's regions (or, if there are none, its markers) as the sections of this arrangement: length in whole bars, type guessed from the name, START BAR = first region. A JSFX cannot read project markers itself, so this needs the helper script: run the action 'TT-KNOBMOVER: import service' once per session, or run 'TT-KNOBMOVER: import regions (or markers) as sections' from the Action list (no button needed). Ctrl+Z undoes it.");
btn(912, 28, 70, 17, 0, "PANIC") ? ( km_panic = 1;  km_msgt = 60;  strcpy(#km_m, "PANIC: ALL NOTES OFF SENT"); );
tt_hov(912, 28, 70, 17, "Sends All Notes Off (CC 123) on all 16 channels, forgets held notes and re-sends every CC lane.");

// ---------- Obere Zeile: Klasse, Laenge, Folgen, Wiederholen, Start, Anzeige ----------
slider1 < 0.5 ? strcpy(#cmb_txt, "CLASS: DRIVER") : slider1 < 1.5 ? strcpy(#cmb_txt, "CLASS: MELODIC")
  : slider1 < 2.5 ? strcpy(#cmb_txt, "CLASS: SCREAM") : strcpy(#cmb_txt, "CLASS: LOW");
kv_nv = combo(50, 16, 60, 160, 26, floor(slider1), 4);
// Codex-Review 0.8.0 (1)/(3): Klasse gleich hier anwenden (die Front ist der Schreiber) und sofort neu backen, bevor die Reiter Werte lesen;
// der Block sieht danach slider1 == km_cls und fordert nichts an.
kv_nv != floor(slider1) ? ( km_applyClass(kv_nv);  km_clsReq = 0;  tt_slset(1, kv_nv);  kv_bakeMain();  kv_pvOn ? kv_usePv(); );
tt_hov(16, 60, 160, 26, "Sound class: sets the limits of every knob (DRIVER, MELODIC, SCREAM, LOW). Sections you have not edited follow the class table.");

kv_tt = km_total();
// Liste 8 16 24 32 48 64 96 128 192 256; steht die Laenge zwischen zwei Eintraegen, zeigt das Feld den naechsthoeheren (Pfeil links = naechstkleinerer); Codex-Review (10)
kv_li = kv_tt <= 8 ? 0 : kv_tt <= 16 ? 1 : kv_tt <= 24 ? 2 : kv_tt <= 32 ? 3 : kv_tt <= 48 ? 4 : kv_tt <= 64 ? 5 : kv_tt <= 96 ? 6 : kv_tt <= 128 ? 7 : kv_tt <= 192 ? 8 : 9;
sprintf(#cmb_txt, "LEN %d BARS", kv_tt);
kv_nv = combo(51, 182, 60, 150, 26, kv_li, 10);
kv_nv != kv_li ? ( km_setTotal(kv_nv == 0 ? 8 : kv_nv == 1 ? 16 : kv_nv == 2 ? 24 : kv_nv == 3 ? 32 : kv_nv == 4 ? 48 : kv_nv == 5 ? 64 : kv_nv == 6 ? 96 : kv_nv == 7 ? 128 : kv_nv == 8 ? 192 : 256);  tt_undo(); );
tt_hov(182, 60, 150, 26, "Total length of the arrangement in bars (8 to 256). The last section grows or shrinks.");

gfx_setfont(5);
toggle(338, 60, 120, 26, km_follow, "FOLLOW SONG") ? ( tt_slset(2, km_follow ? 0 : 1); );
tt_hov(338, 60, 120, 26, "On: the arrangement follows the project timeline from START BAR. Off: the selected section loops, handy for setting up, auditioning and for the PADS / DESK scenes.");
toggle(464, 60, 90, 26, km_repeat, "REPEAT") ? ( tt_slset(3, km_repeat ? 0 : 1); );
tt_hov(464, 60, 90, 26, "On: the arrangement starts over after its last bar. Off: the last values are held.");

colDim(1);  xstr(562, 68, "START");
panelBox(598, 62, 42, 22);
sprintf(#kv_s, "%03d", km_start);
gfx_setfont(4);  colAcid(1);  xctr(598, 62, 42, 22, #kv_s);
gfx_setfont(5);
btn(644, 62, 20, 22, 0, "-") ? ( tt_slset(4, max(1, km_start - 1)); );
btn(666, 62, 20, 22, 0, "+") ? ( tt_slset(4, min(999, km_start + 1)); );
inBox(598, 62, 42, 22) && mouse_wheel != 0 ? ( tt_slset(4, min(999, max(1, km_start + (mouse_wheel > 0 ? 1 : 0 - 1))));  mouse_wheel = 0; );
tt_hov(562, 62, 78, 22, "Project bar where the arrangement begins (1 = project start). Wheel = +/-1.");
tt_hov(644, 62, 20, 22, "Start one bar earlier.");
tt_hov(666, 62, 20, 22, "Start one bar later.");

gfx_set(0.02, 0.03, 0.02, 1);  xrect(696, 60, 278, 26);
colBorder();  xrect(696, 60, 278, 1);  xrect(696, 85, 278, 1);  xrect(696, 60, 1, 26);  xrect(973, 60, 1, 26);
gfx_setfont(4);
km_msgt > 0 ? (
  colWhite(1);  xstrfit(706, 60, 262, 26, #km_m);
) : kv_pvOn ? (
  gfx_set(1, 0.72, 0.18, 1);  xstr(706, 66, "PREVIEW ONLY - NOT SENT");
) : (
  kv_bb = max(0, km_uiPos)/km_barBeats;
  sprintf(#kv_s, "BAR %d.%d / %d", floor(kv_bb) + 1, floor((kv_bb - floor(kv_bb))*km_barBeats) + 1, kv_mTot);
  colInk(1);  xstr(706, 66, #kv_s);
  kv_p = M_SEG + max(0, min(km_nseg - 1, km_curSeg))*KM_SS;
  kv_tname(kv_p[KF_TYPE]);
  gfx_measurestr(#kv_tn, kv_w1, kv_h1);
  colAcid(1);  xstr(964 - kv_w1/SC, 66, #kv_tn);
);
tt_hov(696, 60, 278, 26, "Position of the play cursor inside the arrangement (bar.beat / total bars) and the section it is in.");
// ==== Reiter 0 (61_view_rack.jsfx), vom Generator gefasst ====
km_view == 0 ? (
// ---------- Reiter RACK+ (K6, enthaelt K1): Kurvenkarte, Regler des Abschnitts, MOVEMENT, SECTION TOOLS ----------
// Vom Generator in "km_view == 0 ? ( ... );" gefasst.
panel2(16, 96, 958, 436, "RIDE MAP");
kv_mapBar(99);
kv_mapUI(104, 858, 142, 168, 71, 67, 5, 523);   // 0.9.0 (22.10.): zweite Kopfzeile (RANDOM): Band und Lanes tiefer, Lanes etwas niedriger (Historie: 120, 150, 33, 29, 5, 314)
// Historie: Kurvenkarte, Abschnittsband und Griff-Bedienung standen bis 0.3.0 hier im @gfx (jetzt kv_mapUI, mit Zoom und Vorschau);
// Titel war "RIDE MAP - CLICK A SECTION, DRAG ITS EDGES" (der Platz rechts gehoert jetzt Vorschau und Zoom, der Hinweis steht im Tooltip).

// ---------- Regler des gewaehlten Abschnitts ----------
kv_tname(kv_ty);
sprintf(#kv_t, "SECTION %s - LIVE / FROM / TO", #kv_tn);
panel2(16, 542, 690, 214, #kv_t);
kv_k = 0;
loop(5,
  kv_cx = 86 + kv_k*136;
  kv_lo = M_LIM[kv_k*2];  kv_hi = M_LIM[kv_k*2 + 1];
  // 0.9.0 (22.10.): die Klassengrenzen klemmen nur unbearbeitete Abschnitte; Regler und Eingaben duerfen die ganze Lane 0..100 nutzen
  kv_lo2 = kv_sg[KF_ED] > 0.5 ? 0 : kv_lo;  kv_hi2 = kv_sg[KF_ED] > 0.5 ? 100 : kv_hi;
  // Anzeigewerte: gespeichert (unabhaengig vom Bake), bei FILL (relativ) die gebackenen
  kv_sv = kv_sg[KF_REL] > 0.5 ? kv_es[kv_k] : min(kv_hi2, max(kv_lo2, kv_sg[KF_S + kv_k]));
  kv_ev = kv_sg[KF_REL] > 0.5 ? kv_ee[kv_k] : min(kv_hi2, max(kv_lo2, kv_sg[KF_E + kv_k]));
  kv_live = M_OVR[kv_k] >= 0 ? M_OVR[kv_k] : M_NOW[kv_k];
  // Live-Regler: ziehen = Override, Rechtsklick / Doppelklick / Strg+Klick = Override aus
  kv_nv = knob2st(1 + kv_k, kv_cx, 610, 30, kv_live, 0, 100, 0 - 1, 0);   // st = 0: der Reset (-1) kommt unverrundet zurueck
  kv_nv != kv_live ? (
    kv_nv < 0 ? ( M_OVR[kv_k] = 0 - 1; ) : ( M_OVR[kv_k] = min(100, max(0, kv_nv)); );
    km_force = 1;
  );
  kv_knobExtras(kv_cx, 610, 30, kv_k, kv_sv, kv_ev);
  kv_lname(kv_k);
  gfx_setfont(5);
  M_OVR[kv_k] >= 0 ? colWhite(1) : colInk(0.9);
  xctr(kv_cx - 50, 646, 100, 12, #kv_ln);
  M_OVR[kv_k] >= 0 ? sprintf(#kv_s, "%d %% OVR", floor(kv_live + 0.5)) : sprintf(#kv_s, "%d %%", floor(kv_live + 0.5));
  colAcid(1);  xctr(kv_cx - 50, 659, 100, 12, #kv_s);
  tt_hov(kv_cx - 40, 570, 80, 82, "Live value being sent. Drag = hold your own value (OVR), right-click, double-click or Ctrl+click = back to the ride. Green arc = sweet spot, white ticks = class limits (a guide only, the knob can go anywhere 0-100), ring dots = the lowest (hollow) and highest (solid) value this section reaches, ramp plus swing, and the bright arc between them.");

  // START / END
  kv_df = 0;  kv_de = 0;
  kv_ty != 4 ? ( kv_t2 = M_TAB + (km_cls*8 + kv_ty)*16;  kv_si = kv_k == 0 ? 0 : kv_k == 1 ? 4 : kv_k == 2 ? 6 : kv_k == 3 ? 8 : 10;
                 kv_df = kv_t2[kv_si];  kv_de = kv_t2[kv_si + 1]; ) : ( kv_df = kv_sv;  kv_de = kv_ev; );
  gfx_setfont(5);
  colDim(1);  xstr(kv_cx - 52, 676, "FROM");
  kv_n0 = hsliderst(11 + kv_k, kv_cx - 16, 674, 52, 12, kv_sv, 0, 100, min(kv_hi, max(kv_lo, kv_df)), 1);
  kv_n0 != kv_sv ? ( km_unrel(km_sel);  kv_sg[KF_S + kv_k] = kv_n0;  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  colAcid(1);  sprintf(#kv_s, "%d", floor(kv_n0 + 0.5));  xstr(kv_cx + 44, 676, #kv_s);
  colDim(1);  xstr(kv_cx - 52, 698, "TO");
  kv_n1 = hsliderst(21 + kv_k, kv_cx - 16, 696, 52, 12, kv_ev, 0, 100, min(kv_hi, max(kv_lo, kv_de)), 1);
  kv_n1 != kv_ev ? ( km_unrel(km_sel);  kv_sg[KF_E + kv_k] = kv_n1;  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  colAcid(1);  sprintf(#kv_s, "%d", floor(kv_n1 + 0.5));  xstr(kv_cx + 44, 698, #kv_s);
  tt_hov(kv_cx - 54, 670, 112, 20, "Value the ramp of this knob starts the section with (any value 0-100; the thin ticks are only the class limits). The swing rides on top, so the knob can go beyond; the ring dots show the real lowest and highest value. Double-click = class table value.");
  tt_hov(kv_cx - 54, 692, 112, 20, "Value the ramp of this knob reaches at the end of the section (the swing rides on top; see the ring dots for the real extremes). A FILL section starts at the end of the previous one until you touch it.");

  // ON
  gfx_setfont(5);
  toggle(kv_cx - 30, 722, 60, 20, kv_sg[KF_ON + kv_k] > 0.5, "ON") ? (
    kv_on = kv_sg[KF_ON + kv_k] > 0.5 ? 0 : 1;
    (mouse_cap & 8) ? (
      kv_j = 0;
      loop(km_nseg, kv_p = M_SEG + kv_j*KM_SS;  kv_p[KF_ON + kv_k] = kv_on;  kv_p[KF_ED] = 1;  kv_j += 1; );
    ) : (
      kv_sg[KF_ON + kv_k] = kv_on;  kv_sg[KF_ED] = 1;
    );
    km_commit();  tt_undo();
  );
  tt_hov(kv_cx - 30, 722, 60, 20, "Sends this CC lane while this section plays. Off: the lane stays silent here (the synth keeps its last value). Shift+click = all sections.");
  kv_k += 1;
);

// ---------- MOVEMENT: LFO der Fokus-Lane (0.9.6) ----------
// Gilt fuer die Lane, die in der Karte den hellen Rahmen traegt (anklicken, [ und ]). Jede Lane (Cutoff bis Accent) hat einen eigenen LFO mit Tiefe (AMP), Rate
// (SYNC in 16tel-Steps oder HZ) und Form; Start, Ende und jeder eigene Punkt der Lane tragen ihre eigene Tiefe und Rate (NODE), dazwischen laufen beide gleitend.
// Historie: bis 0.9.5 stand hier SWING / PERIOD / RIDE nur fuer den Cutoff (Regler 31..33), die anderen Lanes wackelten fest (RIDE steht weiter im DESK, PADS und TRACKER).
kv_tcode(kv_ty);
kv_ml = min(5, kv_lane);
kv_lshort(kv_ml);
sprintf(#kv_t, "MOVEMENT - %s - %s", #kv_ls, #kv_tc);
panel2(718, 542, 256, 214, #kv_t);
kv_t2 = M_TAB + (km_cls*8 + (kv_ty == 4 ? 1 : kv_ty))*16;
(km_sel*8 + kv_ml) != kv_ndKey ? ( kv_nd = 0;  kv_ndKey = km_sel*8 + kv_ml; );
kv_np = kv_sg[KF_NP + kv_ml];
(kv_nd > 0 && kv_nd < 100 && kv_nd > kv_np) ? ( kv_nd = 0; );
kv_ml < 5 ? (
  kv_md = kg_lMd(kv_sg, kv_ml);
  kv_lfoDraw(730, 570, 232, 50, kv_ml);
  tt_hov(730, 570, 232, 50, "The LFO of this lane over the whole section. Orange marks = the nodes (start, own points, end) with their depth; click one to choose it. The curve is scaled to the deepest node.");
  kv_ndGet(kv_sg, kv_ml, kv_nd);
  // AMP (Tiefe in Prozent des Reglerbereichs)
  kv_nv = knob2st(31, 758, 650, 15, kv_la, 0, 72, kv_ml == 0 ? (kv_ty == 4 ? 0 : kv_t2[2]) : M_WOA[kv_ml], 0.5);
  kv_nv != kv_la ? ( kv_ndPut(kv_sg, kv_ml, kv_nd, 0, kv_nv, kv_lnk);  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  // RATE: SYNC = Periode in 16tel-Steps (1 bis 64), HZ = Zyklen je Sekunde (0,05 bis 20, logarithmisch)
  kv_dflr = kv_md > 0.5 ? 1 : (kv_ml == 0 ? (kv_ty == 4 ? 1 : kv_t2[3]) : M_WOP[kv_ml]);
  kv_md > 0.5 ? (
    kv_u = log(max(0.05, kv_lr)/0.05)/log(400);
    kv_nv = knob2st(32, 822, 650, 15, kv_u, 0, 1, log(kv_dflr/0.05)/log(400), 0);
    kv_nv != kv_u ? ( kv_ndPut(kv_sg, kv_ml, kv_nd, 1, floor(0.05*exp(kv_nv*log(400))*100 + 0.5)/100, kv_lnk);  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  ) : (
    kv_nv = knob2st(32, 822, 650, 15, kv_lr, 1, 64, kv_dflr, 1);
    kv_nv != kv_lr ? ( kv_ndPut(kv_sg, kv_ml, kv_nd, 1, kv_nv, kv_lnk);  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  );
  gfx_setfont(5);
  colInk(0.9);
  xctr(728, 668, 60, 12, "AMP");  xctr(792, 668, 60, 12, "RATE");
  colAcid(1);
  sprintf(#kv_s, "%.1f", kv_la);  xctr(728, 680, 60, 12, #kv_s);
  kv_md > 0.5 ? sprintf(#kv_s, "%.2f HZ", kv_lr) : sprintf(#kv_s, "%d ST", floor(kv_lr + 0.5));
  xctr(792, 680, 60, 12, #kv_s);
  tt_hov(736, 632, 44, 62, "Depth of the LFO around the line, in percent of the knob range, for the chosen node. 0 = a straight line. Right-click = default.");
  tt_hov(800, 632, 44, 62, "Speed of the LFO for the chosen node: SYNC = length of one cycle in 16th steps, HZ = cycles per second. Right-click = default.");
  // Einheit
  kv_nv = ukf_segrow(856, 636, 106, 20, 2, kv_md, "SYNC|HZ");
  kv_nv != kv_md ? ( km_lfoMat(kv_sg, kv_ml);  km_lfoUnit(kv_sg, kv_ml, kv_nv);  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
  tt_hov(856, 636, 106, 20, "Unit of RATE for this lane: SYNC = cycle length in 16th steps (follows the tempo), HZ = cycles per second (free). The speed stays the same when you switch.");
  // Form
  kv_shp = kg_lSh(kv_sg, kv_ml);
  kv_shp < 0.5 ? strcpy(#cmb_txt, "SINE") : kv_shp < 1.5 ? strcpy(#cmb_txt, "TRIANGLE") : kv_shp < 2.5 ? strcpy(#cmb_txt, "SAW UP")
    : kv_shp < 3.5 ? strcpy(#cmb_txt, "SQUARE") : strcpy(#cmb_txt, "SAW DOWN");
  kv_nv = combo(52, 856, 660, 106, 20, floor(kv_shp), 5);
  kv_nv != floor(kv_shp) ? (
    kv_ml == 0 ? ( kv_sg[KF_SHP] = kv_nv; ) : ( km_lfoMat(kv_sg, kv_ml);  kv_sg[KF_LS + kv_ml] = kv_nv; );
    kv_sg[KF_ED] = 1;  km_commit();  tt_undo();
  );
  tt_hov(856, 660, 106, 20, "Waveform of this lane's LFO: sine, triangle, saw up (rises, then jumps back), square, or saw down (falls, then jumps up).");
  // Knoten
  kv_ni = kv_nd == 0 ? 0 : kv_nd >= 100 ? kv_np + 1 : kv_nd;
  kv_ni == 0 ? strcpy(#cmb_txt, "NODE: START") : kv_ni == kv_np + 1 ? strcpy(#cmb_txt, "NODE: END") : sprintf(#cmb_txt, "NODE: POINT %d", kv_ni);
  kv_nv = combo(60, 730, 696, 150, 20, kv_ni, kv_np + 2);
  kv_nv != kv_ni ? ( kv_ndPick(kv_nv == 0 ? 0 : kv_nv == kv_np + 1 ? 100 : kv_nv); );
  tt_hov(730, 696, 150, 20, "Which node AMP and RATE edit: START, one of the own points of this lane (double-click the lane to add some) or END. You can also click a handle or point in the map, or a mark in the LFO display. Depth and speed glide from node to node.");
  gfx_setfont(5);
  toggle(886, 696, 76, 20, kv_lnk, "ALL") ? ( kv_lnk = kv_lnk ? 0 : 1; );
  tt_hov(886, 696, 76, 20, "On: AMP and RATE change every node of this lane in the section at once (one value for the whole section).");
) : (
  gfx_setfont(5);  colDim(1);
  xctr(730, 604, 232, 12, "THE VOLUME LANE HAS NO LFO");
  xctr(730, 622, 232, 12, "IT STAYS A STRAIGHT LINE");
  tt_hov(730, 570, 232, 80, "Volume (CC 7) is a plain line from FROM to TO. Choose another lane (click it in the map, or [ and ]) to edit its LFO.");
);
gfx_setfont(5);
kv_bu = km_hasPre(km_sel);
toggle(730, 724, 112, 22, kv_bu, "BUILD-UP") ? (
  kv_ty == 3 ? (
    km_toggleBuildup(km_sel) ? tt_undo() : ( km_msgt = 90;  strcpy(#km_m, "NO ROOM FOR A BUILD-UP"); );
  ) : ( km_msgt = 90;  strcpy(#km_m, "ONLY ON A3 DROP SECTIONS"); );
);
tt_hov(730, 724, 112, 22, "On a DROP: puts a 2-bar PRE-DROP section in front of it (or removes it). The bars come from the section before.");
kv_fl = km_hasFill(km_sel);
toggle(850, 724, 112, 22, kv_fl, "FILL A4") ? (
  kv_ty == 3 ? (
    km_toggleFill(km_sel) ? tt_undo() : ( km_msgt = 90;  strcpy(#km_m, "NO ROOM FOR A FILL"); );
  ) : ( km_msgt = 90;  strcpy(#km_m, "ONLY ON A3 DROP SECTIONS"); );
);
tt_hov(850, 724, 112, 22, "On a DROP: ends it with a 2-bar A4 FILL that continues from the last values (or removes it).");

// ---------- SECTION TOOLS ----------
panel2(16, 766, 958, 62, "SECTION TOOLS");
kv_tname(kv_ty);  strcpy(#cmb_txt, #kv_tn);
inBox(28, 794, 190, 24) ? ( mouse_wheel = 0; );   // das Mausrad wuerde den Typ wechseln und Bearbeitungen verwerfen
kv_nv = combo(53, 28, 794, 190, 24, kv_ty, 8);
kv_nv != kv_ty ? ( km_setType(km_sel, kv_nv);  tt_undo(); );
tt_hov(28, 794, 190, 24, "Type of the selected section. Changing it loads that type's values from the class table.");
kv_sg[KF_LEN] == 1 ? sprintf(#cmb_txt, "LEN %d BAR", kv_sg[KF_LEN]) : sprintf(#cmb_txt, "LEN %d BARS", kv_sg[KF_LEN]);
kv_nv = combo(54, 226, 794, 150, 24, kv_sg[KF_LEN] - 1, KM_MAXBARS);
kv_nv != kv_sg[KF_LEN] - 1 ? ( km_setLen(km_sel, kv_nv + 1);  tt_undo(); );
tt_hov(226, 794, 150, 24, "Length of the selected section in bars. The next section gives or takes the bars (the last one changes the total).");
gfx_setfont(5);
btn(384, 794, 80, 24, 0, "SPLIT") ? (
  km_split(km_sel) ? tt_undo() : ( km_msgt = 90;  strcpy(#km_m, "CANNOT SPLIT"); );
);
tt_hov(384, 794, 80, 24, "Splits the selected section into two halves with the same values.");
