// XY-Feld (354 x 354): x = Cutoff 0..100, y = Resonanz 0..100
panel2(584, 96, 390, 732, "XY RIDE - CUTOFF / RESONANCE");
kv_fx = 602;  kv_fy = 124;  kv_fs = 354;
gfx_set(0.02, 0.03, 0.02, 1);  xrect(kv_fx, kv_fy, kv_fs, kv_fs);
colAcid(0.13);
xrect(kv_fx + M_SWT[0]*0.01*kv_fs, kv_fy + kv_fs - M_SWT[3]*0.01*kv_fs, (M_SWT[1] - M_SWT[0])*0.01*kv_fs, (M_SWT[3] - M_SWT[2])*0.01*kv_fs);
colWhite(0.34);
kv_l0 = M_LIM[0];  kv_l1 = M_LIM[1];  kv_l2 = M_LIM[2];  kv_l3 = M_LIM[3];
xrect(kv_fx + kv_l0*0.01*kv_fs, kv_fy, 1, kv_fs);  xrect(kv_fx + kv_l1*0.01*kv_fs, kv_fy, 1, kv_fs);
xrect(kv_fx, kv_fy + kv_fs - kv_l2*0.01*kv_fs, kv_fs, 1);  xrect(kv_fx, kv_fy + kv_fs - kv_l3*0.01*kv_fs, kv_fs, 1);
colBorder();  xrect(kv_fx, kv_fy, kv_fs, 1);  xrect(kv_fx, kv_fy + kv_fs - 1, kv_fs, 1);  xrect(kv_fx, kv_fy, 1, kv_fs);  xrect(kv_fx + kv_fs - 1, kv_fy, 1, kv_fs);
// Spur der letzten 48 Punkte (alle 3 Frames einer)
kv_trF += 1;
kv_trF >= 3 ? (
  kv_trF = 0;
  M_TRAIL[kv_trI*2] = M_NOW[0];  M_TRAIL[kv_trI*2 + 1] = M_NOW[1];
  kv_trI = (kv_trI + 1) % 48;  kv_trN = min(48, kv_trN + 1);
);
kv_j = 1;
loop(kv_trN - 1,
  kv_a = (kv_trI - kv_j + 96) % 48;  kv_b = (kv_trI - kv_j - 1 + 96) % 48;
  colAcid(0.75*(1 - kv_j/48));
  xline(kv_fx + M_TRAIL[kv_a*2]*0.01*kv_fs, kv_fy + kv_fs - M_TRAIL[kv_a*2 + 1]*0.01*kv_fs,
        kv_fx + M_TRAIL[kv_b*2]*0.01*kv_fs, kv_fy + kv_fs - M_TRAIL[kv_b*2 + 1]*0.01*kv_fs);
  kv_j += 1;
);
kv_px = kv_fx + M_NOW[0]*0.01*kv_fs;  kv_py = kv_fy + kv_fs - M_NOW[1]*0.01*kv_fs;
(M_OVR[0] >= 0 || M_OVR[1] >= 0) ? colWhite(1) : colAcid(1);
xcirc(kv_px, kv_py, 6, 1);  gfx_set(0, 0, 0, 1);  xcirc(kv_px, kv_py, 2, 1);
gfx_setfont(5);
colDim(1);  xstr(kv_fx, kv_fy + kv_fs + 4, "CUTOFF");  xstr(kv_fx + kv_fs - 76, kv_fy + kv_fs + 4, "RESONANCE");
// Ziehen = Override fuer beide Lanes, Loslassen = zurueck zur Fahrt (ausser HOLD)
(uiClick && inBox(kv_fx, kv_fy, kv_fs, kv_fs)) ? ( dragId = 90; );
(dragId == 90 && uiLmb) ? (
  M_OVR[0] = min(100, max(0, floor((mX - kv_fx)/kv_fs*100 + 0.5)));
  M_OVR[1] = min(100, max(0, floor((kv_fy + kv_fs - mY)/kv_fs*100 + 0.5)));
  km_force = 1;  kv_xyOn = 1;
);
(kv_xyOn && !uiLmb) ? (
  kv_xyOn = 0;
  !kv_xyHold ? ( M_OVR[0] = 0 - 1;  M_OVR[1] = 0 - 1;  km_force = 1; );
);
tt_hov(kv_fx, kv_fy, kv_fs, kv_fs, "Drag to ride cutoff (left/right) and resonance (up/down) by hand; release and the ride takes over again (unless HOLD is on). Green box = sweet spot, thin lines = class limits (a guide only: the whole field can be ridden), trail = the last moments.");
toggle(602, 502, 170, 22, kv_xyHold, "HOLD") ? (
  kv_xyHold = kv_xyHold ? 0 : 1;
  // Codex-Review 0.8.0 (8): HOLD aus -> die gehaltenen XY-Werte freigeben
  !kv_xyHold ? ( M_OVR[0] = 0 - 1;  M_OVR[1] = 0 - 1;  km_force = 1; );
);
tt_hov(602, 502, 170, 22, "On: the XY values stay after you let go (shown as OVR). Off: they spring back to the ride.");
btn(786, 502, 170, 22, 0, "RELEASE") ? ( kv_k = 0;  loop(KM_NL, M_OVR[kv_k] = 0 - 1;  kv_k += 1; );  km_force = 1; );
tt_hov(786, 502, 170, 22, "Releases every live override (all lanes back to the ride).");
// Historie: bis 0.8.0 Runde 2 zwei Regler (knob2st 91 RIDE cx 620 r 30, knob2st 92 SMOOTH cx 760 r 30; Beschriftung xctr 570/710, Tooltips 580/720).
// RIDE = INTENSITY (alle Bewegungen), SCREAM (0.8.0 Runde 2: Resonanz hoch, Env Mod runter), SMOOTH
kv_nv = knob2st(91, 653, 610, 30, slider9, 0, 200, 100, 1);
kv_nv != slider9 ? ( tt_slset(9, kv_nv); );
kv_nv = knob2st(93, 779, 610, 30, slider18, 0, 100, 0, 1);
kv_nv != slider18 ? ( tt_slset(18, kv_nv); );
kv_nv = knob2st(92, 905, 610, 30, slider10, 0, 100, 0, 1);
kv_nv != slider10 ? ( tt_slset(10, kv_nv); );
gfx_setfont(5);
colInk(0.9);  xctr(603, 652, 100, 12, "RIDE (INTENSITY)");  xctr(729, 652, 100, 12, "SCREAM");  xctr(855, 652, 100, 12, "SMOOTH");
colAcid(1);  sprintf(#kv_s, "%d %%", slider9);  xctr(603, 665, 100, 12, #kv_s);
sprintf(#kv_s, "%d %%", slider18);  xctr(729, 665, 100, 12, #kv_s);
sprintf(#kv_s, "%d %%", slider10);  xctr(855, 665, 100, 12, #kv_s);
tt_hov(613, 566, 80, 110, "RIDE: scales every movement of the whole arrangement (same as INTENSITY below). 0 = straight lines, 200 % = double.");
tt_hov(739, 566, 80, 110, "SCREAM: pushes resonance up and env mod down towards the scream class (0 % = off, 100 % = full); stays inside the class limits in sections you have not edited.");
tt_hov(865, 566, 80, 110, "SMOOTH: rounds off jumps between values (same as SMOOTH below).");
);
// ==== Reiter 4 (65_view_tracker.jsfx), vom Generator gefasst ====
km_view == 4 ? (
// ---------- Reiter TRACKER (K5): jede Zeile ein Abschnitt, alle Werte als Zahlen ----------
// Vom Generator in "km_view == 4 ? ( ... );" gefasst. Zellen: ziehen (senkrecht), Rad +-1, Doppel-/Rechts-/Strg-Klick = Wert der Klassentabelle.
// TYPE: Doppelklick = naechster Typ (Umschalt = vorheriger; laedt die Werte der Klasse wie RESET TO CLASS). Grau = Lane in diesem Abschnitt aus,
// kursiv gedacht/gedimmt = FILL-Abschnitt (folgt dem Vorgaenger, bis eine Zelle angefasst wird). Darunter die Vorschau des gewaehlten Abschnitts.
panel2(16, 96, 958, 732, "TRACKER - SECTION TABLE");
kv_rows = 28;  kv_rh = 17;  kv_ty0 = 146;
// Kopf
gfx_setfont(5);
colDim(1);
xstr(30, 130, "#");  xstr(56, 130, "TYPE");  xstr(134, 130, "LEN");
kv_k = 0;
loop(KM_NL,
  kv_lshort(kv_k);
  kv_k == kv_lane ? colAcid(1) : colDim(1);
  xctr(176 + kv_k*104, 118, 101, 12, #kv_ls);
  colDim(0.8);  xctr(176 + kv_k*104, 130, 50, 12, "FROM");  xctr(228 + kv_k*104, 130, 50, 12, "TO");
  kv_k += 1;
);
colDim(1);  xctr(810, 130, 44, 12, "SWG");  xctr(858, 130, 44, 12, "PER");  xctr(906, 130, 48, 12, "RIDE");
tt_hov(176, 116, 624, 28, "Knob columns: FROM = value the ramp starts the section with, TO = value at its end (any value 0-100). The green one is the lane the Up/Down keys edit.");
tt_hov(810, 116, 144, 28, "SWG = cutoff swing depth, PER = swing period in 16th steps, RIDE = wobble of the other lanes (%).");
// Sichtbaren Bereich der Auswahl folgen lassen (nur wenn sich die Auswahl geaendert hat; sonst darf man frei rollen)
kv_trSelP != km_sel ? (
  kv_trSelP = km_sel;
  km_sel < kv_trTop ? ( kv_trTop = km_sel; );
  km_sel >= kv_trTop + kv_rows ? ( kv_trTop = km_sel - kv_rows + 1; );
);
kv_trTop = max(0, min(max(0, km_nseg - kv_rows), kv_trTop));
// Zeilen
kv_r = 0;
loop(min(kv_rows, km_nseg - kv_trTop),
  kv_i = kv_trTop + kv_r;
  kv_y = kv_ty0 + kv_r*kv_rh;
  kv_p = M_SEG + kv_i*KM_SS;
  kv_pty = kv_p[KF_TYPE];
  kv_rel = kv_p[KF_REL] > 0.5;
  kv_i == km_sel ? ( colWhite(0.07);  xrect(26, kv_y - 1, 930, kv_rh); );
  gfx_setfont(5);
  kv_i == km_curSeg ? colAcid(1) : colDim(1);
  kv_i == km_curSeg ? sprintf(#kv_s, ">%d", kv_i + 1) : sprintf(#kv_s, " %d", kv_i + 1);  xstr(28, kv_y + 2, #kv_s);
  (uiClick && inBox(26, kv_y - 1, 26, kv_rh)) ? ( km_sel = kv_i; );
  // TYPE: Klick waehlt, Doppelklick wechselt den Typ
  kv_hov = inBox(54, kv_y, 76, kv_rh - 2);
  kv_secCol(kv_pty, kv_hov ? 1 : 0.85);  xrect(54, kv_y, 76, kv_rh - 2);
  kv_isLight(kv_pty) ? gfx_set(0.02, 0.06, 0.02, 1) : colInk(1);
  kv_tcode(kv_pty);  kv_sname(kv_pty);  sprintf(#kv_s, "%s %s", #kv_tc, #kv_sn);  xstrfit(57, kv_y, 72, kv_rh - 2, #kv_s);
  (uiClick && kv_hov) ? (
    (clickId == 4000 + kv_i && clickWait > 0) ? (
      km_setType(kv_i, (mouse_cap & 8) ? (kv_pty + 7) % 8 : (kv_pty + 1) % 8);  tt_undo();  clickWait = 0;
    ) : ( clickId = 4000 + kv_i;  clickWait = 12; );
    km_sel = kv_i;
  );
  // LEN
  kv_id = 5000 + kv_i*16;
  (uiClick && inBox(132, kv_y, 40, kv_rh - 2)) ? ( km_sel = kv_i; );
  kv_nv = kv_cell(kv_id, 132, kv_y, 40, kv_rh - 2, kv_p[KF_LEN], 1, KM_MAXBARS, kv_p[KF_LEN], 0);
  kv_nv != kv_p[KF_LEN] ? ( km_setLen(kv_i, kv_nv);  tt_undo(); );
  colInk(1);  sprintf(#kv_s, "%d", kv_p[KF_LEN]);  xctr(132, kv_y, 40, kv_rh - 2, #kv_s);
  // Lanes FROM / TO
  kv_t2 = M_TAB + (km_cls*8 + kv_pty)*16;
  kv_k = 0;
  loop(KM_NL,
    kv_lo = M_LIM[kv_k*2];  kv_hi = M_LIM[kv_k*2 + 1];
    kv_si = kv_k == 0 ? 0 : kv_k == 1 ? 4 : kv_k == 2 ? 6 : kv_k == 3 ? 8 : 10;
    kv_w = 0;
    loop(2,
      kv_cx = 176 + kv_k*104 + kv_w*52;
      kv_v = kv_w ? M_EE[kv_i*8 + kv_k] : M_ES[kv_i*8 + kv_k];
      kv_df = kv_k == 5 ? 100 : (kv_pty == 4 ? kv_v : kv_t2[kv_si + kv_w]);
      (uiClick && inBox(kv_cx, kv_y, 50, kv_rh - 2)) ? ( km_sel = kv_i;  kv_lane = kv_k;  kv_trW = kv_w; );
      kv_nv = kv_cell(kv_id + 1 + kv_k*2 + kv_w, kv_cx, kv_y, 50, kv_rh - 2, kv_v, 0, 100, min(kv_hi, max(kv_lo, kv_df)),
                      kv_i == km_sel && kv_k == kv_lane && kv_w == kv_trW);
      kv_nv != kv_v ? ( kv_setVal(kv_i, kv_k, kv_w, kv_nv); );
      kv_p[KF_ON + kv_k] < 0.5 ? colDim(0.55) : (kv_rel && kv_k < 5) ? colInk(0.6) : colAcid(1);
      sprintf(#kv_s, "%d", kv_v);  xctr(kv_cx, kv_y, 50, kv_rh - 2, #kv_s);
      // 0.9.0: kleine Marke oben rechts, wenn die Lane in diesem Abschnitt eigene Punkte hat
      (kv_w == 1 && kv_p[KF_NP + kv_k] > 0.5) ? ( colAcid(1);  xrect(kv_cx + 44, kv_y + 2, 4, 4); );
      kv_w += 1;
    );
    kv_k += 1;
  );
  // SWING / PERIOD / RIDE
  (uiClick && inBox(810, kv_y, 144, kv_rh - 2)) ? ( km_sel = kv_i; );
  kv_nv = kv_cell(kv_id + 13, 810, kv_y, 44, kv_rh - 2, kv_p[KF_SWA], 0, 72, kv_pty == 4 ? 0 : kv_t2[2], 0);
  kv_nv != kv_p[KF_SWA] ? ( kv_p[KF_SWA] = kv_nv;  kv_p[KF_ED] = 1;  km_commit();  tt_undo(); );
  colAcid(1);  sprintf(#kv_s, "%d", kv_p[KF_SWA]);  xctr(810, kv_y, 44, kv_rh - 2, #kv_s);
  kv_nv = kv_cell(kv_id + 14, 858, kv_y, 44, kv_rh - 2, kv_p[KF_SWP], 1, 64, kv_pty == 4 ? 1 : kv_t2[3], 0);
  kv_nv != kv_p[KF_SWP] ? ( kv_p[KF_SWP] = kv_nv;  kv_p[KF_ED] = 1;  km_commit();  tt_undo(); );
  colAcid(1);  sprintf(#kv_s, "%d", kv_p[KF_SWP]);  xctr(858, kv_y, 44, kv_rh - 2, #kv_s);
  kv_nv = kv_cell(kv_id + 15, 906, kv_y, 48, kv_rh - 2, kv_p[KF_RIDE], 0, 200, 100, 0);
  kv_nv != kv_p[KF_RIDE] ? ( kv_p[KF_RIDE] = kv_nv;  kv_p[KF_ED] = 1;  km_commit();  tt_undo(); );
  colAcid(1);  sprintf(#kv_s, "%d", kv_p[KF_RIDE]);  xctr(906, kv_y, 48, kv_rh - 2, #kv_s);
  kv_r += 1;
);
tt_hov(26, kv_ty0, 26, kv_rows*kv_rh, "Section number (> = playing now). Click selects the row, the wheel here scrolls the table.");
tt_hov(54, kv_ty0, 76, kv_rows*kv_rh, "Section type. Click selects, double-click = next type (Shift = previous); a new type loads that type's values from the class table.");
tt_hov(132, kv_ty0, 40, kv_rows*kv_rh, "Length in bars: drag up/down or use the wheel; the next section gives or takes the bars.");
tt_hov(176, kv_ty0, 624, kv_rows*kv_rh, "FROM / TO of each knob: drag up/down (Shift = fine) or wheel = +-1, double-click or right-click = class table value. Grey = lane off in this section, dim = FILL section that still follows the previous one. Keys: Up/Down = +-1, Page Up/Down = +-10, Alt = the other end.");
tt_hov(810, kv_ty0, 144, kv_rows*kv_rh, "Cutoff swing depth (0 to 72), swing period in 16th steps (1 to 64) and ride of the other lanes (0 to 200 %).");
// Rollen: Rad ueber der Nummernspalte bzw. Rollbalken
(inBox(26, kv_ty0, 26, kv_rows*kv_rh) && mouse_wheel != 0) ? ( kv_trTop -= mouse_wheel > 0 ? 3 : 0 - 3;  mouse_wheel = 0; );
km_nseg > kv_rows ? (
  kv_sbh = kv_rows*kv_rh;
  gfx_set(0.03, 0.04, 0.03, 1);  xrect(958, kv_ty0, 8, kv_sbh);
  kv_thh = max(16, kv_rows/km_nseg*kv_sbh);
  kv_thy = kv_ty0 + kv_trTop/(km_nseg - kv_rows)*(kv_sbh - kv_thh);
  (dragId == 3300 || inBox(956, kv_thy, 12, kv_thh)) ? colAcid(0.9) : colAcid(0.5);
  xrect(958, kv_thy, 8, kv_thh);
  (uiClick && inBox(956, kv_ty0, 12, kv_sbh)) ? ( dragId = 3300;  kv_sbY = mY;  kv_sbT = kv_trTop; );
  (dragId == 3300 && uiLmb) ? ( kv_trTop = floor(kv_sbT + (mY - kv_sbY)/max(1, kv_sbh - kv_thh)*(km_nseg - kv_rows) + 0.5); );
  tt_hov(956, kv_ty0, 12, kv_sbh, "Scroll the table (64 sections at most).");
);
kv_trTop = max(0, min(max(0, km_nseg - kv_rows), kv_trTop));

// Vorschau des gewaehlten Abschnitts (alle sechs Lanes ueber seine Laenge), nur bei Aenderung neu gerechnet
(kg_bseq != kv_spk || km_sel != kv_sps || km_barBeats != kv_spb || km_tempo != kv_spt) ? (
  kv_spk = kg_bseq;  kv_sps = km_sel;  kv_spb = km_barBeats;  kv_spt = km_tempo;
  kv_j = 0;
  loop(96,
    kv_pb = min((kg_tot - 0.0001)*km_barBeats, (kg_CUM[km_sel] + kv_j/95*kv_sg[KF_LEN])*km_barBeats);
    kg_eval(kv_pb, M_TMPG);
    kv_k = 0;  loop(KM_NL, M_SPRV[kv_k*96 + kv_j] = M_TMPG[kv_k];  kv_k += 1; );
    kv_j += 1;
  );
);
kv_tname(kv_ty);
sprintf(#kv_s, "SECTION %d %s - %d BARS", km_sel + 1, #kv_tn, kv_sg[KF_LEN]);
colInk(0.92);  xstr(28, 634, #kv_s);
kv_k = 0;
loop(KM_NL,
  kv_x = 28 + kv_k*156;  kv_y = 654;
  gfx_set(0.02, 0.03, 0.02, 1);  xrect(kv_x, kv_y, 148, 150);
  colAcid(0.13);  xrect(kv_x + 1, kv_y + 150 - M_SWT[kv_k*2 + 1]*1.5, 146, (M_SWT[kv_k*2 + 1] - M_SWT[kv_k*2])*1.5);
  kv_k == kv_lane ? colAcid(0.55) : colBorder();
  xrect(kv_x, kv_y, 148, 1);  xrect(kv_x, kv_y + 149, 148, 1);  xrect(kv_x, kv_y, 1, 150);  xrect(kv_x + 147, kv_y, 1, 150);
  colAcid(1);
  kv_j = 0;
  loop(95,
    xline(kv_x + kv_j/95*148, kv_y + 150 - M_SPRV[kv_k*96 + kv_j]*1.5, kv_x + (kv_j + 1)/95*148, kv_y + 150 - M_SPRV[kv_k*96 + kv_j + 1]*1.5);
    kv_j += 1;
  );
  gfx_setfont(5);
  colDim(1);  kv_lshort(kv_k);  xstr(kv_x + 4, kv_y + 154, #kv_ls);
  kv_k += 1;
);
tt_hov(28, 632, 928, 190, "Preview of the selected section: how each knob moves over its length (ramp plus swing and wobble; class limits are a guide only - the whole 0-100 range can be used).");
);
// ---------- OUTPUT (in allen Reitern gleich) ----------
panel2(16, 838, 958, 62, "OUTPUT");
gfx_setfont(5);
colDim(1);  xstr(28, 876, "MIDI");
sprintf(#cmb_txt, "CH %d", km_ch);
kv_nv = combo(55, 62, 864, 88, 24, km_ch - 1, 16);
kv_nv != km_ch - 1 ? ( tt_slset(5, kv_nv + 1); );
tt_hov(28, 864, 122, 24, "MIDI channel of the CC messages. Set the TT-303 behind this plug-in to listen on the same channel.");
gfx_setfont(5);
colDim(1);  xstr(160, 876, "RATE");
km_rate == 0 ? strcpy(#cmb_txt, "1/32") : km_rate == 1 ? strcpy(#cmb_txt, "1/64") : km_rate == 2 ? strcpy(#cmb_txt, "1/128") : strcpy(#cmb_txt, "1/256");
kv_nv = combo(56, 196, 864, 90, 24, km_rate, 4);
kv_nv != km_rate ? ( tt_slset(6, kv_nv); );
tt_hov(160, 864, 126, 24, "How often a lane is looked at (note value). A CC is only sent when its value changed.");
gfx_setfont(5);
toggle(296, 864, 112, 24, km_pass, "PASS NOTES") ? ( tt_slset(7, km_pass ? 0 : 1); );
tt_hov(296, 864, 112, 24, "On: incoming notes pass through unchanged. Off: notes are dropped (a note already sounding is still released).");
toggle(416, 864, 104, 24, km_cc7, "SEND CC 7") ? ( tt_slset(8, km_cc7 ? 0 : 1); );
tt_hov(416, 864, 104, 24, "Also sends the volume lane as CC 7 (flat 100 % unless you edit it in MAP, DESK or TRACKER).");
colDim(1);  xstr(560, 870, "INTENSITY");
kv_nv = hsliderst(41, 560, 882, 130, 12, slider9, 0, 200, 100, 1);
kv_nv != slider9 ? ( tt_slset(9, kv_nv); );
colAcid(1);  sprintf(#kv_s, "%d %%", slider9);  xstr(696, 882, #kv_s);
tt_hov(560, 866, 170, 28, "Scales every movement: the cutoff swing and the wobble of the other lanes. 100 % = as set, 0 = straight lines.");
colDim(1);  xstr(780, 870, "SMOOTH");
kv_nv = hsliderst(42, 780, 882, 130, 12, slider10, 0, 100, 0, 1);
kv_nv != slider10 ? ( tt_slset(10, kv_nv); );
colAcid(1);  sprintf(#kv_s, "%d %%", slider10);  xstr(916, 882, #kv_s);
tt_hov(780, 866, 170, 28, "Rounds off jumps between values (a slew of up to 8 steps). 0 = off.");

// ---------- Tastatur (0.8.0, wie der MOVER-Tab der TT-ACIDLAB) ----------
// Nur ohne offenes Overlay (OPTIONS, Zoom-Eingabefeld, Preset-Dropdown, Namenseingabe): die lesen gfx_getchar selbst (in tth_post/tt_pb_post).
(!tth_open && !tth_edit && !tt_pb_open && !tt_pb_hold) ? (
  kv_c = gfx_getchar();  kv_n = 0;
  while (kv_c > 0 && kv_n < 16) ( kv_key(kv_c, tth_rcap);  kv_c = gfx_getchar();  kv_n += 1; );
);
(kv_inj && gmem[7405] != 0) ? ( kv_key(gmem[7405], gmem[7406]);  gmem[7405] = 0;  gmem[7406] = 0; );

// ---------- Liste fuer PREVIEW (0.9.6) ----------
kv_pvList();

// ---------- Preset-Leiste, OPTIONS, Tooltips ----------
kv_pa = tt_pb_post(OX + 652*SC, OY + 6*SC, SC);
kv_pa == 1 ? ( km_pbFactory(tt_pb_arg);  tt_undo(); )
: kv_pa == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( km_pbApply();  tt_undo(); ); )
: kv_pa == 3 ? ( km_pbCapture();  tt_pb_commit(tt_pb_arg, KM_PSW); )
: kv_pa == 4 ? ( km_pbFactory(0);  tt_undo(); );
tt_pb_track(km_pbSum());
kv_c = tth_post(OX + 912*SC, OY + 6*SC, SC);
kv_c >= 0 ? ( slider11 = kv_c;  sliderchange(slider11);  slider_automate(slider11); );
tt_modtips();  tt_tipflush();
uikit_end();
// Zeichenzeit je Frame (ms): gleitender Mittelwert und Spitze, nur fuer Testskripte (Freigabe)
kv_ft = (time_precise() - kv_tf0)*1000;
kv_fa = kv_fa*0.9 + kv_ft*0.1;  kv_fm = max(kv_ft, kv_fm*0.995);
tt_testok() ? (
  gmem[6150] = kv_fa;  gmem[6151] = kv_fm;  gmem[6152] += 1;
  gmem[7420] = km_view;  gmem[7421] = kv_zoom;  gmem[7422] = kv_b0;  gmem[7423] = kv_lane;  gmem[7424] = kv_pv;  gmem[7425] += 1;
  gmem[7426] = km_ld;  gmem[7427] = km_sel;  gmem[7428] = km_selQ;  gmem[7429] = kv_vis;  gmem[7430] = kv_lmax;  gmem[7431] = kv_pvDrop;  gmem[7432] = kv_nd;
);
km_ggen += 1;      // 0.8.0 Seqlock: wieder gerade = die Front ist fertig (MUSS die letzte Zeile des @gfx bleiben)
