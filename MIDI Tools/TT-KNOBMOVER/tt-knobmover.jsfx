kv_nv = knob2st(82, 902, 690, 24, kv_sg[KF_SWA], 0, 72, kv_ty == 4 ? 0 : M_TAB[(km_cls*8 + kv_ty)*16 + 2], 1);
kv_nv != kv_sg[KF_SWA] ? ( kv_sg[KF_SWA] = kv_nv;  kv_sg[KF_ED] = 1;  km_commit();  tt_undo(); );
gfx_setfont(5);
colInk(0.9);  xctr(780, 724, 60, 12, "RIDE");  xctr(872, 724, 60, 12, "SWING");
colAcid(1);  sprintf(#kv_s, "%d %%", kv_sg[KF_RIDE]);  xctr(780, 737, 60, 12, #kv_s);
