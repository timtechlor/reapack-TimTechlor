// ==== Reiter 3 (64_view_pads.jsfx), vom Generator gefasst ====
km_view == 3 ? (
// ---------- Reiter PADS (K4): Abschnitte als grosse Pads, XY-Feld fuer Cutoff/Resonanz ----------
// Vom Generator in "km_view == 3 ? ( ... );" gefasst. Pads waehlen den Abschnitt (QUANTIZE: am naechsten Takt, Block-Thread); bei FOLLOW SONG aus
// laeuft er als Schleife. Das XY-Feld setzt beim Ziehen den Live-Override von Cutoff (waagerecht) und Resonanz (senkrecht); beim Loslassen
// federt die Fahrt zurueck (Override aus), ausser HOLD ist an. Historie: Nicht umgesetzt aus dem Mockup: SCREAM-Schieber, Pads per MIDI-Note (offen, PLAN.md).
// 0.8.0 Runde 2 (14.10.2026): SCREAM-Regler (dritter Regler rechts, Slider 18) und Pads per MIDI-Note (NOTE TRIGGER unten links,
// Slider 19..21; Trigger-Noten BASE..BASE+15 auf dem Trigger-Kanal waehlen wie die Pads und laufen nicht weiter).
panel2(16, 96, 556, 732, "SECTION PADS");
// Codex-Review 0.8.0 (4): Seite getrennt von der Auswahl (Blaettern darf die hoerbare Schleife nicht wechseln); folgt der Auswahl, wenn sie sich aendert
kv_pgSel != km_sel ? ( kv_pgSel = km_sel;  kv_padPg = floor(km_sel/16);  kv_dskPg = floor(km_sel/8); );
kv_pg = max(0, min(ceil(km_nseg/16) - 1, kv_padPg));
// Historie: kv_pg = floor(km_sel/16);
kv_pgn = ceil(km_nseg/16);
kv_i = 0;
loop(16,
  kv_n = kv_pg*16 + kv_i;
  kv_x = 28 + (kv_i % 4)*134;  kv_y = 124 + floor(kv_i/4)*136;
  kv_n < km_nseg ? (
    kv_p = M_SEG + kv_n*KM_SS;
    kv_tname(kv_p[KF_TYPE]);
    gfx_setfont(4);
    padbtn(kv_x, kv_y, 128, 130, kv_n == km_sel, kv_n == km_curSeg, #kv_tn, "Section pad: selects this section (with QUANTIZE at the next bar while playing). With FOLLOW SONG off the section loops, so the pads switch it live. Outline = section playing now.") ? kv_padSel(kv_n);
    gfx_setfont(5);
