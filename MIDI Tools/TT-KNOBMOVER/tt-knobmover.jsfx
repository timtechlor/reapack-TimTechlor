  (km_tgt + 1*KM_SS)[KF_ED] = 1; (km_tgt + 1*KM_SS)[KF_REL] = 0; (km_tgt + 1*KM_SS)[KF_SWA] = 0; (km_tgt + 1*KM_SS)[KF_RIDE] = 0;
