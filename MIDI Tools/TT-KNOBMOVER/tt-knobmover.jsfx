btn(28, 678, 40, 22, 0, "<") ? ( kv_padPg = max(0, kv_pg - 1); );
tt_hov(28, 678, 40, 22, "Previous page of pads (16 sections per page).");
sprintf(#kv_s, "PAGE %d / %d", kv_pg + 1, kv_pgn);  colInk(0.9);  xctr(70, 678, 96, 22, #kv_s);
btn(168, 678, 40, 22, 0, ">") ? ( kv_padPg = min(ceil(km_nseg/16) - 1, kv_pg + 1); );
tt_hov(168, 678, 40, 22, "Next page of pads.");
toggle(220, 678, 150, 22, km_quant, "QUANTIZE NEXT BAR") ? ( km_quant = km_quant ? 0 : 1; );
tt_hov(220, 678, 150, 22, "On: a pad switches at the next bar while playing (orange bar = waiting). Off: at once.");
toggle(376, 678, 148, 22, !km_follow, "LOOP SECTION") ? ( tt_slset(2, km_follow ? 0 : 1); );
tt_hov(376, 678, 148, 22, "On = FOLLOW SONG off: the selected section loops, the pads switch scenes live. Off = the arrangement follows the project.");
// Historie: xstr(28, 528, "PADS PICK THE SECTION, THE XY FIELD RIDES CUTOFF AND");  xstr(28, 542, "RESONANCE BY HAND. EVERYTHING ELSE KEEPS RIDING.");
// 0.8.0 Runde 2: NOTE TRIGGER - die Pads von MIDI-Noten aus schalten (Kanal und Basisnote waehlbar; Einrichtung, kein Teil des Klang-Presets)
toggle(28, 710, 150, 22, km_ntOn, "NOTE TRIGGER") ? ( tt_slset(19, km_ntOn ? 0 : 1); );
