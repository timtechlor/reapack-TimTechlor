      xstr(kv_x + 122 - kv_w1/SC, kv_y + 114, #kv_nn);
    );
    (km_selQ == kv_n && (time_precise()*4 - floor(time_precise()*4)) < 0.5) ? ( gfx_set(1, 0.72, 0.18, 1);  xrect(kv_x + 3, kv_y + 3, 122, 3); );
  ) : (
