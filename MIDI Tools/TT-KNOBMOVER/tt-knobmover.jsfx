// ==== Reiter 2 (63_view_desk.jsfx), vom Generator gefasst ====
km_view == 2 ? (
// ---------- Reiter DESK (K3): ein Kanalzug je Regler, Szenen-Pads ----------
// Vom Generator in "km_view == 2 ? ( ... );" gefasst. Je Zug: Bereichsleiste 0..100 mit Sweetspot, Klassengrenzen und den Griffen FROM (hohl) /
// TO (voll) des gewaehlten Abschnitts (ziehen = Wert), weisse Linie = gesendeter Wert, Pegel = zuletzt gesendeter CC, Live-Regler (Override), ON.
// Historie: Nicht umgesetzt aus dem Mockup: MOVE je Spur (braeuchte einen neuen Engine-Parameter; offen, siehe PLAN.md).
// 0.8.0 Runde 2 (14.10.2026): MOVE je Spur umgesetzt - Schieber je Kanalzug unter dem ON-Schalter (Slider 13..17, 0..200 %),
// skaliert die Schwingung der Lane um ihre FROM/TO-Linie (Engine-Parameter M_MOVE, Zeiger ke_MOVE/kg_MOVE).
kv_tname(kv_ty);
sprintf(#kv_t, "DESK - SECTION %d %s", km_sel + 1, #kv_tn);
panel2(16, 96, 710, 732, #kv_t);
kv_k = 0;
loop(KM_NL,
  kv_x = 34 + kv_k*116;
  kv_lo = M_LIM[kv_k*2];  kv_hi = M_LIM[kv_k*2 + 1];
  gfx_setfont(5);
  kv_k == kv_lane ? colAcid(1) : colInk(0.9);
  kv_lshort(kv_k);  sprintf(#kv_s, "%s CC %d", #kv_ls, M_CCN[kv_k]);  xctr(kv_x, 124, 96, 12, #kv_s);
  kv_live = M_OVR[kv_k] >= 0 ? M_OVR[kv_k] : M_NOW[kv_k];
  colAcid(1);
  (kv_k == 5 && !km_cc7) ? xctr(kv_x, 138, 96, 12, "CC 7 OFF")
  : ( M_OVR[kv_k] >= 0 ? sprintf(#kv_s, "%d %% OVR", floor(kv_live + 0.5)) : sprintf(#kv_s, "%d %%", floor(kv_live + 0.5));  xctr(kv_x, 138, 96, 12, #kv_s); );
  // Bereichsleiste (y 160..460 = Wert 100..0)
  kv_bx0 = kv_x + 26;  kv_by0 = 160;  kv_bh = 500;
  gfx_set(0.02, 0.03, 0.02, 1);  xrect(kv_bx0, kv_by0, 28, kv_bh);
  colAcid(0.13);  xrect(kv_bx0 + 1, kv_by0 + kv_bh - M_SWT[kv_k*2 + 1]*0.01*kv_bh, 26, (M_SWT[kv_k*2 + 1] - M_SWT[kv_k*2])*0.01*kv_bh);
  colWhite(0.34);
  kv_hi < 99.5 ? xrect(kv_bx0 - 4, kv_by0 + kv_bh - kv_hi*0.01*kv_bh, 36, 1);
  kv_lo > 0.5 ? xrect(kv_bx0 - 4, kv_by0 + kv_bh - kv_lo*0.01*kv_bh, 36, 1);
  kv_k == kv_lane ? colAcid(0.55) : colBorder();
  xrect(kv_bx0, kv_by0, 28, 1);  xrect(kv_bx0, kv_by0 + kv_bh - 1, 28, 1);  xrect(kv_bx0, kv_by0, 1, kv_bh);  xrect(kv_bx0 + 27, kv_by0, 1, kv_bh);
  kv_sv = kv_es[kv_k];  kv_ev = kv_ee[kv_k];
  kv_ya = kv_by0 + kv_bh - kv_sv*0.01*kv_bh;  kv_yb = kv_by0 + kv_bh - kv_ev*0.01*kv_bh;
  colAcid(0.35);  xrect(kv_bx0 + 8, min(kv_ya, kv_yb), 12, max(1, abs(kv_ya - kv_yb)));
  // gesendeter Wert
  colWhite(0.95);  xrect(kv_bx0 + 1, kv_by0 + kv_bh - M_NOW[kv_k]*0.01*kv_bh, 26, 2);
  // Griffe FROM (hohl) / TO (voll)
  gfx_set(0, 0, 0, 1);  xrect(kv_bx0 - 5, kv_ya - 4, 38, 8);  colWhite(1);  xrect(kv_bx0 - 5, kv_ya - 4, 38, 1);  xrect(kv_bx0 - 5, kv_ya + 3, 38, 1);
  xrect(kv_bx0 - 5, kv_ya - 4, 1, 8);  xrect(kv_bx0 + 32, kv_ya - 4, 1, 8);
  colWhite(1);  xrect(kv_bx0 - 5, kv_yb - 4, 38, 8);  gfx_set(0, 0, 0, 1);  xrect(kv_bx0 + 12, kv_yb - 1, 4, 2);
  // Pegel: zuletzt gesendeter CC (0..127)
  ledbar(kv_x + 62, kv_by0, 8, kv_bh, 24, max(0, M_OUT[kv_k])/127, 0 - 1, 1);
  // Ziehen: naechster Griff (TO hat Vorrang, wenn beide uebereinander liegen); Umschalt = fein
  (uiClick && inBox(kv_bx0 - 8, kv_by0 - 8, 44, kv_bh + 16)) ? (
    kv_wh = abs(mY - kv_yb) <= abs(mY - kv_ya) ? 1 : 0;
    dragId = 61 + kv_k*2 + kv_wh;  kv_dY = mY;  kv_dV = kv_wh ? kv_ev : kv_sv;  kv_dSh = (mouse_cap & 8) ? 1 : 0;
    kv_lane = kv_k;
  );
  (uiLmb && (dragId == 61 + kv_k*2 || dragId == 62 + kv_k*2)) ? (
    kv_wh = dragId == 62 + kv_k*2;
    kv_sh = (mouse_cap & 8) ? 1 : 0;
    kv_sh != kv_dSh ? ( kv_dSh = kv_sh;  kv_dY = mY;  kv_dV = kv_wh ? kv_ev : kv_sv; );
    kv_nv = min(100, max(0, floor(kv_dV + (kv_dY - mY)/kv_bh*100/(kv_sh ? 6 : 1) + 0.5)));
    kv_nv != (kv_wh ? kv_ev : kv_sv) ? ( kv_setVal(km_sel, kv_k, kv_wh, kv_nv); );
  );
  tt_hov(kv_bx0 - 8, kv_by0 - 8, 44, kv_bh + 16, "Range of this knob in the selected section: drag the hollow handle (FROM, start of the ramp) or the solid one (TO, end); Shift = fine. Green band = sweet spot, white ticks = class limits (a guide only: the handles move over the whole 0-100), white line = the value being sent.");
  tt_hov(kv_x + 60, kv_by0, 12, kv_bh, "Last CC value sent on this lane (0 to 127).");
  gfx_setfont(5);
  colDim(1);  xstr(kv_x + 6, 670, "FROM");  colAcid(1);  sprintf(#kv_s, "%d", kv_sv);  xstr(kv_x + 56, 670, #kv_s);
  colDim(1);  xstr(kv_x + 6, 684, "TO");    colAcid(1);  sprintf(#kv_s, "%d", kv_ev);  xstr(kv_x + 56, 684, #kv_s);
  // Live-Regler (Override wie im RACK+)
  kv_nv = knob2st(1 + kv_k, kv_x + 48, 728, 20, kv_live, 0, 100, 0 - 1, 0);
  kv_nv != kv_live ? (
    kv_nv < 0 ? ( M_OVR[kv_k] = 0 - 1; ) : ( M_OVR[kv_k] = min(100, max(0, kv_nv)); );
    km_force = 1;
  );
  tt_hov(kv_x + 24, 704, 48, 48, "Live value: drag = hold your own value (OVR), right-click, double-click or Ctrl+click = back to the ride.");
  gfx_setfont(5);
  toggle(kv_x + 18, 762, 60, 20, kv_sg[KF_ON + kv_k] > 0.5, "ON") ? (
    kv_on = kv_sg[KF_ON + kv_k] > 0.5 ? 0 : 1;
    (mouse_cap & 8) ? (
      kv_j = 0;
      loop(km_nseg, kv_p = M_SEG + kv_j*KM_SS;  kv_p[KF_ON + kv_k] = kv_on;  kv_p[KF_ED] = 1;  kv_j += 1; );
    ) : ( kv_sg[KF_ON + kv_k] = kv_on;  kv_sg[KF_ED] = 1; );
    km_commit();  tt_undo();
  );
  tt_hov(kv_x + 18, 762, 60, 20, "Sends this CC lane while the selected section plays. Shift+click = all sections.");
  // 0.8.0 Runde 2: MOVE je Spur - wie stark die Lane um ihre FROM/TO-Linie schwingt (Slider 13..17; Volume hat keine Schwingung)
  gfx_setfont(5);
  kv_k < 5 ? (
    colDim(1);  xstr(kv_x + 4, 786, "MOVE");
    sprintf(#kv_s, "%d %%", slider(13 + kv_k));
    gfx_measurestr(#kv_s, kv_w1, kv_h1);
    colAcid(1);  xstr(kv_x + 92 - kv_w1/SC, 786, #kv_s);
    kv_nv = hsliderst(101 + kv_k, kv_x + 10, 800, 76, 9, slider(13 + kv_k), 0, 200, 100, 1);
    kv_nv != slider(13 + kv_k) ? ( tt_slset(13 + kv_k, kv_nv); );
    tt_hov(kv_x + 4, 784, 88, 26, "MOVE: how strongly this lane swings around its FROM / TO line in every section (0 % = straight line, 100 % = as set, 200 % = double). Right-click = 100 %.");
  ) : (
    colDim(0.8);  xstr(kv_x + 4, 786, "NO MOVE");
    tt_hov(kv_x + 4, 784, 88, 26, "The volume lane does not swing, so MOVE does not apply to it.");
  );
  kv_k += 1;
);

