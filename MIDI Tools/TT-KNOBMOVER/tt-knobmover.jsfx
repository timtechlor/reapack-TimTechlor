// Vorlage t im Stil st nach km_tgt schreiben (0.8.0: Ziel M_SEG oder die Preset-Vorschau M_PVSEG), Klasse km_tcls; Anzahl danach in km_tn.
function km_template(t, st) (
  km_tn = 0;
  (t == 0 && st == 0) ? km_tpl_0_0();
  (t == 0 && st == 2) ? km_tpl_0_2();
  (t == 0 && st == 3) ? km_tpl_0_3();
  (t == 0 && st == 4) ? km_tpl_0_4();
  (t == 0 && st == 5) ? km_tpl_0_5();
  (t == 0 && st == 6) ? km_tpl_0_6();
  (t == 1 && st == 0) ? km_tpl_1_0();
  (t == 1 && st == 1) ? km_tpl_1_1();
  (t == 2 && st == 0) ? km_tpl_2_0();
  (t == 2 && st == 1) ? km_tpl_2_1();
  (t == 2 && st == 6) ? km_tpl_2_6();
  (t == 3 && st == 0) ? km_tpl_3_0();
  (t == 3 && st == 1) ? km_tpl_3_1();
  (t == 3 && st == 3) ? km_tpl_3_3();
  (t == 3 && st == 4) ? km_tpl_3_4();
  (t == 4 && st == 0) ? km_tpl_4_0();
  (t == 4 && st == 2) ? km_tpl_4_2();
  (t == 4 && st == 4) ? km_tpl_4_4();
  (t == 4 && st == 5) ? km_tpl_4_5();
  (t == 4 && st == 6) ? km_tpl_4_6();
  (t == 5 && st == 0) ? km_tpl_5_0();
  (t == 5 && st == 1) ? km_tpl_5_1();
  (t == 5 && st == 2) ? km_tpl_5_2();
  (t == 5 && st == 5) ? km_tpl_5_5();
  (t == 5 && st == 6) ? km_tpl_5_6();
  (t == 6 && st == 0) ? km_tpl_6_0();
  (t == 6 && st == 1) ? km_tpl_6_1();
  (t == 6 && st == 4) ? km_tpl_6_4();
  (t == 6 && st == 5) ? km_tpl_6_5();
  (t == 6 && st == 6) ? km_tpl_6_6();
  (t == 7 && st == 0) ? km_tpl_7_0();
  (t == 7 && st == 1) ? km_tpl_7_1();
  (t == 7 && st == 3) ? km_tpl_7_3();
  (t == 7 && st == 4) ? km_tpl_7_4();
  (t == 7 && st == 5) ? km_tpl_7_5();
  (t == 8 && st == 0) ? km_tpl_8_0();
  (t == 8 && st == 4) ? km_tpl_8_4();
  (t == 8 && st == 5) ? km_tpl_8_5();
  (t == 8 && st == 6) ? km_tpl_8_6();
  (t == 9 && st == 0) ? km_tpl_9_0();
  (t == 9 && st == 4) ? km_tpl_9_4();
  (t == 10 && st == 0) ? km_tpl_10_0();
  (t == 10 && st == 1) ? km_tpl_10_1();
  (t == 10 && st == 3) ? km_tpl_10_3();
  (t == 10 && st == 4) ? km_tpl_10_4();
  (t == 11 && st == 0) ? km_tpl_11_0();
  (t == 11 && st == 3) ? km_tpl_11_3();
  (t == 11 && st == 5) ? km_tpl_11_5();
  (t == 11 && st == 6) ? km_tpl_11_6();
  (t == 12 && st == 0) ? km_tpl_12_0();
  (t == 12 && st == 2) ? km_tpl_12_2();
  (t == 12 && st == 4) ? km_tpl_12_4();
  (t == 13 && st == 0) ? km_tpl_13_0();
  (t == 14 && st == 0) ? km_tpl_14_0();
);
// Vorlage t (Stil st) ins Arrangement laden (Klasse vorher setzen: km_cls, km_limInit). Auswahl danach auf Segment 0.
function km_loadTemplate(t, st) (
  km_tgt = M_SEG;  km_tcls = km_cls;
  km_template(t, st);
  km_nseg = km_tn;
  km_sel = 0;  km_selQ = 0 - 1;      // Codex-Review 0.8.0 (5): neue Vorlage -> vorgemerkte Abschnittswahl verwerfen
  km_commit();
);
// Werks-Preset n: Klasse und Vorlage (im Stil des Presets) laden (Regler setzt km_slFactory)
function km_loadFactoryData(n) local(p, k) (
  p = M_FAC + n*8;
  km_cls = p[0];
  km_limInit();
  km_loadTemplate(p[1], p[6]);
  k = 0;  loop(KM_NL, M_OVR[k] = 0 - 1;  k += 1; );
);
// Werks-Presets: Name, Klasse, Vorlage, Intensitaet %, Glaettung %, Rate-Index, Wiederholen, Stil. Aufruf NACH tt_pb_init (das loescht die Namen).
