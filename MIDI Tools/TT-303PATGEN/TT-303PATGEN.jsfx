    );
    gfx_set(1, 1, 1, 0.5); gfx_rect(svx, svy, svw, svh, 0);
    // Fadenkreuz auf dem SV-Feld
    cxr = svx + tth_cs*svw; syy = svy + (1 - tth_cv)*svh;
    gfx_set(0, 0, 0, 0.8); gfx_rect(cxr - 1, syy - 4, 3, 8, 1); gfx_rect(cxr - 4, syy - 1, 8, 3, 1);
    gfx_set(1, 1, 1, 0.9); gfx_rect(cxr - 0.5, syy - 3, 1, 6, 1); gfx_rect(cxr - 3, syy - 0.5, 6, 1, 1);
    // Farbton-Leiste: 24 Streifen
    i = 0;
    loop(24,
      tth_hsv(i/24, 1, 1);
      gfx_set(tth_hr, tth_hg, tth_hb, 1);
      gfx_rect(hxx, svy + i*svh/24, 16*sc, svh/24 + 1, 1);
      i += 1;
    );
    gfx_set(1, 1, 1, 0.5); gfx_rect(hxx, svy, 16*sc, svh, 0);
    gfx_set(1, 1, 1, 0.9); gfx_rect(hxx - 1, svy + tth_ch*svh - 1, 16*sc + 2, 2, 1);
    // rechte Spalte: RESET je Ziel + RESET ALL + Warnhinweis
    cxr = hxx + 22*sc;
    tth_sbtn(cxr, svy, 84*sc, 15*sc, "RESET", tth_inbox(cxr, svy, 84*sc, 15*sc), 0);
    (click && tth_inbox(cxr, svy, 84*sc, 15*sc)) ? ( tth_reset_tgt(); tth_tgtcol(); tth_rgb2hsv(tth_tr,tth_tg,tth_tb); );
    tth_hint(cxr,svy,84*sc,15*sc,"Restore the selected title, text or background colour to its scheme default.");
    tth_sbtn(cxr, svy + 19*sc, 84*sc, 15*sc, "RESET ALL", tth_inbox(cxr, svy + 19*sc, 84*sc, 15*sc), 0);
    tth_hint(cxr,svy+19*sc,84*sc,15*sc,"Restore both font sizes and all custom colours to their scheme defaults.");
    (click && tth_inbox(cxr, svy + 19*sc, 84*sc, 15*sc)) ? (
      tth_f1on = 0; tth_f2on = 0; tth_bgon = 0; tth_f1sz = 0; tth_f2sz = 0; tth_apply(tth_cur);
      tth_tgtcol(); tth_rgb2hsv(tth_tr,tth_tg,tth_tb);
    );
    warn = 0;
    (tth_f1on && tth_cr(tth_f1R, tth_f1G, tth_f1B, tth_bgR, tth_bgG, tth_bgB) < 3) ? ( warn = 1; );
    (tth_f2on && tth_cr(tth_f2R, tth_f2G, tth_f2B, tth_bgR, tth_bgG, tth_bgB) < 3) ? ( warn = 1; );
    warn ? (
      gfx_set(tth_alR, tth_alG, tth_alB, 1);
      gfx_x = cxr; gfx_y = svy + 42*sc; gfx_drawstr("low contrast");
      gfx_x = cxr; gfx_y = svy + 53*sc; gfx_drawstr("vs background");
    );
    // Fusszeile: Schema-Name (Zweitfarbe) + "per instance" (gedimmt)
    hov < 0 ? ( hov = tth_cur; );
    gfx_set(tth_alR, tth_alG, tth_alB, 1); gfx_x = x0 + 12*sc; gfx_y = y0 + ph - 16*sc;
    gfx_drawstr(tth_name(hov));
    gfx_set(tth_dmR, tth_dmG, tth_dmB, 1); gfx_measurestr("per instance", tw, th);
    gfx_x = x0 + pw - tw - 12*sc; gfx_y = y0 + ph - 16*sc; gfx_drawstr("per instance");
    chosen >= 0 ? ( tth_apply(chosen); tth_tgtcol(); tth_rgb2hsv(tth_tr,tth_tg,tth_tb); );
  );
  !(tth_rcap & 1) ? ( tth_cdrag = 0; );
  // P25: Stil in der Box geaendert (TOOLTIPS, Schriftgroessen, eigene Farben) -> Undo-Punkt. Nur bei offener Box UND
  // Maustaste (jetzt oder im Vorframe): ein Projekt-Laden/Undo aendert die Werte ohne Klick und darf keinen neuen Punkt setzen.
  !tth_open ? tth_edit = 0;
  tth_oprev=tth_open; tth_cscheme=tth_cur;
  tth_stsum = 149*tth_uisize + 151*tth_ctgt + tth_tipoff + 157*tth_autooff + 3*tth_f1sz + 7*tth_f2sz + 11*tth_f1on + 13*tth_f2on + 17*tth_bgon
    + 101*tth_f1R + 103*tth_f1G + 107*tth_f1B + 109*tth_f2R + 113*tth_f2G + 127*tth_f2B + 131*tth_bgUR + 137*tth_bgUG + 139*tth_bgUB;
  // 10.10.2026: eine automatische Anpassung an die Fenstergroesse ist keine Bearbeitung - kein Undo-Punkt.
  tth_fitchg ? ( tth_stprev = tth_stsum; tth_fitchg = 0; );
  tth_stsum != tth_stprev ? (
    (tth_stini && tth_open && ((tth_rcap0 | tth_pcap) & 1)) ? tt_undo();
    tth_stprev = tth_stsum; tth_stini = 1;
  );
  tth_pcap = tth_rcap0;      // P25: rohe Taste (tth_rcap ist bei offenem Preset-Overlay genullt)
  (tt_undoreq && (tth_rcap0 & 1) == 0) ? ( tt_undoreq = 0; sliderchange(-1); );      // P25: Undo-Punkt fuer Zustand ohne Slider
  chosen;
);
// ==========================  Ende TT-Theme  ============================
// __THEME_END__
// __PRESETS_BEGIN__   // generiert aus _shared/tt-presets.jsfx-inc
// ==========================  TT-Presets (TTPB_VER 4)  ==================
// Einheitliche Preset-Leiste (Werks-Presets + Anwender-Bank mit 32 Slots) fuer alle TT-Plugins.
// Die Leiste sitzt in der Kopfzeile unmittelbar LINKS neben dem OPTIONS-Button des Theme-Moduls:
//   [<] [ Preset-Name  v ] [>] [SAVE] [...]
// Voraussetzung: Theme-Modul (tt-theme.jsfx-inc) steht davor (Globals accR/G/B, tth_*, tth_pre/tth_post).
// Das Modul braucht KEIN UI-Kit (nur rohe gfx_*-Aufrufe), Schrift-Slot 11 (Theme nutzt 10, Produkte 1..5 und 9).
// JSFX kann keine Dateien schreiben: die Anwender-Bank liegt im Zustand des Plugins (@serialize = Projekt, FX-Kette,
// Track-Template UND jede native REAPER-Presetdatei des Plugins).
// Aufgabenteilung ohne Callbacks: das Modul liefert Speicher, Namen, Oberflaeche, Serialisierung und Aktionscodes;
// das Plugin liest seinen Zustand aus / wendet ihn an (es kennt Slider, Speicherbloecke und Resync-Wege).
// Einbindung (Codeschablone: _shared/PRESETS.md):
//   @init      : tt_pb_init(nFactory, 32, memBase, wordsPerSlot);  tt_pb_fname(i, "Name"); ...   // NACH den Modul-Definitionen
//   @gfx       : tth_pre();  tt_pb_pre();  ...  uikit_begin ... Front ...
//                a = tt_pb_post(px, py, sc);   // vor tth_post; px/py = linke obere Ecke der Leiste (Fensterpixel), Breite tt_pb_w(sc)
//                Aktion a: 0 nichts | 1 LOAD_FACTORY (Index tt_pb_arg) | 2 LOAD_USER (Slot tt_pb_arg) | 3 SAVE (Slot tt_pb_arg) | 4 INIT
//                tt_pb_track(pruefsumme);      // nach dem Anwenden, jeden Frame: setzt tt_pb_mod (Stern "*")
//   @serialize : ...eigene Daten...;  tt_pb_serialize();   // ZULETZT, Lesen und Schreiben
// Globals (Praefix tt_pb_ / TTPB_): tt_pb_buf = Zwischenpuffer (wordsPerSlot Worte), tt_pb_arg, tt_pb_cur/tt_pb_curKind
// (0 keins, 1 Werks, 2 Anwender; wird serialisiert), tt_pb_mod, tt_pb_open (Overlay offen), tt_pb_hasinit.
// Speicherbedarf ab memBase: nUser + (nFactory+nUser)*25 + (nUser+1)*wordsPerSlot + 25 Worte (tt_pb_end = erste freie Adresse).
TTPB_VER   = 4;        // v2 (P20): Stil-Block (Schrift-Stufen, eigene Farben FONT1/FONT2/BG) am Chunk-Ende; v4 (10.10.2026): Stil-Block-Version 4 (+ tth_autooff)
TTPB_MAGIC = 21584;    // 0x5450, klein gewaehlt: float32-exakt, Vergleich toleranzbehaftet
TTPB_MAG2  = 22032;    // "TTS" Stil-Block: Marker + Version + 14 Werte (s. tt_pb_serialize)
TTPB_MAG3  = 22288;    // 1.5.1 (B3): Stern-Block hinter dem Stil-Block: Marker + Version 1 + Merker "geaendert" (tt_pb_stk)
TTPB_FONT  = 11;       // Schrift-Slot
TTPB_NW    = 25;       // Worte je Namensfeld (24 Zeichen + Endnull)
TTPB_NMAX  = 24;       // Zeichen je Name
TTPB_ROWS  = 14;       // sichtbare Zeilen im Dropdown
// Zustandsvariablen bewusst NICHT auf Top-Level initialisiert (ein erneutes @init - z. B. bei Transportstart - darf ein offenes
// Overlay nicht schliessen); Vorbelegung nur beim ersten Mal in tt_pb_init.
// Speicher anlegen. Nur beim ersten Mal loeschen: ein erneutes @init (Samplerate, Transportstart) behaelt Bank und Auswahl.
function tt_pb_init(nf, nu, base, wps) (
  tt_pb_nfac = nf; tt_pb_nusr = max(1, min(64, nu)); tt_pb_wps = wps; tt_pb_hf = nf > 0 ? 1 : 0;
  tt_pb_used  = base;                                     // nUser Worte: 1 = Slot belegt
  tt_pb_names = tt_pb_used + tt_pb_nusr;                  // (nFactory + nUser) * 25 Worte, Zeichen als Worte
  tt_pb_data  = tt_pb_names + (nf + tt_pb_nusr)*TTPB_NW;  // nUser * wps Worte
  tt_pb_buf   = tt_pb_data + tt_pb_nusr*wps;              // wps Worte: Zwischenpuffer Plugin <-> Slot
  tt_pb_ebuf  = tt_pb_buf + wps;                          // 25 Worte: Namens-Editierpuffer (= "pending" Name fuer commit)
  tt_pb_end   = tt_pb_ebuf + TTPB_NW;
  tt_pb_ready != 1 ? (
    memset(base, 0, tt_pb_end - base);
    tt_pb_cur = -1; tt_pb_curKind = 0; tt_pb_elen = 0; tt_pb_ready = 1;
    tt_pb_hasinit = 1; tt_pb_open = 0; tt_pb_hold = 0; tt_pb_pcap = 0; tt_pb_rmx = -10000; tt_pb_rmy = -10000; tt_pb_rcap = 0; tt_pb_rwh = 0; tt_pb_act = 1;
    tt_pb_bx = 0; tt_pb_by = 0; tt_pb_bw = 0; tt_pb_bh = 0; tt_pb_scr = 0; tt_pb_sbd = 0; tt_pb_frm = 0; tt_pb_msgt = 0; tt_pb_conf = 0;
    tt_pb_emode = 1; tt_pb_eslot = 0; tt_pb_mod = 0; tt_pb_reset = 1; tt_pb_chkok = 0; tt_pb_chk = 0; tt_pb_fsCur = 0;
  );
);

// Name k (0..nFactory-1 Werks, danach Anwender) aus einem String-Index in die Wortdarstellung schreiben
function tt_pb_setname(k, s) local(a, i, n) (
  a = tt_pb_names + k*TTPB_NW;
  n = min(strlen(s), TTPB_NMAX);
  memset(a, 0, TTPB_NW);
  i = 0;
  loop(n, a[i] = str_getchar(s, i); i += 1; );
);

function tt_pb_fname(i, s) ( i >= 0 && i < tt_pb_nfac ? tt_pb_setname(i, s); );

// Wortdarstellung (Zeichen als Worte, Endnull) ab Adresse a -> #tt_pb_s
function tt_pb_wstr(a) local(i, c) (
  strcpy(#tt_pb_s, "");
  i = 0; c = a[0];
  while (c > 0 && i < TTPB_NMAX) (
    sprintf(#tt_pb_t, "%c", c); strcat(#tt_pb_s, #tt_pb_t);
    i += 1; c = a[i];
  );
);

// Name k (0..nFactory-1 Werks, danach Anwender) -> #tt_pb_s
function tt_pb_getname(k) ( tt_pb_wstr(tt_pb_names + k*TTPB_NW); );

// Anzahl belegter Anwender-Slots / erster freier Slot (-1 = keiner)
function tt_pb_count() local(j, n) ( n = 0; j = 0; loop(tt_pb_nusr, tt_pb_used[j] > 0 ? n += 1; j += 1; ); n; );
function tt_pb_free() local(j, r) ( r = -1; j = 0; loop(tt_pb_nusr, (r < 0 && tt_pb_used[j] <= 0) ? r = j; j += 1; ); r; );

// Auf 24 signifikante Bit runden = float32-exakt (die Serialisierung schreibt float32)
function tt_pb_q(v) local(e, st) (
  (v === 0 || abs(v) > 1000000000000000000000000000) ? v : (
    e = floor(log(abs(v))/log(2));
    st = 2^(e - 23);
    floor(v/st + 0.5)*st;
  );
);

// Pending-Name (tt_pb_ebuf) aus einem String setzen
function tt_pb_setpend(s) local(i, n) (
  n = min(strlen(s), TTPB_NMAX);
  memset(tt_pb_ebuf, 0, TTPB_NW);
  i = 0;
  loop(n, tt_pb_ebuf[i] = str_getchar(s, i); i += 1; );
  tt_pb_elen = n;
);

// Name eines Slots/Werks-Presets in den Editierpuffer holen
function tt_pb_loadpend(k) local(a) (
  a = tt_pb_names + k*TTPB_NW;
  memcpy(tt_pb_ebuf, a, TTPB_NW);
  tt_pb_elen = 0;
  while (tt_pb_ebuf[tt_pb_elen] > 0 && tt_pb_elen < TTPB_NMAX) ( tt_pb_elen += 1; );
);

// Slot -> Puffer; liefert Wortzahl (0 = leer)
function tt_pb_fetch(slot) local(n) (
  memset(tt_pb_buf, 0, tt_pb_wps);
  n = 0;
  (slot >= 0 && slot < tt_pb_nusr && tt_pb_used[slot] > 0) ? (
    memcpy(tt_pb_buf, tt_pb_data + slot*tt_pb_wps, tt_pb_wps);
    n = tt_pb_wps;
  );
  n;
);

// Puffer (vom Plugin gefuellt, n Worte, Rest wird mit 0 aufgefuellt) -> Slot; Name = Pending-Name (tt_pb_ebuf)
function tt_pb_commit(slot, n) local(a, i) (
  (slot >= 0 && slot < tt_pb_nusr) ? (
    n = max(0, min(n, tt_pb_wps));
    a = tt_pb_data + slot*tt_pb_wps;
    memset(a, 0, tt_pb_wps);
    i = 0;
    loop(n, a[i] = tt_pb_q(tt_pb_buf[i]); i += 1; );
    memcpy(tt_pb_names + (tt_pb_nfac + slot)*TTPB_NW, tt_pb_ebuf, TTPB_NW);
    tt_pb_used[slot] = 1; tt_undo();      // P25: SAVE -> Undo-Punkt (das Produkt muss nichts weiter melden)
    tt_pb_cur = slot; tt_pb_curKind = 2; tt_pb_reset = 1;
  );
);

// Vorgabename "User NN" fuer einen Slot -> Pending-Name
function tt_pb_defname(slot) (
  sprintf(#tt_pb_s, "User %02d", slot + 1);
  tt_pb_setpend(#tt_pb_s);
);

// Nachweis "gleicher Zustand": Plugin ruft jeden Frame mit einer Pruefsumme seines Zustands auf (nach dem Anwenden).
// Nach Laden/Speichern/Init (tt_pb_reset) und nach dem Lesen aus dem Projekt (tt_pb_chkok = 0) wird die Referenz neu genommen.
// 1.5.1 (B3): Nach dem Lesen (Projekt oeffnen, Strg+Z) wird die Referenz zwar neu genommen, aber ein im Chunk gespeicherter Stern
// (tt_pb_stk) bleibt bis zum naechsten Laden/Speichern/INIT stehen (tt_pb_reset). Historie: nur die zweite Zeile ohne "|| tt_pb_stk".
function tt_pb_track(s) (
  tt_pb_reset ? tt_pb_stk = 0;
  (tt_pb_chkok == 0 || tt_pb_reset) ? ( tt_pb_chk = s; tt_pb_chkok = 1; tt_pb_reset = 0; );
  tt_pb_mod = (tt_pb_curKind > 0 && (tt_pb_stk || s != tt_pb_chk)) ? 1 : 0;
);

// Auswahl (kind 1 Werks / 2 Anwender, Index i) -> Aktionscode
function tt_pb_select(kind, i) (
  tt_pb_curKind = kind; tt_pb_cur = i; tt_pb_arg = i; tt_pb_reset = 1;
  kind;
);

// Nachbar in Richtung dir (+1/-1): Werks-Presets, dann belegte Anwender-Slots, mit Umlauf; liefert Aktionscode (0 = keins)
function tt_pb_step(dir) local(p, tot, tries, found, r) (
  tot = tt_pb_nfac + tt_pb_nusr;
  p = tt_pb_curKind == 1 ? tt_pb_cur : tt_pb_curKind == 2 ? tt_pb_nfac + tt_pb_cur : (dir > 0 ? -1 : tot);
  found = 0; tries = 0; r = 0;
  while (!found && tries < tot) (
    p += dir;
    p = (p + tot) % tot;
    found = (p < tt_pb_nfac) || (tt_pb_used[max(0, p - tt_pb_nfac)] > 0);
    tries += 1;
  );
  found ? ( r = p < tt_pb_nfac ? tt_pb_select(1, p) : tt_pb_select(2, p - tt_pb_nfac); );
  r;
);

function tt_pb_in(x, y, w, h) ( tt_pb_rmx >= x && tt_pb_rmx < x + w && tt_pb_rmy >= y && tt_pb_rmy < y + h; );

// Breite der Leiste in Designeinheiten: tt_pb_wu (Vorgabe 250; kleine Fenster setzen z. B. tt_pb_wu = 190 im @init)
tt_pb_wu == 0 ? ( tt_pb_wu = 250; );
function tt_pb_w(sc) ( tt_pb_wu*max(0.25, sc); );

// Schrift setzen (Slot 11, Arial), nur bei Groessenwechsel neu anlegen
function tt_pb_font(sz) (
  tt_pb_fsCur != sz ? ( gfx_setfont(TTPB_FONT, "Arial", sz); tt_pb_fsCur = sz; ) : gfx_setfont(TTPB_FONT);
);

// Text (#tt_pb_s) in ein Rechteck: align 0 = zentriert, sonst linksbuendig
function tt_pb_txt(x, y, w, h, align) local(tw, th) (
  gfx_measurestr(#tt_pb_s, tw, th);
  gfx_x = align ? x : x + (w - tw)*0.5;
  gfx_y = y + (h - th)*0.5;
  tth_txt(); gfx_drawstr(#tt_pb_s);
);

// #tt_pb_s auf Breite w kuerzen (".." am Ende)
function tt_pb_fit(w) local(tw, th, n, n0) (
  gfx_measurestr(#tt_pb_s, tw, th);
  n0 = strlen(#tt_pb_s); n = n0;
  while (tw > w && n > 2) (
    n -= 1;
    strcpy_substr(#tt_pb_s2, #tt_pb_s, 0, n); strcat(#tt_pb_s2, "..");
    gfx_measurestr(#tt_pb_s2, tw, th);
  );
  n < n0 ? strcpy(#tt_pb_s, #tt_pb_s2);
);

// Knopfgrund: Panel + Rahmen; setzt danach die Textfarbe
function tt_pb_btn(x, y, w, h, hot, on) (
  gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(x, y, w, h, 1);
  (hot || on) ? gfx_set(accR, accG, accB, 0.95) : gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  gfx_rect(x, y, w, h, 0);
  gfx_set(accR, accG, accB, (hot || on) ? 1 : 0.8);
);

// Overlay-Grund (Schatten, Flaeche, Rahmen)
function tt_pb_ovl(x, y, w, h, sc) (
  gfx_set(0, 0, 0, 0.45); gfx_rect(x + 4*sc, y + 5*sc, w, h, 1);
  gfx_set(tth_bgR*1.25, tth_bgG*1.25, tth_bgB*1.25, 1); gfx_rect(x, y, w, h, 1);
  gfx_set(accR, accG, accB, 0.9); gfx_rect(x, y, w, h, 0);
);

// Zeile r des Dropdowns -> tt_pb_rk (0 Kopf, 1 Werks, 2 Anwender), tt_pb_ri (Index bzw. Kopf 0 = FACTORY, 1 = USER)
function tt_pb_rowinfo(r) (
  r < tt_pb_hf ? ( tt_pb_rk = 0; tt_pb_ri = 0; )
  : r < tt_pb_hf + tt_pb_nfac ? ( tt_pb_rk = 1; tt_pb_ri = r - tt_pb_hf; )
  : r == tt_pb_hf + tt_pb_nfac ? ( tt_pb_rk = 0; tt_pb_ri = 1; )
  : ( tt_pb_rk = 2; tt_pb_ri = r - tt_pb_hf - tt_pb_nfac - 1; );
);

// Dropdown (Overlay). Zeichnet und wertet aus; liefert Aktionscode. x/y = linke untere Ecke der Leiste, w = Breite.
function tt_pb_dropdown(x, y, w, sc, click) local(rh, nr, vis, room, h, x0, y0, r, rr, hov, sbw, sbx, th0, thh, a, ry, lw, cr, hot) (
  a = 0;
  rh = 16*sc; nr = tt_pb_hf + tt_pb_nfac + 1 + tt_pb_nusr;
  room = gfx_h - (y + 2*sc) - 6;
  vis = max(3, min(TTPB_ROWS, min(nr, floor((room - 4*sc)/rh))));
  h = vis*rh + 4*sc;
  x0 = max(4, min(x, gfx_w - w - 4)); y0 = y + 2*sc;
  sbw = 7*sc; sbx = x0 + w - sbw - 2*sc; lw = w - sbw - 4*sc;
  tt_pb_scr = max(0, min(nr - vis, tt_pb_scr));
  hot = tt_pb_in(x0, y0, w, h);
  (hot && tt_pb_rwh != 0) ? ( tt_pb_scr = max(0, min(nr - vis, tt_pb_scr - (tt_pb_rwh > 0 ? 3 : -3))); );
  // Zeile unter dem Zeiger
  hov = -1;
  ry = y0 + 2*sc;
  (hot && tt_pb_rmx < sbx - 2*sc && tt_pb_rmy >= ry) ? (
    r = floor((tt_pb_rmy - ry)/rh);
    r < vis ? ( hov = tt_pb_scr + r; );
  );
  // Scrollbalken ziehen
  (tt_pb_sbd && (tt_pb_rcap & 1)) ? (
    tt_pb_scr = max(0, min(nr - vis, floor((tt_pb_rmy - y0)/h*(nr - vis + 1))));
  ) : ( tt_pb_sbd = 0; );
  click ? (
    hot ? (
      hov >= 0 ? (
        tt_pb_rowinfo(hov);
        (tt_pb_rk == 1) ? ( a = tt_pb_select(1, tt_pb_ri); tt_pb_open = 0; )
        : (tt_pb_rk == 2 && tt_pb_used[tt_pb_ri] > 0) ? ( a = tt_pb_select(2, tt_pb_ri); tt_pb_open = 0; );
      ) : ( tt_pb_rmx >= sbx - 2*sc && nr > vis ? ( tt_pb_sbd = 1; tt_pb_scr = max(0, min(nr - vis, floor((tt_pb_rmy - y0)/h*(nr - vis + 1)))); ); );
    ) : ( tt_pb_open = 0; );
  );
  tt_pb_open == 1 ? (
    // Review 11.10.2026: Tooltip-Kennung des Dropdowns (1 Werks-Preset, 2 belegter Slot, 3 leerer Slot, 4 Scrollbalken); gezeichnet in tt_pb_post
    tt_pb_hv = 0;
    hov >= 0 ? ( tt_pb_rowinfo(hov); tt_pb_hv = tt_pb_rk == 1 ? 1 : tt_pb_rk == 2 ? (tt_pb_used[tt_pb_ri] > 0 ? 2 : 3) : 0; )
    : (hot && nr > vis && tt_pb_rmx >= sbx - 2*sc) ? ( tt_pb_hv = 4; );
    tt_pb_ovl(x0, y0, w, h, sc);
    cr = tt_pb_curKind == 1 ? tt_pb_hf + tt_pb_cur : tt_pb_curKind == 2 ? tt_pb_hf + tt_pb_nfac + 1 + tt_pb_cur : -1;
    r = 0;
    loop(vis,
      rr = tt_pb_scr + r;
      tt_pb_rowinfo(rr);
      ry = y0 + 2*sc + r*rh;
      tt_pb_rk == 0 ? (
        gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(x0 + 1, ry, w - 2, rh, 1);
        gfx_set(tth_dmR, tth_dmG, tth_dmB, 1);
        strcpy(#tt_pb_s, tt_pb_ri == 0 ? "FACTORY" : "USER");
        tt_pb_txt(x0 + 8*sc, ry, lw, rh, 1);
      ) : (
        tt_pb_rk == 1 ? ( tt_pb_getname(tt_pb_ri); sprintf(#tt_pb_s2, "%s", #tt_pb_s); )
        : ( tt_pb_getname(tt_pb_nfac + tt_pb_ri); sprintf(#tt_pb_s2, "%02d  %s", tt_pb_ri + 1, #tt_pb_s); );
        strcpy(#tt_pb_s, #tt_pb_s2);
        (tt_pb_rk == 2 && tt_pb_used[tt_pb_ri] <= 0) ? ( sprintf(#tt_pb_s, "%02d  - empty -", tt_pb_ri + 1); );
        tt_pb_fit(lw - 14*sc);
        rr == hov ? ( gfx_set(accR, accG, accB, 0.20); gfx_rect(x0 + 1, ry, w - 2, rh, 1); );
        rr == cr ? (
          gfx_set(accR, accG, accB, 0.16); gfx_rect(x0 + 1, ry, w - 2, rh, 1);
          gfx_set(accR, accG, accB, 1); gfx_rect(x0 + 1, ry, 3*sc, rh, 1);
        );
        (tt_pb_rk == 2 && tt_pb_used[tt_pb_ri] <= 0) ? gfx_set(tth_dmR, tth_dmG, tth_dmB, 1)
        : rr == cr ? gfx_set(accR, accG, accB, 1) : gfx_set(0.92, 0.95, 0.92, 1);
        tt_pb_txt(x0 + 12*sc, ry, lw, rh, 1);
      );
      r += 1;
    );
    // Scrollbalken
    nr > vis ? (
      gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(sbx, y0 + 2*sc, sbw, h - 4*sc, 1);
      thh = max(10*sc, (h - 4*sc)*vis/nr);
      th0 = y0 + 2*sc + ((h - 4*sc) - thh)*tt_pb_scr/max(1, nr - vis);
      gfx_set(accR, accG, accB, 0.7); gfx_rect(sbx, th0, sbw, thh, 1);
    );
  );
  a;
);

// 1.5.1 (B5): Mit want_all_kb sammeln sich Tasten in der gfx-Warteschlange; beim Oeffnen des Namensfelds werden sie verworfen
// (ein altes Enter beendete SAVE sofort ohne Speichern, alte Zeichen standen im Namen).
function tt_pb_kflush() local(c, n) ( c = gfx_getchar(); n = 0; while (c > 0 && n < 64) ( c = gfx_getchar(); n += 1; ); );

// Menue "..." (Overlay). x = rechte Kante der Leiste, y = Unterkante. Liefert Aktionscode (nur INIT = 4).
function tt_pb_menu(x, y, sc, click) local(rh, w, h, x0, y0, n, i, hov, a, en, item, ry, ok) (
  a = 0;
  rh = 17*sc; w = 116*sc; n = tt_pb_hasinit ? 4 : 3; h = n*rh + 4*sc;
  x0 = max(4, min(x - w, gfx_w - w - 4)); y0 = y + 2*sc;
  hov = -1;
  tt_pb_in(x0, y0, w, h) ? ( hov = floor((tt_pb_rmy - y0 - 2*sc)/rh); hov < 0 || hov >= n ? hov = -1; );
  ok = tt_pb_curKind == 2;   // RENAME / COPY / DELETE nur fuer Anwender-Presets
  click ? (
    hov >= 0 ? (
      hov == 0 && ok ? (           // RENAME
        tt_pb_emode = 2; tt_pb_eslot = tt_pb_cur; tt_pb_loadpend(tt_pb_nfac + tt_pb_cur); tt_pb_kflush(); tt_pb_open = 3; tt_pb_conf = 0;
      ) : hov == 1 && ok ? (       // COPY in den naechsten freien Slot
        i = tt_pb_free();
        i < 0 ? ( tt_pb_msgt = 90; strcpy(#tt_pb_msg, "BANK FULL"); ) : (
          memcpy(tt_pb_data + i*tt_pb_wps, tt_pb_data + tt_pb_cur*tt_pb_wps, tt_pb_wps);
          tt_pb_getname(tt_pb_nfac + tt_pb_cur);
          sprintf(#tt_pb_s2, "Copy of %s", #tt_pb_s); tt_pb_setpend(#tt_pb_s2);
          memcpy(tt_pb_names + (tt_pb_nfac + i)*TTPB_NW, tt_pb_ebuf, TTPB_NW);
          tt_pb_used[i] = 1; tt_undo();      // P25: Bank geaendert -> Undo-Punkt
          tt_pb_msgt = 90; sprintf(#tt_pb_msg, "COPIED TO %02d", i + 1);
        );
        tt_pb_open = 0; tt_pb_conf = 0;
      ) : hov == 2 && ok ? (       // DELETE (zweiter Klick bestaetigt)
        tt_pb_conf ? (
          tt_pb_used[tt_pb_cur] = 0; memset(tt_pb_names + (tt_pb_nfac + tt_pb_cur)*TTPB_NW, 0, TTPB_NW);
          memset(tt_pb_data + tt_pb_cur*tt_pb_wps, 0, tt_pb_wps); tt_undo();      // P25
          tt_pb_curKind = 0; tt_pb_cur = -1; tt_pb_reset = 1;
          tt_pb_open = 0; tt_pb_conf = 0;
        ) : ( tt_pb_conf = 1; );
      ) : (hov == 3 && tt_pb_hasinit) ? (   // INIT
        a = 4; tt_pb_curKind = 0; tt_pb_cur = -1; tt_pb_reset = 1; tt_pb_open = 0; tt_pb_conf = 0;
      );
    ) : ( !tt_pb_in(x0, y0, w, h) ? ( tt_pb_open = 0; tt_pb_conf = 0; ); );
  );
  tt_pb_open == 2 ? (
    // Review 11.10.2026: Tooltip-Kennung 10 + Zeile (+ 20 bei gesperrter Zeile, 15 = DELETE-Bestaetigung)
    tt_pb_hv = hov < 0 ? 0 : ((hov <= 2 && !ok) ? 20 + hov : (hov == 2 && tt_pb_conf) ? 15 : 10 + hov);
    tt_pb_ovl(x0, y0, w, h, sc);
    i = 0;
    loop(n,
      ry = y0 + 2*sc + i*rh;
      item = (i == 0 || i == 1 || i == 2) ? ok : 1;
      i == hov && item ? ( gfx_set(accR, accG, accB, 0.20); gfx_rect(x0 + 1, ry, w - 2, rh, 1); );
      item ? gfx_set(0.92, 0.95, 0.92, 1) : gfx_set(tth_dmR, tth_dmG, tth_dmB, 1);
      i == 2 && tt_pb_conf ? gfx_set(tth_alR, tth_alG, tth_alB, 1);
      strcpy(#tt_pb_s, i == 0 ? "RENAME" : i == 1 ? "COPY" : i == 2 ? (tt_pb_conf ? "CONFIRM DELETE?" : "DELETE") : "INIT");
      tt_pb_txt(x0 + 10*sc, ry, w, rh, 1);
      i += 1;
    );
  );
  a;
);

// Eine Taste im Namensfeld verarbeiten (Flags tt_pb_kdone / tt_pb_kcanc)
function tt_pb_key(c) (
  tt_pb_lk = c; tt_pb_nk += 1;                  // Diagnose: letzte Taste / Anzahl (Q-Kommando 19 im Plugin)
  c == 13 || c == 10 ? ( tt_pb_kdone = 1; )
  : c == 27 ? ( tt_pb_kcanc = 1; )
  : c == 8 ? ( tt_pb_elen > 0 ? ( tt_pb_elen -= 1; tt_pb_ebuf[tt_pb_elen] = 0; ); )
  : (c >= 32 && c < 127 && tt_pb_elen < TTPB_NMAX) ? ( tt_pb_ebuf[tt_pb_elen] = c; tt_pb_elen += 1; tt_pb_ebuf[tt_pb_elen] = 0; );
);

// Namenseingabe (Overlay). Tastatur ueber gfx_getchar. REAPER faengt Space (Transport) und - je nach Einstellung - Esc (Fenster schliessen)
// selbst ab: Leerzeichen per Shift+Space, Abbruch per CANCEL-Knopf oder Klick daneben. Liefert 3 (SAVE bestaetigt; Slot in tt_pb_arg, Name in tt_pb_ebuf).
function tt_pb_entry(x, y, sc, click) local(w, h, x0, y0, c, n, done, canc, bw, bh, okx, cx, tw, th, a, i, hokk, hcan, fy) (
  a = 0; done = 0; canc = 0;
  w = 250*sc; h = 90*sc; bh = 17*sc; bw = 56*sc;
  x0 = max(4, min(x, gfx_w - w - 4)); y0 = y + 2*sc;
  // Tastatur
  tt_pb_kdone = 0; tt_pb_kcanc = 0;
  c = gfx_getchar(); n = 0;
  while (c > 0 && n < 40) (
    tt_pb_key(c);
    c = gfx_getchar(); n += 1;
  );
  done = tt_pb_kdone; canc = tt_pb_kcanc;
  okx = x0 + w - 2*bw - 12*sc; fy = y0 + 67*sc;
  hokk = tt_pb_in(okx, fy, bw, bh); hcan = tt_pb_in(okx + bw + 4*sc, fy, bw, bh);
  click ? (
    hokk ? ( done = 1; ) : hcan ? ( canc = 1; ) : !tt_pb_in(x0, y0, w, h) ? ( canc = 1; );
  );
  done ? (
    tt_pb_elen < 1 ? ( sprintf(#tt_pb_s, "User %02d", tt_pb_eslot + 1); tt_pb_setpend(#tt_pb_s); );
    tt_pb_emode == 2 ? (
      memcpy(tt_pb_names + (tt_pb_nfac + tt_pb_eslot)*TTPB_NW, tt_pb_ebuf, TTPB_NW); tt_undo();      // P25
    ) : ( a = 3; tt_pb_arg = tt_pb_eslot; tt_pb_reset = 1; );
    tt_pb_open = 0;
  );
  canc ? ( tt_pb_open = 0; );
  tt_pb_open == 3 ? (
    // Review 11.10.2026: Tooltip-Kennung 30 OK, 31 CANCEL, 32 Textfeld, 33 Hinweiszeile
    tt_pb_hv = hokk ? 30 : hcan ? 31 : tt_pb_in(x0 + 8*sc, y0 + 26*sc, w - 16*sc, 17*sc) ? 32 : tt_pb_in(x0 + 10*sc, y0 + 46*sc, w - 20*sc, 16*sc) ? 33 : 0;
    tt_pb_ovl(x0, y0, w, h, sc);
    gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(x0 + 1, y0 + 1, w - 2, 20*sc, 1);
    gfx_set(0.92, 0.95, 0.92, 1);
    sprintf(#tt_pb_s, tt_pb_emode == 2 ? "RENAME PRESET  (slot %02d)" : "SAVE PRESET  (slot %02d)", tt_pb_eslot + 1);
    tt_pb_txt(x0 + 10*sc, y0 + 1, w, 20*sc, 1);
    // Textfeld
    gfx_set(tth_bgR, tth_bgG, tth_bgB, 1); gfx_rect(x0 + 8*sc, y0 + 26*sc, w - 16*sc, 17*sc, 1);
    gfx_set(accR, accG, accB, 0.8); gfx_rect(x0 + 8*sc, y0 + 26*sc, w - 16*sc, 17*sc, 0);
    tt_pb_wstr(tt_pb_ebuf);
    gfx_set(1, 1, 1, 1);
    tt_pb_txt(x0 + 12*sc, y0 + 26*sc, w, 17*sc, 1);
    gfx_measurestr(#tt_pb_s, tw, th);
    (floor(tt_pb_frm/15) & 1) == 0 ? ( gfx_set(accR, accG, accB, 1); gfx_rect(x0 + 12*sc + tw + 1, y0 + 29*sc, max(1, sc), 11*sc, 1); );
    // Buttons + Hinweis
    gfx_set(tth_dmR, tth_dmG, tth_dmB, 1); strcpy(#tt_pb_s, "Enter = OK    Shift+Space = blank");
    tt_pb_txt(x0 + 10*sc, y0 + 46*sc, w, 16*sc, 1);
    tt_pb_btn(okx, fy, bw, bh, hokk, 0); strcpy(#tt_pb_s, "OK"); tt_pb_txt(okx, fy, bw, bh, 0);
    tt_pb_btn(okx + bw + 4*sc, fy, bw, bh, hcan, 0); strcpy(#tt_pb_s, "CANCEL"); tt_pb_txt(okx + bw + 4*sc, fy, bw, bh, 0);
  );
  a;
);

// Ende des Laufs gleicher Art (Nullen / Nicht-Nullen) ab i
function tt_pb_run(a, i, n) local(z, j) (
  z = a[i] === 0; j = i;   // Review 11.10.2026: exakter Vergleich, sonst werden Werte < ~1e-5 als Nullen gespeichert. Historie: a[i] == 0
  while (j < n && (a[j] === 0) == z) ( j += 1; );
  j;
);

// Lesen: ein Slot-Datensatz (RLE) in den Puffer, danach in Slot j uebernehmen. Liefert 1 = ok.
function tt_pb_rdone(j, sw) local(u, i, i0, k, ok) (
  u = 0; ok = 1;
  // Review zcode 17.10.2026: Chunk endet vor dem Slot-Wort (abgeschnitten) = Fehler (BANK DAMAGED) statt still leerer Slot. Historie: u = 0; file_var(0, u); ok = 1;
  file_avail(0) > 0 ? ( file_var(0, u); ) : ( ok = 0; );
  u > 0 && ok ? (
    ok = file_mem(0, tt_pb_ebuf, TTPB_NW) == TTPB_NW;   // Review 11.10.2026: Rueckgabe = gelesene Worte; abgeschnittene Datei = Fehler. Historie: file_mem(0, tt_pb_ebuf, TTPB_NW);
    memset(tt_pb_buf, 0, tt_pb_wps);
    i = 0;
    while (ok && i < sw) (
      k = 0; file_var(0, k);
      ok = (k < 0 && i - k <= sw) || (k > 0 && i + k <= sw);
      i0 = i; i += ok ? abs(k) : 0;
      (ok && k > 0) ? ( ok = file_mem(0, tt_pb_buf + i0, k) == k; );   // Review 11.10.2026. Historie: file_mem(0, tt_pb_buf + i0, k);
    );
    ok ? (
      memcpy(tt_pb_data + j*tt_pb_wps, tt_pb_buf, tt_pb_wps);
      memcpy(tt_pb_names + (tt_pb_nfac + j)*TTPB_NW, tt_pb_ebuf, TTPB_NW);
      tt_pb_used[j] = 1;
    );
  ) : (
    tt_pb_used[j] = 0;
    memset(tt_pb_names + (tt_pb_nfac + j)*TTPB_NW, 0, TTPB_NW);
    memset(tt_pb_data + j*tt_pb_wps, 0, tt_pb_wps);
  );
  ok;
);

// Schreiben: ein belegter Slot j (Name + RLE-Daten)
function tt_pb_wrone(j) local(u, a, i, i0, jj, k, z) (
  u = tt_pb_used[j] > 0 ? 1 : 0;
  file_var(0, u);
  u > 0 ? (
    file_mem(0, tt_pb_names + (tt_pb_nfac + j)*TTPB_NW, TTPB_NW);
    a = tt_pb_data + j*tt_pb_wps;
    i = 0;
    while (i < tt_pb_wps) (
      z = a[i] === 0;   // Review 11.10.2026 (exakt). Historie: a[i] == 0
      jj = tt_pb_run(a, i, tt_pb_wps);
      k = z ? i - jj : jj - i;
      file_var(0, k);
      i0 = i; i = jj;
      z == 0 ? file_mem(0, a + i0, k);
    );
  );
);

// Serialisierung (am ENDE des @serialize des Plugins aufrufen; Lesen und Schreiben)
// Format: MAGIC, VER, nUser, wps, cur, curKind, dann je Slot: used [, Name (25 Worte), Daten RLE-gepackt].
// RLE je Slot: Wort k < 0 = |k| Nullen; k > 0 = k Literalworte folgen.
// Lesen: fehlt der Block (altes Projekt) oder passt Magic/Version/nUser/wps nicht, bleibt die Bank unveraendert.
// P20 (v2): dahinter der Stil-Block TTPB_MAG2, Stilversion, 14 Werte (tth_f1sz/f2sz, f1on+f1RGB,
// f2on+f2RGB, bgon+bgURGB). Rueckwaertskompatibel: alte Chunks enden vor dem Block (file_avail = 0
// -> nichts gelesen), alte Modul-Staende lesen neue Chunks bis zum Bank-Ende und lassen den Rest liegen.
// Die Stil-Werte sind KEINE Preset-Leisten-Daten: sie gelten pro Instanz, nicht pro Preset.
function tt_pb_serialize() local(rd, m, ver, nu, sw, cu, ck, j, ok, m2, v2, m3, v3, mk, jj) (
  rd = file_avail(0) >= 0;
  jj = 0;
  rd ? tt_pb_stk = 0;      // 1.5.1 (B3): vor dem Lesen immer zurueck; nur ein gueltiger Stern-Block setzt ihn wieder
  rd ? (
    file_avail(0) > 0 ? (
      m = 0; file_var(0, m);
      abs(m - TTPB_MAGIC) < 256 ? (
        ver = 0; nu = 0; sw = 0; cu = 0; ck = 0;
        file_var(0, ver); file_var(0, nu); file_var(0, sw); file_var(0, cu); file_var(0, ck);
        (ver == 1 && nu >= 1 && nu <= tt_pb_nusr && sw >= 1 && sw <= tt_pb_wps) ? (   // P22: Alt-Chunk mit weniger Anwender-Slots bleibt ladbar (Rest = leer)
          // P24: Slots, die der Chunk nicht mitbringt (nu < tt_pb_nusr), ausdruecklich leeren - sonst blieben die
          // Presets der bisherigen Instanz in den hinteren Slots stehen.
          ok = 1; j = nu;
          loop(max(0, tt_pb_nusr - nu),
            tt_pb_used[j] = 0;
            memset(tt_pb_names + (tt_pb_nfac + j)*TTPB_NW, 0, TTPB_NW);
            memset(tt_pb_data + j*tt_pb_wps, 0, tt_pb_wps);
            j += 1;
          );
          j = 0;
          while (ok && j < nu) (
            ok = tt_pb_rdone(j, sw);
            j += 1;
          );
          // 1.5.1 (B4): scheitert Slot j beim Lesen, blieb vorher eine Mischung aus Chunk (0..j-1) und alter Bank stehen.
          // Jetzt wird der Rest (ab dem fehlerhaften Slot) geleert, die Auswahl entfernt und BANK DAMAGED gemeldet.
          !ok ? (
            jj = max(0, j - 1);
            loop(max(0, tt_pb_nusr - jj),
              tt_pb_used[jj] = 0;
              memset(tt_pb_names + (tt_pb_nfac + jj)*TTPB_NW, 0, TTPB_NW);
              memset(tt_pb_data + jj*tt_pb_wps, 0, tt_pb_wps);
              jj += 1;
            );
            tt_pb_curKind = 0; tt_pb_cur = -1; tt_pb_reset = 1;
            tt_pb_msgt = 90; strcpy(#tt_pb_msg, "BANK DAMAGED");
          );
          ok ? (
            tt_pb_curKind = (ck == 1 || ck == 2) ? floor(ck) : 0;
            tt_pb_cur = tt_pb_curKind == 1 ? (cu >= 0 && cu < tt_pb_nfac ? floor(cu) : -1)
                      : tt_pb_curKind == 2 ? (cu >= 0 && cu < tt_pb_nusr && tt_pb_used[floor(cu)] > 0 ? floor(cu) : -1) : -1;
            tt_pb_cur < 0 ? tt_pb_curKind = 0;
          );
          // P20 Stil-Block. Ein Chunk, der die Bank enthaelt, bestimmt den Stil vollstaendig:
          // erst auf Schema-Defaults zurueck, dann - nur wenn Daten folgen - den Block lesen.
          // Alt-Chunks (vor P20) enden nach der Bank -> Stil = Schema-Defaults.
          ok ? (
            tth_f1sz = 0; tth_f2sz = 0; tth_f1on = 0; tth_f2on = 0; tth_bgon = 0;
            tth_uisize = 125; tth_panx = 0; tth_pany = 0; tth_ctgt = 0;
            tth_tipoff = 0;                     // P23: Tooltips an (Vorgabe; Alt-Chunks kennen den Schalter nicht)
            tth_autooff = 0;                    // 10.10.2026: AUTO FIT an (Vorgabe; Chunks vor Stil-Block 4 kennen den Schalter nicht)
            file_avail(0) > 0 ? (
              m2 = 0; file_var(0, m2);
              abs(m2 - TTPB_MAG2) < 256 ? (
                v2 = 0; file_var(0, v2);
                // exakt v1: ein unbekannter Spaeter-Block wird nicht fehlinterpretiert
                // (der Zeiger bleibt dann stehen - der Stil-Block ist der letzte im Chunk,
                // beim naechsten Speichern wird er ohnehin neu geschrieben)
                (v2 == 1 || v2 == 2 || v2 == 3 || v2 == 4) ? (       // P23: v2 = v1 + ein Wert dahinter (tth_tipoff); 10.10.2026: v4 = v3 + tth_autooff (Historie: v2 == 1 || v2 == 2 || v2 == 3)
                  file_var(0, tth_f1sz); file_var(0, tth_f2sz);
                  file_var(0, tth_f1on); file_var(0, tth_f1R); file_var(0, tth_f1G); file_var(0, tth_f1B);
                  file_var(0, tth_f2on); file_var(0, tth_f2R); file_var(0, tth_f2G); file_var(0, tth_f2B);
                  file_var(0, tth_bgon); file_var(0, tth_bgUR); file_var(0, tth_bgUG); file_var(0, tth_bgUB);
                  tth_f1sz = max(-4, min(8, floor(tth_f1sz + 0.5)));
                  tth_f2sz = max(-4, min(8, floor(tth_f2sz + 0.5)));
                  tth_f1on = tth_f1on > 0.5; tth_f2on = tth_f2on > 0.5; tth_bgon = tth_bgon > 0.5;
                  v2 >= 2 ? ( file_var(0, tth_tipoff); tth_tipoff = tth_tipoff > 0.5; );
                  // Version 3: UI-Zoom, Scrollposition und Waehler-Ziel. v1/v2 bleiben lesbar.
                  v2 >= 3 ? (
                    file_var(0,tth_uisize); file_var(0,tth_panx); file_var(0,tth_pany); file_var(0,tth_ctgt);
                    // 10.10.2026: Untergrenze 25 (AUTO FIT); Historie: max(50, ...)
                    tth_uisize=max(25,min(400,floor(tth_uisize+0.5)));
                    tth_panx=max(0,tth_panx); tth_pany=max(0,tth_pany); tth_ctgt=max(0,min(2,floor(tth_ctgt+0.5)));
                  );
                  // Version 4 (10.10.2026): AUTO FIT-Schalter.
                  v2 >= 4 ? ( file_var(0, tth_autooff); tth_autooff = tth_autooff > 0.5; );
                  // 1.5.1 (B3): Stern-Block (alte Chunks enden vorher: file_avail = 0, der Stern bleibt aus)
                  file_avail(0) > 0 ? (
                    m3 = 0; file_var(0, m3);
                    abs(m3 - TTPB_MAG3) < 256 ? (
                      v3 = 0; mk = 0; file_var(0, v3); file_var(0, mk);
                      tt_pb_stk = (v3 == 1 && mk > 0.5) ? 1 : 0;
                    );
                  );
                  tth_edit=0; tth_cdrag=0; tth_sdrag=0; tth_stini=0;
                );
              );
            );
            // Schema (+ eigenen Grund) neu anwenden; tth_cur < 0 heisst noch nie synchronisiert
            // (FX noch nie gezeichnet) - dann uebernimmt das erste tth_sync das Slider-Schema.
            tth_cur >= 0 ? ( tth_apply(tth_cur); tth_tgtcol(); tth_rgb2hsv(tth_tr,tth_tg,tth_tb); );
          );
        );
      );
    );
    // 1.5.2 (Review S4 0.13.2, B1): ein noch ausstehendes tt_pb_reset (Laden/INIT im selben Frame) wuerde den eben
    // gelesenen Stern in tt_pb_track wieder loeschen; die Referenz wird ohnehin ueber tt_pb_chkok = 0 neu genommen.
    tt_pb_stk ? tt_pb_reset = 0;
    tt_pb_chkok = 0;
  ) : (
    m = TTPB_MAGIC; ver = 1; nu = tt_pb_nusr; sw = tt_pb_wps; cu = tt_pb_cur; ck = tt_pb_curKind;
    file_var(0, m); file_var(0, ver); file_var(0, nu); file_var(0, sw); file_var(0, cu); file_var(0, ck);
    j = 0;
    loop(tt_pb_nusr, tt_pb_wrone(j); j += 1; );
    // P20 Stil-Block anhaengen
    m2 = TTPB_MAG2; v2 = 4;                     // P23: Block-Version 2 (haengt tth_tipoff an); 10.10.2026: Version 4 (haengt tth_autooff an), Historie: v2 = 3
    file_var(0, m2); file_var(0, v2);
    file_var(0, tth_f1sz); file_var(0, tth_f2sz);
    file_var(0, tth_f1on); file_var(0, tth_f1R); file_var(0, tth_f1G); file_var(0, tth_f1B);
    file_var(0, tth_f2on); file_var(0, tth_f2R); file_var(0, tth_f2G); file_var(0, tth_f2B);
    file_var(0, tth_bgon); file_var(0, tth_bgUR); file_var(0, tth_bgUG); file_var(0, tth_bgUB);
    file_var(0, tth_tipoff);
    file_var(0,tth_uisize); file_var(0,tth_panx); file_var(0,tth_pany); file_var(0,tth_ctgt);
    file_var(0, tth_autooff);          // Stil-Block 4 (10.10.2026)
    // 1.5.1 (B3): Stern-Block (haengt hinter den Stil-Block; aeltere Leser lesen bis zum Stil-Ende und lassen den Rest liegen)
    m3 = TTPB_MAG3; v3 = 1; mk = (tt_pb_curKind > 0 && tt_pb_mod) ? 1 : 0;
    file_var(0, m3); file_var(0, v3); file_var(0, mk);
  );
);

// Am Anfang von @gfx (nach tth_pre): rohe Maus merken; solange ein Overlay offen ist (und danach bis zum Loslassen), sieht das
// Produkt keine Maus. Die Leiste selbst maskiert ebenfalls. Waehrend eines Overlays ist auch der OPTIONS-Button taub.
function tt_pb_pre() (
  tt_pb_rmx = tth_rmx; tt_pb_rmy = tth_rmy; tt_pb_rcap = tth_rcap; tt_pb_rwh = mouse_wheel;
  tt_pb_act = (tth_open || tth_hold) ? 0 : 1;
  // 1.5.1 (B1): liegt eine Scrollleiste oder der OPTIONS-Knopf (Druck begann dort) unter der Maus, sieht die Leiste keine Maus - sonst
  // loeste ein Klick auf OPTIONS (bei Scrollleisten ueber der Preset-Leiste) zusaetzlich < / > aus und lud ein Preset.
  (!tt_pb_open && (tth_shot || tth_sdrag || (tth_ib && !tth_dnout))) ? ( tt_pb_rmx = -10000; tt_pb_rmy = -10000; );
  !tt_pb_act ? ( tt_pb_open = 0; tt_pb_conf = 0; );
  tt_pb_open ? ( tt_pb_hold = 1; );
  (tt_pb_hold && (tt_pb_rcap & 1) == 0 && !tt_pb_open) ? ( tt_pb_hold = 0; );
  // P25: die Leiste maskiert nur, wenn der Druck NICHT ausserhalb begonnen hat (sonst brach ein Regler-Zug ueber
  // die Leiste ab und hinterliess beim Verlassen einen Phantomklick). tth_rcap0/tth_pcap = rohe Taste jetzt/Vorframe.
  tt_pb_ib = tt_pb_bw > 0 && tt_pb_in(tt_pb_bx, tt_pb_by, tt_pb_bw, tt_pb_bh);
  (tth_rcap0 & 1) == 0 ? ( tt_pb_dnout = 0; ) : ( !(tth_pcap & 1) ? ( tt_pb_dnout = !tt_pb_ib; ); );
  (tt_pb_open || tt_pb_hold || (tt_pb_ib && !tt_pb_dnout))
    ? ( mouse_cap = 0; mouse_x = -10000; mouse_y = -10000; mouse_wheel = 0; );
  (tt_pb_open || tt_pb_hold)
    ? ( tth_rcap = 0; tth_rmx = -10000; tth_rmy = -10000; );
);

// Review 11.10.2026: Tooltips der Preset-Overlays (Dropdown, Menue, Namenseingabe). Die Overlays zeichnen NACH tt_tipflush, das Kit
// erreicht sie nicht; deshalb eigene Zeichnung hier: Kennung tt_pb_hv (von den Overlays gesetzt), Verweilzeit 0.35 s wie im Kit,
// nicht waehrend eines Zugs, nichts bei tth_tipoff, nichts ausserhalb des Fensters. Historie: kein Tooltip in den Overlays.
function tt_pb_tipdraw(hv) local(t, tw, th, bw, bh, px, py, n, k, e, d1, d2) (
  hv = hv > 0 ? hv : 0;
  (tth_tipoff || (tt_pb_rcap & 1) || tt_pb_rmx < 0 || tt_pb_rmy < 0 || tt_pb_rmx >= gfx_w || tt_pb_rmy >= gfx_h) ? ( hv = 0; );
  hv != tt_pb_tid ? ( tt_pb_tid = hv; tt_pb_tt = time_precise(); );
  (hv > 0 && time_precise() - tt_pb_tt >= 0.35) ? (
    hv == 1 ? strcpy(#tt_pb_tip, "Load this factory preset.")
    : hv == 2 ? strcpy(#tt_pb_tip, "Load this user preset.")
    : hv == 3 ? strcpy(#tt_pb_tip, "Empty user slot - use SAVE to store a preset here.")
    : hv == 4 ? strcpy(#tt_pb_tip, "Drag to scroll the preset list (the mouse wheel works too).")
    : hv == 10 ? strcpy(#tt_pb_tip, "RENAME: change the name of the current user preset.")
    : hv == 11 ? strcpy(#tt_pb_tip, "COPY: duplicate the current user preset into the next free slot.")
    : hv == 12 ? strcpy(#tt_pb_tip, "DELETE: remove the current user preset (asks to confirm with a second click).")
    : hv == 15 ? strcpy(#tt_pb_tip, "Click again to delete the current user preset for good; click elsewhere to cancel.")
    : hv == 13 ? strcpy(#tt_pb_tip, "INIT: reset the plugin to its default state.")
    : hv >= 20 && hv < 23 ? strcpy(#tt_pb_tip, "Only available while a user preset is selected.")
    : hv == 30 ? strcpy(#tt_pb_tip, "OK: store the preset under this name (same as Enter).")
    : hv == 31 ? strcpy(#tt_pb_tip, "CANCEL: close without saving (a click outside the box does the same).")
    : hv == 32 ? strcpy(#tt_pb_tip, "Type the preset name (up to 24 characters; Shift+Space inserts a blank).")
    : hv == 33 ? strcpy(#tt_pb_tip, "Enter confirms the name; Shift+Space types a blank because REAPER keeps the plain space bar.")
    : strcpy(#tt_pb_tip, "");
    gfx_setfont(TTPB_FONT, "Arial", 12); tt_pb_fsCur = 12;
    n = strlen(#tt_pb_tip);
    gfx_measurestr(#tt_pb_tip, tw, th);
    d1 = 0;
    (n > 0 && tw + 14 > gfx_w - 4) ? (          // zu breit fuer das Fenster: an einem Leerzeichen nahe der Mitte in zwei Zeilen teilen
      k = floor(n/2); e = k;
      while (e > 4 && str_getchar(#tt_pb_tip, e) != 32) ( e -= 1; );
      e > 4 ? (
        strcpy_substr(#tt_pb_tip2, #tt_pb_tip, e + 1, n - e - 1);
        strcpy_substr(#tt_pb_tip, #tt_pb_tip, 0, e);
        d1 = 1;
      );
    );
    n > 0 ? (
      gfx_measurestr(#tt_pb_tip, tw, th);
      bw = tw; bh = th;
      d1 ? ( gfx_measurestr(#tt_pb_tip2, k, e); bw = max(bw, k); bh = th*2; );
      bw += 14; bh += 8;
      px = max(2, min(tt_pb_rmx + 14, gfx_w - bw - 2));
      py = max(2, min(tt_pb_rmy + 18, gfx_h - bh - 2));
      gfx_set(0, 0, 0, 0.40); gfx_rect(px + 2, py + 3, bw, bh, 1);
      gfx_set(0.030, 0.040, 0.030, 1); gfx_rect(px, py, bw, bh, 1);
      gfx_set(0.62, 1.0, 0.50, 1); gfx_roundrect(px, py, bw - 1, bh - 1, 2, 1);
      gfx_set(0.88, 1.0, 0.85, 1);
      gfx_x = px + 7; gfx_y = py + 4; gfx_drawstr(#tt_pb_tip);
      d1 ? ( gfx_x = px + 7; gfx_y = py + 4 + th; gfx_drawstr(#tt_pb_tip2); );
    );
  );
);

// Am Ende von @gfx (vor tth_post): Leiste + Overlays zeichnen. px/py = linke obere Ecke der Leiste in Fensterpixeln,
// sc = Skalierung. Rueckgabe: Aktionscode (siehe Kopf).
function tt_pb_post(px, py, sc)
  local(bh, aw, gp, sw, mw, nw, W, x1, x2, x3, x4, click, act, wasopen, hl, hn, hr, hs, hm, fs, a, b, kk, so) (
  sc = max(0.25, sc);   // Review 11.10.2026: Position (SC) und Groesse muessen denselben Massstab nutzen, sonst ueberlappen Leiste und OPTIONS bei AUTO FIT < 50 %. Historie: max(0.5, sc)
  a = 0;
  tt_pb_hv = 0;          // Review 11.10.2026: Tooltip-Kennung der Overlays (von Dropdown/Menue/Eingabe gesetzt)
  tt_pb_frm += 1;
  tt_pb_msgt > 0 ? tt_pb_msgt -= 1;
  bh = 17*sc; aw = 17*sc; gp = 2*sc; sw = 42*sc; mw = 24*sc; W = tt_pb_wu*sc;
  nw = W - 2*aw - sw - mw - 4*gp;
  x1 = px + aw + gp; x2 = x1 + nw + gp; x3 = x2 + aw + gp; x4 = x3 + sw + gp;
  tt_pb_bx = px; tt_pb_by = py; tt_pb_bw = W; tt_pb_bh = bh;
  tt_pb_e1 = x1; tt_pb_e2 = x2; tt_pb_e3 = x3; tt_pb_e4 = x4;      // P25: Elementgrenzen fuer tt_modtips (Kit)
  fs = max(9, floor(10*sc + 0.5));
  tt_pb_font(fs);
  gfx_mode = 0;
  click = tt_pb_act && (tt_pb_rcap & 1) && !(tt_pb_pcap & 1);
  wasopen = tt_pb_open;
  // Overlays (zeichnen zuletzt; Auswertung zuerst, damit ein Klick nur einmal zaehlt)
  // Leiste: Klicks (nur wenn kein Overlay offen war)
  hl = tt_pb_act && !wasopen && tt_pb_in(px, py, aw, bh);
  hn = tt_pb_act && !wasopen && tt_pb_in(x1, py, nw, bh);
  hr = tt_pb_act && !wasopen && tt_pb_in(x2, py, aw, bh);
  hs = tt_pb_act && !wasopen && tt_pb_in(x3, py, sw, bh);
  hm = tt_pb_act && !wasopen && tt_pb_in(x4, py, mw, bh);
  (click && !wasopen) ? (
    hl ? ( a = tt_pb_step(-1); )
    : hr ? ( a = tt_pb_step(1); )
    : hn ? (
        tt_pb_open = 1; tt_pb_scr = 0;
        tt_pb_curKind == 1 ? ( tt_pb_scr = max(0, tt_pb_hf + tt_pb_cur - 5); )
        : tt_pb_curKind == 2 ? ( tt_pb_scr = max(0, tt_pb_hf + tt_pb_nfac + 1 + tt_pb_cur - 5); );
      )
    : hs ? (
        // SAVE: aktueller Anwender-Slot, sonst erster freier
        kk = tt_pb_curKind == 2 ? tt_pb_cur : tt_pb_free();
        kk < 0 ? ( tt_pb_msgt = 90; strcpy(#tt_pb_msg, "BANK FULL - DELETE A SLOT"); ) : (
          tt_pb_emode = 1; tt_pb_eslot = kk;
          tt_pb_curKind == 2 ? tt_pb_loadpend(tt_pb_nfac + kk) : tt_pb_defname(kk);
          tt_pb_kflush();
          tt_pb_open = 3;
        );
      )
    : hm ? ( tt_pb_open = 2; tt_pb_conf = 0; );
  );
  // --- Leiste zeichnen
  tt_pb_btn(px, py, aw, bh, hl, 0); strcpy(#tt_pb_s, "<"); tt_pb_txt(px, py, aw, bh, 0);
  tt_pb_btn(x1, py, nw, bh, hn, tt_pb_open == 1);
  tt_pb_msgt > 0 ? (
    gfx_set(tth_alR, tth_alG, tth_alB, 1); strcpy(#tt_pb_s, #tt_pb_msg);
  ) : (
    tt_pb_curKind == 1 ? tt_pb_getname(tt_pb_cur)
    : tt_pb_curKind == 2 ? tt_pb_getname(tt_pb_nfac + tt_pb_cur)
    : strcpy(#tt_pb_s, "- no preset -");
    tt_pb_curKind > 0 && tt_pb_mod ? strcat(#tt_pb_s, " *");
    tt_pb_curKind == 0 ? gfx_set(tth_dmR + 0.15, tth_dmG + 0.15, tth_dmB + 0.15, 1) : gfx_set(0.92, 0.95, 0.92, 1);
  );
  tt_pb_fit(nw - 22*sc);
  tt_pb_txt(x1 + 6*sc, py, nw, bh, 1);
  // Dropdown-Pfeil
  gfx_set(accR, accG, accB, (hn || tt_pb_open == 1) ? 1 : 0.8);
  gfx_triangle(x1 + nw - 14*sc, py + bh*0.36, x1 + nw - 6*sc, py + bh*0.36, x1 + nw - 10*sc, py + bh*0.68);
  tt_pb_btn(x2, py, aw, bh, hr, 0); strcpy(#tt_pb_s, ">"); tt_pb_txt(x2, py, aw, bh, 0);
  tt_pb_btn(x3, py, sw, bh, hs, tt_pb_open == 3); strcpy(#tt_pb_s, "SAVE"); tt_pb_txt(x3, py, sw, bh, 0);
  tt_pb_btn(x4, py, mw, bh, hm, tt_pb_open == 2); strcpy(#tt_pb_s, "..."); tt_pb_txt(x4, py, mw, bh, 0);
  // --- Overlays
  // Overlays haben eine Mindestgroesse (kleines Fenster: Text darf nicht abgeschnitten werden), Breite = W bzw. mindestens 250*0.85
  // Review 11.10.2026: bei sehr kleinem Fenster (AUTO FIT 25 %) nicht breiter als das Fenster, sonst liegt CANCEL ausserhalb. Historie: so = max(sc, 0.85);
  so = min(max(sc, 0.85), max(0.4, (gfx_w - 8)/250));
  tt_pb_font(max(9, floor(10*so + 0.5)));
  wasopen == 1 ? ( a = tt_pb_dropdown(px, py + bh, max(W, 250*so), so, click); );
  wasopen == 2 ? ( b = tt_pb_menu(px + W, py + bh, so, click); b > 0 ? a = b; );
  wasopen == 3 ? ( b = tt_pb_entry(px, py + bh, so, click); b > 0 ? a = b; );
  // Overlay wurde gerade in diesem Frame geoeffnet: schon jetzt zeichnen
  (!wasopen && tt_pb_open == 1) ? ( tt_pb_dropdown(px, py + bh, max(W, 250*so), so, 0); );
  (!wasopen && tt_pb_open == 2) ? ( tt_pb_menu(px + W, py + bh, so, 0); );
  (!wasopen && tt_pb_open == 3) ? ( b = tt_pb_entry(px, py + bh, so, 0); b > 0 ? a = b; );   // 1.5.1 (B5): Rueckgabewert des Oeffnungsframes uebernehmen (vorher verworfen)
  tt_pb_open > 0 ? tt_pb_tipdraw(tt_pb_hv) : tt_pb_tipdraw(0);   // Review 11.10.2026: Overlay-Tooltips zuletzt (ueber allem)
  tt_pb_pcap = tt_pb_rcap;
  a;
);
