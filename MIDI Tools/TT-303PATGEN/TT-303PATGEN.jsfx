  pg_combo(24, 5, 468, 520, 148, 22, 10, 0);
  pg_hint(468, 520, 148, 22, "Scale. CUSTOM uses the 12 keys to the right");
  ui_mk = pg_mask();
  ui_i = 0;
  loop(12,
    ui_j = ui_i;
    ui_i += 1;
    ui_kx = 624 + ui_j * 21;
    ui_on = floor(ui_mk / (2 ^ ui_j)) & 1;
    ui_kh = inBox(ui_kx, 520, 20, 22) ? 1 : 0;
    pg_cell(ui_kx, 520, 20, 22, ui_on ? (ui_j == 0 ? 2 : 1) : 0, ui_kh);
    gfx_setfont(5);
    ui_on ? gfx_set(0.02, 0.05, 0.02, 1) : colInk(0.6);
    xctr(ui_kx, 520, 20, 22, ui_j == 0 ? "R" : ui_j == 1 ? "b2" : ui_j == 2 ? "2" : ui_j == 3 ? "b3" : ui_j == 4 ? "3" : ui_j == 5 ? "4" : ui_j == 6 ? "b5" : ui_j == 7 ? "5" : ui_j == 8 ? "b6" : ui_j == 9 ? "6" : ui_j == 10 ? "b7" : "7");
    (ui_kh && uiClick) ? (
      ui_nm = ui_on ? ui_mk - 2 ^ ui_j : ui_mk + 2 ^ ui_j;
