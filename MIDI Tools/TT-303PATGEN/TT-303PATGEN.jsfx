    ui_on = floor(slider19 / ui_bit) & 1;
    gfx_setfont(5);
    toggle(584 + ui_j * 72, 550, 68, 22, ui_on, ui_j == 0 ? "NOTE" : ui_j == 1 ? "ACC" : ui_j == 2 ? "SLIDE" : "GATE") ? (
      ui_nw = ui_on ? slider19 - ui_bit : slider19 + ui_bit;
      pg_set(19, max(1, ui_nw));
    );
    pg_hint(584 + ui_j * 72, 550, 68, 22, "Properties MUTATE may change (each mutated step gets one of the enabled ones)");
  );
  // AMOUNT / FROM / TO
  gfx_setfont(5); colInk(0.85);
  sprintf(#ui_s, "AMOUNT %d", slider18); xstr(256, 586, #ui_s);
  sprintf(#ui_s, "FROM %d", slider20); xstr(392, 586, #ui_s);
  sprintf(#ui_s, "TO %d", slider21); xstr(528, 586, #ui_s);
  ui_v = hsliderst(30, 256, 604, 120, 14, slider18, 1, 32, 4, 1); ui_v != slider18 ? ( pg_set(18, floor(ui_v + 0.5)); );
  ui_v = hsliderst(31, 392, 604, 120, 14, slider20, 1, 32, 1, 1); ui_v != slider20 ? ( pg_set(20, floor(ui_v + 0.5)); );
  ui_v = hsliderst(32, 528, 604, 120, 14, slider21, 1, 32, 32, 1); ui_v != slider21 ? ( pg_set(21, floor(ui_v + 0.5)); );
  pg_hint(256, 584, 120, 36, "AMOUNT: how many steps MUTATE changes per press");
  pg_hint(392, 584, 120, 36, "REROLL FROM: first step MUTATE may touch when nothing is selected (e.g. 9 to only vary the second half)");
  pg_hint(528, 584, 120, 36, "REROLL TO: last step MUTATE may touch when nothing is selected");
  // 0.8.0 (Stufe 5): DENS VAR (Slider 68)
