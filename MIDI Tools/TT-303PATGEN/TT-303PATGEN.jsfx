);

ui_dk && ui_tab == 1 ? (
  // ---- OUTPUT ----
  pg_rateStr(floor(slider22));
  pg_combo(20, 22, 256, 456, 144, 22, 4, 0);
  pg_hint(256, 456, 144, 22, "Step rate: 1/16, 1/8, 1/16 triplets, 1/32 (click = next, arrows = -/+)");
  // P25 (A5): slider 25 is 1..16, combo 0..15 -> offset 1; display clamped like the output (pg_ch = slider - 1, 0..15)
  sprintf(#pn, "MIDI CH %d", min(16, max(1, floor(slider25))));
  pg_combo(21, 25, 408, 456, 144, 22, 16, 1);
  pg_hint(408, 456, 144, 22, "MIDI output channel. Changing it releases held notes");
  pg_tgl(29, 568, 456, 132, 22, "FOLLOW IN", "FOLLOW: incoming MIDI notes transpose the pattern (C2 = original pitch). Notes are never passed through");
  pg_tgl(34, 708, 456, 132, 22, "SEQ LINK", "SEQ LINK: publish the active pattern in gmem namespace tt303pg (sender only, see manual)");
  pg_kn(10, 23, 290, 516, 15, 50, 75, 50, "SWING", 0, "SWING %: delays every second step (50 = straight, 66 = triplet feel)", 1);
  pg_kn(11, 24, 370, 516, 15, 5, 100, 50, "GATE LEN", 0, "GATE LEN %: note length in steps (50 = half a step). Slide overlaps by half of it", 1);
  pg_kn(12, 26, 450, 516, 15, 1, 127, 127, "ACC VEL", 3, "ACC VEL: velocity of accented steps (TT-303 HOST mode: at or above its Accent threshold)", 1);
  pg_kn(13, 27, 530, 516, 15, 1, 127, 64, "NORM VEL", 3, "NORM VEL: velocity of normal steps (must stay below the synth's accent threshold)", 1);
  pg_kn(14, 31, 610, 516, 15, 0, 20, 0, "HUM TIME", 1, "HUMANIZE TIME ms: deterministic timing jitter +- (0 = exact grid). A step never starts before the previous one", 0.1);
  pg_kn(15, 32, 690, 516, 15, 0, 30, 0, "HUM VEL", 0, "HUMANIZE VELOCITY: deterministic velocity jitter; accents stay accents", 1);
  pg_kn(16, 28, 770, 516, 15, 1, 127, 65, "THRESH", 0, "ACC THRESHOLD of your synth (TT-303 default 65 since the Devil Fish update, 100 before): keeps humanized velocities on the right side", 1);
  pg_kn(17, 35, 850, 516, 15, -2, 2, 0, "OCTAVE", 2, "OCTAVE: transposes the output by whole octaves (C2 = pattern root at 0)", 1);
  gfx_setfont(5);
  (slider26 >= slider28 && slider27 < slider28) ? ( colAcid(0.9); pg_strF(256, 574, 5, "VELOCITIES OK FOR THRESHOLD", 300, 16); )
  : ( gfx_set(1, 0.55, 0, 1); pg_strF(256, 574, 5, "ACC VEL >= THRESH > NORM VEL !", 300, 16); );
  pg_hint(256, 572, 300, 18, "Checks that ACC VEL is at or above THRESH and NORM VEL below it, so accents stay accents on the target synth");
  // 0.8.0 (Stufe 5): SLOT QUANT / NOTE TRIG / TRIG BASE (Slider 65..67)
  pg_sqStr(floor(slider65));
  pg_combo(38, 65, 566, 568, 128, 22, 5, 0);
  pg_hint(566, 568, 128, 22, "SLOT QUANT: a slot change from the front, the keys 1..8 or NOTE TRIG waits for the next beat / bar (counted from the project start). INSTANT = immediate. Automating SLOT stays immediate; nothing waits while stopped or in SONG mode");
  pg_tgl(66, 700, 568, 92, 22, "NOTE TRIG", "NOTE TRIG: eight incoming MIDI notes from TRIG BASE switch the slots A..H (quantized like SLOT QUANT). These notes do not transpose and are not passed through");
  pg_trigStr(floor(slider67));
  pg_combo(39, 67, 798, 568, 82, 22, 4, 0);
  slider66 < 0.5 ? ( gfx_set(0.02, 0.03, 0.02, 0.45); xrect(798, 568, 82, 22); );
  pg_hint(798, 568, 82, 22, "TRIG BASE: the eight chromatic notes that switch the slots A..H (C0 = MIDI 12, C1 = 24, C3 = 48, C4 = 60). FOLLOW IN transposes with all other notes");
  colInk(0.6); pg_strF(256, 592, 5, "IN: C2 = ORIGINAL PITCH (WITH FOLLOW IN)", 300, 16);
  colInk(0.6); pg_strF(256, 610, 5, "PRINT: ACTION 'TT-303PATGEN PRINT TO MIDI ITEM' (NEEDS SEQ LINK)", 620, 16);
  pg_hint(256, 608, 620, 18, "How to turn the pattern into a MIDI item: enable SEQ LINK, select a track, run the action from the action list");
);

ui_dk && ui_tab == 2 ? (
  // ---- SONG: Kette (16 Zellen), Kettenbearbeitung, Zeitleiste, Slot-Uebersicht ----
  pg_tgl(33, 256, 456, 74, 22, "SONG", "SONG: play the chain of slots instead of the active slot");
  ui_cell = min(15, max(0, ui_cell));
  ui_i = 0;
  loop(16,
    ui_j = ui_i;
    ui_i += 1;
    ui_kx = 340 + ui_j * 34;
    ui_ky = 456;
    ui_cs = M_CHS[ui_j];
    ui_kh = inBox(ui_kx, ui_ky, 31, 22) ? 1 : 0;
    pg_cell(ui_kx, ui_ky, 31, 22, ui_cs < 0 ? 0 : (ui_j < pg_songN ? 1 : 3), ui_kh);
    ui_j == ui_cell ? ( colWhite(0.9); xrect(ui_kx + 2, ui_ky + 20, 27, 2); );
    gfx_setfont(5);
    ui_cs < 0 ? ( colInk(0.4); xctr(ui_kx, ui_ky, 31, 22, "-"); )
              : ( gfx_set(0.02, 0.05, 0.02, 1);
                  sprintf(#ui_t, M_CHR[ui_j] > 1 ? "%c%d" : "%c", 65 + ui_cs, M_CHR[ui_j]);
                  xctr(ui_kx, ui_ky, 31, 22, #ui_t); );
    ui_next = ui_cs >= 7 ? 0 - 1 : ui_cs + 1;
    (ui_kh && uiClick) ? ( ui_cell = ui_j; pg_postU(21, ui_j, ui_next, M_CHR[ui_j]); );
    (ui_kh && uiRClk) ? ( ui_cell = ui_j; pg_postU(21, ui_j, ui_cs, M_CHR[ui_j] >= 8 ? 1 : M_CHR[ui_j] + 1); );
  );
  pg_hint(340, 456, 544, 22, "Song chain (16 cells, ends at the first empty one): click = next slot / empty, right-click = repeats 1..8 (A3 = slot A three times). The underlined cell is the one the buttons below act on");
  // Kettenbearbeitung
  ui_op(256, 484, 52, 20, "INSERT", "Insert a cell with the active slot (1 repeat) after the underlined cell; the following cells move right, the last one drops out", 1) ? ( ui_send(62, min(15, ui_cell + 1), ui_slot, 1); ui_cell = min(15, ui_cell + 1); );
  ui_op(312, 484, 52, 20, "DELETE", "Delete the underlined cell; the following cells move left", 1) ? ( ui_send(63, ui_cell, 0, 0); );
  ui_op(368, 484, 34, 20, "<<", "Move the underlined cell one position to the left", ui_cell > 0) ? ( ui_send(64, ui_cell, ui_cell - 1, 0); ui_cell = ui_cell - 1; );
  ui_op(406, 484, 34, 20, ">>", "Move the underlined cell one position to the right", ui_cell < 15) ? ( ui_send(64, ui_cell, ui_cell + 1, 0); ui_cell = ui_cell + 1; );
  // Chain length: sum of length x repeats up to the first empty cell, in bars at the grid rate
  ui_tot = 0;
  ui_i = 0;
  loop(pg_songN,
    ui_j = ui_i;
    ui_i += 1;
    ui_tot += M_LEN[min(7, max(0, M_CHS[ui_j]))] * M_CHR[ui_j];
  );
  ui_spb = floor(slider22) == 0 ? 16 : floor(slider22) == 1 ? 8 : floor(slider22) == 2 ? 24 : 32;   // Steps je Takt (4/4)
  gfx_setfont(5); colInk(0.85);
  pg_songN > 0 ? sprintf(#ui_s, "CHAIN: %d CELL(S) = %d STEPS = %.2f BARS", pg_songN, ui_tot, ui_tot / ui_spb)
               : strcpy(#ui_s, "CHAIN: EMPTY (CLICK A CELL ABOVE)");
  xstr(452, 490, #ui_s);
  pg_hint(448, 484, 432, 20, "Length of the song chain: all cells up to the first empty one, in steps and in 4/4 bars at the current RATE");
  // Timeline: one block per cell, width = length x repeats
  panelBox(256, 510, 624, 24);
  ui_acc = 0;
  ui_i = 0;
  loop(pg_songN,
    ui_j = ui_i;
    ui_i += 1;
    ui_cs = min(7, max(0, M_CHS[ui_j]));
    ui_wd = 620 * M_LEN[ui_cs] * M_CHR[ui_j] / max(1, ui_tot);
    ui_bx = 258 + 620 * ui_acc / max(1, ui_tot);
    ui_acc += M_LEN[ui_cs] * M_CHR[ui_j];
    (ui_j & 1) ? colAcid(0.55) : colAcid(0.85);
    xrect(ui_bx, 513, max(1, ui_wd - 1), 18);
    ui_j == ui_cell ? ( colWhite(0.95); xrect(ui_bx, 530, max(1, ui_wd - 1), 2); );
    (pg_curCell === ui_j && pg_songOn) ? ( colWhite(0.22); xrect(ui_bx, 513, max(1, ui_wd - 1), 18); );   // 0.8.1: gerade spielende Zelle heller
    gfx_setfont(5); gfx_set(0.02, 0.05, 0.02, 1);
    ui_wd > 20 ? ( sprintf(#ui_t, M_CHR[ui_j] > 1 ? "%c x%d" : "%c", 65 + ui_cs, M_CHR[ui_j]); xctr(ui_bx, 513, ui_wd, 18, #ui_t); );
    (inBox(ui_bx, 513, ui_wd, 18) && uiClick) ? ( ui_cell = ui_j; );
  );
  // 0.8.1: running playhead - vertical line across the timeline plus a growing horizontal line below it (only while the chain plays)
  (pg_songOn && pg_curCell >= 0 && pg_curTot > 0 && pg_curStep >= 0) ? (
    ui_px = 258 + 620 * pg_curQ / pg_curTot;
    ui_pw = max(2, 620 / pg_curTot);
    colWhite(0.9); xrect(258, 535, max(1, ui_px - 258 + ui_pw), 3);
    colWhite(1); xrect(ui_px, 508, ui_pw, 30);
  );
  pg_hint(256, 510, 624, 24, "Timeline of the chain: one block per cell, width = pattern length x repeats. The bright line is the playhead (it runs while the chain plays); the lit block is the cell that is playing. Click a block to underline its cell");
  // Slot overview: eight miniature rolls, click selects the slot
  ui_i = 0;
  loop(8,
    ui_j = ui_i;
    ui_i += 1;
    ui_bx = 256 + ui_j * 78;
    ui_by = 540;
    ui_ln = M_LEN[ui_j];
    panelBox(ui_bx, ui_by, 74, 58);
    ui_j == ui_slot ? ( colAcid(0.9); xrrect(ui_bx, ui_by, 74, 58, 3, 0); );
    (pg_sqPend && pg_sqSlot == ui_j) ? ( colWhite(floor(time_precise() * 4) & 1 ? 0.95 : 0.35); xrrect(ui_bx, ui_by, 74, 58, 3, 0); );
    ui_mini(ui_bx + 2, ui_by + 3, 70, 36, ui_j * 32, ui_ln);
    gfx_setfont(5); colInk(0.8);
    sprintf(#ui_t, "%c  %d STEPS", 65 + ui_j, ui_ln); xstr(ui_bx + 4, ui_by + 44, #ui_t);
    (pg_curSlot == ui_j && pg_curStep >= 0) ? ( colWhite(0.9); xcirc(ui_bx + 66, ui_by + 49, 2.2, 1); );
    (inBox(ui_bx, ui_by, 74, 58) && uiClick) ? ( ui_slotSel(ui_j); );
    pg_hint(ui_bx, ui_by, 74, 58, "Slot overview: click = edit and play this slot. The number is the pattern length");
  );
  gfx_setfont(5); colInk(0.6);
  pg_strF(256, 606, 5, "PRINT THE WHOLE CHAIN: ACTION 'TT-303PATGEN PRINT SONG CHAIN' (NEEDS SEQ LINK, SEE OUTPUT)", 620, 16);
  pg_hint(256, 604, 620, 18, "How to turn the whole song chain into a MIDI item: enable SEQ LINK, select a track, run the action TT-303PATGEN Print Song Chain from the action list");
);

ui_dk && ui_tab == 3 ? (
  // ---- GALLERY: eight candidates (each = GENERATE with its seed), partial reroll, seed history ----
  ui_gStale = (pg_galCtr == 0 || pg_galLen != ui_len) ? 1 : 0;
  ui_op(256, 452, 62, 20, "ROLL 8", "Draw eight new candidates from the current generator settings for the length of the active slot. Each candidate is exactly what GENERATE would give with its seed", 1) ? ( ui_send(70, 0, 0, 0); );
  toggle(322, 452, 60, 20, ui_gAuto, "AUTO") ? ( ui_gAuto = 1 - ui_gAuto; );
  pg_hint(322, 452, 60, 20, "AUTO: draw new candidates by itself whenever a generator setting, the slot or the length changes (this tab only)");
  ui_tgt == ui_slot ? ( ui_tgt = (ui_slot + 1) % 8; );
  sprintf(#cmb_txt, "KEEP TO %c", 65 + ui_tgt);
  ui_tgt = combo(36, 388, 452, 92, 20, ui_tgt, 8);
  pg_hint(388, 452, 92, 20, "Target slot for KEEP (click = next, arrows = -/+)");
  gfx_setfont(5); colInk(0.85); xstr(488, 457, "REROLL");
  ui_op(530, 452, 54, 20, "NOTES", "Partial reroll: a new tone sequence over the rhythm of the pattern - walk / Markov / motif, TENSION, REPEAT, OCT JUMP, RANGE and scale as in GENERATE (locked steps stay, ties follow their note)", 1) ? ( ui_send(73, 1, 0, 0); );
  ui_op(588, 452, 60, 20, "RHYTHM", "Partial reroll: a new rhythm (algorithm, DENSITY, DENS VAR, SYNCOPATION, TIES as in GENERATE); the pitch of every step stays, accents stay where the step still plays, slides are redrawn (locked steps stay)", 1) ? ( ui_send(73, 2, 0, 0); );
  ui_op(652, 452, 62, 20, "ACC+SLD", "Partial reroll: new accents (ACCENT %) and slides (SLIDE %) over the rhythm that plays now; tones and gates stay (locked steps stay)", 1) ? ( ui_send(73, 3, 0, 0); );
  ui_op(718, 452, 34, 20, "ALL", "Partial reroll: every step that is not locked comes from a new candidate", 1) ? ( ui_send(73, 4, 0, 0); );
  // Seed history: ui_shi = 0 newest
  ui_shn = min(16, PG_SH[16]);
  ui_shi = min(max(0, ui_shn - 1), max(0, ui_shi));
  ui_op(758, 452, 18, 20, "<", "Seed history: one seed further back", ui_shi < ui_shn - 1) ? ( ui_shi += 1; );
  ui_op(778, 452, 18, 20, ">", "Seed history: one seed forward", ui_shi > 0) ? ( ui_shi -= 1; );
  ui_shn > 0 ? ( ui_hseed = PG_SH[(PG_SH[16] - 1 - ui_shi) % 16]; sprintf(#ui_s, "0x%06X", ui_hseed); ) : strcpy(#ui_s, "NO SEED");
  ui_op(800, 452, 80, 20, #ui_s, "Seed history: GENERATE the active slot with this seed (SEED is set to it, LOCK stays as it is; settings as they are now)", ui_shn > 0) ? ( ui_send(75, ui_hseed, 0, 0); );
  // AUTO: watch settings (without SEED, so that TRY does not immediately reroll)
  ui_sig = ui_slot * 5 + ui_len * 101 + slider4 * 3 + slider5 * 7 + slider6 * 11 + slider7 * 13 + slider8 * 17 + slider9 * 19 + slider10 * 23 + slider11 * 29
         + slider12 * 31 + slider13 * 37 + slider14 * 41 + slider15 * 43 + slider16 * 47 + slider17 * 53
         + slider68 * 59;   // Review 0.9.0 F4: DENS VAR belongs to the signature (Historie: ended at slider17)
  ui_sig != ui_sigP ? ( ui_sigP = ui_sig; ui_sigT = time_precise(); ui_sigPend = 1; );
  (ui_gAuto && ui_sigPend && time_precise() - ui_sigT > 0.25) ? ( ui_sigPend = 0; ui_send(70, 0, 0, 0); );
  // Kandidaten 4 x 2
  ui_i = 0;
  loop(8,
    ui_j = ui_i;
    ui_i += 1;
    ui_cx = 256 + (ui_j & 3) * 156;
    ui_cy = 478 + (ui_j >> 2) * 76;
    panelBox(ui_cx, ui_cy, 152, 72);
    ui_gStale ? ( gfx_set(0.1, 0.1, 0.1, 1); xrect(ui_cx + 4, ui_cy + 3, 144, 34); )
              : ui_mini(ui_cx + 4, ui_cy + 3, 144, 34, PG_GAL + ui_j * 32, pg_galLen);
    gfx_setfont(5); colInk(0.7);
    ui_gStale ? strcpy(#ui_t, ui_j == 0 ? "PRESS ROLL 8" : "-") : sprintf(#ui_t, "SEED 0x%06X", PG_GS[ui_j]);
    xstr(ui_cx + 6, ui_cy + 39, #ui_t);
    ui_op(ui_cx + 4, ui_cy + 50, 68, 20, "TRY", "Put this candidate into the active slot (SEED is set to its seed; undoable). Locked steps stay", !ui_gStale) ? ( ui_send(71, ui_j, 0, 0); );
    ui_op(ui_cx + 76, ui_cy + 50, 72, 20, "KEEP", "Copy this candidate into the KEEP TO slot (undoable) without touching the active slot", !ui_gStale) ? ( ui_send(72, ui_j, ui_tgt, 0); );
  );
);

ui_dk && ui_tab == 4 ? (
  // ---- LIBRARY: the 32 style patterns with preview; click = load into the active slot (undoable) ----
  ui_i = 0;
  loop(32,
    ui_j = ui_i;
    ui_i += 1;
    ui_cx = 256 + (ui_j & 7) * 78;
    ui_cy = 452 + (ui_j >> 3) * 44;
    ui_kh = inBox(ui_cx, ui_cy, 74, 40) ? 1 : 0;
    panelBox(ui_cx, ui_cy, 74, 40);
    ui_kh ? ( colAcid(0.8); xrrect(ui_cx, ui_cy, 74, 40, 3, 0); );
    ui_mini(ui_cx + 2, ui_cy + 2, 70, 22, M_LIB + ui_j * 16, 16);
    pg_libStr(ui_j);
    gfx_setfont(5); ui_kh ? colWhite(0.95) : colInk(0.8);
    pg_strF(ui_cx + 4, ui_cy + 26, 5, #pn, 68, 12);
    (ui_kh && uiClick) ? ( ui_send(20, ui_j, 0, 0); );
    pg_hint(ui_cx, ui_cy, 74, 40, "Library pattern: click = load into the active slot (16 steps, undoable). With ALGO = CLASSIC MUT the generator mutates these patterns");
  );
);

// P25 (harmonization 2/3): target form of the suite. Header tooltips (preset bar per element, OPTIONS) via tt_modtips() from the
// kit; uikit_end() last. Historie: pg_barhints(); tt_tipflush(); pg_rflush(); uikit_end(); stood before tt_pb_post/tth_post.
 
// Preset bar (preset module) in the header row left of OPTIONS, design grid (292,20), 250 wide; actions run as commands in @block
// P25 (A11): FACTORY only with two free ring places (otherwise pg_pbSeq != pg_pbAck stayed forever); A7: request undo marker.
pg_pa = tt_pb_post(OX + 292 * SC, OY + 20 * SC, SC);
// 0.6.1 (Review P-G): preset / scene / INIT requests share PG_PBA and tt_pb_buf. A new request is started only when the
// previous one is acknowledged in @block (pg_pbSeq == pg_pbAck) and two ring places are free; until then it is remembered (the last one wins).
// Previously a second request overwrote the buffer of the first while @block stood still (FX bypassed/offline).
// Historie: pg_pa evaluated directly. SAVE (3) does not touch PG_PBA and stays immediate.
(pg_pa > 0 && pg_pa != 3) ? ( pg_pbDefPa = pg_pa; pg_pbDefArg = tt_pb_arg; pg_pa = 0; );
(pg_pbDefPa > 0 && pg_pbSeq == pg_pbAck && pg_ringFree() >= 3) ? (
  pg_pa = pg_pbDefPa; tt_pb_arg = pg_pbDefArg; pg_pbDefPa = 0;
);
pg_pa == 1 ? (
  tt_pb_arg < PG_NLIB ? (
    // 0.6.0 (F7): no more pg_set(36) (LIB IDX is read nowhere, cost an undo step); Historie: pg_set(36, tt_pb_arg);
    pg_ringFree() >= 2 ? ( pg_pbSeq += 1; pg_post(20, tt_pb_arg, 0, 0); pg_post(32, 0, 0, 0); pg_undoNeed = 1; );   // FACTORY: library pattern into the active slot (like the former LOAD button)
  ) : (
    pg_ringFree() >= 2 ? ( pg_scnBuild(tt_pb_arg - PG_NLIB); pg_pbSend(30, 0); );   // 0.6.0: scene = whole state like a user preset
  );
)
: pg_pa == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( memcpy(PG_PBA, tt_pb_buf, PG_PBW); pg_pbSend(30, 0); ); )
: pg_pa == 3 ? ( pg_pbCapture(); tt_pb_commit(tt_pb_arg, PG_PBW); )
: pg_pa == 4 ? ( pg_pbSend(31, 0); );
(pg_pbSeq != pg_pbAck) ? ( tt_pb_reset = 1; ) : tt_pb_track(pg_pbSum());   // Reference for the star only after execution in @block
// P25 (A7): undo marker (command 36) once per frame BEHIND the pattern commands of this frame; in @block it calls tt_undo(), tth_post
// creates the undo point "Edit FX" (sliderchange(-1)) as soon as the mouse button is released. Ring full -> again in the next frame.
pg_undoNeed ? ( pg_post(36, 0, 0, 0) ? ( pg_undoNeed = 0; ); );
pg_seedNew ? ( pg_seedNew = 0; sliderchange(slider2); );   // P25 (A7): new seed from @block (NEW / GENERATE without LOCK) -> host
// OPTIONS button (theme module) right of the bar, design grid (550,20); box overlays on top of it
ui_tc = tth_post(OX + 550 * SC, OY + 20 * SC, SC);
ui_tc >= 0 ? ( slider64 = ui_tc; sliderchange(slider64); slider_automate(slider64); );
tt_modtips(); tt_tipflush(); // 02.10.2026: after all overlays
uikit_end();
