  ui_v = hsliderst(37, 664, 604, 96, 14, slider68, 0, 100, 25, 1); ui_v != slider68 ? ( pg_set(68, floor(ui_v + 0.5)); );
  pg_hint(664, 584, 96, 36, "DENS VAR %: spreads the number of playing steps around DENSITY, symmetric, at most half the pattern length at 100 (0 = exact count). Not used by CLASSIC MUT");
  gfx_setfont(5); colInk(0.7); xstr(772, 586, "MUTATE RANGE");
  ui_hs = ui_sel0 >= 0 ? 1 : 0;
  ui_hs ? sprintf(#ui_s, "SELECTION %d-%d", ui_sel0 + 1, ui_sel1 + 1)
        : sprintf(#ui_s, "STEPS %d-%d", min(ui_len, floor(slider20)), min(ui_len, max(floor(slider20), floor(slider21))));
  ui_hs ? colAcid(1) : colInk(0.9);
  xstr(772, 604, #ui_s);
