  pg_hint(22, 578, 140, 22, "Target slot for the copy to the right (click = next, arrows = -/+)");
  ui_op(168, 578, 58, 22, "COPY>", "Copy the selected steps into the target slot at the same positions (undoable; a shorter target pattern is extended)", ui_hs && ui_tgt != ui_slot) ? ( ui_send(51, ui_sel0, ui_sel1, ui_tgt); );
  // Step locks (0.7.0): locked steps are not changed by GENERATE, MUTATE and REROLL (manual pattern edits remain possible)
  ui_op(22, 604, 48, 22, "LOCK", "Lock the selected steps (the whole pattern without a selection): GENERATE, MUTATE and the REROLL buttons leave them alone. Key L toggles the step under the pointer", 1) ? ( ui_aLock(1); );
  ui_op(74, 604, 48, 22, "UNLK", "Unlock the selected steps (the whole pattern without a selection)", ui_lkOn) ? ( ui_aLock(0); );
  ui_op(126, 604, 100, 22, "CLEAR LOCKS", "Unlock all steps of the active slot", ui_lkOn) ? ( ui_send(74, 0, 31, 3); );
);

// ===== DECK (rechts unten): Reiter GENERATE / OUTPUT / SONG + GENERATE / MUTATE =====
ui_dty = ui_dk ? 424 : 606;
ui_dk ? ( panelBox(248, 422, 640, 210); );
gfx_setfont(5);
ui_i = 0;
loop(5,
  ui_j = ui_i;
  ui_i += 1;
  btn(256 + ui_j * 77, ui_dty, 74, 20, ui_tab == ui_j, ui_j == 0 ? "GENERATE" : ui_j == 1 ? "OUTPUT" : ui_j == 2 ? "SONG" : ui_j == 3 ? "GALLERY" : "LIBRARY") ? ( ui_tab = ui_j; ui_deckOpen = 1; );
  pg_hint(256 + ui_j * 77, ui_dty, 74, 20, ui_j == 0 ? "Generator settings: algorithm, scale, seed, mutate"
