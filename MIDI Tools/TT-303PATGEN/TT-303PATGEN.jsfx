// Historie (F4, 0.6.0): options:want_all_kb entfernt - es schickte alle Tasten an das Plugin, die Leertaste startete im FX-Fenster den Transport nicht mehr.

@init
// __THEME_BEGIN__   // generiert aus _shared/tt-theme.jsfx-inc
// ==========================  TT-Theme (THEME_VER 6)  ==================
// Zehn Farbschemata (Akzent + Zweitfarbe + getoenter Grund) und die OPTIONS-Box
// mit Stil-Optionen (P20): Font-Groessen, eigener HSV-Farbwaehler (FONT 1 / FONT 2 / BG).
// Erzeugt von _shared/tt_theme_gen.py - nicht von Hand aendern.
// Einbindung im Produkt (Details: _shared/THEME.md):
//   @init   : tth_sync(sliderN);                 // Schema aus dem versteckten Slider
//   @gfx    : tth_pre();  tth_sync(sliderN);     // GANZ OBEN (maskiert Maus, solange die Box offen ist)
//             ... Front zeichnen ...
//             c = tth_post(px, py, sc);          // GANZ UNTEN; px/py = Button links oben in Fensterpixeln, sc = Skalierung
//             c >= 0 ? ( sliderN = c; slider_automate(sliderN); );
// Globals (Praefix tth_ / acc*): accR/G/B = Akzent, tth_dmR.. = gedimmter Akzent (P20: kontrastgehoben,
// WCAG >= 4.5 gegen Panel), tth_alR.. = Zweitfarbe, tth_ikR.. = Primaer-Text (Ink, getoent),
// tth_bgR.. Grund, tth_pnR.. Panel, tth_bdR.. Rahmen, tth_knR.. Knob-Scheibe.
// Stil-Optionen (per Instanz, werden vom Preset-Modul serialisiert - Block TTPB_MAG2):
// tth_f1sz/tth_f2sz = Schrift-Stufen -4..+8 (Slot 1 = Titel, Slots 2..5 = Text; das Kit skaliert in uikit_begin);
// tth_f1on/f2on + tth_f1R../f2R.. = eigene Textfarben; tth_bgon + tth_bgUR.. = eigener Grund
// (pn/bd/kn folgen mit dem Schema-Abstand, s. tth_bgmix).
THEME_VER = 6;      // v3 (P23): TOOLTIPS ON/OFF in der OPTIONS-Box (tth_tipoff, im Stil-Block serialisiert); v4 (P25): tt_slset, tt_undo, tt_testok; v6 (10.10.2026): AUTO FIT (UI-Zoom folgt der Fenstergroesse, tth_autooff)
TTH_FONT  = 10;      // Schrift-Slot der Box (Produkte nutzen 1..5 und 9)
tth_on    = 1;
tth_cur   = -1;      // zuletzt angewandtes Schema
// Historie: tth_open  = 0;       // Box offen
// P24: tth_open und tth_hold werden nicht mehr bei jedem @init zurueckgesetzt - @init laeuft bei jedem
// Transportstart erneut und schloss sonst die offene OPTIONS-Box. Vorgabe 0 gilt ohne Zuweisung.
// P25: nur beim ersten @init - @init laeuft bei jedem Transportstart erneut; ein Reset bei gedrueckter Taste
// erzeugte im Folgeframe eine Klickflanke (Phantomklick auf den OPTIONS-Knopf).
tth_ini1 != 1 ? ( tth_ini1 = 1; tth_pcap = 0; );       // tth_pcap = mouse_cap des Vorframes (Flankenerkennung)
tth_fsCur = 0;
tth_tint  = 0;       // 1 = Grautoene mit Akzent toenen (Schemata 5..9)
// Historie: tth_hold  = 0;       // Maus bleibt maskiert, bis nach dem Schliessen die Taste losgelassen ist
tth_bx = 0; tth_by = 0; tth_bw = 0; tth_bh = 0;   // Button-Rechteck (fuer die Maskierung im Folgeframe)

// Stil-Zustand: bewusst nur beim ersten @init vorbelegen (ein Re-Init bei
// Samplerate/Transportstart darf die gewaehlten Optionen nicht verlieren).
tth_styok != 1 ? (
  tth_styok = 1;
  tth_uisize = 125; tth_panx = 0; tth_pany = 0; // 02.10.2026: groessere Vorgabe; pro Instanz gespeichert
  tth_autooff = 0;                            // 10.10.2026: AUTO FIT an (Vorgabe); 1 = UI-Zoom ignoriert die Fenstergroesse
  tth_f1sz = 0; tth_f2sz = 0;                 // Schrift-Stufen -4..+8
  tth_f1on = 0; tth_f2on = 0; tth_bgon = 0;   // eigene Farben aktiv?
  tth_f1R = 0.92; tth_f1G = 0.95; tth_f1B = 0.92;
  tth_f2R = 0.92; tth_f2G = 0.95; tth_f2B = 0.92;
  tth_bgUR = 0.050; tth_bgUG = 0.054; tth_bgUB = 0.050;
  tth_ctgt = 0;                              // Farbwaehler-Ziel: 0 = FONT 1, 1 = FONT 2, 2 = BG
  tth_ch = 0.30; tth_cs = 0.85; tth_cv = 0.9; // HSV des Waehlers
  tth_cdrag = 0;                             // 1 = SV-Feld, 2 = Farbton-Leiste
);

// ---------- WCAG-Kontrast (Laufzeit: Warnung + Hilfsrechnung) ----------
function tth_lin(c) ( c <= 0.04045 ? c/12.92 : ((c + 0.055)/1.055)^2.4; );

// Kontrastverhaeltnis (L hell + 0.05)/(L dunkel + 0.05)
function tth_cr(r1, g1, b1, r2, g2, b2) local(l1, l2, t) (
  l1 = 0.2126*tth_lin(r1) + 0.7152*tth_lin(g1) + 0.0722*tth_lin(b1);
  l2 = 0.2126*tth_lin(r2) + 0.7152*tth_lin(g2) + 0.0722*tth_lin(b2);
  l1 < l2 ? ( t = l1; l1 = l2; l2 = t; );
  (l1 + 0.05)/(l2 + 0.05);
);

// ---------- HSV <-> RGB fuer den Farbwaehler ----------
// tth_hsv(h, s, v): Ergebnis in tth_hr/hg/hb
function tth_hsv(h, s, v) local(i, f, p, q, t) (
  h -= floor(h); i = floor(h*6); f = h*6 - i;
  p = v*(1 - s); q = v*(1 - s*f); t = v*(1 - s*(1 - f));
  i == 0 ? ( tth_hr = v; tth_hg = t; tth_hb = p; )
  : i == 1 ? ( tth_hr = q; tth_hg = v; tth_hb = p; )
  : i == 2 ? ( tth_hr = p; tth_hg = v; tth_hb = t; )
  : i == 3 ? ( tth_hr = p; tth_hg = q; tth_hb = v; )
  : i == 4 ? ( tth_hr = t; tth_hg = p; tth_hb = v; )
  : ( tth_hr = v; tth_hg = p; tth_hb = q; );
);

// tth_rgb2hsv(r, g, b): Ergebnis in tth_ch/cs/cv (Waehler-Stand)
function tth_rgb2hsv(r, g, b) local(mx, mn, dd, h) (
  mx = max(r, max(g, b)); mn = min(r, min(g, b)); dd = mx - mn;
  h = 0;
  dd > 0.000001 ? (
    mx == r ? h = (g - b)/dd : mx == g ? h = 2 + (b - r)/dd : h = 4 + (r - g)/dd;
    h < 0 ? h += 6;
    h /= 6;
  );
  tth_ch = h; tth_cs = mx > 0.000001 ? dd/mx : 0; tth_cv = mx;
);

// Eigenen Grund anwenden: tth_bg = Wunschfarbe, pn/bd/kn folgen mit dem
// Abstand des aktiven Schemas (Snapshot tth_s* beim Schema-Wechsel).
function tth_bgmix() (
  tth_bgR = tth_bgUR; tth_bgG = tth_bgUG; tth_bgB = tth_bgUB;
  tth_pnR = min(1, max(0, tth_spnR + (tth_bgUR - tth_sbgR)));
  tth_pnG = min(1, max(0, tth_spnG + (tth_bgUG - tth_sbgG)));
  tth_pnB = min(1, max(0, tth_spnB + (tth_bgUB - tth_sbgB)));
  tth_bdR = min(1, max(0, tth_sbdR + (tth_bgUR - tth_sbgR)));
  tth_bdG = min(1, max(0, tth_sbdG + (tth_bgUG - tth_sbgG)));
  tth_bdB = min(1, max(0, tth_sbdB + (tth_bgUB - tth_sbgB)));
  tth_knR = min(1, max(0, tth_sknR + (tth_bgUR - tth_sbgR)));
  tth_knG = min(1, max(0, tth_sknG + (tth_bgUG - tth_sbgG)));
  tth_knB = min(1, max(0, tth_sknB + (tth_bgUB - tth_sbgB)));
);

function tth_apply(i) (
  i = max(0, min(9, floor(i + 0.5)));
  tth_cur = i;
  i == 0 ? ( tth_tint = 0; accR = 0.224; accG = 1.000; accB = 0.078; tth_dmR = 0.128; tth_dmG = 0.570; tth_dmB = 0.044; tth_alR = 1.000; tth_alG = 0.702; tth_alB = 0.361; tth_ikR = 0.750; tth_ikG = 0.810; tth_ikB = 0.750; tth_bgR = 0.050; tth_bgG = 0.054; tth_bgB = 0.050; tth_pnR = 0.072; tth_pnG = 0.077; tth_pnB = 0.072; tth_bdR = 0.125; tth_bdG = 0.155; tth_bdB = 0.115; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.105; ) :
  i == 1 ? ( tth_tint = 0; accR = 0.133; accG = 0.827; accB = 0.933; tth_dmR = 0.088; tth_dmG = 0.546; tth_dmB = 0.616; tth_alR = 1.000; tth_alG = 0.620; tth_alB = 0.300; tth_ikR = 0.750; tth_ikG = 0.810; tth_ikB = 0.750; tth_bgR = 0.050; tth_bgG = 0.054; tth_bgB = 0.050; tth_pnR = 0.072; tth_pnG = 0.077; tth_pnB = 0.072; tth_bdR = 0.125; tth_bdG = 0.155; tth_bdB = 0.115; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.105; ) :
  i == 2 ? ( tth_tint = 0; accR = 1.000; accG = 0.353; accB = 0.122; tth_dmR = 0.860; tth_dmG = 0.304; tth_dmB = 0.105; tth_alR = 0.350; tth_alG = 0.850; tth_alB = 1.000; tth_ikR = 0.750; tth_ikG = 0.810; tth_ikB = 0.750; tth_bgR = 0.050; tth_bgG = 0.054; tth_bgB = 0.050; tth_pnR = 0.072; tth_pnG = 0.077; tth_pnB = 0.072; tth_bdR = 0.125; tth_bdG = 0.155; tth_bdB = 0.115; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.105; ) :
  i == 3 ? ( tth_tint = 0; accR = 0.878; accG = 0.251; accB = 0.984; tth_dmR = 0.790; tth_dmG = 0.226; tth_dmB = 0.886; tth_alR = 0.350; tth_alG = 1.000; tth_alB = 0.750; tth_ikR = 0.750; tth_ikG = 0.810; tth_ikB = 0.750; tth_bgR = 0.050; tth_bgG = 0.054; tth_bgB = 0.050; tth_pnR = 0.072; tth_pnG = 0.077; tth_pnB = 0.072; tth_bdR = 0.125; tth_bdG = 0.155; tth_bdB = 0.115; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.105; ) :
  i == 4 ? ( tth_tint = 0; accR = 1.000; accG = 0.839; accB = 0.039; tth_dmR = 0.580; tth_dmG = 0.487; tth_dmB = 0.023; tth_alR = 0.450; tth_alG = 0.750; tth_alB = 1.000; tth_ikR = 0.750; tth_ikG = 0.810; tth_ikB = 0.750; tth_bgR = 0.050; tth_bgG = 0.054; tth_bgB = 0.050; tth_pnR = 0.072; tth_pnG = 0.077; tth_pnB = 0.072; tth_bdR = 0.125; tth_bdG = 0.155; tth_bdB = 0.115; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.105; ) :
  i == 5 ? ( tth_tint = 1; accR = 1.000; accG = 0.176; accB = 0.333; tth_dmR = 0.940; tth_dmG = 0.165; tth_dmB = 0.313; tth_alR = 1.000; tth_alG = 0.780; tth_alB = 0.350; tth_ikR = 0.805; tth_ikG = 0.752; tth_ikB = 0.768; tth_bgR = 0.058; tth_bgG = 0.050; tth_bgB = 0.051; tth_pnR = 0.082; tth_pnG = 0.070; tth_pnB = 0.073; tth_bdR = 0.155; tth_bdG = 0.120; tth_bdB = 0.127; tth_knR = 0.110; tth_knG = 0.105; tth_knB = 0.106; ) :
  i == 6 ? ( tth_tint = 1; accR = 0.300; accG = 0.550; accB = 1.000; tth_dmR = 0.264; tth_dmG = 0.484; tth_dmB = 0.880; tth_alR = 1.000; tth_alG = 0.750; tth_alB = 0.300; tth_ikR = 0.755; tth_ikG = 0.778; tth_ikB = 0.815; tth_bgR = 0.051; tth_bgG = 0.053; tth_bgB = 0.058; tth_pnR = 0.072; tth_pnG = 0.076; tth_pnB = 0.082; tth_bdR = 0.126; tth_bdG = 0.136; tth_bdB = 0.155; tth_knR = 0.106; tth_knG = 0.107; tth_knB = 0.110; ) :
  i == 7 ? ( tth_tint = 1; accR = 0.620; accG = 0.480; accB = 1.000; tth_dmR = 0.533; tth_dmG = 0.413; tth_dmB = 0.860; tth_alR = 1.000; tth_alG = 0.720; tth_alB = 0.400; tth_ikR = 0.778; tth_ikG = 0.773; tth_ikB = 0.815; tth_bgR = 0.054; tth_bgG = 0.053; tth_bgB = 0.058; tth_pnR = 0.077; tth_pnG = 0.075; tth_pnB = 0.082; tth_bdR = 0.139; tth_bdG = 0.133; tth_bdB = 0.155; tth_knR = 0.108; tth_knG = 0.107; tth_knB = 0.110; ) :
  i == 8 ? ( tth_tint = 1; accR = 0.176; accG = 0.886; accB = 0.651; tth_dmR = 0.113; tth_dmG = 0.567; tth_dmB = 0.417; tth_alR = 1.000; tth_alG = 0.600; tth_alB = 0.450; tth_ikR = 0.747; tth_ikG = 0.802; tth_ikB = 0.790; tth_bgR = 0.050; tth_bgG = 0.058; tth_bgB = 0.055; tth_pnR = 0.071; tth_pnG = 0.082; tth_pnB = 0.078; tth_bdR = 0.121; tth_bdG = 0.155; tth_bdB = 0.144; tth_knR = 0.105; tth_knG = 0.110; tth_knB = 0.108; ) :
  ( tth_tint = 1; accR = 0.900; accG = 0.930; accB = 0.960; tth_dmR = 0.495; tth_dmG = 0.512; tth_dmB = 0.528; tth_alR = 1.000; tth_alG = 0.700; tth_alB = 0.360; tth_ikR = 0.798; tth_ikG = 0.805; tth_ikB = 0.812; tth_bgR = 0.057; tth_bgG = 0.058; tth_bgB = 0.058; tth_pnR = 0.081; tth_pnG = 0.082; tth_pnB = 0.082; tth_bdR = 0.152; tth_bdG = 0.154; tth_bdB = 0.155; tth_knR = 0.110; tth_knG = 0.110; tth_knB = 0.110; );
  // Schema-Snapshot (Basis fuer den BG-Versatz) + eigener Grund
  tth_sbgR = tth_bgR; tth_sbgG = tth_bgG; tth_sbgB = tth_bgB;
  tth_spnR = tth_pnR; tth_spnG = tth_pnG; tth_spnB = tth_pnB;
  tth_sbdR = tth_bdR; tth_sbdG = tth_bdG; tth_sbdB = tth_bdB;
  tth_sknR = tth_knR; tth_sknG = tth_knG; tth_sknB = tth_knB;
  tth_bgon ? tth_bgmix();
);

// Schema i nur zum Zeichnen der Vorschau: Akzent (tth_sa), Zweitfarbe (tth_sl), Grund (tth_sg) - aendert das aktive Schema nicht
function tth_swatch(i) (
  i == 0 ? ( tth_saR = 0.224; tth_saG = 1.000; tth_saB = 0.078; tth_slR = 1.000; tth_slG = 0.702; tth_slB = 0.361; tth_sgR = 0.050; tth_sgG = 0.054; tth_sgB = 0.050; ) :
  i == 1 ? ( tth_saR = 0.133; tth_saG = 0.827; tth_saB = 0.933; tth_slR = 1.000; tth_slG = 0.620; tth_slB = 0.300; tth_sgR = 0.050; tth_sgG = 0.054; tth_sgB = 0.050; ) :
  i == 2 ? ( tth_saR = 1.000; tth_saG = 0.353; tth_saB = 0.122; tth_slR = 0.350; tth_slG = 0.850; tth_slB = 1.000; tth_sgR = 0.050; tth_sgG = 0.054; tth_sgB = 0.050; ) :
  i == 3 ? ( tth_saR = 0.878; tth_saG = 0.251; tth_saB = 0.984; tth_slR = 0.350; tth_slG = 1.000; tth_slB = 0.750; tth_sgR = 0.050; tth_sgG = 0.054; tth_sgB = 0.050; ) :
  i == 4 ? ( tth_saR = 1.000; tth_saG = 0.839; tth_saB = 0.039; tth_slR = 0.450; tth_slG = 0.750; tth_slB = 1.000; tth_sgR = 0.050; tth_sgG = 0.054; tth_sgB = 0.050; ) :
  i == 5 ? ( tth_saR = 1.000; tth_saG = 0.176; tth_saB = 0.333; tth_slR = 1.000; tth_slG = 0.780; tth_slB = 0.350; tth_sgR = 0.058; tth_sgG = 0.050; tth_sgB = 0.051; ) :
  i == 6 ? ( tth_saR = 0.300; tth_saG = 0.550; tth_saB = 1.000; tth_slR = 1.000; tth_slG = 0.750; tth_slB = 0.300; tth_sgR = 0.051; tth_sgG = 0.053; tth_sgB = 0.058; ) :
  i == 7 ? ( tth_saR = 0.620; tth_saG = 0.480; tth_saB = 1.000; tth_slR = 1.000; tth_slG = 0.720; tth_slB = 0.400; tth_sgR = 0.054; tth_sgG = 0.053; tth_sgB = 0.058; ) :
  i == 8 ? ( tth_saR = 0.176; tth_saG = 0.886; tth_saB = 0.651; tth_slR = 1.000; tth_slG = 0.600; tth_slB = 0.450; tth_sgR = 0.050; tth_sgG = 0.058; tth_sgB = 0.055; ) :
  ( tth_saR = 0.900; tth_saG = 0.930; tth_saB = 0.960; tth_slR = 1.000; tth_slG = 0.700; tth_slB = 0.360; tth_sgR = 0.057; tth_sgG = 0.058; tth_sgB = 0.058; );
);

function tth_name(i) (
  i == 0 ? "ACID" : i == 1 ? "CYAN" : i == 2 ? "ORANGE" : i == 3 ? "MAGENTA" : i == 4 ? "YELLOW"
  : i == 5 ? "RED" : i == 6 ? "BLUE" : i == 7 ? "VIOLET" : i == 8 ? "MINT" : "ICE";
);

// Tint (nur Schemata 5..9; die klassischen 0..4 lassen die Grautoene unveraendert): uebertraegt einen gruenlich getoenten Grauwert (r,g,b - Acid-Look) ins aktive Schema; bei ACID exakt neutral.
function tth_tn(r, g, b, a) local(f) (
  f = tth_tint ? max(0, (g - (r + b)*0.5)/0.849) : 0;
  gfx_set(min(1, max(0, r + f*(accR - 0.224))), min(1, max(0, g + f*(accG - 1.000))), min(1, max(0, b + f*(accB - 0.078))), a);
);

// Textfarbe der Schrift-Slots (P20): FONT 1 = Slot 1 (Titel), FONT 2 = Slots 2..5 (Text).
// Wird am Ende der Kit-Textfunktionen vor gfx_drawstr aufgerufen; Alpha des Aufrufers bleibt.
// Ohne eigene Farbe (tth_f*on = 0) tut sie nichts.
function tth_txt() local(f) (
  f = gfx_getfont(#tth_tf) + 1;      // P25: gfx_getfont liefert den Slot MINUS 1 (gemessen: setfont 1/2/3 -> 0/1/2, Vorgabe -1; _shared/spikes/spk_getfont)
  (tth_f1on && f == 1) ? gfx_set(tth_f1R, tth_f1G, tth_f1B, gfx_a)
  : (tth_f2on && f >= 2 && f <= 5) ? gfx_set(tth_f2R, tth_f2G, tth_f2B, gfx_a);
);

function tth_sync(v) ( v != tth_cur ? tth_apply(v); );

function tth_inbox(x, y, w, h) ( tth_rmx >= x && tth_rmx < x + w && tth_rmy >= y && tth_rmy < y + h; );


// UI-Zoom: echte Vektorzeichnung in der gewaehlten Groesse, keine skalierte Bitmap.
// JSFX kann sein Hostfenster nicht vergroessern. Bei Ueberlauf bleibt die gesamte Front
// ueber die Scrollleisten erreichbar; OPTIONS bleibt fest am sichtbaren oberen Rand.
//
// AUTO FIT (10.10.2026): Mit der OPTIONS-Box (UI SIZE, Version 5) fiel das fruehere Mitwachsen der Front mit dem
// Fenster weg - das Fenster zu ziehen aenderte nichts mehr. Jetzt gilt: aendert sich die Fenstergroesse (Ziehen am Rand,
// Andocken, Monitorwechsel), wird tth_uisize auf den groessten ganzzahligen Prozentwert gesetzt, bei dem die ganze Front
// ins Fenster passt (25..400 %). Die Zoom-Tasten und das Prozentfeld bleiben unberuehrt: sie setzen tth_uisize direkt und
// gelten bis zur naechsten Fensteraenderung. Abschaltbar ueber tth_autooff (OPTIONS: AUTO FIT ON/OFF, pro Instanz
// serialisiert). Der erste Frame nach dem Laden nimmt nur das Fenstermass auf (der gespeicherte Zoom bleibt); beim
// Einschalten wird einmal sofort angepasst (tth_afreq). Eine automatische Anpassung setzt keinen Undo-Punkt (tth_fitchg).
// Unter Test-Freigabe (gmem[tth_gmb - 1] = 20261001) ist AUTO FIT aus, solange gmem[tth_gmb + 34] != 1: die Screenshot-Rigs
// verschieben und skalieren das FX-Fenster und duerfen dabei den Zoom nicht aendern (Zeile steht vor tt_testok - daher inline).
function tth_autofit(w, h) local(v, tst) (
  tst = gmem[tth_gmb - 1] == 20261001 && gmem[tth_gmb + 34] != 1;
  (tth_afW <= 0 || gfx_w != tth_afW || gfx_h != tth_afH || tth_afreq) ? (
    (tth_afW > 0 || tth_afreq) && !tth_autooff && !tst && w > 0 && h > 0 ? (
      v = max(25, min(400, floor(min(gfx_w/w, gfx_h/h)*100 + 0.0001)));
      v != tth_uisize ? ( tth_uisize = v; tth_panx = 0; tth_pany = 0; tth_fitchg = 1; );
    );
    tth_afW = gfx_w; tth_afH = gfx_h; tth_afreq = 0;
  );
);
function tth_view(w, h) local(vw, vh, cw, ch) (
  tth_vw = w; tth_vh = h;
  tth_autofit(w, h);
  SC = tth_uisize / 100;
  cw = w*SC; ch = h*SC;
  vw = gfx_w; vh = gfx_h;
  // 10.10.2026: 0,01 Pixel Toleranz - eine auf ganze Prozent abgerundete Front passt rechnerisch, kann aber durch
  // Gleitkomma einen Hauch ueber der Fensterkante liegen und haette dann eine Scrollleiste ausgeloest.
  // Historie: tth_vbar = ch > vh; tth_hbar = cw > vw - 14*tth_vbar; tth_vbar = ch > vh - 14*tth_hbar;
  tth_vbar = ch > vh + 0.01; tth_hbar = cw > vw - 14*tth_vbar + 0.01;
  tth_vbar = ch > vh - 14*tth_hbar + 0.01;
  tth_visw = max(1, vw - 14*tth_vbar); tth_vish = max(1, vh - 14*tth_hbar);
  tth_maxx = max(0, cw - tth_visw); tth_maxy = max(0, ch - tth_vish);
  tth_panx = max(0, min(tth_maxx, tth_panx)); tth_pany = max(0, min(tth_maxy, tth_pany));
  OX = max(0, (tth_visw - cw)*0.5) - tth_panx;
  OY = max(0, (tth_vish - ch)*0.5) - tth_pany;
  mX = (mouse_x - OX)/SC; mY = (mouse_y - OY)/SC;
);
function tth_parsepercent(s) local(n,i,k,v,ok) (
  n=strlen(s); i=0; v=0; ok=n>0 && n<=3;
  loop(n, k=str_getchar(s,i); ok=ok && k>=48 && k<=57; v=v*10+k-48; i+=1; );
  ok && v>0 ? v : 0;
);
function tth_size(v) (
  // 10.10.2026: Untergrenze 25 statt 50 (AUTO FIT darf ein kleines Fenster ausfuellen; Historie: max(50, ...)).
  v = max(25, min(400, floor(v + 0.5)));
  v != tth_uisize ? ( tth_uisize = v; tth_panx = 0; tth_pany = 0; tt_undoreq = 1; );
);
function tth_sizekey(k) local(v) (
k==13 ? ( v=tth_parsepercent(#tth_szinput); v>0 ? tth_size(v); tth_edit=0; )
        : k==27 ? tth_edit=0
        : k==8 ? ( tth_editfirst=0; strcpy_substr(#tth_szback,#tth_szinput,0,max(0,strlen(#tth_szinput)-1)); strcpy(#tth_szinput,#tth_szback); )
        : k>=48 && k<=57 ? (
          tth_editfirst ? ( strcpy(#tth_szinput,""); tth_editfirst=0; );
          strlen(#tth_szinput)<3 ? ( sprintf(#tth_szchar,"%c",k); strcat(#tth_szinput,#tth_szchar); );
        );
);
// Hilfetexte der OPTIONS-/Scroll-Elemente benutzen Fensterpixel und rohe Maus.
function tth_hint(x,y,w,h,s) (
  tth_inbox(x,y,w,h) ? ( strcpy(#tth_help,s); tth_helpon = 1; );
);
function tth_hintflush() local(t,x,y,w,h,fs,n,st,e,k,nl,lw,lh,d) (
  tth_helpon && !tth_tipoff && !(tth_rcap0 & 1) ? (
    t = time_precise();
    strcmp(#tth_help,#tth_helpprev) ? ( strcpy(#tth_helpprev,#tth_help); tth_helptime = t; );
    t - tth_helptime >= 0.35 ? (
      fs = max(11, floor(12*min(2,tth_uisize/100)+0.5));
      gfx_setfont(16,"Arial",fs);
      // Lange Hilfe auch bei 300 % vollstaendig im Fenster halten; reale Zeilenbreite messen.
      n=strlen(#tth_help); st=0; nl=0; w=0;
      loop(4,
        st<n ? (
          e=n; d=nl==0 ? #tth_hl0 : nl==1 ? #tth_hl1 : nl==2 ? #tth_hl2 : #tth_hl3;
          strcpy_substr(d,#tth_help,st,e-st); gfx_measurestr(d,lw,lh);
          while(lw>max(1,gfx_w-16) && e>st+1) (
            e-=1; strcpy_substr(d,#tth_help,st,e-st); gfx_measurestr(d,lw,lh);
          );
          e<n ? (
            k=e; while(k>st+1 && str_getchar(#tth_help,k)!=32) ( k-=1; );
            k>st+1 ? ( e=k; strcpy_substr(d,#tth_help,st,e-st); gfx_measurestr(d,lw,lh); );
          );
          w=max(w,lw); st=e; str_getchar(#tth_help,st)==32 ? st+=1; nl+=1;
        );
      );
      w += 16; h = nl*lh+10;
      x = max(0,min(tth_rmx+14,gfx_w-w)); y = max(0,min(tth_rmy+18,gfx_h-h));
      gfx_set(tth_bgR,tth_bgG,tth_bgB,1); gfx_rect(x,y,w,h,1);
      gfx_set(accR,accG,accB,1); gfx_rect(x,y,w,h,0);
      gfx_set(tth_ikR,tth_ikG,tth_ikB,1); k=0;
      loop(nl, d=k==0 ? #tth_hl0 : k==1 ? #tth_hl1 : k==2 ? #tth_hl2 : #tth_hl3;
        gfx_x=x+8; gfx_y=y+5+k*lh; gfx_drawstr(d); k+=1;
      );
    );
  ) : strcpy(#tth_helpprev,"");
  tth_helpon = 0;
);
function tth_scrollbars() local(l,p) (
  tth_hbar ? (
    gfx_set(tth_bgR,tth_bgG,tth_bgB,1); gfx_rect(0,tth_vish,tth_visw,14,1);
    l=max(24,tth_visw*tth_visw/(tth_vw*SC)); p=tth_maxx>0 ? tth_panx/tth_maxx*(tth_visw-l) : 0;
    gfx_set(accR,accG,accB,0.8); gfx_rect(p,tth_vish+3,l,8,1);
    tth_hint(0,tth_vish,tth_visw,14,"Scroll horizontally to reach the enlarged front.");
  );
  tth_vbar ? (
    gfx_set(tth_bgR,tth_bgG,tth_bgB,1); gfx_rect(tth_visw,0,14,tth_vish,1);
    l=max(24,tth_vish*tth_vish/(tth_vh*SC)); p=tth_maxy>0 ? tth_pany/tth_maxy*(tth_vish-l) : 0;
    gfx_set(accR,accG,accB,0.8); gfx_rect(tth_visw+3,p,8,l,1);
    tth_hint(tth_visw,0,14,tth_vish,"Scroll vertically to reach the enlarged front.");
  );
);

// Kleine Schaltflaeche der Box: Panel + Rahmen (Akzent bei hot/on), Text zentriert in Akzentfarbe.
function tth_sbtn(x, y, w, h, s, hot, on) (
  gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(x, y, w, h, 1);
  (hot || on) ? gfx_set(accR, accG, accB, 0.95) : gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  gfx_rect(x, y, w, h, 0);
  gfx_set(accR, accG, accB, (hot || on) ? 1 : 0.85);
  gfx_measurestr(s, tth_tw, tth_th);
  gfx_x = x + (w - tth_tw)*0.5; gfx_y = y + (h - tth_th)*0.5; gfx_drawstr(s);
);

// Aktive Farbe des Waehler-Ziels (fuer Vorschau + Ruecknahme in den Waehler)
function tth_tgtcol() (
  tth_ctgt == 0 ? ( tth_tr = tth_f1on ? tth_f1R : accR;       tth_tg = tth_f1on ? tth_f1G : accG;        tth_tb = tth_f1on ? tth_f1B : accB; )
  : tth_ctgt == 1 ? ( tth_tr = tth_f2on ? tth_f2R : tth_ikR;  tth_tg = tth_f2on ? tth_f2G : tth_ikG;     tth_tb = tth_f2on ? tth_f2B : tth_ikB; )
  : ( tth_tr = tth_bgR; tth_tg = tth_bgG; tth_tb = tth_bgB; );
);

// Waehler-Farbe (tth_ch/cs/cv -> RGB) live auf das Ziel anwenden
function tth_pick() (
  tth_hsv(tth_ch, tth_cs, tth_cv);
  tth_ctgt == 0 ? ( tth_f1on = 1; tth_f1R = tth_hr; tth_f1G = tth_hg; tth_f1B = tth_hb; )
  : tth_ctgt == 1 ? ( tth_f2on = 1; tth_f2R = tth_hr; tth_f2G = tth_hg; tth_f2B = tth_hb; )
  : ( tth_bgon = 1; tth_bgUR = tth_hr; tth_bgUG = tth_hg; tth_bgUB = tth_hb; tth_bgmix(); );
);

// Ein Ziel aufs Schema zuruecksetzen (Schriftfarben wirken beim Zeichnen, Grund per Neu-Anwenden)
function tth_reset_tgt() (
  tth_ctgt == 0 ? ( tth_f1on = 0; )
  : tth_ctgt == 1 ? ( tth_f2on = 0; )
  : ( tth_bgon = 0; tth_apply(tth_cur); );
);

// Testhaken (P20): nur aktiv, wenn das Produkt tth_test = 1 setzt (und options:gmem deklariert hat).
// gmem[5190] = Kommando, wird nach der Ausfuehrung auf 0 geschrieben:
//   1 = Box oeffnen, 2 = schliessen,
//   3 = Stil setzen: gmem[5191]=f1sz, [5192]=f2sz, [5193]=Ziel(-1 = keins, 0/1/2), [5194..5196]=h/s/v,
//       [5197] = -1 RESET Ziel, -2 RESET ALL
//   4 = Stil-Zustand -> gmem[5200..5211] (f1sz,f2sz,f1on,f1rgb,f2on,f2rgb,bgon,bgUrgb)
//   5 = WCAG-Kontraste -> gmem[5200..5206] (dm/ik/al/acc gegen pn, dm/ik/acc gegen bg)
//   6 = Schema setzen (gmem[5191] = 0..9)
//   7 = Tooltips setzen (gmem[5191] = 1 an / 0 aus); Kommando 4 meldet tth_tipoff zusaetzlich in gmem[5214]
//   8 = UI-Zoom setzen (gmem[5191] = Prozent), 9 = AUTO FIT setzen (gmem[5191] = 1 an / 0 aus); Kommando 4 meldet tth_autooff in gmem[5223]
//   gmem[5224] = 1 schaltet AUTO FIT unter Test-Freigabe scharf (sonst aus, s. tth_autofit)
// HINWEIS: steht bewusst hinter tth_pick/tth_reset_tgt — EEL2 kompiliert Funktionsrumpf erst
// beim ersten Aufruf, ein Aufruf einer noch nicht definierten Funktion ist dann ein Laufzeitfehler.
// P25: Basisadresse der Testzellen. Vorgabe 5190; ein Produkt, dessen gmem-Namespace dort eigene Daten haelt
// (Schwesterprodukte S3 / S1: Ring im Namespace ttab), setzt tth_gmb VOR dem Modul auf einen freien Bereich.
// Die Kommentare oben nennen die Vorgabe-Adressen (5190 = tth_gmb).
tth_gmb == 0 ? ( tth_gmb = 5190; );
// P25: Test-Freigabe der Suite. Test-Skripte schreiben zuerst die Kennung 20261001 nach gmem[tth_gmb - 1].
// Ohne Kennung sind der Theme-Testhaken UND alle schreibenden Test-Kommandos der Produkte wirkungslos
// (Produkte pruefen tt_testok() vor jedem zerstoerenden Test-Kommando). tth_test wird nicht mehr gebraucht.
function tt_testok() ( gmem[tth_gmb - 1] == 20261001; );
function tth_testcmd() (
  tth_gm = gmem[tth_gmb];
  tth_gm == 1 ? ( tth_open = 1; gmem[tth_gmb] = 0; )
  : tth_gm == 2 ? ( tth_open = 0; gmem[tth_gmb] = 0; )
  : tth_gm == 3 ? (
      tth_f1sz = max(-4, min(8, floor(gmem[tth_gmb + 1]))); tth_f2sz = max(-4, min(8, floor(gmem[tth_gmb + 2])));
      gmem[tth_gmb + 3] >= 0 ? (
        tth_ctgt = max(0, min(2, floor(gmem[tth_gmb + 3])));
        tth_ch = gmem[tth_gmb + 4]; tth_cs = gmem[tth_gmb + 5]; tth_cv = gmem[tth_gmb + 6]; tth_pick();
      );
      gmem[tth_gmb + 7] == -1 ? tth_reset_tgt()
      : gmem[tth_gmb + 7] == -2 ? ( tth_f1on = 0; tth_f2on = 0; tth_bgon = 0; tth_f1sz = 0; tth_f2sz = 0; tth_apply(tth_cur); );
      gmem[tth_gmb] = 0;
    )
  : tth_gm == 4 ? (
      gmem[tth_gmb + 10] = tth_f1sz; gmem[tth_gmb + 11] = tth_f2sz;
      gmem[tth_gmb + 12] = tth_f1on; gmem[tth_gmb + 13] = tth_f1R; gmem[tth_gmb + 14] = tth_f1G; gmem[tth_gmb + 15] = tth_f1B;
      gmem[tth_gmb + 16] = tth_f2on; gmem[tth_gmb + 17] = tth_f2R; gmem[tth_gmb + 18] = tth_f2G; gmem[tth_gmb + 19] = tth_f2B;
      gmem[tth_gmb + 20] = tth_bgon; gmem[tth_gmb + 21] = tth_bgUR; gmem[tth_gmb + 22] = tth_bgUG; gmem[tth_gmb + 23] = tth_bgUB;
      gmem[tth_gmb + 24] = tth_tipoff;
      gmem[tth_gmb + 25] = tth_uisize; gmem[tth_gmb + 26] = tth_panx; gmem[tth_gmb + 27] = tth_pany;
      gmem[tth_gmb + 28] = tth_ctgt; gmem[tth_gmb + 29] = SC; gmem[tth_gmb + 30] = tth_cur;
      gmem[tth_gmb + 33] = tth_autooff;      // 10.10.2026 (31/32 belegt S3 PRE)
      gmem[tth_gmb + 35] = gfx_w; gmem[tth_gmb + 36] = gfx_h; gmem[tth_gmb + 37] = tth_vbar + 2*tth_hbar;   // 10.10.2026: Fenstermass und Scrollleisten (Test)
      gmem[tth_gmb] = 0;
    )
  : tth_gm == 5 ? (
      gmem[tth_gmb + 10] = tth_cr(tth_dmR, tth_dmG, tth_dmB, tth_pnR, tth_pnG, tth_pnB);
      gmem[tth_gmb + 11] = tth_cr(tth_ikR, tth_ikG, tth_ikB, tth_pnR, tth_pnG, tth_pnB);
      gmem[tth_gmb + 12] = tth_cr(tth_alR, tth_alG, tth_alB, tth_pnR, tth_pnG, tth_pnB);
      gmem[tth_gmb + 13] = tth_cr(accR, accG, accB, tth_pnR, tth_pnG, tth_pnB);
      gmem[tth_gmb + 14] = tth_cr(tth_dmR, tth_dmG, tth_dmB, tth_bgR, tth_bgG, tth_bgB);
      gmem[tth_gmb + 15] = tth_cr(tth_ikR, tth_ikG, tth_ikB, tth_bgR, tth_bgG, tth_bgB);
      gmem[tth_gmb + 16] = tth_cr(accR, accG, accB, tth_bgR, tth_bgG, tth_bgB);
      gmem[tth_gmb] = 0;
    )
  : tth_gm == 6 ? ( tth_apply(max(0, min(9, floor(gmem[tth_gmb + 1])))); gmem[tth_gmb] = 0; )
  : tth_gm == 7 ? ( tth_tipoff = gmem[tth_gmb + 1] > 0.5 ? 0 : 1; gmem[tth_gmb] = 0; )
  : tth_gm == 8 ? ( tth_size(gmem[tth_gmb + 1]); gmem[tth_gmb] = 0; )
  : tth_gm == 9 ? ( tth_autooff = gmem[tth_gmb + 1] > 0.5 ? 0 : 1; !tth_autooff ? tth_afreq = 1; gmem[tth_gmb] = 0; );      // 10.10.2026: AUTO FIT setzen (1 = an)
);

// ---------- P25: Host-Meldungen aus @gfx (gemessen in REAPER, _shared/spikes/spk_hostnotify) ----------
// Eine blosse Zuweisung an einen Slider und sliderchange(maske) erzeugen KEINEN Undo-Punkt; slider_automate(maske)
// erzeugt einen (Slider 1..63 ueber die Maske 2^(n-1); Slider 64 nur in Variablenform). @slider laeuft bei Zuweisungen
// aus @gfx nie - Produkte leiten ihre Parameter ueber tt_sldirty (im @block abfragen und loeschen) neu ab.
// tt_slset(n, v): Slider n (1..63) aus @gfx setzen und dem Host melden. Rueckgabe 1 bei Aenderung.
function tt_slset(n, v) (
  abs(slider(n) - v) > 0.0000001 ? ( slider(n) = v; slider_automate(2^(n - 1)); tt_sldirty = 1; 1; ) : 0;
);
// tt_undo(): Zustand OHNE Slider wurde geaendert (Pattern, Kurve, Preset-Bank, Speicherparameter). Der Undo-Punkt
// (sliderchange(-1), "Edit FX") entsteht einmal, sobald die Maustaste los ist - tth_post loest ihn aus.
function tt_undo() ( tt_undoreq = 1; );

// Am Anfang von @gfx: echte Maus merken; solange die Box offen ist, sieht das Produkt keine Maus.
// Maskiert auch den Schliess-Klick (tth_hold, bis die Maustaste losgelassen ist) und den Klick auf den Button selbst.
function tth_pre() (
  tth_rmx = mouse_x; tth_rmy = mouse_y; tth_rcap = mouse_cap; tth_rcap0 = mouse_cap;   // tth_rcap0: bleibt roh (tt_pb_pre nullt tth_rcap bei offenem Overlay)

  tth_helpon = 0;
  // Scrollleisten maskieren die darunter liegende Front; Drag nur auf einer echten Klickflanke beginnen.
  !(tth_rcap & 1) ? tth_sdrag = 0;
  tth_shot = !tth_open && !tt_pb_open && ((tth_hbar && tth_rmy >= tth_vish) || (tth_vbar && tth_rmx >= tth_visw));
  (tth_shot && (tth_rcap & 1) && !(tth_pcap & 1)) ? (
    tth_sdrag = tth_vbar && tth_rmx >= tth_visw ? 2 : 1;
  );
  tth_sdrag == 1 ? (
    tth_slen=max(24,tth_visw*tth_visw/(tth_vw*tth_uisize/100));
    tth_panx=max(0,min(tth_maxx,(tth_rmx-tth_slen*0.5)/max(1,tth_visw-tth_slen)*tth_maxx));
  ) : tth_sdrag == 2 ? (
    tth_slen=max(24,tth_vish*tth_vish/(tth_vh*tth_uisize/100));
    tth_pany=max(0,min(tth_maxy,(tth_rmy-tth_slen*0.5)/max(1,tth_vish-tth_slen)*tth_maxy));
  );
  (tth_shot || tth_sdrag) && mouse_wheel != 0 ? (
    tth_vbar && tth_rmx >= tth_visw ? tth_pany=max(0,min(tth_maxy,tth_pany-mouse_wheel/120*40))
    : tth_panx=max(0,min(tth_maxx,tth_panx-mouse_wheel/120*40));
  );
  (tth_shot || tth_sdrag) ? ( mouse_cap=0; mouse_x=-10000; mouse_y=-10000; mouse_wheel=0; );

  tt_testok() ? tth_testcmd();      // P25: Freigabe per Kennung statt tth_test
  tth_open ? ( tth_hold = 1; );
  (tth_hold && (tth_rcap & 1) == 0 && !tth_open) ? ( tth_hold = 0; );
  // P25: der Knopf maskiert nur, wenn der Druck NICHT ausserhalb begonnen hat. Vorher brach ein Regler-Zug, der den
  // Knopf kreuzte, ab, und beim Verlassen sah das Produkt eine Klickflanke (Phantomklick).
  tth_ib = tth_bw > 0 && tth_rmx >= tth_bx && tth_rmx < tth_bx + tth_bw && tth_rmy >= tth_by && tth_rmy < tth_by + tth_bh;
  (tth_rcap & 1) == 0 ? ( tth_dnout = 0; ) : ( !(tth_pcap & 1) ? ( tth_dnout = !tth_ib; ); );
  (tth_open || tth_hold || (tth_ib && !tth_dnout))
    ? ( mouse_cap = 0; mouse_x = -10000; mouse_y = -10000; mouse_wheel = 0; );
);

// Am Ende von @gfx: Button + Box zeichnen. Rueckgabe: neu gewaehltes Schema (0..9) oder -1.
function tth_post(px, py, sc) local(bw, bh, pw, ph, x0, y0, i, sx, sy, sw, sh, click, hotb, hov, chosen, fs, tw, th, ry, bx1, tx1, tx2, svx, svy, svw, svh, hxx, cxr, syy, warn, v, k, n) (
  tth_scrollbars();
  sc = max(0.25, min(2, sc));   // Review 11.10.2026: wie tt_pb_post (AUTO FIT bis 25 %). Historie: max(0.5, ...)
  // Bei Zoom/Scroll bleibt OPTIONS erreichbar (unabhaengig vom Front-Ursprung).
  tth_hbar || tth_vbar ? ( px = max(4, gfx_w - 80*sc - 14*tth_vbar); py = 4; );
  px = max(4,min(px,gfx_w - 74*sc)); py = max(4,min(py,gfx_h - 21*sc));
  chosen = -1;
  click = (tth_rcap & 1) && !(tth_pcap & 1);
  bw = 70*sc; bh = 17*sc;
  tth_bx = px; tth_by = py; tth_bw = bw; tth_bh = bh;
  hotb = tth_inbox(px, py, bw, bh);
  fs = max(9, floor(10*sc + 0.5));
  tth_fsCur != fs ? ( gfx_setfont(TTH_FONT, "Arial", fs); tth_fsCur = fs; ) : gfx_setfont(TTH_FONT);
  gfx_mode = 0;
  // Box-Skalierung: immer so klein, dass der Kasten komplett ins Fenster passt (P20: 640x520, aber auch S3 560x210)
  // P22: der Schlagschatten (4/5*scb rechts/unten) gehoert zur gezeichneten Flaeche und muss mit in den Clamp.
  tth_scb = max(0.4, min(sc, min((gfx_w - 14)/353, (gfx_h - 10)/357)));
  pw = 348*tth_scb; ph = 352*tth_scb;
  // gezeichnete Flaeche: x0 .. x0+pw+4*scb, y0 .. y0+ph+5*scb -> Klick-/Maskenflaeche = diese Flaeche inkl. Schatten
  x0 = max(4, min(px, gfx_w - pw - 4*tth_scb - 4)); y0 = py + bh + 4*sc;
  y0 + ph + 5*tth_scb > gfx_h - 4 ? ( y0 = max(4, py - ph - 5*tth_scb - 4*sc); );
  y0 = min(y0, gfx_h - ph - 5*tth_scb - 4);
  y0 = max(0, y0);
  // Klick auswerten (Button schaltet um, Klick ausserhalb der GEZEICHNETEN Box inkl. Schatten schliesst - ausser beim Ziehen im Waehler)
  click ? (
    // Ein Klick ausserhalb des Prozentfeldes bestaetigt die Eingabe, auch wenn er die Box schliesst.
    tth_edit && !tth_inbox(x0+252*tth_scb,y0+129*tth_scb,60*tth_scb,17*tth_scb) ? (
      v=tth_parsepercent(#tth_szinput); v>0 ? tth_size(v); tth_edit=0;
    );
    hotb ? ( tth_open = !tth_open; )
    : tth_open && !tth_inbox(x0, y0, pw + 4*tth_scb, ph + 5*tth_scb) && tth_cdrag == 0 ? ( tth_open = 0; );
  );
  // Button
  gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(px, py, bw, bh, 1);
  (tth_open || hotb) ? gfx_set(accR, accG, accB, 0.95) : gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  gfx_rect(px, py, bw, bh, 0);
  gfx_set(accR, accG, accB, 1); gfx_rect(px + 4*sc, py + 4*sc, 9*sc, bh - 8*sc, 1);
  gfx_set(accR, accG, accB, (hotb || tth_open) ? 1 : 0.8);
  gfx_measurestr("OPTIONS", tw, th);
  gfx_x = px + 18*sc; gfx_y = py + (bh - th)*0.5; gfx_drawstr("OPTIONS");
  tth_open ? (
    // Beim ersten Oeffnen / Schemawechsel muss das HSV-Feld zur echten Ziel-Farbe passen.
    (!tth_oprev || tth_cscheme!=tth_cur) ? ( tth_tgtcol(); tth_rgb2hsv(tth_tr,tth_tg,tth_tb); );
    sc = tth_scb;               // ab hier in Box-Skalierung
    fs = max(9, floor(10*sc + 0.5));
    tth_fsCur != fs ? ( gfx_setfont(TTH_FONT, "Arial", fs); tth_fsCur = fs; );
    gfx_set(0, 0, 0, 0.45); gfx_rect(x0 + 4*sc, y0 + 5*sc, pw, ph, 1);
    gfx_set(tth_bgR*1.25, tth_bgG*1.25, tth_bgB*1.25, 1); gfx_rect(x0, y0, pw, ph, 1);
    gfx_set(tth_pnR, tth_pnG, tth_pnB, 1); gfx_rect(x0 + 1, y0 + 1, pw - 2, 22*sc, 1);
    gfx_set(accR, accG, accB, 0.9); gfx_rect(x0, y0, pw, ph, 0);
    gfx_set(0.92, 0.95, 0.92, 1); gfx_x = x0 + 12*sc; gfx_y = y0 + 6*sc; gfx_drawstr("OPTIONS");
    // --- P23: Tooltips an/aus, rechts in der Titelzeile. tth_tipoff = 1 schaltet ALLE Tooltips des Produkts ab
    // (das Kit prueft es in tt_tip; Produkte mit eigener Tooltip-Zeichnung pruefen tth_tipoff selbst).
    // Bewusst als "off"-Flag: Vorgabe 0 = Tooltips an, auch ohne Vorbelegung und bei Alt-Chunks.
    bx1 = x0 + pw - 100*sc;
    tth_sbtn(bx1, y0 + 3*sc, 92*sc, 16*sc, tth_tipoff ? "TOOLTIPS OFF" : "TOOLTIPS ON", tth_inbox(bx1, y0 + 3*sc, 92*sc, 16*sc), !tth_tipoff);
    (click && tth_cdrag == 0 && tth_inbox(bx1, y0 + 3*sc, 92*sc, 16*sc)) ? ( tth_tipoff = !tth_tipoff; );
    tth_hint(bx1,y0+3*sc,92*sc,16*sc,"Enable or disable all tooltips for this instance.");
    gfx_set(tth_dmR, tth_dmG, tth_dmB, 1); gfx_x = x0 + 12*sc; gfx_y = y0 + 28*sc; gfx_drawstr("COLOR");
    // --- Schema-Felder
    hov = -1;
    sw = 36*sc; sh = 26*sc;
    i = 0;
    loop(10,
      sx = x0 + 12*sc + (i % 5)*(sw + 6*sc);
      sy = y0 + 42*sc + floor(i/5)*(sh + 7*sc);
      tth_inbox(sx, sy, sw, sh) ? ( hov = i; click && tth_cdrag == 0 ? ( chosen = i; ); );
      tth_swatch(i);
      tth_hint(sx,sy,sw,sh,"Choose the colour scheme for this instance.");
      gfx_set(tth_sgR, tth_sgG, tth_sgB, 1); gfx_rect(sx, sy, sw, sh, 1);
      gfx_set(tth_saR, tth_saG, tth_saB, 1); gfx_rect(sx + 2, sy + 2, sw - 4, (sh - 4)*0.62, 1);
      gfx_set(tth_slR, tth_slG, tth_slB, 1); gfx_rect(sx + 2, sy + 2 + (sh - 4)*0.68, sw - 4, (sh - 4)*0.32, 1);
      i == tth_cur ? ( gfx_set(1, 1, 1, 1); gfx_rect(sx - 1, sy - 1, sw + 2, sh + 2, 0); gfx_rect(sx, sy, sw, sh, 0); )
      : i == hov ? ( gfx_set(1, 1, 1, 0.6); gfx_rect(sx, sy, sw, sh, 0); );
      i += 1;
    );

    // --- UI SIZE: fuenf Stufen plus direkt editierbarer Prozentwert.
    gfx_set(tth_pnR,tth_pnG,tth_pnB,1); gfx_rect(x0+12*sc,y0+108*sc,pw-24*sc,1,1);
    gfx_set(tth_dmR,tth_dmG,tth_dmB,1); gfx_x=x0+12*sc; gfx_y=y0+112*sc; gfx_drawstr("UI SIZE");
    // 10.10.2026: AUTO FIT - das Fenster ziehen passt den UI-Zoom an (OFF: der gewaehlte Zoom bleibt, Scrollleisten wie bisher).
    bx1 = x0 + pw - 100*sc;
    tth_sbtn(bx1, y0 + 110*sc, 92*sc, 16*sc, tth_autooff ? "AUTO FIT OFF" : "AUTO FIT ON", tth_inbox(bx1, y0 + 110*sc, 92*sc, 16*sc), !tth_autooff);
    (click && tth_cdrag == 0 && tth_inbox(bx1, y0 + 110*sc, 92*sc, 16*sc)) ? ( tth_autooff = !tth_autooff; !tth_autooff ? tth_afreq = 1; );
    tth_hint(bx1,y0+110*sc,92*sc,16*sc,"When on, resizing the window rescales the UI to fit it; the zoom buttons still work. Off keeps the chosen zoom.");
    i=0;
    loop(5,
      v=i==0 ? 100 : i==1 ? 125 : i==2 ? 150 : i==3 ? 200 : 300;
      sx=x0+12*sc+i*47*sc; sy=y0+129*sc;
      sprintf(#tth_szlabel,"%d%%",v);
      tth_sbtn(sx,sy,43*sc,17*sc,#tth_szlabel,tth_inbox(sx,sy,43*sc,17*sc),tth_uisize==v);
      click && tth_inbox(sx,sy,43*sc,17*sc) ? ( tth_size(v); tth_edit=0; );
      tth_hint(sx,sy,43*sc,17*sc,"Set UI zoom; scrollbars keep enlarged controls reachable.");
      i+=1;
    );
    sx=x0+252*sc; sy=y0+129*sc;
    !tth_edit ? sprintf(#tth_szinput,"%d",tth_uisize);
    tth_sbtn(sx,sy,60*sc,17*sc,#tth_szinput,tth_inbox(sx,sy,60*sc,17*sc),tth_edit);
    gfx_set(tth_ikR,tth_ikG,tth_ikB,1); gfx_x=sx+64*sc; gfx_y=sy+2*sc; gfx_drawstr("%");
    tth_hint(sx,sy,60*sc,17*sc,"Enter UI zoom from 25 to 400 percent; Enter applies, Escape cancels.");
    click && tth_inbox(sx,sy,60*sc,17*sc) ? ( tth_edit=1; tth_editfirst=1; );
    tth_edit ? (
      k=gfx_getchar(); n=0;
      while(k>0 && n<32) (
        tth_sizekey(k);
        k=gfx_getchar(); n+=1;
      );
      click && !tth_inbox(sx,sy,60*sc,17*sc) ? (
