  ui_sh = inBox(256, 550, 90, 22);
  (ui_sh && mouse_wheel != 0) ? (
    pg_set(2, min(16777215, max(0, floor(slider2) + (mouse_wheel > 0 ? 1 : 0 - 1) * ((mouse_cap & 8) ? 16 : 1))));
  );
  (ui_sh && uiRClk) ? ( pg_set(2, 0); );
  pg_hint(256, 550, 90, 22, "SEED (24 bit). Wheel = +-1 (Shift = 16), right-click = 0. With LOCK the same seed always gives the same pattern");
  pg_tgl(3, 350, 550, 52, 22, "LOCK", "LOCK SEED: GENERATE reuses the seed (repeatable). Unlocked: every GENERATE draws a new seed");
  pg_act(406, 550, 40, 22, "NEW", "Draw a new random seed without generating") ? ( pg_postU(23, 0, 0, 0); );
  // MUT %: slider 17 (rate of the classic mutation), effective only with ALGO = CLASSIC MUT
  ui_mutOn = floor(slider4) == 4 ? 1 : 0;
  gfx_setfont(5); ui_mutOn ? colInk(0.85) : colInk(0.5);
  xstr(452, 556, "MUT %");
  ui_v = hsliderst(33, 486, 553, 62, 14, slider17, 0, 100, 30, 1); ui_v != slider17 ? ( pg_set(17, floor(ui_v + 0.5)); );
  sprintf(#ui_s, "%d", slider17); gfx_setfont(5); ui_mutOn ? colAcid(1) : colInk(0.5);
  xstr(554, 556, #ui_s);
  ui_mutOn == 0 ? ( gfx_set(0.02, 0.03, 0.02, 0.45); xrect(486, 553, 62, 14); );
  pg_hint(452, 550, 128, 22, "MUTATE %: per-step mutation rate of the CLASSIC MUT algorithm (a library pattern is mutated while generating). Only active with ALGO = CLASSIC MUT");
  // MUTATE WHAT
  ui_i = 0;
  loop(4,
    ui_j = ui_i;
    ui_i += 1;
