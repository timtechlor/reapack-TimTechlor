// ---------- Kommando-Ring: @gfx (und Testhooks) schreiben, nur @block fuehrt aus ----------
// P25 (A11): Rueckgabe 1 = eingereiht, 0 = Ring voll (verworfen). pg_ringFree() = freie Plaetze (Ring 64, einer bleibt leer).
function pg_post(c, a, b, d) local(p) (
  ((pg_cw + 1) % 64) != pg_cr ? (
    p = M_CMD + pg_cw * 4;
    p[0] = c; p[1] = a; p[2] = b; p[3] = d;
    pg_cw = (pg_cw + 1) % 64;
    pg_cmdW += 1;   // 0.7.0: Zaehler fuer "WAITING FOR AUDIO" (Front: geschrieben - ausgefuehrt)
    1;
  ) : 0;
);
function pg_ringFree() ( (pg_cr - pg_cw - 1 + 128) % 64; );

function pg_exec(c, a, b, d) local(slot, len) (
  slot = min(7, max(0, floor(slider1)));
  len = M_LEN[slot];
  c == 1 ? ( pg_doGenerate(slot); )
  : c == 2 ? ( pg_doMutate(slot, a, b); )
  : c == 3 ? ( pg_undoSave(slot); pg_rotate(slot, a); )
  : c == 4 ? ( pg_undoSave(slot); pg_reverse(slot); )
  : c == 5 ? ( pg_undoSave(slot); pg_invert(slot); )
  : c == 6 ? ( pg_undoSave(slot); pg_double(slot); )
  : c == 7 ? ( pg_undoSave(slot); pg_clear(slot); )
  : c == 8 ? ( pg_copy(slot); )
  : c == 9 ? ( pg_paste(slot); )
  : c == 10 ? ( pg_undoDo(); )
  : c == 11 ? ( M_PAT[slot * 32 + min(31, max(0, a))] = b; )
  : c == 12 ? ( pg_set_note(slot, min(31, max(0, a)), b); )
  : c == 13 ? ( pg_move(slot, min(31, max(0, a)), b); )
  : c == 14 ? ( pg_set_flags(slot, min(31, max(0, a)), b, 0 - 1, 0 - 1); )
  : c == 15 ? ( pg_set_flags(slot, min(31, max(0, a)), 0 - 1, b, 0 - 1); )
  : c == 16 ? ( pg_set_flags(slot, min(31, max(0, a)), 0 - 1, 0 - 1, b); )
  : c == 17 ? ( pg_set_oct(slot, min(31, max(0, a)), b); )
  : c == 18 ? ( pg_set_prob(slot, min(31, max(0, a)), b); )
  : c == 19 ? ( M_LEN[slot] = min(32, max(1, floor(a))); )
  : c == 20 ? ( pg_loadLib(slot, min(31, max(0, floor(a)))); )
  : c == 21 ? (
      M_CHS[min(15, max(0, a))] = b < 0 ? 0 - 1 : min(7, floor(b));
      M_CHR[min(15, max(0, a))] = min(8, max(1, d));
    )
  : c == 22 ? ( pg_stStart(a, b, d); )
  : c == 23 ? ( pg_newSeed(); )
  : c == 25 ? ( pg_panic(0); )
  : c == 26 ? ( M_PAT[min(7, max(0, a)) * 32 + min(31, max(0, b))] = d; )
  : c == 27 ? ( M_LEN[min(7, max(0, a))] = min(32, max(1, floor(b))); )
  : c == 30 ? ( pg_pbApply(); )
  : c == 31 ? ( pg_pbInit(); )
  : c == 32 ? ( pg_pbAck += 1; )
  : c == 33 ? ( pg_pbCapture(); tt_pb_defname(min(31, max(0, floor(a)))); tt_pb_commit(min(31, max(0, floor(a))), PG_PBW); )
  : c == 34 ? ( tt_pb_fetch(min(31, max(0, floor(a)))) > 0 ? ( memcpy(PG_PBA, tt_pb_buf, PG_PBW); pg_pbApply(); tt_pb_select(2, min(31, max(0, floor(a)))); ); )
  : c == 35 ? ( floor(a) >= PG_NLIB ? ( pg_scnBuild(min(PG_NSCN - 1, floor(a) - PG_NLIB)); pg_pbApply(); tt_pb_select(1, min(PG_NFAC - 1, floor(a))); ) : ( pg_loadLib(slot, min(31, max(0, floor(a)))); tt_pb_select(1, min(31, max(0, floor(a)))); ); )   // 0.6.0: a >= 32 = Szene
  : c == 37 ? ( pg_scnBuild(min(PG_NSCN - 1, max(0, floor(a)))); pg_pbApply(); tt_pb_select(1, PG_NLIB + min(PG_NSCN - 1, max(0, floor(a)))); )   // 0.6.0: Szene a (0..15) anwenden (Test)
  : c == 39 ? ( pg_pbCapture(); tt_pb_commit(min(31, max(0, floor(a))), PG_PBW); )   // 1.0.6 (dsh F4): SAVE im @block (war @gfx: Capture las M_PAT/Slider mitten im Kommando)
  : c == 52 ? ( pg_scnBuild(min(PG_NSCN - 1, max(0, floor(a)))); pg_pbApply(); )     // 1.0.6 (dsh F4): Szenenbau wie 37, ohne tt_pb_select (die Leiste waehlt den Eintrag selbst)
  : c == 42 ? ( pg_rcopy(slot, a, b); )          // 0.7.0 (Stufe 2): Bereichs-Operationen, a / b = von / bis (0-basiert), d = Parameter
  : c == 43 ? ( pg_rpaste(slot, a); )
  : c == 44 ? ( pg_rclear(slot, a, b); )
  : c == 45 ? ( pg_rtrans(slot, a, b, d); )
  : c == 46 ? ( pg_roct(slot, a, b, d); )
  : c == 47 ? ( pg_rrot(slot, a, b, d); )
  : c == 48 ? ( pg_rrev(slot, a, b); )
  : c == 49 ? ( pg_rinv(slot, a, b); )
  : c == 50 ? ( pg_rdup(slot, a, b); )
  : c == 51 ? ( pg_rtoslot(slot, a, b, d); )
  : c == 62 ? ( pg_chIns(a, b, d); )             // 0.7.0 (Stufe 4): Kettenbearbeitung
  : c == 63 ? ( pg_chDel(a); )
  : c == 64 ? ( pg_chMove(a, b); )
  : c == 70 ? ( pg_galGen(); )                  // 0.7.0 (Stufe 3): Galerie
  : c == 71 ? ( pg_galTry(slot, a); )
  : c == 72 ? ( pg_galKeep(a, b); )
  : c == 73 ? ( pg_doMerge(slot, floor(a)); )
  : c == 74 ? ( pg_lkCmd(slot, a, b, floor(d)); )
  : c == 75 ? ( pg_genSeed(slot, a); )
  : c == 76 ? ( pg_slotReq(a, 0); )            // 0.8.0 (Stufe 5): Slot-Wechsel (quantisiert nach SLOT QUANT), bearbeitet pg_slotProc nach der Transportauswertung
  : c == 40 ? ( pg_undoBack(); )   // 0.7.0 (Stufe 1): Undo-Ring eine Stufe zurueck (slotuebergreifend)
  : c == 41 ? ( pg_redoFwd(); )    // 0.7.0 (Stufe 1): eine Stufe vor
  : c == 38 ? ( pg_undoSave(slot); )   // 0.6.1 (P-H): Undo-Stand VOR einer direkten Pattern-Edit-Geste sichern (@gfx sendet es einmal je Geste)
  : c == 36 ? ( tt_undo(); )   // P25 (A7): Undo-Marke der Front - erst NACH den Muster-Kommandos davor; tth_post meldet beim Loslassen
  : 0;
);

function pg_params() (
  pg_slot   = min(7, max(0, floor(slider1)));
  pg_root   = floor(slider6);
  pg_oct    = floor(slider35);
  pg_ch     = min(15, max(0, floor(slider25) - 1));
  pg_accV   = floor(slider26);
  pg_normV  = floor(slider27);
  pg_thr    = floor(slider28);
  pg_gatel  = slider24 / 100;
  pg_sw     = slider23 / 100;
  pg_rate   = floor(slider22);
  pg_L      = pg_rate == 0 ? 0.25 : pg_rate == 1 ? 0.5 : pg_rate == 2 ? (1 / 6) : 0.125;
  pg_follow = slider29 > 0.5 ? 1 : 0;
  pg_songOn = slider33 > 0.5 ? 1 : 0;
  pg_humV   = floor(slider32);
  pg_beatSamp = 60 * srate / (tempo > 0 ? tempo : 120);
  pg_humS   = slider31 * 0.001 * srate;
);

function pg_drain() local(p) (
  while (pg_cr != pg_cw) (
    p = M_CMD + pg_cr * 4;
    pg_cr = (pg_cr + 1) % 64;
    pg_cmdA += 1;
    pg_exec(p[0], p[1], p[2], p[3]);
  );
);

// @gfx: Kommando + Ausfuehrungsmarke in den Ring (Zaehler fuer den Stern: Referenz erst nach der Ausfuehrung im @block nehmen)
// P25 (A11): nur senden, wenn beide Plaetze frei sind; pg_pbSeq zaehlt nur dann hoch. Vorher konnte bei vollem Ring (FX umgangen/
// offline, @block steht) das Kommando eingereiht, die Marke 32 aber verworfen werden - pg_pbSeq != pg_pbAck fuer immer, der Stern
// blieb bis zum Neuladen aus. Rueckgabe 1 = gesendet. pg_undoNeed: Undo-Marke am Frame-Ende (siehe pg_postU).
function pg_pbSend(c, a) (
  pg_ringFree() >= 2 ? (
    pg_pbSeq += 1;
    pg_post(c, a, 0, 0);
    pg_post(32, 0, 0, 0);
    pg_undoNeed = 1;
    1;
  ) : 0;
);
// P25 (A7): Muster-Kommando der Front senden und eine Undo-Marke fuer das Frame-Ende anfordern (Kommando 36 -> tt_undo() im @block,
// also erst nach der Aenderung; tth_post loest den Undo-Punkt "Edit FX" beim Loslassen der Maus aus). Nicht fuer COPY/PANIC.
// 0.6.1 (Review P-H): direkte Pattern-Edits (12..19: Ton setzen/ziehen, Gate, Accent, Slide, Oktave, PROB, Laenge) sicherten keinen
// Undo-Stand - die interne UNDO-Taste tauschte nur M_UND (Stand vor GENERATE/ROT/REV/...). Jetzt sendet die erste Edit-Aktion einer
// Geste (pg_gest, geloescht bei losgelassener Maus am Frame-Anfang) vorher Kommando 38 = pg_undoSave; Ziehen/Malen = eine Geste.
function pg_postU(c, a, b, d) local(ok) (
  ok = 1;
  (c >= 12 && c <= 19 && pg_gest == 0) ? (
    pg_ringFree() >= 2 ? ( pg_post(38, 0, 0, 0); pg_gest = 1; ) : ( ok = 0; );
  );
  ok ? ( pg_post(c, a, b, d) ? ( pg_undoNeed = 1; ); );
);

// Pruefsumme eines Slots (32 Woerter, gewichtet) - fuer schnelle Determinismus-Vergleiche
function pg_checksum(slot) local(i, sm) (
  sm = 0;
  i = 0;
  while (i < 32) ( sm += M_PAT[slot * 32 + i] * (2 * i + 1); i += 1; );
  sm;
);

// Abfrage-Bus fuer Tests: 0..255 Woerter (slot*32+step), 256..263 Laengen, 264..279 Kette-Slot, 280..295 Reps, 300.. Skalare
function pg_query(a) local(r) (
  a = floor(a);
  r = 0;
  a < 256 ? ( r = M_PAT[a]; )
  : a < 264 ? ( r = M_LEN[a - 256]; )
  : a < 280 ? ( r = M_CHS[a - 264]; )
  : a < 296 ? ( r = M_CHR[a - 280]; )
  : a == 300 ? ( r = pg_curStep; )
  : a == 301 ? ( r = pg_curSlot; )
  : a == 302 ? ( r = pg_nextN; )
  : a == 303 ? ( r = pg_trans; )
  : a == 304 ? ( r = pg_sndCnt; )
  : a == 305 ? ( r = pg_qN; )
  : a == 306 ? ( r = M_CLP[0]; )
  : a == 307 ? ( r = M_UND[1]; )
  : a == 308 ? ( r = pg_linkCnt; )
  : a == 309 ? ( r = gmem[pg_linkBase]; )       // Review 1.0.4 (M2): Magic des EIGENEN Blocks (LINK ID), nicht fest ID 1
  : a == 310 ? ( r = gmem[pg_linkBase + 2]; )
  : a == 311 ? ( r = pg_checksum(min(7, max(0, floor(slider1)))); )
  : a == 312 ? ( r = pg_stI; )
  : a == 313 ? ( r = pg_qOvf; )   // 0.6.0 (F6): verworfene Ereignisse (Queue voll)
  : a == 314 ? ( r = PG_UR[0]; )  // 0.7.0: Undo-Tiefe
  : a == 315 ? ( r = PG_UR[1]; )  // 0.7.0: Redo-Tiefe
  : a == 316 ? ( r = PG_UR[0] > 0 ? (PG_UR + 8 + (PG_UR[0] - 1) * PG_UW)[0] : 0 - 1; )                      // Slot der naechsten Undo-Stufe
  : a == 317 ? ( r = PG_UR[1] > 0 ? (PG_UR + 8 + PG_UN * PG_UW + (PG_UR[1] - 1) * PG_UW)[0] : 0 - 1; )     // Slot der naechsten Redo-Stufe
  : a == 318 ? ( r = pg_cmdW - pg_cmdA; )   // 0.7.0: ausstehende Kommandos (Front -> @block)
  : a == 319 ? ( r = PG_RCL[0]; )           // 0.7.0: Bereichs-Zwischenablage (Anzahl Steps)
  : (a >= 384 && a < 400 && tt_testok()) ? ( r = PG_XK[a - 384]; )   // 0.7.0: Tasten-Diagnose (384 = Zaehler, 385..399 = Ring der letzten Codes)
  : a >= 320 && a < 384 ? ( r = M_ST[a - 320]; )
  : a == 400 ? ( r = tt_pb_count(); )
  : a == 401 ? ( r = tt_pb_curKind*1000 + tt_pb_cur; )
  : a == 402 ? ( r = pg_pbSum(); )
  : a == 403 ? ( r = tt_pb_mod; )
  : a == 404 ? ( r = pg_pbSeq - pg_pbAck; )
  // P25 (A10): Slot-/Namens-Pruefsummen (344 bzw. TTPB_NW Iterationen je Abfrage, viermal je Block) nur mit Test-Freigabe -
  // ein stehengebliebenes Q ADDR haette sonst Dauerlast im Audio-Thread erzeugt.
  : (a >= 420 && a < 452 && tt_testok()) ? (
      pg_qi = 0; loop(PG_PBW, r += (tt_pb_data + (a - 420)*PG_PBW)[pg_qi]*(pg_qi + 1); pg_qi += 1; );
    )
  : (a >= 460 && a < 492 && tt_testok()) ? (
      pg_qi = 0; loop(TTPB_NW, r += (tt_pb_names + (tt_pb_nfac + a - 460)*TTPB_NW)[pg_qi]*(pg_qi + 1); pg_qi += 1; );
    )
  : (a >= 500 && a < 508) ? ( r = slider(1 + a - 500); )
  // 0.7.0 (Stufe 3): 512..767 Kandidaten (8 x 32 Woerter), 768..775 Seeds, 776..791 Sperren (2 Worte je Slot), 792..807 Seed-Historie (Ring),
  // 808 = Historienzaehler, 809 = Laenge der Kandidaten, 810 = Chargenzaehler
  : (a >= 512 && a < 768) ? ( r = PG_GAL[a - 512]; )
  : (a >= 768 && a < 776) ? ( r = PG_GS[a - 768]; )
  : (a >= 776 && a < 792) ? ( r = PG_LK[a - 776]; )
  : (a >= 792 && a < 808) ? ( r = PG_SH[a - 792]; )
  : a == 808 ? ( r = PG_SH[16]; )
  : a == 809 ? ( r = pg_galLen; )
  : a == 810 ? ( r = pg_galCtr; )
  // 0.8.0 (Stufe 5): 811 wartender Slot-Wechsel (0 / 1), 812 Ziel-Slot, 813 Grenze (Step-Zaehler), 814 Einheit in Steps
  : a == 811 ? ( r = pg_sqPend; )
  : a == 812 ? ( r = pg_sqSlot; )
  : a == 813 ? ( r = pg_sqN; )
  : a == 814 ? ( r = floor(pg_sqUnit() * 1000 + 0.5); )   // Einheit in Millibeats
  // 1.0.4: 815 = Generator-Generation, 816..831 = Generation je Seed-Historien-Eintrag, 832 = Hinweis "Preset von aelterem Generator"
  : a == 815 ? ( r = PG_GENVER; )
  : (a >= 816 && a < 832) ? ( r = PG_SH[17 + a - 816]; )
  : a == 832 ? ( r = pg_gvNote; )
  : 0;
  r;
);

// ---------- Wiedergabe: Raster, Song-Position, PROB/HUMANIZE, Step ausloesen ----------
// Position von Step n (globaler Zaehler ab Beat 0) in Beats; ungerade Steps um (2*SWING-1)*L verzoegert
function pg_stepPos(n) local(o) (
  o = n - 2 * floor(n / 2);
  n * pg_L + o * (2 * pg_sw - 1) * pg_L;
);

// Erster Step mit Position >= bp0 (mit 1e-7 Beat Nachsicht, damit Start auf dem Raster Step 0 trifft)
function pg_firstStep(bp0) local(n) (
  n = ceil(bp0 / pg_L - 0.000000001);
  while (pg_stepPos(n - 1) >= bp0 - 0.0000001) ( n -= 1; );
  while (pg_stepPos(n) < bp0 - 0.0000001) ( n += 1; );
  n;
);

// 0.8.0 (Stufe 5): Grenze des quantisierten Wechsels: erster Step ab Step n0, dessen Position auf / hinter der naechsten Einheitsgrenze (Beats) liegt
function pg_sqBound(n0) local(ub) (
  ub = max(0.01, pg_sqUnit());   // Review zcode 17.10.2026 (B1): ts_num = 0 -> bpb = 0 -> Division durch 0
  pg_firstStep(ceil(pg_stepPos(n0) / ub - 0.000000001) * ub);
);
// Anforderung bearbeiten (im @block hinter der Transportauswertung: pg_active, pg_nextN, pg_bp0 gelten fuer diesen Block)
function pg_slotProc() local(sl, n0, nn) (
  (pg_sqPend && pg_slot != pg_slotPrev) ? ( pg_sqPend = 0; );   // SLOT von aussen geaendert (Automation, Front ohne Quantisierung): Wunsch verfaellt
  pg_rqSlot > 0 ? (
    sl = pg_rqSlot - 1;
    pg_rqSlot = 0;
    sl == pg_slot ? (
      pg_sqPend = 0;   // zurueck auf den laufenden Slot: wartenden Wechsel verwerfen
    ) : (!pg_active || pg_songOn) ? (
      pg_sqPend = 0;
      pg_pbSetSl(1, sl);
      pg_slot = sl;
    ) : (
      n0 = pg_nextN;
      nn = 0;
      while (nn < 64 && (pg_stepPos(n0) - pg_bp0) * pg_beatSamp < pg_rqOffs) ( n0 += 1; nn += 1; );
      pg_sqSlot = sl;
      pg_sqN = slider65 < 0.5 ? n0 : pg_sqBound(n0);
      pg_sqPend = 1;
    );
  );
);

// Step n -> (pg_ls = Slot, pg_lp = Step im Slot). Song-Modus: Kette der Slots mit Wiederholungen, zustandslos aus n berechnet.
// P25 (A9): nur die fuehrenden GUELTIGEN Kettenzellen zaehlen (k). Wurde eine Zelle im selben Block geleert, las die Schleife
// vorher M_LEN[-1] (= Step-Wort aus Slot H) als Laenge und ein fremdes Wort als Step. pg_songN wird zusaetzlich erst nach
// pg_drain() bestimmt (@block); diese Pruefung ist die zweite Sicherung.
function pg_locate(n) local(len, tot, p, i, span, sl, go, k) (
  pg_lc = 0 - 1; pg_lq = 0; pg_lt = 0;   // 0.8.1: Song-Position (Zelle, Step in der Kette, Kettenlaenge) fuer den laufenden Playhead der SONG-Ansicht
  k = 0;
  pg_songOn ? ( while (k < pg_songN && M_CHS[k] >= 0 && M_CHS[k] <= 7) ( k += 1; ); );
  k > 0 ? (
    tot = 0;
    i = 0;
    while (i < k) ( tot += M_LEN[M_CHS[i]] * M_CHR[i]; i += 1; );
    tot = max(1, tot);
    p = n - tot * floor(n / tot);
    pg_lq = p; pg_lt = tot;
    pg_ls = M_CHS[0];
    pg_lp = 0;
    go = 1;
    i = 0;
    while (i < k && go) (
      sl = M_CHS[i];
      len = M_LEN[sl];
      span = len * M_CHR[i];
      i += 1;
      p < span ? ( pg_ls = sl; pg_lp = p - len * floor(p / len); pg_lc = i - 1; go = 0; ) : ( p -= span; );
    );
  ) : (
    sl = (pg_sqPend && n >= pg_sqN) ? pg_sqSlot : pg_slot;   // 0.8.0 (Stufe 5): wartender quantisierter Wechsel
    len = M_LEN[sl];
    pg_ls = sl;
    pg_lp = n - len * floor(n / len);
  );
);

// Step-Wort mit WIRKSAMEM Gate: PROB < 100 wuerfelt deterministisch per Hash(Seed, Step, n); PROB 0 = nie
function pg_effWord(n) local(w, g, p) (
  pg_locate(n);
  w = M_PAT[pg_ls * 32 + pg_lp];
  g = w_gate(w);
  p = w_prob(w);
  (g > 0 && p < 100) ? ( pg_hash(slider2, pg_lp, n, 1) * 100 >= p ? ( g = 0; ); );
  w - w_gate(w) * 128 + g * 128;
);

// absolute Sendezeit (Samples) von Step n inkl. HUMANIZE-Versatz (+-, deterministisch), nie vor Blockbeginn
function pg_tabs(n) local(t, dev) (
  t = pg_absPos + (pg_stepPos(n) - pg_bp0) * pg_beatSamp;
  dev = 0;
  pg_humS > 0 ? ( dev = (pg_hash(slider2, 0, n, 2) * 2 - 1) * pg_humS; );
  max(pg_absPos, floor(t + dev + 0.5));
);

// 0.6.1 (Review P-C): Transponierung zur Zeit t (absolute Samples). pg_transB = Wert am Blockanfang, M_TT/M_TV = Aenderungen durch
// Eingangsnoten dieses Blocks mit ihrem Sample-Offset (pg_recalcTrans), chronologisch. Ein Step vor dem Offset der Eingangsnote
// klingt noch in der alten Lage. Historie: pg_trans (Endstand des Blocks) galt fuer alle Steps des Blocks.
function pg_transAt(t) local(v, i, go) (
  v = pg_transB;
  i = 0;
  go = 1;
  while (go && i < pg_tevN) (
    M_TT[i] <= t ? ( v = M_TV[i]; i += 1; ) : ( go = 0; );
  );
  v;
);

// Step n ausloesen. Slide: NoteOn des Folge-Tons VOR dem NoteOff des vorigen (Ueberlappung max(1 Sample, 0.5*GATE LEN*Step));
// Tie: Ton haelt ueber die Step-Grenze; ein Slide zaehlt nur, wenn der Folge-Step ein normaler Gate-Step ist.
// P25 (A1): Startzeiten monoton - Step n beginnt mindestens 1 Sample nach Step n-1 (pg_tLast), TonN mit derselben Klemme
// (TonN aus fire(n) = Ton aus fire(n+1)). Vorher konnte HUMANIZE (1/32 bzw. 1/16T, viel Swing, HUM TIME ab 15 ms) Step n+1
// vor Step n legen; beim Slide kam das Off der alten Note dann vor ihrem On und die Note hing bis Stop/PANIC.
// Ohne HUMANIZE und bei kleinem HUM TIME greift die Klemme nie (Ausgabe unveraendert). Orakel: tt-303patgen_model.py (clamp).
// Historie: Ton = pg_tabs(n); TonN = pg_tabs(n + 1);
// P25 (A13): beim Start einer neuen Nicht-Slide-Note ausstehende Offs auf Ton vorziehen (pg_qPullOffs), beim Slide-Start nur Offs
// derselben Tonhoehe (gefunden mit der Invarianten-Rechenprobe check.py prop: X -> Y -> X bei 1/16T, Swing 66, HUM 20, GATE 100).
function pg_fireDo(n) local(Ton, TonN, wA, wB, g, gN, e, acc, sl, note, vel, dur, gl, ovl, off, cont, started, hv) (
  Ton = max(pg_tabs(n), pg_tLast + 1);
  TonN = max(pg_tabs(n + 1), Ton + 1);
  pg_tLast = Ton;
  wA = pg_effWord(n);
  pg_curSlot = pg_ls;
  pg_curStep = pg_lp;
  pg_curCell = pg_lc; pg_curQ = pg_lq; pg_curTot = pg_lt;   // 0.8.1
  wB = pg_effWord(n + 1);
  g = w_gate(wA);
  gN = w_gate(wB);
  acc = w_acc(wA);
  sl = w_sld(wA);
  e = w_e(wA);
  // 0.6.1 (Review P-C): Eingangs-Transponierung zeitgenau - der Wert, der zur Startzeit Ton dieses Steps galt (pg_transAt), nicht der
  // Endstand des Blocks. Historie: ... + e + pg_trans));
  note = min(127, max(0, 36 + pg_root + 12 * pg_oct + e + pg_transAt(Ton)));
  dur = pg_L * pg_beatSamp;
  gl = max(1, floor(pg_gatel * dur));
  ovl = max(1, floor(0.5 * gl));
  vel = acc ? pg_accV : pg_normV;
  pg_humV > 0 ? (
    hv = pg_hash(slider2, 0, n, 3);
    vel = vel + floor((hv * 2 - 1) * pg_humV + 0.5);
    acc ? ( vel = max(pg_thr, min(127, vel)); ) : ( vel = min(pg_thr - 1, max(1, vel)); );
  );
  vel = max(1, min(127, vel));
  cont = 0;
  started = 0;
  (g == 2 && pg_snd < 0) ? ( g = 1; );
  g == 2 ? (
    cont = 1;
  ) : g == 1 ? (
    pg_snd >= 0 ? (
      (pg_openSlide && note != pg_snd) ? (
        pg_qPullOffs(Ton, note);
        pg_qPush(Ton, 0x90 + pg_ch, note, vel);
        pg_qPush(Ton + ovl, 0x80 + pg_sndCh, pg_snd, 0);
        started = 1;
      ) : (pg_openSlide && note == pg_snd) ? (
        cont = 1;
      ) : (
        pg_qPullOffs(Ton, 0 - 1);
        pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
        pg_qPush(Ton, 0x90 + pg_ch, note, vel);
        started = 1;
      );
    ) : (
      pg_qPullOffs(Ton, 0 - 1);
      pg_qPush(Ton, 0x90 + pg_ch, note, vel);
      started = 1;
    );
    started ? ( pg_snd = note; pg_sndCh = pg_ch; );
  ) : (
    pg_snd >= 0 ? (
      pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  );
  (started || cont) ? (
    gN == 2 ? (
      pg_openSlide = 0;
    ) : (sl && gN == 1) ? (
      pg_openSlide = 1;
    ) : (
      off = Ton + gl;
      gN >= 1 ? ( off = min(off, TonN - 1); );
      off = max(off, Ton + 1);
      pg_qPush(off, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  );
  started ? (
    pg_lastNote = note;
    pg_lastAcc = acc;
    pg_lastSld = pg_openSlide;
    pg_evCnt += 1;
  );
);

// 0.6.1 (Review P-B): Gruppen nur vollstaendig einreihen. Ein Step erzeugt bis zu drei Ereignisse (Off der Vorgaengernote, On, eigenes
// Off); die Durchreiche laesst nur 64 Plaetze frei, ein Block kann aber bis zu 64 Steps ausloesen (Slide: je Wechsel On + Off) - das
// verworfene Off haengte die Note. Reichen die Plaetze nicht fuer die ganze Gruppe (4 Plaetze bleiben fuer Schlussoffs gesperrt),
// faellt der Step aus: kein On, und eine noch offene Note bekommt ihr Off (auch eine, deren Off noch nicht eingereiht war: offener
// Slide oder Tie-Folge). Dieser Fall tritt nur bei CC-Fluten ueber 190 Ereignisse im selben Block auf. pg_qOvf zaehlt den Ausfall.
// Historie: pg_fire(n) = Rumpf oben (pg_fireDo), ohne die Platzpruefung.
function pg_fire(n) local(Ton) (
  (pg_qN + 3 > QCAP - 4) ? (
    Ton = max(pg_tabs(n), pg_tLast + 1);
    pg_tLast = Ton;
    pg_effWord(n);
    pg_curSlot = pg_ls;
    pg_curStep = pg_lp;
    pg_curCell = pg_lc; pg_curQ = pg_lq; pg_curTot = pg_lt;   // 0.8.1
    pg_qOvf += 1;
    pg_snd >= 0 ? (
      pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  ) : (
    pg_fireDo(n);
  );
);

// ---------- MIDI-Eingang: Noten transponieren das Muster (C2 = 36 = Originallage), werden nie durchgereicht; Rest geht durch ----------
function pg_recalcTrans() local(i, cnt, hi) (
  cnt = 0;
  i = 0;
  while (i < 128) ( cnt += (M_HELD[i] != 0 ? 1 : 0); i += 1; );
  // Historie (V2, 0.6.0): pg_nHeld = cnt; (wurde nie gelesen)
  pg_trans = (pg_follow && cnt > 0 && M_HELD[pg_lastHeld] != 0) ? pg_lastHeld - 36 : 0;
  (pg_follow && cnt > 0 && M_HELD[pg_lastHeld] == 0) ? (
    hi = 127;
    while (hi > 0 && M_HELD[hi] == 0) ( hi -= 1; );
    pg_lastHeld = hi;
    pg_trans = hi - 36;
  );
  // 0.6.1 (P-C): Wechsel mit Zeitstempel merken (pg_curOffs setzt pg_handleMidi; Aufrufe vor dem MIDI-Lauf werden mit pg_tevN = 0 verworfen)
  // 0.6.2 (Codex P10 R2): voll (M_TEV, damals 30) -> aeltesten Eintrag verwerfen (sein Wert wird zum Blockanfangswert), die letzten M_TEV Wechsel bleiben mit
  // Zeitstempel exakt und der Endstand ist immer der letzte. Historie: M_TV[29] = pg_trans (neuer Wert mit altem Zeitstempel, zu frueh)
  pg_tevN >= M_TEV ? (
    pg_transB = M_TV[0];
    i = 0;
    while (i < M_TEV - 1) ( M_TT[i] = M_TT[i + 1]; M_TV[i] = M_TV[i + 1]; i += 1; );
    pg_tevN = M_TEV - 1;
  );
  M_TT[pg_tevN] = pg_absPos + pg_curOffs;
  M_TV[pg_tevN] = pg_trans;
  pg_tevN += 1;
);

function pg_handleMidi(offs, m1, m2, m3) local(st, tb) (
  st = m1 - m1 % 16;
  pg_curOffs = offs;   // 0.6.1 (P-C): Zeitstempel fuer pg_recalcTrans
  tb = pg_trigBase();
  // 0.8.0 (Stufe 5): NOTE TRIG - acht Noten ab TRIG BASE schalten die Slots A..H (quantisiert wie SLOT QUANT), transponieren nicht und gehen
  // nicht durch (Note-Off ebenso). Ausgeschaltet laeuft alles bitgleich wie vorher.
  (slider66 > 0.5 && (st == 0x90 || st == 0x80) && m2 >= tb && m2 < tb + 8) ? (
    (st == 0x90 && m3 > 0) ? ( pg_slotReq(m2 - tb, offs); )
    : ( M_HELD[m2] != 0 ? ( M_HELD[m2] = 0; pg_recalcTrans(); ); );   // Review S7: war die Note vor dem Einschalten von NOTE TRIG gehalten, endet FOLLOW jetzt auch
  ) : (st == 0x90 && m3 > 0) ? (
    M_HELD[m2] = 1;
    pg_lastHeld = m2;
    pg_recalcTrans();
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    M_HELD[m2] = 0;
    pg_recalcTrans();
  ) : (
    (st == 0xB0 && (m2 == 123 || m2 == 120)) ? (
      pg_panic(offs);
      memset(M_HELD, 0, 128);
      pg_recalcTrans();
    );
    pg_qPushThru(pg_absPos + offs, m1, m2, m3);   // 0.6.0 (F6); Historie: pg_qPush
  );
);

// ---------- SEQ LINK: Sender im gmem-Namespace tt303pg (Protokoll siehe Manual) ----------
// 1.0.4: LINK ID (Slider 69) legt den Block dieser Instanz fest: Basis = (ID - 1) * 3000. ID 1 liegt ab gmem[0] wie immer;
// alle Adressen unten sind relativ zur Basis. [Basis+198] = Plugin-Version x 100, [Basis+199] = Herzschlag (Zaehler je @block,
// auch bei SEQ LINK OFF) - damit erkennen Leser laufende Instanzen und unterscheiden "kein Plug-in" / "LINK aus" / "veraltet".
// gmem[0]=30301 Magic, [1]=1 Version, [2]=Laenge, [3]=Schreibzaehler, [4+4*s+k] = Step s, Feld k: 0 Note (MIDI absolut),
// 1 Gate (Tie = 1), 2 Accent, 3 Slide (Tie wird als Slide des Vorgaengers ausgedrueckt). Nur der aktive Slot, ohne Transposition.
// Erweiterung (fuer das ReaScript "Print to MIDI Item"): [132]=Steplaenge in Beats, [133]=Swing (0.5..0.75), [134]=Gate-Laenge (Step-Anteil),
// [135]=ACC VEL, [136]=NORM VEL, [137]=MIDI-Kanal 1..16, [138]=1 (Erweiterung gueltig).
// Kettenblock: [200] = 1 gueltig, [201] = Schreibzaehler, [202] = Zellen (bis zur ersten leeren), [203 + 2 * j] = Slot, [204 + 2 * j] = Wiederholungen
// (j < 16); je Slot k (0..7) ab 240 + 164 * k: [0] = Laenge, [1 + 4 * s ..] = Note, Gate (Tie = 1), Accent, Slide (wie gmem[4..]; Tie als Slide des
// Vorgaengers; ausser bei Step 0: dort setzt der Leser das Slide-Bit des Vorgaengers selbst, weil der Vorgaenger in der Kette der letzte Step
// der vorigen Zelle ist), [129 + s] = 1 bei Tie. Noten absolut wie oben (ROOT und OCTAVE sind eingerechnet).
// Review Codex 0.7.0 (R2): Abstand 164 statt 160, sonst lag das Tie-Flag von Step 31 (129 + 31 = 160) auf der Laenge des naechsten Slots.
function pg_linkChainWrite() local(sum, i, k, s, ss, w, g, b, len, nc, gb) (
  gb = pg_linkBase;   // 1.0.4: Instanz-Block = (LINK ID - 1) * 3000
  sum = 7;
  i = 0;
  while (i < 16) ( sum = (sum * 31 + M_CHS[i] * 9 + M_CHR[i]) % 2147483647; i += 1; );
  i = 0;
  while (i < 256) ( sum = (sum * 31 + M_PAT[i]) % 2147483647; i += 1; );
  i = 0;
  while (i < 8) ( sum = (sum * 31 + M_LEN[i]) % 2147483647; i += 1; );
  sum = (sum * 31 + pg_root * 7 + pg_oct * 131 + floor(pg_L * 1000) * 977 + floor(pg_sw * 1000) * 101 + floor(pg_gatel * 1000) * 13 + pg_accV * 31 + pg_normV * 37 + pg_ch * 41 + pg_linkBase) % 2147483647;   // 1.0.4: + Basis, ID-Wechsel schreibt am neuen Platz sofort
  sum != pg_chainSum ? (
    pg_chainSum = sum;
    gmem[gb + 200] = 0;   // Review Codex 0.7.0 (R5): waehrend des Schreibens ungueltig, der Leser versucht es erneut
    nc = 0;
    while (nc < 16 && M_CHS[nc] >= 0) ( nc += 1; );
    gmem[gb + 202] = nc;
    i = 0;
    while (i < 16) ( gmem[gb + 203 + 2 * i] = M_CHS[i]; gmem[gb + 204 + 2 * i] = M_CHR[i]; i += 1; );
    k = 0;
    while (k < 8) (
      b = gb + 240 + 164 * k;
      len = M_LEN[k];
      gmem[b] = len;
      s = 0;
      while (s < len) (
        w = M_PAT[k * 32 + s];
        g = w_gate(w);
        gmem[b + 1 + 4 * s] = min(127, max(0, 36 + pg_root + 12 * pg_oct + w_e(w)));
        gmem[b + 2 + 4 * s] = (g > 0 ? 1 : 0);
        gmem[b + 3 + 4 * s] = (g == 1 ? w_acc(w) : 0);
        gmem[b + 4 + 4 * s] = w_sld(w);
        gmem[b + 129 + s] = (g == 2 ? 1 : 0);
        s += 1;
      );
      s = 0;
      while (s < len) (
        ss = s;
        s += 1;
        (ss > 0 && w_gate(M_PAT[k * 32 + ss]) == 2) ? ( gmem[b + 4 + 4 * (ss - 1)] = 1; );   // Review Codex 0.7.0 (R4): Step 0 setzt der Leser
      );
      k += 1;
    );
    // 25.10.2026 (Review 303patgen-R003): Zaehler gmem[201] VOR dem Gueltig-Flag gmem[200] erhoehen -
    // ein Leser sah sonst c0 == c1 (alter Zaehler) bei Flag 1 und nahm Mischdaten.
    // 1.0.6 (dsh F6): Zaehler vor dem Erhoehen sanieren - ein fremd geschriebener NaN-Wert bliebe NaN und
    // jeder Leser fiele danach dauerhaft in "hat sich waehrend des Lesens geaendert" (c0 == c1 nie wahr).
    sum = gmem[gb + 201];
    gmem[gb + 201] = (sum >= 0 && sum < 4294967296) ? sum + 1 : 1;
    gmem[gb + 200] = 1;
  );
);

function pg_linkWrite() local(slot, len, s, ss, w, sum, g, nt, pv, gb) (
  gb = pg_linkBase;   // 1.0.4: Instanz-Block = (LINK ID - 1) * 3000
  slot = pg_slot;
  len = M_LEN[slot];
  sum = len * 1000003 + pg_root * 7 + pg_oct * 131 + slot + floor(pg_L * 1000) * 977 + floor(pg_sw * 1000) * 101 + floor(pg_gatel * 1000) * 13 + pg_accV * 31 + pg_normV * 37 + pg_ch * 41 + pg_linkBase;   // 1.0.4: + Basis, ID-Wechsel schreibt sofort
  s = 0;
  while (s < len) ( sum = (sum * 31 + M_PAT[slot * 32 + s]) % 2147483647; s += 1; );
  sum != pg_linkSum ? (
    pg_linkSum = sum;
    gmem[gb + 138] = 0;   // Review-Befund E5: waehrend des Schreibens ungueltig (wie gmem[200] beim Kettenblock), das Print-Skript liest erneut; gmem[138] = 1 und gmem[3] + 1 stehen erst hinter den Daten
    s = 0;
    while (s < len) (
      w = M_PAT[slot * 32 + s];
      g = w_gate(w);
      nt = min(127, max(0, 36 + pg_root + 12 * pg_oct + w_e(w)));
      gmem[gb + 4 + 4 * s] = nt;
      gmem[gb + 4 + 4 * s + 1] = (g > 0 ? 1 : 0);
      gmem[gb + 4 + 4 * s + 2] = (g == 1 ? w_acc(w) : 0);
      gmem[gb + 4 + 4 * s + 3] = w_sld(w);
      s += 1;
    );
    s = 0;
    while (s < len) (
      w = M_PAT[slot * 32 + s];
      ss = s;
      s += 1;
      w_gate(w) == 2 ? ( gmem[gb + 4 + 4 * ((ss + len - 1) % len) + 3] = 1; );
    );
    // 0.6.1 (Review P-D): Tie-Flags je Step (1 = Tie: Ton des Vorgaengers haelt, eigener Ton zaehlt nicht) in gmem[140..171], gueltig
    // wenn gmem[139] = 1. Die alten Felder (Tie = Gate 1 + Slide des Vorgaengers) bleiben unveraendert, aeltere Print-Skripte laufen weiter.
    s = 0;
    while (s < len) (
      gmem[gb + 140 + s] = (w_gate(M_PAT[slot * 32 + s]) == 2);
      s += 1;
    );
    gmem[gb + 139] = 1;
    gmem[gb + 132] = pg_L;
    gmem[gb + 133] = pg_sw;
    gmem[gb + 134] = pg_gatel;
    gmem[gb + 135] = pg_accV;
    gmem[gb + 136] = pg_normV;
    gmem[gb + 137] = pg_ch + 1;
    // 25.10.2026 (Review 303patgen-R003): Zaehler gmem[3] VOR dem Gueltig-Flag gmem[138] erhoehen -
    // stand das Flag zuerst, konnte der Leser im Fenster "Flag 1 / Zaehler alt" Mischdaten annehmen.
    gmem[gb + 0] = 30301;
    gmem[gb + 1] = 1;
    gmem[gb + 2] = len;
    sum = gmem[gb + 3];   // 1.0.6 (dsh F6): wie gmem[201] - Zaehler vor dem Erhoehen sanieren (NaN waere dauerhaft)
    gmem[gb + 3] = (sum >= 0 && sum < 4294967296) ? sum + 1 : 1;
    gmem[gb + 138] = 1;
    pg_linkCnt += 1;
  );
  // 0.7.0 (Stufe 4): Kette + alle Muster ab gmem[200], gueltig wenn gmem[200] = 1 (gmem[201] zaehlt hoch). Der Block ist rein additiv:
  // gmem[0..171] bleiben wie bisher, aeltere Print-Skripte lesen ihn nie. Neuberechnung nur bei Aenderung (Pruefsumme ueber Kette + 8 Muster).
  pg_linkChainWrite();
);

// ---------- Init-Daten: Bibliothek (32 Muster), Markov-Zaehlung, Vorbelegung ----------
function pg_libInit() (
  pg_libAdd(0, "aAa_m_a_a_mAa_k_aAa_m_a_d_a_kSh_");   // Roll One
  pg_libAdd(1, "a_a_aAm_._a_a_mAa_._aAd_a_k_a_m_");   // Roll Two
  pg_libAdd(2, "aA._a_a_m_a_a_._aAa_mSk_a_a_d_._");   // Roll Three
  pg_libAdd(3, "a_mAa_a_k_a_mAa_a_d_a_m_aAa_k_a_");   // Roll Four
  pg_libAdd(4, "aAa_a_m_a_a_k_a_mAa_a_h_a_d_a_kS");   // Roll Five
  pg_libAdd(5, "a_-_a_mAa_-_a_m_a_-_aAk_a_d_a_hS");   // Roll Six
  pg_libAdd(6, "aAa_m_a_aSd_a_m_a_k_aAa_m_a_hSf_");   // Roll Seven
  pg_libAdd(7, "a_a_mAa_a_a_k_aAa_m_a_a_d_a_mSk_");   // Roll Eight
  pg_libAdd(8, "aSd_._aA._a_hSf_._a_kA._a_dSa_._");   // Sparse One
  pg_libAdd(9, "aA._._a_dSf_._aSg_h_._aA._kSa_._");   // Sparse Two
  pg_libAdd(10, "a_._aSd_._aAh_._kSh_._a_fA._aSd_");   // Sparse Three
  pg_libAdd(11, "aA-_a_._dSa_._hA-_kSh_._a_f_._a_");   // Sparse Four
  pg_libAdd(12, "aSf_._gAh_._aSd_._dA._fSa_._k_._");   // Sparse Five
  pg_libAdd(13, "a_._._aA._dSf_a_._h_._kAa_._._d_");   // Sparse Six
  pg_libAdd(14, "aA._dSh_._._a_aSf_._a_kA._h_aSd_");   // Sparse Seven
  pg_libAdd(15, "aSd_._a_dA._f_aSg_._hA._kSa_._h_");   // Sparse Eight
  pg_libAdd(16, "aAa_b_a_a_b_aAd_a_b_a_hSf_a_b_a_");   // Drive One
  pg_libAdd(17, "a_b_aAa_d_a_b_a_aAhSf_a_b_aAa_m_");   // Drive Two
  pg_libAdd(18, "aAb_a_b_a_d_aSb_aAa_d_b_a_hSg_f_");   // Drive Three
  pg_libAdd(19, "a_a_b_aAa_b_d_a_a_b_aAa_d_b_a_mS");   // Drive Four
  pg_libAdd(20, "aAa_bSa_d_a_bSa_f_a_hAa_b_a_d_a_");   // Drive Five
  pg_libAdd(21, "a_b_a_d_aAb_a_f_a_b_aAg_a_h_b_a_");   // Drive Six
  pg_libAdd(22, "aAa_a_b_a_a_d_aSb_a_hAb_a_a_fSg_");   // Drive Seven
  pg_libAdd(23, "a_b_a_aAd_a_b_a_hAa_b_a_dSf_a_b_");   // Drive Eight
  pg_libAdd(24, "aA._a_a_._aSk_._a_aA._a_k_._d_a_");   // Squelch One
  pg_libAdd(25, "a_._aA._a_k_aSa_._a_._aAk_._a_a_");   // Squelch Two
  pg_libAdd(26, "aAa_._a_k_._aA._a_kSa_._a_d_._a_");   // Squelch Three
  pg_libAdd(27, "a_._a_aAk_._a_._a_hSk_._aAa_k_._");   // Squelch Four
  pg_libAdd(28, "aA._._a_._a_k_a_._aSa_._aA._kSd_");   // Squelch Five
  pg_libAdd(29, "a_a_._aA-_a_d_._a_a_k_-_aAa_._a_");   // Squelch Six
  pg_libAdd(30, "aA._a_._k_a_._aA._a_d_._k_aSa_._");   // Squelch Seven
  pg_libAdd(31, "a_._aAk_a_._a_aA._k_a_._d_a_k_._");   // Squelch Eight
);

// Markov-Zaehlung 12x12 (Zeile = von Tonklasse, Spalte = nach): Uebergaenge zwischen aufeinanderfolgenden gespielten Noten
// der 32 eigenen Bibliotheksmuster (Pausen/Ties uebersprungen, zyklisch), erzeugt mit tt-303patgen_lib.py
function pg_mkInit() (
  M_MKV[0] = 146; M_MKV[1] = 25; M_MKV[3] = 36; M_MKV[5] = 7; M_MKV[6] = 3; M_MKV[7] = 16; M_MKV[10] = 31;
  M_MKV[12] = 28; M_MKV[15] = 1;
  M_MKV[36] = 30; M_MKV[37] = 2; M_MKV[39] = 1; M_MKV[41] = 5; M_MKV[43] = 1; M_MKV[46] = 1;
  M_MKV[60] = 15; M_MKV[66] = 2;
  M_MKV[72] = 2; M_MKV[77] = 1; M_MKV[79] = 3;
  M_MKV[84] = 12; M_MKV[85] = 2; M_MKV[89] = 4; M_MKV[90] = 1; M_MKV[94] = 5;
  M_MKV[120] = 31; M_MKV[123] = 2; M_MKV[127] = 4;
);

// 0.6.0 (B4): Bibliothek und Markov-Tabelle nur einmal (Speicher und Variablen ueberleben den Neulauf von @init bei Transportstart)
pg_libOk != 1 ? ( pg_libOk = 1; pg_libInit(); pg_mkInit(); );
pg_first ? ( pg_defaults(); pg_first = 0; );

// ---------- Front-Bausteine (Zeichnen/Bedienen laeuft in @gfx; Datenaenderungen nur als Kommando an @block) ----------

// Slider aus der Front setzen (mit Host-Automation-Hinweis)
// P25 (Harmonisierung 4): ueber tt_slset (Theme-Modul, Slider 1..63: Schwelle 1e-7, slider_automate -> Undo-Punkt, tt_sldirty).
// PATGEN liest alle Slider in jedem @block direkt (pg_readParams / Blockparameter) - kein eigener Spiegel, tt_sldirty wird nicht
// gebraucht. Alle Front-Slider sind 1..36; der Farbslider 64 bleibt in Variablenform (Ende von @gfx).
// Historie: slider(idx) != v ? ( slider(idx) = v; sliderchange(2 ^ (idx - 1)); slider_automate(2 ^ (idx - 1)); );
function pg_set(idx, v) (
  // 0.8.0 (Stufe 5): Slider 65..68 (SLOT QUANT, NOTE TRIG, TRIG BASE, DENS VAR) nur in Variablenform (Masken gibt es bis 63)
  idx == 65 ? ( abs(slider65 - v) > 0.0000001 ? ( slider65 = v; slider_automate(slider65); tt_sldirty = 1; ); )
  : idx == 66 ? ( abs(slider66 - v) > 0.0000001 ? ( slider66 = v; slider_automate(slider66); tt_sldirty = 1; ); )
  : idx == 67 ? ( abs(slider67 - v) > 0.0000001 ? ( slider67 = v; slider_automate(slider67); tt_sldirty = 1; ); )
  : idx == 68 ? ( abs(slider68 - v) > 0.0000001 ? ( slider68 = v; slider_automate(slider68); tt_sldirty = 1; ); )
  : idx == 69 ? ( abs(slider69 - v) > 0.0000001 ? ( slider69 = v; slider_automate(slider69); tt_sldirty = 1; ); )
  : tt_slset(idx, v);
);

// Hinweis-Text merken, wenn die Maus im Feld steht (Ausgabe am Frame-Ende)
// P23: seit 0.5.3 ueber den Suite-Standard des Kits (tt_hov meldet, tt_tipflush am Ende von @gfx zeichnet nach 0.35 s
// Verweilen, nicht beim Ziehen und nicht bei OPTIONS > TOOLTIPS OFF). Frueher: eigener Puffer #ui_tip + ui_tipOn, sofortige
// Anzeige, Sperre ueber dragId < 0 (das Kit sperrt jetzt ueber uiLmb: Maustaste gedrueckt = kein Tooltip).
function pg_hint(x, y, w, h, s) (
  tt_hov(x, y, w, h, s);
);

// Historie (P23 -> P25): Preset-Leiste und OPTIONS-Button hatten eine eigene Verweil-Erkennung ueber die rohe Maus
// (pg_rhov / pg_rflush / pg_barhints, Zeichnen ueber tt_tip). pg_barhints hatte ein Local `sc`, das wegen der fehlenden
// Gross-/Kleinschreibung in EEL2 dasselbe ist wie das Global SC (Review P25 A4): alle Rechtecke wurden mit 0.5 statt SC gerechnet,
// die Tooltips lagen ueber der Wortmarke statt ueber der Leiste. Ersatzlos gestrichen, die Kopfzeile laeuft jetzt ueber
// tt_modtips() aus dem Kit (ein Text je Element der Leiste + OPTIONS) - der EINE Weg der Suite (P25_FIX Punkt 3).

// Namen (Ergebnis jeweils in #pn)
function pg_noteStr(n) local(pc, l) (
  pc = n - 12 * floor(n / 12);
  l = (pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10) ? 2 : 1;
  strcpy_substr(#pn, "C C#D D#E F F#G G#A A#B ", pc * 2, l);
);
function pg_algoStr(i) (
  i == 0 ? strcpy(#pn, "RANDOM WALK")
  : i == 1 ? strcpy(#pn, "MARKOV")
  : i == 2 ? strcpy(#pn, "EUCLID+WALK")
  : i == 3 ? strcpy(#pn, "MOTIF+VAR")
  : i == 4 ? strcpy(#pn, "CLASSIC MUT")
  : strcpy(#pn, "TECHNO BASS");
);
function pg_scaleStr(i) (
  i == 0 ? strcpy(#pn, "MINOR PENT")
  : i == 1 ? strcpy(#pn, "NAT MINOR")
  : i == 2 ? strcpy(#pn, "PHRYGIAN")
  : i == 3 ? strcpy(#pn, "HARM MINOR")
  : i == 4 ? strcpy(#pn, "DORIAN")
  : i == 5 ? strcpy(#pn, "CHROMATIC")
  : i == 6 ? strcpy(#pn, "BLUES")
  : i == 7 ? strcpy(#pn, "PHRYG DOM")
  : i == 8 ? strcpy(#pn, "WHOLE TONE")
  : strcpy(#pn, "CUSTOM");
);
function pg_rateStr(i) (
  i == 0 ? strcpy(#pn, "RATE 1/16")
  : i == 1 ? strcpy(#pn, "RATE 1/8")
  : i == 2 ? strcpy(#pn, "RATE 1/16T")
  : strcpy(#pn, "RATE 1/32");
);
// 0.8.0 (Stufe 5): Beschriftung SLOT QUANT / TRIG BASE
function pg_sqStr(i) (
  i == 0 ? strcpy(#pn, "Q: INSTANT")
  : i == 1 ? strcpy(#pn, "Q: 1 BEAT")
  : i == 2 ? strcpy(#pn, "Q: 1 BAR")
  : i == 3 ? strcpy(#pn, "Q: 2 BARS")
  : strcpy(#pn, "Q: 4 BARS");
);
function pg_trigStr(i) (
  i == 0 ? strcpy(#pn, "C0-G0")
  : i == 1 ? strcpy(#pn, "C1-G1")
  : i == 2 ? strcpy(#pn, "C3-G3")
  : strcpy(#pn, "C4-G4");
);
function pg_libStr(i) (
  i < 8 ? sprintf(#pn, "%02d ROLL %d", i + 1, i + 1)
  : i < 16 ? sprintf(#pn, "%02d SPARSE %d", i + 1, i - 7)
  : i < 24 ? sprintf(#pn, "%02d DRIVE %d", i + 1, i - 15)
  : sprintf(#pn, "%02d SQUELCH %d", i + 1, i - 23);
);

// Preset-Leiste: Tabelle, Bank, Werks-Namen (Bibliotheksmuster 1..32; die Ladelogik ist die der frueheren LOAD-Taste: Kommando 20 in den aktiven Slot)
pg_pbTable();
tt_pb_init(PG_NFAC, 32, PG_PBB, PG_PBW);
// Historie: tth_test = 1;   // P20: gmem-Testhaken des Theme-Moduls (gmem[5190], nur bei gesetztem Flag)
// P25 (A10, Harmonisierung 7): Zeile geloescht. Theme-Haken und alle schreibenden Test-Kommandos laufen nur noch mit der
// Freigabe tt_testok() (gmem[tth_gmb - 1] = gmem[5189] == 20261001, Namespace tt303pg). Im Namespace liegt sonst nur SEQ LINK
// (gmem[0..138]) - 5189..5214 sind frei, tth_gmb bleibt auf der Vorgabe 5190.
// 0.6.1 (Review P-I): die 48 Werks-Namen laufen ueber #pn, den @gfx jeden Frame beschreibt - bei jedem Transportstart neu gebaut
// konnten sie sich mit Front-Texten mischen. Der Namensspeicher des Preset-Moduls bleibt ueber @init erhalten (tt_pb_init loescht nur
// beim ersten Lauf), also nur einmal. Historie: ohne pg_namesOk-Pruefung bei jedem @init.
pg_namesOk != 1 ? (
  pg_ii = 0;
  loop(PG_NLIB, pg_libStr(pg_ii); tt_pb_fname(pg_ii, #pn); pg_ii += 1; );
  pg_ii = 0;
  loop(PG_NSCN, pg_scnStr(pg_ii); tt_pb_fname(PG_NLIB + pg_ii, #pn); pg_ii += 1; );
  pg_namesOk = 1;
);

// Theme-Tint: gruenlich getoentes Grau (Bezugsschema ACID) in die Farbe des aktiven Schemas uebertragen.
// frac = Gruenanteil relativ zum Vollakzent; Ergebnis = Grundfarbe + frac * (Akzent - ACID-Akzent). Bei ACID exakt unveraendert.
function pg_tn(r, g, b, a) local(f) (
  f = max(0, (g - (r + b) * 0.5) / 0.849);
  gfx_set(min(1, max(0, r + f * (accR - 0.224))), min(1, max(0, g + f * (accG - 1.000))), min(1, max(0, b + f * (accB - 0.078))), a);
);

// Zelle (Step-Raster): st 0 aus, 1 an (Akzent), 2 hell (Accent), 3 gedimmt (Tie), 4 gesperrt
function pg_cell(x, y, w, h, st, hov) (
  st == 0 ? (
    hov ? xgrad(x, y, w, h, 0.150, 0.160, 0.150, 0.085, 0.090, 0.085) : xgrad(x, y, w, h, 0.115, 0.122, 0.115, 0.066, 0.070, 0.066);
    hov ? pg_tn(0.30, 0.46, 0.26, 1) : pg_tn(0.17, 0.22, 0.16, 1);
    xrrect(x, y, w, h, 3, 0);
  ) : st == 1 ? (
    colAcid(0.22); xrrect(x - 1.5, y - 1.5, w + 3, h + 3, 4, 1);
    xgrad(x, y, w, h, accR, accG, accB, accR * 0.62, accG * 0.62, accB * 0.62);
    gfx_set(1, 1, 1, 0.30); xrect(x + 2, y + 1, w - 4, 1);
  ) : st == 2 ? (
    colAcid(0.30); xrrect(x - 1.5, y - 1.5, w + 3, h + 3, 4, 1);
    xgrad(x, y, w, h, 1, 1, 1, 0.55 + accR * 0.4, 0.55 + accG * 0.4, 0.55 + accB * 0.4);
  ) : st == 3 ? (
    xgrad(x, y, w, h, accR * 0.55, accG * 0.55, accB * 0.55, accR * 0.30, accG * 0.30, accB * 0.30);
  ) : (
    pg_tn(0.075, 0.080, 0.075, 1); xrrect(x, y, w, h, 3, 1);
    pg_tn(0.13, 0.15, 0.12, 1); xrrect(x, y, w, h, 3, 0);
  );
);

// P26 (Nacharbeit "Ueberlappungen bei grossen Schriftstufen"): OPTIONS FONT 1/2 laesst die Kit-Schriften bis Stufe +8 wachsen
// (x 1,85). Beschriftungen in festen Kaesten (Reglerspalten 66 breit, Wertzeile 10 tiefer, Monitor, Labels vor Auswahlfeldern,
// Hilfezeilen, Wortmarke vor der Preset-Leiste) liefen dann ineinander (Nachweis ohne REAPER: dem Arp-Tool/tt_font_overlap.py,
// Stufe +8: 31 Funde). Ersatzschriften in der Groesse der Stufe 0 (kleinere Stufen wirken weiter): Slot 12 = wie Slot 5 (mono
// klein), 13 = wie Slot 4 (mono), 14 = wie Slot 1 (Wortmarke). pg_fit waehlt fuer einen Text in einem Kasten w x h (Designraster)
// die normale Schrift, solange sie passt, sonst die Ersatzschrift. Bei Stufe 0 passt alles (gemessen) -> Bild unveraendert.
// Slots 12..14 nutzt kein Modul (Theme 9/10/16, Leiste 11). Eigene Textfarbe (CUSTOM COLOR FONT 1/2): tth_txt kennt nur die
// Slots 1..5 -> pg_capCol setzt sie fuer die Ersatzschrift (nach der Farbwahl, vor dem Zeichnen).
function pg_capFonts() local(s, m, b) (
  pg_capOn = (tth_f1sz > 0 || tth_f2sz > 0);   // 0.6.0 (P4): bei Stufe <= 0 passt alles, pg_fit misst dann nicht
  s = max(9,  floor(12*SC*1.08^min(0, tth_f2sz)));
  m = max(10, floor(15*SC*1.08^min(0, tth_f2sz)));
  b = max(12, floor(34*SC*1.08^min(0, tth_f1sz)));
  (s != pg_capS || m != pg_capM || b != pg_capB) ? (
    pg_capS = s; pg_capM = m; pg_capB = b;
    monoSel == 0 ? ( gfx_setfont(12, "Consolas", s); gfx_setfont(13, "Consolas", m); )
    : monoSel == 1 ? ( gfx_setfont(12, "DejaVu Sans Mono", s); gfx_setfont(13, "DejaVu Sans Mono", m); )
    : monoSel == 2 ? ( gfx_setfont(12, "Menlo", s); gfx_setfont(13, "Menlo", m); )
    : ( gfx_setfont(12, "Courier New", s); gfx_setfont(13, "Courier New", m); );
    bigSel ? gfx_setfont(14, "Zilap Orion", b, 'b')
    : sansSel == 0 ? gfx_setfont(14, "Segoe UI", b, 'b')
    : sansSel == 1 ? gfx_setfont(14, "Helvetica Neue", b, 'b')
    : sansSel == 2 ? gfx_setfont(14, "DejaVu Sans", b, 'b')
    : sansSel == 3 ? gfx_setfont(14, "Liberation Sans", b, 'b')
    : gfx_setfont(14, "Arial", b, 'b');
    gfx_setfont(5);                          // wie nach uikit_begin
  );
);
function pg_fit(slot, s, w, h) local(tw, th) (
  gfx_setfont(slot);
  pg_capF = 0;
  pg_capOn ? (
    gfx_measurestr(s, tw, th);
    pg_capF = (tw > w*SC || th > h*SC) ? (slot == 1 ? 1 : 2) : 0;
    pg_capF ? gfx_setfont(slot == 5 ? 12 : (slot == 4 ? 13 : 14));
  );
);
function pg_capCol() (
  (pg_capF == 1 && tth_f1on) ? gfx_set(tth_f1R, tth_f1G, tth_f1B, gfx_a)
  : (pg_capF == 2 && tth_f2on) ? gfx_set(tth_f2R, tth_f2G, tth_f2B, gfx_a);
);
// Text in Schrift slot, passend in w x h (Farbe vorher setzen); pg_ctrF zentriert im Kasten w x h, passend in (w - 2) x (h + 2)
function pg_strF(x, y, slot, s, w, h) ( pg_fit(slot, s, w, h); pg_capCol(); xstr(x, y, s); );
function pg_ctrF(x, y, w, h, slot, s) ( pg_fit(slot, s, w - 2, h + 2); pg_capCol(); xctr(x, y, w, h, s); );

// Drehregler mit Beschriftung + Wert; mode 0 ganzzahlig, 1 eine Nachkommastelle, 2 mit Vorzeichen
// P25 (A8, Harmonisierung 8): st = Schrittweite der Slider-Deklaration (1 bzw. 0,1 bei HUM TIME) an knob2st durchgereicht: ein
// Schritt je Mausrad-Raste, Ziehen rastet. Vorher (knob2, 2 % des Bereichs je Raste mit anschliessender Rundung) wirkte das Rad auf
// RANGE (5..24) und OCTAVE (-2..2) gar nicht, auf SWING (50..75) nur aufwaerts, bei 1..127 sprang es um 3.
// Die Rundung bleibt (Schutz gegen Gleitkomma-Reste von vmn + k*st). Tooltip-Rechteck: genau die Knopf-Spalte (Breite 66) und von
// Oberkante Fangkreis (cy - r - 7) bis Unterkante Wertzeile (cy + r + 24) - Nachbarn ueberlappen sich damit nicht mehr
// (OUTPUT: Spalten 66 auseinander; GENERATOR: Reihen 61 auseinander). Historie: pg_hint(cx - 34, cy - r - 6, 68, 2 * r + 32, tip);
function pg_kn(id, sl, cx, cy, r, vmn, vmx, def, lbl, mode, tip, st) local(v0, nv) (
  v0 = min(vmx, max(vmn, slider(sl)));
  nv = knob2st(id, cx, cy, r, v0, vmn, vmx, def, st);
  nv != v0 ? ( pg_set(sl, mode == 1 ? floor(nv * 10 + 0.5) / 10 : floor(nv + 0.5)); );
  // Historie: gfx_setfont(5); colInk(0.85); xctr(cx - 34, cy + r + 4, 68, 10, lbl); ... colAcid(1); xctr(..., #ui_s);
  // P26: Beschriftung und Wert passen in die Spalte (66) und in ihre 10er-Zeile
  colInk(0.85); pg_ctrF(cx - 34, cy + r + 4, 68, 10, 5, lbl);
  mode == 1 ? sprintf(#ui_s, "%.1f", slider(sl))
  : mode == 2 ? sprintf(#ui_s, "%+d", slider(sl))
  : sprintf(#ui_s, "%d", slider(sl));
  colAcid(1); pg_ctrF(cx - 34, cy + r + 14, 68, 10, 5, #ui_s);
  gfx_setfont(5);
  pg_hint(cx - 33, cy - r - 7, 66, 2 * r + 31, tip);
);

// Combo mit Text aus #pn (vorher setzen), Rueckgabe: neuer Index; schreibt den Slider
// P25 (A5): ofs = kleinster Sliderwert. Das Kit-combo arbeitet auf 0..n-1; MIDI CH (Slider 25) ist 1..16 und lief vorher
// ohne Versatz (Kanal 16 unerreichbar, 0 moeglich). Alle anderen Combos beginnen bei 0 (ofs = 0).
function pg_combo(id, sl, x, y, w, h, n, ofs) local(v0, nv) (
  v0 = min(n - 1, max(0, floor(slider(sl)) - ofs));
  strcpy(#cmb_txt, #pn);
  nv = combo(id, x, y, w, h, v0, n);
  nv != v0 ? ( pg_set(sl, nv + ofs); );
  nv;
);

// Klein-Schalter fuer einen 0/1-Slider
function pg_tgl(sl, x, y, w, h, s, tip) (
  gfx_setfont(5);
  toggle(x, y, w, h, slider(sl) > 0.5, s) ? ( pg_set(sl, slider(sl) > 0.5 ? 0 : 1); );
  pg_hint(x, y, w, h, tip);
);

// Aktionstaste: 1 bei Klick
function pg_act(x, y, w, h, s, tip) local(hit) (
  gfx_setfont(5);
  hit = btn(x, y, w, h, 0, s);
  pg_hint(x, y, w, h, tip);
  hit;
);

// ---------- 0.7.0 (Stufe 2): Helfer der Werkbank-Front (Auswahl, Bereichs-Aktionen, Tastatur) ----------
// Alle Bereichs-Aktionen werden von Knoepfen UND Tasten benutzt. Ohne Auswahl wirken sie auf das ganze Muster; wo es dafuer ein Ganz-Muster-Kommando
// gibt (3..9), wird dieses gesendet (bitgleich zum bisherigen Verhalten). Auswahl, Ansicht, Deck-Zustand und Zwischenablage-Art sind
// fluechtige Front-Zustaende (nicht im Projekt gespeichert).
PG_XK    = 41300;    // Tasten-Diagnose (nur mit Test-Freigabe): [0] = Zaehler, [1..16] Ring der letzten Tastencodes

// naechster Skalenton, wenn SNAP an ist (Alt kehrt fuer eine Geste um); immer in -12..35 geklemmt
function ui_snapE(e) local(r) (
  r = (ui_snap != ((mouse_cap & 16) ? 1 : 0)) ? pg_snapRaw(e, pg_mask()) : e;
  min(35, max(0 - 12, r));
);

function ui_tri(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(OX + x1 * SC, OY + y1 * SC, OX + x2 * SC, OY + y2 * SC, OX + x3 * SC, OY + y3 * SC);
);

// Miniatur eines Musters (ln Steps ab Adresse base) im Kasten x, y, w, h: ein Strich je Step, Hoehe = Tonhoehe 0..24, Accent weiss, Tie blass
function ui_mini(x, y, w, h, base, ln) local(k, ww, ey, sw) (
  sw = w / max(1, ln);
  k = 0;
  loop(ln,
    ww = base[k];
    w_gate(ww) > 0 ? (
      ey = y + (24 - min(24, max(0, w_e(ww)))) * ((h - 2) / 24);
      w_gate(ww) == 2 ? colAcid(0.45) : (w_acc(ww) ? colWhite(0.95) : colAcid(0.85));
      xrect(x + k * sw, ey, max(1, sw - 1), 2);
    );
    k += 1;
  );
);

// Muster-Kommando mit Undo-Marke senden, wenn genug Ring-Plaetze frei sind (Vorab-Sicherung 38 + Kommando + Marke 36); sonst BUSY
function ui_send(c, a, b, d) (
  pg_ringFree() >= 3 ? ( pg_postU(c, a, b, d); 1; ) : ( ui_busyT = time_precise(); 0; );
);
// 0.8.0 (Stufe 5): Slot-Wahl der Front (Knoepfe, Uebersicht, Tasten 1..8). Mit SLOT QUANT <> INSTANT, laufendem Transport und ohne SONG
// geht der Wunsch als Kommando 76 an den @block (Wechsel an der naechsten Grenze, nochmal der laufende Slot = Wunsch verwerfen);
// sonst wie bisher sofort ueber den SLOT-Slider.
function ui_slotSel(j) (
  // 1.0.6 (dsh R006): voller Kommando-Ring -> pg_post verwirft; BUSY zeigen statt den Klick still zu verlieren
  (slider65 > 0.5 && pg_active && pg_songOn == 0) ? ( pg_post(76, j, 0, 0) ? 1 : ( ui_busyT = time_precise(); ); ) : ( pg_set(1, j); );
);

// Aktionsknopf mit Sperre: en = 0 -> gedimmt und wirkungslos. Rueckgabe 1 bei Klick (nur wenn en)
function ui_op(x, y, w, h, s, tip, en) local(hit) (
  gfx_setfont(5);
  hit = btn(x, y, w, h, 0, s);
  en ? 0 : ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(x, y, w, h); );
  pg_hint(x, y, w, h, tip);
  hit && en;
);

function ui_aCopy() (
  // 1.0.6 (dsh R006): clipKind erst setzen, wenn das Kommando wirklich im Ring liegt - sonst wuerde PASTE
  // anschliessend die ALTE Zwischenablage einfuegen (BUSY-Anzeige statt stiller Fehlbedienung)
  ui_sel0 >= 0 ? ( pg_post(42, ui_sel0, ui_sel1, 0) ? ( ui_clipKind = 2; ) : ( ui_busyT = time_precise(); ); )
               : ( pg_post(8, 0, 0, 0) ? ( ui_clipKind = 1; ) : ( ui_busyT = time_precise(); ); );
);
function ui_aCut() (
  pg_ringFree() >= 4 ? (
    ui_sel0 >= 0 ? ( pg_post(42, ui_sel0, ui_sel1, 0); pg_postU(44, ui_sel0, ui_sel1, 0); ui_clipKind = 2; )
                 : ( pg_post(8, 0, 0, 0); pg_postU(7, 0, 0, 0); ui_clipKind = 1; );
  ) : ( ui_busyT = time_precise(); );
);
function ui_aPaste(at) (
  ui_clipKind == 2 ? ui_send(43, at, 0, 0) : ui_send(9, 0, 0, 0);
);
function ui_aClr() (
  ui_sel0 >= 0 ? ui_send(44, ui_sel0, ui_sel1, 0) : ui_send(7, 0, 0, 0);
);
function ui_aRot(d) (
  ui_sel0 >= 0 ? ui_send(47, ui_sel0, ui_sel1, d) : ui_send(3, d, 0, 0);
);
function ui_aRev() (
  ui_sel0 >= 0 ? ui_send(48, ui_sel0, ui_sel1, 0) : ui_send(4, 0, 0, 0);
);
function ui_aInv() (
  ui_sel0 >= 0 ? ui_send(49, ui_sel0, ui_sel1, 0) : ui_send(5, 0, 0, 0);
);
function ui_aTrans(d) (
  ui_send(45, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, d);
);
function ui_aOct(d) (
  ui_send(46, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, d);
);
function ui_aDup() (
  ui_sel0 >= 0 ? ui_send(50, ui_sel0, ui_sel1, 0);
);
// Step-Locks (aktiver Slot): mode 1 sperren, 0 freigeben, 2 umschalten, 3 alle freigeben. Ohne Auswahl wirkt es auf den Step unter dem Zeiger
// (Taste) bzw. auf das ganze Muster (Knoepfe).
function ui_aLock(mode) (
  ui_send(74, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, mode);
);
// MUTATE: mit Auswahl nur in der Auswahl (Kommando-Argumente ersetzen FROM / TO fuer diesen Aufruf, die Slider bleiben unberuehrt)
function ui_aMut() (
  ui_send(2, ui_sel0 >= 0 ? ui_sel0 + 1 : 0, ui_sel0 >= 0 ? ui_sel1 + 1 : 0, 0);
);

// Tastatur: nur mit Zeiger ueber Roll / Spuren (ui_hov), nur ohne offenes Overlay; Schritt unter dem Zeiger = ui_ps (-1 = keiner).
// Belegte Tastencodes: gfx_getchar liefert fuer Buchstaben ASCII, fuer Pfeile / Entf die REAPER-Codes (30064 hoch, 1685026670 runter,
// 1818584692 links, 1919379572 rechts, 6579564 Entf). Ob REAPER sie ohne want_all_kb durchlaesst, zeigt der Tastentest (PG_XK).
function ui_key(k) local(s, w, g, hs, v, np, d, n0, n1) (
  s = ui_ps;
  hs = (s >= 0 && s < ui_len) ? 1 : 0;
  w = hs ? M_PAT[ui_slot * 32 + s] : PG_EMPTY;
  g = w_gate(w);
  (k == 97 || k == 65) ? ( (hs && g == 1) ? ui_send(15, s, 1 - w_acc(w), 0); )
  : (k == 115 || k == 83) ? ( hs ? ui_send(16, s, 1 - w_sld(w), 0); )
  : (k == 103 || k == 71) ? ( hs ? ui_send(14, s, g == 0 ? 1 : 0, 0); )
  : (k == 116 || k == 84) ? ( hs ? ui_send(14, s, g == 2 ? 1 : 2, 0); )
  : (k == 111 || k == 79) ? ( hs ? ( v = w_octf(w) - 1; ui_send(17, s, v >= 2 ? 0 - 1 : v + 1, 0); ); )
  : (k == 112 || k == 80) ? ( hs ? ( v = w_prob(w); np = v > 75 ? 75 : (v > 50 ? 50 : (v > 25 ? 25 : 100)); ui_send(18, s, np, 0); ); )
  : (k == 108 || k == 76) ? ( hs ? ui_send(74, s, s, 2); )          // L: Lock des Steps unter dem Zeiger umschalten
  : (k == 99 || k == 67) ? ( ui_aCopy(); )
  : (k == 120 || k == 88) ? ( ui_aCut(); )
  : (k == 118 || k == 86) ? ( ui_aPaste(hs ? s : (ui_sel0 >= 0 ? ui_sel0 : 0)); )
  : (k == 114 || k == 82) ? ( ui_aRev(); )
  : (k == 105 || k == 73) ? ( ui_aInv(); )
  : k == 91 ? ( ui_aRot(0 - 1); )
  : k == 93 ? ( ui_aRot(1); )
  : (k >= 49 && k <= 56) ? ( ui_slotSel(k - 49); )   // 0.8.0 (Stufe 5): Taste 1..8 = Slot A..H (quantisiert nach SLOT QUANT)
  : k == 122 ? ( PG_UR[0] > 0 ? ui_send(40, 0, 0, 0); )
  : k == 90 ? ( PG_UR[1] > 0 ? ui_send(41, 0, 0, 0); )
  : k == 6579564 ? ( ui_aClr(); )
  : k == 30064 ? ( ui_aTrans(1); )
  : k == 1685026670 ? ( ui_aTrans(0 - 1); )
  : (k == 1818584692 || k == 1919379572) ? (
      ui_sel0 >= 0 ? (
        d = k == 1919379572 ? 1 : 0 - 1;
        n0 = ui_sel0 + d; n1 = ui_sel1 + d;
        (n0 >= 0 && n1 <= ui_len - 1) ? ( ui_sel0 = n0; ui_sel1 = n1; ui_anc = n0; );
      );
    )
  : 0;
);

@slider
// Alle Werte werden direkt aus den Slidern gelesen (@block); hier nichts noetig.

@serialize
// Format PG_SER = 1: [ver][256 Woerter][8 Laengen][16 Ketten-Slots][16 Ketten-Wiederholungen] [+ ab 0.5.0: Preset-Bank (tt_pb_serialize)]
// P25: REAPER-Undo spielt den Zustand ueber diesen Lesezweig in die LAUFENDE Instanz zurueck (jedes Strg+Z). Geprueft: gelesen werden
// nur Muster, Laengen und Kette (+ pg_validate) und die Bank; Notenzustand (pg_snd, M_SN, Queue), Transport und Kommando-Ring bleiben
// unberuehrt -> eine klingende Note endet regulaer (Pause/Gate-Ende des neuen Musters, Slide in eine Pause beendet sie). Abgeleitet wird
// nur die SEQ-LINK-Summe (pg_linkSum = -1); alles andere liest @block je Step neu. Kein Werks-Preset/pg_defaults danach. Format unveraendert.
pg_serVer = PG_SER;
file_var(0, pg_serVer);
pg_serVer == PG_SER ? (
  // Review zcode 17.10.2026 (B2): gelesene Wortzahl pruefen; abgeschnittener Chunk (beim Lesen weniger als 296 Worte) -> Werks-Vorbelegung statt halb alter Daten. Format unveraendert.
  pg_rdN = file_mem(0, M_PAT, 256);
  pg_rdN += file_mem(0, M_LEN, 8);
  pg_rdN += file_mem(0, M_CHS, 16);
  pg_rdN += file_mem(0, M_CHR, 16);
  (file_avail(0) >= 0 && pg_rdN < 296) ? pg_defaults();
  pg_validate();
  pg_linkSum = 0 - 1; pg_chainSum = 0 - 1;
  // 0.7.0 (Stufe 1): nur beim LESEN (REAPER-Undo, Projekt laden) den Undo-Ring leeren; beim Schreiben (Undo-Punkte, Speichern) bleibt er
  pg_serRd = file_avail(0) >= 0 ? 1 : 0;
  pg_serRd ? ( pg_urClear(); pg_sqPend = 0; pg_rqSlot = 0; pg_mutCnt = 0; );   // Review 0.9.0 F6: Mutations-Zaehler wie beim internen Undo (Historie: ohne pg_mutCnt = 0)   // 0.8.0 (Review S5): ein geladener Host-Zustand verwirft wartende Slot-Wechsel
  tt_pb_serialize();   // 0.5.0: Preset-Bank hinter den alten Daten (alte Projekte enden vorher: file_avail = 0 -> Bank bleibt leer)
  // 0.7.0 (Stufe 3): Step-Locks hinter der Bank, mit Versionsmarke. Alte Projekte enden vorher (Marke bleibt 0 -> Locks unveraendert),
  // aeltere Plugin-Staende lesen den Anhang nie. Weicht von der Sollform "tt_pb_serialize zuletzt" ab (Praezedenz: dem Raum-Modul LEARN-Block).
  pg_lkMark = pg_serRd ? 0 : PG_LKMARK;
  file_var(0, pg_lkMark);
  (pg_serRd && pg_lkMark != PG_LKMARK) ? ( memset(PG_LK, 0, 16); );   // Review Codex 0.7.0 (R3): Chunk ohne Anhang = keine Locks
  pg_lkMark == PG_LKMARK ? (
    file_mem(0, PG_LK, 16);
    pg_lkSan = 0;
    loop(16,
      PG_LK[pg_lkSan] = min(65535, max(0, floor(PG_LK[pg_lkSan])));
      pg_lkSan += 1;
    );
  );
);

@block
// 0.6.0 (B3): pg_tb0 steht jetzt hinter der Zeile pg_testOk (gemessen wird nur mit Test-Freigabe)
// ---- Parameter dieses Blocks ----
// 0.6.1 (Review P-F): die Ausgabeparameter stehen in pg_params(); sie werden NACH den Kommandos (Preset/Szene/INIT aendern die Slider)
// noch einmal abgeleitet, sonst galten im Ladeblock alte Rate/ROOT/GATE/... zusammen mit den neuen Mustern.
// Historie: die Zeilen pg_slot = ... pg_humS = ... standen hier einmal vor pg_drain().
pg_params();
pg_testOk = tt_testok();             // P25 (A10): Test-Freigabe (gmem[5189] == 20261001) einmal je Block lesen
pg_testOk ? ( pg_tb0 = time_precise(); );
pg_logEn  = pg_testOk ? floor(slider45) : 0;   // P25: Diagnose-Log nur mit Freigabe (Debug-Slider mit Laufzeitkosten)
// Historie: pg_songN wurde hier, VOR pg_drain(), bestimmt (P25 A9: eine im selben Block geleerte Kettenzelle wurde dann noch
// mitgezaehlt). Jetzt hinter pg_drain().

// ---- Kommandos: Testhook (CMD-Slider) und Front ----
// P25 (A10): CMD (Slider 37) nur mit Test-Freigabe. Ohne Freigabe wird das Kommando verworfen (Slider auf 0, kein ACK) - auch eine
// Automationshuellkurve auf CMD kann so nichts mehr ausloesen (vorher: jedes pg_exec-Kommando in jedem Block, z. B. 7 CLEAR, 31 INIT).
pg_drain();
// 0.6.0 (V7): CMD direkt ausfuehren (Historie: pg_post aus dem @block machte neben @gfx einen zweiten Schreiber auf pg_cw)
slider37 != 0 ? (
  pg_testOk ? (
    pg_exec(slider37, slider38, slider39, slider40);
    pg_ack += 1;
  );
  slider37 = 0;
);
pg_params();   // 0.6.1 (P-F): nach Kommandos/Preset-Laden neu ableiten
pg_stRun();
pg_songN  = 0;
while (pg_songN < 16 && M_CHS[pg_songN] >= 0) ( pg_songN += 1; );

// ---- Transport ----
pg_active = ((play_state & 1) && slider30 > 0.5) ? 1 : 0;
pg_bp0 = beat_position;
pg_adv = samplesblock / pg_beatSamp;

// Kanalwechsel: offene Noten auf dem alten Kanal beenden
pg_ch != pg_chPrev ? (
  pg_chPrev >= 0 ? ( pg_panic(0); );
  pg_chPrev = pg_ch;
);

// FOLLOW umgeschaltet -> Transposition neu bewerten (0.6.0, B5: nur bei Wechsel; Historie: in jedem Block)
pg_follow != pg_followP ? ( pg_followP = pg_follow; pg_recalcTrans(); );

// ---- MIDI-Eingang ----
// 0.6.1 (P-C): Transponierung am Blockanfang merken; Aenderungen im MIDI-Lauf bekommen ihren Offset (pg_transAt)
pg_transB = pg_trans; pg_tevN = 0; pg_curOffs = 0;
while (midirecv(pg_offs, pg_m1, pg_m2, pg_m3)) (
  pg_logEv(0, pg_absPos + pg_offs, pg_m1, pg_m2, pg_m3);
  pg_handleMidi(pg_offs, pg_m1, pg_m2, pg_m3);
);

// ---- Start / Stop / Sprung ----
pg_rs = pg_needPanic ? 1 : 0;
pg_needPanic = 0;
(pg_active && !pg_prevActive) ? (
  pg_rs = 1;
  pg_logN = 0;
  pg_logT0 = pg_absPos;
);
(pg_active && pg_prevActive && (abs(pg_bp0 - (pg_prevBp + pg_prevAdv)) > 0.02 || pg_rate != pg_prevRate)) ? (
  pg_rs = 1;
);
(!pg_active && pg_prevActive) ? (
  pg_panic(0);
  pg_curStep = 0 - 1;
  pg_curSlot = 0 - 1;
  pg_curCell = 0 - 1;
);
pg_rs ? (
  pg_panic(0);
  pg_nextN = pg_firstStep(pg_bp0);
  pg_sqPend ? ( pg_sqN = slider65 < 0.5 ? pg_nextN : pg_sqBound(pg_nextN); );   // 0.8.0 (Review S2): Start / Sprung -> Grenze ab der neuen Position
);
pg_slotProc();   // 0.8.0 (Stufe 5): Slot-Anforderungen (Kommando 76, NOTE TRIG) nach dem Transportzustand

// 0.8.0 (Stufe 5): wartender Slot-Wechsel: ohne Transport / bei SONG sofort; Grenze weiter als eine Einheit voraus (Sprung rueckwaerts) neu rechnen
pg_sqPend ? (
  (!pg_active || pg_songOn) ? (
    pg_sqPend = 0;
    pg_pbSetSl(1, pg_sqSlot);
    pg_slot = pg_sqSlot;
  ) : (
    (pg_stepPos(pg_sqN) - pg_stepPos(pg_nextN) > pg_sqUnit() + 0.000001) ? ( pg_sqN = slider65 < 0.5 ? pg_nextN : pg_sqBound(pg_nextN); );
  );
);

// ---- Steps ausloesen (Vorlauf um den HUMANIZE-Bereich, damit auch Vorziehen ohne Latenz geht) ----
pg_active ? (
  pg_bp1 = pg_bp0 + pg_adv;
  pg_Jb = pg_humS / pg_beatSamp;
  pg_cnt = 0;
  // Review 0.9.0 F5: mit HUM TIME zaehlt die tatsaechliche Startzeit (pg_tabs inkl. Versatz), nicht die Sollposition mit Vorlauf: ein Step,
  // dessen Ton erst im naechsten Block faellt, wird dort ausgeloest und sieht dessen Eingangsnoten (Transponierung). Ohne HUMANIZE unveraendert.
  // Historie: while (pg_cnt < 64 && pg_stepPos(pg_nextN) - pg_Jb < pg_bp1)
  while (pg_cnt < 64 && (pg_humS > 0 ? pg_tabs(pg_nextN) < pg_absPos + samplesblock : pg_stepPos(pg_nextN) < pg_bp1)) (
    pg_fire(pg_nextN);
    pg_nextN += 1;
    pg_cnt += 1;
  );
);
// 0.8.0 (Stufe 5): der Step der Grenze ist ausgeloest -> neuer Slot wird der aktive (SLOT-Slider); pg_locate hat ihn schon verwendet
(pg_sqPend && pg_active && pg_nextN > pg_sqN) ? (
  pg_sqPend = 0;
  pg_pbSetSl(1, pg_sqSlot);
  pg_slot = pg_sqSlot;
);

pg_qDrain();

// ---- SEQ LINK ----
// 1.0.4: LINK ID waehlt den Block dieser Instanz ((ID - 1) * 3000; ID 1 = bisheriges Layout ab gmem[0]). Praesenz-Zellen
// [+198] Version x100, [+199] Herzschlag werden IMMER geschrieben (auch bei SEQ LINK OFF), damit Print-Skripte laufende
// Instanzen finden und "kein Plug-in" von "LINK aus" unterscheiden koennen.
pg_linkBase = (min(8, max(1, floor(slider69))) - 1) * 3000;   // Review 1.0.4 (M1): geklemmt wie die Anzeige - ein Wert ausserhalb 1..8 schriebe sonst in fremden gmem
gmem[pg_linkBase + 198] = PG_PLVER;
pg_linkHb += 1;
gmem[pg_linkBase + 199] = pg_linkHb;
slider34 > 0.5 ? ( pg_linkWrite(); ) : (
  // 1.0.6 (dsh-Review F1): SEQ LINK OFF macht die Bloecke ungueltig - sonst blieben [138]/[200] auf 1 und die
  // Print-Skripte druckten das zuletzt publizierte Muster, statt "LINK aus" zu melden. Pruefsummen invalidieren:
  // beim Wiedereinschalten schreibt der naechste Block sofort neu.
  gmem[pg_linkBase + 138] = 0;
  gmem[pg_linkBase + 200] = 0;
  pg_linkSum = -1;
  pg_chainSum = -1;
);

// ---- Readouts / Abfrage-Bus ----
// 0.6.0 (B3): Diagnose-Readouts (Slider 41..63) nur mit Test-Freigabe; vorher schrieb jeder Block 23 Slider, deren Messwerte in Projekt und
// Presets landeten. pg_blk zaehlt weiter. Historie: Readout-Block ohne Bedingung.
pg_blk += 1;
pg_testOk ? (
  slider41 = pg_ack;
  slider54 = pg_sndCnt;
  slider55 = pg_stDone;
  slider56 = srate;
  slider57 = pg_beatSamp;
  pg_qa = floor(slider42);
  slider43 = pg_query(pg_qa);
  slider58 = pg_query(pg_qa + 1);
  slider59 = pg_query(pg_qa + 2);
  slider60 = pg_query(pg_qa + 3);
  slider44 = pg_qa;
  pg_li = max(0, min(LOGCAP - 1, floor(slider46)));
  pg_lp2 = M_LG + pg_li * 5;
  slider47 = pg_li < pg_logN ? pg_lp2[0] : 0 - 1;
  slider48 = pg_li < pg_logN ? pg_lp2[1] : 0;
  slider49 = pg_li < pg_logN ? pg_lp2[2] : 0;
  slider50 = pg_li < pg_logN ? pg_lp2[3] : 0;
  slider51 = pg_li < pg_logN ? pg_lp2[4] : 0;
  slider52 = pg_logN;
  slider53 = pg_li;

  slider61 = pg_blk;
  // Eigenlast von @block in Mikrosekunden (gleitender Mittelwert ueber ~200 Bloecke, Maximum mit langsamem Abklingen); @gfx nicht enthalten
  pg_dtb = (time_precise() - pg_tb0) * 1000000;
  pg_avg = pg_avg * 0.995 + pg_dtb * 0.005;
  pg_bmax = max(pg_dtb, pg_bmax * 0.9995);
  slider62 = pg_avg;
  slider63 = pg_bmax;
);
pg_slotPrev = pg_slot;   // 0.8.0: Slot nach einem eventuellen Wechsel dieses Blocks (siehe pg_slotProc)
pg_prevActive = pg_active;
pg_prevBp = pg_bp0;
pg_prevAdv = pg_adv;
pg_prevRate = pg_rate;
pg_absPos += samplesblock;

// ---------- Geraetefront ----------
// Designraster 900x640. Die Front liest Slider und Muster direkt, aendert Muster NUR ueber pg_post (Kommandos laufen im @block),
// Slider ueber pg_set. Drag-IDs: 1..9 Generator-Knobs, 10..17 Output-Knobs, 20..30 Combos/Slider, 40 Roll, 41.. Zeilen.
@gfx 1125 800
tth_pre(); tt_pb_pre(); tth_sync(slider64);   // Preset-Leiste: Maske nach tth_pre, vor uikit_begin
uikit_begin(900, 640);
uikit_ground2();
pg_capFonts();                                // P26: Ersatzschriften fuer grosse FONT-Stufen
(mouse_cap & 3) == 0 ? ( pg_gest = 0; );     // 0.6.1 (P-H): neue Edit-Geste, sobald keine Maustaste gehalten wird
gfx_setfont(5);   // (P23: ui_tipOn = 0 entfaellt, Tooltips laufen ueber tt_hov / tt_tipflush)

ui_slot = min(7, max(0, floor(slider1)));
ui_len = M_LEN[ui_slot];
// 0.7.0 (Stufe 2): Seitenwahl ui_page / ui_pg0 sitzt jetzt in der Werkzeugzeile (VIEW) und im Roll-Abschnitt
ui_playHere = (pg_curSlot == ui_slot) ? 1 : 0;
// P25 (A6): hier nur ui_paint zuruecksetzen. ui_drag setzt der Roll-Zweig "Loslassen" selbst zurueck; mit ui_drag = 0 an dieser
// Stelle lief der Zweig "Klick auf eine Note ohne Ziehen = Note entfernen" nie (seit 0.3.0, Tooltip und Manual versprechen es).
// Historie: !uiLmb ? ( ui_drag = 0; ui_paint = 0; );
!uiLmb ? ( ui_paint = 0; );

// Blitze aus dem Ausgabe-Zaehler
pg_evCnt != ui_ec ? ( ui_ec = pg_evCnt; ui_fa = pg_lastAcc; ui_fs = pg_lastSld; ui_fn = 1; );
ui_fa *= 0.90; ui_fs *= 0.90; ui_fn *= 0.93;

// ===== Kopfzeile =====
xshadow(12, 8, 876, 40, 6);
pg_tn(0.06, 0.065, 0.06, 1); xrrect(12, 8, 876, 40, 6, 1);
colAcid(0.85); xrrect(12, 8, 876, 40, 6, 0);
// Historie: gfx_setfont(1);   P26: Wortmarke "TT-303 PATGEN" endet vor der Preset-Leiste (x 292) und bleibt in der Kopfzeile
pg_fit(1, "TT-303 PATGEN", 256, 40);
gfx_measurestr("TT-303", ui_tw, ui_th);
ui_ty = 8 + (40 - ui_th / SC) * 0.5;
colWhite(0.95); pg_capCol(); xstr(30, ui_ty, "TT-303");
colAcid(1); pg_capCol(); xstr(30 + ui_tw / SC + 6, ui_ty, "PATGEN");
// (MIDI-Monitor sitzt seit 0.5.0 in der Slot-Zeile rechts, weil die Preset-Leiste + OPTIONS die Mitte der Kopfzeile belegen;
//  0.5.0-0.5.3 lag das GENERATOR-Panel darueber - seit 0.5.4 beginnt das Panel bei y 84, P25 A3)
pg_tgl(30, 660, 14, 84, 24, slider30 > 0.5 ? "RUN" : "HALT", "RUN: play the pattern with the host transport. HALT stops output and releases held notes");
pg_act(750, 14, 58, 24, "PANIC", "Release all sounding notes immediately (the plug-in also does this on stop, jumps, HALT and channel change)") ? ( pg_post(25, 0, 0, 0); );
gfx_setfont(5); colInk(0.6); xstr(820, 14, #tt_ver);   // P25: #tt_ver aus @init (einzige Versionsstelle; Position/Schrift wie bisher). P23: stand auf v0.5.0
colAcid(0.8); xstr(820, 28, ui_playHere ? "PLAYING" : "");

// ===== Werkzeugzeile (y 54..78) =====
// 0.7.0 (Stufe 2): Layout "Werkbank". Zeile: Slots A..H | UNDO REDO Tiefe | LEN | VIEW | SNAP | MIDI-Monitor. COPY / PASTE und alle Muster-Operationen
// wohnen im Feld SELECTION (unten links), Generator / Ausgabe / Kette im Deck (unten rechts, Reiter). Historie: COPY 292 / PASTE 340 / UNDO 394 /
// LEN 448..532 / Seitenwahl 558 (0.6.2); 0.7.0: REDO neben UNDO.
ui_ini != 1 ? (
  ui_ini = 1;
  ui_sel0 = 0 - 1; ui_sel1 = 0 - 1; ui_anc = 0; ui_selDrag = 0; ui_lastCT = 0; ui_lastCS = 0 - 1;
  ui_view = 0; ui_snap = 0; ui_deckOpen = 1; ui_tab = 0; ui_r0 = 0;
  ui_clipKind = 0; ui_tgt = 1; ui_busyT = 0;
  ui_cell = 0; ui_gAuto = 1; ui_shi = 0; ui_sigP = 0 - 1; ui_sigPend = 0; ui_sigT = 0;
);
ui_i = 0;
loop(8,
  ui_j = ui_i;
  ui_i += 1;
  ui_bx = 12 + ui_j * 32;
  ui_has = 0;
  ui_k = 0;
  while (ui_k < M_LEN[ui_j]) ( ui_has += (w_gate(M_PAT[ui_j * 32 + ui_k]) > 0 ? 1 : 0); ui_k += 1; );
  gfx_setfont(4);
  btn(ui_bx, 56, 28, 24, ui_j == ui_slot, ui_j == 0 ? "A" : ui_j == 1 ? "B" : ui_j == 2 ? "C" : ui_j == 3 ? "D" : ui_j == 4 ? "E" : ui_j == 5 ? "F" : ui_j == 6 ? "G" : "H") ? ( ui_slotSel(ui_j); );
  ui_has > 0 ? ( colAcid(ui_j == ui_slot ? 0.9 : 0.55); xrect(ui_bx + 8, 76, 12, 2); );
  (pg_curSlot == ui_j && pg_curStep >= 0) ? ( colWhite(0.9); xcirc(ui_bx + 23, 60, 2.2, 1); );
  (pg_sqPend && pg_sqSlot == ui_j) ? ( colWhite(floor(time_precise() * 4) & 1 ? 0.95 : 0.35); xrrect(ui_bx, 56, 28, 24, 3, 0); );   // 0.8.0: Wechsel wartet auf die Grenze
  pg_hint(ui_bx, 56, 28, 24, "Pattern slot. Click = edit and play this slot (with SLOT QUANT in OUTPUT the change waits for the beat / bar, a blinking frame marks the waiting slot). A dot marks the slot that is playing, an underline a slot with notes. Keys 1..8 over the roll");
);
ui_un = PG_UR[0]; ui_rn = PG_UR[1];
ui_un > 0 ? sprintf(#ui_tipU, "Undo the last pattern edit (16 steps deep, across slots). %d step(s) left, the next one changes slot %c", ui_un, 65 + (PG_UR + 8 + (ui_un - 1) * PG_UW)[0])
          : strcpy(#ui_tipU, "Undo the last pattern edit (16 steps deep, across slots). Nothing to undo");
ui_rn > 0 ? sprintf(#ui_tipR, "Redo the last undone edit (%d step(s) available, the next one changes slot %c)", ui_rn, 65 + (PG_UR + 8 + PG_UN * PG_UW + (ui_rn - 1) * PG_UW)[0])
          : strcpy(#ui_tipR, "Redo the last undone edit. Nothing to redo (a new edit discards the redo steps)");
pg_act(272, 56, 40, 24, "UNDO", #ui_tipU) ? ( ui_un > 0 ? ui_send(40, 0, 0, 0); );
ui_un == 0 ? ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(272, 56, 40, 24); );
pg_act(316, 56, 40, 24, "REDO", #ui_tipR) ? ( ui_rn > 0 ? ui_send(41, 0, 0, 0); );
ui_rn == 0 ? ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(316, 56, 40, 24); );
gfx_setfont(5); colInk(0.7);
sprintf(#ui_s, "%d/%d", ui_un, PG_UN); xstr(360, 62, #ui_s);
pg_hint(358, 56, 34, 24, "Undo depth: steps that can be undone / ring size. Hover UNDO to see which slot the next step changes");
gfx_setfont(5); colInk(0.85); xstr(398, 62, "LEN");
pg_act(420, 56, 18, 24, "-", "Pattern length -1 (1..32)") ? ( pg_postU(19, ui_len - 1, 0, 0); );
panelBox(440, 56, 28, 24);
sprintf(#ui_s, "%d", ui_len); gfx_setfont(4); colAcid(1); xctr(440, 56, 28, 24, #ui_s);
(inBox(440, 56, 28, 24) && mouse_wheel != 0) ? ( pg_postU(19, ui_len + (mouse_wheel > 0 ? 1 : 0 - 1), 0, 0); );
pg_hint(440, 56, 28, 24, "Pattern length of the active slot in steps (1..32). Mouse wheel = +-1, or use the - and + buttons");
pg_act(470, 56, 18, 24, "+", "Pattern length +1 (1..32)") ? ( pg_postU(19, ui_len + 1, 0, 0); );
// VIEW: FIT zeigt alle Steps des Musters auf einmal; 1-16 / 17-32 zeigen eine Seite mit breiteren Spalten
ui_view = min(ui_view, ui_len > 16 ? 2 : 1);
strcpy(#cmb_txt, ui_view == 0 ? "VIEW FIT" : ui_view == 1 ? "VIEW 1-16" : "VIEW 17-32");
ui_view = combo(35, 494, 56, 84, 24, ui_view, ui_len > 16 ? 3 : 2);
pg_hint(494, 56, 84, 24, "Roll view: FIT shows all steps of the pattern at once, 1-16 / 17-32 shows one page with wider columns");
gfx_setfont(5);
toggle(582, 56, 46, 24, ui_snap, "SNAP") ? ( ui_snap = 1 - ui_snap; );
pg_hint(582, 56, 46, 24, "SNAP: notes you set or drag land on the scale (ROOT + SCALE). Hold Alt to invert for one edit");

// ===== MIDI-Monitor (Slot-Zeile rechts, x 632..888, y 56..80; frei seit P25: GENERATOR-Panel ab y 84) =====
// Historie: gfx_setfont(5)/(4) + xstr ohne Platzpruefung; P26: Monitor-Texte passend in ihre Felder (Zeile y 56..80)
colInk(0.70); pg_strF(640, 62, 5, "LAST NOTE", 62, 14);
pg_lastNote >= 0 ? ( pg_noteStr(pg_lastNote); sprintf(#ui_s, "%s%d", #pn, floor(pg_lastNote / 12) - 1); ) : ( strcpy(#ui_s, "--"); );
colAcid(0.55 + 0.45 * ui_fn); pg_strF(704, 61, 4, #ui_s, 42, 18);
colInk(0.70); pg_strF(748, 62, 5, "STEP", 32, 14);
pg_curStep >= 0 ? sprintf(#ui_s, "%02d/%02d", pg_curStep + 1, M_LEN[max(0, pg_curSlot)]) : strcpy(#ui_s, "--/--");
colAcid(1); pg_strF(782, 61, 4, #ui_s, 54, 18);
pg_tn(0.16, 0.18, 0.15, 1); xcirc(842, 63, 4, 1);
colWhite(ui_fa); xcirc(842, 63, 4, 1); colBorder(); xcirc(842, 63, 4, 0);
colInk(0.75); pg_strF(851, 58, 5, "ACC", 36, 12);
pg_tn(0.16, 0.18, 0.15, 1); xcirc(842, 74, 4, 1);
colAcid(ui_fs); xcirc(842, 74, 4, 1); colBorder(); xcirc(842, 74, 4, 0);
colInk(0.75); pg_strF(851, 69, 5, "SLIDE", 36, 12);
// 0.7.0 (Stufe 1): "WAITING FOR AUDIO" - Kommandos der Front werden im Audio-Thread ausgefuehrt; haengt der Zaehler > 0,5 s hinter dem
// Schreibzaehler (FX umgangen / offline / Audio gestoppt), steht das hier statt des Monitors (Anleitung: Edits need running audio).
(pg_cmdW != pg_cmdA) ? ( ui_waitT == 0 ? ( ui_waitT = time_precise(); ); ) : ( ui_waitT = 0; );
ui_waiting = (ui_waitT > 0 && time_precise() - ui_waitT > 0.5) ? 1 : 0;
ui_busy = (time_precise() - ui_busyT < 1.0) ? 1 : 0;   // 0.7.0: Kommando-Ring voll, Aktion verworfen
(ui_waiting || ui_busy) ? (
  pg_tn(0.10, 0.07, 0.03, 1); xrrect(634, 57, 252, 22, 3, 1);
  gfx_set(1, 0.55, 0, 1); pg_strF(644, 62, 4, ui_waiting ? "WAITING FOR AUDIO" : "BUSY - TRY AGAIN", 232, 14);
);
pg_hint(632, 56, 256, 24, ui_waiting ? "Edits are applied in the audio thread. The plug-in must be active (not bypassed or offline) and the audio engine must run" : "MIDI monitor: last note sent, current step, accent / slide LEDs");

// ===== Roll + Step-Spuren (ganze Breite) =====
// 0.7.0 (Stufe 2): Raster x 52..880 (828 breit). FIT: Spaltenzahl = Laenge (bis 32 Steps auf einmal), sonst 16 Spalten je Seite. Zeilenfenster:
// Deck offen 25 Zeilen (Halbtonfenster ui_r0 .. ui_r0 + 24, Rad auf der Klaviatur verschiebt), Deck zu (FOCUS) alle 48 Zeilen (-12..+35).
// Toene ausserhalb des Fensters stehen als Pfeilmarke am Rand (vorher auf Zeile 0 / 24 geklemmt gezeichnet).
// Historie: Roll x 48 / 16 Spalten zu 34,5 / 25 Zeilen fest, Spuren je 22 hoch bei y 330 + 26 * Zeile.
ui_dk = ui_deckOpen;
ui_rows = ui_dk ? 25 : 48;
ui_r0v = ui_dk ? ui_r0 : (0 - 12);
ui_gx = 52; ui_gy = 102; ui_rh = 8; ui_gw = 828;
ui_fit = ui_view == 0 ? 1 : 0;
ui_cols = ui_fit ? ui_len : 16;
ui_cw = ui_gw / ui_cols;
ui_pg0 = ui_view == 2 ? 16 : 0;
ui_ly = ui_dk ? 326 : 494;                       // oberer Rand der Step-Spuren
ui_rbot = ui_gy + ui_rows * ui_rh;
ui_sel0 >= 0 ? (
  ui_sel0 = min(ui_sel0, ui_len - 1);
  ui_sel1 = min(ui_sel1, ui_len - 1);
  ui_sel1 < ui_sel0 ? ( ui_sel1 = ui_sel0; );
);
xshadow(12, 84, 876, ui_ly + 94 - 84, 6);
panelBox(12, 84, 876, ui_ly + 94 - 84);
// Nummern-/Auswahlzeile
gfx_setfont(5); colInk(0.7);
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_s = ui_pg0 + ui_cc;
  sprintf(#ui_t, "%d", ui_s + 1);
  ui_s >= ui_len ? gfx_set(0.3, 0.3, 0.3, 0.5) : ((ui_s & 3) == 0 ? colAcid(0.9) : colInk(0.55));
  xctr(ui_gx + ui_cc * ui_cw, 90, ui_cw, 12, #ui_t);
);
// Step-Locks: orange Marke ueber der Nummernzeile und leichter Schleier auf der Spalte (nur fuer Steps < Laenge)
ui_lkOn = pg_lkAny(ui_slot);
ui_lkOn ? (
  ui_c = 0;
  loop(ui_cols,
    ui_cc = ui_c;
    ui_c += 1;
    ui_s = ui_pg0 + ui_cc;
    (ui_s < ui_len && pg_lkGet(ui_slot, ui_s)) ? ( gfx_set(1, 0.55, 0, 0.95); xrect(ui_gx + ui_cc * ui_cw + 1, 85, ui_cw - 2, 3); );
  );
);
// Zeilen + Klaviatur
ui_e = 0;
while (ui_e < ui_rows) (
  ui_ee = ui_e;
  ui_e += 1;
  ui_ry = ui_gy + (ui_rows - 1 - ui_ee) * ui_rh;
  ui_ea = ui_r0v + ui_ee;                       // Tonhoehe dieser Zeile (Halbtoene ueber ROOT)
  ui_pc = ui_ea - 12 * floor(ui_ea / 12);
  ui_blk = (ui_pc == 1 || ui_pc == 3 || ui_pc == 6 || ui_pc == 8 || ui_pc == 10) ? 1 : 0;
  ui_blk ? pg_tn(0.030, 0.038, 0.030, 1) : pg_tn(0.058, 0.070, 0.056, 1);
  xrect(ui_gx, ui_ry, ui_gw, ui_rh);
  ui_pc == 0 ? ( colAcid(0.13); xrect(ui_gx, ui_ry + ui_rh - 1, ui_gw, 1); );
  ui_blk ? ( pg_tn(0.10, 0.11, 0.10, 1); xrect(20, ui_ry, 16, ui_rh); )
         : ( gfx_set(0.70, 0.74, 0.70, 1); xrect(20, ui_ry, 26, ui_rh - 1); );
  ui_pc == 0 ? (
    gfx_setfont(5); pg_tn(0.20, 0.26, 0.20, 1); pg_noteStr(36 + floor(slider6) + ui_ea);
    sprintf(#ui_t, "%s%d", #pn, floor((36 + floor(slider6) + ui_ea) / 12) - 1); xstr(22, ui_ry - 1, #ui_t);
  );
);
// Spalten
ui_c = 0;
loop(ui_cols + 1,
  ui_cc = ui_c;
  ui_c += 1;
  ((ui_pg0 + ui_cc) & 3) == 0 ? pg_tn(0.20, 0.30, 0.18, 0.9) : pg_tn(0.10, 0.14, 0.10, 0.8);
  xrect(ui_gx + ui_cc * ui_cw, ui_gy, 1, ui_rows * ui_rh);
);
// Spalten hinter der Laenge
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_pg0 + ui_cc >= ui_len ? ( gfx_set(0, 0, 0, 0.55); xrect(ui_gx + ui_cc * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh); );
);
// Laufbalken
(ui_playHere && pg_curStep >= ui_pg0 && pg_curStep < ui_pg0 + ui_cols) ? (
  colAcid(0.16); xrect(ui_gx + (pg_curStep - ui_pg0) * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh);
);
// gesperrte Spalten leicht orange
ui_lkOn ? (
  ui_c = 0;
  loop(ui_cols,
    ui_cc = ui_c;
    ui_c += 1;
    ui_s = ui_pg0 + ui_cc;
    (ui_s < ui_len && pg_lkGet(ui_slot, ui_s)) ? ( gfx_set(1, 0.55, 0, 0.10); xrect(ui_gx + ui_cc * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh); );
  );
);
// Noten
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_s = ui_pg0 + ui_cc;
  ui_s < ui_len ? (
    ui_w = M_PAT[ui_slot * 32 + ui_s];
    ui_g = w_gate(ui_w);
    ui_ri = w_e(ui_w) - ui_r0v;
    ui_out = ui_ri < 0 ? 0 - 1 : (ui_ri >= ui_rows ? 1 : 0);
    ui_ri = min(ui_rows - 1, max(0, ui_ri));
    ui_ny = ui_gy + (ui_rows - 1 - ui_ri) * ui_rh;
    ui_nx = ui_gx + ui_cc * ui_cw;
    ui_g == 0 ? (
      colDim(0.55); xrrect(ui_nx + 3, ui_ny + 1, ui_cw - 6, ui_rh - 2, 2, 0);   // Geisternote
    ) : (
      ui_g == 2 ? (
        colAcid(0.50); xrect(ui_nx, ui_ny + 1, ui_cw, ui_rh - 2);                  // Tie: reicht bis an den Folge-Step
        gfx_set(0, 0, 0, 0.35); xrect(ui_nx, ui_ny + 3, ui_cw, 2);
      ) : (
        w_acc(ui_w) ? ( colWhite(0.96); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 1); colAcid(1); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 0); )
                    : ( colAcid(1); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 1); );
      );
      // Slide: Verbindung zum Ton des Folge-Steps
      w_sld(ui_w) ? (
        ui_w2 = M_PAT[ui_slot * 32 + ((ui_s + 1) % ui_len)];
        ui_ri2 = min(ui_rows - 1, max(0, w_e(ui_w2) - ui_r0v));
        colWhite(0.85);
        xline(ui_nx + ui_cw - 2, ui_ny + ui_rh * 0.5, ui_nx + ui_cw + 2, ui_gy + (ui_rows - 1 - ui_ri2) * ui_rh + ui_rh * 0.5);
        xline(ui_nx + ui_cw - 2, ui_ny + ui_rh * 0.5 + 1, ui_nx + ui_cw + 2, ui_gy + (ui_rows - 1 - ui_ri2) * ui_rh + ui_rh * 0.5 + 1);
      );
      // Wahrscheinlichkeit < 100: kleiner Punkt
      w_prob(ui_w) < 100 ? ( gfx_set(1, 0.55, 0, 1); xcirc(ui_nx + 6, ui_ny + ui_rh * 0.5, 1.8, 1); );
    );
    // ausserhalb des Fensters: Pfeilmarke am Rand der Spalte
    ui_out != 0 ? (
      colWhite(0.9);
      ui_out > 0 ? ui_tri(ui_nx + ui_cw * 0.5 - 3, ui_gy + 6, ui_nx + ui_cw * 0.5 + 3, ui_gy + 6, ui_nx + ui_cw * 0.5, ui_gy + 1)
                 : ui_tri(ui_nx + ui_cw * 0.5 - 3, ui_rbot - 6, ui_nx + ui_cw * 0.5 + 3, ui_rbot - 6, ui_nx + ui_cw * 0.5, ui_rbot - 1);
    );
  );
);
colBorder(); xrrect(ui_gx, ui_gy, ui_gw, ui_rows * ui_rh, 2, 0);

// Maus im Roll: Ton setzen / ziehen / loeschen; Strg + Ziehen waehlt Steps (Rahmen), Klick in die Nummernzeile waehlt ebenfalls
ui_inroll = inBox(ui_gx, ui_gy, ui_gw, ui_rows * ui_rh) ? 1 : 0;
ui_mc = floor((mX - ui_gx) / ui_cw);
ui_ms = ui_pg0 + ui_mc;
ui_mr = min(ui_rows - 1, max(0, ui_rows - 1 - floor((mY - ui_gy) / ui_rh)));
ui_me = ui_snapE(ui_r0v + ui_mr);
(uiClick && ui_inroll && ui_ms < ui_len && ui_drag == 0 && (mouse_cap & 4)) ? (
  ui_selDrag = 1; ui_anc = ui_ms; ui_sel0 = ui_ms; ui_sel1 = ui_ms;
) : (uiClick && ui_inroll && ui_ms < ui_len && ui_drag == 0) ? (
  ui_w = M_PAT[ui_slot * 32 + ui_ms];
  (w_gate(ui_w) > 0 && w_e(ui_w) == ui_me) ? (
    ui_drag = 1; ui_dS = ui_ms; ui_dE = ui_me; ui_moved = 0;
  ) : (
    pg_postU(12, ui_ms, ui_me, 0);
    ui_drag = 1; ui_dS = ui_ms; ui_dE = ui_me; ui_moved = 1;
  );
);
(ui_drag == 1 && uiLmb) ? (
  ui_me != ui_dE ? ( pg_postU(13, ui_dS, ui_me - ui_dE, 0); ui_dE = ui_me; ui_moved = 1; );
);
(ui_drag == 1 && !uiLmb) ? (
