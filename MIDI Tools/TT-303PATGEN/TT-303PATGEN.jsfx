// Szene i (0..PG_NSCN-1) im Staging-Puffer PG_PBA aufbauen. Senden: pg_pbSend(30, 0) (@gfx) bzw. pg_pbApply() (Test im @block)
function pg_scnBuild(i) (
  pg_scnBegin();
  i == 0 ? pg_scn0()
  : i == 1 ? pg_scn1()
  : i == 2 ? pg_scn2()
  : i == 3 ? pg_scn3()
  : i == 4 ? pg_scn4()
  : i == 5 ? pg_scn5()
  : i == 6 ? pg_scn6()
  : i == 7 ? pg_scn7()
  : i == 8 ? pg_scn8()
  : i == 9 ? pg_scn9()
  : i == 10 ? pg_scn10()
  : i == 11 ? pg_scn11()
  : i == 12 ? pg_scn12()
  : i == 13 ? pg_scn13()
  : i == 14 ? pg_scn14()
  : i == 15 ? pg_scn15()
  : i == 16 ? pg_scn16()
  : i == 17 ? pg_scn17()
  : i == 18 ? pg_scn18()
  : i == 19 ? pg_scn19()
  : i == 20 ? pg_scn20()
  : i == 21 ? pg_scn21()
  : i == 22 ? pg_scn22()
  : i == 23 ? pg_scn23()
  : i == 24 ? pg_scn24()
  : i == 25 ? pg_scn25()
  : i == 26 ? pg_scn26()
  : i == 27 ? pg_scn27()
  : i == 28 ? pg_scn28()
  : i == 29 ? pg_scn29()
  : i == 30 ? pg_scn30()
  : i == 31 ? pg_scn31()
  : i == 32 ? pg_scn32()
  : i == 33 ? pg_scn33()
  : i == 34 ? pg_scn34()
  : i == 35 ? pg_scn35()
  : i == 36 ? pg_scn36()
  : i == 37 ? pg_scn37()
  : i == 38 ? pg_scn38()
  : i == 39 ? pg_scn39();
  memcpy(PG_PBA, tt_pb_buf, PG_PBW);
);
