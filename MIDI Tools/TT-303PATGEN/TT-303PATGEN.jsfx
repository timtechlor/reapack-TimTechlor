// Build scene i (0..PG_NSCN-1) in the staging buffer PG_PBA. Send: pg_pbSend(30, 0) (@gfx) or pg_pbApply() (test in @block)
function pg_scnBuild(i) (
  pg_scnBegin();
  i == 0 ? pg_scn0()
  : i == 1 ? pg_scn1()
  : i == 2 ? pg_scn2()
  : i == 3 ? pg_scn3()
  : i == 4 ? pg_scn4()
  : i == 5 ? pg_scn5()
  : i == 6 ? pg_scn6()
  : i == 7 ? pg_scn7()
  : i == 8 ? pg_scn8()
  : i == 9 ? pg_scn9()
  : i == 10 ? pg_scn10()
  : i == 11 ? pg_scn11()
  : i == 12 ? pg_scn12()
  : i == 13 ? pg_scn13()
  : i == 14 ? pg_scn14()
  : i == 15 ? pg_scn15();
  memcpy(PG_PBA, tt_pb_buf, PG_PBW);
);
// Names of the scenes (result in #pn), factory entry PG_NLIB + i
function pg_scnStr(i) (
  i == 0 ? strcpy(#pn, "S01 ACID TECHNO 140")
  : i == 1 ? strcpy(#pn, "S02 HARD ACID 150")
  : i == 2 ? strcpy(#pn, "S03 ACID HOUSE 124")
  : i == 3 ? strcpy(#pn, "S04 PSY ACID 142")
  : i == 4 ? strcpy(#pn, "S05 MINIMAL ACID 128")
  : i == 5 ? strcpy(#pn, "S06 ELECTRO ACID 130")
  : i == 6 ? strcpy(#pn, "S07 UK ACID 145")
  : i == 7 ? strcpy(#pn, "S08 DUB ACID 118")
  : i == 8 ? strcpy(#pn, "S09 TRIPLET ACID 126")
  : i == 9 ? strcpy(#pn, "S10 MELODIC ACID 122")
  : i == 10 ? strcpy(#pn, "S11 HALFTIME ACID 140")
  : i == 11 ? strcpy(#pn, "S12 RAVE HOOVER 136")
  : i == 12 ? strcpy(#pn, "S13 BODY ACID 125")
  : i == 13 ? strcpy(#pn, "S14 LOFI ACID JAZZ 96")
  : i == 14 ? strcpy(#pn, "S15 POLY ACID 3:4")
  : i == 15 ? strcpy(#pn, "S16 EVOLVING PROB 132")
  : strcpy(#pn, "");
);

// ---------- Command ring: @gfx (and test hooks) write, only @block executes ----------
// P25 (A11): return 1 = queued, 0 = ring full (discarded). pg_ringFree() = free places (ring 64, one stays empty).
function pg_post(c, a, b, d) local(p) (
  ((pg_cw + 1) % 64) != pg_cr ? (
    p = M_CMD + pg_cw * 4;
    p[0] = c; p[1] = a; p[2] = b; p[3] = d;
    pg_cw = (pg_cw + 1) % 64;
    pg_cmdW += 1;   // 0.7.0: counters for "WAITING FOR AUDIO" (front: written - executed)
    1;
  ) : 0;
);
function pg_ringFree() ( (pg_cr - pg_cw - 1 + 128) % 64; );

function pg_exec(c, a, b, d) local(slot, len) (
  slot = min(7, max(0, floor(slider1)));
  len = M_LEN[slot];
  c == 1 ? ( pg_doGenerate(slot); )
  : c == 2 ? ( pg_doMutate(slot, a, b); )
  : c == 3 ? ( pg_undoSave(slot); pg_rotate(slot, a); )
  : c == 4 ? ( pg_undoSave(slot); pg_reverse(slot); )
  : c == 5 ? ( pg_undoSave(slot); pg_invert(slot); )
  : c == 6 ? ( pg_undoSave(slot); pg_double(slot); )
  : c == 7 ? ( pg_undoSave(slot); pg_clear(slot); )
  : c == 8 ? ( pg_copy(slot); )
  : c == 9 ? ( pg_paste(slot); )
  : c == 10 ? ( pg_undoDo(); )
  : c == 11 ? ( M_PAT[slot * 32 + min(31, max(0, a))] = b; )
  : c == 12 ? ( pg_set_note(slot, min(31, max(0, a)), b); )
  : c == 13 ? ( pg_move(slot, min(31, max(0, a)), b); )
  : c == 14 ? ( pg_set_flags(slot, min(31, max(0, a)), b, 0 - 1, 0 - 1); )
  : c == 15 ? ( pg_set_flags(slot, min(31, max(0, a)), 0 - 1, b, 0 - 1); )
  : c == 16 ? ( pg_set_flags(slot, min(31, max(0, a)), 0 - 1, 0 - 1, b); )
  : c == 17 ? ( pg_set_oct(slot, min(31, max(0, a)), b); )
  : c == 18 ? ( pg_set_prob(slot, min(31, max(0, a)), b); )
  : c == 19 ? ( M_LEN[slot] = min(32, max(1, floor(a))); )
  : c == 20 ? ( pg_loadLib(slot, min(31, max(0, floor(a)))); )
  : c == 21 ? (
      M_CHS[min(15, max(0, a))] = b < 0 ? 0 - 1 : min(7, floor(b));
      M_CHR[min(15, max(0, a))] = min(8, max(1, d));
    )
  : c == 22 ? ( pg_stStart(a, b, d); )
  : c == 23 ? ( pg_newSeed(); )
  : c == 25 ? ( pg_panic(0); )
  : c == 26 ? ( M_PAT[min(7, max(0, a)) * 32 + min(31, max(0, b))] = d; )
  : c == 27 ? ( M_LEN[min(7, max(0, a))] = min(32, max(1, floor(b))); )
  : c == 30 ? ( pg_pbApply(); )
  : c == 31 ? ( pg_pbInit(); )
  : c == 32 ? ( pg_pbAck += 1; )
  : c == 33 ? ( pg_pbCapture(); tt_pb_defname(min(31, max(0, floor(a)))); tt_pb_commit(min(31, max(0, floor(a))), PG_PBW); )
  : c == 34 ? ( tt_pb_fetch(min(31, max(0, floor(a)))) > 0 ? ( memcpy(PG_PBA, tt_pb_buf, PG_PBW); pg_pbApply(); tt_pb_select(2, min(31, max(0, floor(a)))); ); )
  : c == 35 ? ( floor(a) >= PG_NLIB ? ( pg_scnBuild(min(PG_NSCN - 1, floor(a) - PG_NLIB)); pg_pbApply(); tt_pb_select(1, min(PG_NFAC - 1, floor(a))); ) : ( pg_loadLib(slot, min(31, max(0, floor(a)))); tt_pb_select(1, min(31, max(0, floor(a)))); ); )   // 0.6.0: a >= 32 = Szene
  : c == 37 ? ( pg_scnBuild(min(PG_NSCN - 1, max(0, floor(a)))); pg_pbApply(); tt_pb_select(1, PG_NLIB + min(PG_NSCN - 1, max(0, floor(a)))); )   // 0.6.0: Szene a (0..15) anwenden (Test)
  : c == 42 ? ( pg_rcopy(slot, a, b); )          // 0.7.0 (stage 2): range operations, a / b = from / to (0-based), d = parameter
  : c == 43 ? ( pg_rpaste(slot, a); )
  : c == 44 ? ( pg_rclear(slot, a, b); )
  : c == 45 ? ( pg_rtrans(slot, a, b, d); )
  : c == 46 ? ( pg_roct(slot, a, b, d); )
  : c == 47 ? ( pg_rrot(slot, a, b, d); )
  : c == 48 ? ( pg_rrev(slot, a, b); )
  : c == 49 ? ( pg_rinv(slot, a, b); )
  : c == 50 ? ( pg_rdup(slot, a, b); )
  : c == 51 ? ( pg_rtoslot(slot, a, b, d); )
  : c == 62 ? ( pg_chIns(a, b, d); )             // 0.7.0 (Stufe 4): Kettenbearbeitung
  : c == 63 ? ( pg_chDel(a); )
  : c == 64 ? ( pg_chMove(a, b); )
  : c == 70 ? ( pg_galGen(); )                  // 0.7.0 (Stufe 3): Galerie
  : c == 71 ? ( pg_galTry(slot, a); )
  : c == 72 ? ( pg_galKeep(a, b); )
  : c == 73 ? ( pg_doMerge(slot, floor(a)); )
  : c == 74 ? ( pg_lkCmd(slot, a, b, floor(d)); )
  : c == 75 ? ( pg_genSeed(slot, a); )
  : c == 76 ? ( pg_slotReq(a, 0); )            // 0.8.0 (stage 5): slot change (quantized per SLOT QUANT), processed by pg_slotProc after the transport evaluation
  : c == 40 ? ( pg_undoBack(); )   // 0.7.0 (stage 1): undo ring one level back (across slots)
  : c == 41 ? ( pg_redoFwd(); )    // 0.7.0 (stage 1): one level forward
  : c == 38 ? ( pg_undoSave(slot); )   // 0.6.1 (P-H): save the undo state BEFORE a direct pattern-edit gesture (@gfx sends it once per gesture)
  : c == 36 ? ( tt_undo(); )   // P25 (A7): undo marker of the front - only AFTER the pattern commands before it; tth_post reports on release
  : 0;
);

function pg_params() (
  pg_slot   = min(7, max(0, floor(slider1)));
  pg_root   = floor(slider6);
  pg_oct    = floor(slider35);
  pg_ch     = min(15, max(0, floor(slider25) - 1));
  pg_accV   = floor(slider26);
  pg_normV  = floor(slider27);
  pg_thr    = floor(slider28);
  pg_gatel  = slider24 / 100;
  pg_sw     = slider23 / 100;
  pg_rate   = floor(slider22);
  pg_L      = pg_rate == 0 ? 0.25 : pg_rate == 1 ? 0.5 : pg_rate == 2 ? (1 / 6) : 0.125;
  pg_follow = slider29 > 0.5 ? 1 : 0;
  pg_songOn = slider33 > 0.5 ? 1 : 0;
  pg_humV   = floor(slider32);
  pg_beatSamp = 60 * srate / (tempo > 0 ? tempo : 120);
  pg_humS   = slider31 * 0.001 * srate;
);

function pg_drain() local(p) (
  while (pg_cr != pg_cw) (
    p = M_CMD + pg_cr * 4;
    pg_cr = (pg_cr + 1) % 64;
    pg_cmdA += 1;
    pg_exec(p[0], p[1], p[2], p[3]);
  );
);

// @gfx: command + execution marker into the ring (counter for the star: take the reference only after execution in @block)
// P25 (A11): send only if both places are free; pg_pbSeq counts up only then. Previously with a full ring (FX bypassed/
// offline, @block stands still) the command could be queued but marker 32 discarded - pg_pbSeq != pg_pbAck forever, the star
// stayed off until reload. Return 1 = sent. pg_undoNeed: undo marker at frame end (see pg_postU).
function pg_pbSend(c, a) (
  pg_ringFree() >= 2 ? (
    pg_pbSeq += 1;
    pg_post(c, a, 0, 0);
    pg_post(32, 0, 0, 0);
    pg_undoNeed = 1;
    1;
  ) : 0;
);
// P25 (A7): send a pattern command from the front and request an undo marker for the frame end (command 36 -> tt_undo() in @block,
// i.e. only after the change; tth_post triggers the "Edit FX" undo point on mouse release). Not for COPY/PANIC.
// 0.6.1 (Review P-H): direct pattern edits (12..19: set/drag note, gate, accent, slide, octave, PROB, length) did not save an
// undo state - the internal UNDO button only swapped M_UND (state before GENERATE/ROT/REV/...). Now the first edit action of a
// gesture (pg_gest, cleared when the mouse is released at frame start) sends command 38 = pg_undoSave beforehand; dragging/painting = one gesture.
function pg_postU(c, a, b, d) local(ok) (
  ok = 1;
  (c >= 12 && c <= 19 && pg_gest == 0) ? (
    pg_ringFree() >= 2 ? ( pg_post(38, 0, 0, 0); pg_gest = 1; ) : ( ok = 0; );
  );
  ok ? ( pg_post(c, a, b, d) ? ( pg_undoNeed = 1; ); );
);

// Checksum of a slot (32 words, weighted) - for quick determinism comparisons
function pg_checksum(slot) local(i, sm) (
  sm = 0;
  i = 0;
  while (i < 32) ( sm += M_PAT[slot * 32 + i] * (2 * i + 1); i += 1; );
  sm;
);

// Query bus for tests: 0..255 words (slot*32+step), 256..263 lengths, 264..279 chain slot, 280..295 reps, 300.. scalars
function pg_query(a) local(r) (
  a = floor(a);
  r = 0;
  a < 256 ? ( r = M_PAT[a]; )
  : a < 264 ? ( r = M_LEN[a - 256]; )
  : a < 280 ? ( r = M_CHS[a - 264]; )
  : a < 296 ? ( r = M_CHR[a - 280]; )
  : a == 300 ? ( r = pg_curStep; )
  : a == 301 ? ( r = pg_curSlot; )
  : a == 302 ? ( r = pg_nextN; )
  : a == 303 ? ( r = pg_trans; )
  : a == 304 ? ( r = pg_sndCnt; )
  : a == 305 ? ( r = pg_qN; )
  : a == 306 ? ( r = M_CLP[0]; )
  : a == 307 ? ( r = M_UND[1]; )
  : a == 308 ? ( r = pg_linkCnt; )
  : a == 309 ? ( r = gmem[0]; )
  : a == 310 ? ( r = gmem[2]; )
  : a == 311 ? ( r = pg_checksum(min(7, max(0, floor(slider1)))); )
  : a == 312 ? ( r = pg_stI; )
  : a == 313 ? ( r = pg_qOvf; )   // 0.6.0 (F6): discarded events (queue full)
  : a == 314 ? ( r = PG_UR[0]; )  // 0.7.0: Undo-Tiefe
  : a == 315 ? ( r = PG_UR[1]; )  // 0.7.0: Redo-Tiefe
  : a == 316 ? ( r = PG_UR[0] > 0 ? (PG_UR + 8 + (PG_UR[0] - 1) * PG_UW)[0] : 0 - 1; )                      // Slot of the next undo level
  : a == 317 ? ( r = PG_UR[1] > 0 ? (PG_UR + 8 + PG_UN * PG_UW + (PG_UR[1] - 1) * PG_UW)[0] : 0 - 1; )     // Slot of the next redo level
  : a == 318 ? ( r = pg_cmdW - pg_cmdA; )   // 0.7.0: ausstehende Kommandos (Front -> @block)
  : a == 319 ? ( r = PG_RCL[0]; )           // 0.7.0: Bereichs-Zwischenablage (Anzahl Steps)
  : (a >= 384 && a < 400 && tt_testok()) ? ( r = PG_XK[a - 384]; )   // 0.7.0: key diagnostics (384 = counter, 385..399 = ring of the last codes)
  : a >= 320 && a < 384 ? ( r = M_ST[a - 320]; )
  : a == 400 ? ( r = tt_pb_count(); )
  : a == 401 ? ( r = tt_pb_curKind*1000 + tt_pb_cur; )
  : a == 402 ? ( r = pg_pbSum(); )
  : a == 403 ? ( r = tt_pb_mod; )
  : a == 404 ? ( r = pg_pbSeq - pg_pbAck; )
  // P25 (A10): slot / name checksums (344 or TTPB_NW iterations per query, four times per block) only with test enable -
  // a leftover Q ADDR would otherwise have caused constant load in the audio thread.
  : (a >= 420 && a < 452 && tt_testok()) ? (
      pg_qi = 0; loop(PG_PBW, r += (tt_pb_data + (a - 420)*PG_PBW)[pg_qi]*(pg_qi + 1); pg_qi += 1; );
    )
  : (a >= 460 && a < 492 && tt_testok()) ? (
      pg_qi = 0; loop(TTPB_NW, r += (tt_pb_names + (tt_pb_nfac + a - 460)*TTPB_NW)[pg_qi]*(pg_qi + 1); pg_qi += 1; );
    )
  : (a >= 500 && a < 508) ? ( r = slider(1 + a - 500); )
  // 0.7.0 (stage 3): 512..767 candidates (8 x 32 words), 768..775 seeds, 776..791 locks (2 words per slot), 792..807 seed history (ring),
  // 808 = history counter, 809 = length of the candidates, 810 = batch counter
  : (a >= 512 && a < 768) ? ( r = PG_GAL[a - 512]; )
  : (a >= 768 && a < 776) ? ( r = PG_GS[a - 768]; )
  : (a >= 776 && a < 792) ? ( r = PG_LK[a - 776]; )
  : (a >= 792 && a < 808) ? ( r = PG_SH[a - 792]; )
  : a == 808 ? ( r = PG_SH[16]; )
  : a == 809 ? ( r = pg_galLen; )
  : a == 810 ? ( r = pg_galCtr; )
  // 0.8.0 (stage 5): 811 pending slot change (0 / 1), 812 target slot, 813 boundary (step counter), 814 unit in steps
  : a == 811 ? ( r = pg_sqPend; )
  : a == 812 ? ( r = pg_sqSlot; )
  : a == 813 ? ( r = pg_sqN; )
  : a == 814 ? ( r = floor(pg_sqUnit() * 1000 + 0.5); )   // Einheit in Millibeats
  : 0;
  r;
);

// ---------- Playback: grid, song position, PROB/HUMANIZE, trigger step ----------
// Position of step n (global counter from beat 0) in beats; odd steps delayed by (2*SWING-1)*L
function pg_stepPos(n) local(o) (
  o = n - 2 * floor(n / 2);
  n * pg_L + o * (2 * pg_sw - 1) * pg_L;
);

// First step with position >= bp0 (with 1e-7 beat tolerance, so that a start on the grid hits step 0)
function pg_firstStep(bp0) local(n) (
  n = ceil(bp0 / pg_L - 0.000000001);
  while (pg_stepPos(n - 1) >= bp0 - 0.0000001) ( n -= 1; );
  while (pg_stepPos(n) < bp0 - 0.0000001) ( n += 1; );
  n;
);

// 0.8.0 (stage 5): boundary of the quantized change: first step from step n0 whose position lies on / behind the next unit boundary (beats)
function pg_sqBound(n0) local(ub) (
  ub = max(0.01, pg_sqUnit());   // Review 17.10.2026 (B1): ts_num = 0 -> bpb = 0 -> division by zero
  pg_firstStep(ceil(pg_stepPos(n0) / ub - 0.000000001) * ub);
);
// Process request (in @block behind the transport evaluation: pg_active, pg_nextN, pg_bp0 apply to this block)
function pg_slotProc() local(sl, n0, nn) (
  (pg_sqPend && pg_slot != pg_slotPrev) ? ( pg_sqPend = 0; );   // SLOT changed from outside (automation, front without quantization): request lapses
  pg_rqSlot > 0 ? (
    sl = pg_rqSlot - 1;
    pg_rqSlot = 0;
    sl == pg_slot ? (
      pg_sqPend = 0;   // back to the running slot: discard the pending change
    ) : (!pg_active || pg_songOn) ? (
      pg_sqPend = 0;
      pg_pbSetSl(1, sl);
      pg_slot = sl;
    ) : (
      n0 = pg_nextN;
      nn = 0;
      while (nn < 64 && (pg_stepPos(n0) - pg_bp0) * pg_beatSamp < pg_rqOffs) ( n0 += 1; nn += 1; );
      pg_sqSlot = sl;
      pg_sqN = slider65 < 0.5 ? n0 : pg_sqBound(n0);
      pg_sqPend = 1;
    );
  );
);

// Step n -> (pg_ls = slot, pg_lp = step in slot). Song mode: chain of slots with repeats, computed statelessly from n.
// P25 (A9): count only the leading VALID chain cells (k). If a cell was cleared in the same block, the loop previously
// read M_LEN[-1] (= step word from slot H) as length and a foreign word as step. pg_songN is additionally determined only after
// pg_drain() (@block); this check is the second safeguard.
function pg_locate(n) local(len, tot, p, i, span, sl, go, k) (
  pg_lc = 0 - 1; pg_lq = 0; pg_lt = 0;   // 0.8.1: song position (cell, step in the chain, chain length) for the running playhead of the SONG view
  k = 0;
  pg_songOn ? ( while (k < pg_songN && M_CHS[k] >= 0 && M_CHS[k] <= 7) ( k += 1; ); );
  k > 0 ? (
    tot = 0;
    i = 0;
    while (i < k) ( tot += M_LEN[M_CHS[i]] * M_CHR[i]; i += 1; );
    tot = max(1, tot);
    p = n - tot * floor(n / tot);
    pg_lq = p; pg_lt = tot;
    pg_ls = M_CHS[0];
    pg_lp = 0;
    go = 1;
    i = 0;
    while (i < k && go) (
      sl = M_CHS[i];
      len = M_LEN[sl];
      span = len * M_CHR[i];
      i += 1;
      p < span ? ( pg_ls = sl; pg_lp = p - len * floor(p / len); pg_lc = i - 1; go = 0; ) : ( p -= span; );
    );
  ) : (
    sl = (pg_sqPend && n >= pg_sqN) ? pg_sqSlot : pg_slot;   // 0.8.0 (Stufe 5): wartender quantisierter Wechsel
    len = M_LEN[sl];
    pg_ls = sl;
    pg_lp = n - len * floor(n / len);
  );
);

// Step word with EFFECTIVE gate: PROB < 100 rolls deterministically via hash(seed, step, n); PROB 0 = never
function pg_effWord(n) local(w, g, p) (
  pg_locate(n);
  w = M_PAT[pg_ls * 32 + pg_lp];
  g = w_gate(w);
  p = w_prob(w);
  (g > 0 && p < 100) ? ( pg_hash(slider2, pg_lp, n, 1) * 100 >= p ? ( g = 0; ); );
  w - w_gate(w) * 128 + g * 128;
);

// absolute send time (samples) of step n including HUMANIZE offset (+-, deterministic), never before block start
function pg_tabs(n) local(t, dev) (
  t = pg_absPos + (pg_stepPos(n) - pg_bp0) * pg_beatSamp;
  dev = 0;
  pg_humS > 0 ? ( dev = (pg_hash(slider2, 0, n, 2) * 2 - 1) * pg_humS; );
  max(pg_absPos, floor(t + dev + 0.5));
);

// 0.6.1 (Review P-C): transposition at time t (absolute samples). pg_transB = value at block start, M_TT/M_TV = changes by
// input notes of this block with their sample offset (pg_recalcTrans), chronological. A step before the offset of the input note
// still sounds in the old position. Historie: pg_trans (final state of the block) applied to all steps of the block.
function pg_transAt(t) local(v, i, go) (
  v = pg_transB;
  i = 0;
  go = 1;
  while (go && i < pg_tevN) (
    M_TT[i] <= t ? ( v = M_TV[i]; i += 1; ) : ( go = 0; );
  );
  v;
);

// Trigger step n. Slide: note-on of the following note BEFORE the note-off of the previous one (overlap max(1 sample, 0.5*GATE LEN*step));
// Tie: note holds across the step boundary; a slide only counts if the following step is a normal gate step.
// P25 (A1): start times monotonic - step n starts at least 1 sample after step n-1 (pg_tLast), TonN with the same clamp
// (TonN aus fire(n) = Ton aus fire(n+1)). Vorher konnte HUMANIZE (1/32 bzw. 1/16T, viel Swing, HUM TIME ab 15 ms) Step n+1
// before step n; with a slide the off of the old note then came before its on and the note hung until stop/PANIC.
// Without HUMANIZE and at small HUM TIME the clamp never engages (output unchanged). Oracle: tt-303patgen_model.py (clamp).
// Historie: Ton = pg_tabs(n); TonN = pg_tabs(n + 1);
// P25 (A13): at the start of a new non-slide note pull pending offs forward to Ton (pg_qPullOffs), at slide start only offs
// of the same pitch (found with the invariant check check.py prop: X -> Y -> X at 1/16T, swing 66, HUM 20, GATE 100).
function pg_fireDo(n) local(Ton, TonN, wA, wB, g, gN, e, acc, sl, note, vel, dur, gl, ovl, off, cont, started, hv) (
  Ton = max(pg_tabs(n), pg_tLast + 1);
  TonN = max(pg_tabs(n + 1), Ton + 1);
  pg_tLast = Ton;
  wA = pg_effWord(n);
  pg_curSlot = pg_ls;
  pg_curStep = pg_lp;
  pg_curCell = pg_lc; pg_curQ = pg_lq; pg_curTot = pg_lt;   // 0.8.1
  wB = pg_effWord(n + 1);
  g = w_gate(wA);
  gN = w_gate(wB);
  acc = w_acc(wA);
  sl = w_sld(wA);
  e = w_e(wA);
  // 0.6.1 (Review P-C): input transposition with exact timing - the value that applied at the start time Ton of this step (pg_transAt), not the
  // final state of the block. Historie: ... + e + pg_trans));
  note = min(127, max(0, 36 + pg_root + 12 * pg_oct + e + pg_transAt(Ton)));
  dur = pg_L * pg_beatSamp;
  gl = max(1, floor(pg_gatel * dur));
  ovl = max(1, floor(0.5 * gl));
  vel = acc ? pg_accV : pg_normV;
  pg_humV > 0 ? (
    hv = pg_hash(slider2, 0, n, 3);
    vel = vel + floor((hv * 2 - 1) * pg_humV + 0.5);
    acc ? ( vel = max(pg_thr, min(127, vel)); ) : ( vel = min(pg_thr - 1, max(1, vel)); );
  );
  vel = max(1, min(127, vel));
  cont = 0;
  started = 0;
  (g == 2 && pg_snd < 0) ? ( g = 1; );
  g == 2 ? (
    cont = 1;
  ) : g == 1 ? (
    pg_snd >= 0 ? (
      (pg_openSlide && note != pg_snd) ? (
        pg_qPullOffs(Ton, note);
        pg_qPush(Ton, 0x90 + pg_ch, note, vel);
        pg_qPush(Ton + ovl, 0x80 + pg_sndCh, pg_snd, 0);
        started = 1;
      ) : (pg_openSlide && note == pg_snd) ? (
        cont = 1;
      ) : (
        pg_qPullOffs(Ton, 0 - 1);
        pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
        pg_qPush(Ton, 0x90 + pg_ch, note, vel);
        started = 1;
      );
    ) : (
      pg_qPullOffs(Ton, 0 - 1);
      pg_qPush(Ton, 0x90 + pg_ch, note, vel);
      started = 1;
    );
    started ? ( pg_snd = note; pg_sndCh = pg_ch; );
  ) : (
    pg_snd >= 0 ? (
      pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  );
  (started || cont) ? (
    gN == 2 ? (
      pg_openSlide = 0;
    ) : (sl && gN == 1) ? (
      pg_openSlide = 1;
    ) : (
      off = Ton + gl;
      gN >= 1 ? ( off = min(off, TonN - 1); );
      off = max(off, Ton + 1);
      pg_qPush(off, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  );
  started ? (
    pg_lastNote = note;
    pg_lastAcc = acc;
    pg_lastSld = pg_openSlide;
    pg_evCnt += 1;
  );
);

// 0.6.1 (Review P-B): queue groups only completely. A step creates up to three events (off of the predecessor note, on, own
// off); the pass-through leaves only 64 places free, but a block can trigger up to 64 steps (slide: on + off per change) - the
// discarded off left the note hanging. If the places do not suffice for the whole group (4 places stay reserved for closing offs),
// the step is dropped: no on, and a still open note gets its off (also one whose off had not been queued yet: open
// slide or tie sequence). This case occurs only with CC floods above 190 events in the same block. pg_qOvf counts the dropout.
// Historie: pg_fire(n) = body above (pg_fireDo), without the space check.
function pg_fire(n) local(Ton) (
  (pg_qN + 3 > QCAP - 4) ? (
    Ton = max(pg_tabs(n), pg_tLast + 1);
    pg_tLast = Ton;
    pg_effWord(n);
    pg_curSlot = pg_ls;
    pg_curStep = pg_lp;
    pg_curCell = pg_lc; pg_curQ = pg_lq; pg_curTot = pg_lt;   // 0.8.1
    pg_qOvf += 1;
    pg_snd >= 0 ? (
      pg_qPush(Ton, 0x80 + pg_sndCh, pg_snd, 0);
      pg_snd = 0 - 1;
      pg_openSlide = 0;
    );
  ) : (
    pg_fireDo(n);
  );
);

// ---------- MIDI input: notes transpose the pattern (C2 = 36 = original position), are never passed through; the rest goes through ----------
function pg_recalcTrans() local(i, cnt, hi) (
  cnt = 0;
  i = 0;
  while (i < 128) ( cnt += (M_HELD[i] != 0 ? 1 : 0); i += 1; );
  // Historie (V2, 0.6.0): pg_nHeld = cnt; (was never read)
  pg_trans = (pg_follow && cnt > 0 && M_HELD[pg_lastHeld] != 0) ? pg_lastHeld - 36 : 0;
  (pg_follow && cnt > 0 && M_HELD[pg_lastHeld] == 0) ? (
    hi = 127;
    while (hi > 0 && M_HELD[hi] == 0) ( hi -= 1; );
    pg_lastHeld = hi;
    pg_trans = hi - 36;
  );
  // 0.6.1 (P-C): remember change with timestamp (pg_curOffs sets pg_handleMidi; calls before the MIDI loop are discarded with pg_tevN = 0)
  // 0.6.2 (Codex P10 R2): full (M_TEV, then 30) -> discard the oldest entry (its value becomes the block start value), the last M_TEV changes stay with
  // exact timestamp and the final state is always the last. Historie: M_TV[29] = pg_trans (new value with old timestamp, too early)
  pg_tevN >= M_TEV ? (
    pg_transB = M_TV[0];
    i = 0;
    while (i < M_TEV - 1) ( M_TT[i] = M_TT[i + 1]; M_TV[i] = M_TV[i + 1]; i += 1; );
    pg_tevN = M_TEV - 1;
  );
  M_TT[pg_tevN] = pg_absPos + pg_curOffs;
  M_TV[pg_tevN] = pg_trans;
  pg_tevN += 1;
);

function pg_handleMidi(offs, m1, m2, m3) local(st, tb) (
  st = m1 - m1 % 16;
  pg_curOffs = offs;   // 0.6.1 (P-C): timestamp for pg_recalcTrans
  tb = pg_trigBase();
  // 0.8.0 (stage 5): NOTE TRIG - eight notes from TRIG BASE switch slots A..H (quantized like SLOT QUANT), do not transpose and are
  // not passed through (note-off likewise). When switched off everything runs bit-identically to before.
  (slider66 > 0.5 && (st == 0x90 || st == 0x80) && m2 >= tb && m2 < tb + 8) ? (
    (st == 0x90 && m3 > 0) ? ( pg_slotReq(m2 - tb, offs); )
    : ( M_HELD[m2] != 0 ? ( M_HELD[m2] = 0; pg_recalcTrans(); ); );   // Review S7: if the note was held before NOTE TRIG was switched on, FOLLOW now ends as well
  ) : (st == 0x90 && m3 > 0) ? (
    M_HELD[m2] = 1;
    pg_lastHeld = m2;
    pg_recalcTrans();
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    M_HELD[m2] = 0;
    pg_recalcTrans();
  ) : (
    (st == 0xB0 && (m2 == 123 || m2 == 120)) ? (
      pg_panic(offs);
      memset(M_HELD, 0, 128);
      pg_recalcTrans();
    );
    pg_qPushThru(pg_absPos + offs, m1, m2, m3);   // 0.6.0 (F6); Historie: pg_qPush
  );
);

// ---------- SEQ LINK: sender in gmem namespace tt303pg (protocol see manual) ----------
// gmem[0]=30301 magic, [1]=1 version, [2]=length, [3]=write counter, [4+4*s+k] = step s, field k: 0 note (MIDI absolute),
// 1 gate (tie = 1), 2 accent, 3 slide (a tie is expressed as a slide of the predecessor). Active slot only, without transposition.
// Extension (for the ReaScript "Print to MIDI Item"): [132]=step length in beats, [133]=swing (0.5..0.75), [134]=gate length (step fraction),
// [135]=ACC VEL, [136]=NORM VEL, [137]=MIDI channel 1..16, [138]=1 (extension valid).
// Chain block: [200] = 1 valid, [201] = write counter, [202] = cells (up to the first empty one), [203 + 2 * j] = slot, [204 + 2 * j] = repeats
// (j < 16); per slot k (0..7) from 240 + 164 * k: [0] = length, [1 + 4 * s ..] = note, gate (tie = 1), accent, slide (as gmem[4..]; tie as slide of the
// predecessor; except at step 0: there the reader sets the predecessor's slide bit itself, because in the chain the predecessor is the last step
// of the previous cell), [129 + s] = 1 on tie. Notes absolute as above (ROOT and OCTAVE are included).
// Review Codex 0.7.0 (R2): spacing 164 instead of 160, otherwise the tie flag of step 31 (129 + 31 = 160) lay on the length of the next slot.
function pg_linkChainWrite() local(sum, i, k, s, ss, w, g, b, len, nc) (
  sum = 7;
  i = 0;
  while (i < 16) ( sum = (sum * 31 + M_CHS[i] * 9 + M_CHR[i]) % 2147483647; i += 1; );
  i = 0;
  while (i < 256) ( sum = (sum * 31 + M_PAT[i]) % 2147483647; i += 1; );
  i = 0;
  while (i < 8) ( sum = (sum * 31 + M_LEN[i]) % 2147483647; i += 1; );
  sum = (sum * 31 + pg_root * 7 + pg_oct * 131 + floor(pg_L * 1000) * 977 + floor(pg_sw * 1000) * 101 + floor(pg_gatel * 1000) * 13 + pg_accV * 31 + pg_normV * 37 + pg_ch * 41) % 2147483647;
  sum != pg_chainSum ? (
    pg_chainSum = sum;
    gmem[200] = 0;   // Review Codex 0.7.0 (R5): invalid while writing, the reader tries again
    nc = 0;
    while (nc < 16 && M_CHS[nc] >= 0) ( nc += 1; );
    gmem[202] = nc;
    i = 0;
    while (i < 16) ( gmem[203 + 2 * i] = M_CHS[i]; gmem[204 + 2 * i] = M_CHR[i]; i += 1; );
    k = 0;
    while (k < 8) (
      b = 240 + 164 * k;
      len = M_LEN[k];
      gmem[b] = len;
      s = 0;
      while (s < len) (
        w = M_PAT[k * 32 + s];
        g = w_gate(w);
        gmem[b + 1 + 4 * s] = min(127, max(0, 36 + pg_root + 12 * pg_oct + w_e(w)));
        gmem[b + 2 + 4 * s] = (g > 0 ? 1 : 0);
        gmem[b + 3 + 4 * s] = (g == 1 ? w_acc(w) : 0);
        gmem[b + 4 + 4 * s] = w_sld(w);
        gmem[b + 129 + s] = (g == 2 ? 1 : 0);
        s += 1;
      );
      s = 0;
      while (s < len) (
        ss = s;
        s += 1;
        (ss > 0 && w_gate(M_PAT[k * 32 + ss]) == 2) ? ( gmem[b + 4 + 4 * (ss - 1)] = 1; );   // Review Codex 0.7.0 (R4): step 0 is set by the reader
      );
      k += 1;
    );
    gmem[200] = 1;
    gmem[201] = gmem[201] + 1;
  );
);

function pg_linkWrite() local(slot, len, s, ss, w, sum, g, nt, pv) (
  slot = pg_slot;
  len = M_LEN[slot];
  sum = len * 1000003 + pg_root * 7 + pg_oct * 131 + slot + floor(pg_L * 1000) * 977 + floor(pg_sw * 1000) * 101 + floor(pg_gatel * 1000) * 13 + pg_accV * 31 + pg_normV * 37 + pg_ch * 41;
  s = 0;
  while (s < len) ( sum = (sum * 31 + M_PAT[slot * 32 + s]) % 2147483647; s += 1; );
  sum != pg_linkSum ? (
    pg_linkSum = sum;
    gmem[138] = 0;   // 1.0.2: invalid while being written (like gmem[200] for the chain block), the print script reads again; gmem[138] = 1 and gmem[3] + 1 are only set after the data
    s = 0;
    while (s < len) (
      w = M_PAT[slot * 32 + s];
      g = w_gate(w);
      nt = min(127, max(0, 36 + pg_root + 12 * pg_oct + w_e(w)));
      gmem[4 + 4 * s] = nt;
      gmem[4 + 4 * s + 1] = (g > 0 ? 1 : 0);
      gmem[4 + 4 * s + 2] = (g == 1 ? w_acc(w) : 0);
      gmem[4 + 4 * s + 3] = w_sld(w);
      s += 1;
    );
    s = 0;
    while (s < len) (
      w = M_PAT[slot * 32 + s];
      ss = s;
      s += 1;
      w_gate(w) == 2 ? ( gmem[4 + 4 * ((ss + len - 1) % len) + 3] = 1; );
    );
    // 0.6.1 (Review P-D): tie flags per step (1 = tie: predecessor's note holds, own note does not count) in gmem[140..171], valid
    // if gmem[139] = 1. The old fields (tie = gate 1 + slide of the predecessor) stay unchanged, older print scripts keep working.
    s = 0;
    while (s < len) (
      gmem[140 + s] = (w_gate(M_PAT[slot * 32 + s]) == 2);
      s += 1;
    );
    gmem[139] = 1;
    gmem[132] = pg_L;
    gmem[133] = pg_sw;
    gmem[134] = pg_gatel;
    gmem[135] = pg_accV;
    gmem[136] = pg_normV;
    gmem[137] = pg_ch + 1;
    gmem[138] = 1;
    gmem[0] = 30301;
    gmem[1] = 1;
    gmem[2] = len;
    gmem[3] = gmem[3] + 1;
    pg_linkCnt += 1;
  );
  // 0.7.0 (stage 4): chain + all patterns from gmem[200], valid if gmem[200] = 1 (gmem[201] counts up). The block is purely additive:
  // gmem[0..171] stay as before, older print scripts never read it. Recomputed only on change (checksum over chain + 8 patterns).
  pg_linkChainWrite();
);

// ---------- Init data: library (32 patterns), Markov counts, preassignment ----------
function pg_libInit() (
  pg_libAdd(0, "aAa_m_a_a_mAa_k_aAa_m_a_d_a_kSh_");   // Roll One
  pg_libAdd(1, "a_a_aAm_._a_a_mAa_._aAd_a_k_a_m_");   // Roll Two
  pg_libAdd(2, "aA._a_a_m_a_a_._aAa_mSk_a_a_d_._");   // Roll Three
  pg_libAdd(3, "a_mAa_a_k_a_mAa_a_d_a_m_aAa_k_a_");   // Roll Four
  pg_libAdd(4, "aAa_a_m_a_a_k_a_mAa_a_h_a_d_a_kS");   // Roll Five
  pg_libAdd(5, "a_-_a_mAa_-_a_m_a_-_aAk_a_d_a_hS");   // Roll Six
  pg_libAdd(6, "aAa_m_a_aSd_a_m_a_k_aAa_m_a_hSf_");   // Roll Seven
  pg_libAdd(7, "a_a_mAa_a_a_k_aAa_m_a_a_d_a_mSk_");   // Roll Eight
  pg_libAdd(8, "aSd_._aA._a_hSf_._a_kA._a_dSa_._");   // Sparse One
  pg_libAdd(9, "aA._._a_dSf_._aSg_h_._aA._kSa_._");   // Sparse Two
  pg_libAdd(10, "a_._aSd_._aAh_._kSh_._a_fA._aSd_");   // Sparse Three
  pg_libAdd(11, "aA-_a_._dSa_._hA-_kSh_._a_f_._a_");   // Sparse Four
  pg_libAdd(12, "aSf_._gAh_._aSd_._dA._fSa_._k_._");   // Sparse Five
  pg_libAdd(13, "a_._._aA._dSf_a_._h_._kAa_._._d_");   // Sparse Six
  pg_libAdd(14, "aA._dSh_._._a_aSf_._a_kA._h_aSd_");   // Sparse Seven
  pg_libAdd(15, "aSd_._a_dA._f_aSg_._hA._kSa_._h_");   // Sparse Eight
  pg_libAdd(16, "aAa_b_a_a_b_aAd_a_b_a_hSf_a_b_a_");   // Drive One
  pg_libAdd(17, "a_b_aAa_d_a_b_a_aAhSf_a_b_aAa_m_");   // Drive Two
  pg_libAdd(18, "aAb_a_b_a_d_aSb_aAa_d_b_a_hSg_f_");   // Drive Three
  pg_libAdd(19, "a_a_b_aAa_b_d_a_a_b_aAa_d_b_a_mS");   // Drive Four
  pg_libAdd(20, "aAa_bSa_d_a_bSa_f_a_hAa_b_a_d_a_");   // Drive Five
  pg_libAdd(21, "a_b_a_d_aAb_a_f_a_b_aAg_a_h_b_a_");   // Drive Six
  pg_libAdd(22, "aAa_a_b_a_a_d_aSb_a_hAb_a_a_fSg_");   // Drive Seven
  pg_libAdd(23, "a_b_a_aAd_a_b_a_hAa_b_a_dSf_a_b_");   // Drive Eight
  pg_libAdd(24, "aA._a_a_._aSk_._a_aA._a_k_._d_a_");   // Squelch One
  pg_libAdd(25, "a_._aA._a_k_aSa_._a_._aAk_._a_a_");   // Squelch Two
  pg_libAdd(26, "aAa_._a_k_._aA._a_kSa_._a_d_._a_");   // Squelch Three
  pg_libAdd(27, "a_._a_aAk_._a_._a_hSk_._aAa_k_._");   // Squelch Four
  pg_libAdd(28, "aA._._a_._a_k_a_._aSa_._aA._kSd_");   // Squelch Five
  pg_libAdd(29, "a_a_._aA-_a_d_._a_a_k_-_aAa_._a_");   // Squelch Six
  pg_libAdd(30, "aA._a_._k_a_._aA._a_d_._k_aSa_._");   // Squelch Seven
  pg_libAdd(31, "a_._aAk_a_._a_aA._k_a_._d_a_k_._");   // Squelch Eight
);

// Markov counts 12x12 (row = from pitch class, column = to): transitions between consecutive played notes
// of the 32 own library patterns (rests/ties skipped, cyclic), generated with tt-303patgen_lib.py
function pg_mkInit() (
  M_MKV[0] = 146; M_MKV[1] = 25; M_MKV[3] = 36; M_MKV[5] = 7; M_MKV[6] = 3; M_MKV[7] = 16; M_MKV[10] = 31;
  M_MKV[12] = 28; M_MKV[15] = 1;
  M_MKV[36] = 30; M_MKV[37] = 2; M_MKV[39] = 1; M_MKV[41] = 5; M_MKV[43] = 1; M_MKV[46] = 1;
  M_MKV[60] = 15; M_MKV[66] = 2;
  M_MKV[72] = 2; M_MKV[77] = 1; M_MKV[79] = 3;
  M_MKV[84] = 12; M_MKV[85] = 2; M_MKV[89] = 4; M_MKV[90] = 1; M_MKV[94] = 5;
  M_MKV[120] = 31; M_MKV[123] = 2; M_MKV[127] = 4;
);

// 0.6.0 (B4): library and Markov table only once (memory and variables survive the rerun of @init at transport start)
pg_libOk != 1 ? ( pg_libOk = 1; pg_libInit(); pg_mkInit(); );
pg_first ? ( pg_defaults(); pg_first = 0; );

// ---------- Front building blocks (drawing/operating runs in @gfx; data changes only as commands to @block) ----------

// Set slider from the front (with host automation hint)
// P25 (harmonization 4): via tt_slset (theme module, sliders 1..63: threshold 1e-7, slider_automate -> undo point, tt_sldirty).
// PATGEN reads all sliders directly in every @block (pg_readParams / block parameters) - no mirror of its own, tt_sldirty is not
// needed. All front sliders are 1..36; the color slider 64 stays in variable form (end of @gfx).
// Historie: slider(idx) != v ? ( slider(idx) = v; sliderchange(2 ^ (idx - 1)); slider_automate(2 ^ (idx - 1)); );
function pg_set(idx, v) (
  // 0.8.0 (stage 5): sliders 65..68 (SLOT QUANT, NOTE TRIG, TRIG BASE, DENS VAR) in variable form only (masks exist only up to 63)
  idx == 65 ? ( abs(slider65 - v) > 0.0000001 ? ( slider65 = v; slider_automate(slider65); tt_sldirty = 1; ); )
  : idx == 66 ? ( abs(slider66 - v) > 0.0000001 ? ( slider66 = v; slider_automate(slider66); tt_sldirty = 1; ); )
  : idx == 67 ? ( abs(slider67 - v) > 0.0000001 ? ( slider67 = v; slider_automate(slider67); tt_sldirty = 1; ); )
  : idx == 68 ? ( abs(slider68 - v) > 0.0000001 ? ( slider68 = v; slider_automate(slider68); tt_sldirty = 1; ); )
  : tt_slset(idx, v);
);

// Remember hint text when the mouse is in the field (output at frame end)
// P23: since 0.5.3 via the suite standard of the kit (tt_hov reports, tt_tipflush at the end of @gfx draws after 0.35 s
// dwell, not while dragging and not with OPTIONS > TOOLTIPS OFF). Formerly: own buffer #ui_tip + ui_tipOn, immediate
// display, lock via dragId < 0 (the kit now locks via uiLmb: mouse button pressed = no tooltip).
function pg_hint(x, y, w, h, s) (
  tt_hov(x, y, w, h, s);
);

// Historie (P23 -> P25): preset bar and OPTIONS button had their own dwell detection via the raw mouse
// (pg_rhov / pg_rflush / pg_barhints, drawing via tt_tip). pg_barhints had a local `sc` that, because EEL2 is not
// case-sensitive, is the same as the global SC (Review P25 A4): all rectangles were computed with 0.5 instead of SC,
// the tooltips lay above the wordmark instead of above the bar. Removed without replacement, the header now runs via
// tt_modtips() from the kit (one text per element of the bar + OPTIONS) - the ONE way of the suite (P25_FIX point 3).

// Namen (Ergebnis jeweils in #pn)
function pg_noteStr(n) local(pc, l) (
  pc = n - 12 * floor(n / 12);
  l = (pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10) ? 2 : 1;
  strcpy_substr(#pn, "C C#D D#E F F#G G#A A#B ", pc * 2, l);
);
function pg_algoStr(i) (
  i == 0 ? strcpy(#pn, "RANDOM WALK")
  : i == 1 ? strcpy(#pn, "MARKOV")
  : i == 2 ? strcpy(#pn, "EUCLID+WALK")
  : i == 3 ? strcpy(#pn, "MOTIF+VAR")
  : strcpy(#pn, "CLASSIC MUT");
);
function pg_scaleStr(i) (
  i == 0 ? strcpy(#pn, "MINOR PENT")
  : i == 1 ? strcpy(#pn, "NAT MINOR")
  : i == 2 ? strcpy(#pn, "PHRYGIAN")
  : i == 3 ? strcpy(#pn, "HARM MINOR")
  : i == 4 ? strcpy(#pn, "DORIAN")
  : i == 5 ? strcpy(#pn, "CHROMATIC")
  : i == 6 ? strcpy(#pn, "BLUES")
  : i == 7 ? strcpy(#pn, "PHRYG DOM")
  : i == 8 ? strcpy(#pn, "WHOLE TONE")
  : strcpy(#pn, "CUSTOM");
);
function pg_rateStr(i) (
  i == 0 ? strcpy(#pn, "RATE 1/16")
  : i == 1 ? strcpy(#pn, "RATE 1/8")
  : i == 2 ? strcpy(#pn, "RATE 1/16T")
  : strcpy(#pn, "RATE 1/32");
);
// 0.8.0 (Stufe 5): Beschriftung SLOT QUANT / TRIG BASE
function pg_sqStr(i) (
  i == 0 ? strcpy(#pn, "Q: INSTANT")
  : i == 1 ? strcpy(#pn, "Q: 1 BEAT")
  : i == 2 ? strcpy(#pn, "Q: 1 BAR")
  : i == 3 ? strcpy(#pn, "Q: 2 BARS")
  : strcpy(#pn, "Q: 4 BARS");
);
function pg_trigStr(i) (
  i == 0 ? strcpy(#pn, "C0-G0")
  : i == 1 ? strcpy(#pn, "C1-G1")
  : i == 2 ? strcpy(#pn, "C3-G3")
  : strcpy(#pn, "C4-G4");
);
function pg_libStr(i) (
  i < 8 ? sprintf(#pn, "%02d ROLL %d", i + 1, i + 1)
  : i < 16 ? sprintf(#pn, "%02d SPARSE %d", i + 1, i - 7)
  : i < 24 ? sprintf(#pn, "%02d DRIVE %d", i + 1, i - 15)
  : sprintf(#pn, "%02d SQUELCH %d", i + 1, i - 23);
);

// Preset bar: table, bank, factory names (library patterns 1..32; the load logic is that of the former LOAD button: command 20 into the active slot)
pg_pbTable();
tt_pb_init(PG_NFAC, 32, PG_PBB, PG_PBW);
// Historie: tth_test = 1;   // P20: gmem test hook of the theme module (gmem[5190], only with flag set)
// P25 (A10, harmonization 7): line deleted. Theme hook and all writing test commands now run only with the
// enable tt_testok() (gmem[tth_gmb - 1] = gmem[5189] == 20261001, namespace tt303pg). Otherwise only SEQ LINK lies in the namespace
// (gmem[0..138]) - 5189..5214 are free, tth_gmb stays at the default 5190.
// 0.6.1 (Review P-I): the 48 factory names run via #pn, which @gfx overwrites every frame - rebuilt at every transport start
// they could mix with front texts. The name memory of the preset module is kept across @init (tt_pb_init clears only
// on the first run), so only once. Historie: without the pg_namesOk check at every @init.
pg_namesOk != 1 ? (
  pg_ii = 0;
  loop(PG_NLIB, pg_libStr(pg_ii); tt_pb_fname(pg_ii, #pn); pg_ii += 1; );
  pg_ii = 0;
  loop(PG_NSCN, pg_scnStr(pg_ii); tt_pb_fname(PG_NLIB + pg_ii, #pn); pg_ii += 1; );
  pg_namesOk = 1;
);

// Theme tint: transfer greenish-tinted gray (reference scheme ACID) into the color of the active scheme.
// frac = green share relative to the full accent; result = base color + frac * (accent - ACID accent). Exactly unchanged for ACID.
function pg_tn(r, g, b, a) local(f) (
  f = max(0, (g - (r + b) * 0.5) / 0.849);
  gfx_set(min(1, max(0, r + f * (accR - 0.224))), min(1, max(0, g + f * (accG - 1.000))), min(1, max(0, b + f * (accB - 0.078))), a);
);

// Zelle (Step-Raster): st 0 aus, 1 an (Akzent), 2 hell (Accent), 3 gedimmt (Tie), 4 gesperrt
function pg_cell(x, y, w, h, st, hov) (
  st == 0 ? (
    hov ? xgrad(x, y, w, h, 0.150, 0.160, 0.150, 0.085, 0.090, 0.085) : xgrad(x, y, w, h, 0.115, 0.122, 0.115, 0.066, 0.070, 0.066);
    hov ? pg_tn(0.30, 0.46, 0.26, 1) : pg_tn(0.17, 0.22, 0.16, 1);
    xrrect(x, y, w, h, 3, 0);
  ) : st == 1 ? (
    colAcid(0.22); xrrect(x - 1.5, y - 1.5, w + 3, h + 3, 4, 1);
    xgrad(x, y, w, h, accR, accG, accB, accR * 0.62, accG * 0.62, accB * 0.62);
    gfx_set(1, 1, 1, 0.30); xrect(x + 2, y + 1, w - 4, 1);
  ) : st == 2 ? (
    colAcid(0.30); xrrect(x - 1.5, y - 1.5, w + 3, h + 3, 4, 1);
    xgrad(x, y, w, h, 1, 1, 1, 0.55 + accR * 0.4, 0.55 + accG * 0.4, 0.55 + accB * 0.4);
  ) : st == 3 ? (
    xgrad(x, y, w, h, accR * 0.55, accG * 0.55, accB * 0.55, accR * 0.30, accG * 0.30, accB * 0.30);
  ) : (
    pg_tn(0.075, 0.080, 0.075, 1); xrrect(x, y, w, h, 3, 1);
    pg_tn(0.13, 0.15, 0.12, 1); xrrect(x, y, w, h, 3, 0);
  );
);

// P26 (rework "overlaps at large font sizes"): OPTIONS FONT 1/2 lets the kit fonts grow up to level +8
// (x 1.85). Labels in fixed boxes (knob columns 66 wide, value line 10 lower, monitor, labels in front of selection fields,
// help lines, wordmark before the preset bar) then ran into each other (proof without REAPER: another TT plug-in/tt_font_overlap.py,
// level +8: 31 findings). Replacement fonts at the size of level 0 (smaller levels keep working): slot 12 = like slot 5 (mono
// small), 13 = like slot 4 (mono), 14 = like slot 1 (wordmark). pg_fit chooses for a text in a box w x h (design grid)
// the normal font as long as it fits, otherwise the replacement font. At level 0 everything fits (measured) -> image unchanged.
// Slots 12..14 are used by no module (theme 9/10/16, bar 11). Custom text color (CUSTOM COLOR FONT 1/2): tth_txt knows only
// slots 1..5 -> pg_capCol sets it for the replacement font (after the color choice, before drawing).
function pg_capFonts() local(s, m, b) (
  pg_capOn = (tth_f1sz > 0 || tth_f2sz > 0);   // 0.6.0 (P4): at level <= 0 everything fits, pg_fit then does not measure
  s = max(9,  floor(12*SC*1.08^min(0, tth_f2sz)));
  m = max(10, floor(15*SC*1.08^min(0, tth_f2sz)));
  b = max(12, floor(34*SC*1.08^min(0, tth_f1sz)));
  (s != pg_capS || m != pg_capM || b != pg_capB) ? (
    pg_capS = s; pg_capM = m; pg_capB = b;
    monoSel == 0 ? ( gfx_setfont(12, "Consolas", s); gfx_setfont(13, "Consolas", m); )
    : monoSel == 1 ? ( gfx_setfont(12, "DejaVu Sans Mono", s); gfx_setfont(13, "DejaVu Sans Mono", m); )
    : monoSel == 2 ? ( gfx_setfont(12, "Menlo", s); gfx_setfont(13, "Menlo", m); )
    : ( gfx_setfont(12, "Courier New", s); gfx_setfont(13, "Courier New", m); );
    bigSel ? gfx_setfont(14, "Zilap Orion", b, 'b')
    : sansSel == 0 ? gfx_setfont(14, "Segoe UI", b, 'b')
    : sansSel == 1 ? gfx_setfont(14, "Helvetica Neue", b, 'b')
    : sansSel == 2 ? gfx_setfont(14, "DejaVu Sans", b, 'b')
    : sansSel == 3 ? gfx_setfont(14, "Liberation Sans", b, 'b')
    : gfx_setfont(14, "Arial", b, 'b');
    gfx_setfont(5);                          // as after uikit_begin
  );
);
function pg_fit(slot, s, w, h) local(tw, th) (
  gfx_setfont(slot);
  pg_capF = 0;
  pg_capOn ? (
    gfx_measurestr(s, tw, th);
    pg_capF = (tw > w*SC || th > h*SC) ? (slot == 1 ? 1 : 2) : 0;
    pg_capF ? gfx_setfont(slot == 5 ? 12 : (slot == 4 ? 13 : 14));
  );
);
function pg_capCol() (
  (pg_capF == 1 && tth_f1on) ? gfx_set(tth_f1R, tth_f1G, tth_f1B, gfx_a)
  : (pg_capF == 2 && tth_f2on) ? gfx_set(tth_f2R, tth_f2G, tth_f2B, gfx_a);
);
// Text in font slot, fitted into w x h (set color beforehand); pg_ctrF centers in the box w x h, fitted into (w - 2) x (h + 2)
function pg_strF(x, y, slot, s, w, h) ( pg_fit(slot, s, w, h); pg_capCol(); xstr(x, y, s); );
function pg_ctrF(x, y, w, h, slot, s) ( pg_fit(slot, s, w - 2, h + 2); pg_capCol(); xctr(x, y, w, h, s); );

// Rotary knob with label + value; mode 0 integer, 1 one decimal place, 2 signed
// P25 (A8, harmonization 8): st = step size of the slider declaration (1 or 0.1 for HUM TIME) passed through to knob2st: one
// step per wheel notch, dragging snaps. Previously (knob2, 2 % of the range per notch followed by rounding) the wheel had no effect on
// RANGE (5..24) and OCTAVE (-2..2), on SWING (50..75) only upward, at 1..127 it jumped by 3.
// The rounding stays (protection against floating-point residue of vmn + k*st). Tooltip rectangle: exactly the knob column (width 66) and from
// the top edge of the catch circle (cy - r - 7) to the bottom edge of the value line (cy + r + 24) - neighbours no longer overlap
// (OUTPUT: columns 66 apart; GENERATOR: rows 61 apart). Historie: pg_hint(cx - 34, cy - r - 6, 68, 2 * r + 32, tip);
function pg_kn(id, sl, cx, cy, r, vmn, vmx, def, lbl, mode, tip, st) local(v0, nv) (
  v0 = min(vmx, max(vmn, slider(sl)));
  nv = knob2st(id, cx, cy, r, v0, vmn, vmx, def, st);
  nv != v0 ? ( pg_set(sl, mode == 1 ? floor(nv * 10 + 0.5) / 10 : floor(nv + 0.5)); );
  // Historie: gfx_setfont(5); colInk(0.85); xctr(cx - 34, cy + r + 4, 68, 10, lbl); ... colAcid(1); xctr(..., #ui_s);
  // P26: label and value fit into the column (66) and into their 10-high row
  colInk(0.85); pg_ctrF(cx - 34, cy + r + 4, 68, 10, 5, lbl);
  mode == 1 ? sprintf(#ui_s, "%.1f", slider(sl))
  : mode == 2 ? sprintf(#ui_s, "%+d", slider(sl))
  : sprintf(#ui_s, "%d", slider(sl));
  colAcid(1); pg_ctrF(cx - 34, cy + r + 14, 68, 10, 5, #ui_s);
  gfx_setfont(5);
  pg_hint(cx - 33, cy - r - 7, 66, 2 * r + 31, tip);
);

// Combo with text from #pn (set beforehand), returns: new index; writes the slider
// P25 (A5): ofs = smallest slider value. The kit combo works on 0..n-1; MIDI CH (slider 25) is 1..16 and previously ran
// without offset (channel 16 unreachable, 0 possible). All other combos start at 0 (ofs = 0).
function pg_combo(id, sl, x, y, w, h, n, ofs) local(v0, nv) (
  v0 = min(n - 1, max(0, floor(slider(sl)) - ofs));
  strcpy(#cmb_txt, #pn);
  nv = combo(id, x, y, w, h, v0, n);
  nv != v0 ? ( pg_set(sl, nv + ofs); );
  nv;
);

// Small toggle for a 0/1 slider
function pg_tgl(sl, x, y, w, h, s, tip) (
  gfx_setfont(5);
  toggle(x, y, w, h, slider(sl) > 0.5, s) ? ( pg_set(sl, slider(sl) > 0.5 ? 0 : 1); );
  pg_hint(x, y, w, h, tip);
);

// Action button: 1 on click
function pg_act(x, y, w, h, s, tip) local(hit) (
  gfx_setfont(5);
  hit = btn(x, y, w, h, 0, s);
  pg_hint(x, y, w, h, tip);
  hit;
);

// ---------- 0.7.0 (stage 2): helpers of the workbench front (selection, range actions, keyboard) ----------
// All range actions are used by buttons AND keys. Without a selection they act on the whole pattern; where a whole-pattern command exists
// (3..9), it is sent (bit-identical to the previous behavior). Selection, view, deck state and clipboard kind are
// transient front states (not saved in the project).
PG_XK    = 41300;    // Key diagnostics (only with test enable): [0] = counter, [1..16] ring of the last key codes

// nearest scale note if SNAP is on (Alt inverts it for one gesture); always clamped to -12..35
function ui_snapE(e) local(r) (
  r = (ui_snap != ((mouse_cap & 16) ? 1 : 0)) ? pg_snapRaw(e, pg_mask()) : e;
  min(35, max(0 - 12, r));
);

function ui_tri(x1, y1, x2, y2, x3, y3) (
  gfx_triangle(OX + x1 * SC, OY + y1 * SC, OX + x2 * SC, OY + y2 * SC, OX + x3 * SC, OY + y3 * SC);
);

// Thumbnail of a pattern (ln steps from address base) in the box x, y, w, h: one bar per step, height = pitch 0..24, accent white, tie pale
function ui_mini(x, y, w, h, base, ln) local(k, ww, ey, sw) (
  sw = w / max(1, ln);
  k = 0;
  loop(ln,
    ww = base[k];
    w_gate(ww) > 0 ? (
      ey = y + (24 - min(24, max(0, w_e(ww)))) * ((h - 2) / 24);
      w_gate(ww) == 2 ? colAcid(0.45) : (w_acc(ww) ? colWhite(0.95) : colAcid(0.85));
      xrect(x + k * sw, ey, max(1, sw - 1), 2);
    );
    k += 1;
  );
);

// Send a pattern command with undo marker if enough ring places are free (pre-save 38 + command + marker 36); otherwise BUSY
function ui_send(c, a, b, d) (
  pg_ringFree() >= 3 ? ( pg_postU(c, a, b, d); 1; ) : ( ui_busyT = time_precise(); 0; );
);
// 0.8.0 (stage 5): slot choice of the front (buttons, overview, keys 1..8). With SLOT QUANT <> INSTANT, running transport and without SONG
// the request goes to @block as command 76 (change at the next boundary, selecting the running slot again = discard request);
// otherwise immediately via the SLOT slider as before.
function ui_slotSel(j) (
  (slider65 > 0.5 && pg_active && pg_songOn == 0) ? ( pg_post(76, j, 0, 0); ) : ( pg_set(1, j); );
);

// Action button with lock: en = 0 -> dimmed and without effect. Returns 1 on click (only if en)
function ui_op(x, y, w, h, s, tip, en) local(hit) (
  gfx_setfont(5);
  hit = btn(x, y, w, h, 0, s);
  en ? 0 : ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(x, y, w, h); );
  pg_hint(x, y, w, h, tip);
  hit && en;
);

function ui_aCopy() (
  ui_sel0 >= 0 ? ( pg_post(42, ui_sel0, ui_sel1, 0); ui_clipKind = 2; )
               : ( pg_post(8, 0, 0, 0); ui_clipKind = 1; );
);
function ui_aCut() (
  pg_ringFree() >= 4 ? (
    ui_sel0 >= 0 ? ( pg_post(42, ui_sel0, ui_sel1, 0); pg_postU(44, ui_sel0, ui_sel1, 0); ui_clipKind = 2; )
                 : ( pg_post(8, 0, 0, 0); pg_postU(7, 0, 0, 0); ui_clipKind = 1; );
  ) : ( ui_busyT = time_precise(); );
);
function ui_aPaste(at) (
  ui_clipKind == 2 ? ui_send(43, at, 0, 0) : ui_send(9, 0, 0, 0);
);
function ui_aClr() (
  ui_sel0 >= 0 ? ui_send(44, ui_sel0, ui_sel1, 0) : ui_send(7, 0, 0, 0);
);
function ui_aRot(d) (
  ui_sel0 >= 0 ? ui_send(47, ui_sel0, ui_sel1, d) : ui_send(3, d, 0, 0);
);
function ui_aRev() (
  ui_sel0 >= 0 ? ui_send(48, ui_sel0, ui_sel1, 0) : ui_send(4, 0, 0, 0);
);
function ui_aInv() (
  ui_sel0 >= 0 ? ui_send(49, ui_sel0, ui_sel1, 0) : ui_send(5, 0, 0, 0);
);
function ui_aTrans(d) (
  ui_send(45, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, d);
);
function ui_aOct(d) (
  ui_send(46, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, d);
);
function ui_aDup() (
  ui_sel0 >= 0 ? ui_send(50, ui_sel0, ui_sel1, 0);
);
// Step locks (active slot): mode 1 lock, 0 release, 2 toggle, 3 release all. Without a selection it acts on the step under the pointer
// (key) or on the whole pattern (buttons).
function ui_aLock(mode) (
  ui_send(74, ui_sel0 >= 0 ? ui_sel0 : 0, ui_sel0 >= 0 ? ui_sel1 : ui_len - 1, mode);
);
// MUTATE: with selection only within the selection (command arguments replace FROM / TO for this call, the sliders stay untouched)
function ui_aMut() (
  ui_send(2, ui_sel0 >= 0 ? ui_sel0 + 1 : 0, ui_sel0 >= 0 ? ui_sel1 + 1 : 0, 0);
);

// Keyboard: only with pointer over roll / lanes (ui_hov), only without an open overlay; step under the pointer = ui_ps (-1 = none).
// Assigned key codes: gfx_getchar returns ASCII for letters, the REAPER codes for arrows / Del (30064 up, 1685026670 down,
// 1818584692 left, 1919379572 right, 6579564 Del). Whether REAPER lets them through without want_all_kb is shown by the key test (PG_XK).
function ui_key(k) local(s, w, g, hs, v, np, d, n0, n1) (
  s = ui_ps;
  hs = (s >= 0 && s < ui_len) ? 1 : 0;
  w = hs ? M_PAT[ui_slot * 32 + s] : PG_EMPTY;
  g = w_gate(w);
  (k == 97 || k == 65) ? ( (hs && g == 1) ? ui_send(15, s, 1 - w_acc(w), 0); )
  : (k == 115 || k == 83) ? ( hs ? ui_send(16, s, 1 - w_sld(w), 0); )
  : (k == 103 || k == 71) ? ( hs ? ui_send(14, s, g == 0 ? 1 : 0, 0); )
  : (k == 116 || k == 84) ? ( hs ? ui_send(14, s, g == 2 ? 1 : 2, 0); )
  : (k == 111 || k == 79) ? ( hs ? ( v = w_octf(w) - 1; ui_send(17, s, v >= 2 ? 0 - 1 : v + 1, 0); ); )
  : (k == 112 || k == 80) ? ( hs ? ( v = w_prob(w); np = v > 75 ? 75 : (v > 50 ? 50 : (v > 25 ? 25 : 100)); ui_send(18, s, np, 0); ); )
  : (k == 108 || k == 76) ? ( hs ? ui_send(74, s, s, 2); )          // L: toggle the lock of the step under the pointer
  : (k == 99 || k == 67) ? ( ui_aCopy(); )
  : (k == 120 || k == 88) ? ( ui_aCut(); )
  : (k == 118 || k == 86) ? ( ui_aPaste(hs ? s : (ui_sel0 >= 0 ? ui_sel0 : 0)); )
  : (k == 114 || k == 82) ? ( ui_aRev(); )
  : (k == 105 || k == 73) ? ( ui_aInv(); )
  : k == 91 ? ( ui_aRot(0 - 1); )
  : k == 93 ? ( ui_aRot(1); )
  : (k >= 49 && k <= 56) ? ( ui_slotSel(k - 49); )   // 0.8.0 (stage 5): key 1..8 = slot A..H (quantized per SLOT QUANT)
  : k == 122 ? ( PG_UR[0] > 0 ? ui_send(40, 0, 0, 0); )
  : k == 90 ? ( PG_UR[1] > 0 ? ui_send(41, 0, 0, 0); )
  : k == 6579564 ? ( ui_aClr(); )
  : k == 30064 ? ( ui_aTrans(1); )
  : k == 1685026670 ? ( ui_aTrans(0 - 1); )
  : (k == 1818584692 || k == 1919379572) ? (
      ui_sel0 >= 0 ? (
        d = k == 1919379572 ? 1 : 0 - 1;
        n0 = ui_sel0 + d; n1 = ui_sel1 + d;
        (n0 >= 0 && n1 <= ui_len - 1) ? ( ui_sel0 = n0; ui_sel1 = n1; ui_anc = n0; );
      );
    )
  : 0;
);

@slider
// All values are read directly from the sliders (@block); nothing needed here.

@serialize
// Format PG_SER = 1: [ver][256 words][8 lengths][16 chain slots][16 chain repeats] [+ from 0.5.0: preset bank (tt_pb_serialize)]
// P25: REAPER undo plays the state back into the RUNNING instance via this read branch (every Ctrl+Z). Verified: only
// patterns, lengths and chain (+ pg_validate) and the bank are read; note state (pg_snd, M_SN, queue), transport and command ring stay
// untouched -> a sounding note ends regularly (rest/gate end of the new pattern, slide into a rest ends it). Only the SEQ LINK sum is
// derived (pg_linkSum = -1); everything else @block re-reads per step. No factory preset/pg_defaults afterwards. Format unchanged.
pg_serVer = PG_SER;
file_var(0, pg_serVer);
pg_serVer == PG_SER ? (
  // Review 17.10.2026 (B2): check the number of words read; a truncated chunk (fewer than 296 words when reading) -> factory defaults instead of half-old data. Format unchanged.
  pg_rdN = file_mem(0, M_PAT, 256);
  pg_rdN += file_mem(0, M_LEN, 8);
  pg_rdN += file_mem(0, M_CHS, 16);
  pg_rdN += file_mem(0, M_CHR, 16);
  (file_avail(0) >= 0 && pg_rdN < 296) ? pg_defaults();
  pg_validate();
  pg_linkSum = 0 - 1;
  // 0.7.0 (stage 1): clear the undo ring only when READING (REAPER undo, project load); when writing (undo points, saving) it stays
  pg_serRd = file_avail(0) >= 0 ? 1 : 0;
  pg_serRd ? ( pg_urClear(); pg_sqPend = 0; pg_rqSlot = 0; pg_mutCnt = 0; );   // Review 0.9.0 F6: mutation counter as with internal undo (Historie: without pg_mutCnt = 0)   // 0.8.0 (Review S5): a loaded host state discards pending slot changes
  tt_pb_serialize();   // 0.5.0: preset bank behind the old data (old projects end earlier: file_avail = 0 -> bank stays empty)
  // 0.7.0 (stage 3): step locks behind the bank, with version marker. Old projects end earlier (marker stays 0 -> locks unchanged),
  // older plug-in versions never read the appendix. Deviates from the target form "tt_pb_serialize last" (precedent: another TT plug-in LEARN block).
  pg_lkMark = pg_serRd ? 0 : PG_LKMARK;
  file_var(0, pg_lkMark);
  (pg_serRd && pg_lkMark != PG_LKMARK) ? ( memset(PG_LK, 0, 16); );   // Review Codex 0.7.0 (R3): chunk without appendix = no locks
  pg_lkMark == PG_LKMARK ? (
    file_mem(0, PG_LK, 16);
    pg_lkSan = 0;
    loop(16,
      PG_LK[pg_lkSan] = min(65535, max(0, floor(PG_LK[pg_lkSan])));
      pg_lkSan += 1;
    );
  );
);

@block
// 0.6.0 (B3): pg_tb0 now stands behind the line pg_testOk (measured only with test enable)
// ---- Parameter dieses Blocks ----
// 0.6.1 (Review P-F): the output parameters are in pg_params(); they are derived once more AFTER the commands (preset/scene/INIT change the sliders),
// otherwise the load block would have applied old rate/ROOT/GATE/... together with the new patterns.
// Historie: the lines pg_slot = ... pg_humS = ... once stood here before pg_drain().
pg_params();
pg_testOk = tt_testok();             // P25 (A10): Test-Freigabe (gmem[5189] == 20261001) einmal je Block lesen
pg_testOk ? ( pg_tb0 = time_precise(); );
pg_logEn  = pg_testOk ? floor(slider45) : 0;   // P25: diagnostic log only with enable (debug slider with runtime cost)
// Historie: pg_songN was determined here, BEFORE pg_drain() (P25 A9: a chain cell cleared in the same block was then still
// counted). Now behind pg_drain().

// ---- Commands: test hook (CMD slider) and front ----
// P25 (A10): CMD (slider 37) only with test enable. Without enable the command is discarded (slider to 0, no ACK) - so even an
// automation envelope on CMD can no longer trigger anything (before: every pg_exec command in every block, e.g. 7 CLEAR, 31 INIT).
pg_drain();
// 0.6.0 (V7): execute CMD directly (Historie: pg_post from @block made a second writer on pg_cw besides @gfx)
slider37 != 0 ? (
  pg_testOk ? (
    pg_exec(slider37, slider38, slider39, slider40);
    pg_ack += 1;
  );
  slider37 = 0;
);
pg_params();   // 0.6.1 (P-F): derive again after commands/preset load
pg_stRun();
pg_songN  = 0;
while (pg_songN < 16 && M_CHS[pg_songN] >= 0) ( pg_songN += 1; );

// ---- Transport ----
pg_active = ((play_state & 1) && slider30 > 0.5) ? 1 : 0;
pg_bp0 = beat_position;
pg_adv = samplesblock / pg_beatSamp;

// Channel change: end open notes on the old channel
pg_ch != pg_chPrev ? (
  pg_chPrev >= 0 ? ( pg_panic(0); );
  pg_chPrev = pg_ch;
);

// FOLLOW toggled -> re-evaluate transposition (0.6.0, B5: only on change; Historie: in every block)
pg_follow != pg_followP ? ( pg_followP = pg_follow; pg_recalcTrans(); );

// ---- MIDI-Eingang ----
// 0.6.1 (P-C): remember transposition at block start; changes in the MIDI loop get their offset (pg_transAt)
pg_transB = pg_trans; pg_tevN = 0; pg_curOffs = 0;
while (midirecv(pg_offs, pg_m1, pg_m2, pg_m3)) (
  pg_logEv(0, pg_absPos + pg_offs, pg_m1, pg_m2, pg_m3);
  pg_handleMidi(pg_offs, pg_m1, pg_m2, pg_m3);
);

// ---- Start / Stop / Sprung ----
pg_rs = pg_needPanic ? 1 : 0;
pg_needPanic = 0;
(pg_active && !pg_prevActive) ? (
  pg_rs = 1;
  pg_logN = 0;
  pg_logT0 = pg_absPos;
);
(pg_active && pg_prevActive && (abs(pg_bp0 - (pg_prevBp + pg_prevAdv)) > 0.02 || pg_rate != pg_prevRate)) ? (
  pg_rs = 1;
);
(!pg_active && pg_prevActive) ? (
  pg_panic(0);
  pg_curStep = 0 - 1;
  pg_curSlot = 0 - 1;
  pg_curCell = 0 - 1;
);
pg_rs ? (
  pg_panic(0);
  pg_nextN = pg_firstStep(pg_bp0);
  pg_sqPend ? ( pg_sqN = slider65 < 0.5 ? pg_nextN : pg_sqBound(pg_nextN); );   // 0.8.0 (Review S2): start / jump -> boundary from the new position
);
pg_slotProc();   // 0.8.0 (stage 5): slot requests (command 76, NOTE TRIG) after the transport state

// 0.8.0 (stage 5): pending slot change: without transport / with SONG immediately; recompute the boundary if it is further ahead than one unit (jump backwards)
pg_sqPend ? (
  (!pg_active || pg_songOn) ? (
    pg_sqPend = 0;
    pg_pbSetSl(1, pg_sqSlot);
    pg_slot = pg_sqSlot;
  ) : (
    (pg_stepPos(pg_sqN) - pg_stepPos(pg_nextN) > pg_sqUnit() + 0.000001) ? ( pg_sqN = slider65 < 0.5 ? pg_nextN : pg_sqBound(pg_nextN); );
  );
);

// ---- Trigger steps (lead time around the HUMANIZE range, so that pulling forward also works without latency) ----
pg_active ? (
  pg_bp1 = pg_bp0 + pg_adv;
  pg_Jb = pg_humS / pg_beatSamp;
  pg_cnt = 0;
  // Review 0.9.0 F5: with HUM TIME the actual start time counts (pg_tabs including offset), not the nominal position with lead time: a step
  // whose note only falls in the next block is triggered there and sees its input notes (transposition). Unchanged without HUMANIZE.
  // Historie: while (pg_cnt < 64 && pg_stepPos(pg_nextN) - pg_Jb < pg_bp1)
  while (pg_cnt < 64 && (pg_humS > 0 ? pg_tabs(pg_nextN) < pg_absPos + samplesblock : pg_stepPos(pg_nextN) < pg_bp1)) (
    pg_fire(pg_nextN);
    pg_nextN += 1;
    pg_cnt += 1;
  );
);
// 0.8.0 (stage 5): the boundary step has been triggered -> the new slot becomes the active one (SLOT slider); pg_locate already used it
(pg_sqPend && pg_active && pg_nextN > pg_sqN) ? (
  pg_sqPend = 0;
  pg_pbSetSl(1, pg_sqSlot);
  pg_slot = pg_sqSlot;
);

pg_qDrain();

// ---- SEQ LINK ----
slider34 > 0.5 ? ( pg_linkWrite(); );

// ---- Readouts / Abfrage-Bus ----
// 0.6.0 (B3): diagnostic readouts (sliders 41..63) only with test enable; previously every block wrote 23 sliders whose measured values
// ended up in projects and presets. pg_blk keeps counting. Historie: readout block without condition.
pg_blk += 1;
pg_testOk ? (
  slider41 = pg_ack;
  slider54 = pg_sndCnt;
  slider55 = pg_stDone;
  slider56 = srate;
  slider57 = pg_beatSamp;
  pg_qa = floor(slider42);
  slider43 = pg_query(pg_qa);
  slider58 = pg_query(pg_qa + 1);
  slider59 = pg_query(pg_qa + 2);
  slider60 = pg_query(pg_qa + 3);
  slider44 = pg_qa;
  pg_li = max(0, min(LOGCAP - 1, floor(slider46)));
  pg_lp2 = M_LG + pg_li * 5;
  slider47 = pg_li < pg_logN ? pg_lp2[0] : 0 - 1;
  slider48 = pg_li < pg_logN ? pg_lp2[1] : 0;
  slider49 = pg_li < pg_logN ? pg_lp2[2] : 0;
  slider50 = pg_li < pg_logN ? pg_lp2[3] : 0;
  slider51 = pg_li < pg_logN ? pg_lp2[4] : 0;
  slider52 = pg_logN;
  slider53 = pg_li;

  slider61 = pg_blk;
  // Own load of @block in microseconds (moving average over ~200 blocks, maximum with slow decay); @gfx not included
  pg_dtb = (time_precise() - pg_tb0) * 1000000;
  pg_avg = pg_avg * 0.995 + pg_dtb * 0.005;
  pg_bmax = max(pg_dtb, pg_bmax * 0.9995);
  slider62 = pg_avg;
  slider63 = pg_bmax;
);
pg_slotPrev = pg_slot;   // 0.8.0: slot after a possible change in this block (see pg_slotProc)
pg_prevActive = pg_active;
pg_prevBp = pg_bp0;
pg_prevAdv = pg_adv;
pg_prevRate = pg_rate;
pg_absPos += samplesblock;

// ---------- Device front ----------
// Design grid 900x640. The front reads sliders and patterns directly, changes patterns ONLY via pg_post (commands run in @block),
// sliders via pg_set. Drag IDs: 1..9 generator knobs, 10..17 output knobs, 20..30 combos/sliders, 40 roll, 41.. rows.
@gfx 1125 800
tth_pre(); tt_pb_pre(); tth_sync(slider64);   // Preset bar: mask after tth_pre, before uikit_begin
uikit_begin(900, 640);
uikit_ground2();
pg_capFonts();                                // P26: replacement fonts for large FONT levels
(mouse_cap & 3) == 0 ? ( pg_gest = 0; );     // 0.6.1 (P-H): new edit gesture as soon as no mouse button is held
gfx_setfont(5);   // (P23: ui_tipOn = 0 is dropped, tooltips run via tt_hov / tt_tipflush)

ui_slot = min(7, max(0, floor(slider1)));
ui_len = M_LEN[ui_slot];
// 0.7.0 (stage 2): page choice ui_page / ui_pg0 now sits in the tool row (VIEW) and in the roll section
ui_playHere = (pg_curSlot == ui_slot) ? 1 : 0;
// P25 (A6): only reset ui_paint here. ui_drag is reset by the roll branch "release" itself; with ui_drag = 0 at this
// place the branch "click on a note without dragging = remove note" never ran (since 0.3.0, tooltip and manual promise it).
// Historie: !uiLmb ? ( ui_drag = 0; ui_paint = 0; );
!uiLmb ? ( ui_paint = 0; );

// Flashes from the output counter
pg_evCnt != ui_ec ? ( ui_ec = pg_evCnt; ui_fa = pg_lastAcc; ui_fs = pg_lastSld; ui_fn = 1; );
ui_fa *= 0.90; ui_fs *= 0.90; ui_fn *= 0.93;

// ===== Kopfzeile =====
xshadow(12, 8, 876, 40, 6);
pg_tn(0.06, 0.065, 0.06, 1); xrrect(12, 8, 876, 40, 6, 1);
colAcid(0.85); xrrect(12, 8, 876, 40, 6, 0);
// Historie: gfx_setfont(1);   P26: wordmark "TT-303 PATGEN" ends before the preset bar (x 292) and stays in the header row
pg_fit(1, "TT-303 PATGEN", 256, 40);
gfx_measurestr("TT-303", ui_tw, ui_th);
ui_ty = 8 + (40 - ui_th / SC) * 0.5;
colWhite(0.95); pg_capCol(); xstr(30, ui_ty, "TT-303");
colAcid(1); pg_capCol(); xstr(30 + ui_tw / SC + 6, ui_ty, "PATGEN");
// (MIDI monitor has sat in the slot row on the right since 0.5.0, because the preset bar + OPTIONS occupy the middle of the header row;
//  in 0.5.0-0.5.3 the GENERATOR panel lay above it - since 0.5.4 the panel starts at y 84, P25 A3)
pg_tgl(30, 660, 14, 84, 24, slider30 > 0.5 ? "RUN" : "HALT", "RUN: play the pattern with the host transport. HALT stops output and releases held notes");
pg_act(750, 14, 58, 24, "PANIC", "Release all sounding notes immediately (the plug-in also does this on stop, jumps, HALT and channel change)") ? ( pg_post(25, 0, 0, 0); );
gfx_setfont(5); colInk(0.6); xstr(820, 14, #tt_ver);   // P25: #tt_ver from @init (the only version location; position/font as before). P23: stood at v0.5.0
colAcid(0.8); xstr(820, 28, ui_playHere ? "PLAYING" : "");

// ===== Werkzeugzeile (y 54..78) =====
// 0.7.0 (stage 2): layout "workbench". Row: slots A..H | UNDO REDO depth | LEN | VIEW | SNAP | MIDI monitor. COPY / PASTE and all pattern operations
// live in the SELECTION field (bottom left), generator / output / chain in the deck (bottom right, tabs). Historie: COPY 292 / PASTE 340 / UNDO 394 /
// LEN 448..532 / Seitenwahl 558 (0.6.2); 0.7.0: REDO neben UNDO.
ui_ini != 1 ? (
  ui_ini = 1;
  ui_sel0 = 0 - 1; ui_sel1 = 0 - 1; ui_anc = 0; ui_selDrag = 0; ui_lastCT = 0; ui_lastCS = 0 - 1;
  ui_view = 0; ui_snap = 0; ui_deckOpen = 1; ui_tab = 0; ui_r0 = 0;
  ui_clipKind = 0; ui_tgt = 1; ui_busyT = 0;
  ui_cell = 0; ui_gAuto = 1; ui_shi = 0; ui_sigP = 0 - 1; ui_sigPend = 0; ui_sigT = 0;
);
ui_i = 0;
loop(8,
  ui_j = ui_i;
  ui_i += 1;
  ui_bx = 12 + ui_j * 32;
  ui_has = 0;
  ui_k = 0;
  while (ui_k < M_LEN[ui_j]) ( ui_has += (w_gate(M_PAT[ui_j * 32 + ui_k]) > 0 ? 1 : 0); ui_k += 1; );
  gfx_setfont(4);
  btn(ui_bx, 56, 28, 24, ui_j == ui_slot, ui_j == 0 ? "A" : ui_j == 1 ? "B" : ui_j == 2 ? "C" : ui_j == 3 ? "D" : ui_j == 4 ? "E" : ui_j == 5 ? "F" : ui_j == 6 ? "G" : "H") ? ( ui_slotSel(ui_j); );
  ui_has > 0 ? ( colAcid(ui_j == ui_slot ? 0.9 : 0.55); xrect(ui_bx + 8, 76, 12, 2); );
  (pg_curSlot == ui_j && pg_curStep >= 0) ? ( colWhite(0.9); xcirc(ui_bx + 23, 60, 2.2, 1); );
  (pg_sqPend && pg_sqSlot == ui_j) ? ( colWhite(floor(time_precise() * 4) & 1 ? 0.95 : 0.35); xrrect(ui_bx, 56, 28, 24, 3, 0); );   // 0.8.0: change waits for the boundary
  pg_hint(ui_bx, 56, 28, 24, "Pattern slot. Click = edit and play this slot (with SLOT QUANT in OUTPUT the change waits for the beat / bar, a blinking frame marks the waiting slot). A dot marks the slot that is playing, an underline a slot with notes. Keys 1..8 over the roll");
);
ui_un = PG_UR[0]; ui_rn = PG_UR[1];
ui_un > 0 ? sprintf(#ui_tipU, "Undo the last pattern edit (16 steps deep, across slots). %d step(s) left, the next one changes slot %c", ui_un, 65 + (PG_UR + 8 + (ui_un - 1) * PG_UW)[0])
          : strcpy(#ui_tipU, "Undo the last pattern edit (16 steps deep, across slots). Nothing to undo");
ui_rn > 0 ? sprintf(#ui_tipR, "Redo the last undone edit (%d step(s) available, the next one changes slot %c)", ui_rn, 65 + (PG_UR + 8 + PG_UN * PG_UW + (ui_rn - 1) * PG_UW)[0])
          : strcpy(#ui_tipR, "Redo the last undone edit. Nothing to redo (a new edit discards the redo steps)");
pg_act(272, 56, 40, 24, "UNDO", #ui_tipU) ? ( ui_un > 0 ? ui_send(40, 0, 0, 0); );
ui_un == 0 ? ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(272, 56, 40, 24); );
pg_act(316, 56, 40, 24, "REDO", #ui_tipR) ? ( ui_rn > 0 ? ui_send(41, 0, 0, 0); );
ui_rn == 0 ? ( gfx_set(0.02, 0.03, 0.02, 0.55); xrect(316, 56, 40, 24); );
gfx_setfont(5); colInk(0.7);
sprintf(#ui_s, "%d/%d", ui_un, PG_UN); xstr(360, 62, #ui_s);
pg_hint(358, 56, 34, 24, "Undo depth: steps that can be undone / ring size. Hover UNDO to see which slot the next step changes");
gfx_setfont(5); colInk(0.85); xstr(398, 62, "LEN");
pg_act(420, 56, 18, 24, "-", "Pattern length -1 (1..32)") ? ( pg_postU(19, ui_len - 1, 0, 0); );
panelBox(440, 56, 28, 24);
sprintf(#ui_s, "%d", ui_len); gfx_setfont(4); colAcid(1); xctr(440, 56, 28, 24, #ui_s);
(inBox(440, 56, 28, 24) && mouse_wheel != 0) ? ( pg_postU(19, ui_len + (mouse_wheel > 0 ? 1 : 0 - 1), 0, 0); );
pg_hint(440, 56, 28, 24, "Pattern length of the active slot in steps (1..32). Mouse wheel = +-1, or use the - and + buttons");
pg_act(470, 56, 18, 24, "+", "Pattern length +1 (1..32)") ? ( pg_postU(19, ui_len + 1, 0, 0); );
// VIEW: FIT shows all steps of the pattern at once; 1-16 / 17-32 show one page with wider columns
ui_view = min(ui_view, ui_len > 16 ? 2 : 1);
strcpy(#cmb_txt, ui_view == 0 ? "VIEW FIT" : ui_view == 1 ? "VIEW 1-16" : "VIEW 17-32");
ui_view = combo(35, 494, 56, 84, 24, ui_view, ui_len > 16 ? 3 : 2);
pg_hint(494, 56, 84, 24, "Roll view: FIT shows all steps of the pattern at once, 1-16 / 17-32 shows one page with wider columns");
gfx_setfont(5);
toggle(582, 56, 46, 24, ui_snap, "SNAP") ? ( ui_snap = 1 - ui_snap; );
pg_hint(582, 56, 46, 24, "SNAP: notes you set or drag land on the scale (ROOT + SCALE). Hold Alt to invert for one edit");

// ===== MIDI monitor (slot row right, x 632..888, y 56..80; free since P25: GENERATOR panel from y 84) =====
// Historie: gfx_setfont(5)/(4) + xstr without space check; P26: monitor texts fitted into their fields (row y 56..80)
colInk(0.70); pg_strF(640, 62, 5, "LAST NOTE", 62, 14);
pg_lastNote >= 0 ? ( pg_noteStr(pg_lastNote); sprintf(#ui_s, "%s%d", #pn, floor(pg_lastNote / 12) - 1); ) : ( strcpy(#ui_s, "--"); );
colAcid(0.55 + 0.45 * ui_fn); pg_strF(704, 61, 4, #ui_s, 42, 18);
colInk(0.70); pg_strF(748, 62, 5, "STEP", 32, 14);
pg_curStep >= 0 ? sprintf(#ui_s, "%02d/%02d", pg_curStep + 1, M_LEN[max(0, pg_curSlot)]) : strcpy(#ui_s, "--/--");
colAcid(1); pg_strF(782, 61, 4, #ui_s, 54, 18);
pg_tn(0.16, 0.18, 0.15, 1); xcirc(842, 63, 4, 1);
colWhite(ui_fa); xcirc(842, 63, 4, 1); colBorder(); xcirc(842, 63, 4, 0);
colInk(0.75); pg_strF(851, 58, 5, "ACC", 36, 12);
pg_tn(0.16, 0.18, 0.15, 1); xcirc(842, 74, 4, 1);
colAcid(ui_fs); xcirc(842, 74, 4, 1); colBorder(); xcirc(842, 74, 4, 0);
colInk(0.75); pg_strF(851, 69, 5, "SLIDE", 36, 12);
// 0.7.0 (stage 1): "WAITING FOR AUDIO" - commands of the front are executed in the audio thread; if the counter hangs > 0.5 s behind the
// write counter (FX bypassed / offline / audio stopped), this appears here instead of the monitor (manual: Edits need running audio).
(pg_cmdW != pg_cmdA) ? ( ui_waitT == 0 ? ( ui_waitT = time_precise(); ); ) : ( ui_waitT = 0; );
ui_waiting = (ui_waitT > 0 && time_precise() - ui_waitT > 0.5) ? 1 : 0;
ui_busy = (time_precise() - ui_busyT < 1.0) ? 1 : 0;   // 0.7.0: Kommando-Ring voll, Aktion verworfen
(ui_waiting || ui_busy) ? (
  pg_tn(0.10, 0.07, 0.03, 1); xrrect(634, 57, 252, 22, 3, 1);
  gfx_set(1, 0.55, 0, 1); pg_strF(644, 62, 4, ui_waiting ? "WAITING FOR AUDIO" : "BUSY - TRY AGAIN", 232, 14);
);
pg_hint(632, 56, 256, 24, ui_waiting ? "Edits are applied in the audio thread. The plug-in must be active (not bypassed or offline) and the audio engine must run" : "MIDI monitor: last note sent, current step, accent / slide LEDs");

// ===== Roll + Step-Spuren (ganze Breite) =====
// 0.7.0 (stage 2): grid x 52..880 (828 wide). FIT: column count = length (up to 32 steps at once), otherwise 16 columns per page. Row window:
// deck open 25 rows (semitone window ui_r0 .. ui_r0 + 24, wheel on the keyboard shifts it), deck closed (FOCUS) all 48 rows (-12..+35).
// Notes outside the window appear as an arrow marker at the edge (previously drawn clamped to row 0 / 24).
// Historie: roll x 48 / 16 columns of 34.5 / 25 rows fixed, lanes 22 high each at y 330 + 26 * row.
ui_dk = ui_deckOpen;
ui_rows = ui_dk ? 25 : 48;
ui_r0v = ui_dk ? ui_r0 : (0 - 12);
ui_gx = 52; ui_gy = 102; ui_rh = 8; ui_gw = 828;
ui_fit = ui_view == 0 ? 1 : 0;
ui_cols = ui_fit ? ui_len : 16;
ui_cw = ui_gw / ui_cols;
ui_pg0 = ui_view == 2 ? 16 : 0;
ui_ly = ui_dk ? 326 : 494;                       // upper edge of the step lanes
ui_rbot = ui_gy + ui_rows * ui_rh;
ui_sel0 >= 0 ? (
  ui_sel0 = min(ui_sel0, ui_len - 1);
  ui_sel1 = min(ui_sel1, ui_len - 1);
  ui_sel1 < ui_sel0 ? ( ui_sel1 = ui_sel0; );
);
xshadow(12, 84, 876, ui_ly + 94 - 84, 6);
panelBox(12, 84, 876, ui_ly + 94 - 84);
// Nummern-/Auswahlzeile
gfx_setfont(5); colInk(0.7);
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_s = ui_pg0 + ui_cc;
  sprintf(#ui_t, "%d", ui_s + 1);
  ui_s >= ui_len ? gfx_set(0.3, 0.3, 0.3, 0.5) : ((ui_s & 3) == 0 ? colAcid(0.9) : colInk(0.55));
  xctr(ui_gx + ui_cc * ui_cw, 90, ui_cw, 12, #ui_t);
);
// Step locks: orange marker above the number row and a light veil on the column (only for steps < length)
ui_lkOn = pg_lkAny(ui_slot);
ui_lkOn ? (
  ui_c = 0;
  loop(ui_cols,
    ui_cc = ui_c;
    ui_c += 1;
    ui_s = ui_pg0 + ui_cc;
    (ui_s < ui_len && pg_lkGet(ui_slot, ui_s)) ? ( gfx_set(1, 0.55, 0, 0.95); xrect(ui_gx + ui_cc * ui_cw + 1, 85, ui_cw - 2, 3); );
  );
);
// Zeilen + Klaviatur
ui_e = 0;
while (ui_e < ui_rows) (
  ui_ee = ui_e;
  ui_e += 1;
  ui_ry = ui_gy + (ui_rows - 1 - ui_ee) * ui_rh;
  ui_ea = ui_r0v + ui_ee;                       // Pitch of this row (semitones above ROOT)
  ui_pc = ui_ea - 12 * floor(ui_ea / 12);
  ui_blk = (ui_pc == 1 || ui_pc == 3 || ui_pc == 6 || ui_pc == 8 || ui_pc == 10) ? 1 : 0;
  ui_blk ? pg_tn(0.030, 0.038, 0.030, 1) : pg_tn(0.058, 0.070, 0.056, 1);
  xrect(ui_gx, ui_ry, ui_gw, ui_rh);
  ui_pc == 0 ? ( colAcid(0.13); xrect(ui_gx, ui_ry + ui_rh - 1, ui_gw, 1); );
  ui_blk ? ( pg_tn(0.10, 0.11, 0.10, 1); xrect(20, ui_ry, 16, ui_rh); )
         : ( gfx_set(0.70, 0.74, 0.70, 1); xrect(20, ui_ry, 26, ui_rh - 1); );
  ui_pc == 0 ? (
    gfx_setfont(5); pg_tn(0.20, 0.26, 0.20, 1); pg_noteStr(36 + floor(slider6) + ui_ea);
    sprintf(#ui_t, "%s%d", #pn, floor((36 + floor(slider6) + ui_ea) / 12) - 1); xstr(22, ui_ry - 1, #ui_t);
  );
);
// Spalten
ui_c = 0;
loop(ui_cols + 1,
  ui_cc = ui_c;
  ui_c += 1;
  ((ui_pg0 + ui_cc) & 3) == 0 ? pg_tn(0.20, 0.30, 0.18, 0.9) : pg_tn(0.10, 0.14, 0.10, 0.8);
  xrect(ui_gx + ui_cc * ui_cw, ui_gy, 1, ui_rows * ui_rh);
);
// Columns behind the length
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_pg0 + ui_cc >= ui_len ? ( gfx_set(0, 0, 0, 0.55); xrect(ui_gx + ui_cc * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh); );
);
// Laufbalken
(ui_playHere && pg_curStep >= ui_pg0 && pg_curStep < ui_pg0 + ui_cols) ? (
  colAcid(0.16); xrect(ui_gx + (pg_curStep - ui_pg0) * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh);
);
// gesperrte Spalten leicht orange
ui_lkOn ? (
  ui_c = 0;
  loop(ui_cols,
    ui_cc = ui_c;
    ui_c += 1;
    ui_s = ui_pg0 + ui_cc;
    (ui_s < ui_len && pg_lkGet(ui_slot, ui_s)) ? ( gfx_set(1, 0.55, 0, 0.10); xrect(ui_gx + ui_cc * ui_cw + 1, ui_gy, ui_cw - 1, ui_rows * ui_rh); );
  );
);
// Noten
ui_c = 0;
loop(ui_cols,
  ui_cc = ui_c;
  ui_c += 1;
  ui_s = ui_pg0 + ui_cc;
  ui_s < ui_len ? (
    ui_w = M_PAT[ui_slot * 32 + ui_s];
    ui_g = w_gate(ui_w);
    ui_ri = w_e(ui_w) - ui_r0v;
    ui_out = ui_ri < 0 ? 0 - 1 : (ui_ri >= ui_rows ? 1 : 0);
    ui_ri = min(ui_rows - 1, max(0, ui_ri));
    ui_ny = ui_gy + (ui_rows - 1 - ui_ri) * ui_rh;
    ui_nx = ui_gx + ui_cc * ui_cw;
    ui_g == 0 ? (
      colDim(0.55); xrrect(ui_nx + 3, ui_ny + 1, ui_cw - 6, ui_rh - 2, 2, 0);   // Geisternote
    ) : (
      ui_g == 2 ? (
        colAcid(0.50); xrect(ui_nx, ui_ny + 1, ui_cw, ui_rh - 2);                  // Tie: reaches up to the next step
        gfx_set(0, 0, 0, 0.35); xrect(ui_nx, ui_ny + 3, ui_cw, 2);
      ) : (
        w_acc(ui_w) ? ( colWhite(0.96); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 1); colAcid(1); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 0); )
                    : ( colAcid(1); xrrect(ui_nx + 2, ui_ny, ui_cw - 4, ui_rh, 2, 1); );
      );
      // Slide: connection to the note of the next step
      w_sld(ui_w) ? (
        ui_w2 = M_PAT[ui_slot * 32 + ((ui_s + 1) % ui_len)];
        ui_ri2 = min(ui_rows - 1, max(0, w_e(ui_w2) - ui_r0v));
        colWhite(0.85);
        xline(ui_nx + ui_cw - 2, ui_ny + ui_rh * 0.5, ui_nx + ui_cw + 2, ui_gy + (ui_rows - 1 - ui_ri2) * ui_rh + ui_rh * 0.5);
        xline(ui_nx + ui_cw - 2, ui_ny + ui_rh * 0.5 + 1, ui_nx + ui_cw + 2, ui_gy + (ui_rows - 1 - ui_ri2) * ui_rh + ui_rh * 0.5 + 1);
      );
      // Wahrscheinlichkeit < 100: kleiner Punkt
      w_prob(ui_w) < 100 ? ( gfx_set(1, 0.55, 0, 1); xcirc(ui_nx + 6, ui_ny + ui_rh * 0.5, 1.8, 1); );
    );
    // outside the window: arrow marker at the edge of the column
    ui_out != 0 ? (
      colWhite(0.9);
      ui_out > 0 ? ui_tri(ui_nx + ui_cw * 0.5 - 3, ui_gy + 6, ui_nx + ui_cw * 0.5 + 3, ui_gy + 6, ui_nx + ui_cw * 0.5, ui_gy + 1)
                 : ui_tri(ui_nx + ui_cw * 0.5 - 3, ui_rbot - 6, ui_nx + ui_cw * 0.5 + 3, ui_rbot - 6, ui_nx + ui_cw * 0.5, ui_rbot - 1);
    );
  );
);
colBorder(); xrrect(ui_gx, ui_gy, ui_gw, ui_rows * ui_rh, 2, 0);

// Mouse in the roll: set / drag / delete note; Ctrl + drag selects steps (frame), clicking in the number row selects as well
ui_inroll = inBox(ui_gx, ui_gy, ui_gw, ui_rows * ui_rh) ? 1 : 0;
ui_mc = floor((mX - ui_gx) / ui_cw);
ui_ms = ui_pg0 + ui_mc;
ui_mr = min(ui_rows - 1, max(0, ui_rows - 1 - floor((mY - ui_gy) / ui_rh)));
ui_me = ui_snapE(ui_r0v + ui_mr);
(uiClick && ui_inroll && ui_ms < ui_len && ui_drag == 0 && (mouse_cap & 4)) ? (
  ui_selDrag = 1; ui_anc = ui_ms; ui_sel0 = ui_ms; ui_sel1 = ui_ms;
) : (uiClick && ui_inroll && ui_ms < ui_len && ui_drag == 0) ? (
  ui_w = M_PAT[ui_slot * 32 + ui_ms];
  (w_gate(ui_w) > 0 && w_e(ui_w) == ui_me) ? (
    ui_drag = 1; ui_dS = ui_ms; ui_dE = ui_me; ui_moved = 0;
  ) : (
    pg_postU(12, ui_ms, ui_me, 0);
    ui_drag = 1; ui_dS = ui_ms; ui_dE = ui_me; ui_moved = 1;
  );
);
(ui_drag == 1 && uiLmb) ? (
  ui_me != ui_dE ? ( pg_postU(13, ui_dS, ui_me - ui_dE, 0); ui_dE = ui_me; ui_moved = 1; );
);
(ui_drag == 1 && !uiLmb) ? (
  !ui_moved ? ( pg_postU(14, ui_dS, 0, 0); );
  ui_drag = 0;
);
(uiRClk && ui_inroll && ui_ms < ui_len) ? ( pg_postU(14, ui_ms, 0, 0); );
pg_hint(ui_gx, ui_gy, ui_gw, ui_rows * ui_rh, "Piano roll: click = set note, drag = move pitch, click a note or right-click = remove, Ctrl + drag = select steps. Rows are semitones above ROOT (SNAP puts notes on the scale)");

// Number row: click = one step, drag = range, Shift + click = extend, double-click = all, right-click = clear selection
ui_inNum = inBox(ui_gx, 88, ui_gw, 14) ? 1 : 0;
ui_ns = min(ui_len - 1, max(0, ui_pg0 + floor((mX - ui_gx) / ui_cw)));
(uiClick && ui_inNum) ? (
  ((mouse_cap & 8) && ui_sel0 >= 0) ? (
    ui_sel0 = min(ui_anc, ui_ns); ui_sel1 = max(ui_anc, ui_ns); ui_selDrag = 1;
  ) : ((time_precise() - ui_lastCT < 0.35 && ui_lastCS == ui_ns) ? (
    ui_sel0 = 0; ui_sel1 = ui_len - 1; ui_anc = 0; ui_selDrag = 0;
  ) : (
    ui_anc = ui_ns; ui_sel0 = ui_ns; ui_sel1 = ui_ns; ui_selDrag = 1;
  ));
  ui_lastCT = time_precise(); ui_lastCS = ui_ns;
);
(uiRClk && ui_inNum) ? ( ui_sel0 = 0 - 1; ui_sel1 = 0 - 1; ui_selDrag = 0; );
(ui_selDrag && uiLmb) ? (
  ui_cur = min(ui_len - 1, max(0, ui_pg0 + floor((mX - ui_gx) / ui_cw)));
  ui_sel0 = min(ui_anc, ui_cur); ui_sel1 = max(ui_anc, ui_cur);
);
!uiLmb ? ( ui_selDrag = 0; );
pg_hint(ui_gx, 88, ui_gw, 14, "Step numbers. Click / drag = select steps, Shift + click = extend, double-click = all, right-click = clear the selection. The edit buttons act on the selection");

// Keyboard: wheel = window +-1 semitone (Shift = octave), right-click = back, arrows = octave (only with deck; otherwise everything is already in view)
ui_kbh = inBox(12, ui_gy, 40, ui_rows * ui_rh) ? 1 : 0;
(ui_dk && ui_kbh && mouse_wheel != 0) ? ( ui_r0 = min(11, max(0 - 12, ui_r0 + (mouse_wheel > 0 ? 1 : 0 - 1) * ((mouse_cap & 8) ? 12 : 1))); );
(ui_dk && ui_kbh && uiRClk) ? ( ui_r0 = 0; );
pg_hint(12, ui_gy, 40, ui_rows * ui_rh, ui_dk ? "Keyboard: wheel scrolls the visible pitch range (Shift = octave), right-click = back to ROOT..ROOT+24" : "Keyboard: the whole range -12..+35 is visible (deck closed)");
ui_dk ? (
  gfx_setfont(5);
  btn(14, 304, 18, 14, 0, "^") ? ( ui_r0 = min(11, ui_r0 + 12); );
  pg_hint(14, 304, 18, 14, "Scroll the visible pitch range up by an octave");
  btn(34, 304, 18, 14, 0, "v") ? ( ui_r0 = max(0 - 12, ui_r0 - 12); );
  pg_hint(34, 304, 18, 14, "Scroll the visible pitch range down by an octave");
);

// ===== Spuren: ACCENT / SLIDE / GATE / OCT / PROB (16 Einheiten hoch) =====
gfx_setfont(5);
ui_r = 0;
loop(5,
  ui_rr = ui_r;
  ui_r += 1;
  ui_ry = ui_ly + ui_rr * 18;
  colInk(0.85);
  xstr(14, ui_ry + 3, ui_rr == 0 ? "ACCENT" : ui_rr == 1 ? "SLIDE" : ui_rr == 2 ? "GATE" : ui_rr == 3 ? "OCT" : "PROB");
  ui_c = 0;
  loop(ui_cols,
    ui_cc = ui_c;
    ui_c += 1;
    ui_s = ui_pg0 + ui_cc;
    ui_cx = ui_gx + ui_cc * ui_cw + 1;
    ui_cwid = ui_cw - 2;
    ui_act = ui_s < ui_len ? 1 : 0;
    ui_w = ui_act ? M_PAT[ui_slot * 32 + ui_s] : PG_EMPTY;
    ui_g = w_gate(ui_w);
    ui_hov = (ui_act && inBox(ui_cx, ui_ry, ui_cwid, 16)) ? 1 : 0;
    ui_rr == 0 ? (
      ui_v = w_acc(ui_w);
      pg_cell(ui_cx, ui_ry, ui_cwid, 16, !ui_act ? 4 : ui_g == 0 ? 4 : ui_g == 1 && ui_v ? 2 : 0, ui_hov);
      (ui_hov && uiClick && ui_g == 1) ? ( ui_paint = 1; ui_pv = 1 - ui_v; pg_postU(15, ui_s, ui_pv, 0); );
      (ui_hov && uiLmb && !uiClick && ui_paint == 1 && ui_g == 1 && ui_v != ui_pv) ? ( pg_postU(15, ui_s, ui_pv, 0); );
      (ui_hov && uiRClk && ui_g == 1) ? ( pg_postU(15, ui_s, 0, 0); );
    ) : ui_rr == 1 ? (
      ui_v = w_sld(ui_w);
      pg_cell(ui_cx, ui_ry, ui_cwid, 16, !ui_act ? 4 : ui_g == 0 ? (ui_v ? 3 : 4) : ui_v ? 1 : 0, ui_hov);
      (ui_hov && uiClick) ? ( ui_paint = 2; ui_pv = 1 - ui_v; pg_postU(16, ui_s, ui_pv, 0); );
      (ui_hov && uiLmb && !uiClick && ui_paint == 2 && ui_v != ui_pv) ? ( pg_postU(16, ui_s, ui_pv, 0); );
      (ui_hov && uiRClk) ? ( pg_postU(16, ui_s, 0, 0); );
    ) : ui_rr == 2 ? (
      pg_cell(ui_cx, ui_ry, ui_cwid, 16, !ui_act ? 4 : ui_g == 1 ? 1 : ui_g == 2 ? 3 : 0, ui_hov);
      ui_g == 2 ? ( gfx_set(0, 0, 0, 0.8); xctr(ui_cx, ui_ry, ui_cwid, 16, "TIE"); );
      (ui_hov && uiClick) ? ( ui_paint = 3; ui_pv = (ui_g + 1) % 3; pg_postU(14, ui_s, ui_pv, 0); );
      (ui_hov && uiLmb && !uiClick && ui_paint == 3 && ui_g != ui_pv) ? ( pg_postU(14, ui_s, ui_pv, 0); );
      (ui_hov && uiRClk) ? ( pg_postU(14, ui_s, 0, 0); );
    ) : ui_rr == 3 ? (
      ui_v = w_octf(ui_w) - 1;
      pg_cell(ui_cx, ui_ry, ui_cwid, 16, !ui_act ? 4 : ui_v != 0 ? 1 : 0, ui_hov);
      ui_v != 0 ? ( gfx_set(0, 0, 0, 0.85); sprintf(#ui_t, "%+d", ui_v); xctr(ui_cx, ui_ry, ui_cwid, 16, #ui_t); );
      (ui_hov && uiClick) ? ( ui_paint = 4; ui_pv = ui_v >= 2 ? 0 - 1 : ui_v + 1; pg_postU(17, ui_s, ui_pv, 0); );
      (ui_hov && uiLmb && !uiClick && ui_paint == 4 && ui_v != ui_pv) ? ( pg_postU(17, ui_s, ui_pv, 0); );
      (ui_hov && uiRClk) ? ( pg_postU(17, ui_s, 0, 0); );
    ) : (
      ui_v = w_prob(ui_w);
      pg_cell(ui_cx, ui_ry, ui_cwid, 16, 4, ui_hov);
      ui_act ? (
        ui_v < 100 ? gfx_set(1, 0.55, 0, 0.9) : colDim(0.9);
        xrect(ui_cx + 1, ui_ry + 15 - ui_v * 0.14, ui_cwid - 2, max(1, ui_v * 0.14));
        ui_v < 100 ? ( gfx_set(1, 1, 1, 0.9); gfx_setfont(5); sprintf(#ui_t, "%d", ui_v); xctr(ui_cx, ui_ry, ui_cwid, 16, #ui_t); );
      );
      (ui_hov && uiClick) ? ( ui_paint = 5; );
      (ui_paint == 5 && uiLmb && ui_act && mX >= ui_cx && mX < ui_cx + ui_cwid) ? (
        ui_pv = min(100, max(0, floor((ui_ry + 16 - mY) / 16 * 100 + 0.5)));
        ui_pv != ui_v ? ( pg_postU(18, ui_s, ui_pv, 0); );
      );
      (ui_hov && uiRClk) ? ( pg_postU(18, ui_s, 100, 0); );
    );
  );
  pg_hint(ui_gx, ui_ry, ui_gw, 16,
    ui_rr == 0 ? "ACCENT: step is played with ACC VEL (click / drag to paint, right-click clears). Only on normal gate steps. Key A over a step"
    : ui_rr == 1 ? "SLIDE: legato into the next step (overlapping notes). Only sounds if the next step is a normal gate step. Key S over a step"
    : ui_rr == 2 ? "GATE: click cycles OFF, ON, TIE (tie = note holds into this step, no new note). Keys G (on/off) and T (tie) over a step"
    : ui_rr == 3 ? "OCT: octave shift -1 / 0 / +1 / +2 for this step (click cycles, right-click = 0). Key O over a step"
    : "PROB: chance that the step plays, 0..100 % (drag in the column, right-click = 100). Deterministic per seed. Key P cycles 100 / 75 / 50 / 25");
);

// Selection band over roll and lanes
ui_sel0 >= 0 ? (
  ui_ba = max(ui_sel0, ui_pg0);
  ui_bb = min(ui_sel1, ui_pg0 + ui_cols - 1);
  ui_bb >= ui_ba ? (
    colAcid(0.11); xrect(ui_gx + (ui_ba - ui_pg0) * ui_cw, ui_gy, (ui_bb - ui_ba + 1) * ui_cw, ui_ly + 94 - ui_gy);
    colAcid(0.9);
    xrect(ui_gx + (ui_ba - ui_pg0) * ui_cw, 100, (ui_bb - ui_ba + 1) * ui_cw, 2);
    xrect(ui_gx + (ui_ba - ui_pg0) * ui_cw, ui_ly + 93, (ui_bb - ui_ba + 1) * ui_cw, 1);
  );
);

// Keyboard (hover focus): only without an open module overlay (the modules read gfx_getchar themselves) and only over roll / lanes
ui_hov = (inBox(ui_gx, ui_gy, ui_gw, ui_rbot - ui_gy) || inBox(ui_gx, ui_ly, ui_gw, 94)) ? 1 : 0;
ui_ps = ui_hov ? (ui_pg0 + floor((mX - ui_gx) / ui_cw)) : 0 - 1;
ui_kbOk = (tt_pb_open == 0 && tth_open == 0 && tth_edit == 0) ? 1 : 0;
ui_kbOk ? (
  loop(8,   // Review Codex 0.7.0 (R6): every code is read immediately before processing (the ninth was otherwise lost)
    ui_kc = gfx_getchar();
    ui_kc > 0 ? (
      tt_testok() ? ( PG_XK[0] += 1; PG_XK[1 + (PG_XK[0] - 1) % 16] = ui_kc; );
      ui_hov ? ui_key(ui_kc);
    );
  );
);

// ===== SELECTION (links unten) =====
ui_dk ? (
  panel2(12, 422, 228, 210, "SELECTION");
  ui_hs = ui_sel0 >= 0 ? 1 : 0;
  ui_ckOk = ((ui_clipKind == 2 && PG_RCL[0] > 0) || (ui_clipKind == 1 && M_CLP[0] > 0)) ? 1 : 0;
  ui_hs ? sprintf(#ui_s, "SEL %d-%d  =  %d STEPS", ui_sel0 + 1, ui_sel1 + 1, ui_sel1 - ui_sel0 + 1) : strcpy(#ui_s, "NO SELECTION = WHOLE PATTERN");
  gfx_setfont(5); ui_hs ? colAcid(1) : colInk(0.7);
  pg_strF(22, 453, 5, #ui_s, 208, 14);
  pg_hint(18, 450, 216, 20, "Current step selection. The edit buttons act on it; without a selection they act on the whole pattern");
  ui_op(22, 474, 48, 22, "COPY", "Copy the selected steps (the whole slot without a selection)", 1) ? ( ui_aCopy(); );
  ui_op(74, 474, 48, 22, "CUT", "Cut: copy, then clear the selected steps (the whole slot without a selection)", 1) ? ( ui_aCut(); );
  ui_op(126, 474, 48, 22, "PASTE", "Paste at the start of the selection (step 1 without a selection); clipped at the pattern end. After a whole-slot COPY: replaces the slot", ui_ckOk) ? ( ui_aPaste(ui_hs ? ui_sel0 : 0); );
  ui_op(178, 474, 48, 22, "CLR", "Clear the selected steps (gate off, pitches stay as ghost notes). Without a selection: clear the whole slot", 1) ? ( ui_aClr(); );
  ui_op(22, 500, 48, 22, "<ROT", "Rotate the selection one step earlier (wraps inside the selection; the whole pattern without a selection)", 1) ? ( ui_aRot(0 - 1); );
  ui_op(74, 500, 48, 22, "ROT>", "Rotate the selection one step later (wraps inside the selection)", 1) ? ( ui_aRot(1); );
  ui_op(126, 500, 48, 22, "REV", "Reverse the selection (slides follow their link, ties stay attached to their note)", 1) ? ( ui_aRev(); );
  ui_op(178, 500, 48, 22, "INV", "Invert the pitches of the selection around ROOT, snapped to the scale", 1) ? ( ui_aInv(); );
  ui_op(22, 526, 48, 22, "ST-", "Transpose the selection one scale degree down (the whole pattern without a selection)", 1) ? ( ui_aTrans(0 - 1); );
  ui_op(74, 526, 48, 22, "ST+", "Transpose the selection one scale degree up", 1) ? ( ui_aTrans(1); );
  ui_op(126, 526, 48, 22, "OCT-", "Selection one octave down (limit -1)", 1) ? ( ui_aOct(0 - 1); );
  ui_op(178, 526, 48, 22, "OCT+", "Selection one octave up (limit +2)", 1) ? ( ui_aOct(1); );
  ui_op(22, 552, 48, 22, "DUP", "Duplicate the selection right after itself (clipped at the pattern end)", ui_hs) ? ( ui_aDup(); );
  ui_op(74, 552, 48, 22, "DBL", "Double: 16 steps become 32 (second half = copy). Only for length <= 16", ui_len <= 16) ? ( ui_send(6, 0, 0, 0); );
  ui_op(126, 552, 48, 22, "ALL", "Select all steps", 1) ? ( ui_sel0 = 0; ui_sel1 = ui_len - 1; ui_anc = 0; );
  ui_op(178, 552, 48, 22, "NONE", "Clear the selection", ui_hs) ? ( ui_sel0 = 0 - 1; ui_sel1 = 0 - 1; );
  ui_tgt == ui_slot ? ( ui_tgt = (ui_slot + 1) % 8; );
  sprintf(#cmb_txt, "TO SLOT %c", 65 + ui_tgt);
