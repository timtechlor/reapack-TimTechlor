  pg_combo(22, 4, 256, 520, 148, 22, 5, 0);
  pg_hint(256, 520, 148, 22, "Algorithm: random walk, Markov chain, Euclid rhythm + walk, motif with variation, classic mutation of the library");
  pg_noteStr(floor(slider6));
  pg_combo(23, 6, 410, 520, 52, 22, 12, 0);
  pg_hint(410, 520, 52, 22, "Root note (C..B). The pattern lives above C2 + root");
