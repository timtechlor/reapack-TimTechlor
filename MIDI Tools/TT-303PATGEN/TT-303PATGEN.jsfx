  pg_kn(2, 9, 356, 470, 14, 0, 100, 30, "ACCENT", 0, "ACCENT %: chance that a playing step is accented", 1);
  pg_kn(3, 10, 428, 470, 14, 0, 100, 20, "SLIDE", 0, "SLIDE %: share of the playing steps that slide into the next playing step (e.g. 20 % of 8 notes = 2 slides; the rhythm is built so that neighbours exist)", 1);
  pg_kn(4, 11, 500, 470, 14, 0, 100, 20, "OCT JUMP", 0, "OCT JUMP %: chance of an octave jump (+1 / +2), limited by RANGE", 1);
  pg_kn(5, 12, 572, 470, 14, 0, 100, 25, "REPEAT", 0, "REPEAT %: tendency to repeat the previous note", 1);
  pg_kn(6, 13, 644, 470, 14, 5, 24, 12, "RANGE st", 0, "RANGE: ambitus in semitones above ROOT (5..24). No note leaves 0..RANGE", 1);
  pg_kn(7, 14, 716, 470, 14, 0, 100, 20, "TENSION", 0, "TENSION %: share of dissonant tones (b2, tritone) - only if the scale contains them", 1);
  pg_kn(8, 15, 788, 470, 14, 0, 100, 40, "SYNCOPATION", 0, "SYNCOPATION %: moves the notes from the downbeats to the offbeats", 1);
  pg_kn(9, 16, 860, 470, 14, 0, 100, 10, "TIES", 0, "TIES %: chance that a step following a note becomes a tie (holds the note)", 1);
  // Algorithmus / Skala
