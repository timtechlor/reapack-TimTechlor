tt_hov(52, 350, 284, 14, "Timing window set by TIME DEV (0 to the set delay); the white mark is the last queued note's HUMAN delay.");
// Historie: colDim(1); lm_xs(5, 18, 374, 318, 13, "+/- range, live");
lm_dgHumSer > 0 ? sprintf(#ui_s, "LAST NOTE: VEL %+.0f   TIME +%.1f ms", lm_dgVelD, lm_dgHumMs) : strcpy(#ui_s, "LAST NOTE: --");
colDim(1); lm_xs(5, 18, 374, 318, 13, #ui_s);   // P26: Feld-Schrift
tt_hov(18, 372, 318, 15, "Shows the last queued note's final velocity change and HUMAN delay; the bands show the set ranges, the velocity change includes MUTATE.");

