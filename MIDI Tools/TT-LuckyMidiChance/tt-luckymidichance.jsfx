sprintf(#ui_s, "%.0f", slider15);
colAcid(1); lm_xs(5, 404, 374, 98, 13, #ui_s);
tt_hov(404, 358, 96, 28, "Chance in percent that a note is mutated; the target at right is changed for that note only, seeded.");   // P23
ui_tv = floor(slider16);
