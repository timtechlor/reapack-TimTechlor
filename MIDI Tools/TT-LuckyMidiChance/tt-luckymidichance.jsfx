ui_tv == 0 ? strcpy(#cmb_txt, "GATE FLIP") : ui_tv == 1 ? strcpy(#cmb_txt, "VEL") : ui_tv == 2 ? strcpy(#cmb_txt, "RATCH") : strcpy(#cmb_txt, "ALL");
lm_cmb(24, 16, 505, 362, 150, 18, 4, "What a MUTATE hit changes: GATE FLIP reverses the combined EUCLID and CHANCE result (COND still applies), VEL offsets velocity by up to +/-48, RATCH picks a random ratchet division, ALL does all three.");
lm_led(670, 371, 4, lm_fl(ui_tsm, 30), 0);
tt_hov(660, 360, 20, 22, "Flashes when MUTATE hits a note; GATE FLIP reverses the combined EUCLID and CHANCE result while COND still applies.");

// --- Readouts (8,394,684,58) ---
panel2(8, 394, 684, 58, "MONITOR");
// 1.6.0 (Codex 2): Kette als Stufen mit LED (Blitz = Stufe hat eine Note bearbeitet), hell = eingeschaltet.
// Historie: colDim(1); lm_xs(5, 120, 399, 560, 14, "MIDI IN > COND > EUCLID > CHANCE > STRUM > RATCHET > OUT");
ui_en = slider1 > 0.5;
lm_stage(120, "IN", ui_en, lm_fl(ui_ti, 30), 0);
lm_stage(182, "COND", ui_en && floor(slider4) > 0, lm_fl(ui_tsc, 30), 0);
lm_stage(244, "EUCLID", ui_en && floor(slider12) > 0, lm_fl(ui_tse, 30), 0);
lm_stage(306, "CHANCE", ui_en && slider3 < 100, lm_fl(ui_tsh, 30), 0);
lm_stage(368, "MUTATE", ui_en && slider15 > 0, lm_fl(ui_tsm, 30), 0);
lm_stage(430, "HUMAN", ui_en && (floor(slider10) > 0 || slider11 > 0), lm_fl(ui_tsu, 30), 0);
lm_stage(492, "STRUM", ui_en && slider6 > 0, lm_fl(ui_tss, 30), 0);
lm_stage(554, "RATCH", ui_en && (floor(slider8) > 0 || (slider15 > 0 && floor(slider16) >= 2)), lm_fl(ui_tsr, 30), 0);
lm_stage(616, "OUT", ui_en, ui_fp, 1);
tt_hov(120, 399, 558, 14, "Processing order of every note-on; bright = stage on, dim = off. The dot flashes when a stage handles a note (COND/EUCLID/CHANCE: checked, MUTATE: hit, HUMAN/STRUM/RATCH: applied to a queued note, OUT: sent). MUTATE can reverse the EUCLID/CHANCE result.");
// 1.6.0 (Codex 1): Verwurf-Ursachen, Summe = EV DROP
colInk(0.85); lm_xs(5, 20, 418, 56, 12, "DROPS");
tt_hov(20, 416, 58, 15, "Dropped note-ons by cause; COND + EUCLID + CHANCE + MUTATE + QUEUE = EV DROP. A note rejected by several gates counts once: COND first, then MUTATE, EUCLID, CHANCE. Counters reset when playback starts.");
lm_cause(80, "COND", lm_dgDCond, "Notes dropped because COND was closed at the note's bar position.");
lm_cause(200, "EUCLID", lm_dgDEu, "Notes dropped because they fell on an EUCLID rest step (and MUTATE did not reverse it).");
lm_cause(320, "CHANCE", lm_dgDCh, "Notes dropped by the CHANCE roll after EUCLID let them through (and MUTATE did not reverse it).");
lm_cause(440, "MUTATE", lm_dgDMut, "Notes that EUCLID and CHANCE let through but a MUTATE GATE FLIP dropped; notes MUTATE rescued are not counted.");
lm_cause(560, "QUEUE", lm_dgDQ, "Notes dropped because the output queue had no room for them (dense RATCHET or STRUM); see Q LOAD.");
gfx_setfont(4);
// P26: lm_kv = kvLabel mit Feld bis zum naechsten Paar (Historie: kvLabel(20/150/290/430, 425))
// 1.6.0: Zeile von y 425 nach 433 (Platz fuer DROPS), Q-LOAD-Balken rechts neben dem Wert. Historie: lm_kv(..., 425, ...);
// meterH(430, 441, 240, 7, ...); Hover-Felder bei y 423.
strcpy(#klbl, "EV IN");   sprintf(#kval, "%d", slider18); lm_kv(20, 433, 126);
strcpy(#klbl, "EV OUT");  sprintf(#kval, "%d", slider19); lm_kv(150, 433, 136);
strcpy(#klbl, "EV DROP"); sprintf(#kval, "%d", slider20); lm_kv(290, 433, 136);
strcpy(#klbl, "Q LOAD");  sprintf(#kval, "%d", slider21); lm_kv(430, 433, 88);
meterH(522, 437, 158, 7, min(1, slider21 / 512));   // P21: v2-Pegelbalken (vorher eigener Balken mit Warnfarbe)
// P23: Tooltips der MONITOR-Anzeigen
tt_hov(20, 431, 120, 17, "Number of note-ons received by the processor.");
tt_hov(150, 431, 130, 17, "Number of note-ons sent out; every ratchet hit counts individually, so OUT can exceed IN.");
tt_hov(290, 431, 130, 17, "Number of note-ons dropped (by the gates or for lack of queue space); the DROPS row above splits it by cause.");
tt_hov(430, 431, 250, 17, "Scheduled events waiting in the output queue (of 512 slots); amber above 60 %, red above 85 %.");
// Historie: P23 setzte hier tt_hov-Aufrufe fuer Preset-Leiste (354..604, y 6) und OPTIONS-Knopf (614, 6); sie feuerten nie (Modul maskiert die Maus, mX = -10000), P24: ersetzt durch tt_modtips()
    // P23: Tooltip nach der Front, vor den Overlays tt_pb_post / tth_post

// P17: Preset-Leiste (250 Einheiten, Modul tt-presets) in der Kopfzeile, rechts neben dem Wordmark
// P25 (Harmonisierung Punkt 5): Laden (Werks/Anwender) und INIT melden zusaetzlich einen Undo-Punkt (tt_undo), weil die
// Preset-Auswahl der Bank (serialisiert) kein Slider ist; SAVE meldet das Modul selbst (tt_pb_commit), RENAME/COPY/DELETE auch.
lm_pa = tt_pb_post(OX + 354*SC, OY + 6*SC, SC);
lm_pa == 1 ? ( lm_pbFactory(tt_pb_arg); tt_undo(); )
: lm_pa == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( lm_pbApply(); ); tt_undo(); )
: lm_pa == 3 ? ( lm_pbCapture(); tt_pb_commit(tt_pb_arg, LM_PSW); )
: lm_pa == 4 ? ( lm_pbInit(); tt_undo(); );
tt_pb_track(lm_pbSum());
// P14: OPTIONS-Button (70x17) rechts neben der Preset-Leiste; die Box klappt selbst um
thc = tth_post(OX + 614*SC, OY + 6*SC, SC);
thc >= 0 ? ( slider40 = thc; sliderchange(slider40); slider_automate(slider40); );
tt_modtips(); tt_tipflush(); // 02.10.2026: nach allen Overlays
uikit_end();
