colInk(0.9); lm_xs(5, 120, 134, 180, 12, "COND CYCLE (BARS)");   // P26: Feld-Schrift
sprintf(#cmb_txt, "%d BARS", 2 ^ (floor(slider5) + 1));
lm_cmb(21, 5, 120, 146, 180, 20, 4, "Cycle length in bars (2, 4, 8 or 16) that FILL, !FILL and LAST refer to; the 1:2 to 4:4 modes use their own fixed grid.");
