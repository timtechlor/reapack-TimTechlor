);
tt_hov(381, 319, 284, 31, "Euclid pattern: lit dots are pulse steps, the white ring marks the current 16th step; a green (pulse) or amber (veto) inner ring marks the last note's EUCLID check, before MUTATE.");   // P23; 1.6.0
colBorder(); xline(364, 354, 680, 354);
lm_kn(9, 15, 384, 369, 12, 0, 100, 0, "", 3, 1, 1, "Chance in percent that a note is mutated; the target at right is changed for that note only, seeded.");
