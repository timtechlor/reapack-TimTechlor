desc:TT-303 Acid Machine
// @description TT-303 Acid Machine
// @author TimTechlor
// @version 1.07
// @license MIT
// @tags synth instrument acid 303 tb-303 bass techno
// @about
//   # TT-303 Acid Machine
//
//   Monophonic acid bass synthesizer in the style of the Roland TB-303.
//   Tribute model, no samples.
//
//   - Oscillator: saw / square, 1-sample PolyBLEP, 2x oversampled
//   - VCF: 4-pole cascade at the TB-303 pole positions (ZDF/TPT),
//     level-dependent resonance
//   - Slide + accent, internal 16-step sequencer with 4 banks A-D
//   - Drive (parallel EQ + WaveShaper), ping-pong delay, Freeverb reverb,
//     compressor (dry only) with adjustable mix
//   - Fully drawn device front with version display, 5 factory presets
//
//   HOST mode: sound generator from the piano roll. SEQ mode: internal
//   sequencer on the timeline or free-running.
// @changelog
//   1.07
//   - Sound engine recalibrated against reference recordings:
//     4-pole VCF at the TB-303 pole positions, much stronger resonance,
//     lower cutoff floor (~100 Hz), decay range 25-570 ms, fast VEG sag
//     after the attack (shorter, punchier steps), accent network
//     (latch + RC) with audible accent tail, 6 ms release
//   - SLIDE time now sets the arrival time (~95 %) instead of the time constant
//   - Square with pitch-dependent duty; 7-tap half-band decimation
//   - Hotter distortion (more drive and presence tilt) and +12 dB output
//     make-up: 1.07 is noticeably louder than 1.0 - lower VOLUME if needed
//   - New EQ defaults: drive EQ fully open, delay 300 Hz-2.8 kHz,
//     reverb 300 Hz-2.5 kHz (header and INIT)
//   - The preset bar shows the active preset again after loading a project
//   - Fixes: same-pitch overlaps in HOST mode; held notes are released on
//     transport stop; step at the loop end no longer fires twice; tie after
//     All-Notes-Off no longer silent; UNDO restores the right bank and
//     survives transport start; no hanging notes on SEQ OUT; MIDI transpose
//     counts keys, not events; TUNING/FINE and MIDI CC act immediately;
//     INIT resets all sound controls
//   - COPY creates an undo point for the target bank
//   - Wordmark font name corrected to "Zilap Orion"
//   1.0.1
//   - Wordmark font name corrected to "Zilap Orion"
//   1.0
//   - First full release
//about:
// TT-303 ACID MACHINE — mono acid synth in the style of the TB-303.
// Tribute, no samples, no sample ROM, all model.
//
// CONTROLS AS ON THE ORIGINAL
//   TUNING     semitones (-24..+24), plus FINE in cents (act immediately)
//   CUTOFF     filter frequency, ~100 Hz .. ~1 kHz, resonance raises it up to 2x
//   RESONANCE  filter feedback up to self-oscillation
//   ENV MOD    depth of the filter envelope, up to 5.2 octaves
//   DECAY      decay of the filter envelope, ~25 ms .. ~570 ms
//   ACCENT     level AND filter boost of the accent circuit
//   WAVEFORM   sawtooth / square
//
// MODEL DETAILS (after R. Whittle / Devil Fish / Open303 / Stinchcombe)
//  - Filter: 4 TPT stages at the poles of the idealised TB-303 diode
//    ladder denominator {0.128/1.038/2.325/3.236} — this makes the open
//    transfer function exact. Level-dependent feedback k/(1+0.4|y|),
//    2x oversampled, 7-tap half-band decimation. Soft clip only at the
//    master. Feedback HP 20 Hz, pole correction 1/(1+0.10*kRes).
//  - Square: pitch-dependent duty ~0.5*sqrt(85 Hz/f) (after Burnett)
//    and a lower level than saw -> different filter excitation.
//    1-sample PolyBLEP. The VCO runs freely.
//  - Accent: own control latch + RC network (sweep capacitor charges
//    via diode+R, discharges via the pot wiper; smoothed VCA path
//    47k x 0.033 uF). MEG time on accent = decay minimum.
//  - Slide: RC time constant in log frequency space; the same note stays.
//  - FX: delay/reverb bypassed at mix < 0.5 %. EQ OFF = true bypass.
//  - MIDI: notes are consumed, CC/pitchbend keep going.
//
// OPERATING MODES
//   HOST  Pure sound generator, played from the piano roll.
//         Velocity >= threshold = accent, overlapping notes = slide.
//   SEQ   Internal 16-step sequencer, four pattern banks A-D with
//         copy function, random and mutation, shuffle, gate length.
//         Runs on the project timeline or free (FREE RUN).
//         MIDI notes transpose the pattern (C2 = original pitch).
//         MIDI OUT also sends the sequence out.
//         All four banks travel with the project.
//
// Effect path: ahead of each of the three units — WaveShaper (Soft/Hard/
// Fold/Fuzz), ping-pong delay, Freeverb reverb — sits an input EQ
// as a dual slider (lowcut left, highcut right, 0..20 kHz). After that
// compressor (-14 dB, 5:1) and master.
//
// The input EQ only shapes what is sent into each effect; the dry
// signal runs alongside. On the drive the filtered band is distorted
// and the rest is added back undistorted — a raised lowcut takes the
// bass out of the DISTORTION, not out of the output.
//
// MIDI: THRU (header) passes INCOMING notes on, SEQ OUT (sequencer
// panel) sends the GENERATED sequence out — two sources, two switches.
// CC/pitchbend always pass through. In SEQ mode incoming notes are
// transpose commands.
//
// SURFACE after the Tim Techlor design kit: Core Black, Core White,
// Acid Green #39FF14, traces at a 45 degree angle with solder pads.
// Wordmark in Zilap Orion, if installed. Labels sans-serif
// (Segoe UI / Helvetica Neue / DejaVu Sans / Arial), numeric values
// monospaced (Consolas / DejaVu Sans Mono / Menlo / Courier New).
// Which of these is present the script measures itself.
// The front computes in a fixed design grid and scales to the
// window size — to enlarge, just drag the FX window open.
// HiDPI is honoured via gfx_ext_retina. All internal
// JSFX sliders are hidden ("-" before the name), operation is
// exclusively via the device front.

in_pin:none
out_pin:TT-303 L
out_pin:TT-303 R

options:gfx_hz=45 gmem=tt303_acid

slider1:0<0,1,1{HOST,SEQ}>-Mode
slider2:0<0,1,1{Sawtooth,Square}>-Waveform
slider3:0<-24,24,1>-Tuning (semitones)
slider4:0<-50,50,1>-Fine (cents)
slider5:32<0,100,0.1>-Cutoff Freq
slider6:55<0,100,0.1>-Resonance
slider7:62<0,100,0.1>-Env Mod
slider8:35<0,100,0.1>-Decay
slider9:60<0,100,0.1>-Accent
slider10:70<0,100,0.1>-Volume
slider11:60<0,300,1>-Slide time (ms)
slider12:100<1,127,1>-Accent from velocity
slider13:0<0,1,1{Off,On}>-Distortion
slider14:0<0,3,1{Soft,Hard,Fold,Fuzz}>-Distortion model
slider15:8<1,40,0.1>-Drive
slider16:15<0,100,0.5>-Delay mix (%)
slider17:1<0,3,1{1/8,Dotted 1/8,1/4,1/2}>-Delay division
slider18:60<0,90,1>-Delay feedback (%)
slider19:18<0,100,0.5>-Reverb mix (%)
slider20:70<20,100,1>-Room size (%)
slider21:16<1,16,1>-SEQ pattern length
slider22:0<0,75,1>-SEQ Shuffle (%)
slider23:55<10,100,1>-SEQ Gate (%)
slider24:0<0,1,1{Off,On}>-SEQ Free Run
slider25:0<0,3,1{A,B,C,D}>-SEQ pattern bank
slider26:0<0,1,1{Off,On}>-SEQ Out (sequence to output)
slider27:20<0,20000,1>-Drive EQ Lowcut (Hz)
slider28:20000<20,20000,1>-Drive EQ Highcut (Hz)
slider29:300<0,20000,1>-Delay EQ Lowcut (Hz)
slider30:2800<20,20000,1>-Delay EQ Highcut (Hz)
slider31:300<0,20000,1>-Reverb EQ Lowcut (Hz)
slider32:2500<20,20000,1>-Reverb EQ Highcut (Hz)
slider33:0<0,1,1{Off,On}>-MIDI Thru (incoming notes)
slider34:1<0,1,1{Off,On}>-Compressor
slider35:100<0,100,1>-Compressor mix

/* ============================================================
   @init — memory map, functions, base state.
   Functions must come BEFORE their first use, which is why
   everything sits together here.
   ============================================================ */
@init

// ---------- Memory map ----------
// Note: M_SEQ deliberately lies in a gap that the memset skips.
// @init runs again on every samplerate change and on transport start —
// without this gap the pattern would be gone every time, including the
// one just loaded from the project.
M_SCOPE  = 64;       // 512    oscilloscope ring buffer
M_PAR    = 1792;     // 128    Freeverb layout and state
M_PRE    = 2048;     // 8192   reverb predelay
M_EVT    = 10240;    // 2048   MIDI queue, 512 events x 4 values
M_SEQ    = 12288;    // 1024   4 banks x 16 steps x 4 values [is preserved]
M_UNDO   = 13312;    // 64     one bank of undo (RND/MUT/CLEAR/COPY) [is preserved]
M_SOUT   = 13376;    // 128    notes currently on at SEQ OUT [preserved, so @block can end them]
M_SEQEND = 13504;    // covered by the memset again from here
M_HELD   = 13504;    // 128    held transpose keys (SEQ mode)
M_STK    = 13632;    // 128    unique pitches, last note wins
M_NCNT   = 13760;    // 128    open note-ons per pitch (HOST overlap)
M_DLY1   = 16384;

// Sized for the longest possible delay: a half note at 40 BPM is 3.0 s.
dlyBufLen = ceil(3.3*srate);
M_DLY2 = M_DLY1 + dlyBufLen + 16;
M_RVB  = M_DLY2 + dlyBufLen + 16;

rvSc     = max(1, srate/44100);              // scale Freeverb lengths
rvSpread = ceil(23*rvSc);
rvbTotal = ceil(25174*rvSc) + 12*rvSpread + 128;
MEMTOP   = M_RVB + rvbTotal + 16;

EVT_MAX = 512;                               // room in the MIDI queue

SRX = srate*2;                               // working rate of the filter (2x)

// Step fields and bank size
SF_NOTE = 0; SF_GATE = 1; SF_ACC = 2; SF_SLIDE = 3;
SEQ_BANK = 64;                               // 16 steps x 4 values per bank
SEQ_NLO = 24; SEQ_NHI = 48;                  // C1 .. C3 in the step editor

// Layout of the front in the design grid; SC scales to the window size
UI_W = 900; UI_H = 732;
LANE_Y = 544; LANE_H = 92; ROW_H = 3.68;     // 25 semitones in the note lane
GRID_X = 52; GRID_W = 52;                    // 16 columns of 52 points

// HiDPI: REAPER then reports the real pixel resolution, and because SC
// follows from gfx_w/gfx_h, the front is automatically drawn larger
// instead of staying tiny.
gfx_ext_retina = 1;

/* ---------- small math helpers ---------- */

// tanh substitute (not every REAPER build has tanh as a builtin)
function fastTanh(x) local(a) (
  a = min(30, max(-30, 2*x));
  (1 - exp(-a))/(1 + exp(-a));
);

// soft saturation without exp — Pade approximation of tanh, saturates at +-1
function softSat(x) local(a) (
  a = min(3, max(-3, x));
  a*(27 + a*a)/(27 + 9*a*a);
);

// 1-sample PolyBLEP
function polyBlep(t, dt) (
  t < dt ? ( t /= dt; t + t - t*t - 1 )
  : t > 1 - dt ? ( t = (t - 1)/dt; t*t + t + t + 1 )
  : 0;
);

// Soft limiting instead of a hard cut. Fully linear up to 0.7, above
// that a tanh knee with continuous slope, limit exactly 1.0.
// A resonance overshoot no longer clips off square.
function softClip(x) local(a) (
  a = abs(x);
  a <= 0.7 ? x : (x >= 0 ? 1 : -1)*(0.7 + 0.3*fastTanh((a - 0.7)*3.3333333));
);

/* ---------- Parameters ---------- */

function readSliders() (
  seqMode   = slider1;
  waveSel   = slider2;
  tuneSemi  = slider3;
  fineCent  = slider4;
  cutN      = slider5*0.01;
  resN      = slider6*0.01;
  envN      = slider7*0.01;
  decN      = slider8*0.01;
  accN      = slider9*0.01;
  volG      = slider10*0.01;
  slideSec  = slider11*0.001;
  accThresh = slider12;
  fxDistOn  = slider13;
  distModel = slider14;
  driveG    = max(1, slider15);
  dlyMix    = slider16*0.01;
  dlyDiv    = slider17 == 0 ? 0.5 : slider17 == 1 ? 0.75 : slider17 == 2 ? 1 : 2;
  dlyFb     = slider18*0.01;
  rvbMix    = slider19*0.01;
  roomSz    = (slider20 - 20)/80;
  patLen    = max(1, min(16, floor(slider21)));
  bankBase  = floor(slider25)*SEQ_BANK;
  midiOut   = slider26;
  midiThru  = slider33;
  compOn    = slider34;                        // compressor on/off
  compMix   = slider35*0.01;                   // 1 = full, 0 = bypass
  swFrac    = slider22/200;                  // up to 0.375 step offset
  gateFrac  = slider23*0.01;
  freeRun   = slider24;
  eqDLoHz   = slider27; eqDHiHz = slider28;    // input EQs of the FX units
  eqYLoHz   = slider29; eqYHiHz = slider30;
  eqRLoHz   = slider31; eqRHiHz = slider32;
);

function updateParams() (
  // --- Filter. The resonance hump moves up with rising resonance, so the
  // cutoff follows it. The (145 - K*e^-6cutN) term sets the low floor
  // (~100 Hz, ~200 Hz at full resonance) without moving mid and top.
  baseF   = (145 - 45*exp(-6*cutN))*exp(cutN*1.95)*(1 + resN);
  // Resonance range: coefficient and ^1.2 curve keep the middle moderate
  // and reach strong resonance at the top while staying stable.
  kRes    = 1.6 + 14.5*(resN^1.2);           // Q~1.6 at 0, max ~16.1
  resMakeUp = 0.62;                          // -4.2 dB flat: level offset of the chain
  poleScale = 1/(1 + 0.10*kRes);             // mild peak correction
  // Residual effect with the control at 0: the TB-303 circuit does not
  // let the MEG influence vanish completely (Whittle).
  envOct  = 0.4 + envN*4.8;                  // depth: ~0.4 .. 5.2 octaves
  // Tuning as a log offset that is applied to the note in @sample, so
  // TUNING/FINE act immediately on the sounding note and on a slide
  // target. ln(2)/12 = 0.0577622650.
  tuneLog = (tuneSemi + fineCent*0.01)*0.0577622650;
  // MEG decay range 25 / 120 / 566 ms.
  decTau  = 0.025*exp(decN*3.12);
  mDecC   = exp(-1/(decTau*srate));
  // Accent shorts the decay pot: MEG time = decay minimum
  // (Whittle, 303-unique), here 45 ms.
  mDecAcc = exp(-1/(0.045*srate));
  // Accent network (Whittle): sweep capacitor 1 uF charges via
  // diode + 47k + part of the resonance pot (0..100k) -> tau ~47..147 ms;
  // discharge via the 100k wiper -> tau ~100 ms. VCA path 47k x
  // 0.033 uF -> tau ~1.55 ms (smooths the accent pulse only slightly).
  accChgC = 1 - exp(-1/((0.047 + 0.10*resN)*srate));
  accDisC = exp(-1/(0.10*srate));
  accVcaC = 1 - exp(-1/(0.00155*srate));
  fcMax   = min(16000, 0.45*SRX);
  // --- Couplings in the VCF path
  oscHpA  = exp(-2*$pi*40/SRX);
  sqHpA   = exp(-2*$pi*28/SRX);              // slightly lower tilt
  // Feedback HP 20 Hz: DC block. Higher values choke the resonance at low
  // cutoff because poleScale pulls the pole below the HP.
  fbHpA   = exp(-2*$pi*20/SRX);
  // --- VCA: fundamental decay tau ~1.1 s, independent of the controls
  attSec  = 0.003;                           // VEG attack (sharp)
  susTau  = 1.10;
  susCoef = exp(-1/(susTau*srate));
  // Sag stage: after the attack the VEG falls quickly to ~45 % of the
  // peak (tau 20 ms) and then decays slowly with susTau -> short,
  // punchy steps like the original.
  sagCoef = exp(-1/(0.020*srate));
  // Release 6 ms.
  relCoef = exp(-1/(0.006*srate));
  // SLIDE control = ~95 % arrival time: tau_eff = slideSec/3 reaches
  // ~95 % of the target exactly at the set time (RC character stays).
  slideSamps = slideSec*srate/3;
  // --- Distortion: level compensation per model (measured, filtered saw,
  // driveG 1..40): Hard -1.13 dB, Fold -7.92 dB, Fuzz -1.10 dB vs. Soft.
  // Fold 2.40 instead of 2.49 = peak headroom.
  distMk    = distModel == 1 ? 1.14 : distModel == 2 ? 2.40
            : distModel == 3 ? 1.14 : 1;
  // Input gain of the shaper (x3) and presence tilt (x2.6) set the
  // amount of distortion; the output soft clip limits the level gain.
  distPreG  = fxDistOn ? driveG*3.0 : 1;
  distPostG = fxDistOn ? 0.9*distMk/(driveG^0.35) : 1;
  // Presence tilt for the shaper input only: one-pole LP at ~1.8 kHz,
  // band = LP + 2.6*(x - LP) => high shelf ~+8.3 dB. Sharpens the
  // distortion without changing the dry sound (dRest runs unaffected).
  dShG      = 1 - exp(-2*$pi*1800/srate);
  // Fixed output make-up +12 dB at the very end before the master clip.
  // The gain sits behind all FX, so internal level ratios stay the same
  // and the soft clip keeps working as a limiter.
  outMk     = 4.0;
  // --- Compressor (3 ms / 250 ms, knee 30, threshold -14 dB, 5:1).
  // The curve below is algebraically identical to the textbook form
  //   over<=-K/2: 0 | |over|<K/2: -(over+K/2)^2/(2K)*(1-1/R)
  //   over>=K/2 : -over*(1-1/R)
  // with K=30, R=5, so (1-1/R)=0.8 and 2K=60. Do not rewrite.
  cAtk = 1 - exp(-1/(0.003*srate));
  cRel = 1 - exp(-1/(0.25*srate));
  // --- Delay
  lpG24   = 1 - exp(-2*$pi*2400/srate);
  // Cross-coupling undamped, feedback squared — same loop gain, but
  // the right channel sounds even at 0 % feedback.
  dlyFb2  = dlyFb*dlyFb;
  // --- FX input EQs. 0 Hz / 20 kHz = true bypass (not a=1).
  eqDLoOn = eqDLoHz > 0;     eqDHiOn = eqDHiHz < 20000;
  eqYLoOn = eqYLoHz > 0;     eqYHiOn = eqYHiHz < 20000;
  eqRLoOn = eqRLoHz > 0;     eqRHiOn = eqRHiHz < 20000;
  eqDLoA = eqDLoOn ? exp(-2*$pi*eqDLoHz/srate) : 0;
  eqDHiG = eqDHiOn ? 1 - exp(-2*$pi*eqDHiHz/srate) : 1;
  eqYLoA = eqYLoOn ? exp(-2*$pi*eqYLoHz/srate) : 0;
  eqYHiG = eqYHiOn ? 1 - exp(-2*$pi*eqYHiHz/srate) : 1;
  eqRLoA = eqRLoOn ? exp(-2*$pi*eqRLoHz/srate) : 0;
  eqRHiG = eqRHiOn ? 1 - exp(-2*$pi*eqRHiHz/srate) : 1;
  // --- Reverb
  rhpA    = exp(-2*$pi*250/srate);
  rlpG    = 1 - exp(-2*$pi*3200/srate);
  cmbFb   = 0.7 + 0.25*roomSz;
  cmbDamp = 0.44 - 0.14*roomSz;              // shortest combs a little deader
  preLen  = floor(min(0.012*srate, 8000));
);

/* ---------- Effects ---------- */

// WaveShaper models (input limited to +-1 like a Web Audio shaper)
function distProc(x) local(c, t, m) (
  c = min(1, max(-1, x));
  distModel == 1 ? ( t = min(0.82, max(-0.82, c*4)); fastTanh(t*1.4); )
  : distModel == 2 ? ( t = c*1.7 + 1; m = t - 4*floor(t/4); (abs(m - 2) - 1)*0.82; )
  : distModel == 3 ? ( c >= 0 ? 1 - exp(-c*4.2) : -(1 - exp(c*2.1)); )
  : fastTanh(3.6*c);
);

// Freeverb comb — i = 0..15 (channel 0: 0..7, channel 1: 8..15)
function combProc(i, x) local(o, idx, y, s) (
  o = M_RVB + M_PAR[i];
  idx = M_PAR[32+i];
  y = o[idx];
  s = M_PAR[48+i]*cmbDamp + y*(1 - cmbDamp);
  M_PAR[48+i] = s;
  o[idx] = x + s*cmbFb;
  idx += 1; idx >= M_PAR[16+i] ? idx = 0;
  M_PAR[32+i] = idx;
  y;
);

// Freeverb allpass — i = 0..7
function apProc(i, x) local(o, idx, y) (
  o = M_RVB + M_PAR[64+i];
  idx = M_PAR[80+i];
  y = o[idx];
  o[idx] = x + 0.5*y;
  idx += 1; idx >= M_PAR[72+i] ? idx = 0;
  M_PAR[80+i] = idx;
  y - x;
);

/* ---------- Voice ---------- */

// RC recharge of the control voltage (1 V/oct) -> exponential curve in
// log frequency space that eases out at the end instead of kinking.
// slideSamps is the time constant tau (95 % after 3*tau).
function startSlide(tl) (
  slideSamps >= 1 ? (
    slideTgt = tl;
    slideCoef = 1 - exp(-1/slideSamps);
    sliding = 1;
  ) : ( curLog = tl; sliding = 0; );
);

// Note start. accOn is the accent control latch: the network (sweep
// capacitor, VCA path) follows it even during a tie, without
// retriggering the base envelopes. noteAcc remembers the MEG time of
// the note (accent = short decay = decay minimum, Whittle).
function startNote(acc) (
  accOn = acc;
  noteAcc = acc;
  accentLed = acc;
  peakAmp = 0.5;                    // accent level comes from accVca
  attInc  = (peakAmp - amp)/max(1, attSec*srate);
  envStage = 1; gateHeld = 1;
  mEnv = 1;
);

function voiceOn(n, acc) local(f, i, j, legato, sameNote) (
  // Every note-on needs its note-off. The counter keeps same-pitch
  // ties; the stack holds each pitch only once for the priority.
  legato = gateHeld && stkN > 0;
  sameNote = n == noteCur;
  M_NCNT[n] += 1;
  i = 0; j = 0;
  loop(stkN, M_STK[i] != n ? ( M_STK[j] = M_STK[i]; j += 1; ); i += 1; );
  stkN = j;
  M_STK[stkN] = n; stkN += 1;
  noteCur = n;
  f = 440*2^((n - 69)/12);                   // tuning: tuneLog in @sample
  legato ? (
    !sameNote ? startSlide(log(f));          // tie: leave a slide to the same target alone
    // A tied step may still be accented: the accent latch follows the
    // step (on AND off) without retriggering the envelopes.
    accOn = acc; accentLed = acc;
  ) : (
    curLog = log(f); sliding = 0;
    startNote(acc);
  );
);

function noteOff(n) local(i, j) (
  // A note-off only acts when the last open note-on of this pitch is
  // closed. Unknown offs are ignored.
  M_NCNT[n] > 0 ? (
    M_NCNT[n] -= 1;
    M_NCNT[n] == 0 ? (
      i = 0; j = 0;
      loop(stkN, M_STK[i] != n ? ( M_STK[j] = M_STK[i]; j += 1; ); i += 1; );
      stkN = j;
      stkN > 0 ? (
        M_STK[stkN-1] != noteCur ? (            // last-note priority
          noteCur = M_STK[stkN-1];
          startSlide(log(440*2^((noteCur - 69)/12)));
        );
      ) : (
        gateHeld = 0;
        envStage == 1 || envStage == 2 ? envStage = 3 : 0;
      );
    );
  );
);

function allOff() (
  memset(M_NCNT, 0, 128);
  stkN = 0; gateHeld = 0;
  envStage == 1 || envStage == 2 ? envStage = 3 : 0;
);

/* ---------- Pattern ---------- */

// After loading: pull all steps into valid limits — protection against
// damaged/older project data (editor and seqFire rely on it).
function validateBanks() local(i, v) (
  i = 0;
  loop(4*SEQ_BANK,
    v = M_SEQ[i];
    (i & 3) == SF_NOTE ? ( M_SEQ[i] = min(SEQ_NHI, max(SEQ_NLO, floor(v + 0.5))); )
                       : ( M_SEQ[i] = v > 0.5 ? 1 : 0; );
    i += 1;
  );
);

function setStep(bb, s, n, g, a, sl) (
  M_SEQ[bb + s*4 + SF_NOTE]  = n; M_SEQ[bb + s*4 + SF_GATE]  = g;
  M_SEQ[bb + s*4 + SF_ACC]   = a; M_SEQ[bb + s*4 + SF_SLIDE] = sl;
);

function copyBank(src, dst) local(i) (
  src != dst ? ( i = 0; loop(SEQ_BANK, M_SEQ[dst + i] = M_SEQ[src + i]; i += 1; ); );
);

// Undo remembers the bank it came from and writes back only there.
function saveUndo(bb) local(i) (
  i = 0; loop(SEQ_BANK, M_UNDO[i] = M_SEQ[bb + i]; i += 1; );
  undoArm = 1; undoBank = bb;
);
function loadUndo() local(i) (
  undoArm ? ( i = 0; loop(SEQ_BANK, M_SEQ[undoBank + i] = M_UNDO[i]; i += 1; ); undoArm = 0; );
);

function clearBank(bb) local(s) (
  s = 0; loop(16, setStep(bb, s, 36, 0, 0, 0); s += 1; );
);

// Note pool for random: minor pentatonic above C2 — the register where
// the typical acid lines sit.
function randNote() local(r) (
  r = rand(1);
  r < 0.44 ? 36 : r < 0.58 ? 39 : r < 0.70 ? 41
  : r < 0.80 ? 43 : r < 0.90 ? 46 : 48;
);

function randPattern(bb) local(s, n) (
  s = 0;
  loop(16,
    n = randNote();
    rand(1) < 0.12 ? n -= 12;                // now and then an octave lower
    M_SEQ[bb + s*4 + SF_NOTE]  = min(SEQ_NHI, max(SEQ_NLO, n));
    M_SEQ[bb + s*4 + SF_GATE]  = rand(1) < 0.78;
    M_SEQ[bb + s*4 + SF_ACC]   = rand(1) < 0.22;
    M_SEQ[bb + s*4 + SF_SLIDE] = rand(1) < 0.16;
    s += 1;
  );
  // The first step is always set and accented, otherwise the figure
  // starts in nothing and you cannot hear the pattern start.
  setStep(bb, 0, 36, 1, 1, 0);
);

// Mutation: only touch a few steps, the rest stays recognisable.
function mutPattern(bb) local(k, s, r, n) (
  k = 0;
  loop(3,
    s = floor(rand(16));
    r = rand(1);
    r < 0.40 ? (
      n = randNote();
      M_SEQ[bb + s*4 + SF_NOTE] = min(SEQ_NHI, max(SEQ_NLO, n));
    ) : r < 0.62 ? (
      M_SEQ[bb + s*4 + SF_GATE] = 1 - M_SEQ[bb + s*4 + SF_GATE];
    ) : r < 0.82 ? (
      M_SEQ[bb + s*4 + SF_ACC] = 1 - M_SEQ[bb + s*4 + SF_ACC];
    ) : (
      M_SEQ[bb + s*4 + SF_SLIDE] = 1 - M_SEQ[bb + s*4 + SF_SLIDE];
    );
    k += 1;
  );
);

function defaultPattern() local(b, i) (
  setStep(0,  0, 36, 1, 1, 0);  setStep(0,  1, 36, 1, 0, 1);
  setStep(0,  2, 48, 1, 0, 0);  setStep(0,  3, 36, 1, 0, 0);
  setStep(0,  4, 39, 1, 1, 0);  setStep(0,  5, 36, 1, 0, 0);
  setStep(0,  6, 36, 0, 0, 0);  setStep(0,  7, 43, 1, 0, 1);
  setStep(0,  8, 43, 1, 0, 0);  setStep(0,  9, 36, 1, 0, 0);
  setStep(0, 10, 48, 1, 1, 0);  setStep(0, 11, 36, 1, 0, 0);
  setStep(0, 12, 41, 1, 0, 1);  setStep(0, 13, 41, 1, 0, 0);
  setStep(0, 14, 39, 1, 0, 0);  setStep(0, 15, 36, 0, 0, 0);
  b = 1; loop(3, copyBank(0, b*SEQ_BANK); b += 1; );
);

/* ---------- Sequencer ---------- */

// MIDI out. The offset is the position in the running block, so the
// sequence stays sample-accurate at the output too.
// M_SOUT remembers every note sent out: the note-off follows even if
// SEQ OUT has been switched off in the meantime (otherwise the note
// hangs in the target device), and no orphan note-off goes out without
// a note-on.
// Velocity 64/127 instead of 100/127: a receiver with the usual
// threshold >= 100 (e.g. this device itself in HOST mode) would
// otherwise treat normal notes as accents.
function seqSendOn(n, acc) (
  midiOut ? ( midisend(smplPos, 0x90, n, acc ? 127 : 64); M_SOUT[n] = 1; );
);
function seqSendOff(n) (
  M_SOUT[n] ? ( midisend(smplPos, 0x80, n, 0); M_SOUT[n] = 0; );
);

function seqRelease() (
  seqHeld >= 0 ? ( noteOff(seqHeld); seqSendOff(seqHeld); seqHeld = -1; );
  gateLeft = 0;
);

// Fire a step. A step's slide flag ties it to the FOLLOWING one —
// hence prevSlide decides between legato and retrigger.
// The gate only stays up past the step when the following step is a
// note: slide -> rest releases the gate at the normal gate end
// (Savov/Schmidt: the gate falls at the following step if there is
// no gate there).
function seqFire(s) local(n, a, oldHeld, sl, nextS, nextNote) (
  curStepDisp = s;
  M_SEQ[bankBase + s*4 + SF_GATE] ? (
    n = min(120, max(0, M_SEQ[bankBase + s*4 + SF_NOTE] + seqTrans));
    a = M_SEQ[bankBase + s*4 + SF_ACC];
    prevSlide ? (
      oldHeld = seqHeld;
      // Same target note = tie: the note keeps sounding, no retrigger.
      // Accent is its own latch and switches per step on AND off.
      oldHeld == n ? ( accOn = a; accentLed = a; )
      : (
        voiceOn(n, a); seqSendOn(n, a);
        oldHeld >= 0 ? ( noteOff(oldHeld); seqSendOff(oldHeld); );
      );
    ) : (
      seqHeld >= 0 ? ( noteOff(seqHeld); seqSendOff(seqHeld); );
      voiceOn(n, a); seqSendOn(n, a);
    );
    seqHeld = n;
    sl = M_SEQ[bankBase + s*4 + SF_SLIDE];
    nextS = s + 1 >= patLen ? 0 : s + 1;
    nextNote = M_SEQ[bankBase + nextS*4 + SF_GATE];
    prevSlide = sl;
    gateLeft = sl && nextNote ? -1 : max(1, gateFrac*stepSamps);
  ) : (
    seqRelease();
    prevSlide = 0; accOn = 0;
  );
);

/* ---------- MIDI ---------- */

// Release transpose keys in SEQ mode (mode change, All-Notes-Off)
function clearHeld() ( memset(M_HELD, 0, 128); midiHeld = 0; seqTrans = 0; );

// m1 & 0xF0 yields 0x90 / 0x80 / 0xB0 — this is exactly how to compare.
// SEQ mode: midiHeld counts KEYS (M_HELD), not events — otherwise a
// double note-on left the transposition hanging after release.
// All-Notes-Off also releases the sequencer note: otherwise seqHeld
// pointed at a note the voice no longer has, and a following tie
// (slide to the same note) stayed silent.
// Sound CCs go straight into the DSP aliases, so they act at once and
// not only in the next @block.
function syncDsp() ( readSliders(); updateParams(); );

function handleMidi(m1, m2, m3) local(st, nv) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? (
    seqMode ? ( !M_HELD[m2] ? ( M_HELD[m2] = 1; midiHeld += 1; ); seqTrans = m2 - 36; )
            : voiceOn(m2, m3 >= accThresh);
  )
  : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    seqMode ? ( M_HELD[m2] ? ( M_HELD[m2] = 0; midiHeld -= 1; ); midiHeld == 0 ? seqTrans = 0; )
            : noteOff(m2);
  )
  : st == 0xB0 ? (
    m2 == 123 || m2 == 120 ? ( seqRelease(); allOff(); prevSlide = 0; clearHeld(); )
    : m2 == 74 ? ( slider5  = m3 * 100 / 127; slider_automate(slider5);  syncDsp(); )  // cutoff
    : m2 == 71 ? ( slider6  = m3 * 100 / 127; slider_automate(slider6);  syncDsp(); )  // res
    : m2 == 73 ? ( slider7  = m3 * 100 / 127; slider_automate(slider7);  syncDsp(); )  // env
    : m2 == 75 ? ( slider8  = m3 * 100 / 127; slider_automate(slider8);  syncDsp(); )  // decay
    : m2 == 16 ? ( slider9  = m3 * 100 / 127; slider_automate(slider9);  syncDsp(); )  // accent
    : m2 ==  7 ? ( slider10 = m3 * 100 / 127; slider_automate(slider10); syncDsp(); )  // volume
    : 0;
  )
  : 0;
);

/* ---------- Surface building blocks ----------
   Everything is given in the 900 x 732 design grid. SC is the factor to
   the actual window size, OX/OY centre the image. The mouse is mapped
   back into the grid (mX/mY), so that hit tests and drag sensitivity
   stay independent of the zoom.                                       */

// Assigned drag IDs (dragId), so later extensions do not collide:
//   1..18      rotary knobs
//   20..25     handles of the three dual EQ strips
//   1000..1015 columns in the step editor
// Free: 19, 26..999, from 1016.

function xrect(x, y, w, h) (
  gfx_rect(OX + x*SC, OY + y*SC, max(1, w*SC), max(1, h*SC), 1);
);
function xline(x1, y1, x2, y2) (
  gfx_line(OX + x1*SC, OY + y1*SC, OX + x2*SC, OY + y2*SC, 1);
);
function xcirc(x, y, r, f) (
  gfx_circle(OX + x*SC, OY + y*SC, max(1, r*SC), f, 1);
);
function xat(x, y) ( gfx_x = OX + x*SC; gfx_y = OY + y*SC; );
function xstr(x, y, s) ( xat(x, y); gfx_drawstr(s); );
function xctr(x, y, w, h, s) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = OX + x*SC + (w*SC - tw)*0.5;
  gfx_y = OY + y*SC + (h*SC - th)*0.5;
  gfx_drawstr(s);
);
function inBox(bx, by, bw, bh) (
  mX >= bx && mX < bx + bw && mY >= by && mY < by + bh;
);

// Core colours from the design kit
function colAcid(a)  ( gfx_set(0.224, 1.000, 0.078, a); );   // #39FF14
function colDim(a)   ( gfx_set(0.130, 0.340, 0.090, a); );
function colWhite(a) ( gfx_set(1, 1, 1, a); );
function colInk(a)   ( gfx_set(0.75, 0.81, 0.75, a); );

// Solder pad at the end of a trace
function pad(x, y, r) (
  colAcid(1); xcirc(x, y, r, 1);
  gfx_set(0, 0, 0, 1); xcirc(x, y, r*0.40, 1);
);

// Trace: horizontal up to the bend, then 45 degrees
function trace(x1, y1, x2, y2) local(kx) (
  kx = x2 - abs(y2 - y1);
  colDim(1);
  xline(x1, y1, kx, y1);
  xline(kx, y1, x2, y2);
);

function panelBox(x, y, w, h) (
  gfx_set(0.072, 0.077, 0.072, 1); xrect(x, y, w, h);
  gfx_set(0.125, 0.155, 0.115, 1);
  xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
  xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
);

// Switch. Returns 1 if it was clicked in this frame.
function btn(x, y, w, h, on, s) local(hit, hov) (
  hov = inBox(x, y, w, h);
  hit = uiClick && hov;
  on ? (
    colAcid(0.88); xrect(x, y, w, h);
    gfx_set(0, 0, 0, 1);
  ) : (
    gfx_set(0.098, 0.103, 0.098, 1); xrect(x, y, w, h);
    hov ? gfx_set(0.30, 0.46, 0.26, 1) : gfx_set(0.15, 0.20, 0.14, 1);
    xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
    xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
    hov ? gfx_set(0.85, 0.95, 0.82, 1) : gfx_set(0.78, 0.84, 0.76, 1);
  );
  xctr(x, y, w, h, s);
  hit;
);

// Rotary knob. Drag vertically, Shift = fine, mouse wheel works too.
// Returns the (possibly changed) value.
function knobDef(id) (
  id == 1 ? 0 : id == 2 ? 0 : id == 3 ? 32 : id == 4 ? 55 : id == 5 ? 62
  : id == 6 ? 35 : id == 7 ? 60 : id == 8 ? 70 : id == 9 ? 8 : id == 10 ? 15
  : id == 11 ? 60 : id == 12 ? 18 : id == 13 ? 70 : id == 14 ? 60
  : id == 15 ? 16 : id == 16 ? 0 : id == 17 ? 55 : id == 18 ? 100 : 0;
);

function knob(id, cx, cy, r, val, vmn, vmx)
  local(t, i, a, ri, ro, nv, dv, hot, sh, def, nTick) (
  nv = val;
  def = knobDef(id);
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = (mX - cx)*(mX - cx) + (mY - cy)*(mY - cy) <= (r + 7)*(r + 7);
  uiRClk && hot ? ( nv = def; )
  : uiClick && hot ? (
      clickId == id && clickWait > 0 ? ( nv = def; dragId = -1; clickWait = 0; )
      : ( dragId = id; dragY = mY; dragV = val; dragSh = sh; clickId = id; clickWait = 12; );
    );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh; dragY = mY; dragV = val; );
    dv = (dragY - mY)/(sh ? 900 : 170);
    nv = min(vmx, max(vmn, dragV + dv*(vmx - vmn)));
  );
  hot && mouse_wheel != 0 ? (
    nv = min(vmx, max(vmn, val + (mouse_wheel/120)*(vmx - vmn)*0.02));
    mouse_wheel = 0;
  );
  t = (nv - vmn)/(vmx - vmn);
  gfx_set(0.105, 0.110, 0.105, 1); xcirc(cx, cy, r - 5, 1);
  hot || dragId == id ? gfx_set(0.26, 0.40, 0.24, 1) : gfx_set(0.15, 0.19, 0.14, 1);
  xcirc(cx, cy, r - 5, 0);
  nTick = (hot || dragId == id) ? 24 : 12;
  i = 0;
  loop(nTick + 1,
    a = (-225 + 270*i/nTick)*$pi/180;
    ri = r - 3; ro = r + 1;
    i/nTick <= t ? colAcid(1) : gfx_set(0.16, 0.18, 0.15, 1);
    xline(cx + cos(a)*ri, cy + sin(a)*ri, cx + cos(a)*ro, cy + sin(a)*ro);
    i += 1;
  );
  a = (-225 + 270*t)*$pi/180;
  colWhite(1);
  xline(cx + cos(a)*(r - 16), cy + sin(a)*(r - 16), cx + cos(a)*(r - 7), cy + sin(a)*(r - 7));
  gfx_set(0.30, 0.34, 0.30, 1); xcirc(cx, cy, 2, 1);
  nv;
);

// String in #vstr centred at (cx, y) — set the font first
function drawCentered(cx, y) local(w, h) (
  gfx_measurestr(#vstr, w, h);
  xat(cx - w*0.5, y); gfx_drawstr(#vstr);
);

// Label (#klbl) grey + value (#kval) acid from x0; the caller computes
// the position from the measured widths (no collisions).
function kvLabel(x0, y) local(lw, vh) (
  gfx_setfont(3);
  gfx_measurestr(#klbl, lw, vh);
  xat(x0, y); colInk(1); gfx_drawstr(#klbl);
  xat(x0 + lw + 6, y); colAcid(1); gfx_drawstr(#kval);
);

/* ---------- Dual EQ slider under each effect unit ----------
   Logarithmic scale 20 Hz .. 20 kHz: f = 20*1000^t, t = eqT(hz).
   Left edge = lowcut (snaps to OFF/0 Hz), right = highcut (OFF/
   20 kHz). Right-click = factory setting. eqT and the way back in
   fxEqVal must be mirror images, otherwise the handle jumps.        */
function eqT(hz) ( min(1, max(0, log(max(20, hz)*0.05)*0.144764827)); );

// Compact frequency display in #vstr
function hzTxt(hz) (
  hz <= 0 || hz >= 20000 ? sprintf(#vstr, "OFF")
  : hz >= 9950 ? sprintf(#vstr, "%dk", floor(hz*0.001 + 0.5))
  : hz >= 1000 ? sprintf(#vstr, "%.1fk", hz*0.001)
  : sprintf(#vstr, "%d", floor(hz + 0.5));
);

// Track of the strip; the area between the handles is the band that
// passes
function eqTrack(x, y, w, tLo, tHi) (
  gfx_set(0.092, 0.097, 0.092, 1); xrect(x, y, w, 6);
  tHi > tLo ? ( colAcid(0.30); xrect(x + tLo*w, y + 1, (tHi - tLo)*w, 4); );
);

// One handle (side 0 = lowcut left, 1 = highcut right); compute only,
// eqHandle draws. The travel factor is the strip width w — otherwise
// the handle does not follow the pointer. Shift = 5x fine.
function fxEqVal(id, x, y, w, hz, side, defHz)
  local(t, hot, nv, hx, sh) (
  t  = eqT(hz);
  hx = x + t*w;
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = mX >= hx - 8 && mX <= hx + 8 && mY >= y - 7 && mY <= y + 11;
  nv = hz;
  uiRClk && hot ? ( nv = defHz; )
  : uiClick && hot ? ( dragId = id; dragX = mX; dragT = t; dragSh = sh; );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh; dragX = mX; dragT = t; );
    t = min(1, max(0, dragT + (mX - dragX)/(sh ? w*5 : w)));
    nv = floor(20*1000^t + 0.5);
    side == 0 ? ( nv = t < 0.02 ? 0 : nv; ) : ( nv = t > 0.98 ? 20000 : nv; );
  ) : (
    hot && mouse_wheel != 0 ? (
      t = min(1, max(0, t + (mouse_wheel/120)*0.05));
      nv = floor(20*1000^t + 0.5);
      side == 0 ? ( nv = t < 0.02 ? 0 : nv; ) : ( nv = t > 0.98 ? 20000 : nv; );
      mouse_wheel = 0;
    );
  );
  nv;
);

// Draw the handle — separate from computing, otherwise the strip lags
// one frame behind the handle while dragging.
function eqHandle(id, x, y, w, hz) local(hx) (
  hx = x + eqT(hz)*w;
  dragId == id || (mX >= hx - 8 && mX <= hx + 8 && mY >= y - 7 && mY <= y + 11)
    ? colAcid(1) : gfx_set(0.17, 0.44, 0.12, 1);
  xrect(hx - 4, y - 4, 8, 14);
  gfx_set(0, 0, 0, 1); xrect(hx - 1, y, 2, 6);
);

// LO/HI label with frequency values under an EQ strip
function eqLabels(x, y, w, loHz, hiHz) local(a, b, c, d, x0) (
  gfx_setfont(3);
  hzTxt(loHz); gfx_measurestr(#vstr, a, b);
  gfx_measurestr("LO", c, d);
  xat(x, y); colInk(1); gfx_drawstr("LO");
  xat(x + c + 5, y); colAcid(0.85); gfx_drawstr(#vstr);
  hzTxt(hiHz); gfx_measurestr(#vstr, a, b);
  gfx_measurestr("HI", c, d);
  x0 = x + w - (a + 5 + c);
  xat(x0, y); colInk(1); gfx_drawstr("HI");
  xat(x0 + c + 5, y); colAcid(0.85); gfx_drawstr(#vstr);
);

// Note name, e.g. "C#2" — draws at the current text position
function noteName(n) local(k, o) (
  k = n - 12*floor(n/12); o = floor(n/12) - 1;
  k == 0 ? gfx_drawstr("C") : k == 1 ? gfx_drawstr("C#") : k == 2 ? gfx_drawstr("D")
  : k == 3 ? gfx_drawstr("D#") : k == 4 ? gfx_drawstr("E") : k == 5 ? gfx_drawstr("F")
  : k == 6 ? gfx_drawstr("F#") : k == 7 ? gfx_drawstr("G") : k == 8 ? gfx_drawstr("G#")
  : k == 9 ? gfx_drawstr("A") : k == 10 ? gfx_drawstr("A#") : gfx_drawstr("B");
  gfx_printf("%d", o);
);

// Is this note currently in the stack? (for the keyboard display)
function noteHeld(n) local(i, r) (
  r = 0; i = 0;
  loop(stkN, M_STK[i] == n ? r = 1; i += 1; );
  r;
);

/* ---------- Sound presets ---------- */

function applyPatch(p) (
  p == 1 ? ( slider2 = 0; slider5 = 16; slider6 = 48; slider7 = 42; slider8 = 58;
             slider9 = 38; slider13 = 0; slider14 = 0; slider15 = 7;
             slider16 = 18; slider18 = 52; slider19 = 20; )                       // DEEP
  : p == 2 ? ( slider2 = 0; slider5 = 38; slider6 = 86; slider7 = 78; slider8 = 25;
               slider9 = 78; slider13 = 1; slider14 = 0; slider15 = 7;
               slider16 = 16; slider18 = 64; slider19 = 14; )                     // SQUELCH
  : p == 3 ? ( slider2 = 1; slider5 = 58; slider6 = 95; slider7 = 88; slider8 = 18;
               slider9 = 92; slider13 = 1; slider14 = 1; slider15 = 18;
               slider16 = 10; slider18 = 58; slider19 = 10; )                     // SCREAM
  : p == 4 ? ( slider2 = 1; slider5 = 64; slider6 = 72; slider7 = 92; slider8 = 68;
               slider9 = 72; slider13 = 1; slider14 = 2; slider15 = 11;
               slider16 = 22; slider18 = 68; slider19 = 22; )                     // HOOVER
  : p == 5 ? ( slider2 = 0; slider5 = 20; slider6 = 58; slider7 = 48; slider8 = 48;
               slider9 = 52; slider13 = 0; slider14 = 0; slider15 = 7;
               slider16 = 48; slider18 = 78; slider19 = 42; )                     // DUB
  : ( slider2 = 0; slider3 = 0; slider4 = 0;
      slider5 = 32; slider6 = 55; slider7 = 62; slider8 = 35;
      slider9 = 60; slider10 = 70; slider11 = 60;
      slider13 = 0; slider14 = 0; slider15 = 8;
      slider16 = 15; slider17 = 1; slider18 = 60; slider19 = 18; slider20 = 70;
      slider27 = 20; slider28 = 20000; slider29 = 300; slider30 = 2800;
      slider31 = 300; slider32 = 2500; slider34 = 1; slider35 = 100;
      slider_automate(slider3); slider_automate(slider4); slider_automate(slider10);
      slider_automate(slider34); slider_automate(slider35); );                      // INIT
  slider_automate(slider2);  slider_automate(slider5);  slider_automate(slider6);
  slider_automate(slider7);  slider_automate(slider8);  slider_automate(slider9);
  slider_automate(slider11); slider_automate(slider13); slider_automate(slider14);
  slider_automate(slider15); slider_automate(slider16); slider_automate(slider17);
  slider_automate(slider18); slider_automate(slider19); slider_automate(slider20);
  slider_automate(slider27); slider_automate(slider28); slider_automate(slider29);
  slider_automate(slider30); slider_automate(slider31); slider_automate(slider32);
  patchSel = p;
  paramsDirty = 1;
);

// Rebuild patchSel after loading — the state comes from the sliders
// themselves (REAPER stores them in the project), not from an extra
// serialised index. A patch counts as active if all sliders it sets
// match exactly; EQ/compressor trims (27-32, 34, 35) and SEQ/system
// sliders are free and do not invalidate a preset. No match -> -1 =
// custom (no button marked).
function matchPatchState() (
  patchSel =
    (slider2==0 && slider5==16 && slider6==48 && slider7==42 && slider8==58 &&
     slider9==38 && slider13==0 && slider14==0 && slider15==7 &&
     slider16==18 && slider18==52 && slider19==20) ? 1
  : (slider2==0 && slider5==38 && slider6==86 && slider7==78 && slider8==25 &&
     slider9==78 && slider13==1 && slider14==0 && slider15==7 &&
     slider16==16 && slider18==64 && slider19==14) ? 2
  : (slider2==1 && slider5==58 && slider6==95 && slider7==88 && slider8==18 &&
     slider9==92 && slider13==1 && slider14==1 && slider15==18 &&
     slider16==10 && slider18==58 && slider19==10) ? 3
  : (slider2==1 && slider5==64 && slider6==72 && slider7==92 && slider8==68 &&
     slider9==72 && slider13==1 && slider14==2 && slider15==11 &&
     slider16==22 && slider18==68 && slider19==22) ? 4
  : (slider2==0 && slider5==20 && slider6==58 && slider7==48 && slider8==48 &&
     slider9==52 && slider13==0 && slider14==0 && slider15==7 &&
     slider16==48 && slider18==78 && slider19==42) ? 5
  : (slider2==0 && slider3==0 && slider4==0 && slider5==32 && slider6==55 &&
     slider7==62 && slider8==35 && slider9==60 && slider10==70 &&
     slider11==60 && slider13==0 && slider14==0 && slider15==8 &&
     slider16==15 && slider17==1 && slider18==60 && slider19==18 &&
     slider20==70) ? 0
  : -1;
);

/* ---------- Base state ---------- */

readSliders();

// Two memsets: the pattern gap stays untouched.
memset(0, 0, M_SEQ);
memset(M_SEQEND, 0, MEMTOP - M_SEQEND);

// Freeverb: 8 combs + 4 allpasses per channel, lengths scale with srate
M_PAR[16] = ceil(1116*rvSc); M_PAR[17] = ceil(1188*rvSc);
M_PAR[18] = ceil(1277*rvSc); M_PAR[19] = ceil(1356*rvSc);
M_PAR[20] = ceil(1422*rvSc); M_PAR[21] = ceil(1491*rvSc);
M_PAR[22] = ceil(1557*rvSc); M_PAR[23] = ceil(1617*rvSc);
i = 0; loop(8, M_PAR[24+i] = M_PAR[16+i] + rvSpread; i += 1; );
p = 0;
i = 0; loop(8, M_PAR[i]   = p; p += M_PAR[16+i]; i += 1; );
i = 0; loop(8, M_PAR[8+i] = p; p += M_PAR[24+i]; i += 1; );
M_PAR[72] = ceil(556*rvSc); M_PAR[73] = ceil(441*rvSc);
M_PAR[74] = ceil(341*rvSc); M_PAR[75] = ceil(225*rvSc);
i = 0; loop(4, M_PAR[76+i] = M_PAR[72+i] + rvSpread; i += 1; );
i = 0; loop(4, M_PAR[64+i] = p; p += M_PAR[72+i]; i += 1; );
i = 0; loop(4, M_PAR[68+i] = p; p += M_PAR[76+i]; i += 1; );

updateParams();

// Start pattern only the very first time — after that this holds either
// the banks you built or those loaded from the project.
patInit != 1 ? ( defaultPattern(); patInit = 1; );

// Voice
stkN = 0; gateHeld = 0; envStage = 0; amp = 0; peakAmp = 0.5;
accCap = 0; sliding = 0; slideTgt = 0; slideCoef = 0; noteCur = 36;
curLog = log(65.406); phase = 0;
mEnv = 0; accOn = 0; accVca = 0; noteAcc = 0;
s1 = 0; s2 = 0; s3 = 0; s4 = 0; y4prev = 0;
oscHpY = 0; oscHpX = 0; sqHpY = 0; sqHpX = 0; fbHpY = 0; fbHpX = 0;
// Effect state
envDb = -100; dlyPos = 0; prePos = 0;
hpY = 0; hpPrev = 0; lpL = 0; lpR = 0;
dHpY = 0; dHpX = 0; dLpY = 0; dlyLpY = 0;    // FX input EQs
dPrevIn = 0; dsPrev = 0;                     // drive oversampling
dShA = 0; dShB = 0;                          // drive tilt states
rvHpY = 0; rvHpX = 0; rvLpY = 0;
rhpL = 0; rhpXL = 0; rlpL = 0; rhpR = 0; rhpXR = 0; rlpR = 0;
scopePos = 0; accentLed = 0; bpmNow = 120;
dlySamps = min(dlyBufLen - 4, 0.75*(60/120)*srate);
// Sequencing
evN = 0; evRd = 0; smplPos = 0; paramsDirty = 0;
seqHeld = -1; prevSlide = 0; gateLeft = 0; lastStep = -1; seqPos = 0;
curStepDisp = 0; seqTrans = 0; midiHeld = 0; seqRunning = 0; modePrev = -1; hostWasPlaying = 0;
stepSamps = srate*0.125; stepInc = 1/stepSamps;
// Surface
SC = 1; OX = 0; OY = 0; mX = -1; mY = -1;
dragId = -1; dragX = 0; dragY = 0; dragV = 0; dragT = 0; dragSh = 0;
bigSel = 0;
paintRow = -1; lmbPrev = 0; rmbPrev = 0;
monoSel = 0; sansSel = 0; fontChk = 0; copyArm = 0;
fBigP = -1; fMedP = -1; fSmlP = -1;
clickId = -1; clickWait = 0;
// Only on the first load: @init also runs on every transport start, and
// M_UNDO sits in the memset gap on purpose — without this lock UNDO and
// the preset display would be reset after every play.
uiInit != 1 ? ( patchSel = 0; undoArm = 0; undoBank = 0; uiInit = 1; );
// @init has discarded seqHeld; whatever still sounds at SEQ OUT (e.g.
// play pressed out of FREE RUN) is ended by the next @block.
soutFlush = 1;
poleFcPrev = -1; osA = 0; osB = 0;
oA1 = 0; oB1 = 0; oB2 = 0; oB3 = 0; scopeDiv = 0;
rvbWas = rvbMix > 0.005;      // state of the reverb bypass, see @sample
gTan = 0; G1 = 0; G2 = 0; G3 = 0; G4 = 0;

/* ============================================================
   @serialize — all four banks travel into the project and presets
   ============================================================ */
@serialize

seqVer = 2;
file_var(0, seqVer);
file_mem(0, M_SEQ, 4*SEQ_BANK);
// Runs in both directions. When writing it is a no-op because the
// values are valid anyway; when reading it catches damaged or foreign
// data. Future format changes belong here via seqVer.
validateBanks();
patInit = 1;
// The slider state is loaded at this point -> derive the preset marker
// from it (a no-op when writing, because patchSel is correct anyway).
matchPatchState();

/* ============================================================
   @slider
   ============================================================ */
@slider

readSliders();
updateParams();

/* ============================================================
   @block — transport, clocking, collecting MIDI
   ============================================================ */
@block

// First: seqRelease() may already send a note-off here (stop, mode
// change); with the old smplPos (= length of the PREVIOUS block) its
// offset would lie behind the block end.
smplPos = 0;

paramsDirty ? ( readSliders(); updateParams(); paramsDirty = 0; );

soutFlush ? (
  soI = 0;
  loop(128, M_SOUT[soI] ? ( midisend(0, 0x80, soI, 0); M_SOUT[soI] = 0; ); soI += 1; );
  soutFlush = 0;
);

bpmNow    = tempo > 10 ? tempo : 120;
stepSamps = max(16, srate*15/bpmNow);        // a 16th in samples
stepInc   = 1/stepSamps;
dlySamps  = min(dlyBufLen - 4, (60/bpmNow)*dlyDiv*srate);

// Catch mode changes cleanly
seqMode != modePrev ? (
  modePrev = seqMode;
  seqRelease(); allOff(); clearHeld();
  lastStep = -1; prevSlide = 0;
);

hostPlay = play_state & 1;
// HOST: the edge play -> stop/pause releases held notes (replacement
// for lost note-offs). HOST only — live playing while stopped and
// SEQ/FREE RUN keep running independently of the transport.
hostWasPlaying && !hostPlay && !seqMode ? allOff();
hostWasPlaying = hostPlay;
seqWant  = seqMode && (hostPlay || freeRun);
seqWant != seqRunning ? (
  seqRunning = seqWant;
  seqRunning ? (
    prevSlide = 0;
    hostPlay ? ( seqPos = beat_position*4; ) : ( seqPos = 0; );
    lastStep = floor(seqPos) - 1;             // step under the cursor fires
  ) : ( seqRelease(); );
);
// Follow the timeline, but only correct on a real offset (loop jump,
// position change, tempo). Hard setting per block caused double-fired
// or dropped steps because beat_position rounds. 0.02 steps = 2.3 ms at
// 130 BPM.
// Loop jump by whole pattern lengths: rebook phase-true, do NOT fire
// again. seqPos is incremented before the check, so the step at the
// loop end often fires in the last sample before the wrap; firing it
// again would double the accent and send note-on/off/on at SEQ OUT.
// Real jump: the step under the cursor fires, unless it is already
// running (correction within a step).
seqRunning && hostPlay ? (
  tgtPos = beat_position*4;
  dPos = tgtPos - seqPos;
  abs(dPos) > 0.02 ? (
    dWrap = patLen*floor(dPos/patLen + 0.5);
    dWrap != 0 && abs(dPos - dWrap) <= 0.02 ? (
      seqPos += dWrap; lastStep += dWrap;
    ) : (
      seqPos = tgtPos;
      floor(seqPos) != lastStep ? lastStep = floor(seqPos) - 1;
    );
  );
);

// MIDI with offset into the queue, triggering happens sample-accurately in @sample
evN = 0; evRd = 0;
while (midirecv(offs, m1, m2, m3)) (
  evN < EVT_MAX ? (
    M_EVT[evN*4] = offs;   M_EVT[evN*4+1] = m1;
    M_EVT[evN*4+2] = m2;   M_EVT[evN*4+3] = m3;
    evN += 1;
  ) : ( handleMidi(m1, m2, m3); );
  // Instrument: notes are consumed. CC/pitchbend/clock keep going.
  stThru = m1 & 0xF0;
  midiThru ? midisend(offs, m1, m2, m3)
           : ( stThru != 0x80 && stThru != 0x90 ? midisend(offs, m1, m2, m3) );
);

// --- Pattern export to the companion ReaScript tt303_pattern_to_midi.lua:
// the DISPLAYED bank raw into gmem.
gmem[0] = 30303;                     // handshake / magic
gmem[1] = 1;                         // layout version
gmem[2] = gmem[2] + 1;               // heartbeat: running instance
gmem[3] = floor(slider25);           // displayed bank 0..3 (A..D)
gmem[4] = slider21;                  // SEQ pattern length, raw (script clamps 1..16)
gmem[5] = slider23;                  // global SEQ GATE % (non-slide steps)
gmem[6] = slider22;                  // SEQ SHUFFLE %
gmem[7] = 36;                        // note number of the original pitch (C2)
exBase = floor(slider25)*SEQ_BANK;
exI = 0;
loop(64,
  gmem[8 + exI] = M_SEQ[exBase + exI];
  exI += 1;
);

// --- State handoff via gmem: REAPER stores FX states per file path, so
// a newly inserted instance from a differently named file starts with
// defaults. A fresh instance (all sliders at their header defaults) takes
// over the state last exported in this session, once. Import before the
// own export, otherwise we would overwrite the donor.
// Limits: gmem is session-only (empty after a REAPER restart — then the
// project state applies as usual) and global across all instances
// (with several TT-303 in parallel the last export wins).
stDone != 1 ? (
  stDone = 1;
  stFresh = slider1==0 && slider2==0 && slider3==0 && slider4==0 &&
    slider5==32 && slider6==55 && slider7==62 && slider8==35 &&
    slider9==60 && slider10==70 && slider11==60 && slider12==100 &&
    slider13==0 && slider14==0 && slider15==8 && slider16==15 &&
    slider17==1 && slider18==60 && slider19==18 && slider20==70 &&
    slider21==16 && slider22==0 && slider23==55 && slider24==0 &&
    slider25==0 && slider26==0 && slider27==20 && slider28==20000 &&
    slider29==300 && slider30==2800 && slider31==300 && slider32==2500 &&
    slider33==0 && slider34==1 && slider35==100;
  stFresh && gmem[200] == 30307 && gmem[201] == 1 ? (
    stI = 1; loop(35, slider(stI) = gmem[201 + stI]; stI += 1; );
    paramsDirty = 1; matchPatchState();
  );
);
// export the own state (area 200-236, the bridge uses 0-71).
gmem[200] = 30307; gmem[201] = 1;
stI = 1; loop(35, gmem[201 + stI] = slider(stI); stI += 1; );

/* ============================================================
   @sample — one voice, signal path as in the hardware
   ============================================================ */
@sample

// --- due MIDI events
while (evRd < evN && M_EVT[evRd*4] <= smplPos) (
  handleMidi(M_EVT[evRd*4+1], M_EVT[evRd*4+2], M_EVT[evRd*4+3]);
  evRd += 1;
);

// --- Sequencer clock. With shuffle, odd steps move back.
seqRunning ? (
  seqPos += stepInc;
  stepIdx = floor(seqPos);
  sFrac = seqPos - stepIdx;
  ((stepIdx & 1) ? sFrac >= swFrac : 1) && stepIdx != lastStep ? (
    lastStep = stepIdx;
    seqFire(stepIdx - patLen*floor(stepIdx/patLen));
  );
  gateLeft > 0 ? ( gateLeft -= 1; gateLeft <= 0 ? seqRelease(); );
);

// --- Slide: RC approach in log frequency space (capacitor recharge).
sliding ? (
  curLog += (slideTgt - curLog)*slideCoef;
  // stop when the rest is below one cent (ln(2)/1200 = 0.000578)
  abs(slideTgt - curLog) < 0.0005 ? ( curLog = slideTgt; sliding = 0; );
);
freq = exp(curLog + tuneLog);

// --- Envelopes and accent network (after Whittle). The MEG (mEnv)
//     drives the filter directly; via the accent switch it feeds two
//     extra paths: the sweep capacitor (charges via diode+R, discharges
//     via the pot wiper) and the smoothed accent VCA path (47k x 0.033 uF).
//     accSrc uses a minimum feed of 0.55 for tied accents — pure MEG
//     coupling (floor 0) would make tied accents practically silent.
mEnv *= (noteAcc ? mDecAcc : mDecC);   // decay control acts continuously
accSrc = accOn*gateHeld*max(mEnv, 0.55);  // pulses only while the gate is up
accOn ? accCap += (accSrc - accCap)*accChgC
      : (accCap *= accDisC);
// VCA accent path: while the gate is held it follows accSrc with 1.55 ms
// (47k x 0.033 uF); after the gate it decays on its own with ~40 ms —
// the audible accent tail of the original.
gateHeld ? accVca += (accSrc - accVca)*accVcaC
      : (accVca *= exp(-1/(0.04*srate)));
// ACW: direct pulse (MEG copy); CW: smoothed cap curve
accDrv = accN*(0.55 + 2.55*resN)*(0.92 + 0.08*cutN)
         * ((1 - resN)*accSrc + resN*accCap);
fc = baseF*exp((envOct*mEnv + accDrv)*0.6931472);
fc = min(fcMax, max(30, fc));

// --- VCA: VEG (amp) and accent contribution separately
envStage == 1 ? (
  amp += attInc;
  (attInc >= 0 ? amp >= peakAmp : amp <= peakAmp) ? ( amp = peakAmp; envStage = 2; );
);
// Fast sag phase down to 45 % of the peak (tau 20 ms), then slow
// sustain decay (peak:body ~4:1).
envStage == 2 ? amp *= (amp > 0.45*peakAmp ? sagCoef : susCoef);
envStage == 3 ? ( amp *= relCoef; amp < 0.00002 ? ( amp = 0; envStage = 0; ); );
vcaGain = amp + accN*0.45*accVca;

needVoice = amp > 0.00002 || stkN > 0 || envStage > 0 || sliding
          || accVca > 0.0001;

// The VCO keeps running freely — the hardware has no oscillator reset
// on the gate; a frozen phase would be the same on every note.
phaseInc = min(max(freq, 8), 0.45*SRX)/SRX;   // step per OS sub-sample
phase += 2*phaseInc; phase -= floor(phase);
phA = phase - phaseInc; phA < 0 ? phA += 1;   // middle of the host period

needVoice ? (
  // Four TPT one-pole stages at the poles of the idealised TB-303
  // diode ladder denominator (Stinchcombe, C1 = C/2):
  //   s^4 + 2^(11/4)s^3 + 10*sqrt(2)s^2 + 2^(13/4)s + 1
  // A cascade of single poles at the same positions gives exactly the
  // same open transfer function.
  // Coefficients are cached by the actual pole (fc*poleScale).
  poleFc = fc*poleScale;
  abs(poleFc - poleFcPrev) > poleFc*0.00015 ? (
    poleFcPrev = poleFc;
    gTan = tan(min(1.5, $pi*poleFc*0.1280189/SRX)); G1 = gTan/(1+gTan);
    gTan = tan(min(1.5, $pi*poleFc*1.0381986/SRX)); G2 = gTan/(1+gTan);
    gTan = tan(min(1.5, $pi*poleFc*2.3253871/SRX)); G3 = gTan/(1+gTan);
    gTan = tan(min(1.5, $pi*poleFc*3.2355668/SRX)); G4 = gTan/(1+gTan);
  );
  // Square: pitch-dependent — duty ~0.5*sqrt(85 Hz/f), ~50 % at ~85 Hz,
  // narrower above (after Burnett).
  // A lower level than saw excites the filter resonance differently.
  sqDuty = waveSel ? min(0.72, max(0.10, 0.5*sqrt(85/max(freq, 20)))) : 0.5;
  osA = 0; osB = 0; osi = 0;
  loop(2,
    ph = osi == 0 ? phA : phase;
    waveSel ? (
      // second edge at ph = sqDuty, i.e. (ph - sqDuty) mod 1
      tp = ph + (1 - sqDuty); tp -= floor(tp);
      sqRaw = (ph < sqDuty ? 1 : -1)
            + polyBlep(ph, phaseInc) - polyBlep(tp, phaseInc);
      sqHpY = sqHpA*(sqHpY + sqRaw - sqHpX); sqHpX = sqRaw;
      oscv = softSat(sqHpY*1.8)*0.5;   // overdriven stage, small level
    ) : (
      oscv = 2*ph - 1 - polyBlep(ph, phaseInc);
    );
    oscHpY = oscHpA*(oscHpY + oscv - oscHpX); oscHpX = oscv;
    xin = softSat(oscHpY*0.8);

    // Level-dependent feedback: belongs INSIDE the oversampling, otherwise
    // the second pass computes with the value from the previous sample.
    kEff = kRes/(1 + 0.4*abs(y4prev));

    // High-pass IN the feedback path. Its share is affine in y4,
    // so the loop stays solvable without delay:
    //   u  = xin - fbHp(kEff*y4) = (xin - fbC) - fbHpA*kEff*y4
    //   y4 = A*u + B   ->   y4 = (A*(xin - fbC) + B)/(1 + A*fbHpA*kEff)
    fbC = fbHpA*(fbHpY - fbHpX);
    B   = G4*G3*G2*(1 - G1)*s1 + G4*G3*(1 - G2)*s2
        + G4*(1 - G3)*s3 + (1 - G4)*s4;
    A   = G1*G2*G3*G4;
    y4  = (A*(xin - fbC) + B)/(1 + A*fbHpA*kEff);
    fbI = kEff*y4;
    fbHpY = fbHpA*(fbHpY + fbI - fbHpX); fbHpX = fbI;
    u = xin - fbHpY;

    v = (u  - s1)*G1; o1 = v + s1; s1 = o1 + v;
    v = (o1 - s2)*G2; o2 = v + s2; s2 = o2 + v;
    v = (o2 - s3)*G3; o3 = v + s3; s3 = o3 + v;
    v = (o3 - s4)*G4; o4 = v + s4; s4 = o4 + v;
    y4prev = o4;
    osi == 0 ? osA = o4 : osB = o4;
    osi += 1;
  );
  // 7-tap half-band decimation [-1/32, 0, 9/32, 1/2, 9/32, 0, -1/32]:
  // zero at the OS Nyquist frequency and a much wider stop band than
  // 1/4-1/2-1/4. Latency 1.5 host samples.
  voice = (0.5*oA1 + 0.28125*(oB1 + oB2) - 0.03125*(osB + oB3))
          * resMakeUp * vcaGain;
  oA1 = osA; oB3 = oB2; oB2 = oB1; oB1 = osB;
) : (
  // Voice asleep: let the states decay instead of freezing them — amp
  // acts behind the filter, the ladder keeps ringing at high resonance;
  // frozen, that would click on the next note.
  voice = 0;
  s1 *= 0.99; s2 *= 0.99; s3 *= 0.99; s4 *= 0.99;
  fbHpX *= 0.99; fbHpY *= 0.99; y4prev *= 0.99;
  oscHpX *= 0.99; oscHpY *= 0.99; sqHpX *= 0.99; sqHpY *= 0.99;
  oA1 *= 0.5; oB1 *= 0.5; oB2 *= 0.5; oB3 *= 0.5;
);

// --- Drive: EQ selects the band to distort. dBand goes into the
// WaveShaper, dRest (= dIn - dBand) passes undistorted. The sum is
// exactly the input signal — bypass bit-exact transparent, EQ or not.
// Lowcut takes the bass out of the distortion, not out of the output.
dIn   = voice;
dBand = dIn;
eqDLoOn ? ( dHpY = eqDLoA*(dHpY + dBand - dHpX); dHpX = dBand; dBand = dHpY; )
        : ( dHpY = dBand; dHpX = dBand; );
eqDHiOn ? ( dLpY += eqDHiG*(dBand - dLpY); dBand = dLpY; )
        : ( dLpY = dBand; );
dRest = dIn - dBand;

// WaveShaper 2x OS (linear midpoint + 1/4-1/2-1/4 decimation).
// The chain runs half a sample period behind dRest (<0.1 dB
// sum error with one-pole EQs; with EQ off dRest is exactly 0).
fxDistOn ? (
  dMid  = 0.5*(dPrevIn + dBand); dPrevIn = dBand;
  // Presence tilt into the shaper input (states dShA/dShB follow the
  // signal in bypass too — no jump when switching on).
  dShA += dShG*(dMid  - dShA);
  dShB += dShG*(dBand - dShB);
  dsA   = distProc((dShA + 2.6*(dMid  - dShA))*distPreG)*distPostG;
  dsB   = distProc((dShB + 2.6*(dBand - dShB))*distPreG)*distPostG;
  dy    = 0.25*dsPrev + 0.5*dsA + 0.25*dsB + dRest;
  dsPrev = dsB;
) : (
  // Bypass is true unity — dBand + dRest is dIn again.
  dy = dIn;
  dPrevIn = dBand; dsPrev *= 0.5;
  dShA = dBand; dShB = dBand;
);

// --- Ping-pong delay (fully bypassed at mix < 0.5 %)
dlyMix > 0.005 ? (
  dlyIn = dy;
  eqYLoOn ? ( hpY = eqYLoA*(hpY + dlyIn - hpPrev); hpPrev = dlyIn; dlyIn = hpY; ) : ( hpY = dlyIn; hpPrev = dlyIn; );
  eqYHiOn ? ( dlyLpY += eqYHiG*(dlyIn - dlyLpY); dlyIn = dlyLpY; ) : ( dlyLpY = dlyIn; );
  rp = dlyPos - floor(dlySamps); rp < 0 ? rp += dlyBufLen;
  i2 = rp - 1; i2 < 0 ? i2 += dlyBufLen;
  fr = dlySamps - floor(dlySamps);
  dl = M_DLY1[rp]*(1 - fr) + M_DLY1[i2]*fr;
  dr = M_DLY2[rp]*(1 - fr) + M_DLY2[i2]*fr;
  lpL += lpG24*(dl - lpL);
  lpR += lpG24*(dr - lpR);
  M_DLY1[dlyPos] = dlyIn + dlyFb2*lpR;
  M_DLY2[dlyPos] = lpL;
  dlyPos += 1; dlyPos >= dlyBufLen ? dlyPos = 0;
  wetDL = lpL*dlyMix;
  wetDR = lpR*dlyMix;
 ) : (
  wetDL = 0; wetDR = 0;
  lpL *= 0.995; lpR *= 0.995; dlyLpY *= 0.995;
  // Carry the HP state along (otherwise a DC step = pop when switching
  // back on); the write pointer keeps storing silence — no old buffer
  // content when switching on.
  hpPrev = dy; hpY *= 0.995;
  M_DLY1[dlyPos] = 0; M_DLY2[dlyPos] = 0;
  dlyPos += 1; dlyPos >= dlyBufLen ? dlyPos = 0;
);

// --- Reverb (bypassed at mix < 0.5 %). When switching off, clear
// buffers/indices once — otherwise old content comes back when turning
// it up again. One-off memset (~220 kB) within one sample period.
rvbOn = rvbMix > 0.005;
rvbOn != rvbWas ? (
  rvbWas = rvbOn;
  !rvbOn ? (
    memset(M_PRE, 0, 8192);
    memset(M_RVB, 0, rvbTotal);
    ri = 48; loop(16, M_PAR[ri] = 0; ri += 1; );   // comb damping memory
    prePos = 0;
    ri = 32; loop(16, M_PAR[ri] = 0; ri += 1; );   // comb read indices
    ri = 80; loop(8,  M_PAR[ri] = 0; ri += 1; );   // allpass read indices
    rvHpX = 0; rvHpY = 0; rvLpY = 0;
    rhpL = 0; rhpR = 0; rhpXL = 0; rhpXR = 0; rlpL = 0; rlpR = 0;
  );
);
rvbOn ? (
  rvIn = dy + (wetDL + wetDR)*0.5;
  eqRLoOn ? ( rvHpY = eqRLoA*(rvHpY + rvIn - rvHpX); rvHpX = rvIn; rvIn = rvHpY; ) : ( rvHpY = rvIn; rvHpX = rvIn; );
  eqRHiOn ? ( rvLpY += eqRHiG*(rvIn - rvLpY); rvIn = rvLpY; ) : ( rvLpY = rvIn; );
  M_PRE[prePos] = rvIn;
  prePos += 1; prePos >= preLen ? prePos = 0;
  rvbX = M_PRE[prePos];
  sum1 = 0; sum2 = 0;
  i = 0;
  loop(8,
    sum1 += combProc(i, rvbX);
    sum2 += combProc(i + 8, rvbX);
    i += 1;
  );
  w1 = sum1*0.015; w2 = sum2*0.015;
  i = 0;
  loop(4,
    w1 = apProc(i, w1);
    w2 = apProc(i + 4, w2);
    i += 1;
  );
  rhpL = rhpA*(rhpL + w1 - rhpXL); rhpXL = w1;
  rhpR = rhpA*(rhpR + w2 - rhpXR); rhpXR = w2;
  rlpL += rlpG*(rhpL - rlpL);
  rlpR += rlpG*(rhpR - rlpR);
);

// --- Compressor on dry only, then add delay/reverb (303 punch stays)
lv = abs(dy);
db = 20*log(lv + 0.00000001)*0.43429448;
db > envDb ? ( envDb += (db - envDb)*cAtk; ) : ( envDb += (db - envDb)*cRel; );
over = envDb + 14;
k15 = min(30, max(0, over + 15));
gr = -0.8*(k15*k15/60 + max(0, over - 15));
cg = 10^(gr/20)*1.78;
// compOn=0: dry unprocessed incl. ~+5 dB make-up 1.78 (compensate
// VOLUME). compMix blends dy <-> dy*cg; envDb/cg always run along
// -> click-free.
dry = compOn ? dy*(1 + compMix*(cg - 1)) : dy;
sumL = dry + wetDL + rlpL*rvbMix;
sumR = dry + wetDR + rlpR*rvbMix;
spl0 = min(1, max(-1, softClip(sumL*volG*outMk)));
spl1 = min(1, max(-1, softClip(sumR*volG*outMk)));

// --- Oscilloscope (every 2nd sample is enough at gfx 45 Hz)
scopeDiv ? (
  M_SCOPE[scopePos] = (spl0 + spl1)*0.5;
  scopePos += 1; scopePos >= 512 ? scopePos = 0;
);
scopeDiv = 1 - scopeDiv;

// Count smplPos up here -> the MIDI output offset is sample-accurate.
smplPos += 1;

/* ============================================================
   @gfx — device front after the Tim Techlor design kit
   Core Black as the base, Acid Green as the only accent colour,
   Core White only for pointers and keyboard. Traces at a
   45 degree angle end in solder pads and structure the layout.
   Drawn in the 900 x 732 grid, SC scales to the window.
   ============================================================ */
@gfx 1120 912

// ---------- Scale ----------
SC = min(gfx_w/UI_W, gfx_h/UI_H);
SC = max(0.25, SC);    // only an emergency brake against SC = 0
OX = (gfx_w - UI_W*SC)*0.5;
OY = (gfx_h - UI_H*SC)*0.5;
mX = (mouse_x - OX)/SC;
mY = (mouse_y - OY)/SC;

/* ---------- Fonts ----------
   Sans-serif for labels, monospaced for numbers (no jitter while
   turning). Availability test: measure against a font that is
   guaranteed to be missing — same size = not installed (otherwise
   the GDI fallback silently catches the test).

     1  wordmark      Zilap Orion, else sans-serif bold
     2  sans-serif    medium      3  sans-serif    small
     4  monospaced    medium      5  monospaced    small               */

fontChk == 0 ? (
  fontChk = 1;
  gfx_setfont(9, "TT303NoSuchFace", 16);
  gfx_measurestr("HAMBURGEFONSIV", refW, refH);
  gfx_measurestr("M", refM, refH2);

  sansSel = -1;
  sansSel < 0 ? ( gfx_setfont(9, "Segoe UI", 16);        gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 0; );
  sansSel < 0 ? ( gfx_setfont(9, "Helvetica Neue", 16);  gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 1; );
  sansSel < 0 ? ( gfx_setfont(9, "DejaVu Sans", 16);     gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 2; );
  sansSel < 0 ? ( gfx_setfont(9, "Liberation Sans", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 3; );
  sansSel < 0 ? sansSel = 4;                 // last resort: Arial

  // monospaced: must be present AND really fixed-width
  monoSel = -1;
  monoSel < 0 ? ( gfx_setfont(9, "Consolas", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 0; );
  monoSel < 0 ? ( gfx_setfont(9, "DejaVu Sans Mono", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 1; );
  monoSel < 0 ? ( gfx_setfont(9, "Menlo", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 2; );
  monoSel < 0 ? monoSel = 3;                 // last resort: Courier New

  // house font for the wordmark only if it is really there
  gfx_setfont(9, "Zilap Orion", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
  bigSel = (tw1 != refW || th1 != refH);
);

// Sizes grow with the window.
fBig = max(12, floor(38*SC));
fMed = max(10, floor(16*SC));
fSml = max(9,  floor(13*SC));

(fBig != fBigP || fMed != fMedP || fSml != fSmlP) ? (
  fBigP = fBig; fMedP = fMed; fSmlP = fSml;
  bigSel ? gfx_setfont(1, "Zilap Orion", fBig, 'b')
  : sansSel == 0 ? gfx_setfont(1, "Segoe UI", fBig, 'b')
  : sansSel == 1 ? gfx_setfont(1, "Helvetica Neue", fBig, 'b')
  : sansSel == 2 ? gfx_setfont(1, "DejaVu Sans", fBig, 'b')
  : sansSel == 3 ? gfx_setfont(1, "Liberation Sans", fBig, 'b')
  : gfx_setfont(1, "Arial", fBig, 'b');
  sansSel == 0 ? ( gfx_setfont(2, "Segoe UI", fMed);        gfx_setfont(3, "Segoe UI", fSml); )
  : sansSel == 1 ? ( gfx_setfont(2, "Helvetica Neue", fMed);  gfx_setfont(3, "Helvetica Neue", fSml); )
  : sansSel == 2 ? ( gfx_setfont(2, "DejaVu Sans", fMed);     gfx_setfont(3, "DejaVu Sans", fSml); )
  : sansSel == 3 ? ( gfx_setfont(2, "Liberation Sans", fMed); gfx_setfont(3, "Liberation Sans", fSml); )
  : ( gfx_setfont(2, "Arial", fMed); gfx_setfont(3, "Arial", fSml); );
  monoSel == 0 ? ( gfx_setfont(4, "Consolas", fMed);         gfx_setfont(5, "Consolas", fSml); )
  : monoSel == 1 ? ( gfx_setfont(4, "DejaVu Sans Mono", fMed); gfx_setfont(5, "DejaVu Sans Mono", fSml); )
  : monoSel == 2 ? ( gfx_setfont(4, "Menlo", fMed);            gfx_setfont(5, "Menlo", fSml); )
  : ( gfx_setfont(4, "Courier New", fMed); gfx_setfont(5, "Courier New", fSml); );
);

// Mouse state: click as an edge so switches do not fire continuously
uiLmb   = mouse_cap & 1;
uiClick = uiLmb && !lmbPrev;
uiRClk  = (mouse_cap & 2) && !rmbPrev;
!uiLmb ? ( dragId = -1; );
!uiLmb ? ( paintRow = -1; );
clickWait > 0 ? clickWait -= 1;

accentLed *= 0.88;

// ---------- Background ----------
gfx_set(0.050, 0.054, 0.050, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

// ---------- Header ----------
gfx_setfont(1);
colAcid(1);
xstr(24, 8, "TT-303");
// Version badge to the right of the title (small font, on the title baseline)
gfx_measurestr("TT-303", hdrTW, hdrTH);
gfx_setfont(3);
gfx_measurestr("v1.07", hdrVW, hdrVH);
colInk(1);
gfx_x = OX + 24*SC + hdrTW + 10*SC;
gfx_y = OY + 8*SC + hdrTH - hdrVH - 1*SC;
gfx_drawstr("v1.07");
gfx_setfont(3);
colInk(1);
xstr(26, 48, "ACID MACHINE // TIM TECHLOR // MONO BASS SYNTHESIZER");

trace(212, 20, 320, 60);
trace(320, 20, 448, 60);
pad(212, 20, 4); pad(320, 20, 4);
pad(320, 60, 3); pad(448, 60, 3);
colDim(1); xline(0, 70, UI_W, 70);
colAcid(1); xrect(0, 70, 232, 1);

// Accent display (charge of the accent capacitor)
colInk(1); xstr(500, 22, "ACCENT");
gfx_set(0.11, 0.13, 0.11, 1); xrect(500, 38, 64, 8);
ledA = min(1, max(accentLed, accCap*0.6));
gfx_set(0.224*ledA, 1*ledA, 0.078*ledA, 1);
ledA > 0.01 ? xrect(501, 39, 62*ledA, 6);

// Operating mode + MIDI thru
colInk(1); xstr(572, 20, "MIDI");
gfx_setfont(2);
btn(572, 32, 70, 26, slider33 == 1, "THRU") ? ( slider33 = 1 - slider33; slider_automate(slider33); paramsDirty = 1; );
gfx_setfont(3);
colInk(1); xstr(726, 20, "MODE");
gfx_setfont(2);
btn(726, 32, 74, 26, slider1 == 0, "HOST") ? ( slider1 = 0; slider_automate(slider1); paramsDirty = 1; );
btn(804, 32, 74, 26, slider1 == 1, "SEQ")  ? ( slider1 = 1; slider_automate(slider1); paramsDirty = 1; );

/* ---------- Panel SYNTHESIZER ---------- */
panelBox(14, 78, 872, 148);
gfx_setfont(3);
colAcid(1); xstr(26, 84, "SYNTHESIZER");
colInk(1);  xstr(26, 98, "VCO / VCF 24 dB / VCA");

btn(460, 82, 66, 18, patchSel == 0, "INIT") ? applyPatch(0);
btn(530, 82, 66, 18, patchSel == 1, "DEEP") ? applyPatch(1);
btn(600, 82, 66, 18, patchSel == 2, "SQCH") ? applyPatch(2);
btn(670, 82, 66, 18, patchSel == 3, "SCRM") ? applyPatch(3);
btn(740, 82, 66, 18, patchSel == 4, "HOOV") ? applyPatch(4);
btn(810, 82, 66, 18, patchSel == 5, "DUB")  ? applyPatch(5);

// --- Knobs
nv = floor(knob(1, 60, 152, 27, slider3, -24, 24) + 0.5);
nv != slider3 ? ( slider3 = nv; slider_automate(slider3); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(2, 158, 152, 27, slider4, -50, 50) + 0.5);
nv != slider4 ? ( slider4 = nv; slider_automate(slider4); paramsDirty = 1; patchSel = -1; );
nv = knob(3, 256, 152, 27, slider5, 0, 100);
nv != slider5 ? ( slider5 = nv; slider_automate(slider5); paramsDirty = 1; patchSel = -1; );
nv = knob(4, 354, 152, 27, slider6, 0, 100);
nv != slider6 ? ( slider6 = nv; slider_automate(slider6); paramsDirty = 1; patchSel = -1; );
nv = knob(5, 452, 152, 27, slider7, 0, 100);
nv != slider7 ? ( slider7 = nv; slider_automate(slider7); paramsDirty = 1; patchSel = -1; );
nv = knob(6, 550, 152, 27, slider8, 0, 100);
nv != slider8 ? ( slider8 = nv; slider_automate(slider8); paramsDirty = 1; patchSel = -1; );
nv = knob(7, 648, 152, 27, slider9, 0, 100);
nv != slider9 ? ( slider9 = nv; slider_automate(slider9); paramsDirty = 1; patchSel = -1; );
nv = knob(8, 746, 152, 27, slider10, 0, 100);
nv != slider10 ? ( slider10 = nv; slider_automate(slider10); paramsDirty = 1; patchSel = -1; );

gfx_setfont(3); colInk(1);
xctr(11, 182, 98, 12, "TUNING");
xctr(109, 182, 98, 12, "FINE");
xctr(207, 182, 98, 12, "CUTOFF FREQ");
xctr(305, 182, 98, 12, "RESONANCE");
xctr(403, 182, 98, 12, "ENV MOD");
xctr(501, 182, 98, 12, "DECAY");
xctr(599, 182, 98, 12, "ACCENT");
xctr(697, 182, 98, 12, "VOLUME");

gfx_setfont(4); colAcid(1);
xat(20, 196);  gfx_printf("%+d st", slider3);
xat(120, 196); gfx_printf("%+d ct", slider4);
xat(210, 196); gfx_printf("%d Hz", floor(baseF));
xat(322, 196); gfx_printf("%d %%", floor(slider6));
xat(420, 196); gfx_printf("%.1f oct", slider7*0.052);
xat(512, 196); gfx_printf("%d ms", floor(decTau*1000 + 0.5));
xat(616, 196); gfx_printf("%d %%", floor(slider9));
xat(714, 196); gfx_printf("%d %%", floor(slider10));

gfx_setfont(3); colInk(1); xctr(800, 104, 78, 12, "WAVEFORM");
gfx_setfont(2);
btn(800, 118, 78, 22, slider2 == 0, "SAW") ? ( slider2 = 0; slider_automate(slider2); paramsDirty = 1; );
btn(800, 144, 78, 22, slider2 == 1, "SQUARE") ? ( slider2 = 1; slider_automate(slider2); paramsDirty = 1; );

// Accent threshold only matters in HOST mode, so it is only drawn then
slider1 == 0 ? (
  gfx_setfont(3); colInk(1); xstr(800, 172, "ACCENT VEL");
  gfx_setfont(4); colAcid(1);
  xat(800, 184); gfx_printf("%d", floor(slider12));
  gfx_setfont(3);
  btn(800, 202, 20, 18, 0, "-") ? ( slider12 = max(1, slider12 - 1); slider_automate(slider12); paramsDirty = 1; );
  btn(826, 202, 20, 18, 0, "+") ? ( slider12 = min(127, slider12 + 1); slider_automate(slider12); paramsDirty = 1; );
);

/* ---------- Panel EFFECTS ----------
   Under each unit its input EQ as a dual slider (see above). */
panelBox(14, 234, 872, 156);
gfx_setfont(3);
colAcid(1);
xstr(26, 240, "DRIVE"); xstr(342, 240, "DELAY"); xstr(566, 240, "REVERB");
xstr(772, 240, "COMP");
colDim(1);
xline(328, 244, 328, 382);
xline(558, 244, 558, 382);
xline(762, 244, 762, 382);
pad(328, 244, 3); pad(558, 244, 3); pad(762, 244, 3);

gfx_setfont(2);
btn(26, 254, 54, 18, slider13 == 1, slider13 == 1 ? "ON" : "OFF") ? ( slider13 = 1 - slider13; slider_automate(slider13); paramsDirty = 1; );
btn(86, 254, 44, 18, slider14 == 0, "SOFT") ? ( slider14 = 0; slider_automate(slider14); paramsDirty = 1; );
btn(134, 254, 44, 18, slider14 == 1, "HARD") ? ( slider14 = 1; slider_automate(slider14); paramsDirty = 1; );
btn(182, 254, 44, 18, slider14 == 2, "FOLD") ? ( slider14 = 2; slider_automate(slider14); paramsDirty = 1; );
btn(230, 254, 44, 18, slider14 == 3, "FUZZ") ? ( slider14 = 3; slider_automate(slider14); paramsDirty = 1; );

btn(342, 254, 42, 18, slider17 == 0, "1/8")  ? ( slider17 = 0; slider_automate(slider17); paramsDirty = 1; );
btn(388, 254, 42, 18, slider17 == 1, "1/8.") ? ( slider17 = 1; slider_automate(slider17); paramsDirty = 1; );
btn(434, 254, 42, 18, slider17 == 2, "1/4")  ? ( slider17 = 2; slider_automate(slider17); paramsDirty = 1; );
btn(480, 254, 42, 18, slider17 == 3, "1/2")  ? ( slider17 = 3; slider_automate(slider17); paramsDirty = 1; );

// COMP column: ON/OFF in the button row, MIX = knob id 18.
btn(772, 254, 64, 18, slider34 == 1, slider34 == 1 ? "ON" : "OFF")
  ? ( slider34 = 1 - slider34; slider_automate(slider34); paramsDirty = 1; );
gfx_setfont(2); colInk(1); xstr(772, 354, "-14 dB / 5:1");

nv = knob(9, 171, 298, 20, slider15, 1, 40);
nv != slider15 ? ( slider15 = nv; slider_automate(slider15); paramsDirty = 1; patchSel = -1; );
nv = knob(10, 440, 298, 20, slider16, 0, 100);
nv != slider16 ? ( slider16 = nv; slider_automate(slider16); paramsDirty = 1; patchSel = -1; );
nv = knob(11, 520, 298, 20, slider18, 0, 90);
nv != slider18 ? ( slider18 = nv; slider_automate(slider18); paramsDirty = 1; patchSel = -1; );
nv = knob(12, 592, 298, 20, slider19, 0, 100);
nv != slider19 ? ( slider19 = nv; slider_automate(slider19); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(13, 657, 298, 20, slider20, 20, 100) + 0.5);
nv != slider20 ? ( slider20 = nv; slider_automate(slider20); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(14, 722, 298, 20, slider11, 0, 300) + 0.5);
nv != slider11 ? ( slider11 = nv; slider_automate(slider11); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(18, 824, 298, 20, slider35, 0, 100) + 0.5);
nv != slider35 ? ( slider35 = nv; slider_automate(slider35); paramsDirty = 1; );

gfx_setfont(3); colInk(1);
xctr(141, 322, 60, 12, "DRIVE");
xctr(410, 322, 60, 12, "MIX");
xctr(490, 322, 60, 12, "FEEDBACK");
xctr(562, 322, 60, 12, "MIX");
xctr(627, 322, 60, 12, "SIZE");
xctr(692, 322, 60, 12, "SLIDE");
xctr(794, 322, 60, 12, "MIX");
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%.1f", slider15);         drawCentered(171, 336);
sprintf(#vstr, "%d %%", floor(slider16)); drawCentered(440, 336);
sprintf(#vstr, "%d %%", floor(slider18)); drawCentered(520, 336);
sprintf(#vstr, "%d %%", floor(slider19)); drawCentered(592, 336);
sprintf(#vstr, "%d %%", floor(slider20)); drawCentered(657, 336);
sprintf(#vstr, "%d ms", floor(slider11)); drawCentered(722, 336);
sprintf(#vstr, "%d %%", floor(slider35)); drawCentered(824, 336);

// --- Input EQs: compute first, then draw (same frame);
// min/max prevents the band from being pinched shut — the unit would
// otherwise be silent without any visible reason.
nv = min(fxEqVal(20, 26, 360, 284, slider27, 0, 0), slider28);
nv != slider27 ? ( slider27 = nv; slider_automate(slider27); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(21, 26, 360, 284, slider28, 1, 20000), slider27);
nv != slider28 ? ( slider28 = nv; slider_automate(slider28); paramsDirty = 1; patchSel = -1; );
eqTrack(26, 360, 284, eqT(slider27), eqT(slider28));
eqHandle(20, 26, 360, 284, slider27);
eqHandle(21, 26, 360, 284, slider28);

nv = min(fxEqVal(22, 342, 360, 208, slider29, 0, 300), slider30);
nv != slider29 ? ( slider29 = nv; slider_automate(slider29); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(23, 342, 360, 208, slider30, 1, 20000), slider29);
nv != slider30 ? ( slider30 = nv; slider_automate(slider30); paramsDirty = 1; patchSel = -1; );
eqTrack(342, 360, 208, eqT(slider29), eqT(slider30));
eqHandle(22, 342, 360, 208, slider29);
eqHandle(23, 342, 360, 208, slider30);

nv = min(fxEqVal(24, 562, 360, 196, slider31, 0, 0), slider32);
nv != slider31 ? ( slider31 = nv; slider_automate(slider31); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(25, 562, 360, 196, slider32, 1, 20000), slider31);
nv != slider32 ? ( slider32 = nv; slider_automate(slider32); paramsDirty = 1; patchSel = -1; );
eqTrack(562, 360, 196, eqT(slider31), eqT(slider32));
eqHandle(24, 562, 360, 196, slider31);
eqHandle(25, 562, 360, 196, slider32);

eqLabels(26, 370, 284, slider27, slider28);
eqLabels(342, 370, 208, slider29, slider30);
eqLabels(562, 370, 196, slider31, slider32);

/* ---------- Oscilloscope (signal wave as a leitmotif) ---------- */
panelBox(14, 398, 872, 64);
gfx_set(0.042, 0.048, 0.042, 1); xrect(16, 400, 868, 60);
gfx_set(0.10, 0.13, 0.08, 1);
xline(16, 430, 884, 430);
gi = 1;
loop(7, xline(16 + gi*108.5, 400, 16 + gi*108.5, 460); gi += 1; );
colAcid(1);
gi = 0;
loop(256,
  sxp = OX + (18 + 864*gi/255)*SC;
  sv  = M_SCOPE[(scopePos + gi*2) % 512];
  syp = OY + (430 - max(-1.1, min(1.1, sv))*26)*SC;
  gi == 0 ? ( gfx_x = sxp; gfx_y = syp; ) : gfx_lineto(sxp, syp, 1);
  gi += 1;
);
gfx_setfont(5);
gfx_set(0, 0, 0, 0.75); xrect(20, 442, 384, 16);
gateHeld ? colAcid(1) : colInk(1);
xat(24, 444);
gfx_printf("NOTE "); noteName(noteCur);
gfx_printf("  %.1f Hz  |  VCF %d Hz  |  %d BPM", freq, floor(fc), floor(bpmNow));

/* ---------- Panel SEQUENCER / MIDI ---------- */
panelBox(14, 470, 872, 250);

slider1 == 1 ? (

  bb = floor(slider25)*SEQ_BANK;

  gfx_setfont(3);
  colAcid(1); xstr(26, 478, "SEQUENCER");
  colInk(1);  xstr(26, 492, "16 STEPS");
  seqRunning ? colAcid(1) : gfx_set(0.16, 0.19, 0.15, 1);
  xcirc(150, 489, 5, 1);
  gfx_setfont(5);
  colInk(1); xat(162, 482);
  seqRunning ? gfx_printf("RUN  STEP %02d", curStepDisp + 1) : gfx_drawstr("STOP");

  gfx_setfont(2);
  btn(250, 478, 86, 22, slider24 == 1, "FREE RUN") ? ( slider24 = 1 - slider24; slider_automate(slider24); paramsDirty = 1; );
  // SEQ OUT = generated sequence out (THRU at the top = incoming notes).
  btn(344, 478, 86, 22, slider26 == 1, "SEQ OUT") ? ( slider26 = 1 - slider26; slider_automate(slider26); paramsDirty = 1; );

  gfx_setfont(3);
  midiHeld ? colAcid(1) : colInk(1);
  xat(445, 482);
  midiHeld ? gfx_printf("MIDI TRANSPOSE %+d", seqTrans) : gfx_drawstr("MIDI = TRANSPOSE");

  // --- Banks. Arm COPY, then click the target bank. The target bank
  // gets an undo point first (UNDO there, after switching).
  gfx_setfont(3); colInk(1); xstr(26, 516, "BANK");
  gfx_setfont(2);
  btn(70, 510, 36, 22, slider25 == 0, "A") ? (
    copyArm ? ( bb != 0 ? ( saveUndo(0); copyBank(bb, 0); ); copyArm = 0; )
            : ( slider25 = 0; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(110, 510, 36, 22, slider25 == 1, "B") ? (
    copyArm ? ( bb != SEQ_BANK ? ( saveUndo(SEQ_BANK); copyBank(bb, SEQ_BANK); ); copyArm = 0; )
            : ( slider25 = 1; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(150, 510, 36, 22, slider25 == 2, "C") ? (
    copyArm ? ( bb != 2*SEQ_BANK ? ( saveUndo(2*SEQ_BANK); copyBank(bb, 2*SEQ_BANK); ); copyArm = 0; )
            : ( slider25 = 2; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(190, 510, 36, 22, slider25 == 3, "D") ? (
    copyArm ? ( bb != 3*SEQ_BANK ? ( saveUndo(3*SEQ_BANK); copyBank(bb, 3*SEQ_BANK); ); copyArm = 0; )
            : ( slider25 = 3; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(236, 510, 56, 22, copyArm, "COPY")  ? ( copyArm = 1 - copyArm; );
  btn(300, 510, 46, 22, 0, "RND")   ? ( saveUndo(bb); randPattern(bb); copyArm = 0; );
  btn(350, 510, 46, 22, 0, "MUT")   ? ( saveUndo(bb); mutPattern(bb); copyArm = 0; );
  btn(400, 510, 52, 22, 0, "CLEAR") ? ( saveUndo(bb); clearBank(bb); copyArm = 0; );
  // UNDO only lit and active on the bank the undo point comes from
  btn(456, 510, 52, 22, undoArm && undoBank == bb, "UNDO") ? (
    undoBank == bb ? loadUndo(); copyArm = 0;
  );
  bb = floor(slider25)*SEQ_BANK;
  gfx_setfont(3);
  copyArm ? ( colAcid(1); xstr(514, 516, "SELECT TARGET BANK"); );

  // --- Sequencer knobs, values below.
  nv = floor(knob(15, 690, 506, 19, slider21, 1, 16) + 0.5);
  nv != slider21 ? ( slider21 = nv; slider_automate(slider21); paramsDirty = 1; patchSel = -1; );
  nv = floor(knob(16, 770, 506, 19, slider22, 0, 75) + 0.5);
  nv != slider22 ? ( slider22 = nv; slider_automate(slider22); paramsDirty = 1; patchSel = -1; );
  nv = floor(knob(17, 849, 506, 19, slider23, 10, 100) + 0.5);
  nv != slider23 ? ( slider23 = nv; slider_automate(slider23); paramsDirty = 1; patchSel = -1; );
  // Positions from measured text widths (minimum gap 10, right
  // edge 880) — no overlap with any fallback font or window size.
  gfx_setfont(3);
  sprintf(#klbl, "LEN");  sprintf(#kval, "%d", floor(slider21));
  gfx_measurestr(#klbl, kw1, kh1); gfx_measurestr(#kval, vw1, vh1);
  wq1 = kw1 + 6 + vw1;
  sprintf(#klbl, "SHUF"); sprintf(#kval, "%d %%", floor(slider22));
  gfx_measurestr(#klbl, kw2, kh1); gfx_measurestr(#kval, vw2, vh1);
  wq2 = kw2 + 6 + vw2;
  sprintf(#klbl, "GATE"); sprintf(#kval, "%d %%", floor(slider23));
  gfx_measurestr(#klbl, kw3, kh1); gfx_measurestr(#kval, vw3, vh1);
  wq3 = kw3 + 6 + vw3;
  qx1 = 690 - wq1*0.5;
  qx2 = max(qx1 + wq1 + 10, 770 - wq2*0.5);
  qx3 = max(qx2 + wq2 + 10, 849 - wq3*0.5);
  qx3 = min(qx3, 880 - wq3);
  qx2 = min(qx2, qx3 - wq2 - 10);
  qx1 = min(qx1, qx2 - wq1 - 10);
  sprintf(#klbl, "LEN");  sprintf(#kval, "%d", floor(slider21));     kvLabel(qx1, 528);
  sprintf(#klbl, "SHUF"); sprintf(#kval, "%d %%", floor(slider22));  kvLabel(qx2, 528);
  sprintf(#klbl, "GATE"); sprintf(#kval, "%d %%", floor(slider23));  kvLabel(qx3, 528);

  // --- Row labels
  colInk(1);
  xstr(14, 584, "NOTE");
  xstr(14, 660, "GATE");
  xstr(14, 678, "ACC");
  xstr(14, 696, "SLD");

  // guide lines of the C notes
  gi = 0;
  loop(3,
    ly = LANE_Y + LANE_H - (24 + gi*12 - SEQ_NLO + 1)*ROW_H;
    gfx_set(0.14, 0.17, 0.12, 1);
    xline(GRID_X, ly, 884, ly);
    gi += 1;
  );

  // --- 16 columns (monospaced note names, nothing jitters).
  gfx_setfont(5);
  gi = 0;
  loop(16,
    cx0 = GRID_X + gi*GRID_W;
    seqRunning && curStepDisp == gi ? gfx_set(0.09, 0.16, 0.07, 1)
    : gi < patLen ? gfx_set(0.092, 0.096, 0.092, 1) : gfx_set(0.056, 0.060, 0.056, 1);
    xrect(cx0, LANE_Y, 50, LANE_H);
    (gi % 4) == 0 ? ( colDim(1); xrect(cx0, LANE_Y, 1, LANE_H); );

    uiClick && inBox(cx0, LANE_Y, 50, LANE_H) ? ( dragId = 1000 + gi; );
    dragId == 1000 + gi && uiLmb ? (
      M_SEQ[bb + gi*4 + SF_NOTE] = min(SEQ_NHI, max(SEQ_NLO,
        SEQ_NLO + floor((LANE_Y + LANE_H - mY)/ROW_H)));
    );
    uiRClk && inBox(cx0, LANE_Y, 50, LANE_H) ? ( M_SEQ[bb + gi*4 + SF_GATE] = 1 - M_SEQ[bb + gi*4 + SF_GATE]; );

    nn = M_SEQ[bb + gi*4 + SF_NOTE];
    ly = LANE_Y + LANE_H - (nn - SEQ_NLO + 1)*ROW_H;
    M_SEQ[bb + gi*4 + SF_GATE] ? ( M_SEQ[bb + gi*4 + SF_ACC] ? colWhite(1) : colAcid(1); )
                               : gfx_set(0.20, 0.24, 0.19, 1);
    xrect(cx0 + 4, ly, 42, 4);

    M_SEQ[bb + gi*4 + SF_SLIDE] ? (
      colAcid(0.55);
      xline(cx0 + 46, ly + 2, cx0 + 52, ly + 2);
      xline(cx0 + 48, ly - 1, cx0 + 52, ly + 2);
      xline(cx0 + 48, ly + 5, cx0 + 52, ly + 2);
    );

    M_SEQ[bb + gi*4 + SF_GATE] ? colAcid(1) : gfx_set(0.25, 0.28, 0.24, 1);
    gfx_measurestr("C#2", tw1, th1);
    gfx_x = OX + cx0*SC + (50*SC - tw1)*0.5; gfx_y = OY + 638*SC;
    noteName(nn);

    ri = 0;
    loop(3,
      ry = 656 + ri*18;
      fld = 1 + ri;
      hitc = inBox(cx0, ry, 50, 16);
      uiClick && hitc ? (
        paintRow = ri + 1;
        paintVal = 1 - M_SEQ[bb + gi*4 + fld];
        M_SEQ[bb + gi*4 + fld] = paintVal;
      ) : (
        uiLmb && paintRow == ri + 1 && hitc ? ( M_SEQ[bb + gi*4 + fld] = paintVal; );
      );
      M_SEQ[bb + gi*4 + fld] ? (
        ri == 0 ? colAcid(0.90) : ri == 1 ? colWhite(0.90) : colAcid(0.50);
      ) : (
        hitc ? gfx_set(0.16, 0.19, 0.15, 1) : gfx_set(0.104, 0.109, 0.104, 1);
      );
      xrect(cx0, ry, 50, 16);
      ri += 1;
    );
    gi += 1;
  );
  patLen < 16 ? (
    gfx_set(0, 0, 0, 0.45);
    xrect(GRID_X + patLen*GRID_W, LANE_Y, 884 - (GRID_X + patLen*GRID_W), 168);
  );

) : (

  // ---------- HOST mode: MIDI display ----------
  gfx_setfont(3);
  colAcid(1); xstr(26, 478, "MIDI INPUT");
  colInk(1);  xstr(26, 492, "PIANO ROLL PLAYS THE SOUND ENGINE");
  xat(26, 514);
  gfx_printf("VELOCITY >= %d = ACCENT   |   OVERLAPPING NOTES = SLIDE   |   LAST NOTE WINS   |   HELD: %d", floor(slider12), stkN);

  gi = 0; wi = 0;
  loop(37,
    nn = 24 + gi;
    kk = nn - 12*floor(nn/12);
    (kk == 1 || kk == 3 || kk == 6 || kk == 8 || kk == 10) ? 0 : (
      noteHeld(nn) ? colAcid(1) : gfx_set(0.88, 0.88, 0.88, 1);
      xrect(40 + wi*36, 544, 34, 110);
      gfx_set(0.10, 0.10, 0.10, 1);
      kk == 0 ? ( xat(45 + wi*36, 632); gfx_printf("C%d", floor(nn/12) - 1); );
      wi += 1;
    );
    gi += 1;
  );
  gi = 0; wi = 0;
  loop(37,
    nn = 24 + gi;
    kk = nn - 12*floor(nn/12);
    (kk == 1 || kk == 3 || kk == 6 || kk == 8 || kk == 10) ? (
      noteHeld(nn) ? colAcid(1) : gfx_set(0.04, 0.05, 0.04, 1);
      xrect(40 + wi*36 - 11, 544, 22, 66);
      gfx_set(0.20, 0.24, 0.19, 1);
      xrect(40 + wi*36 - 11, 544, 22, 1);
    ) : ( wi += 1; );
    gi += 1;
  );
  pad(40, 676, 4); pad(832, 676, 4);
  colDim(1); xline(44, 676, 828, 676);
  colInk(1);
  xstr(26, 692, "SEQ MODE (TOP RIGHT) SWITCHES ON THE INTERNAL 16-STEP SEQUENCER");
);

lmbPrev = uiLmb;
rmbPrev = mouse_cap & 2;
mouse_wheel = 0;
