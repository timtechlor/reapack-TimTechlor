desc:TT-303 Acid Machine
// @description TT-303 Acid Machine
// @author TimTechlor
// @version 1.0
// @license MIT
// @tags synth instrument acid 303 tb-303 bass techno
// @about
//   # TT-303 Acid Machine
//
//   Monophoner Acid-Bass-Synthesizer im Stil der Roland TB-303. Tribute-
//   Modell ohne Samples.
//
//   - Oszillator: Saw / Rechteck, 1-Sample-PolyBLEP, 2x ueberabgetastet
//   - VCF: 3-Pol-Leiter (18 dB/Okt) in ZDF/TPT-Form, pegelabhaengige Resonanz
//   - Slide + Accent, interner 16-Step-Sequencer mit 4 Baenken A-D
//   - Drive (paralleler EQ + WaveShaper), Ping-Pong-Delay, Freeverb-Hall,
//     Kompressor (nur auf Dry) mit regelbarem Mix
//   - Komplett gezeichnete Geraetefront mit Versionsanzeige, 5 Werks-Presets
//
//   HOST-Modus: Klangerzeuger aus der Piano-Rolle. SEQ-Modus: interner
//   Sequencer an der Timeline oder frei laufend.
// @changelog
//   1.0
//   - Erste Vollversion
//tags: synth instrument acid 303 bass techno
//author: TimTechlor
//about:
// TT-303 ACID MACHINE — v5
// Uebernommen aus v4 (nachgemessen und bestaetigt):
//   3-Punkt-Dezimierung 1/4-1/2-1/4 (Alias -4,3 dB), Accent-Attack 1,8 ms,
//   echter EQ-Bypass, MIDI-Thru-Schalter, CC-Mapping, Pattern-Undo,
//   Kompressor nur auf Dry, Voice-Sleep, Font-Cache.
// In v5 zurueckgenommen (nachgemessen: Verschlechterung):
//   poleScale-Saettigung  -> Resonanzhoecker lag +2,4 Halbtoene zu hoch
//   polyBlepNext          -> Alias 1,1..3,2 dB SCHLECHTER als ohne
//   kRes/resMakeUp-Tuning -> 0,8 dB Pegelverlust bei hoher Resonanz
// In v5 neu behoben:
//   Voice-Sleep fror die Filterzustaende ein (Knacken bei hoher Resonanz)
//   Hall-Bypass fror Comb-/Allpass-Puffer und prePos ein (alter Inhalt)
//   Delay-Bypass liess hpY/hpPrev stehen (Gleichsprung beim Zuschalten)
//   Note-Stack konnte Duplikate halten (haengende Stimme)
//   Drive-Bypass war 0,9 dB leiser als Unity; Modelle nicht pegelgleich
//   Pattern-Daten wurden beim Laden nicht validiert
//   MIDI-Queue 256 -> 512 Events, GUI-Mindestskalierung 0,45 -> 0,25
// Neu in v6:
//   Drive-EQ arbeitet parallel statt in Reihe. Was der EQ wegnimmt,
//   laeuft am WaveShaper vorbei und kommt sauber wieder dazu — ein
//   hochgezogener Lowcut nimmt also den Bass aus der VERZERRUNG, nicht
//   aus dem Signal.
//   WaveShaper 2-fach ueberabgetastet (+7,6 bis +9,8 dB Alias gemessen).
//   MIDI OUT heisst jetzt SEQ OUT, weil THRU eine andere Aufgabe hat.
// TT-303 ACID MACHINE — Mono-Acid-Synth im Stil der TB-303.
// Tribute, keine Samples, kein Sample-ROM, alles Modell.
//
// BEDIENELEMENTE WIE AM ORIGINAL
//   TUNING     Halbtoene (-24..+24), dazu FINE in Cent
//   CUTOFF     Filterfrequenz, 60 Hz .. 6 kHz exponentiell
//   RESONANCE  Rueckkopplung der 18-dB-Leiter bis zur Selbstschwingung
//   ENV MOD    Hub der Filterhuellkurve, bis 5,2 Oktaven
//   DECAY      Abfall der Filterhuellkurve, 60 ms .. 2,5 s
//   ACCENT     Lautstaerke- UND Filter-Zuschlag der Accent-Schaltung
//   WAVEFORM   Saegezahn / Rechteck
//
// MODELLDETAILS (nach R. Whittle / Devil-Fish-Dokumentation)
//  - Filter: 3-polige Leiter (18 dB/Okt) in ZDF/TPT-Form,
//    pegelabhaengige Rueckkopplung k/(1+0,4|y|), 2-fach ueberabgetastet,
//    danach 3-Punkt-Dezimierung. Soft-Clip nur am Master, nie in der
//    OS-Schleife (dort greift er bei realen Pegeln ohnehin nie).
//  - Polkorrektur 1/(1+0,0913*kRes): nachgemessen liegt der Resonanz-
//    hoecker damit ueber kRes 3,5..9,2 auf +0,05 bis +0,53 Halbtoenen
//    genau am angezeigten Cutoff. Jede "verfeinerte" Variante mit
//    Quadrat- oder Saettigungsterm war messbar schlechter.
//  - Feedback-HP 150 Hz IM Rueckkopplungsweg (Open303-Struktur).
//  - Rechteck mit frequenzabhaengigem Duty + Dachschraege.
//    Klassischer 1-Sample-PolyBLEP: der 2-Sample-Zusatzterm wurde in
//    allen Vorzeichen und Skalierungen getestet und war stets schlechter.
//  - Accent-Kondensator: Nachladen +0.95, Saettigung 1.65.
//    Accent-Sweep mit Nichtlinearitaet und leichter Cutoff-Abhaengigkeit.
//  - Bei Accent: fixe 0,2 s Filter-Decay + verkuerzte VCA-Attack (1.8 ms).
//  - Slide: konstante Zeit, Log-Frequenzraum; gleiche Note bleibt liegen.
//  - FX: Delay/Reverb bypassed bei Mix < 0.5 %. EQ-OFF = echter Bypass.
//  - MIDI: Noten werden verbraucht, CC/Pitchbend gehen weiter.
//
// BETRIEBSARTEN
//   HOST  Reiner Klangerzeuger, gespielt aus der Piano-Rolle.
//         Velocity >= Schwelle = Accent, ueberlappende Noten = Slide.
//   SEQ   Interner 16-Step-Sequencer, vier Pattern-Baenke A-D mit
//         Kopierfunktion, Zufall und Mutation, Shuffle, Gate-Laenge.
//         Laeuft an der Projekt-Timeline oder frei (FREE RUN).
//         MIDI-Noten transponieren das Pattern (C2 = Originallage).
//         MIDI OUT schickt die Sequenz zusaetzlich nach draussen.
//         Alle vier Baenke wandern mit ins Projekt.
//
// Effektweg: vor jeder der drei Einheiten — WaveShaper (Soft/Hard/
// Fold/Fuzz), Ping-Pong-Delay, Freeverb-Hall — liegt ein Eingangs-EQ
// als Dualslider (Lowcut links, Highcut rechts, 0..20 kHz). Danach
// Kompressor (-14 dB, 5:1) und Master.
//
// Beim Delay und beim Hall bestimmt der EQ, was in den Effekt geschickt
// wird; das trockene Signal laeuft ohnehin daneben her. Beim Drive war
// das frueher anders: dort sass der EQ in Reihe, ein hochgezogener
// Lowcut hat den Bass aus dem GESAMTEN Ausgang genommen. Seit v6 wird
// aufgeteilt — der EQ waehlt aus, was in den WaveShaper geht, der Rest
// laeuft unverzerrt daran vorbei und wird danach wieder addiert.
//
// MIDI: THRU oben in der Kopfzeile reicht EINGEHENDE Noten an den
// Ausgang weiter (CC und Pitchbend gehen ohnehin immer durch).
// SEQ OUT im Sequencer-Panel schickt die SELBST ERZEUGTE Sequenz nach
// draussen. Zwei verschiedene Quellen, deshalb zwei Schalter. Im
// SEQ-Modus sind eingehende Noten Transponierbefehle — wer sie mit
// THRU zusaetzlich durchreicht, schickt sie neben der Sequenz mit raus.
//
// OBERFLAECHE nach dem Tim-Techlor-Designkit: Core Black, Core White,
// Acid Green #39FF14, Leitbahnen im 45-Grad-Winkel mit Loetpunkten.
// Schriftzug in Zilap Orian, wenn installiert. Beschriftungen serifenlos
// (Segoe UI / Helvetica Neue / DejaVu Sans / Arial), Zahlenwerte
// dicktengleich (Consolas / DejaVu Sans Mono / Menlo / Courier New).
// Welche davon vorhanden ist, misst das Skript selbst nach.
// Die Front rechnet in einem festen Designraster und skaliert auf die
// Fenstergroesse — zum Vergroessern einfach das FX-Fenster aufziehen.
// HiDPI wird ueber gfx_ext_retina beruecksichtigt. Alle internen
// JSFX-Regler sind ausgeblendet ("-" vor dem Namen), bedient wird
// ausschliesslich ueber die Geraetefront.

in_pin:none
out_pin:TT-303 L
out_pin:TT-303 R

options:gfx_hz=45 gmem=tt303_acid

slider1:0<0,1,1{HOST,SEQ}>-Modus
slider2:0<0,1,1{Sawtooth,Square}>-Waveform
slider3:0<-24,24,1>-Tuning (Halbtoene)
slider4:0<-50,50,1>-Fine (Cent)
slider5:32<0,100,0.1>-Cutoff Freq
slider6:55<0,100,0.1>-Resonance
slider7:62<0,100,0.1>-Env Mod
slider8:35<0,100,0.1>-Decay
slider9:60<0,100,0.1>-Accent
slider10:70<0,100,0.1>-Volume
slider11:60<0,300,1>-Slide-Zeit (ms)
slider12:100<1,127,1>-Accent ab Velocity
slider13:0<0,1,1{Aus,An}>-Verzerrung
slider14:0<0,3,1{Soft,Hard,Fold,Fuzz}>-Verzerrungs-Modell
slider15:8<1,40,0.1>-Drive
slider16:15<0,100,0.5>-Delay-Mix (%)
slider17:1<0,3,1{1/8,Punktierte 1/8,1/4,1/2}>-Delay-Teiler
slider18:60<0,90,1>-Delay-Feedback (%)
slider19:18<0,100,0.5>-Hall-Mix (%)
slider20:70<20,100,1>-Raumgroesse (%)
slider21:16<1,16,1>-SEQ Pattern-Laenge
slider22:0<0,75,1>-SEQ Shuffle (%)
slider23:55<10,100,1>-SEQ Gate (%)
slider24:0<0,1,1{Aus,An}>-SEQ Free Run
slider25:0<0,3,1{A,B,C,D}>-SEQ Pattern-Bank
slider26:0<0,1,1{Aus,An}>-SEQ Out (Sequenz nach aussen)
slider27:0<0,20000,1>-Drive EQ Lowcut (Hz)
slider28:20000<20,20000,1>-Drive EQ Highcut (Hz)
slider29:250<0,20000,1>-Delay EQ Lowcut (Hz)
slider30:3000<20,20000,1>-Delay EQ Highcut (Hz)
slider31:300<0,20000,1>-Hall EQ Lowcut (Hz)
slider32:2300<20,20000,1>-Hall EQ Highcut (Hz)
slider33:0<0,1,1{Aus,An}>-MIDI Thru (eingehende Noten)
slider34:1<0,1,1{Aus,An}>-Kompressor
slider35:100<0,100,1>-Kompressor Mix

/* ============================================================
   @init — Speicherkarte, Funktionen, Grundzustand.
   Funktionen muessen VOR ihrer ersten Verwendung stehen, deshalb
   liegt hier alles beisammen.
   ============================================================ */
@init

// ---------- Speicherkarte ----------
// Achtung: M_SEQ liegt bewusst in einer Luecke, die vom memset
// ausgespart wird. @init laeuft bei jedem Samplerate-Wechsel und beim
// Transportstart erneut — ohne diese Luecke waere das Pattern jedes Mal
// weg, inklusive dem gerade aus dem Projekt geladenen.
M_STK    = 0;        // 32     Note-Stack (Mono, letzte-Note-Prioritaet)
M_SCOPE  = 64;       // 512    Oszilloskop-Ringpuffer
M_PAR    = 1792;     // 128    Freeverb-Layout und -Zustand
M_PRE    = 2048;     // 8192   Hall-Predelay
M_EVT    = 10240;    // 2048   MIDI-Queue, 512 Events x 4 Werte
M_SEQ    = 12288;    // 1024   4 Baenke x 16 Steps x 4 Werte [bleibt erhalten]
M_UNDO   = 13312;    // 64     eine Bank Undo (RND/MUT/CLEAR)
M_SEQEND = 13376;
M_DLY1   = 16384;

// Groesse nach dem laengsten moeglichen Delay: halbe Note bei 40 BPM
// sind 3,0 s. Mit 1,6 s lief der Puffer schon unterhalb von 75 BPM an
// den Anschlag und das Delay verlor das Timing.
dlyBufLen = ceil(3.3*srate);
M_DLY2 = M_DLY1 + dlyBufLen + 16;
M_RVB  = M_DLY2 + dlyBufLen + 16;

rvSc     = max(1, srate/44100);              // Freeverb-Laengen skalieren
rvSpread = ceil(23*rvSc);
rvbTotal = ceil(25174*rvSc) + 12*rvSpread + 128;
MEMTOP   = M_RVB + rvbTotal + 16;

EVT_MAX = 512;                               // Platz in der MIDI-Queue

SRX = srate*2;                               // Arbeitsrate des Filters (2-fach)

// Step-Felder und Bankgroesse
SF_NOTE = 0; SF_GATE = 1; SF_ACC = 2; SF_SLIDE = 3;
SEQ_BANK = 64;                               // 16 Steps x 4 Werte je Bank
SEQ_NLO = 24; SEQ_NHI = 48;                  // C1 .. C3 im Step-Editor

// Layout der Front im Designraster; SC skaliert auf die Fenstergroesse
UI_W = 900; UI_H = 732;
LANE_Y = 544; LANE_H = 92; ROW_H = 3.68;     // 25 Halbtoene in der Notenspur
GRID_X = 52; GRID_W = 52;                    // 16 Spalten a 52 Punkt

// HiDPI: REAPER liefert dann die echte Pixelaufloesung, und weil SC aus
// gfx_w/gfx_h faellt, wird die Front automatisch entsprechend groesser
// gezeichnet statt winzig zu bleiben.
gfx_ext_retina = 1;

/* ---------- kleine Mathe-Helfer ---------- */

// tanh-Ersatz (nicht jeder REAPER-Build hat tanh als Builtin)
function fastTanh(x) local(a) (
  a = min(30, max(-30, 2*x));
  (1 - exp(-a))/(1 + exp(-a));
);

// weiche Saettigung ohne exp — Pade-Naeherung von tanh, saettigt bei +-1
function softSat(x) local(a) (
  a = min(3, max(-3, x));
  a*(27 + a*a)/(27 + 9*a*a);
);

// 1-Sample-PolyBLEP. Ein zusaetzlicher 2-Sample-Restterm wurde gemessen
// (Vorzeichen +/-, Skalierung 0,25/0,5/1,0) und verschlechterte den
// Alias-Boden in jeder Variante um 0,15 bis 3,2 dB. Deshalb bleibt es
// beim klassischen 1-Sample-Kern; die Verbesserung kommt statt dessen
// aus der 3-Punkt-Dezimierung weiter unten (-4,3 dB gemessen).
function polyBlep(t, dt) (
  t < dt ? ( t /= dt; t + t - t*t - 1 )
  : t > 1 - dt ? ( t = (t - 1)/dt; t*t + t + t + 1 )
  : 0;
);

// Weiche Begrenzung statt hartem Schnitt. Bis 0,7 voellig linear,
// darueber ein tanh-Knie mit stetiger Steigung, Grenzwert genau 1,0.
// So knickt ein Resonanzueberschwinger nicht mehr rechteckig ab.
function softClip(x) local(a) (
  a = abs(x);
  a <= 0.7 ? x : (x >= 0 ? 1 : -1)*(0.7 + 0.3*fastTanh((a - 0.7)*3.3333333));
);

/* ---------- Parameter ---------- */

function readSliders() (
  seqMode   = slider1;
  waveSel   = slider2;
  tuneSemi  = slider3;
  fineCent  = slider4;
  cutN      = slider5*0.01;
  resN      = slider6*0.01;
  envN      = slider7*0.01;
  decN      = slider8*0.01;
  accN      = slider9*0.01;
  volG      = slider10*0.01;
  slideSec  = slider11*0.001;
  accThresh = slider12;
  fxDistOn  = slider13;
  distModel = slider14;
  driveG    = max(1, slider15);
  dlyMix    = slider16*0.01;
  dlyDiv    = slider17 == 0 ? 0.5 : slider17 == 1 ? 0.75 : slider17 == 2 ? 1 : 2;
  dlyFb     = slider18*0.01;
  rvbMix    = slider19*0.01;
  roomSz    = (slider20 - 20)/80;
  patLen    = max(1, min(16, floor(slider21)));
  bankBase  = floor(slider25)*SEQ_BANK;
  midiOut   = slider26;
  midiThru  = slider33;
  compOn    = slider34;                        // Kompressor abschaltbar (v8)
  compMix   = slider35*0.01;                   // 1 = voll (wie bisher), 0 = Bypass
  swFrac    = slider22/200;                  // bis 0,375 Step Versatz
  gateFrac  = slider23*0.01;
  freeRun   = slider24;
  eqDLoHz   = slider27; eqDHiHz = slider28;    // Eingangs-EQs der FX-Einheiten
  eqYLoHz   = slider29; eqYHiHz = slider30;
  eqRLoHz   = slider31; eqRHiHz = slider32;
);

function updateParams() (
  // --- Filter. Kennlinien in v8 an einen Roland-TB-303-VST angeglichen
  // (Task O3, gemessen an ref_f_*.wav; LTI-Fit + Nachjustierung an der
  // vollen Kette, tt303_o3_fit.py / tt303_o3_try.py). Ergebnis: die
  // Resonanz war vorher praktisch wirkungslos (Peak +1,5 dB statt +12..+19),
  // der Cutoff lag ~7 HT zu tief, und die 150-Hz-Feedback-HP hat zusammen
  // mit poleScale bei tiefem Cutoff jede Resonanz erstickt.
  //
  // Historie (Stand bis v7):
  //   baseF   = 60*exp(cutN*4.60517);                 // 60 Hz .. 6 kHz
  //   kRes    = 9.2*(resN^1.15);
  //   resMakeUp = 1 + 0.20*kRes/(1 + 0.10*kRes);
  //   poleScale = 1/(1 + 0.0913*kRes);                // Peak auf Cutoff geschoben
  //   fbHpA   = exp(-2*$pi*150/SRX);                  // Open303-Feedback-HP
  // Die alte poleScale war so gefittet, dass der Resonanzhoecker GENAU auf
  // dem angezeigten Cutoff liegt. Der Referenz-VST macht das NICHT — dort
  // wandert der Hoecker mit steigender Resonanz nach oben. Deshalb hier ein
  // schwaecheres poleScale und ein Cutoff, der mit der Resonanz mitgeht.
  // cut_a: 177 -> 145 (Nutzer-Ohr "zu offen", 2026-09-07). Bei 145 liegen
  // die Resonanz-Peakfrequenzen auf dem Referenz-Ziel (c25 r50 327 Hz,
  // c25 r90 425 Hz); der Broadband-RMS-Fehler steigt dabei, weil der
  // Referenz-Rolloff hoeher reicht (teils deren Rauschteppich).
  baseF   = 145*exp(cutN*1.95)*(1 + resN);   // ~145 Hz .. ~1,6 kHz, Resonanz
                                             // hebt die Ecke zusaetzlich
  kRes    = 1.6 + 6.0*(resN^0.7);            // Reso 0 traegt schon Q~1,6;
                                             // Maximum kRes ~7,6
  // Historie: O3  resMakeUp = 1  (kein Ausgleich mehr). Danach gemessen:
  // v8 lag ueber alle 7 ref_f_*-Faelle +2,5..+6,4 dB (Schnitt +4,2) heiss,
  // und im Blade-Pattern +3,6 dB trotz -3 dB Plugin-Volume (=~ +6,7 dB
  // pegelgleich). "Zu offen" am Ohr war primaer Pegel + Tiefbass, nicht
  // Helligkeit (Zentroid war schon dunkler als die Referenz).
  resMakeUp = 0.62;                          // -4,2 dB flach (10^(-4.2/20)),
                                             // holt den Schnitt-Offset raus
  poleScale = 1/(1 + 0.10*kRes);             // nur milde Peak-Korrektur
  envOct  = envN*5.2;                        // Hub der Huellkurve
  // Decay-Kennlinie in v8 an ref_dec_0/50/100.wav angeglichen (Task B4,
  // gemessen am Abfall des 400-3000-Hz-Bandes = "Filter schliesst"):
  // Referenz-tau ~30 / 130 / 574 ms bei Decay 0 / 50 / 100 %.
  // Historie: bis v7  decTau = 0.06*exp(decN*3.7297)  -> 60 / 390 / 2500 ms
  // (2..4x zu langsam; trug zum Eindruck "zu offen" bei).
  decTau  = 0.03*exp(decN*2.95);             // ~30 ms .. ~570 ms
  mDecC   = exp(-1/(decTau*srate));
  mDecAcc = exp(-1/(0.20*srate));            // Accent: fixe 0,2 s
  aDecC   = exp(-1/(0.085*srate));           // Accent-Zusatz etwas schneller
  fcMax   = min(16000, 0.45*SRX);
  // --- Kopplungen im VCF-Weg
  oscHpA  = exp(-2*$pi*40/SRX);
  sqHpA   = exp(-2*$pi*28/SRX);              // leicht tiefere Dachschraege
  // Feedback-Hochpass: v8 auf 20 Hz (war 150, Open303). Bei 150 Hz konnte
  // der Rueckkopplungsweg bei tiefem Cutoff keine Resonanz aufbauen —
  // poleScale zog die Polfrequenz unter die HP. 20 Hz bleibt DC-Sperre,
  // ohne die Resonanz unten abzuschneiden (Task O3 / Befund F3).
  fbHpA   = exp(-2*$pi*20/SRX);
  // --- VCA. susCoef klingt in v8 ab (Task O4). Nachgemessen an
  // ref_dec_0/50/100.wav (Grundton-Abfall): tau ~1,05..1,10 s und
  // WEITGEHEND UNABHAENGIG vom Decay-Regler. Deshalb konstant.
  // Historie: bis v7 fix  susCoef = exp(-1/(2.5*srate))  (haelt praktisch
  // flach). Zwischenstand (erste Messung, 2 verrauschte Punkte):
  //   susTau = 0.60 + 0.90*decN  -- verworfen, decN-Kopplung nicht belegt.
  attSec  = 0.003;                           // Normal-Attack
  attSecAcc = 0.0018;                        // Accent-Attack (spitzer)
  susTau  = 1.10;                            // ~1,1 s, reglerunabhaengig
  susCoef = exp(-1/(susTau*srate));
  relCoef = exp(-1/(0.012*srate));
  // --- Accent-Kondensator (leicht aggressiver Devil-Fish)
  accDecC = exp(-1/(0.10*srate));
  slideSamps = slideSec*srate;              // seit v7: Zeitkonstante tau des
                                            // RC-Slides, nicht mehr Gesamtdauer
  // --- Verzerrung
  // Jedes Modell hat einen eigenen Ausgleich, damit ein Modellwechsel
  // nicht die Lautstaerke aendert. Gemessen an einem gefilterten Saw
  // ueber driveG 1..40: Hard -1,13 dB, Fold -7,92 dB, Fuzz -1,10 dB
  // gegenueber Soft. Fold wird auf 2,40 statt 2,49 getrimmt, damit die
  // Spitzen Reserve behalten.
  distMk    = distModel == 1 ? 1.14 : distModel == 2 ? 2.40
            : distModel == 3 ? 1.14 : 1;
  distPreG  = fxDistOn ? driveG : 1;
  distPostG = fxDistOn ? 0.9*distMk/(driveG^0.35) : 1;
  // --- Kompressor (3 ms / 250 ms, Knee 30, Schwelle -14 dB, 5:1).
  // Die Kennlinie unten ist algebraisch identisch mit der Lehrbuchform
  //   over<=-K/2: 0 | |over|<K/2: -(over+K/2)^2/(2K)*(1-1/R)
  //   over>=K/2 : -over*(1-1/R)
  // mit K=30, R=5, also (1-1/R)=0,8 und 2K=60. Nicht umschreiben.
  cAtk = 1 - exp(-1/(0.003*srate));
  cRel = 1 - exp(-1/(0.25*srate));
  // --- Delay
  lpG24   = 1 - exp(-2*$pi*2400/srate);
  // Die Kreuzkopplung laeuft jetzt ungedaempft, die Rueckkopplung traegt
  // dafuer das Quadrat — so bleibt die Schleifenverstaerkung pro Umlauf
  // dieselbe wie vorher, aber der rechte Kanal bekommt auch bei 0 %
  // Feedback noch Signal.
  dlyFb2  = dlyFb*dlyFb;
  // --- FX-Eingangs-EQs. 0 Hz / 20 kHz = echter Bypass (nicht a=1).
  eqDLoOn = eqDLoHz > 0;     eqDHiOn = eqDHiHz < 20000;
  eqYLoOn = eqYLoHz > 0;     eqYHiOn = eqYHiHz < 20000;
  eqRLoOn = eqRLoHz > 0;     eqRHiOn = eqRHiHz < 20000;
  eqDLoA = eqDLoOn ? exp(-2*$pi*eqDLoHz/srate) : 0;
  eqDHiG = eqDHiOn ? 1 - exp(-2*$pi*eqDHiHz/srate) : 1;
  eqYLoA = eqYLoOn ? exp(-2*$pi*eqYLoHz/srate) : 0;
  eqYHiG = eqYHiOn ? 1 - exp(-2*$pi*eqYHiHz/srate) : 1;
  eqRLoA = eqRLoOn ? exp(-2*$pi*eqRLoHz/srate) : 0;
  eqRHiG = eqRHiOn ? 1 - exp(-2*$pi*eqRHiHz/srate) : 1;
  // --- Hall
  rhpA    = exp(-2*$pi*250/srate);
  rlpG    = 1 - exp(-2*$pi*3200/srate);
  cmbFb   = 0.7 + 0.25*roomSz;
  cmbDamp = 0.44 - 0.14*roomSz;              // kuerzeste Combs etwas toter
  preLen  = floor(min(0.012*srate, 8000));
);

/* ---------- Effekte ---------- */

// WaveShaper-Modelle (Eingang auf +-1 begrenzt wie ein Web-Audio-Shaper)
function distProc(x) local(c, t, m) (
  c = min(1, max(-1, x));
  distModel == 1 ? ( t = min(0.82, max(-0.82, c*4)); fastTanh(t*1.4); )
  : distModel == 2 ? ( t = c*1.7 + 1; m = t - 4*floor(t/4); (abs(m - 2) - 1)*0.82; )
  : distModel == 3 ? ( c >= 0 ? 1 - exp(-c*4.2) : -(1 - exp(c*2.1)); )
  : fastTanh(3.6*c);
);

// Freeverb-Comb — i = 0..15 (Kanal 0: 0..7, Kanal 1: 8..15)
function combProc(i, x) local(o, idx, y, s) (
  o = M_RVB + M_PAR[i];
  idx = M_PAR[32+i];
  y = o[idx];
  s = M_PAR[48+i]*cmbDamp + y*(1 - cmbDamp);
  M_PAR[48+i] = s;
  o[idx] = x + s*cmbFb;
  idx += 1; idx >= M_PAR[16+i] ? idx = 0;
  M_PAR[32+i] = idx;
  y;
);

// Freeverb-Allpass — i = 0..7
function apProc(i, x) local(o, idx, y) (
  o = M_RVB + M_PAR[64+i];
  idx = M_PAR[80+i];
  y = o[idx];
  o[idx] = x + 0.5*y;
  idx += 1; idx >= M_PAR[72+i] ? idx = 0;
  M_PAR[80+i] = idx;
  y - x;
);

/* ---------- Stimme ---------- */

// Der Slide der 303 laedt einen Kondensator auf die neue Steuerspannung um.
// Weil die Steuerspannung 1 V pro Oktave ist, ist das im Logfrequenzraum
// eine Exponentialannaeherung, keine Gerade. Hoerbar ist der Unterschied am
// Ende: die RC-Kurve laeuft weich aus, die Gerade knickt ab.
// slideSamps ist jetzt die Zeitkonstante tau, nicht die Gesamtdauer. Nach
// 3*tau sind 95 % erreicht, das entspricht ungefaehr der frueheren
// Gesamtdauer.
// Historie: bis v6 lineare Interpolation ueber slidePos/slideInc mit
//   slideF1 = curLog; slideF2 = tl; slidePos = 0; slideInc = 1/slideSamps;
// (konstante Zeit; die Schrittweite wurde einmal beim Start berechnet, damit
// ein Reglerwechsel mitten im Slide nicht durch null teilt). Der Reglerwert
// war die Gesamtdauer.
// OFFEN (LOGBUCH O2): slider11 bedeutet mit dieser Kurve tau; Default/Range
// wollen aus ref_slide.wav neu bestimmt werden, nicht geschaetzt.
function startSlide(tl) (
  slideSamps >= 1 ? (
    slideTgt = tl;
    slideCoef = 1 - exp(-1/slideSamps);
    sliding = 1;
  ) : ( curLog = tl; sliding = 0; );
);

// Accent-Anteil fuer sich: Kondensator nachladen und den Filter-Sweep
// starten. Steht getrennt, weil auch eine angebundene Slide-Note betont
// sein kann — dann darf genau dieser Teil feuern, die Huellkurven aber
// nicht neu anlaufen.
function fireAccent() (
  // Recovery: ausgeruhter Kondensator laedt kraeftiger nach (Devil-Fish)
  accBoost = accCap < 0.18 ? 1.08 : 0.95;
  accCap = min(1.65, accCap + accBoost);
  accentLed = 1;
  aEnv = 1;
  // Accent-Sweep: an Resonanz gekoppelt + leichte Cutoff-Abhaengigkeit
  // und sanfte Nichtlinearitaet (accCap^1.12) fuer dichtere Accents
  accOctCur = accN * (0.55 + 2.55*resN) * (0.92 + 0.08*cutN)
              * ((accCap/0.95)^1.12);
);

// Anschlag. acc = Accent ja/nein.
function startNote(acc) (
  accentNow = acc;
  acc ? fireAccent() : ( aEnv = 0; accOctCur = 0; );
  // Lautstaerke: Accent hebt an (leicht staerker bei hohen accCap)
  peakAmp = min(1, 0.5*(1 + (acc ? 0.88*accN*(accCap/0.95) : 0)));
  // Accent bekommt kuerzere Attack (1.8 ms) → spitzerer Anschlag
  attInc  = (peakAmp - amp)/max(1, (acc ? attSecAcc : attSec)*srate);
  envStage = 1; gateHeld = 1;
  mEnv = 1;
  mCoef = acc ? mDecAcc : mDecC;             // Accent = fixe 0,2 s
);

function voiceOn(n, acc) local(f, i, j) (
  // Dieselbe Note darf nur einmal im Stack stehen. Manche Controller und
  // manche Hosts schicken zwei Note-On ohne Note-Off dazwischen; stand die
  // Note dann doppelt drin, hat ein einzelnes Note-Off sie nicht mehr
  // vollstaendig entfernt und die Stimme blieb haengen. Ein vorhandener
  // Eintrag wird herausgenommen, die Note wandert dadurch nach oben und
  // die Letzte-Note-Prioritaet bleibt unveraendert.
  i = 0; j = 0;
  loop(stkN, M_STK[i] != n ? ( M_STK[j] = M_STK[i]; j += 1; ); i += 1; );
  stkN = j;
  stkN >= 32 ? ( i = 0; loop(31, M_STK[i] = M_STK[i+1]; i += 1; ); stkN = 31; );
  M_STK[stkN] = n; stkN += 1;
  noteCur = n;
  f = 440*2^((n - 69 + tuneSemi + fineCent*0.01)/12);
  stkN > 1 ? (
    startSlide(log(f));                      // Legato bindet, kein Retrigger
    // Ein angebundener Step darf trotzdem betont sein. Kondensator und
    // Filter-Sweep feuern, die Amplitudenhuellkurve bleibt unberuehrt —
    // sonst waere es ein Retrigger und kein Slide.
    acc ? ( accentNow = 1; fireAccent(); );
  ) : (
    curLog = log(f); sliding = 0;
    startNote(acc);
  );
);

function noteOff(n) local(i, j, v, found) (
  found = 0; j = 0; i = 0;
  loop(stkN,
    v = M_STK[i];
    !found && v == n ? found = 1 : ( M_STK[j] = v; j += 1; );
    i += 1;
  );
  stkN = j;
  stkN > 0 ? (
    M_STK[stkN-1] != noteCur ? (            // letzte-Note-Prioritaet
      noteCur = M_STK[stkN-1];
      startSlide(log(440*2^((noteCur - 69 + tuneSemi + fineCent*0.01)/12)));
    );
  ) : (
    gateHeld = 0;
    envStage == 1 || envStage == 2 ? envStage = 3 : 0;
  );
);

function allOff() (
  stkN = 0; gateHeld = 0;
  envStage == 1 || envStage == 2 ? envStage = 3 : 0;
);

/* ---------- Pattern ---------- */

// Nach dem Laden aus dem Projekt: alle Steps in gueltige Grenzen ziehen.
// Eine beschaedigte oder aeltere Datei koennte sonst Noten weit ausserhalb
// von SEQ_NLO..SEQ_NHI oder Flags ungleich 0/1 einschleusen — der Step-
// Editor zeichnet dann ins Leere und seqFire spielt unbrauchbare Noten.
function validateBanks() local(i, v) (
  i = 0;
  loop(4*SEQ_BANK,
    v = M_SEQ[i];
    (i & 3) == SF_NOTE ? ( M_SEQ[i] = min(SEQ_NHI, max(SEQ_NLO, floor(v + 0.5))); )
                       : ( M_SEQ[i] = v > 0.5 ? 1 : 0; );
    i += 1;
  );
);

function setStep(bb, s, n, g, a, sl) (
  M_SEQ[bb + s*4 + SF_NOTE]  = n; M_SEQ[bb + s*4 + SF_GATE]  = g;
  M_SEQ[bb + s*4 + SF_ACC]   = a; M_SEQ[bb + s*4 + SF_SLIDE] = sl;
);

function copyBank(src, dst) local(i) (
  src != dst ? ( i = 0; loop(SEQ_BANK, M_SEQ[dst + i] = M_SEQ[src + i]; i += 1; ); );
);

function saveUndo(bb) local(i) (
  i = 0; loop(SEQ_BANK, M_UNDO[i] = M_SEQ[bb + i]; i += 1; );
  undoArm = 1;
);
function loadUndo(bb) local(i) (
  undoArm ? ( i = 0; loop(SEQ_BANK, M_SEQ[bb + i] = M_UNDO[i]; i += 1; ); undoArm = 0; );
);

function clearBank(bb) local(s) (
  s = 0; loop(16, setStep(bb, s, 36, 0, 0, 0); s += 1; );
);

// Tonvorrat fuer den Zufall: Moll-Pentatonik ueber C2 — das ist die Lage,
// in der die typischen Acid-Linien sitzen.
function randNote() local(r) (
  r = rand(1);
  r < 0.44 ? 36 : r < 0.58 ? 39 : r < 0.70 ? 41
  : r < 0.80 ? 43 : r < 0.90 ? 46 : 48;
);

function randPattern(bb) local(s, n) (
  s = 0;
  loop(16,
    n = randNote();
    rand(1) < 0.12 ? n -= 12;                // ab und zu eine Oktave tiefer
    M_SEQ[bb + s*4 + SF_NOTE]  = min(SEQ_NHI, max(SEQ_NLO, n));
    M_SEQ[bb + s*4 + SF_GATE]  = rand(1) < 0.78;
    M_SEQ[bb + s*4 + SF_ACC]   = rand(1) < 0.22;
    M_SEQ[bb + s*4 + SF_SLIDE] = rand(1) < 0.16;
    s += 1;
  );
  // Der erste Step sitzt immer und betont, sonst faengt die Figur im
  // Nichts an und man hoert den Pattern-Anfang nicht.
  setStep(bb, 0, 36, 1, 1, 0);
);

// Mutation: nur ein paar Steps anfassen, der Rest bleibt wiedererkennbar.
function mutPattern(bb) local(k, s, r, n) (
  k = 0;
  loop(3,
    s = floor(rand(16));
    r = rand(1);
    r < 0.40 ? (
      n = randNote();
      M_SEQ[bb + s*4 + SF_NOTE] = min(SEQ_NHI, max(SEQ_NLO, n));
    ) : r < 0.62 ? (
      M_SEQ[bb + s*4 + SF_GATE] = 1 - M_SEQ[bb + s*4 + SF_GATE];
    ) : r < 0.82 ? (
      M_SEQ[bb + s*4 + SF_ACC] = 1 - M_SEQ[bb + s*4 + SF_ACC];
    ) : (
      M_SEQ[bb + s*4 + SF_SLIDE] = 1 - M_SEQ[bb + s*4 + SF_SLIDE];
    );
    k += 1;
  );
);

function defaultPattern() local(b, i) (
  setStep(0,  0, 36, 1, 1, 0);  setStep(0,  1, 36, 1, 0, 1);
  setStep(0,  2, 48, 1, 0, 0);  setStep(0,  3, 36, 1, 0, 0);
  setStep(0,  4, 39, 1, 1, 0);  setStep(0,  5, 36, 1, 0, 0);
  setStep(0,  6, 36, 0, 0, 0);  setStep(0,  7, 43, 1, 0, 1);
  setStep(0,  8, 43, 1, 0, 0);  setStep(0,  9, 36, 1, 0, 0);
  setStep(0, 10, 48, 1, 1, 0);  setStep(0, 11, 36, 1, 0, 0);
  setStep(0, 12, 41, 1, 0, 1);  setStep(0, 13, 41, 1, 0, 0);
  setStep(0, 14, 39, 1, 0, 0);  setStep(0, 15, 36, 0, 0, 0);
  b = 1; loop(3, copyBank(0, b*SEQ_BANK); b += 1; );
  // Bank D (Index 3): "PUMP" — importiert aus TT-303_pump_134bpm.mid
  // (134 BPM). Die MIDI ist zwei identische Takte lang; hier auf die
  // 16 Steps des einen Takts reduziert (nichts geht verloren). E2-Bass
  // mit Slide 0->1 (ueberlappende gleiche Note in der MIDI) und 10->11,
  // Akzente auf 0/1/8 (Velocity 112), Rest Velocity 80.
  setStep(3*SEQ_BANK,  0, 40, 1, 1, 1);  setStep(3*SEQ_BANK,  1, 40, 1, 1, 0);
  setStep(3*SEQ_BANK,  2, 36, 0, 0, 0);  setStep(3*SEQ_BANK,  3, 40, 1, 0, 0);
  setStep(3*SEQ_BANK,  4, 36, 0, 0, 0);  setStep(3*SEQ_BANK,  5, 28, 1, 0, 0);
  setStep(3*SEQ_BANK,  6, 40, 1, 0, 0);  setStep(3*SEQ_BANK,  7, 36, 0, 0, 0);
  setStep(3*SEQ_BANK,  8, 43, 1, 1, 0);  setStep(3*SEQ_BANK,  9, 36, 0, 0, 0);
  setStep(3*SEQ_BANK, 10, 31, 1, 0, 1);  setStep(3*SEQ_BANK, 11, 31, 1, 0, 0);
  setStep(3*SEQ_BANK, 12, 31, 1, 0, 0);  setStep(3*SEQ_BANK, 13, 43, 1, 0, 0);
  setStep(3*SEQ_BANK, 14, 36, 0, 0, 0);  setStep(3*SEQ_BANK, 15, 31, 1, 0, 0);
);

/* ---------- Sequencer ---------- */

// MIDI nach draussen. Der Offset ist die Position im laufenden Block,
// dadurch bleibt die Sequenz auch am Ausgang sample-genau.
function seqSendOn(n, acc)  ( midiOut ? midisend(smplPos, 0x90, n, acc ? 127 : 100); );
function seqSendOff(n)      ( midiOut ? midisend(smplPos, 0x80, n, 0); );

function seqRelease() (
  seqHeld >= 0 ? ( noteOff(seqHeld); seqSendOff(seqHeld); seqHeld = -1; );
  gateLeft = 0;
);

// Einen Step ausloesen. Das Slide-Flag eines Steps bindet ihn an den
// FOLGENDEN — deshalb entscheidet prevSlide ueber Legato oder Retrigger.
function seqFire(s) local(n, a, oldHeld) (
  curStepDisp = s;
  M_SEQ[bankBase + s*4 + SF_GATE] ? (
    n = min(120, max(0, M_SEQ[bankBase + s*4 + SF_NOTE] + seqTrans));
    a = M_SEQ[bankBase + s*4 + SF_ACC];
    prevSlide ? (
      // Gleiche Zielnote nicht vom Stack nehmen — sonst stirbt der Slide-Ton
      oldHeld = seqHeld;
      voiceOn(n, a); seqSendOn(n, a);
      oldHeld >= 0 && oldHeld != n ? ( noteOff(oldHeld); seqSendOff(oldHeld); );
    ) : (
      seqHeld >= 0 ? ( noteOff(seqHeld); seqSendOff(seqHeld); );
      voiceOn(n, a); seqSendOn(n, a);
    );
    seqHeld = n;
    prevSlide = M_SEQ[bankBase + s*4 + SF_SLIDE];
    gateLeft = prevSlide ? -1 : max(1, gateFrac*stepSamps);
  ) : (
    seqRelease();
    prevSlide = 0;
  );
);

/* ---------- MIDI ---------- */

// m1 & 0xF0 liefert 0x90 / 0x80 / 0xB0 — genau so muss verglichen werden.
function handleMidi(m1, m2, m3) local(st, nv) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? (
    seqMode ? ( midiHeld += 1; seqTrans = m2 - 36; )
            : voiceOn(m2, m3 >= accThresh);
  )
  : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    seqMode ? ( midiHeld = max(0, midiHeld - 1); midiHeld == 0 ? seqTrans = 0; )
            : noteOff(m2);
  )
  : st == 0xB0 ? (
    m2 == 123 || m2 == 120 ? ( allOff(); midiHeld = 0; seqTrans = 0; )
    : m2 == 74 ? ( slider5  = m3 * 100 / 127; slider_automate(slider5);  paramsDirty = 1; )  // Cutoff
    : m2 == 71 ? ( slider6  = m3 * 100 / 127; slider_automate(slider6);  paramsDirty = 1; )  // Res
    : m2 == 73 ? ( slider7  = m3 * 100 / 127; slider_automate(slider7);  paramsDirty = 1; )  // Env
    : m2 == 75 ? ( slider8  = m3 * 100 / 127; slider_automate(slider8);  paramsDirty = 1; )  // Decay
    : m2 == 16 ? ( slider9  = m3 * 100 / 127; slider_automate(slider9);  paramsDirty = 1; )  // Accent
    : m2 ==  7 ? ( slider10 = m3 * 100 / 127; slider_automate(slider10); paramsDirty = 1; )  // Volume
    : 0;
  )
  : 0;
);

/* ---------- Oberflaechen-Bausteine ----------
   Alles wird im Designraster 900 x 732 angegeben. SC ist der Faktor auf
   die tatsaechliche Fenstergroesse, OX/OY zentrieren das Bild. Die Maus
   wird umgekehrt ins Raster zurueckgerechnet (mX/mY), damit Treffertests
   und Zieh-Empfindlichkeit unabhaengig vom Zoom bleiben.             */

// Vergebene Zieh-IDs (dragId), damit sich spaetere Erweiterungen nicht
// ins Gehege kommen:
//   1..17      Drehregler
//   20..25     Griffe der drei Dual-EQ-Streifen
//   1000..1015 Spalten im Step-Editor
// Frei: 18/19, 26..999, ab 1016.

function xrect(x, y, w, h) (
  gfx_rect(OX + x*SC, OY + y*SC, max(1, w*SC), max(1, h*SC), 1);
);
function xline(x1, y1, x2, y2) (
  gfx_line(OX + x1*SC, OY + y1*SC, OX + x2*SC, OY + y2*SC, 1);
);
function xcirc(x, y, r, f) (
  gfx_circle(OX + x*SC, OY + y*SC, max(1, r*SC), f, 1);
);
function xat(x, y) ( gfx_x = OX + x*SC; gfx_y = OY + y*SC; );
function xstr(x, y, s) ( xat(x, y); gfx_drawstr(s); );
function xctr(x, y, w, h, s) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = OX + x*SC + (w*SC - tw)*0.5;
  gfx_y = OY + y*SC + (h*SC - th)*0.5;
  gfx_drawstr(s);
);
function inBox(bx, by, bw, bh) (
  mX >= bx && mX < bx + bw && mY >= by && mY < by + bh;
);

// Kernfarben aus dem Designkit
function colAcid(a)  ( gfx_set(0.224, 1.000, 0.078, a); );   // #39FF14
function colDim(a)   ( gfx_set(0.130, 0.340, 0.090, a); );
function colWhite(a) ( gfx_set(1, 1, 1, a); );
function colInk(a)   ( gfx_set(0.75, 0.81, 0.75, a); );

// Loetpunkt am Ende einer Leitbahn
function pad(x, y, r) (
  colAcid(1); xcirc(x, y, r, 1);
  gfx_set(0, 0, 0, 1); xcirc(x, y, r*0.40, 1);
);

// Leitbahn: waagerecht bis zum Knick, dann 45 Grad
function trace(x1, y1, x2, y2) local(kx) (
  kx = x2 - abs(y2 - y1);
  colDim(1);
  xline(x1, y1, kx, y1);
  xline(kx, y1, x2, y2);
);

function panelBox(x, y, w, h) (
  gfx_set(0.072, 0.077, 0.072, 1); xrect(x, y, w, h);
  gfx_set(0.125, 0.155, 0.115, 1);
  xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
  xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
);

// Schalter. Rueckgabe 1, wenn in diesem Frame geklickt wurde.
function btn(x, y, w, h, on, s) local(hit, hov) (
  hov = inBox(x, y, w, h);
  hit = uiClick && hov;
  on ? (
    colAcid(0.88); xrect(x, y, w, h);
    gfx_set(0, 0, 0, 1);
  ) : (
    gfx_set(0.098, 0.103, 0.098, 1); xrect(x, y, w, h);
    hov ? gfx_set(0.30, 0.46, 0.26, 1) : gfx_set(0.15, 0.20, 0.14, 1);
    xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
    xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
    hov ? gfx_set(0.85, 0.95, 0.82, 1) : gfx_set(0.78, 0.84, 0.76, 1);
  );
  xctr(x, y, w, h, s);
  hit;
);

// Drehregler. Senkrecht ziehen, Shift = fein, Mausrad geht auch.
// Gibt den (evtl. geaenderten) Wert zurueck.
function knobDef(id) (
  id == 1 ? 0 : id == 2 ? 0 : id == 3 ? 32 : id == 4 ? 55 : id == 5 ? 62
  : id == 6 ? 35 : id == 7 ? 60 : id == 8 ? 70 : id == 9 ? 8 : id == 10 ? 15
  : id == 11 ? 60 : id == 12 ? 18 : id == 13 ? 70 : id == 14 ? 60
  : id == 15 ? 16 : id == 16 ? 0 : id == 17 ? 55 : id == 18 ? 100 : 0;
);

function knob(id, cx, cy, r, val, vmn, vmx)
  local(t, i, a, ri, ro, nv, dv, hot, sh, def, nTick) (
  nv = val;
  def = knobDef(id);
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = (mX - cx)*(mX - cx) + (mY - cy)*(mY - cy) <= (r + 7)*(r + 7);
  uiRClk && hot ? ( nv = def; )
  : uiClick && hot ? (
      clickId == id && clickWait > 0 ? ( nv = def; dragId = -1; clickWait = 0; )
      : ( dragId = id; dragY = mY; dragV = val; dragSh = sh; clickId = id; clickWait = 12; );
    );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh; dragY = mY; dragV = val; );
    dv = (dragY - mY)/(sh ? 900 : 170);
    nv = min(vmx, max(vmn, dragV + dv*(vmx - vmn)));
  );
  hot && mouse_wheel != 0 ? (
    nv = min(vmx, max(vmn, val + (mouse_wheel/120)*(vmx - vmn)*0.02));
    mouse_wheel = 0;
  );
  t = (nv - vmn)/(vmx - vmn);
  gfx_set(0.105, 0.110, 0.105, 1); xcirc(cx, cy, r - 5, 1);
  hot || dragId == id ? gfx_set(0.26, 0.40, 0.24, 1) : gfx_set(0.15, 0.19, 0.14, 1);
  xcirc(cx, cy, r - 5, 0);
  nTick = (hot || dragId == id) ? 24 : 12;
  i = 0;
  loop(nTick + 1,
    a = (-225 + 270*i/nTick)*$pi/180;
    ri = r - 3; ro = r + 1;
    i/nTick <= t ? colAcid(1) : gfx_set(0.16, 0.18, 0.15, 1);
    xline(cx + cos(a)*ri, cy + sin(a)*ri, cx + cos(a)*ro, cy + sin(a)*ro);
    i += 1;
  );
  a = (-225 + 270*t)*$pi/180;
  colWhite(1);
  xline(cx + cos(a)*(r - 16), cy + sin(a)*(r - 16), cx + cos(a)*(r - 7), cy + sin(a)*(r - 7));
  gfx_set(0.30, 0.34, 0.30, 1); xcirc(cx, cy, 2, 1);
  nv;
);

// Zeichenkette in #vstr zentriert bei (cx, y) — Schrift vorher setzen
function drawCentered(cx, y) local(w, h) (
  gfx_measurestr(#vstr, w, h);
  xat(cx - w*0.5, y); gfx_drawstr(#vstr);
);

// Beschriftung: Label (#klbl) in grau, Wert (#kval) in Acid-Gruen,
// ab linker Kante x0. Die Position berechnet der Aufrufer aus den
// gemessenen Breiten, damit nichts mit dem Nachbartext kollidiert.
function kvLabel(x0, y) local(lw, vh) (
  gfx_setfont(3);
  gfx_measurestr(#klbl, lw, vh);
  xat(x0, y); colInk(1); gfx_drawstr(#klbl);
  xat(x0 + lw + 6, y); colAcid(1); gfx_drawstr(#kval);
);

/* ---------- Dual-EQ-Slider unter jeder Effekteineheit ----------
   Logarithmische Skala 20 Hz .. 20 kHz: f = 20*1000^t. Die linke
   Kante (t = 0) ist der Lowcut und rastet auf OFF (0 Hz), die rechte
   (t = 1) der Highcut auf OFF (20 kHz). Rechtsklick auf einen Griff
   stellt die Werkseinstellung zurueck.                              */

// Position im Streifen (0..1) fuer eine Frequenz: log(hz/20)/log(1000)
// — 20 Hz ganz links, 20 kHz ganz rechts, OFF (0 Hz) auf der linken
// Kante. Umrechnung und Rueckweg in fxEq muessen spiegelbildlich sein,
// sonst springt der Griff beim Greifen.
function eqT(hz) ( min(1, max(0, log(max(20, hz)*0.05)*0.144764827)); );

// Kompakte Frequenzanzeige in #vstr
function hzTxt(hz) (
  hz <= 0 || hz >= 20000 ? sprintf(#vstr, "OFF")
  : hz >= 9950 ? sprintf(#vstr, "%dk", floor(hz*0.001 + 0.5))
  : hz >= 1000 ? sprintf(#vstr, "%.1fk", hz*0.001)
  : sprintf(#vstr, "%d", floor(hz + 0.5));
);

// Lauf des Streifens; das Feld zwischen den Griffen ist das
// durchgelassene Band
function eqTrack(x, y, w, tLo, tHi) (
  gfx_set(0.092, 0.097, 0.092, 1); xrect(x, y, w, 6);
  tHi > tLo ? ( colAcid(0.30); xrect(x + tLo*w, y + 1, (tHi - tLo)*w, 4); );
);

// Ein Griff: side 0 = Lowcut (links), side 1 = Highcut (rechts).
// Diese Funktion rechnet nur, gezeichnet wird in eqHandle.
//
// Der Wegfaktor ist die Streifenbreite w, nicht mehr die feste 170 der
// Drehregler. Nur so laeuft der Griff genau unter dem Mauszeiger mit.
// Bei einem 284 Punkt breiten Streifen lief er mit 170 um den Faktor
// 1,67 zu schnell — deshalb zogen die EQ-Slider nicht sauber mit.
// Shift = fuenffach fein, mit mitwanderndem Bezugspunkt.
function fxEqVal(id, x, y, w, hz, side, defHz)
  local(t, hot, nv, hx, sh) (
  t  = eqT(hz);
  hx = x + t*w;
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = mX >= hx - 8 && mX <= hx + 8 && mY >= y - 7 && mY <= y + 11;
  nv = hz;
  uiRClk && hot ? ( nv = defHz; )
  : uiClick && hot ? ( dragId = id; dragX = mX; dragT = t; dragSh = sh; );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh; dragX = mX; dragT = t; );
    t = min(1, max(0, dragT + (mX - dragX)/(sh ? w*5 : w)));
    nv = floor(20*1000^t + 0.5);
    side == 0 ? ( nv = t < 0.02 ? 0 : nv; ) : ( nv = t > 0.98 ? 20000 : nv; );
  ) : (
    hot && mouse_wheel != 0 ? (
      t = min(1, max(0, t + (mouse_wheel/120)*0.05));
      nv = floor(20*1000^t + 0.5);
      side == 0 ? ( nv = t < 0.02 ? 0 : nv; ) : ( nv = t > 0.98 ? 20000 : nv; );
      mouse_wheel = 0;
    );
  );
  nv;
);

// Ein Griff, nur zeichnen. Getrennt vom Rechnen, damit das durch-
// gelassene Band im selben Bild steht wie der Griff — vorher lief der
// Streifen dem Griff beim Ziehen ein Bild hinterher.
function eqHandle(id, x, y, w, hz) local(hx) (
  hx = x + eqT(hz)*w;
  dragId == id || (mX >= hx - 8 && mX <= hx + 8 && mY >= y - 7 && mY <= y + 11)
    ? colAcid(1) : gfx_set(0.17, 0.44, 0.12, 1);
  xrect(hx - 4, y - 4, 8, 14);
  gfx_set(0, 0, 0, 1); xrect(hx - 1, y, 2, 6);
);

// LO/HI-Beschriftung mit Frequenzwerten unter einem EQ-Streifen
function eqLabels(x, y, w, loHz, hiHz) local(a, b, c, d, x0) (
  gfx_setfont(3);
  hzTxt(loHz); gfx_measurestr(#vstr, a, b);
  gfx_measurestr("LO", c, d);
  xat(x, y); colInk(1); gfx_drawstr("LO");
  xat(x + c + 5, y); colAcid(0.85); gfx_drawstr(#vstr);
  hzTxt(hiHz); gfx_measurestr(#vstr, a, b);
  gfx_measurestr("HI", c, d);
  x0 = x + w - (a + 5 + c);
  xat(x0, y); colInk(1); gfx_drawstr("HI");
  xat(x0 + c + 5, y); colAcid(0.85); gfx_drawstr(#vstr);
);

// Notenname, z. B. "C#2" — zeichnet an der aktuellen Textposition
function noteName(n) local(k, o) (
  k = n - 12*floor(n/12); o = floor(n/12) - 1;
  k == 0 ? gfx_drawstr("C") : k == 1 ? gfx_drawstr("C#") : k == 2 ? gfx_drawstr("D")
  : k == 3 ? gfx_drawstr("D#") : k == 4 ? gfx_drawstr("E") : k == 5 ? gfx_drawstr("F")
  : k == 6 ? gfx_drawstr("F#") : k == 7 ? gfx_drawstr("G") : k == 8 ? gfx_drawstr("G#")
  : k == 9 ? gfx_drawstr("A") : k == 10 ? gfx_drawstr("A#") : gfx_drawstr("B");
  gfx_printf("%d", o);
);

// Liegt diese Note gerade im Stack? (fuer die Tastaturanzeige)
function noteHeld(n) local(i, r) (
  r = 0; i = 0;
  loop(stkN, M_STK[i] == n ? r = 1; i += 1; );
  r;
);

/* ---------- Klangvorlagen ---------- */

// Klangvorlagen fuer die v8-Engine neu abgestimmt (Release v1.0). Die alten
// Werte stammten aus der v6/v7-Engine, in der Cutoff 60 Hz..6 kHz und Decay
// 60 ms..2,5 s spannten; seit v8 ist das ~145 Hz..~1 kHz bzw. 30..570 ms, die
// Resonanz traegt immer schon Q~1,6 und wirkt deutlich staerker. Angepasst
// wurde daher: Cutoff der hellen Patches hoch (SCREAM 58->72, HOOVER 64->74,
// SQUELCH 38->52), Resonanz der heissen Patches runter (SQUELCH 86->80,
// SCREAM 95->88, HOOVER 72->68), Decay von DUB in den langen Bereich
// (48->82 ~ 340 ms) und von SCREAM/SQUELCH kuerzer. SCREAM und HOOVER
// bleiben SQUARE. INIT setzt jetzt zusaetzlich Comp AN/100 % und die
// Delay-/Hall-Eingangs-EQs (250 Hz..3,0 kHz bzw. 300 Hz..2,3 kHz).
// Historie (v6/v7-Engine):
//   DEEP    s5=16 s6=48 s7=42 s8=58 s9=38  s15=7  s16=18 s18=52 s19=20
//   SQUELCH s5=38 s6=86 s7=78 s8=25 s9=78  s15=7  s16=16 s18=64 s19=14
//   SCREAM  s5=58 s6=95 s7=88 s8=18 s9=92  s15=18 s16=10 s18=58 s19=10
//   HOOVER  s5=64 s6=72 s7=92 s8=68 s9=72  s15=11 s16=22 s18=68 s19=22
//   DUB     s5=20 s6=58 s7=48 s8=48 s9=52  s15=7  s16=48 s18=78 s19=42
//   INIT    ... s29=300 s30=20000 s31=0 s32=20000, Comp unberuehrt
function applyPatch(p) (
  p == 1 ? ( slider2 = 0; slider5 = 14; slider6 = 40; slider7 = 40; slider8 = 64;
             slider9 = 35; slider13 = 0; slider14 = 0; slider15 = 7;
             slider16 = 14; slider18 = 50; slider19 = 16; )                       // DEEP
  : p == 2 ? ( slider2 = 0; slider5 = 52; slider6 = 80; slider7 = 82; slider8 = 22;
               slider9 = 80; slider13 = 1; slider14 = 0; slider15 = 8;
               slider16 = 16; slider18 = 62; slider19 = 12; )                     // SQUELCH
  : p == 3 ? ( slider2 = 1; slider5 = 72; slider6 = 88; slider7 = 92; slider8 = 15;
               slider9 = 95; slider13 = 1; slider14 = 1; slider15 = 16;
               slider16 = 10; slider18 = 55; slider19 = 9; )                      // SCREAM
  : p == 4 ? ( slider2 = 1; slider5 = 74; slider6 = 68; slider7 = 96; slider8 = 55;
               slider9 = 70; slider13 = 1; slider14 = 2; slider15 = 11;
               slider16 = 20; slider18 = 62; slider19 = 24; )                     // HOOVER
  : p == 5 ? ( slider2 = 0; slider5 = 18; slider6 = 52; slider7 = 44; slider8 = 82;
               slider9 = 50; slider13 = 0; slider14 = 0; slider15 = 7;
               slider16 = 46; slider18 = 80; slider19 = 44; )                     // DUB
  : ( slider2 = 0; slider5 = 32; slider6 = 55; slider7 = 62; slider8 = 35;
      slider9 = 60; slider11 = 60; slider13 = 0; slider14 = 0; slider15 = 8;
      slider16 = 15; slider17 = 1; slider18 = 60; slider19 = 18; slider20 = 70;
      slider27 = 0; slider28 = 20000; slider29 = 250; slider30 = 3000;
      slider31 = 300; slider32 = 2300; slider34 = 1; slider35 = 100; );           // INIT
  slider_automate(slider2);  slider_automate(slider5);  slider_automate(slider6);
  slider_automate(slider7);  slider_automate(slider8);  slider_automate(slider9);
  slider_automate(slider11); slider_automate(slider13); slider_automate(slider14);
  slider_automate(slider15); slider_automate(slider16); slider_automate(slider17);
  slider_automate(slider18); slider_automate(slider19); slider_automate(slider20);
  slider_automate(slider27); slider_automate(slider28); slider_automate(slider29);
  slider_automate(slider30); slider_automate(slider31); slider_automate(slider32);
  slider_automate(slider34); slider_automate(slider35);
  patchSel = p;
  paramsDirty = 1;
);

/* ---------- Grundzustand ---------- */

readSliders();

// Zwei memsets: die Pattern-Luecke bleibt unberuehrt.
memset(0, 0, M_SEQ);
memset(M_SEQEND, 0, MEMTOP - M_SEQEND);

// Freeverb: 8 Combs + 4 Allpaesse je Kanal, Laengen skalieren mit srate
M_PAR[16] = ceil(1116*rvSc); M_PAR[17] = ceil(1188*rvSc);
M_PAR[18] = ceil(1277*rvSc); M_PAR[19] = ceil(1356*rvSc);
M_PAR[20] = ceil(1422*rvSc); M_PAR[21] = ceil(1491*rvSc);
M_PAR[22] = ceil(1557*rvSc); M_PAR[23] = ceil(1617*rvSc);
i = 0; loop(8, M_PAR[24+i] = M_PAR[16+i] + rvSpread; i += 1; );
p = 0;
i = 0; loop(8, M_PAR[i]   = p; p += M_PAR[16+i]; i += 1; );
i = 0; loop(8, M_PAR[8+i] = p; p += M_PAR[24+i]; i += 1; );
M_PAR[72] = ceil(556*rvSc); M_PAR[73] = ceil(441*rvSc);
M_PAR[74] = ceil(341*rvSc); M_PAR[75] = ceil(225*rvSc);
i = 0; loop(4, M_PAR[76+i] = M_PAR[72+i] + rvSpread; i += 1; );
i = 0; loop(4, M_PAR[64+i] = p; p += M_PAR[72+i]; i += 1; );
i = 0; loop(4, M_PAR[68+i] = p; p += M_PAR[76+i]; i += 1; );

updateParams();

// Startpattern nur beim allerersten Mal — danach stehen hier entweder die
// selbst gebauten Baenke oder die aus dem Projekt geladenen.
patInit != 1 ? ( defaultPattern(); patInit = 1; );

// Stimme
stkN = 0; gateHeld = 0; envStage = 0; amp = 0; peakAmp = 0.5; accentNow = 0;
accCap = 0; sliding = 0; slideTgt = 0; slideCoef = 0; noteCur = 36;
curLog = log(65.406); phase = 0;
mEnv = 0; aEnv = 0; mCoef = 1; accOctCur = 0;
s1 = 0; s2 = 0; s3 = 0; y3prev = 0;
oscHpY = 0; oscHpX = 0; sqHpY = 0; sqHpX = 0; fbHpY = 0; fbHpX = 0;
// Effektzustand
envDb = -100; dlyPos = 0; prePos = 0;
hpY = 0; hpPrev = 0; lpL = 0; lpR = 0;
dHpY = 0; dHpX = 0; dLpY = 0; dlyLpY = 0;    // FX-Eingangs-EQs
dPrevIn = 0; dsPrev = 0;                     // Drive-Oversampling
rvHpY = 0; rvHpX = 0; rvLpY = 0;
rhpL = 0; rhpXL = 0; rlpL = 0; rhpR = 0; rhpXR = 0; rlpR = 0;
scopePos = 0; accentLed = 0; bpmNow = 120;
dlySamps = min(dlyBufLen - 4, 0.75*(60/120)*srate);
// Ablaufsteuerung
evN = 0; evRd = 0; smplPos = 0; paramsDirty = 0;
seqHeld = -1; prevSlide = 0; gateLeft = 0; lastStep = -1; seqPos = 0;
curStepDisp = 0; seqTrans = 0; midiHeld = 0; seqRunning = 0; modePrev = -1;
stepSamps = srate*0.125; stepInc = 1/stepSamps;
// Oberflaeche
SC = 1; OX = 0; OY = 0; mX = -1; mY = -1;
dragId = -1; dragX = 0; dragY = 0; dragV = 0; dragT = 0; dragSh = 0;
bigSel = 0;
paintRow = -1; lmbPrev = 0; rmbPrev = 0;
monoSel = 0; sansSel = 0; fontChk = 0; patchSel = 0; copyArm = 0;
fBigP = -1; fMedP = -1; fSmlP = -1;
clickId = -1; clickWait = 0; undoArm = 0;
fcPrev = -1; osPrev = 0; osA = 0; osB = 0; scopeDiv = 0;
rvbWas = rvbMix > 0.005;      // Zustand des Hall-Bypass, s. @sample
g = 0; G = 0;

/* ============================================================
   @serialize — alle vier Baenke wandern ins Projekt und in Presets
   ============================================================ */
@serialize

seqVer = 2;
file_var(0, seqVer);
file_mem(0, M_SEQ, 4*SEQ_BANK);
// Laeuft in beide Richtungen. Beim Schreiben ist es ein No-Op, weil die
// Werte ohnehin gueltig sind; beim Lesen faengt es beschaedigte oder
// fremde Daten ab. Kuenftige Formatwechsel gehoeren ueber seqVer hierher.
validateBanks();
patInit = 1;

/* ============================================================
   @slider
   ============================================================ */
@slider

readSliders();
updateParams();

/* ============================================================
   @block — Transport, Taktung, MIDI einsammeln
   ============================================================ */
@block

paramsDirty ? ( readSliders(); updateParams(); paramsDirty = 0; );

bpmNow    = tempo > 10 ? tempo : 120;
stepSamps = max(16, srate*15/bpmNow);        // ein 16tel in Samples
stepInc   = 1/stepSamps;
dlySamps  = min(dlyBufLen - 4, (60/bpmNow)*dlyDiv*srate);

// Moduswechsel sauber abfangen
seqMode != modePrev ? (
  modePrev = seqMode;
  seqRelease(); allOff();
  midiHeld = 0; seqTrans = 0; lastStep = -1; prevSlide = 0;
);

hostPlay = play_state & 1;
seqWant  = seqMode && (hostPlay || freeRun);
seqWant != seqRunning ? (
  seqRunning = seqWant;
  seqRunning ? (
    prevSlide = 0;
    hostPlay ? ( seqPos = beat_position*4; ) : ( seqPos = 0; );
    lastStep = floor(seqPos) - 1;             // Step unter dem Cursor feuert
  ) : ( seqRelease(); );
);
// An der Timeline haengen, aber NICHT jeden Block hart neu setzen.
// beat_position rundet, und wenn seqPos im @sample gerade ueber eine
// Step-Grenze gelaufen ist, schiebt der Blockanfang es minimal zurueck —
// der Step feuert dann doppelt oder faellt aus. Das war der Timing-
// Jitter. Nachgezogen wird nur bei echtem Versatz: Loop-Sprung,
// Positionswechsel, Tempoaenderung. 0,02 Steps sind bei 130 BPM 2,3 ms.
seqRunning && hostPlay ? (
  tgtPos = beat_position*4;
  abs(tgtPos - seqPos) > 0.02 ? (
    seqPos = tgtPos;
    lastStep = floor(seqPos) - 1;
  );
);

// MIDI mit Offset in die Queue, Ausloesung erfolgt sample-genau im @sample
evN = 0; evRd = 0; smplPos = 0;
while (midirecv(offs, m1, m2, m3)) (
  evN < EVT_MAX ? (
    M_EVT[evN*4] = offs;   M_EVT[evN*4+1] = m1;
    M_EVT[evN*4+2] = m2;   M_EVT[evN*4+3] = m3;
    evN += 1;
  ) : ( handleMidi(m1, m2, m3); );
  // Instrument: Noten werden verbraucht. CC/Pitchbend/Clock gehen weiter.
  stThru = m1 & 0xF0;
  midiThru ? midisend(offs, m1, m2, m3)
           : ( stThru != 0x80 && stThru != 0x90 ? midisend(offs, m1, m2, m3) );
);

// --- Pattern-Export fuer das Companion-ReaScript tt303_pattern_to_midi.lua.
// Spiegelt die GERADE ANGEZEIGTE Bank (slider25) unveraendert nach gmem.
// Reines Kopieren aus M_SEQ, kein DSP, keine Rueckwirkung auf den Klang.
// gmem-Layout: MIDI_EXPORT_BRIDGE.md, Abschnitt 3. Neue Bezeichner
// exBase/exI (im v8 sonst nirgends belegt).
gmem[0] = 30303;                     // Handschlag / Magic
gmem[1] = 1;                         // Layout-Version
gmem[2] = gmem[2] + 1;               // Heartbeat: laufende Instanz
gmem[3] = floor(slider25);           // angezeigte Bank 0..3 (A..D)
gmem[4] = slider21;                  // SEQ Pattern-Laenge, roh (Script klemmt 1..16)
gmem[5] = slider23;                  // globales SEQ GATE % (Nicht-Slide-Steps)
gmem[6] = slider22;                  // SEQ SHUFFLE %
gmem[7] = 36;                        // Notennummer der Originallage (C2)
exBase = floor(slider25)*SEQ_BANK;
exI = 0;
loop(64,
  gmem[8 + exI] = M_SEQ[exBase + exI];
  exI += 1;
);

/* ============================================================
   @sample — eine Stimme, Signalweg wie in der Hardware
   ============================================================ */
@sample

// --- faellige MIDI-Ereignisse
while (evRd < evN && M_EVT[evRd*4] <= smplPos) (
  handleMidi(M_EVT[evRd*4+1], M_EVT[evRd*4+2], M_EVT[evRd*4+3]);
  evRd += 1;
);

// --- Sequencer-Uhr. Ungerade Steps wandern beim Shuffle nach hinten.
seqRunning ? (
  seqPos += stepInc;
  stepIdx = floor(seqPos);
  sFrac = seqPos - stepIdx;
  ((stepIdx & 1) ? sFrac >= swFrac : 1) && stepIdx != lastStep ? (
    lastStep = stepIdx;
    seqFire(stepIdx - patLen*floor(stepIdx/patLen));
  );
  gateLeft > 0 ? ( gateLeft -= 1; gateLeft <= 0 ? seqRelease(); );
);

// --- Slide. RC-Annaeherung im Logfrequenzraum (Kondensator-Umladung), seit
//     v7. Historie: bis v6 lineare Interpolation
//     curLog = slideF1 + (slideF2 - slideF1)*slidePos  ueber slidePos/slideInc.
sliding ? (
  curLog += (slideTgt - curLog)*slideCoef;
  // Abbruch, wenn der Rest unter einem Cent liegt (ln(2)/1200 = 0.000578)
  abs(slideTgt - curLog) < 0.0005 ? ( curLog = slideTgt; sliding = 0; );
);
freq = exp(curLog);

// --- Huellkurven. Accent laeuft auf einer zweiten, schnelleren Kurve,
//     der Kondensator entlaedt sich unabhaengig davon weiter.
mEnv *= mCoef;
aEnv *= aDecC;
accCap *= accDecC;
fc = baseF*exp((envOct*mEnv + accOctCur*aEnv)*0.6931472);
fc = min(fcMax, max(30, fc));

// --- VCA
envStage == 1 ? (
  amp += attInc;
  (attInc >= 0 ? amp >= peakAmp : amp <= peakAmp) ? ( amp = peakAmp; envStage = 2; );
);
envStage == 2 ? amp *= susCoef;
envStage == 3 ? ( amp *= relCoef; amp < 0.00002 ? ( amp = 0; envStage = 0; ); );

needVoice = amp > 0.00002 || stkN > 0 || envStage > 0 || sliding;

needVoice ? (
  // tan() nur nachrechnen, wenn sich fc wirklich bewegt. Die Schwelle ist
  // RELATIV (0,15 Promille), nicht absolut — eine feste Grenze in Hertz
  // waere bei 60 Hz Cutoff eine hoerbare Quantisierung und bei 6 kHz
  // wirkungslos gewesen.
  abs(fc - fcPrev) > fc*0.00015 ? (
    fcPrev = fc;
    g = tan($pi*fc*poleScale/SRX);
    G = g/(1 + g);
  );
  inc  = min(max(freq, 8), 0.45*SRX)/SRX;
  A    = G*G*G;
  // Das Rechteck der 303 kommt aus einem Transistor-Komparator mit
  // unsymmetrischem Arbeitspunkt. Der Versatz geht in hohen Lagen zurueck,
  // weil die Umladezeit dort einen groesseren Anteil der Periode ausmacht.
  // Historie: bis v8  sqDuty = 0.53 - 0.025*min(1, freq*0.0005)  (fast 50 %).
  // Task B6, gemessen an ref_f_c50_r50_sq.wav (tt303_b6_fit.py): die Referenz-
  // Square hat kraeftige GERADE Harmonische (H2 -7, H4 -3, H6 -3 dB re H1) und
  // spektrale Nullstellen bei H5/H10/H15 -> Duty ~1/5. Bei 0,53 fehlten die
  // geraden Harmonischen 10..14 dB (Eindruck "zu hohl/anders"). 0,19 senkt
  // den gewichteten Harmonischen-RMS-Fehler 8,1 -> 4,9 dB. Der freq-Term
  // (Drift bei hoher Lage) bleibt; ueber den spielbaren Bereich < 0,01 Duty,
  // Richtung nicht separat vermessen.
  sqDuty = waveSel ? (0.19 - 0.025*min(1, freq*0.0005)) : 0.5;
  osA = 0; osB = 0; osi = 0;
  loop(2,
    phase += inc; phase >= 1 ? phase -= 1;
    waveSel ? (
      // zweite Flanke bei phase = sqDuty, also (phase - sqDuty) mod 1
      tp = phase + (1 - sqDuty); tp -= floor(tp);
      sqRaw = (phase < sqDuty ? 1 : -1)
            + polyBlep(phase, inc) - polyBlep(tp, inc);
      sqHpY = sqHpA*(sqHpY + sqRaw - sqHpX); sqHpX = sqRaw;
      oscv = sqHpY;
    ) : (
      oscv = 2*phase - 1 - polyBlep(phase, inc);
    );
    oscHpY = oscHpA*(oscHpY + oscv - oscHpX); oscHpX = oscv;
    xin = softSat(oscHpY*0.8);

    // Pegelabhaengige Rueckkopplung: gehoert IN die Ueberabtastung, sonst
    // rechnet der zweite Durchlauf mit dem Wert vom vorigen Sample.
    kEff = kRes/(1 + 0.4*abs(y3prev));

    // Hochpass 150 Hz IM Rueckkopplungsweg. Sein Anteil ist affin in y3,
    // deshalb bleibt die Schleife weiterhin ohne Verzug aufloesbar:
    //   u  = xin - fbHp(kEff*y3) = (xin - fbC) - fbHpA*kEff*y3
    //   y3 = A*u + B   ->   y3 = (A*(xin - fbC) + B)/(1 + A*fbHpA*kEff)
    fbC = fbHpA*(fbHpY - fbHpX);
    B   = G*G*(1 - G)*s1 + G*(1 - G)*s2 + (1 - G)*s3;
    y3  = (A*(xin - fbC) + B)/(1 + A*fbHpA*kEff);
    fbI = kEff*y3;
    fbHpY = fbHpA*(fbHpY + fbI - fbHpX); fbHpX = fbI;
    u = xin - fbHpY;

    v = (u  - s1)*G; o1 = v + s1; s1 = o1 + v;
    v = (o1 - s2)*G; o2 = v + s2; s2 = o2 + v;
    v = (o2 - s3)*G; o3 = v + s3; s3 = o3 + v;
    y3prev = o3;
    osi == 0 ? osA = o3 : osB = o3;
    osi += 1;
  );
  // Dezimierung mit 1/4-1/2-1/4 statt reinem Mitteln. Der dritte Punkt
  // ist der zweite Durchlauf des VORIGEN Samples.
  // Ehrliche Zahlen: am nackten Oszillator senkt das den Alias-Boden um
  // 4,3 dB. HINTER dem Filter bleiben davon nur 0,07 dB uebrig, weil die
  // 18-dB-Flanke den oberen Bereich ohnehin wegnimmt. Es bleibt drin,
  // weil es fast nichts kostet — wer exakt das Original will, ersetzt die
  // Zeile durch  voice = 0.5*(osA + osB)*resMakeUp*amp;
  voice = (0.25*osPrev + 0.5*osA + 0.25*osB)*resMakeUp*amp;
  osPrev = osB;
) : (
  // Stimme schlaeft. Die Filterzustaende duerfen dabei NICHT einfach
  // stehenbleiben: amp wirkt erst hinter dem Filter, bei hoher Resonanz
  // schwingt die Leiter also noch mit vollem Pegel, wenn amp laengst
  // unter der Schwelle liegt. Eingefroren waeren diese Werte beim
  // naechsten Anschlag als Knacken zu hoeren. Deshalb hier ein kurzes
  // Ausklingen aller Zustaende (rund 5 ms Zeitkonstante).
  voice = 0;
  s1 *= 0.99; s2 *= 0.99; s3 *= 0.99;
  fbHpX *= 0.99; fbHpY *= 0.99; y3prev *= 0.99;
  oscHpX *= 0.99; oscHpY *= 0.99; sqHpX *= 0.99; sqHpY *= 0.99;
  osPrev *= 0.5;
);

// --- Drive: EQ waehlt das Band aus, das verzerrt wird.
//
// Der EQ liegt NICHT mehr in Reihe. dBand ist der Anteil, den der EQ
// durchlaesst und der in den WaveShaper geht; dRest ist genau das, was
// der EQ weggenommen hat, und laeuft unverzerrt daran vorbei. Weil
// dRest als Differenz gebildet wird, ergibt dBand + dRest wieder exakt
// das Eingangssignal — bei ausgeschalteter Verzerrung ist die ganze
// Stufe damit bitgenau transparent, egal wie der EQ steht.
//
// Praktisch heisst das: Lowcut hochziehen nimmt den Bass aus der
// VERZERRUNG, nicht aus dem Ausgang. Genau so ist ein Drive-Eingangs-EQ
// gemeint — die Grundwelle bleibt sauber, nur die Mitten werden dreckig.
dIn   = voice;
dBand = dIn;
eqDLoOn ? ( dHpY = eqDLoA*(dHpY + dBand - dHpX); dHpX = dBand; dBand = dHpY; )
        : ( dHpY = dBand; dHpX = dBand; );
eqDHiOn ? ( dLpY += eqDHiG*(dBand - dLpY); dBand = dLpY; )
        : ( dLpY = dBand; );
dRest = dIn - dBand;

// WaveShaper 2-fach ueberabgetastet. Der Zwischenpunkt wird linear
// interpoliert, danach dieselbe 1/4-1/2-1/4-Dezimierung wie im Filter.
// Nachgemessen am echten Filterausgang senkt das den Alias-Boden hinter
// dem Drive um 7,6 bis 9,8 dB — je nach Modell und Drive von -15..-56
// auf -24..-60 dBc. Das ist der groesste verbliebene Alias-Hebel im
// ganzen Geraet, deutlich groesser als 4x Oversampling von Osz+Filter.
//
// Die dezimierte Kette laeuft dadurch eine halbe Sampleperiode hinter
// dRest her. Bei den flachen Ein-Pol-EQs sind das im Uebergangsbereich
// weniger als 0,1 dB Summenfehler; bei ausgeschaltetem EQ ist dRest
// exakt null und die Frage stellt sich gar nicht.
fxDistOn ? (
  dMid  = 0.5*(dPrevIn + dBand); dPrevIn = dBand;
  dsA   = distProc(dMid*distPreG)*distPostG;
  dsB   = distProc(dBand*distPreG)*distPostG;
  dy    = 0.25*dsPrev + 0.5*dsA + 0.25*dsB + dRest;
  dsPrev = dsB;
) : (
  // Bypass ist echtes Unity — dBand + dRest ist wieder dIn.
  dy = dIn;
  dPrevIn = dBand; dsPrev *= 0.5;
);

// --- Ping-Pong-Delay (komplett bypassed bei Mix < 0.5 %)
dlyMix > 0.005 ? (
  dlyIn = dy;
  eqYLoOn ? ( hpY = eqYLoA*(hpY + dlyIn - hpPrev); hpPrev = dlyIn; dlyIn = hpY; ) : ( hpY = dlyIn; hpPrev = dlyIn; );
  eqYHiOn ? ( dlyLpY += eqYHiG*(dlyIn - dlyLpY); dlyIn = dlyLpY; ) : ( dlyLpY = dlyIn; );
  rp = dlyPos - floor(dlySamps); rp < 0 ? rp += dlyBufLen;
  i2 = rp - 1; i2 < 0 ? i2 += dlyBufLen;
  fr = dlySamps - floor(dlySamps);
  dl = M_DLY1[rp]*(1 - fr) + M_DLY1[i2]*fr;
  dr = M_DLY2[rp]*(1 - fr) + M_DLY2[i2]*fr;
  lpL += lpG24*(dl - lpL);
  lpR += lpG24*(dr - lpR);
  M_DLY1[dlyPos] = dlyIn + dlyFb2*lpR;
  M_DLY2[dlyPos] = lpL;
  dlyPos += 1; dlyPos >= dlyBufLen ? dlyPos = 0;
  wetDL = lpL*dlyMix;
  wetDR = lpR*dlyMix;
 ) : (
  wetDL = 0; wetDR = 0;
  lpL *= 0.995; lpR *= 0.995; dlyLpY *= 0.995;
  // Der Eingangs-Hochpass wird mitgefuehrt, sonst steht hpPrev beim
  // Wiedereinschalten auf einem alten Wert und der Differenzierer sieht
  // einen Gleichsprung — das war ein Plopp beim Aufdrehen des Mix.
  hpPrev = dy; hpY *= 0.995;
  // Schreibzeiger laeuft weiter und legt Stille ab, damit im Puffer kein
  // alter Inhalt konserviert wird, der beim Zuschalten zurueckkommt.
  M_DLY1[dlyPos] = 0; M_DLY2[dlyPos] = 0;
  dlyPos += 1; dlyPos >= dlyBufLen ? dlyPos = 0;
);

// --- Hall (komplett bypassed bei Mix < 0.5 %)
// Beim Umschalten AUF Bypass werden Predelay, Combs, Allpaesse und die
// Ausgangsfilter einmal geloescht. Ohne das blieben Puffer und Indizes
// stehen (combProc/apProc laufen im Bypass ja gar nicht) und beim
// Wiederaufdrehen kam sekundenalter Inhalt zurueck. Der eine memset
// kostet rund 220 kB, faellt genau einmal am Nulldurchgang des Reglers
// an und liegt unter einer Samplezeit.
rvbOn = rvbMix > 0.005;
rvbOn != rvbWas ? (
  rvbWas = rvbOn;
  !rvbOn ? (
    memset(M_PRE, 0, 8192);
    memset(M_RVB, 0, rvbTotal);
    ri = 48; loop(16, M_PAR[ri] = 0; ri += 1; );   // Comb-Daempfungsspeicher
    prePos = 0;
    ri = 32; loop(16, M_PAR[ri] = 0; ri += 1; );   // Comb-Leseindizes
    ri = 80; loop(8,  M_PAR[ri] = 0; ri += 1; );   // Allpass-Leseindizes
    rvHpX = 0; rvHpY = 0; rvLpY = 0;
    rhpL = 0; rhpR = 0; rhpXL = 0; rhpXR = 0; rlpL = 0; rlpR = 0;
  );
);
rvbOn ? (
  rvIn = dy + (wetDL + wetDR)*0.5;
  eqRLoOn ? ( rvHpY = eqRLoA*(rvHpY + rvIn - rvHpX); rvHpX = rvIn; rvIn = rvHpY; ) : ( rvHpY = rvIn; rvHpX = rvIn; );
  eqRHiOn ? ( rvLpY += eqRHiG*(rvIn - rvLpY); rvIn = rvLpY; ) : ( rvLpY = rvIn; );
  M_PRE[prePos] = rvIn;
  prePos += 1; prePos >= preLen ? prePos = 0;
  rvbX = M_PRE[prePos];
  sum1 = 0; sum2 = 0;
  i = 0;
  loop(8,
    sum1 += combProc(i, rvbX);
    sum2 += combProc(i + 8, rvbX);
    i += 1;
  );
  w1 = sum1*0.015; w2 = sum2*0.015;
  i = 0;
  loop(4,
    w1 = apProc(i, w1);
    w2 = apProc(i + 4, w2);
    i += 1;
  );
  rhpL = rhpA*(rhpL + w1 - rhpXL); rhpXL = w1;
  rhpR = rhpA*(rhpR + w2 - rhpXR); rhpXR = w2;
  rlpL += rlpG*(rhpL - rlpL);
  rlpR += rlpG*(rhpR - rlpR);
);

// --- Kompressor nur auf Dry, dann Delay/Hall dazu (303-Punch bleibt)
lv = abs(dy);
db = 20*log(lv + 0.00000001)*0.43429448;
db > envDb ? ( envDb += (db - envDb)*cAtk; ) : ( envDb += (db - envDb)*cRel; );
over = envDb + 14;
k15 = min(30, max(0, over + 15));
gr = -0.8*(k15*k15/60 + max(0, over - 15));
cg = 10^(gr/20)*1.78;
// Historie: bis v8 fest  dry = dy*cg;  (Kompressor immer an).
// compOn = 0 -> Dry unbearbeitet (Kompression UND das ~+5 dB Make-up 1.78
// raus, also ~5 dB leiser, mit VOLUME ausgleichen). compMix blendet linear
// zwischen dy (0 %) und dy*cg (100 %): dy*(1+compMix*(cg-1)). Bei 100 % ist
// es bitgenau dy*cg wie zuvor. envDb/cg laufen immer mit -> klickfrei.
dry = compOn ? dy*(1 + compMix*(cg - 1)) : dy;
sumL = dry + wetDL + rlpL*rvbMix;
sumR = dry + wetDR + rlpR*rvbMix;
spl0 = min(1, max(-1, softClip(sumL*volG)));
spl1 = min(1, max(-1, softClip(sumR*volG)));

// --- Oszilloskop (jedes 2. Sample reicht bei gfx 45 Hz)
scopeDiv ? (
  M_SCOPE[scopePos] = (spl0 + spl1)*0.5;
  scopePos += 1; scopePos >= 512 ? scopePos = 0;
);
scopeDiv = 1 - scopeDiv;

// Blockposition erst hier hochzaehlen: waehrend Sample n steht smplPos
// damit auf n, und der Offset im MIDI-Ausgang stimmt auf das Sample.
smplPos += 1;

/* ============================================================
   @gfx — Geraetefront nach dem Tim-Techlor-Designkit
   Core Black als Grund, Acid Green als einzige Akzentfarbe,
   Core White nur fuer Zeiger und Tastatur. Leitbahnen im
   45-Grad-Winkel enden in Loetpunkten und gliedern das Layout.
   Gezeichnet wird im Raster 900 x 732, SC skaliert auf das Fenster.
   ============================================================ */
@gfx 1120 912

// ---------- Massstab ----------
SC = min(gfx_w/UI_W, gfx_h/UI_H);
// Untergrenze nur als Notbremse gegen SC = 0. Bei 0,45 wurde die Front
// bei kleinen Fenstern groesser gezeichnet als das Fenster und rechts
// und unten abgeschnitten.
SC = max(0.25, SC);
OX = (gfx_w - UI_W*SC)*0.5;
OY = (gfx_h - UI_H*SC)*0.5;
mX = (mouse_x - OX)/SC;
mY = (mouse_y - OY)/SC;

/* ---------- Schriften ----------
   Zwei Familien: eine serifenlose fuer alle Beschriftungen und eine
   dicktengleiche nur fuer Zahlenwerte, damit Ziffern beim Drehen nicht
   zappeln.

   Jeder Kandidat wird gegen eine garantiert nicht vorhandene Schrift
   gemessen. Misst er genauso, ist er nicht installiert und REAPER ist
   auf dieselbe Systemvorgabe ausgewichen — dann wird der naechste
   probiert. Ohne diese Pruefung landete frueher das ganze Geraet in
   Courier New: "Liberation Mono" gibt es auf Windows nicht, GDI hat auf
   die Standard-Festbreitenschrift ausgewichen, und der alte M/i-Test hat
   das nicht gemerkt, weil Courier New ebenfalls dicktengleich ist.
   Daher die Serifen.

     1  Schriftzug   Zilap Orian, sonst serifenlos fett
     2  serifenlos   mittel      3  serifenlos   klein
     4  dicktengleich mittel     5  dicktengleich klein               */

fontChk == 0 ? (
  fontChk = 1;
  gfx_setfont(9, "TT303NoSuchFace", 16);
  gfx_measurestr("HAMBURGEFONSIV", refW, refH);
  gfx_measurestr("M", refM, refH2);

  sansSel = -1;
  sansSel < 0 ? ( gfx_setfont(9, "Segoe UI", 16);        gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 0; );
  sansSel < 0 ? ( gfx_setfont(9, "Helvetica Neue", 16);  gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 1; );
  sansSel < 0 ? ( gfx_setfont(9, "DejaVu Sans", 16);     gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 2; );
  sansSel < 0 ? ( gfx_setfont(9, "Liberation Sans", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? sansSel = 3; );
  sansSel < 0 ? sansSel = 4;                 // Notnagel: Arial

  // dicktengleich: muss vorhanden UND wirklich gleich breit sein
  monoSel = -1;
  monoSel < 0 ? ( gfx_setfont(9, "Consolas", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 0; );
  monoSel < 0 ? ( gfx_setfont(9, "DejaVu Sans Mono", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 1; );
  monoSel < 0 ? ( gfx_setfont(9, "Menlo", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? monoSel = 2; );
  monoSel < 0 ? monoSel = 3;                 // Notnagel: Courier New

  // Hausschrift fuer den Schriftzug nur, wenn sie wirklich da ist
  gfx_setfont(9, "Zilap Orian", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
  bigSel = (tw1 != refW || th1 != refH);
);

// Groessen wachsen mit dem Fenster. Die kleinen Groessen liegen einen
// Punkt hoeher als frueher, der Schriftzug bleibt wie er war.
fBig = max(12, floor(38*SC));
fMed = max(10, floor(16*SC));
fSml = max(9,  floor(13*SC));

(fBig != fBigP || fMed != fMedP || fSml != fSmlP) ? (
  fBigP = fBig; fMedP = fMed; fSmlP = fSml;
  bigSel ? gfx_setfont(1, "Zilap Orian", fBig, 'b')
  : sansSel == 0 ? gfx_setfont(1, "Segoe UI", fBig, 'b')
  : sansSel == 1 ? gfx_setfont(1, "Helvetica Neue", fBig, 'b')
  : sansSel == 2 ? gfx_setfont(1, "DejaVu Sans", fBig, 'b')
  : sansSel == 3 ? gfx_setfont(1, "Liberation Sans", fBig, 'b')
  : gfx_setfont(1, "Arial", fBig, 'b');
  sansSel == 0 ? ( gfx_setfont(2, "Segoe UI", fMed);        gfx_setfont(3, "Segoe UI", fSml); )
  : sansSel == 1 ? ( gfx_setfont(2, "Helvetica Neue", fMed);  gfx_setfont(3, "Helvetica Neue", fSml); )
  : sansSel == 2 ? ( gfx_setfont(2, "DejaVu Sans", fMed);     gfx_setfont(3, "DejaVu Sans", fSml); )
  : sansSel == 3 ? ( gfx_setfont(2, "Liberation Sans", fMed); gfx_setfont(3, "Liberation Sans", fSml); )
  : ( gfx_setfont(2, "Arial", fMed); gfx_setfont(3, "Arial", fSml); );
  monoSel == 0 ? ( gfx_setfont(4, "Consolas", fMed);         gfx_setfont(5, "Consolas", fSml); )
  : monoSel == 1 ? ( gfx_setfont(4, "DejaVu Sans Mono", fMed); gfx_setfont(5, "DejaVu Sans Mono", fSml); )
  : monoSel == 2 ? ( gfx_setfont(4, "Menlo", fMed);            gfx_setfont(5, "Menlo", fSml); )
  : ( gfx_setfont(4, "Courier New", fMed); gfx_setfont(5, "Courier New", fSml); );
);

// Mauszustand: Klick als Flanke, damit Schalter nicht dauerfeuern
uiLmb   = mouse_cap & 1;
uiClick = uiLmb && !lmbPrev;
uiRClk  = (mouse_cap & 2) && !rmbPrev;
!uiLmb ? ( dragId = -1; );
!uiLmb ? ( paintRow = -1; );
clickWait > 0 ? clickWait -= 1;

accentLed *= 0.88;

// ---------- Grund ----------
gfx_set(0.050, 0.054, 0.050, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

// ---------- Kopfzeile ----------
gfx_setfont(1);
colAcid(1);
xstr(24, 8, "TT-303");
// Versionsbadge rechts neben dem Titel (kleine Schrift, an der Titel-Grundlinie)
gfx_measurestr("TT-303", hdrTW, hdrTH);
gfx_setfont(3);
gfx_measurestr("v1.0", hdrVW, hdrVH);
colInk(1);
gfx_x = OX + 24*SC + hdrTW + 10*SC;
gfx_y = OY + 8*SC + hdrTH - hdrVH - 1*SC;
gfx_drawstr("v1.0");
gfx_setfont(3);
colInk(1);
xstr(26, 48, "ACID MACHINE // TIM TECHLOR // MONO BASS SYNTHESIZER");

trace(212, 20, 320, 60);
trace(320, 20, 448, 60);
pad(212, 20, 4); pad(320, 20, 4);
pad(320, 60, 3); pad(448, 60, 3);
colDim(1); xline(0, 70, UI_W, 70);
colAcid(1); xrect(0, 70, 232, 1);

// Accent-Anzeige (Ladung des Accent-Kondensators)
colInk(1); xstr(500, 22, "ACCENT");
gfx_set(0.11, 0.13, 0.11, 1); xrect(500, 38, 64, 8);
ledA = min(1, max(accentLed, accCap*0.6));
gfx_set(0.224*ledA, 1*ledA, 0.078*ledA, 1);
ledA > 0.01 ? xrect(501, 39, 62*ledA, 6);

// Betriebsart + MIDI-Thru
colInk(1); xstr(572, 20, "MIDI");
gfx_setfont(2);
btn(572, 32, 70, 26, slider33 == 1, "THRU") ? ( slider33 = 1 - slider33; slider_automate(slider33); paramsDirty = 1; );
gfx_setfont(3);
colInk(1); xstr(726, 20, "MODE");
gfx_setfont(2);
btn(726, 32, 74, 26, slider1 == 0, "HOST") ? ( slider1 = 0; slider_automate(slider1); paramsDirty = 1; );
btn(804, 32, 74, 26, slider1 == 1, "SEQ")  ? ( slider1 = 1; slider_automate(slider1); paramsDirty = 1; );

/* ---------- Panel SYNTHESIZER ---------- */
panelBox(14, 78, 872, 148);
gfx_setfont(3);
colAcid(1); xstr(26, 84, "SYNTHESIZER");
colInk(1);  xstr(26, 98, "VCO / VCF 18 dB / VCA");

btn(460, 82, 66, 18, patchSel == 0, "INIT") ? applyPatch(0);
btn(530, 82, 66, 18, patchSel == 1, "DEEP") ? applyPatch(1);
btn(600, 82, 66, 18, patchSel == 2, "SQCH") ? applyPatch(2);
btn(670, 82, 66, 18, patchSel == 3, "SCRM") ? applyPatch(3);
btn(740, 82, 66, 18, patchSel == 4, "HOOV") ? applyPatch(4);
btn(810, 82, 66, 18, patchSel == 5, "DUB")  ? applyPatch(5);

// --- Regler
nv = floor(knob(1, 60, 152, 27, slider3, -24, 24) + 0.5);
nv != slider3 ? ( slider3 = nv; slider_automate(slider3); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(2, 158, 152, 27, slider4, -50, 50) + 0.5);
nv != slider4 ? ( slider4 = nv; slider_automate(slider4); paramsDirty = 1; patchSel = -1; );
nv = knob(3, 256, 152, 27, slider5, 0, 100);
nv != slider5 ? ( slider5 = nv; slider_automate(slider5); paramsDirty = 1; patchSel = -1; );
nv = knob(4, 354, 152, 27, slider6, 0, 100);
nv != slider6 ? ( slider6 = nv; slider_automate(slider6); paramsDirty = 1; patchSel = -1; );
nv = knob(5, 452, 152, 27, slider7, 0, 100);
nv != slider7 ? ( slider7 = nv; slider_automate(slider7); paramsDirty = 1; patchSel = -1; );
nv = knob(6, 550, 152, 27, slider8, 0, 100);
nv != slider8 ? ( slider8 = nv; slider_automate(slider8); paramsDirty = 1; patchSel = -1; );
nv = knob(7, 648, 152, 27, slider9, 0, 100);
nv != slider9 ? ( slider9 = nv; slider_automate(slider9); paramsDirty = 1; patchSel = -1; );
nv = knob(8, 746, 152, 27, slider10, 0, 100);
nv != slider10 ? ( slider10 = nv; slider_automate(slider10); paramsDirty = 1; patchSel = -1; );

gfx_setfont(3); colInk(1);
xctr(11, 182, 98, 12, "TUNING");
xctr(109, 182, 98, 12, "FINE");
xctr(207, 182, 98, 12, "CUTOFF FREQ");
xctr(305, 182, 98, 12, "RESONANCE");
xctr(403, 182, 98, 12, "ENV MOD");
xctr(501, 182, 98, 12, "DECAY");
xctr(599, 182, 98, 12, "ACCENT");
xctr(697, 182, 98, 12, "VOLUME");

gfx_setfont(4); colAcid(1);
xat(20, 196);  gfx_printf("%+d st", slider3);
xat(120, 196); gfx_printf("%+d ct", slider4);
// CUTOFF/DECAY-Anzeige spiegelt die v8-Kennlinien aus updateParams():
// baseF = 145*exp(cutN*1.95)*(1+resN) (Reso hebt die Ecke mit), decTau =
// 30*exp(decN*2.95) ms. Historie (v6/v7): floor(60*exp(slider5*0.0460517))
// "Hz" und floor(60*exp(slider8*0.037297)) "ms" — passte nicht mehr.
xat(210, 196); gfx_printf("%d Hz", floor(145*exp(slider5*0.0195)*(1 + slider6*0.01)));
xat(322, 196); gfx_printf("%d %%", floor(slider6));
xat(420, 196); gfx_printf("%.1f oct", slider7*0.052);
xat(512, 196); gfx_printf("%d ms", floor(30*exp(slider8*0.0295)));
xat(616, 196); gfx_printf("%d %%", floor(slider9));
xat(714, 196); gfx_printf("%d %%", floor(slider10));

gfx_setfont(3); colInk(1); xctr(800, 104, 78, 12, "WAVEFORM");
gfx_setfont(2);
btn(800, 118, 78, 22, slider2 == 0, "SAW") ? ( slider2 = 0; slider_automate(slider2); paramsDirty = 1; );
btn(800, 144, 78, 22, slider2 == 1, "SQUARE") ? ( slider2 = 1; slider_automate(slider2); paramsDirty = 1; );

// Accent-Schwelle — gehoert zum Synthesizer und steht jetzt hier;
// im SEQ-Modus ohne Funktion, deshalb nur dann gezeichnet
slider1 == 0 ? (
  gfx_setfont(3); colInk(1); xstr(800, 172, "ACCENT VEL");
  gfx_setfont(4); colAcid(1);
  xat(800, 184); gfx_printf("%d", floor(slider12));
  gfx_setfont(3);
  btn(800, 202, 20, 18, 0, "-") ? ( slider12 = max(1, slider12 - 1); slider_automate(slider12); paramsDirty = 1; );
  btn(826, 202, 20, 18, 0, "+") ? ( slider12 = min(127, slider12 + 1); slider_automate(slider12); paramsDirty = 1; );
);

/* ---------- Panel EFFEKTE ----------
   DRIVE und DELAY sind schmaler, REVERB dafuer breiter. Unter jeder
   Einheit liegt ihr Eingangs-EQ als Dualslider: links der Lowcut,
   rechts der Highcut, logarithmische Skala 20 Hz..20 kHz, an den
   Aussenkanten rastet die Kante auf OFF. Rechtsklick auf einen Griff
   stellt die Werkseinstellung wieder her. */
panelBox(14, 234, 872, 156);
gfx_setfont(3);
colAcid(1);
xstr(26, 240, "DRIVE"); xstr(342, 240, "DELAY"); xstr(566, 240, "REVERB");
xstr(772, 240, "COMP");
colDim(1);
xline(328, 244, 328, 382);
xline(558, 244, 558, 382);
xline(762, 244, 762, 382);
pad(328, 244, 3); pad(558, 244, 3); pad(762, 244, 3);

gfx_setfont(2);
btn(26, 254, 54, 18, slider13 == 1, slider13 == 1 ? "ON" : "OFF") ? ( slider13 = 1 - slider13; slider_automate(slider13); paramsDirty = 1; );
btn(86, 254, 44, 18, slider14 == 0, "SOFT") ? ( slider14 = 0; slider_automate(slider14); paramsDirty = 1; );
btn(134, 254, 44, 18, slider14 == 1, "HARD") ? ( slider14 = 1; slider_automate(slider14); paramsDirty = 1; );
btn(182, 254, 44, 18, slider14 == 2, "FOLD") ? ( slider14 = 2; slider_automate(slider14); paramsDirty = 1; );
btn(230, 254, 44, 18, slider14 == 3, "FUZZ") ? ( slider14 = 3; slider_automate(slider14); paramsDirty = 1; );

btn(342, 254, 42, 18, slider17 == 0, "1/8")  ? ( slider17 = 0; slider_automate(slider17); paramsDirty = 1; );
btn(388, 254, 42, 18, slider17 == 1, "1/8.") ? ( slider17 = 1; slider_automate(slider17); paramsDirty = 1; );
btn(434, 254, 42, 18, slider17 == 2, "1/4")  ? ( slider17 = 2; slider_automate(slider17); paramsDirty = 1; );
btn(480, 254, 42, 18, slider17 == 3, "1/2")  ? ( slider17 = 3; slider_automate(slider17); paramsDirty = 1; );

// Kompressor: eigene Spalte rechts (Divider bei 762). ON/OFF in der
// Button-Zeile, MIX als Knopf (id 18) in der Knopfzeile. Reine Zeichnung.
btn(772, 254, 64, 18, slider34 == 1, slider34 == 1 ? "ON" : "OFF")
  ? ( slider34 = 1 - slider34; slider_automate(slider34); paramsDirty = 1; );
gfx_setfont(2); colInk(1); xstr(772, 354, "-14 dB / 5:1");

nv = knob(9, 171, 298, 20, slider15, 1, 40);
nv != slider15 ? ( slider15 = nv; slider_automate(slider15); paramsDirty = 1; patchSel = -1; );
nv = knob(10, 440, 298, 20, slider16, 0, 100);
nv != slider16 ? ( slider16 = nv; slider_automate(slider16); paramsDirty = 1; patchSel = -1; );
nv = knob(11, 520, 298, 20, slider18, 0, 90);
nv != slider18 ? ( slider18 = nv; slider_automate(slider18); paramsDirty = 1; patchSel = -1; );
nv = knob(12, 592, 298, 20, slider19, 0, 100);
nv != slider19 ? ( slider19 = nv; slider_automate(slider19); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(13, 657, 298, 20, slider20, 20, 100) + 0.5);
nv != slider20 ? ( slider20 = nv; slider_automate(slider20); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(14, 722, 298, 20, slider11, 0, 300) + 0.5);
nv != slider11 ? ( slider11 = nv; slider_automate(slider11); paramsDirty = 1; patchSel = -1; );
nv = floor(knob(18, 824, 298, 20, slider35, 0, 100) + 0.5);
nv != slider35 ? ( slider35 = nv; slider_automate(slider35); paramsDirty = 1; );

gfx_setfont(3); colInk(1);
xctr(141, 322, 60, 12, "DRIVE");
xctr(410, 322, 60, 12, "MIX");
xctr(490, 322, 60, 12, "FEEDBACK");
xctr(562, 322, 60, 12, "MIX");
xctr(627, 322, 60, 12, "SIZE");
xctr(692, 322, 60, 12, "SLIDE");
xctr(794, 322, 60, 12, "MIX");
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%.1f", slider15);         drawCentered(171, 336);
sprintf(#vstr, "%d %%", floor(slider16)); drawCentered(440, 336);
sprintf(#vstr, "%d %%", floor(slider18)); drawCentered(520, 336);
sprintf(#vstr, "%d %%", floor(slider19)); drawCentered(592, 336);
sprintf(#vstr, "%d %%", floor(slider20)); drawCentered(657, 336);
sprintf(#vstr, "%d ms", floor(slider11)); drawCentered(722, 336);
sprintf(#vstr, "%d %%", floor(slider35)); drawCentered(824, 336);

// --- Eingangs-EQs: Lowcut links, Highcut rechts, je 0..20 kHz
// Erst rechnen, dann zeichnen — so stehen Streifen und Griffe im selben
// Bild. min/max halten den Lowcut unter dem Highcut; sonst laesst sich
// das Band zukneifen und die Einheit ist stumm, ohne dass man sieht warum.
nv = min(fxEqVal(20, 26, 360, 284, slider27, 0, 0), slider28);
nv != slider27 ? ( slider27 = nv; slider_automate(slider27); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(21, 26, 360, 284, slider28, 1, 20000), slider27);
nv != slider28 ? ( slider28 = nv; slider_automate(slider28); paramsDirty = 1; patchSel = -1; );
eqTrack(26, 360, 284, eqT(slider27), eqT(slider28));
eqHandle(20, 26, 360, 284, slider27);
eqHandle(21, 26, 360, 284, slider28);

nv = min(fxEqVal(22, 342, 360, 208, slider29, 0, 250), slider30);
nv != slider29 ? ( slider29 = nv; slider_automate(slider29); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(23, 342, 360, 208, slider30, 1, 3000), slider29);
nv != slider30 ? ( slider30 = nv; slider_automate(slider30); paramsDirty = 1; patchSel = -1; );
eqTrack(342, 360, 208, eqT(slider29), eqT(slider30));
eqHandle(22, 342, 360, 208, slider29);
eqHandle(23, 342, 360, 208, slider30);

nv = min(fxEqVal(24, 562, 360, 196, slider31, 0, 300), slider32);
nv != slider31 ? ( slider31 = nv; slider_automate(slider31); paramsDirty = 1; patchSel = -1; );
nv = max(fxEqVal(25, 562, 360, 196, slider32, 1, 2300), slider31);
nv != slider32 ? ( slider32 = nv; slider_automate(slider32); paramsDirty = 1; patchSel = -1; );
eqTrack(562, 360, 196, eqT(slider31), eqT(slider32));
eqHandle(24, 562, 360, 196, slider31);
eqHandle(25, 562, 360, 196, slider32);

eqLabels(26, 370, 284, slider27, slider28);
eqLabels(342, 370, 208, slider29, slider30);
eqLabels(562, 370, 196, slider31, slider32);

/* ---------- Oszilloskop (Signalwelle als Leitmotiv) ---------- */
panelBox(14, 398, 872, 64);
gfx_set(0.042, 0.048, 0.042, 1); xrect(16, 400, 868, 60);
gfx_set(0.10, 0.13, 0.08, 1);
xline(16, 430, 884, 430);
gi = 1;
loop(7, xline(16 + gi*108.5, 400, 16 + gi*108.5, 460); gi += 1; );
colAcid(1);
gi = 0;
loop(256,
  sxp = OX + (18 + 864*gi/255)*SC;
  sv  = M_SCOPE[(scopePos + gi*2) % 512];
  syp = OY + (430 - max(-1.1, min(1.1, sv))*26)*SC;
  gi == 0 ? ( gfx_x = sxp; gfx_y = syp; ) : gfx_lineto(sxp, syp, 1);
  gi += 1;
);
gfx_setfont(5);
gfx_set(0, 0, 0, 0.75); xrect(20, 442, 384, 16);
gateHeld ? colAcid(1) : colInk(1);
xat(24, 444);
gfx_printf("NOTE "); noteName(noteCur);
gfx_printf("  %.1f Hz  |  VCF %d Hz  |  %d BPM", exp(curLog), floor(fc), floor(bpmNow));

/* ---------- Panel SEQUENCER / MIDI ---------- */
panelBox(14, 470, 872, 250);

slider1 == 1 ? (

  bb = floor(slider25)*SEQ_BANK;

  gfx_setfont(3);
  colAcid(1); xstr(26, 478, "SEQUENCER");
  colInk(1);  xstr(26, 492, "16 STEPS");
  seqRunning ? colAcid(1) : gfx_set(0.16, 0.19, 0.15, 1);
  xcirc(150, 489, 5, 1);
  gfx_setfont(5);
  colInk(1); xat(162, 482);
  seqRunning ? gfx_printf("RUN  STEP %02d", curStepDisp + 1) : gfx_drawstr("STOP");

  gfx_setfont(2);
  btn(250, 478, 86, 22, slider24 == 1, "FREE RUN") ? ( slider24 = 1 - slider24; slider_automate(slider24); paramsDirty = 1; );
  // Heisst SEQ OUT und nicht MIDI OUT, damit klar bleibt, dass hier die
  // erzeugte Sequenz rausgeht — der THRU-Schalter oben reicht dagegen
  // eingehende Noten weiter. Zwei Quellen, zwei Schalter.
  btn(344, 478, 86, 22, slider26 == 1, "SEQ OUT") ? ( slider26 = 1 - slider26; slider_automate(slider26); paramsDirty = 1; );

  // MIDI-Hinweis in der Luecke zwischen MIDI OUT und den Reglern —
  // er stand frueher ueber den Reglern und lief ihnen ueber den Weg
  gfx_setfont(3);
  midiHeld ? colAcid(1) : colInk(1);
  xat(445, 482);
  midiHeld ? gfx_printf("MIDI TRANSPOSE %+d", seqTrans) : gfx_drawstr("MIDI = TRANSPOSE");

  // --- Baenke. COPY scharfschalten, dann Zielbank anklicken.
  gfx_setfont(3); colInk(1); xstr(26, 516, "BANK");
  gfx_setfont(2);
  btn(70, 510, 36, 22, slider25 == 0, "A") ? (
    copyArm ? ( copyBank(bb, 0); copyArm = 0; ) : ( slider25 = 0; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(110, 510, 36, 22, slider25 == 1, "B") ? (
    copyArm ? ( copyBank(bb, SEQ_BANK); copyArm = 0; ) : ( slider25 = 1; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(150, 510, 36, 22, slider25 == 2, "C") ? (
    copyArm ? ( copyBank(bb, 2*SEQ_BANK); copyArm = 0; ) : ( slider25 = 2; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(190, 510, 36, 22, slider25 == 3, "D") ? (
    copyArm ? ( copyBank(bb, 3*SEQ_BANK); copyArm = 0; ) : ( slider25 = 3; slider_automate(slider25); paramsDirty = 1; );
  );
  btn(236, 510, 56, 22, copyArm, "COPY")  ? ( copyArm = 1 - copyArm; );
  btn(300, 510, 46, 22, 0, "RND")   ? ( saveUndo(bb); randPattern(bb); copyArm = 0; );
  btn(350, 510, 46, 22, 0, "MUT")   ? ( saveUndo(bb); mutPattern(bb); copyArm = 0; );
  btn(400, 510, 52, 22, 0, "CLEAR") ? ( saveUndo(bb); clearBank(bb); copyArm = 0; );
  btn(456, 510, 52, 22, undoArm, "UNDO") ? ( loadUndo(bb); copyArm = 0; );
  bb = floor(slider25)*SEQ_BANK;
  gfx_setfont(3);
  copyArm ? ( colAcid(1); xstr(514, 516, "ZIELBANK WAEHLEN"); );

  // --- Sequencer-Regler. Label UND Wert in einer Zeile darunter,
  //     damit ueber den Reglern nichts mehr schwebt.
  nv = floor(knob(15, 690, 506, 19, slider21, 1, 16) + 0.5);
  nv != slider21 ? ( slider21 = nv; slider_automate(slider21); paramsDirty = 1; patchSel = -1; );
  nv = floor(knob(16, 770, 506, 19, slider22, 0, 75) + 0.5);
  nv != slider22 ? ( slider22 = nv; slider_automate(slider22); paramsDirty = 1; patchSel = -1; );
  nv = floor(knob(17, 849, 506, 19, slider23, 10, 100) + 0.5);
  nv != slider23 ? ( slider23 = nv; slider_automate(slider23); paramsDirty = 1; patchSel = -1; );
  // Werte unter den Reglern: erst die Breiten der Texte messen, dann
  // die Positionen vergeben — Mindestabstand 10 zueinander, rechts
  // Rand bis 880. So ueberlappt nichts, egal wie breit die Schrift
  // beim Aufziehen des Fensters oder bei einer Fall-back-Schrift ist.
  gfx_setfont(3);
  sprintf(#klbl, "LEN");  sprintf(#kval, "%d", floor(slider21));
  gfx_measurestr(#klbl, kw1, kh1); gfx_measurestr(#kval, vw1, vh1);
  wq1 = kw1 + 6 + vw1;
  sprintf(#klbl, "SHUF"); sprintf(#kval, "%d %%", floor(slider22));
  gfx_measurestr(#klbl, kw2, kh1); gfx_measurestr(#kval, vw2, vh1);
  wq2 = kw2 + 6 + vw2;
  sprintf(#klbl, "GATE"); sprintf(#kval, "%d %%", floor(slider23));
  gfx_measurestr(#klbl, kw3, kh1); gfx_measurestr(#kval, vw3, vh1);
  wq3 = kw3 + 6 + vw3;
  qx1 = 690 - wq1*0.5;
  qx2 = max(qx1 + wq1 + 10, 770 - wq2*0.5);
  qx3 = max(qx2 + wq2 + 10, 849 - wq3*0.5);
  qx3 = min(qx3, 880 - wq3);
  qx2 = min(qx2, qx3 - wq2 - 10);
  qx1 = min(qx1, qx2 - wq1 - 10);
  sprintf(#klbl, "LEN");  sprintf(#kval, "%d", floor(slider21));     kvLabel(qx1, 528);
  sprintf(#klbl, "SHUF"); sprintf(#kval, "%d %%", floor(slider22));  kvLabel(qx2, 528);
  sprintf(#klbl, "GATE"); sprintf(#kval, "%d %%", floor(slider23));  kvLabel(qx3, 528);

  // --- Zeilenbeschriftung
  colInk(1);
  xstr(14, 584, "NOTE");
  xstr(14, 660, "GATE");
  xstr(14, 678, "ACC");
  xstr(14, 696, "SLD");

  // Hilfslinien der C-Toene
  gi = 0;
  loop(3,
    ly = LANE_Y + LANE_H - (24 + gi*12 - SEQ_NLO + 1)*ROW_H;
    gfx_set(0.14, 0.17, 0.12, 1);
    xline(GRID_X, ly, 884, ly);
    gi += 1;
  );

  // --- 16 Spalten. Notennamen dicktengleich, damit die Spalten
  //     beim Verschieben der Tonhoehe nicht zappeln.
  gfx_setfont(5);
  gi = 0;
  loop(16,
    cx0 = GRID_X + gi*GRID_W;
    seqRunning && curStepDisp == gi ? gfx_set(0.09, 0.16, 0.07, 1)
    : gi < patLen ? gfx_set(0.092, 0.096, 0.092, 1) : gfx_set(0.056, 0.060, 0.056, 1);
    xrect(cx0, LANE_Y, 50, LANE_H);
    (gi % 4) == 0 ? ( colDim(1); xrect(cx0, LANE_Y, 1, LANE_H); );

    uiClick && inBox(cx0, LANE_Y, 50, LANE_H) ? ( dragId = 1000 + gi; );
    dragId == 1000 + gi && uiLmb ? (
      M_SEQ[bb + gi*4 + SF_NOTE] = min(SEQ_NHI, max(SEQ_NLO,
        SEQ_NLO + floor((LANE_Y + LANE_H - mY)/ROW_H)));
    );
    uiRClk && inBox(cx0, LANE_Y, 50, LANE_H) ? ( M_SEQ[bb + gi*4 + SF_GATE] = 1 - M_SEQ[bb + gi*4 + SF_GATE]; );

    nn = M_SEQ[bb + gi*4 + SF_NOTE];
    ly = LANE_Y + LANE_H - (nn - SEQ_NLO + 1)*ROW_H;
    M_SEQ[bb + gi*4 + SF_GATE] ? ( M_SEQ[bb + gi*4 + SF_ACC] ? colWhite(1) : colAcid(1); )
                               : gfx_set(0.20, 0.24, 0.19, 1);
    xrect(cx0 + 4, ly, 42, 4);

    M_SEQ[bb + gi*4 + SF_SLIDE] ? (
      colAcid(0.55);
      xline(cx0 + 46, ly + 2, cx0 + 52, ly + 2);
      xline(cx0 + 48, ly - 1, cx0 + 52, ly + 2);
      xline(cx0 + 48, ly + 5, cx0 + 52, ly + 2);
    );

    M_SEQ[bb + gi*4 + SF_GATE] ? colAcid(1) : gfx_set(0.25, 0.28, 0.24, 1);
    gfx_measurestr("C#2", tw1, th1);
    gfx_x = OX + cx0*SC + (50*SC - tw1)*0.5; gfx_y = OY + 638*SC;
    noteName(nn);

    ri = 0;
    loop(3,
      ry = 656 + ri*18;
      fld = 1 + ri;
      hitc = inBox(cx0, ry, 50, 16);
      uiClick && hitc ? (
        paintRow = ri + 1;
        paintVal = 1 - M_SEQ[bb + gi*4 + fld];
        M_SEQ[bb + gi*4 + fld] = paintVal;
      ) : (
        uiLmb && paintRow == ri + 1 && hitc ? ( M_SEQ[bb + gi*4 + fld] = paintVal; );
      );
      M_SEQ[bb + gi*4 + fld] ? (
        ri == 0 ? colAcid(0.90) : ri == 1 ? colWhite(0.90) : colAcid(0.50);
      ) : (
        hitc ? gfx_set(0.16, 0.19, 0.15, 1) : gfx_set(0.104, 0.109, 0.104, 1);
      );
      xrect(cx0, ry, 50, 16);
      ri += 1;
    );
    gi += 1;
  );
  patLen < 16 ? (
    gfx_set(0, 0, 0, 0.45);
    xrect(GRID_X + patLen*GRID_W, LANE_Y, 884 - (GRID_X + patLen*GRID_W), 168);
  );

) : (

  // ---------- HOST-Modus: MIDI-Anzeige ----------
  gfx_setfont(3);
  colAcid(1); xstr(26, 478, "MIDI INPUT");
  colInk(1);  xstr(26, 492, "PIANO ROLL SPIELT DEN KLANGERZEUGER");
  xat(26, 514);
  gfx_printf("VELOCITY >= %d = ACCENT   |   UEBERLAPPENDE NOTEN = SLIDE   |   LETZTE NOTE GEWINNT   |   GEHALTEN: %d", floor(slider12), stkN);

  gi = 0; wi = 0;
  loop(37,
    nn = 24 + gi;
    kk = nn - 12*floor(nn/12);
    (kk == 1 || kk == 3 || kk == 6 || kk == 8 || kk == 10) ? 0 : (
      noteHeld(nn) ? colAcid(1) : gfx_set(0.88, 0.88, 0.88, 1);
      xrect(40 + wi*36, 544, 34, 110);
      gfx_set(0.10, 0.10, 0.10, 1);
      kk == 0 ? ( xat(45 + wi*36, 632); gfx_printf("C%d", floor(nn/12) - 1); );
      wi += 1;
    );
    gi += 1;
  );
  gi = 0; wi = 0;
  loop(37,
    nn = 24 + gi;
    kk = nn - 12*floor(nn/12);
    (kk == 1 || kk == 3 || kk == 6 || kk == 8 || kk == 10) ? (
      noteHeld(nn) ? colAcid(1) : gfx_set(0.04, 0.05, 0.04, 1);
      xrect(40 + wi*36 - 11, 544, 22, 66);
      gfx_set(0.20, 0.24, 0.19, 1);
      xrect(40 + wi*36 - 11, 544, 22, 1);
    ) : ( wi += 1; );
    gi += 1;
  );
  pad(40, 676, 4); pad(832, 676, 4);
  colDim(1); xline(44, 676, 828, 676);
  colInk(1);
  xstr(26, 692, "SEQ-MODUS OBEN RECHTS SCHALTET DEN INTERNEN 16-STEP-SEQUENCER EIN");
);

lmbPrev = uiLmb;
rmbPrev = mouse_cap & 2;
mouse_wheel = 0;
