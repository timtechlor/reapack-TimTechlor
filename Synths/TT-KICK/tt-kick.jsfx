// Werks-Preset anwenden (TT-303 applyPatch-Muster: eine Funktion,
// Index waehlt). p = 0 = INIT = Werkszustand (writeDefaults) - die
// Kit-Pfade bleiben erhalten (Zuordnung ist Asset, kein Klang-
// parameter; es reicht, das erste Zeichen jedes Pfad-Slots zu parken -
// der Pfad-Hash aendert sich nicht, es gibt also keinen Reload).
// Laeuft immer innerhalb der globalen undoMark/undoCommit-Klammer
// des @gfx -> ein Presetwechsel ist per UNDO rueckgaengig.
// P26 (Review A9, Nutzerentscheidung 02.10.2026): ein Presetwechsel stoppt den Player nicht mehr. PG_ON wird wie
// bei kkPbApply (Anwender-Presets) geparkt und zurueckgeschrieben - fuer alle Werks-Presets UND INIT (Leiste, SYS-Seite,
// Q CMD 16/17). RATE/SYNC/ROOT/SWING/KEYTRACK setzt ein Werks-Preset weiter (Teil des Klangs, ein Anwender-Preset
// setzt sie ebenfalls).
// P26-Nachtrag (Nutzerentscheidung 02.10.2026, v0.13.1): ein Werks-Preset (1..44) laesst ROOT stehen - der Grundton gehoert
// zum Kit/Sample (DETECT), nicht zum Klangentwurf; alle 44 Werks-Presets setzen ohnehin nur den Standardwert 36 (plySet).
// INIT (p == 0) bleibt die Rueckkehr zum Grundzustand und setzt ROOT weiter auf 36 (writeDefaults). Anwender-Presets
// (kkPbApply) und Projekt-Laden unveraendert: ROOT wird dort wie gespeichert geladen.
function applyPatch(p) local(b, pg, ps, tp, ex, c0, c1, c2, bp, on, ro) (
  b = M_GEN;
  pg = b[PG_PAGE];  ps = b[PG_SEGSEL];      // UI-Stand parken
  tp = b[PG_TIPS];                          // v0.9.0: INIT setzt Tips sonst auf Default
  ex = b[PG_EXP];                           // v0.9.1: plySet/writeDefaults nullen +10
  kkFaT = b[PG_FAUT];                       // v1.0.0: +11 ebenso
  kkWvT = b[PG_WVUI];                       // v1.0.0 (Wellenansicht): +12 ebenso
  on = b[PG_ON];                            // P26: Player-Lauf parken (wie kkPbApply)
  ro = b[PG_ROOT];                          // v0.13.1: ROOT parken (nur fuer Werks-Presets 1..44 zurueckgeschrieben)
  p == 0 ? (
    // v0.7.4: Basis in lokale Variable, dann bp[idx] (Hausregel) -
    // die Vorform (M_PATH + 256)[0] ist in keiner Referenzdatei
    // (TT-303/PHALYX) als REAPER-kompilierbar belegt.
    bp = M_PATH;
    c0 = bp[0];
    c1 = bp[256];
    c2 = bp[512];
    writeDefaults();
    bp[0]   = c0;
    bp[256] = c1;
    bp[512] = c2;
  ) : p == 1 ? pst909tight()
  : p == 2 ? pst909punch()
  : p == 3 ? pst909deep()
  : p == 4 ? pst909soft()
  : p == 5 ? pst808sub()
  : p == 6 ? pst808long()
  : p == 7 ? pst808punchy()
  : p == 8 ? psthardtechno()
  : p == 9 ? pstharder()
  : p == 10 ? psthardcore()
  : p == 11 ? pstindustrial()
  : p == 12 ? pstmachinefunk()
  : p == 13 ? pstrumbledeep()
  : p == 14 ? pstrumblefast()
  : p == 15 ? pstrumbledry()
  : p == 16 ? pstrumbledark()
  : p == 17 ? pstminimalclub()
  : p == 18 ? pstdubdry()
  : p == 19 ? pstclubpunch()
  : p == 20 ? pstberghain()
  : p == 21 ? pstrolltight()
  : p == 22 ? pstrollsharp()
  : p == 23 ? pstrolldeep()
  : p == 24 ? pstsubfocus()
  : p == 25 ? pstdeepmelodic()
  : p == 26 ? pstsoftdeep()
  : p == 27 ? pstacidglide()
  : p == 28 ? pstreversebloom()
  : p == 29 ? pstwarehouse()
  : p == 30 ? pstclickminimal()
  : p == 31 ? pst909slam()
  : p == 32 ? pst909clicky()
  : p == 33 ? pst808tight()
  : p == 34 ? psthardscoop()
  : p == 35 ? pstnoiseindustrial()
  : p == 36 ? pstrumblesub()
  : p == 37 ? pstminimaldry()
  : p == 38 ? pstclubwarm()
  : p == 39 ? pstrollsoft()
  : p == 40 ? pstsubrumble()
  : p == 41 ? pstdeeppunch()
  : p == 42 ? psttechnoclassic()
  : p == 43 ? pstwarehousetight()
  : pstreverserise();
  validateState();
  b[PG_PAGE]   = pg;
  b[PG_SEGSEL] = ps;
  b[PG_TIPS]   = tp;
  b[PG_EXP]    = ex;
  b[PG_FAUT]   = kkFaT;
  b[PG_WVUI]   = kkWvT;
  kkFitReq = 1;                             // v1.0.0: AUTO-Fit nach dem Laden (verbraucht im @gfx)
  b[PG_ON]     = on;                        // P26: Player laeuft weiter
  p != 0 ? b[PG_ROOT] = ro;                 // v0.13.1: Werks-Preset behaelt ROOT, INIT setzt 36 (writeDefaults)
  b[PG_PSET]   = p;
  undPset = 1;      // der folgende Commit ist ein Preset-Apply:
                    // Resultat gilt als "unmodified", kein Stern
  psetMod = 0;
);

// Anzeigename des Werks-Presets -> #pstr (45 Namen, Index 0 = INIT). Der letzte Zweig ist
// zugleich Fallback fuer Werte ausserhalb 0..44.
function psetName(p) (
  p == 0 ? sprintf(#pstr, "INIT")
  : p == 1 ? sprintf(#pstr, "909 TIGHT")
  : p == 2 ? sprintf(#pstr, "909 PUNCH")
  : p == 3 ? sprintf(#pstr, "909 DEEP")
  : p == 4 ? sprintf(#pstr, "909 SOFT")
  : p == 5 ? sprintf(#pstr, "808 SUB")
  : p == 6 ? sprintf(#pstr, "808 LONG")
  : p == 7 ? sprintf(#pstr, "808 PUNCHY")
  : p == 8 ? sprintf(#pstr, "HARD TECHNO")
  : p == 9 ? sprintf(#pstr, "HARDER")
  : p == 10 ? sprintf(#pstr, "HARDCORE")
  : p == 11 ? sprintf(#pstr, "INDUSTRIAL")
  : p == 12 ? sprintf(#pstr, "MACHINE FUNK")
  : p == 13 ? sprintf(#pstr, "RUMBLE DEEP")
  : p == 14 ? sprintf(#pstr, "RUMBLE FAST")
  : p == 15 ? sprintf(#pstr, "RUMBLE DRY")
  : p == 16 ? sprintf(#pstr, "RUMBLE DARK")
  : p == 17 ? sprintf(#pstr, "MINIMAL CLUB")
  : p == 18 ? sprintf(#pstr, "DUB DRY")
  : p == 19 ? sprintf(#pstr, "CLUB PUNCH")
  : p == 20 ? sprintf(#pstr, "BERGHAIN")
  : p == 21 ? sprintf(#pstr, "ROLL TIGHT")
  : p == 22 ? sprintf(#pstr, "ROLL SHARP")
  : p == 23 ? sprintf(#pstr, "ROLL DEEP")
  : p == 24 ? sprintf(#pstr, "SUB FOCUS")
  : p == 25 ? sprintf(#pstr, "DEEP MELODIC")
  : p == 26 ? sprintf(#pstr, "SOFT DEEP")
  : p == 27 ? sprintf(#pstr, "ACID GLIDE")
  : p == 28 ? sprintf(#pstr, "REVERSE BLOOM")
  : p == 29 ? sprintf(#pstr, "WAREHOUSE")
  : p == 30 ? sprintf(#pstr, "CLICK MINIMAL")
  : p == 31 ? sprintf(#pstr, "909 SLAM")
  : p == 32 ? sprintf(#pstr, "909 CLICKY")
  : p == 33 ? sprintf(#pstr, "808 TIGHT")
  : p == 34 ? sprintf(#pstr, "HARD SCOOP")
  : p == 35 ? sprintf(#pstr, "NOISE INDUSTRIAL")
  : p == 36 ? sprintf(#pstr, "RUMBLE SUB")
  : p == 37 ? sprintf(#pstr, "MINIMAL DRY")
  : p == 38 ? sprintf(#pstr, "CLUB WARM")
  : p == 39 ? sprintf(#pstr, "ROLL SOFT")
  : p == 40 ? sprintf(#pstr, "SUB RUMBLE")
  : p == 41 ? sprintf(#pstr, "DEEP PUNCH")
  : p == 42 ? sprintf(#pstr, "TECHNO CLASSIC")
  : p == 43 ? sprintf(#pstr, "WAREHOUSE TIGHT")
  : sprintf(#pstr, "REVERSE RISE");
);

// ----------------------------------------------------------------------
// v0.11.0 (P17): Preset-Leiste (Modul tt-presets.jsfx-inc) + Anwender-Bank.
// Werks-Presets = INIT + 44 Kicks (Index 0..44, unveraendert applyPatch).
// Anwender-Zustand = das, was ein Werks-Preset ersetzt (applyPatch-Semantik):
//   buf[0]        Layoutversion (1)
//   buf[1..192]   M_SEG (3 x 64: alle Lane-/Segmentdaten, Lane-Preset-Felder)
//   buf[193..208] M_GEN-Kopf (Player-Kopf; PG_ON/PAGE/SEGSEL/TIPS/EXP/PSET bleiben beim Laden)
//   buf[209..224] M_SLI (Master: Filter, Drive, Comp, OUT)
// NICHT: Kit-Pfade (M_PATH), Farbslider 65, Lane-Ansicht (ZOOM/SKEW/VOFF), Player ON,
// Seite/Lane-Auswahl/Tooltips/EXPERT, PG_PSET. Bank hinter CAP_END (maxmem +16384).
KK_PSW  = 240;                    // Worte je Anwender-Preset (Layout 1 belegt 225); darf nur wachsen
KK_PBB  = CAP_END;                // Bankbasis (Bedarf 9902 Worte, maxmem hat 16384 Reserve)
KK_PBX  = 350;                    // Leiste: x im Designraster (y = 41, links neben OPTIONS bei 610)
tt_pb_init(45, 32, KK_PBB, KK_PSW);
tt_pb_hasinit = 0;                // INIT ist Werks-Eintrag 0 der Liste
kkPbI = 0;
loop(45, psetName(kkPbI); tt_pb_fname(kkPbI, #pstr); kkPbI += 1; );
tt_pb_curKind == 0 ? tt_pb_select(1, min(44, max(0, floor(M_GEN[PG_PSET] + 0.5))));

// Werks-Preset laden und die Leiste nachfuehren (SYS-Seite ruft diese Funktion).
function kkLoadF(p) ( applyPatch(p); tt_pb_select(1, p); );

// 1 = Wort j des Puffers gehoert nicht zum Anwender-Zustand (bleibt beim Laden stehen). Die Lane-Ansicht (ZOOM/SKEW/
// VOFF/ZFIT) gehoert dazu: ein Preset bringt seinen Zoom mit (Nutzervorgabe 23.10.2026), zaehlt aber nicht fuer den Stern.
function kkPbSkip(j) local(k) (
  j >= 193 && j <= 208 ? ( k = j - 193; k == PG_ON || k == PG_PAGE || k == PG_SEGSEL || k == PG_TIPS || k == PG_EXP || k == PG_FAUT || k == PG_WVUI || k == PG_PSET; )
  : 0;
);

// Capture: Zustand -> tt_pb_buf; die nicht zum Zustand gehoerenden Worte (Ansicht, Seite, PSET ...) werden auf 0 gesetzt,
// damit ein Slot nur vom Klang abhaengt (gleicher Klang = gleiche Slot-Pruefsumme).
function kkPbCapture() local(b, j) (
  b = tt_pb_buf;
  memset(b, 0, tt_pb_wps);
  b[0] = 1;
  memcpy(b + 1, M_SEG, 192);
  memcpy(b + 193, M_GEN, 16);
  memcpy(b + 209, M_SLI, 16);
  j = 1;
  loop(224, kkPbSkip(j) ? b[j] = 0; j += 1; );
);

// Puffer -> Zustand, im @gfx (wie applyPatch, innerhalb der Undo-Klammer des Aufrufers).
function kkPbApply() local(b, g, pg, ps, tp, ex, on, pt) (
  b = tt_pb_buf;
  b[0] == 1 ? (
    g = M_GEN;
    pg = g[PG_PAGE]; ps = g[PG_SEGSEL]; tp = g[PG_TIPS]; ex = g[PG_EXP]; on = g[PG_ON]; pt = g[PG_PSET];
    kkFaT = g[PG_FAUT];                    // v1.0.0
    kkWvT = g[PG_WVUI];                    // v1.0.0 (Wellenansicht)
    memcpy(M_SEG, b + 1, 192);             // samt Lane-Ansicht (ZOOM/SKEW/VOFF/ZFIT)
    memcpy(M_GEN, b + 193, 16);
    memcpy(M_SLI, b + 209, 16);
    g[PG_PAGE] = pg; g[PG_SEGSEL] = ps; g[PG_TIPS] = tp; g[PG_EXP] = ex; g[PG_ON] = on; g[PG_PSET] = pt;
    g[PG_FAUT] = kkFaT; kkFitReq = 1;      // v1.0.0
    g[PG_WVUI] = kkWvT;                    // v1.0.0 (Wellenansicht)
    validateState();
    undPset = 1;
    psetMod = 0;
  );
);

// 1 = Wort j ist Lane-Ansicht: wird gespeichert und geladen, aendert aber die Pruefsumme (Stern) nicht
function kkPbView(j) local(k) (
  j >= 1 && j <= 192 ? ( k = (j - 1) & 63; (k >= 8 && k <= 10) || k == SG_ZFIT; ) : 0;
);

// lebendes Wort j (Pufferindex)
function kkPbWord(j) ( j <= 192 ? M_SEG[j - 1] : j <= 208 ? M_GEN[j - 193] : M_SLI[j - 209]; );

// Pruefsumme des lebenden Zustands (fuer den "*"-Stern); qq = 1: jedes Wort vorher auf float32 runden (Test)
function kkPbSum(qq) local(j, s, w) (
  s = 0; j = 1;
  loop(224,
    kkPbSkip(j) || kkPbView(j) ? 0 : ( w = kkPbWord(j); qq ? ( w = tt_pb_q(w); ); s += w*((j % 37) + 1); );
    j += 1;
  );
  s;
);

// Lane-Bank v2 (2026-10-18): Datenblock aus ttkick_lanebank_data_v2.json neu erzeugt (kuratiert nach Hoerurteil 17./18.10.2026,
// 3 x 14, LP_N unveraendert 14).
// ----------------------------------------------------------------------
// B) LANE-PRESET-BROWSER (v0.9.5) — Teil 2: Daten + Apply + Namen.
//    Einfuegen DIREKT NACH psetName() (vor randLane; laneApply nutzt
//    laneInit, das weiter oben liegt - ordercheck-sicher).
//    Aus tt-kick_lanebank.py: 42/42 Solo-Renderings QA-gruen
//    (tt-kick_lab.py-Formeln, Peak 0.08..0.95, Dauer, Ranges).
//    lpSet schreibt NUR die 16 Klang-Parameter (MODE=0): START (Sample-
//    Fenster), ZOOM/SKEW/VOFF (Ansicht) und MUTE/SOLO bleiben unangetastet
//    (Sandbox-Prinzip, ShaperBox-Formel).
// ----------------------------------------------------------------------
function lpSet(s, ga, pi, ln, rv, xf, ph, f0, f1, cv, dr, rm, mx, xi, fcut, fres) local(b) (
  b = M_SEG + s*64;
  b[SG_MODE]  = 0;
  b[SG_GAIN]  = ga;
  b[SG_PITCH] = pi;
  b[SG_LEN]   = ln;
  b[SG_REV]   = rv;
  b[SG_XF]    = xf;
  b[SG_PH]    = ph;
  b[SG_F0]    = f0;
  b[SG_F1]    = f1;
  b[SG_CRVE]  = cv;
  b[SG_DRIFT] = dr;
  b[SG_ROOM]  = rm;
  b[SG_MIX]   = mx;
  b[SG_XFI]   = xi;
  b[SG_FCUT]  = fcut;
  b[SG_FRES]  = fres;
);

