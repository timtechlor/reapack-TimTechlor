// Lane-Preset anwenden (applyPatch-Muster, laeuft im Undo-Bracket
// des @gfx-Klicks). p = 0 = INIT-Lane (laneInit schreibt SG_LP/SG_LPS
// selbst mit); p 1..14 = Bank-Eintrag. Danach Index + Snapshot,
// Kit-Stern an (psetMod) - ein Lane-Preset ist eine echte Aenderung
// des Kick-Zustands, anders als applyPatch (undPset).
function laneApply(s, p) local(sm) (
  p < 1 ? laneInit(s)
  : s == 0 ? ( p == 1  ? lpT1()  : p == 2  ? lpT2()  : p == 3  ? lpT3()
  : p == 4  ? lpT4()  : p == 5  ? lpT5()  : p == 6  ? lpT6()
  : p == 7  ? lpT7()  : p == 8  ? lpT8()  : p == 9  ? lpT9()
  : p == 10 ? lpT10() : p == 11 ? lpT11() : p == 12 ? lpT12()
  : p == 13 ? lpT13() : lpT14(); )
  : s == 1 ? ( p == 1  ? lpB1()  : p == 2  ? lpB2()  : p == 3  ? lpB3()
  : p == 4  ? lpB4()  : p == 5  ? lpB5()  : p == 6  ? lpB6()
  : p == 7  ? lpB7()  : p == 8  ? lpB8()  : p == 9  ? lpB9()
  : p == 10 ? lpB10() : p == 11 ? lpB11() : p == 12 ? lpB12()
  : p == 13 ? lpB13() : lpB14(); )
  : ( p == 1  ? lpL1()  : p == 2  ? lpL2()  : p == 3  ? lpL3()
  : p == 4  ? lpL4()  : p == 5  ? lpL5()  : p == 6  ? lpL6()
  : p == 7  ? lpL7()  : p == 8  ? lpL8()  : p == 9  ? lpL9()
  : p == 10 ? lpL10() : p == 11 ? lpL11() : p == 12 ? lpL12()
  : p == 13 ? lpL13() : lpL14(); );
  sm = M_SEG + s*64;
  sm[SG_LP]  = p;
  sm[SG_LPS] = chkLane(s);
  sm[SG_ZFIT] = 1;              // Lane-Presets oeffnen mit ZOOM FIT (Ausschnitt = Fenster)
  psetMod = 1;
);

// ----------------------------------------------------------------------
// v1.0.1 (26.10.2026): Lane-Klaenge von einem Lua-Skript (Lane-Import, JSON im Lane-Preset-Format) an GENAU EINE Instanz.
// Protokoll wie kitReq (slider70), eigener Bereich im Namespace ttkk (frei: 0..783 Kit, 5189..5227 Theme/Test):
//   gmem[LQ_DAT + s*32]           1 = Lane s (0 TRANSIENT, 1 BODY, 2 TAIL) liefern, sonst bleibt die Lane unberuehrt
//   gmem[LQ_DAT + s*32 + 1 .. 15] GAIN, PITCH, LEN, REV, XF, PH, F0, F1, CRVE, DRIFT, ROOM, MIX, XFI, FCUT, FRES
//                                 (Einheiten wie lpSet / Lane-Bank: LEN Promille des Typ-Maximums, XF/XFI ms, Rest Promille)
//   gmem[LQ_DAT + s*32 + 16]      OFFSET in ms (v1.1.0): Lane 0 geklemmt auf 0..100, Lane 1/2 auf -100..100; 0,1-ms-Raster;
//                                 fehlt, NaN/Inf oder ausserhalb endlich -> Klemme bzw. 0. Wird immer gesetzt (alter Wert faellt weg).
//   gmem[LQ_SER]                  Seriennummer (ganzzahlig 1 .. 16777215); dann slider71 dieser Instanz = Nummer
//   gmem[LQ_RES]                  Antwort: Bitmaske der uebernommenen Lanes (1 S1, 2 S2, 4 S3)
//   gmem[LQ_ACK]                  Quittung = Nummer (zuletzt geschrieben)
// Wirkung wie laneApply: die 16 Klang-Parameter (MODE = 0 SYNTH), Fenster-START, Ansicht, MUTE/SOLO bleiben; ZOOM FIT an.
// Jeder Wert wird auf die Grenzen von validateState geklemmt; NaN/Inf aus gmem (Fremdwerte) werden nur per > und < erkannt
// (EEL2: <, <=, == sind mit NaN wahr) und durch den Lane-INIT-Wert ersetzt. SG_LP = 0 und ein Stern (SG_LPS != Summe): der
// Klang ist kein Bank-Eintrag. Undo: ein Eintrag im eigenen Ring (Klammer undoMark/undoCommit); den REAPER-Undo-Punkt legt
// das Skript nach der Quittung an (wie Load Kit), darum wird die Host-Anforderung von undoCommit hier zurueckgenommen.
// Laeuft gerade eine Maus-Klammer der Front (undArm), faellt der Import in deren Schritt (Commit beim Loslassen).
// Ein alter slider71-Wert (Projekt, Undo, Kopie, natives Preset) ist quittiert oder passt nicht zu gmem: keine Wirkung.
LQ_SER = 1024;   // gmem: Seriennummer der letzten Anfrage (Lua schreibt)
LQ_ACK = 1025;   // gmem: Seriennummer der zuletzt uebernommenen Anfrage (das FX schreibt)
LQ_RES = 1026;   // gmem: Bitmaske der uebernommenen Lanes (das FX schreibt, vor LQ_ACK)
LQ_DAT = 1040;   // gmem: 3 x 32 Worte, 1040 .. 1135

// Wert aus gmem: endlich -> in [lo, hi] geklemmt, sonst def
function lqVal(a, lo, hi, def) local(v) (
  v = gmem[a];
  (v > -1000000000000 && v < 1000000000000) ? min(hi, max(lo, v)) : def;
);

// Lane s aus dem Block a schreiben (Grenzen wie validateState, Ersatzwerte wie laneInit)
function lqLane(s, a) local(b, f) (
  b = M_SEG + s*64;
  b[SG_MODE]  = 0;
  b[SG_GAIN]  = lqVal(a + 1, 0, 200, ctlDef(31 + s));
  b[SG_PITCH] = floor(lqVal(a + 2, -24, 24, 0) + 0.5);
  b[SG_LEN]   = lqVal(a + 3, 1, 1000, ctlDef(23 + s));
  b[SG_REV]   = lqVal(a + 4, 0, 1, 0) > 0.5 ? 1 : 0;
  b[SG_XF]    = lqVal(a + 5, 0, 100, ctlDef(26 + s));
  b[SG_PH]    = floor(lqVal(a + 6, -500, 500, 0) + 0.5);
  // F0/F1: 0 Hz und darunter sind sinnlos -> Lane-Default (wie validateState)
  f = lqVal(a + 7, 0, 18000, 0);
  b[SG_F0]    = f > 0 ? f : laneDef(s, SG_F0);
  f = lqVal(a + 8, 0, 18000, 0);
  b[SG_F1]    = f > 0 ? f : laneDef(s, SG_F1);
  b[SG_CRVE]  = lqVal(a + 9,  0, 1000, laneDef(s, SG_CRVE));
  b[SG_DRIFT] = lqVal(a + 10, 0, 1000, laneDef(s, SG_DRIFT));
  b[SG_ROOM]  = lqVal(a + 11, 0, 1000, laneDef(s, SG_ROOM));
  b[SG_MIX]   = lqVal(a + 12, 0, 1000, laneDef(s, SG_MIX));
  b[SG_XFI]   = lqVal(a + 13, 0, 100, ctlDef(117));
  b[SG_FCUT]  = lqVal(a + 14, 0, 1000, ctlDef(120));
  b[SG_FRES]  = lqVal(a + 15, 0, 1000, ctlDef(121));
  // v1.1.0: OFFSET ms; ein altes Skript schreibt Stelle 16 nicht (gmem ist dann 0 oder alt: Fremdwerte werden geklemmt)
  b[SG_OFF]   = floor(lqVal(a + 16, s == 0 ? 0 : -100, 100, 0)*10 + 0.5)*0.1;
  b[SG_LP]    = 0;
  b[SG_LPS]   = chkLane(s) + 1;   // Stern: importierter Klang, kein Bank-Eintrag
  b[SG_ZFIT]  = 1;
);

function laneReq() local(q, s, n, ua, ur) (
  q = floor(slider71 + 0.5);
  q != lqLast ? (
    lqLast = q;
    // gmem[LQ_SER] > 0.5 zuerst: == ist in EEL2 mit NaN wahr (Fallenliste Punkt 6)
    (q > 0 && gmem[LQ_SER] > 0.5 && gmem[LQ_SER] == q && gmem[LQ_ACK] != q) ? (
      ua = undArm; ur = tt_undoreq;
      ua ? 0 : undoMark();
      n = 0; s = 0;
      loop(3,
        gmem[LQ_DAT + s*32] > 0.5 ? ( lqLane(s, LQ_DAT + s*32); n += 2^s; );
        s += 1;
      );
      n > 0 ? psetMod = 1;
      ua ? 0 : ( undoCommit(); tt_undoreq = ur; );
      gmem[LQ_RES] = n;
      gmem[LQ_ACK] = q;
    );
  );
);

// Anzeigename eines Lane-Presets -> #lpstr (psetName-Muster: FLACHE
// Kette - verschachtelte Ternary-Ketten in Klammergruppen sind in EEL2
// nicht kompilierbar, das gab @init:3203 beim ersten Probe-Start).
function lpName(s, p) (
  p < 1 ? strcpy(#lpstr, "INIT")
  : s == 0 && p == 1  ? sprintf(#lpstr, "NEEDLE")
  : s == 0 && p == 2  ? sprintf(#lpstr, "GLASS CLICK")
  : s == 0 && p == 3  ? sprintf(#lpstr, "RAVE SNAP")
  : s == 0 && p == 4  ? sprintf(#lpstr, "DRY CLICK")
  : s == 0 && p == 5  ? sprintf(#lpstr, "METAL EDGE")
  : s == 0 && p == 6  ? sprintf(#lpstr, "FUZZ TOP")
  : s == 0 && p == 7  ? sprintf(#lpstr, "RIM CLICK")
  : s == 0 && p == 8  ? sprintf(#lpstr, "SLAM TOP")
  : s == 0 && p == 9  ? sprintf(#lpstr, "MUFFLED KNOCK")
  : s == 0 && p == 10 ? sprintf(#lpstr, "CARDBOARD")
  : s == 0 && p == 11 ? sprintf(#lpstr, "PUNCH TOP")
  : s == 0 && p == 12 ? sprintf(#lpstr, "SOFT TAP")
  : s == 0 && p == 13 ? sprintf(#lpstr, "WOOD KNOCK A")
  : s == 0 && p == 14 ? sprintf(#lpstr, "WOOD KNOCK B")
  : s == 1 && p == 1  ? sprintf(#lpstr, "TIGHT 909")
  : s == 1 && p == 2  ? sprintf(#lpstr, "MIN DRY")
  : s == 1 && p == 3  ? sprintf(#lpstr, "HARD CORE")
  : s == 1 && p == 4  ? sprintf(#lpstr, "SNAPPY 909")
  : s == 1 && p == 5  ? sprintf(#lpstr, "IRON FIST")
  : s == 1 && p == 6  ? sprintf(#lpstr, "DRY HIT")
  : s == 1 && p == 7  ? sprintf(#lpstr, "TIGHT ROLL")
  : s == 1 && p == 8  ? sprintf(#lpstr, "ACID GLIDE")
  : s == 1 && p == 9  ? sprintf(#lpstr, "LM DRUM")
  : s == 1 && p == 10 ? sprintf(#lpstr, "WARM 70S")
  : s == 1 && p == 11 ? sprintf(#lpstr, "808 ROUND")
  : s == 1 && p == 12 ? sprintf(#lpstr, "SOFT BODY")
  : s == 1 && p == 13 ? sprintf(#lpstr, "SUB DEEP")
  : s == 1 && p == 14 ? sprintf(#lpstr, "RUMBLE BODY")
  : s == 2 && p == 1  ? sprintf(#lpstr, "STUB")
  : s == 2 && p == 2  ? sprintf(#lpstr, "CLEAN CUT")
  : s == 2 && p == 3  ? sprintf(#lpstr, "DRUM BOX")
  : s == 2 && p == 4  ? sprintf(#lpstr, "SHORT SUB")
  : s == 2 && p == 5  ? sprintf(#lpstr, "DAMPED TAIL")
  : s == 2 && p == 6  ? sprintf(#lpstr, "TECH TAIL")
  : s == 2 && p == 7  ? sprintf(#lpstr, "OLD ROOM")
  : s == 2 && p == 8  ? sprintf(#lpstr, "MUFFLED ROOM")
  : s == 2 && p == 9  ? sprintf(#lpstr, "WARM 707")
  : s == 2 && p == 10 ? sprintf(#lpstr, "TECHNO RUMBLE")
  : s == 2 && p == 11 ? sprintf(#lpstr, "BOTTOM END")
  : s == 2 && p == 12 ? sprintf(#lpstr, "WAREHOUSE TL")
  : s == 2 && p == 13 ? sprintf(#lpstr, "BROKEN SUB")
  : s == 2 && p == 14 ? sprintf(#lpstr, "HEAVY SUB")
  : strcpy(#lpstr, "INIT");
);

// Kategorie des Werks-Presets p (1..44) -> 1..8 (UI-Tabs der SYSTEM-Seite):
// 1 909, 2 808, 3 HARD, 4 RUMBLE, 5 MINIMAL, 6 DEEP, 7 ROLL, 8 CHAR.
// Tabelle = ein Zeichen je Preset (Index p - 1) in Stepper-Reihenfolge.
function psetCat(p) (
  strcpy(#pcat, "11112223333144445555777666888811233455766888");
  str_getchar(#pcat, max(0, min(43, p - 1))) - 48;
);


// ----------------------------------------------------------------------
// Front-Bausteine (Designraster 900 x 700)
// ----------------------------------------------------------------------

// Die Front-Primitive (xrect, xline, xcirc, xat, xstr, xctr, inBox) und die Theme-Farben (colAcid, colDim,
// colWhite, colInk) kommen aus dem gemeinsamen UI-Kit (siehe __UIKIT_BEGIN__ oben).
// Warnfarbe (Orange, 0xFFB35C) - Soll-Bereich verfehlt (v0.8.0), SOLO (v0.9.1)
function colWarn(a) ( gfx_set(tth_alR, tth_alG, tth_alB, a); );

// v0.10.0: fast schwarze Flaechen (Wellenboxen, Schienen, Tooltip) - Werte des ACID-Looks,
// je Kanal mit dem Verhaeltnis Schema-Grund / ACID-Grund skaliert (ACID: exakt unveraendert).
function kTb(r, g, b, a) ( gfx_set(r*tth_bgR/0.050, g*tth_bgG/0.054, b*tth_bgB/0.050, a); );


// Preset-Tab der SYSTEM-Seite (v0.9.4): c = 0 -> INIT (laedt sofort), 1..8 ->
// Kategorie waehlen (laedt nichts). Rueckgabe wie btn().
function psTab(x, w, c, s) (
  btn(x, 108, w, 20, c == 0 ? pset == 0 : psCat == c, s)
    ? ( c == 0 ? kkLoadF(0) : ( psCat = c; ); );
);

// ----------------------------------------------------------------------
// Tooltips (v0.9.0). tip(t) merkt sich pro Frame den Hover-Text in
// #tTipTxt (leer = kein Hover; @gfx loescht ihn am Frameanfang), das
// Panel zeichnet tipDraw() ganz am Ende von @gfx. Trenner "|" = neue
// Zeile (max. 3). Waehrend eines Drags (dragId >= 0) wird nichts gesetzt.
// Zeilen, die mit "CTRL" beginnen, erscheinen in Acid.
// ----------------------------------------------------------------------
function tip(t) ( dragId < 0 && lpMenu < 1 ? strcpy(#tTipTxt, t); );
// Review 14.10.2026 (Kit 7, Codex F2): Tooltip der Eintraege im offenen Lane-Preset-Menue. tip() nimmt bei offenem Menue
// bewusst nichts an (Elemente darunter); die Menuezeilen selbst brauchen diesen eigenen Weg.
function tipMenu(t) ( dragId < 0 ? strcpy(#tTipTxt, t); );
function tipAt(x, y, w, h, t) ( inBox(x, y, w, h) ? tip(t); );
// Hotbox eines mFade-Faders (x - 4, y - 3, w + 8, 16)

function tipLn(s, x, y) (
  str_getchar(s, 0) == 67 && str_getchar(s, 1) == 84 ? colAcid(0.8) : colInk(1);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(s);
);

// Schwebendes Panel nahe der Maus (+16 px), ins Fenster geclampt; passt
// es unten nicht mehr hin, klappt es ueber den Zeiger. Bildschirmpixel,
// nicht Designraster - die Schrift (Font 3) skaliert selbst mit SC.
// v0.12.3 (P23): bei tth_tipoff == 1 (OPTIONS > TOOLTIPS OFF; P25: einziger Schalter) wird nichts gezeichnet; die Position
// folgt der echten Maus kkRmx/kkRmy (Fensterpixel, in @gfx vor der Maskierung durch tth_pre/tt_pb_pre gemerkt) - die
// Tooltips der Preset-Leiste und des OPTIONS-Buttons liegen genau in den maskierten Zonen (mouse_x = -10000).
function tipPaint() local(n, i, st, nl, tw, th, w, lh, bw, bh, px, py, pad) (
  n = strlen(#tTipTxt);
  nl = 0; st = 0; i = 0;
  loop(n + 1,
    i >= n || str_getchar(#tTipTxt, i) == 124 ? (
      nl < 3 ? (
        nl == 0 ? strcpy_substr(#tipL0, #tTipTxt, st, i - st)
        : nl == 1 ? strcpy_substr(#tipL1, #tTipTxt, st, i - st)
        : strcpy_substr(#tipL2, #tTipTxt, st, i - st);
        nl += 1;
      );
      st = i + 1;
    );
    i += 1;
  );
  gfx_setfont(3);
  gfx_measurestr(#tipL0, tw, th); w = tw; lh = th;
  nl > 1 ? ( gfx_measurestr(#tipL1, tw, th); w = max(w, tw); ) : 0;
  nl > 2 ? ( gfx_measurestr(#tipL2, tw, th); w = max(w, tw); ) : 0;
  pad = max(4, 5*SC);
  bw = w + 2*pad;
  bh = nl*lh + 2*pad;
  px = kkRmx + 16;
  py = kkRmy + 16;
  px + bw > gfx_w - 2 ? ( px = gfx_w - 2 - bw; );
  px < 2 ? ( px = 2; );
  py + bh > gfx_h - 2 ? ( py = kkRmy - bh - 8; );
  py < 2 ? ( py = 2; );
  kTb(0.030, 0.035, 0.030, 0.97);
  gfx_rect(px, py, bw, bh, 1);
  colAcid(0.9);
  gfx_rect(px, py, bw, 1, 1);      gfx_rect(px, py + bh - 1, bw, 1, 1);
  gfx_rect(px, py, 1, bh, 1);      gfx_rect(px + bw - 1, py, 1, bh, 1);
  tipLn(#tipL0, px + pad, py + pad);
  nl > 1 ? tipLn(#tipL1, px + pad, py + pad + lh) : 0;
  nl > 2 ? tipLn(#tipL2, px + pad, py + pad + 2*lh) : 0;
);
function tipDraw() ( tth_tipoff ? 0 : tipPaint(); );

// ----------------------------------------------------------------------
// Es gibt nur EINEN Tooltip-Schalter (OPTIONS > TOOLTIPS, tth_tipoff); PG_TIPS wird nur in @serialize gelesen
// (Abbildung auf tth_tipoff) und geschrieben (aus tth_tipoff). Die Kopfzeilen-Tooltips (Preset-Leiste je Element,
// OPTIONS-Knopf) kommen aus dem Kit (tt_modtips + tt_tipflush am Ende von @gfx, Kit-Tooltip an der Maus); das eigene
// Panel tipPaint bleibt fuer die Front.
//


// Promille-Schreibwert eines mFade-Ergebnisses (v0.8.1). Der alte
// Vergleich nv*1000 != msb[..] scheiterte bei 128 der ganzzahligen
// Promillewerte 0..1000 an der Gleitkomma-Rundung (k*0.001*1000 != k):
// der Fader schrieb dann Frame fuer Frame Rundungswerte zurueck, jede
// Klick-Klammer sah mark != commit. Jetzt: unveraendert (Toleranz
// 0,001 Promille) -> cur bleibt bitgenau; sonst exakte Ganzzahl.
function mPm(nv, cur) (
  abs(nv*1000 - cur) > 0.001 ? floor(nv*1000 + 0.5) : cur;
);

// Lane-View: Zoom/Skew/Offset eines Segments -> gZ_fac/gZ_span/gZ_off.
// SG_ZOOM ist Promille -> Faktor 2^(6x) = 1..64fach, gZ_off ist der
// Slot-Anteil am linken Bildrand (geclamppt auf den sichtbaren Rest).
// ZOOM FIT (SG_ZFIT = 1): der Ausschnitt folgt dem Lane-Fenster [START, START + LEN] mit 4 % Rand links und rechts
// (Grenzen: Zoom 1..64fach) und schreibt ZOOM/VOFF mit, damit -, +, Rad und Rollbalken nahtlos daran anschliessen.
// Waehrend die START- oder END-Flagge dieser Lane gezogen wird, steht der Ausschnitt still (sonst liefe die Flagge
// der Maus davon); nach dem Loslassen passt er sich wieder an.
function laneView(s) local(sm, a, e, l, sp, z, o) (
  sm = M_SEG + s*64;
  sm[SG_ZFIT] > 0.5 && dragId != 20 + s && dragId != 23 + s ? (
    a = sm[SG_MODE] == 1 ? sm[SG_START]*0.001 : 0;
    e = min(1, a + sm[SG_LEN]*0.001);
    l = max(0.001, e - a);
    sp = min(1, max(0.015625, l*1.08));
    z = min(1000, max(0, log(1/sp)/(0.006*log(2))));
    sp = 1/2^(z*0.006);
    o = max(0, min(1 - sp, a - l*0.04));
    abs(z - sm[SG_ZOOM]) > 0.001 ? ( sm[SG_ZOOM] = z; ) : 0;
    abs(o*1000 - sm[SG_VOFF]) > 0.001 ? ( sm[SG_VOFF] = o*1000; ) : 0;
  ) : 0;
  gZ_fac  = 2^(sm[SG_ZOOM]*0.006);
  gZ_span = 1/gZ_fac;
  gZ_off  = min(sm[SG_VOFF]*0.001, max(0, 1 - gZ_span));
);

// Zoom um dz Promille (+ = naeher), Anker frac (0..1) im sichtbaren Bereich bleibt stehen; schaltet ZOOM FIT aus.
function laneZoomBy(s, dz, frac) local(sm, a, nz, sp) (
  laneView(s);
  sm = M_SEG + s*64;
  a = gZ_off + frac*gZ_span;
  nz = min(1000, max(0, sm[SG_ZOOM] + dz));
  sp = 1/2^(nz*0.006);
  sm[SG_ZOOM] = nz;
  sm[SG_VOFF] = min(1000, max(0, min(1 - sp, a - frac*sp)*1000));
  sm[SG_ZFIT] = 0;
  laneView(s);
);

// Ausschnitt auf den linken Rand off (Slot-Anteil) rollen; schaltet ZOOM FIT aus.
function laneScroll(s, off) local(sm) (
  laneView(s);
  sm = M_SEG + s*64;
  sm[SG_VOFF] = min(1000, max(0, min(1 - gZ_span, off)*1000));
  sm[SG_ZFIT] = 0;
  laneView(s);
);

// Adaptiver Zeit-Ruler (v0.9.3) - reine Anzeige. Zeichnet in die Box
// (x, y, w, h) vertikale Linien fuer "nette" Zeitmarken zwischen ms0 und ms1
// (sichtbarer Bereich, Box links = ms0, rechts = ms1) und Labels an der
// Unterkante. Step = KLEINster Wert der Leiter 0.5/1/2/5/10/25/50/100/250/
// 500/1000/2500 ms mit w*step/(ms1-ms0) >= 55 px (Fallback 2500). Passt
// zusaetzlich w*step/2/(ms1-ms0) >= 30 px, kommt eine Zwischenlinie bei
// halbem Step mit halbem Alpha dazu (ohne Label). Die Null-Linie (0 ms =
// Slot-/Kettenanfang) ist kraeftiger. Alles bleibt innerhalb der Box.
function drawTimeGrid(x, y, w, h, ms0, ms1) local(span, st, sub, minor, i, n, mj, ms, gx, tw, th, lx, first) (
  span = ms1 - ms0;
  span > 0 && w > 0 ? (
    st = w*0.5/span >= 55 ? 0.5 : w*1/span >= 55 ? 1 : w*2/span >= 55 ? 2
       : w*5/span >= 55 ? 5 : w*10/span >= 55 ? 10 : w*25/span >= 55 ? 25
       : w*50/span >= 55 ? 50 : w*100/span >= 55 ? 100 : w*250/span >= 55 ? 250
       : w*500/span >= 55 ? 500 : w*1000/span >= 55 ? 1000 : 2500;
    sub = st*0.5;
    minor = w*sub/span >= 30;
    i = ceil(ms0/sub);
    n = min(400, floor(ms1/sub) - i + 1);
    first = 1;
    gfx_setfont(5);
    loop(max(0, n),
      mj = i - 2*floor(i*0.5) < 0.5;              // gerades Vielfaches von sub = Hauptlinie
      ms = i*sub;
      gx = x + (ms - ms0)/span*w;
      (mj || minor) && gx >= x && gx <= x + w ? (
        colAcid(ms == 0 ? 0.30 : mj ? 0.14 : 0.07);
        xline(gx, y, gx, y + h - 1);
        mj ? (
          // ganzzahlige ms; nur beim 0,5-ms-Step mit einer Nachkommastelle
          ms == floor(ms) ? (
            first ? sprintf(#tgTxt, "%d MS", ms) : sprintf(#tgTxt, "%d", ms);
          ) : (
            first ? sprintf(#tgTxt, "%.1f MS", ms) : sprintf(#tgTxt, "%.1f", ms);
          );
          first = 0;
          gfx_measurestr(#tgTxt, tw, th);
          lx = min(x + w - 1 - tw/SC, max(x + 1, gx - tw*0.5/SC));
          tth_tn(0.17, 0.44, 0.12, 1);
          xat(lx, y + h - 1 - th/SC);
          gfx_drawstr(#tgTxt);
        ) : 0;
      ) : 0;
      i += 1;
    );
  ) : 0;
);

// Horizontale Wellenform aus dem Peak-Cache (128 Buckets, kein
// Sample-fuer-Sample im gfx) - zoom- und skew-faehig. Das Fenster
// [stF, enF) in Slot-Anteilen brennt in Acid, der Rest dimmt weg;
// pro Spalte wird der zugehoerige Bucket gesucht, damit Zoom und
// Pan stimmen (M_PEAK bleibt ein 128er-Cache, Mehraufloesung gabe
// es nur mit echtem Sample-Zugriff).
function drawWaveZ(x, y, w, h, sl, stF, enF) local(k, amp, sx, pk, fr, bi, skf, qm, sLen, tg) (
  qm = M_SEG + sl*64;
  skf = 2^(qm[SG_SKEW]*0.004);
  tth_tn(0.10, 0.13, 0.08, 1);
  xline(x, y + h*0.5, x + w, y + h*0.5);
  // v0.9.3: Zeit-Ruler UNTER der Wellenform. Spalte k zeigt den Slot-Anteil
  // fr = gZ_off + k*gZ_span/w (Zeile unten); Slot = SM_LEN Frames -> ms.
  // Links (k = 0) fr = gZ_off, rechts (k = w) fr = gZ_off + gZ_span - dieselben
  // Globals wie das Mapping, Zoom/Pan wirken damit automatisch auf den Ruler.
  tg = M_GEN + 32 + sl*16;
  sLen = tg[SM_LEN];
  sLen > 0 ? drawTimeGrid(x, y, w, h, gZ_off*sLen/srate*1000, (gZ_off + gZ_span)*sLen/srate*1000) : 0;
  pk = M_PEAK + sl*128;
  k = 0;
  loop(w,
    fr = gZ_off + k*gZ_span/w;
    bi = min(127, max(0, floor(fr*128)));
    amp = pk[bi]*skf;
    amp > 1 ? amp = 1 : 0;
    amp < 0.008 ? amp = 0.008 : 0;
    fr >= stF && fr < enF ? gfx_set(accR, accG, accB, 1)
                          : tth_tn(0.10, 0.17, 0.07, 1);
    sx = x + k;
    xline(sx, y + h*0.5 - amp*h*0.46, sx, y + h*0.5 + amp*h*0.46);
    k += 1;
  );
);

// Marker-Raute an der Oberkante der Wellen-Box (Crossfade-Griff)
function xfMark(x, y, hot) (
  hot ? colAcid(1) : tth_tn(0.17, 0.44, 0.12, 1);
  xline(x - 4, y, x, y - 5);
  xline(x, y - 5, x + 4, y);
  xline(x + 4, y, x, y + 5);
  xline(x, y + 5, x - 4, y);
);

// ----------------------------------------------------------------------
// EXPERT-Potis (v0.9.1)
// Ein Poti ist eine 45 x 44 px grosse Zelle: Name (Font 5), Drehknopf r = 8
// (Wertebogen in Acid, Zeigerlinie), Wert darunter. Der Knopf ist mit 8 px
// kleiner als die im Auftrag genannten ~10 - hoeher geht die Zelle in den
// 124 px der Lane nicht (Layoutnachweis: verify_v091.py [archiviert]).
// HIT-LOGIK (kein dragId - die Drag-ID-Registry bleibt unberuehrt):
//   * hover-basiert wie mFade: die Zelle unter der Maus (inBox) ist "heiss",
//     Klickflanke (uiClick) auf eine heisse Zelle greift sie;
//   * gegriffen = Zustand kbDrag (Schluessel = Lane*16 + Slot, -1 = keiner),
//     Anker kbY0/kbN0 (Mausy und normierter Wert beim Greifen). Der Wert
//     folgt der VERTIKALEN Mausbewegung relativ zum Anker (120 px = ganzer
//     Weg, SHIFT = 480 px), NICHT der absoluten Position; ein Klick ohne
//     Bewegung aendert nichts (kbMv), auch nicht durch Rundung/Klemmung;
//   * Loslassen (!uiLmb) setzt kbDrag = -1 (Zeile neben dragId = -1 in
//     @gfx); waehrend des Ziehens ist Tooltip und Mausrad stumm;
//   * STRG+Klick = Reset auf den Default (ctlDef/laneDef), kein Drag;
//   * die Undo-Klammer kommt wie bei allen Reglern vom globalen Klick-
//     Mark/Commit in @gfx (ein Eintrag je Drag).
// Rueckgabe: neuer Wert in Parametereinheiten (immer ganzzahlig, geklemmt);
// kbCh = 1 nur, wenn er sich geaendert hat - der Aufrufer schreibt NUR dann
// (sonst wuerde Rundung ein Feld Frame fuer Frame umschreiben, vgl. mPm).
// ----------------------------------------------------------------------
// v1.1.0: elf Zellen (OFFSET kam dazu) teilen sich die 450 Raster-Einheiten der Reihe 180..630: Zellbreite KB_W, halbe Breite KB_H.
KB_W = 450/11; KB_H = KB_W*0.5;
function kbArc(cx, cy, r, a0, a1) local(n, k, a, xp, yp, xn, yn) (
  n = max(1, ceil(abs(a1 - a0)/0.3));
  xp = cx + r*sin(a0); yp = cy - r*cos(a0);
  k = 0;
  loop(n,
    k += 1;
    a = a0 + (a1 - a0)*k/n;
    xn = cx + r*sin(a); yn = cy - r*cos(a);
    xline(xp, yp, xn, yn);
    xp = xn; yp = yn;
  );
);

// v0.12.0 (P21): ehemals knob(...) - in kbKnob umbenannt (Namenskollision mit
// dem Kit-Regler knob(id, cx, cy, r, ...); EEL2-Namen sind case-insensitiv).
// EXPERT-Poti einer Zelle (v0.9.1): eigener Zustand (kbDrag/kbY0/kbN0), keine
// Drag-ID. Signatur und Verhalten unveraendert. P25: zusaetzlich Mausrad (siehe unten).
function kbKnob(cx, T, key, lbl, cur, vmin, vmax, lg, dflt, bip, en) local(cy, r, n, hot, fine, nn, v, a, vmx) (
  kbCh = 0;
  r = 8; cy = T + 22;
  vmx = lg ? log(vmax/vmin) : vmax - vmin;
  n = lg ? log(max(vmin, cur)/vmin)/vmx : (cur - vmin)/vmx;
  n = min(1, max(0, n));
  v = cur;
  hot = en && inBox(cx - KB_H, T, KB_W, 44);
  hot && uiClick ? (
    (mouse_cap & 4) ? (
      v = dflt;                                  // STRG+Klick: Reset
    ) : (
      kbDrag = key; kbY0 = mY; kbN0 = n; kbMv = 0;
      kbFine = (mouse_cap & 8) ? 1 : 0;
    );
  ) : 0;
  en && kbDrag == key && uiLmb && !uiClick ? (
    fine = (mouse_cap & 8) ? 1 : 0;
    fine != kbFine ? ( kbFine = fine; kbY0 = mY; kbN0 = n; ) : 0;   // neu verankern
    kbY0 != mY ? ( kbMv = 1; ) : 0;
    kbMv ? (
      nn = min(1, max(0, kbN0 + (kbY0 - mY)*(kbFine ? 0.0020833333 : 0.0083333333)));
      v = lg ? vmin*exp(nn*vmx) : vmin + nn*vmx;
      v = min(vmax, max(vmin, floor(v + 0.5)));
    ) : 0;
  ) : 0;
  // P25 (Harmonisierung Punkt 8): Mausrad ueber der Zelle, Suite-Regel fuer gerastete Regler. Die Werte sind ganz-
  // zahlig: Bereiche bis 200 Stufen (PITCH, XF-IN/OUT, F0/F1 von S3 und F1 von S2) einen Schritt je Raste; groessere
  // (LEN, NOISE/CURVE/DRIFT/ROOM, CUT, RES 0..1000; F0/F1 sonst) 2 % des Weges je Raste - bei lg auf der log-Skala -,
  // danach gerundet und mindestens ein Schritt (sonst liefe ein kleiner log-Schritt auf den alten Wert zurueck).
  // Rad-Reste werden gesammelt (kbWacc, Touchpad). Nicht waehrend eines Zugs (dann ist das Rad ohnehin auf 0).
  // Undo/Host: die Mausrad-Klammer in @gfx (kkWhUnd) schreibt den Schritt ins eigene Undo.
  en && hot && kbDrag < 0 && mouse_wheel != 0 ? (
    kbWacc += mouse_wheel;
    kbWk = kbWacc > 0 ? floor(kbWacc/120) : 0 - floor((0 - kbWacc)/120);
    kbWacc -= kbWk*120;
    kbWk != 0 ? (
      vmax - vmin <= 200 ? ( v = cur + kbWk; ) : (
        nn = min(1, max(0, n + kbWk*0.02));
        v = lg ? vmin*exp(nn*vmx) : vmin + nn*vmx;
      );
      v = floor(v + 0.5);
      v == cur ? ( v = cur + (kbWk > 0 ? 1 : -1); );
      v = min(vmax, max(vmin, v));
    );
    mouse_wheel = 0;
  ) : 0;
  kbCh = v != cur;
  // --- Zeichnen (Wert v = Stand NACH der Bearbeitung)
  n = lg ? log(max(vmin, v)/vmin)/vmx : (v - vmin)/vmx;
  n = min(1, max(0, n));
  a = -2.356194 + 4.712389*n;
  gfx_setfont(5);
  en ? colInk(0.95) : colInk(0.40);
  xctr(cx - KB_H, T, KB_W, 13, lbl);
  kTb(0.085, 0.090, 0.085, 1); xcirc(cx, cy, r, 1);
  hot || kbDrag == key ? tth_tn(0.30, 0.55, 0.24, 1) : colDim(1);
  kbArc(cx, cy, r, -2.356194, 2.356194);
  en ? colAcid(1) : tth_tn(0.20, 0.30, 0.18, 1);
  bip ? kbArc(cx, cy, r, 0, a) : kbArc(cx, cy, r, -2.356194, a);
  colWhite(en ? 0.90 : 0.30);
  xline(cx + 0.35*r*sin(a), cy - 0.35*r*cos(a), cx + r*sin(a), cy - r*cos(a));
  v;
);

// Wert-Zeile einer Zelle: #kbTxt (vom Aufrufer per sprintf gefuellt)
function kbTxtDraw(cx, T, en) (
  gfx_setfont(5);
  en ? colAcid(1) : colInk(0.40);
  xctr(cx - KB_H, T + 31, KB_W, 13, #kbTxt);
);
function kbTipCell(cx, T, txt) ( tipAt(cx - KB_H, T, KB_W, 44, txt); );

// Zellmitte von Slot k (0..10): 11 Zellen x KB_W (= 450/11) ab x = 180 (bis 630)
function kbCx(k) ( 180 + KB_W*(k + 0.5); );

// Hz-Text: < 1000 ganzzahlig, sonst in kHz
function kbHzTxt(v) (
  v < 1000 ? sprintf(#kbTxt, "%d", floor(v + 0.5)) : sprintf(#kbTxt, "%.1fK", v*0.001);
);
// Beschriftung F0/F1 mit der naechstgelegenen Note: "F0 A1" (die Wertzeile zeigt die Hz; beides zusammen waere breiter als die Zelle)
function kbNoteLbl(lbl, v) (
  noteStr(hzNote(v));
  sprintf(#kbLbl, "%s %s", lbl, #vstr);
);

// Die Poti-Reihe einer Lane. Slots: 0..3 Engine (nur SYNTH; S1/S2 belegen
// 0..2, S3 0..3), 4 PITCH, 5 LEN, 6 OFFSET (v1.1.0), 7 XF-IN, 8 XF-OUT, 9 CUT, 10 RES - die
// gemeinsamen Regler sitzen in beiden Modi an derselben Stelle. T = Oberkante.
function knobRow(s, T) local(sm, md, fmin, fmax, nv, cx, kk, ms) (
  sm = M_SEG + s*64;
  md = sm[SG_MODE] < 0.5;
  kk = s*16;
  colDim(1); xline(180 + KB_W*4, T + 2, 180 + KB_W*4, T + 42);   // Engine | gemeinsam
  md ? (
    // ---- Slot 0 / 1: F0, F1 (logarithmisch)
    fmin = s == 0 ? 300 : s == 1 ? 35 : 30;
    fmax = s == 0 ? 4000 : s == 1 ? 350 : 90;
    cx = kbCx(0);
    kbNoteLbl("F0", sm[SG_F0]);
    nv = kbKnob(cx, T, kk, #kbLbl, sm[SG_F0], fmin, fmax, 1, laneDef(s, SG_F0), 0, 1);
    kbCh ? ( sm[SG_F0] = nv; ) : 0;
    kbHzTxt(sm[SG_F0]); kbTxtDraw(cx, T, 1);
    sprintf(#kbTip, "F0: start of the sweep, %d-%d Hz (log), with the nearest note (A4 = 440 Hz)|Frozen when a kick triggers|CTRL+click: reset", fmin, fmax);
    kbTipCell(cx, T, #kbTip);
    fmin = s == 0 ? 100 : s == 1 ? 30 : 25;
    fmax = s == 0 ? 1200 : s == 1 ? 120 : 70;
    cx = kbCx(1);
    kbNoteLbl("F1", sm[SG_F1]);
    nv = kbKnob(cx, T, kk + 1, #kbLbl, sm[SG_F1], fmin, fmax, 1, laneDef(s, SG_F1), 0, 1);
    kbCh ? ( sm[SG_F1] = nv; ) : 0;
    kbHzTxt(sm[SG_F1]); kbTxtDraw(cx, T, 1);
    sprintf(#kbTip, "F1: target of the sweep, %d-%d Hz (log), with the nearest note (A4 = 440 Hz)|Reached at the end of the window|CTRL+click: reset", fmin, fmax);
    kbTipCell(cx, T, #kbTip);
    // ---- Slot 2: NOISE (S1) / CURVE (S2) / DRIFT (S3)
    cx = kbCx(2);
    s == 0 ? (
      nv = kbKnob(cx, T, kk + 2, "NOISE", sm[SG_MIX], 0, 1000, 0, laneDef(s, SG_MIX), 0, 1);
      kbCh ? ( sm[SG_MIX] = nv; ) : 0;
      sprintf(#kbTxt, "%d%%", floor(sm[SG_MIX]*0.1 + 0.5));
      kbTipCell(cx, T, "NOISE: noise share of the click, 0-100%|0 = pure oscillator click|CTRL+click: reset");
    ) : s == 1 ? (
      nv = kbKnob(cx, T, kk + 2, "CURVE", sm[SG_CRVE], 0, 1000, 0, laneDef(s, SG_CRVE), 0, 1);
      kbCh ? ( sm[SG_CRVE] = nv; ) : 0;
      sprintf(#kbTxt, "%d%%", floor(sm[SG_CRVE]*0.1 + 0.5));
      kbTipCell(cx, T, "CURVE: shape of the F0 > F1 sweep, 0-100%|Low = long high pitch, high = hard drop|CTRL+click: reset");
    ) : (
      nv = kbKnob(cx, T, kk + 2, "DRIFT", sm[SG_DRIFT], 0, 1000, 0, laneDef(s, SG_DRIFT), 0, 1);
      kbCh ? ( sm[SG_DRIFT] = nv; ) : 0;
      sprintf(#kbTxt, "%d%%", floor(sm[SG_DRIFT]*0.1 + 0.5));
      kbTipCell(cx, T, "DRIFT: slow amplitude wobble of the tail, 0-100%|Adds movement (about 7-14 Hz)|CTRL+click: reset");
    );
    kbTxtDraw(cx, T, 1);
    // ---- Slot 3: ROOM (nur S3)
    s == 2 ? (
      cx = kbCx(3);
      nv = kbKnob(cx, T, kk + 3, "ROOM", sm[SG_ROOM], 0, 1000, 0, laneDef(s, SG_ROOM), 0, 1);
      kbCh ? ( sm[SG_ROOM] = nv; ) : 0;
      sprintf(#kbTxt, "%d%%", floor(sm[SG_ROOM]*0.1 + 0.5));
      kbTxtDraw(cx, T, 1);
      kbTipCell(cx, T, "ROOM: detuned copy plus noise in the tail, 0-100%|Adds air and beating|CTRL+click: reset");
    ) : 0;
  ) : (
    gfx_setfont(5); colInk(0.45);
    xctr(180, T, KB_W*4, 44, "NO ENGINE KNOBS (SAMPLE)");
  );
  // ---- Slot 4: PITCH (bipolar)
  cx = kbCx(4);
  nv = kbKnob(cx, T, kk + 4, "PITCH", sm[SG_PITCH], -24, 24, 0, ctlDef(102), 1, 1);
  kbCh ? ( sm[SG_PITCH] = nv; ) : 0;
  nv = floor(sm[SG_PITCH] + 0.5);
  nv > 0 ? sprintf(#kbTxt, "+%d", nv) : sprintf(#kbTxt, "%d", nv);
  kbTxtDraw(cx, T, 1);
  kbTipCell(cx, T, "PITCH: detune this lane, -24..+24 semitones|Scales the engine frequencies or the sample speed|CTRL+click: reset");
  // ---- Slot 5: LEN (Fensterlaenge; wie die END-Flagge an START gebunden)
  cx = kbCx(5);
  nv = kbKnob(cx, T, kk + 5, "LEN", sm[SG_LEN], 1, 1000, 0, lenDef(s, sm[SG_MODE]), 0, 1);
  // P25 (Review A6): an START nur im SAMPLE-Modus gebunden (bei SYNTH ist SG_START unbelegt und kann veraltet sein).
  kbCh ? ( sm[SG_LEN] = min(nv, max(1, 1000 - (md ? 0 : sm[SG_START]))); ) : 0;
  md ? (
    ms = floor(synthFramesG(s)*1000/srate + 0.5);
    sprintf(#kbTxt, "%dMS", ms);
  ) : sprintf(#kbTxt, "%.1f%%", sm[SG_LEN]*0.1);
  kbTxtDraw(cx, T, 1);
  kbTipCell(cx, T, "LEN: window length of this lane, 1-1000 permille|SYNTH: share of the type maximum - SAMPLE: of the slot|CTRL+click: reset");
  // ---- Slot 6: OFFSET (v1.1.0): Start der Lane auf der Zeitachse in ms, Raster 0,1 ms (der Regler rechnet in Zehntel-ms).
  // Lane 0 (Kettenkopf): 0..+100, sonst -100..+100.
  cx = kbCx(6);
  nv = kbKnob(cx, T, kk + 11, "OFFSET", floor(sm[SG_OFF]*10 + 0.5), s > 0 ? -1000 : 0, 1000, 0, 0, s > 0, 1);
  kbCh ? ( sm[SG_OFF] = nv*0.1; ) : 0;
  sm[SG_OFF] > 0.05 ? sprintf(#kbTxt, "+%.1f", sm[SG_OFF]) : sprintf(#kbTxt, "%.1f", sm[SG_OFF]);
  kbTxtDraw(cx, T, 1);
  s > 0 ? (
    kbTipCell(cx, T, "OFFSET: moves the start of this lane on the time axis, -100..+100 ms|Plus = later (a gap after the previous lane), minus = earlier (more overlap)|CTRL+click: reset");
  ) : (
    kbTipCell(cx, T, "OFFSET: delays the start of the whole kick, 0..+100 ms|The lanes after it move with it|CTRL+click: reset");
  );
  // ---- Slot 7: XF-IN (Lane 0 hat keinen Vorgaenger: gesperrt)
  cx = kbCx(7);
  nv = kbKnob(cx, T, kk + 6, "XF-IN", sm[SG_XFI], 0, 100, 0, ctlDef(117), 0, s > 0);
  kbCh ? ( sm[SG_XFI] = nv; ) : 0;
  sprintf(#kbTxt, "%dMS", floor(sm[SG_XFI] + 0.5));
  kbTxtDraw(cx, T, s > 0);
  s > 0 ? (
    kbTipCell(cx, T, "XF-IN: entry crossfade from the previous lane, 0-100 ms|The boundary fades over min(previous XF-OUT, this XF-IN)|CTRL+click: reset");
  ) : (
    kbTipCell(cx, T, "XF-IN: not used on S1, the first lane has no predecessor|The kick head always gets a short anti-click fade");
  );
  // ---- Slot 8: XF-OUT (= SG_XF)
  cx = kbCx(8);
  nv = kbKnob(cx, T, kk + 7, "XF-OUT", sm[SG_XF], 0, 100, 0, ctlDef(26 + s), 0, 1);
  kbCh ? ( sm[SG_XF] = nv; ) : 0;
  sprintf(#kbTxt, "%dMS", floor(sm[SG_XF] + 0.5));
  kbTxtDraw(cx, T, 1);
  kbTipCell(cx, T, "XF-OUT: exit crossfade into the next lane, 0-100 ms|On S3 it is the fade-out of the whole kick|CTRL+click: reset");
  // ---- Slot 9 / 10: Lane-Filter CUT / RES
  cx = kbCx(9);
  nv = kbKnob(cx, T, kk + 8, "CUT", sm[SG_FCUT], 0, 1000, 0, ctlDef(120), 0, 1);
  kbCh ? ( sm[SG_FCUT] = nv; ) : 0;
  kbHzTxt(40*exp(sm[SG_FCUT]*0.0059914645)); kbTxtDraw(cx, T, 1);
  kbTipCell(cx, T, "LANE CUT: low-pass on this lane only, 40 Hz - 16 kHz|Fully open with RES 0 = filter bypassed, bit-exact|CTRL+click: reset");
  cx = kbCx(10);
  nv = kbKnob(cx, T, kk + 9, "RES", sm[SG_FRES], 0, 1000, 0, ctlDef(121), 0, 1);
  kbCh ? ( sm[SG_FRES] = nv; ) : 0;
  sprintf(#kbTxt, "Q%.1f", 0.5*16^(sm[SG_FRES]*0.001));
  kbTxtDraw(cx, T, 1);
  kbTipCell(cx, T, "LANE RES: resonance of the lane filter, Q 0.5 - 8|Higher = a ringing peak at the cutoff|CTRL+click: reset");
);

// ----------------------------------------------------------------------
// RAND je Lane (v0.9.0)
// rnd() mischt den Frame-Zaehler (capBlink) und einen frischen rand()-
// Zug in einen eigenen Lehmer-Zustand - jede Klickfolge sieht anders aus,
// auch wenn rand() selbst reproduzierbar starten sollte.
// randLane(s): Werte innerhalb musikalischer Grenzen (kein Chaos).
//   Beide Modi:  LEN >= 150 Promille (soweit START es zulaesst), XF 2..40 ms,
//                GAIN 80..120 %, PITCH -12..+12 st; v0.9.1 zusaetzlich
//                XFI 2..40 ms, FCUT 600..1000, FRES 0..300 Promille
//   SAMPLE:      zusaetzlich START 0..600 Promille (LEN <= 1000 - START)
//   SYNTH:       F0/F1 in den Typ-Ranges (S1 800..4000 / 300..1200,
//                S2 90..350 / 35..120, S3 40..70 / 30..60; F1 <= 0,9 x F0),
//                CRVE 250..750, MIX (nur S1) und DRIFT/ROOM (nur S3)
//                0..700 - die Felder, die die Engine der jeweiligen Lane
//                wirklich liest (S2 hat keins davon).
// Kit-Pfade und der SYNTH|SAMPLE-Schalter bleiben unberuehrt; die
// Undo-Klammer liefert der globale Klick-Mark/Commit in @gfx.
// ----------------------------------------------------------------------
// Kein '%': EEL2 rechnet den Modulo auf 32-Bit-Integern (siehe strHash) -
// das Produkt (~3,6e13) wird deshalb ueber floor() reduziert.
function rnd() local(r) (
  rndS = rndS*16807 + capBlink*2531 + floor(rand(65536)) + 1;
  rndS -= floor(rndS/2147483647)*2147483647;
  r = rndS*(1/2147483647);
  r - floor(r);
);
function rndR(lo, hi) ( lo + rnd()*(hi - lo); );

function randLane(s) local(sm, st, f0, f1, f0lo, f0hi, f1lo, f1hi) (
  sm = M_SEG + s*64;
  st = 0;
  sm[SG_MODE] == 1 ? (
    st = floor(rndR(0, 601));
    sm[SG_START] = st;
  ) : 0;
  sm[SG_LEN]   = floor(rndR(150, 1001 - st));
  sm[SG_XF]    = floor(rndR(2, 41));
  // v0.9.1: Entry-Fade im selben Bereich wie der Austritt; Lane-Filter mit
  // Fokus auf den Transparenzbereich (FCUT 600..1000, FRES 0..300 Promille -
  // der Regler ist nur im EXPERT-Modus sichtbar, RAND wuerfelt ihn trotzdem)
  sm[SG_XFI]   = floor(rndR(2, 41));
  sm[SG_FCUT]  = floor(rndR(600, 1001));
  sm[SG_FRES]  = floor(rndR(0, 301));
  sm[SG_GAIN]  = floor(rndR(80, 121));
  sm[SG_PITCH] = floor(rndR(-12, 13));
  sm[SG_MODE] == 0 ? (
    f0lo = s == 0 ? 800  : s == 1 ? 90  : 40;
    f0hi = s == 0 ? 4000 : s == 1 ? 350 : 70;
    f1lo = s == 0 ? 300  : s == 1 ? 35  : 30;
    f1hi = s == 0 ? 1200 : s == 1 ? 120 : 60;
    f0 = floor(rndR(f0lo, f0hi + 1));
    f1 = floor(rndR(f1lo, f1hi + 1));
    sm[SG_F0] = f0;
    sm[SG_F1] = max(f1lo, min(f1, floor(f0*0.9)));
    sm[SG_CRVE] = floor(rndR(250, 751));
    s == 0 ? ( sm[SG_MIX] = floor(rndR(0, 701)); ) : 0;
    s == 2 ? (
      sm[SG_DRIFT] = floor(rndR(0, 701));
      sm[SG_ROOM]  = floor(rndR(0, 701));
    ) : 0;
  ) : 0;
  // v0.9.5: RAND loest die Lane-Preset-Assoziation (INIT-Stern zeigt Edit)
  sm[SG_LP]  = 0;
  sm[SG_LPS] = chkLane(s);
);

// RAND + CTRL: die Lane zurueck auf INIT (laneInit), die reine Ansicht
// (Zoom/Skew/Offset) bleibt stehen wie beim Undo.
function laneReset(s) local(sm, z0, z1, z2, z3) (
  sm = M_SEG + s*64;
  z0 = sm[SG_ZOOM]; z1 = sm[SG_SKEW]; z2 = sm[SG_VOFF]; z3 = sm[SG_ZFIT];
  laneInit(s);
  sm[SG_ZOOM] = z0; sm[SG_SKEW] = z1; sm[SG_VOFF] = z2; sm[SG_ZFIT] = z3;
);

// ----------------------------------------------------------------------
// FUSION-Zeile + DUR-Kennzeichnung (v0.8.0) - reine Anzeige.
//   fusBuild() SPIEGELT die Ketten-Mathematik aus trigKick (M/S-Gate
//   laneOnG, XF-Split SG_XF[prev]/SG_XFI[cur] seit v0.9.1, Dauern in
//   Output-Frames, geteilter Crossfade fb, Start des Nachfolgers =
//   Ende des Vorgaengers - fb, Kopf-Mikrofade 64, Endfade des letzten
//   Spans min(XF, Dauer)) fuer die Referenznote PG_ROOT. trigKick,
//   emitSpan und spanRead bleiben unangetastet; wer dort die Kette
//   aendert, muss diese Spiegelung nachziehen.
//   Nur @gfx-Namen (fu*, segWinG, synthFramesG): kein Global wird mit
//   dem Audio-Thread geteilt (Finding 4).
//   Je Span (0..2) als Skalare: fuOkN spielbar, fuStN Start / fuDuN
//   Dauer / fuFiN Einblend- / fuFoN Ausblendlaenge (Output-Frames),
//   fuAN/fuBN Fensteranteil im Slot (SAMPLE, fuer den Peak-Cache).
//   fuTot = Gesamtlaenge der Kette in Frames (Ende des letzten Spans).
// ----------------------------------------------------------------------
function fusSet(s, ok, st, du, fi, fo, fa, fbb) (
  s == 0 ? ( fuOk0 = ok; fuSt0 = st; fuDu0 = du; fuFi0 = fi; fuFo0 = fo; fuA0 = fa; fuB0 = fbb; )
  : s == 1 ? ( fuOk1 = ok; fuSt1 = st; fuDu1 = du; fuFi1 = fi; fuFo1 = fo; fuA1 = fa; fuB1 = fbb; )
  : ( fuOk2 = ok; fuSt2 = st; fuDu2 = du; fuFi2 = fi; fuFo2 = fo; fuA2 = fa; fuB2 = fbb; );
);

// M/S-Gate, gfx-Klon von laneOn (Finding 4: keine function-locals mit dem
// Audio-Thread teilen). Gleiche Logik, eigene Locals.
function laneOnG(s) local(sm, i, b, so) (
  so = 0; i = 0;
  loop(3, b = M_SEG + i*64; b[SG_SOLO] > 0.5 ? ( so = 1; ); i += 1; );
  sm = M_SEG + s*64;
  sm[SG_MUTE] < 0.5 && (so < 0.5 || sm[SG_SOLO] > 0.5);
);

// ----------------------------------------------------------------------
// FIT (length) (v0.14.1): die Kick wird EINMAL auf eine Notenlaenge beim aktuellen Tempo gebracht (wie FIT TO
// in a sibling product). Skaliert werden die Fensterlaengen (SG_LEN) aller Lanes, die in der Kette spielen (spielbar,
// nicht gemutet / von Solo ausgeschlossen), mit EINEM gemeinsamen Faktor - die Proportionen T : B : T bleiben.
// Ziel = Gesamtlaenge der Kette (Summe der Dauern minus Crossfade-Ueberlappungen, wie FUSION-Titel und trigKick),
// bei ROOT-Tonhoehe. Der Faktor wird per Bisektion gesucht, weil die Crossfades (ms) nicht mitskalieren.
// Danach bleiben die Laengen fest (Tempoaenderungen skalieren nichts nach, nur FIT NOW wendet es erneut an).
// Grenzen: je Lane 1..1000 Promille (Synth: Typ-Maximum 60 / 500 / 2000 ms; Sample: Rest des Slots), Mindestlaenge
// 10 Promille wie beim Ziehen der Endflagge. Nur @gfx (eigene Locals, keine Funktionen des Audio-Threads).
// ----------------------------------------------------------------------
// Dauer von Lane s in Output-Frames bei Fensterlaenge ln (Promille), Note == ROOT (nur der SG_PITCH-Detune).
function kkFitFrames(s, ln) local(sm, gm, L, lo, fr) (
  sm = M_SEG + s*64;
  sm[SG_MODE] == 0 ? (
    fr = max(64, floor(ln*0.001*(s == 0 ? 60 : s == 1 ? 500 : 2000)*0.001*srate + 0.5));
  ) : (
    gm = M_GEN + 32 + s*16;
    L = gm[SM_LEN];
    lo = min(max(0, floor(sm[SG_START]*0.001*max(0, L - 2) + 0.5)), max(0, L - 2));
    fr = min(floor(ln*0.001*L + 0.5), L - lo)/(2^(sm[SG_PITCH]*0.0833333333));
  );
  fr;
);

// Obergrenze der Fensterlaenge (Promille) von Lane s.
function kkFitCap(s) local(sm, gm, L, lo) (
  sm = M_SEG + s*64;
  sm[SG_MODE] == 0 ? 1000 : (
    gm = M_GEN + 32 + s*16;
    L = gm[SM_LEN];
    lo = min(max(0, floor(sm[SG_START]*0.001*max(0, L - 2) + 0.5)), max(0, L - 2));
    max(10, min(1000 - sm[SG_START], floor(1000*(L - lo)/max(1, L))));
  );
);

// 1 = Lane s spielt in der Kette (wie trigKick: spielbar UND M/S-Gate).
function kkFitOn(s) local(sm, gm) (
  sm = M_SEG + s*64;
  gm = M_GEN + 32 + s*16;
  (sm[SG_MODE] == 0 || gm[SM_LEN] > 0) && kkFitFrames(s, sm[SG_LEN]) > 2 && laneOnG(s);
);

// Neue Fensterlaenge (Promille) von Lane s beim Faktor k.
function kkFitLn(s, k) local(sm) (
  sm = M_SEG + s*64;
  min(kkFitCap(s), max(min(10, max(1, sm[SG_LEN])), floor(sm[SG_LEN]*k + 0.5)));
);

// Gesamtlaenge der Kette in Output-Frames beim Faktor k.
function kkFitTotal(k) local(s, sm, du, fb, pDu, pXF, tot, have, offF, pOst, mxE) (
  tot = 0; have = 0; pDu = 0; pXF = 0; pOst = 0; mxE = 0;
  s = 0;
  loop(3,
    kkFitOn(s) ? (
      sm = M_SEG + s*64;
      du = kkFitFrames(s, kkFitLn(s, k));
      // v1.1.0: OFFSET wie trigKick (Frames, 0,1-ms-Raster); tot = Ende der Kette, pOst = Start der Vorgaengerin
      offF = floor(sm[SG_OFF]*0.001*srate + 0.5);
      have ? (
        fb = min(min(pXF, sm[SG_XFI]*0.001*srate), min(pDu, du));
        offF < 0 && tot - fb + offF < pOst ? ( tot = pOst + du; )
                                           : ( pOst = tot - fb + offF; tot += du - fb + offF; );
      ) : ( pOst = max(0, offF); tot = pOst + du; );
      mxE = max(mxE, tot);
      pDu = du; pXF = sm[SG_XF]*0.001*srate; have = 1;
    ) : 0;
    s += 1;
  );
  mxE;
);

// Notenlaenge in ms: 0 1/1, 1 1/2, 2 1/4, 3 1/4T, 4 1/8, 5 1/8T, 6 1/16.
function kkFitNoteMs(nd, bpm) (
  60000/(bpm > 10 ? bpm : 120)*(nd < 0.5 ? 4 : nd < 1.5 ? 2 : nd < 2.5 ? 1 : nd < 3.5 ? 0.6666667
    : nd < 4.5 ? 0.5 : nd < 5.5 ? 0.3333333 : 0.25);
);

// Fit auf Notenwert nd. Rueckgabe: Anzahl der skalierten Lanes (0 = nichts spielt, nichts geaendert).
function kkFitLen(nd) local(tgt, lo, hi, k, s, n, sm) (
  tgt = kkFitNoteMs(nd, bpmNow)*0.001*srate;
  n = 0; s = 0;
  loop(3, kkFitOn(s) ? ( n += 1; ) : 0; s += 1; );
  n > 0 ? (
    lo = 0.001; hi = 1000;
    kkFitTotal(hi) <= tgt ? ( k = hi; )
    : kkFitTotal(lo) >= tgt ? ( k = lo; )
    : (
      loop(40,
        k = sqrt(lo*hi);
        kkFitTotal(k) < tgt ? ( lo = k; ) : ( hi = k; );
      );
      k = (tgt - kkFitTotal(lo) <= kkFitTotal(hi) - tgt) ? lo : hi;
    );
    // Idempotenz: liegt der Ist-Zustand (k = 1) bis auf 0,5 ms so nah am Ziel wie das Ergebnis, nichts aendern
    // (sonst driftet jeder weitere Klick um die Promille-Rundung der Fensterlaenge).
    abs(tgt - kkFitTotal(1)) <= abs(tgt - kkFitTotal(k)) + 0.0005*srate ? ( k = 1; );   // Toleranz 0,5 ms: Promille-Raster der Laengen
    s = 0;
    loop(3,
      kkFitOn(s) ? ( sm = M_SEG + s*64; sm[SG_LEN] = kkFitLn(s, k); ) : 0;
      s += 1;
    );
  );
  n;
);

// v1.0.0: nach jedem Preset-Laden (Leiste, Pfeile, Anwender-Slot, SYS-Seite) die Kick auf die gewaehlte Notenlaenge fitten,
// wenn FUSION > AUTO an ist. Laeuft innerhalb der Undo-Klammer des Ladens (ein Undo-Schritt).
function kkFitAfter() (
  kkFitReq = 0;
  M_GEN[PG_FAUT] > 0.5 ? (
    kkFitN1 < 1 ? ( kkFitN1 = 3; );
    kkFitLen(kkFitN1 - 1);
  );
);

// Eigenwerte je Lane (v0.9.1): spielbar / eigene Dauer / vom M/S-Gate
// ausgeschlossen. Die Kettenfelder (fuOk*/fuDu*/...) tragen nur Lanes, die
// WIRKLICH in der Kette sind; die DUR-Zeile zeigt aber auch gemutete Lanes
// (gedimmt) - dafuer diese separaten Skalare.
function fusOwn(s, ok, du, gt) (
  s == 0 ? ( fuOw0 = ok; fuOd0 = du; fuGt0 = gt; )
  : s == 1 ? ( fuOw1 = ok; fuOd1 = du; fuGt1 = gt; )
  : ( fuOw2 = ok; fuOd2 = du; fuGt2 = gt; );
);

// Kettenmitglied (nach M/S-Gate)
function fusOk(s) ( s == 0 ? fuOk0 : s == 1 ? fuOk1 : fuOk2; );
// Eigene Lane-Dauer in Output-Frames (unabhaengig vom Gate; fuer
// Lanes in der Kette identisch zur Kettendauer fuDu*).
function fusDur(s) ( s == 0 ? fuOd0 : s == 1 ? fuOd1 : fuOd2; );
function fusOwnOk(s) ( s == 0 ? fuOw0 : s == 1 ? fuOw1 : fuOw2; );
function fusGated(s) ( s == 0 ? fuGt0 : s == 1 ? fuGt1 : fuGt2; );

function fusBuild() local(s, sm, gm, ok, dur, fa, fbb, qm, fxe, fb, ost, nFi,
    prev, pSt, pDu, pFi, pXF, pA, pB, offF, mxE) (
  fusSet(0, 0, 0, 0, 0, 0, 0, 1);
  fusSet(1, 0, 0, 0, 0, 0, 0, 1);
  fusSet(2, 0, 0, 0, 0, 0, 0, 1);
  fusOwn(0, 0, 0, 0); fusOwn(1, 0, 0, 0); fusOwn(2, 0, 0, 0);
  fuTot = 0;
  prev = -1; pSt = 0; pDu = 0; pFi = 64; pXF = 0; pA = 0; pB = 1; mxE = 0;
  s = 0;
  loop(3,
    sm = M_SEG + s*64;
    gm = M_GEN + 32 + s*16;
    sm[SG_MODE] == 0 ? (
      dur = synthFramesG(s);                 // Synth: absolut, Rate 1
      ok = dur > 2;
      fa = 0; fbb = 1;
    ) : (
      segWinG(s);
      // segRateAbs(s, PG_ROOT): Note == ROOT -> nur der Pitch-Detune
      dur = gWG_LEN/(2^(sm[SG_PITCH]*0.0833333333));
      ok = gm[SM_LEN] > 0 && gWG_LEN > 2;
      fa = ok ? gWG_LO/gm[SM_LEN] : 0;
      fbb = ok ? (gWG_LO + gWG_LEN)/gm[SM_LEN] : 1;
    );
    // v0.9.1: M/S-Gate wie im trigKick-Vorlauf. Die Eigenwerte (DUR-Zeile)
    // werden VOR dem Gate festgehalten, die Kette sieht nur den Rest.
    fusOwn(s, ok, ok ? dur : 0, ok && !laneOnG(s));
    ok = ok && laneOnG(s);
    ok ? (
      // Eintrittsseite der Grenze prev -> s: SG_XFI[s] (wie trigKick)
      fxe = s > 0 ? sm[SG_XFI]*0.001*srate : 0;
      offF = floor(sm[SG_OFF]*0.001*srate + 0.5);   // v1.1.0 (wie trigKick)
      prev < 0 ? (
        ost = max(0, offF);
        nFi = 64;                            // Antiklick-Mikrofade am Kopf
      ) : (
        fb = min(min(pXF, fxe), min(pDu, dur));
        fusSet(prev, 1, pSt, pDu, pFi, fb, pA, pB);   // Vorgaenger fertig
        ost = pSt + pDu - fb + offF;         // Ueberlappung der Laenge fb, v1.1.0: + OFFSET
        offF < 0 && ost < pSt ? ost = pSt;
        nFi = fb;
      );
      pSt = ost; pDu = dur; pFi = nFi;
      mxE = max(mxE, ost + dur);             // v1.1.0: bei negativem OFFSET kann eine fruehere Lane laenger klingen
      pXF = sm[SG_XF]*0.001*srate;           // Austrittsseite
      pA = fa; pB = fbb;
      prev = s;
    ) : 0;
    s += 1;
  );
  prev >= 0 ? (
    // Letzter Span: SG_XF wirkt solo als Endfade (min mit der Dauer)
    fusSet(prev, 1, pSt, pDu, pFi, min(pXF, pDu), pA, pB);
    fuTot = mxE;
  ) : 0;
);

// Amplitudenbeitrag von Span s an Output-Frame t (Betrag, 0 ausserhalb):
// Synth = analytische (1-u)^k-Huelle wie spanRead (T 2 / B 0.6 / TAIL
// 0.45), Sample = Peak-Bucket aus M_PEAK am Fensteranteil; dazu
// Equal-Power-Fades (sin-Viertelwelle) und GAIN. REV spiegelt die
// Lesrichtung, die Fades bleiben in Spielrichtung.
function fusAmp(s, t) local(sm, st, du, fi, fo, p, e, u, pw, bi, pk, fa, fbb) (
  st = s == 0 ? fuSt0 : s == 1 ? fuSt1 : fuSt2;
  du = s == 0 ? fuDu0 : s == 1 ? fuDu1 : fuDu2;
  p = t - st;
  e = 0;
  fusOk(s) && p >= 0 && p < du ? (
    fi = s == 0 ? fuFi0 : s == 1 ? fuFi1 : fuFi2;
    fo = s == 0 ? fuFo0 : s == 1 ? fuFo1 : fuFo2;
    sm = M_SEG + s*64;
    u = p/du;                                // Fortschritt in Spielrichtung
    sm[SG_REV] > 0.5 ? u = 1 - u : 0;        // Position im Fenster
    sm[SG_MODE] == 0 ? (
      e = s == 0 ? (1 - u)*(1 - u) : s == 1 ? (1 - u)^0.6 : (1 - u)^0.45;
    ) : (
      fa = s == 0 ? fuA0 : s == 1 ? fuA1 : fuA2;
      fbb = s == 0 ? fuB0 : s == 1 ? fuB1 : fuB2;
      bi = min(127, max(0, floor((fa + u*(fbb - fa))*128)));
      pk = M_PEAK + s*128;
      e = pk[bi];
    );
    e *= sm[SG_GAIN]*0.01;
    p < fi ? e *= sin(p/fi*1.5707963) : 0;
    du - p < fo ? e *= sin((du - p)/fo*1.5707963) : 0;
  ) : 0;
  e;
);

// FUSION-Wellenform in die Box (x, y, w, h): pro Pixelspalte die
// Beitraege aller aktiven Spans summieren (zwei Abtastpunkte je Spalte,
// gemittelt - Glaettung vor Genauigkeit) und als Balken zeichnen.
// Die Crossfade-Zonen (Einblendbereich jedes Nachfolgers) liegen
// schattiert dahinter. Kein Segment spielbar -> leere Box mit "-".
function fusDraw(x, y, w, h) local(k, n, t, a, cy, hh, s, sx, sw, fi, st) (
  kTb(0.042, 0.048, 0.042, 1); xrect(x, y, w, h);
  gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
  xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
  cy = y + h*0.5; hh = h*0.42;
  tth_tn(0.10, 0.13, 0.08, 1); xline(x + 1, cy, x + w - 2, cy);
  fuTot > 0 ? (
    n = w - 2;
    // v0.9.3: Zeit-Ruler 0..Gesamtlaenge auf den Spalten x + 1 .. x + 1 + n
    // (dasselbe Mapping wie sx / die Wellenspalten unten), UNTER Zonen und Welle
    drawTimeGrid(x + 1, y + 1, n, h - 2, 0, fuTot*1000/srate);
    s = 1;
    loop(2,
      fusOk(s) ? (
        fi = s == 1 ? fuFi1 : fuFi2;
        st = s == 1 ? fuSt1 : fuSt2;
        sx = x + 1 + st/fuTot*n;
        sw = fi/fuTot*n;
        sw > 0.5 ? ( colAcid(0.09); xrect(sx, y + 2, sw, h - 4); ) : 0;
      ) : 0;
      s += 1;
    );
    colAcid(0.9);
    k = 0;
    loop(n,
      t = (k + 0.25)/n*fuTot;
      a = fusAmp(0, t) + fusAmp(1, t) + fusAmp(2, t);
      t = (k + 0.75)/n*fuTot;
      a = (a + fusAmp(0, t) + fusAmp(1, t) + fusAmp(2, t))*0.5;
      a = min(1, max(0.01, a));
      xline(x + 1 + k, cy - a*hh, x + 1 + k, cy + a*hh);
      k += 1;
    );
  ) : (
    gfx_setfont(2); colInk(0.6); xctr(x, y, w, h, "-");
  );
);

// ----------------------------------------------------------------------
// WELLENANSICHT - Front (v1.0.0, 18.10.2026). Drei Ansichten auf dieselben Vorschau-Daten (WV_*, siehe wvTick):
//   A  Lane-Box ENV / WAVE / BOTH (je Lane, Bits 0..5 von PG_WVUI)
//   B  Seite WAVE: die ganze Kick auf einer Zeitachse, Zoom, Lupe, Segmentleiste (PG_PAGE = 2, Bits 8/9)
//   C  FUSION SUM / STACK und EXPAND (Bits 6/7)
//   Nur @gfx: eigene Locals, gelesen wird ausschliesslich der vordere Puffer (wvFr, einmal je Frame festgehalten).
//   Griffe aendern dieselben Parameter wie die Flaggen/Rauten der Lane-Boxen (SG_LEN, SG_XF, SG_XFI); ihre Lage kommt
//   aus fusBuild (sofort), die Welle folgt nach dem naechsten Vorschau-Lauf.
// ----------------------------------------------------------------------
// Ansichtsschalter PG_WVUI: Feld ab Bit sh mit Maske mask lesen / setzen (reine Ansicht, kein Undo-Eintrag).
function wvUi(sh, mask) ( (floor(M_GEN[PG_WVUI] + 0.5) >> sh) & mask; );
function wvUiSet(sh, mask, v) local(u) (
  u = floor(M_GEN[PG_WVUI] + 0.5);
  u = u - (((u >> sh) & mask) << sh) + ((v & mask) << sh);
  M_GEN[PG_WVUI] = min(1023, max(0, u));
);

// Farbton einer RGB-Farbe um dh Grad drehen (HSV) -> wqR/wqG/wqB.
function wvRot(r, g, b, dh) local(mx, mn, d, h, s, v, hh, i, f, p, q, t) (
  mx = max(r, max(g, b)); mn = min(r, min(g, b)); d = mx - mn; v = mx;
  s = mx > 0 ? d/mx : 0;
  h = d <= 0 ? 0 : mx === r ? (g - b)/d : mx === g ? 2 + (b - r)/d : 4 + (r - g)/d;
  h = h*60 + dh;
  h -= 360*floor(h/360);
  hh = h/60; i = floor(hh); f = hh - i;
  p = v*(1 - s); q = v*(1 - s*f); t = v*(1 - s*(1 - f));
  i < 0.5 ? ( wqR = v; wqG = t; wqB = p; )
  : i < 1.5 ? ( wqR = q; wqG = v; wqB = p; )
  : i < 2.5 ? ( wqR = p; wqG = v; wqB = t; )
  : i < 3.5 ? ( wqR = p; wqG = q; wqB = v; )
  : i < 4.5 ? ( wqR = t; wqG = p; wqB = v; )
  : ( wqR = v; wqG = p; wqB = q; );
);

// Segmentfarben aus dem Akzent des Farbschemas (folgen OPTIONS > Farbe): S1 = Farbton -40 Grad, etwas aufgehellt;
// S2 = Akzent; S3 = Farbton +50 Grad. Bei ACID: Limette / Acid-Gruen / Mint. Neu gerechnet nur bei Akzentwechsel.
function wvColsUpd() (
  wvAcK != accR + accG*3 + accB*7 ? (
    wvAcK = accR + accG*3 + accB*7;
    wvC1R = accR; wvC1G = accG; wvC1B = accB;
    wvRot(accR, accG, accB, -40);
    wvC0R = wqR + (1 - wqR)*0.25; wvC0G = wqG + (1 - wqG)*0.25; wvC0B = wqB + (1 - wqB)*0.25;
    wvRot(accR, accG, accB, 50);
    wvC2R = wqR; wvC2G = wqG; wvC2B = wqB;
  ) : 0;
);
function wvCol(s, a) (
  s < 0.5 ? gfx_set(wvC0R, wvC0G, wvC0B, a)
  : s < 1.5 ? gfx_set(wvC1R, wvC1G, wvC1B, a)
  : gfx_set(wvC2R, wvC2G, wvC2B, a);
);

// Spur t des vorderen Puffers -> wt* (Start, Frames, K, Buckets, solo, Peak, Basis). 1 = Daten vorhanden.
function wvTrk(t) local(tm) (
  tm = WV_META + wvFr*64 + 8 + t*8;
  wtSt = tm[0]; wtNf = tm[1]; wtK = max(1, tm[2]); wtNb = tm[3]; wtSo = tm[4]; wtPk = tm[5];
  wtB = WV_DAT + wvFr*WV_BUF + t*WV_TRK;
  wvOk && wtNf > 0 && wtNb > 0;
);

// Min/Max der Frames [lo, hi) (relativ zum Spurbeginn) einer Spur mit Basis tb, K kk, nb Buckets -> wqMn/wqMx.
// 0 = der Bereich liegt ausserhalb der Spur.
function wvQB(tb, kk, nb, lo, hi) local(b0, b1, i, mn, mx) (
  b0 = floor(lo/kk);
  b1 = floor(max(lo, hi - 0.999)/kk);
  b1 < 0 || b0 > nb - 1 ? 0 : (
    b0 = max(0, b0); b1 = min(nb - 1, b1);
    i = b0;
    mn = tb[2*i]; mx = tb[2*i + 1];
    loop(b1 - b0, i += 1; mn = min(mn, tb[2*i]); mx = max(mx, tb[2*i + 1]); );
    wqMn = mn; wqMx = mx;
    1;
  );
);

// Lane mit dem groessten Spitze-Spitze-Wert an den Kettenframes [lo, hi) (nur Lanes in der Kette).
function wvDom(lo, hi) local(t, tm, best, bv) (
  best = 1; bv = -1;
  t = 0;
  loop(3,
    tm = WV_META + wvFr*64 + 8 + t*8;
    tm[1] > 0 && tm[4] < 0.5 ? (
      wvQB(WV_DAT + wvFr*WV_BUF + t*WV_TRK, max(1, tm[2]), tm[3], lo - tm[0], hi - tm[0]) ? (
        wqMx - wqMn > bv ? ( bv = wqMx - wqMn; best = t; ) : 0;
      ) : 0;
    ) : 0;
    t += 1;
  );
  best;
);

// Spur t in die Box (x, y, w, h): Spalte k zeigt die Frames f0 + k*(f1 - f0)/w relativ zum Spurbeginn (f1 < f0 =
// gespiegelt, REV in der Lane-Box). amp = Pixel je Vollausschlag. dom = 1: Farbe je Spalte nach der lautesten Lane
// (nur fuer die Summenspur 3, deren Frames Kettenframes sind), sonst bleibt die gesetzte Farbe.
// Jede Spalte reicht mindestens bis zur Mitte der Vorspalte (pm): bei starkem Zoom (weniger als ein Bucket je Spalte) wird
// daraus eine durchgehende Linie statt einzelner Punkte, bei dichter Welle aendert es nichts (18.10.2026, REAPER-Bild).
function wvDrawT(t, x, y, w, h, f0, f1, amp, dom) local(k, n, d, fa, lo, hi, cy, y0, y1, pm) (
  wvTrk(t) ? (
    cy = y + h*0.5;
    n = max(1, floor(w));
    d = (f1 - f0)/n;
    pm = -1;
    k = 0;
    loop(n,
      fa = f0 + k*d;
      lo = min(fa, fa + d); hi = max(fa, fa + d);
      hi < lo + 1 ? ( hi = lo + 1; ) : 0;
      dom > 0.5 ? wvCol(wvDom(lo + wtSt, hi + wtSt), 1) : 0;
      wvQB(wtB, wtK, wtNb, lo, hi) ? (
        y0 = min(y + h - 1, max(y, cy - wqMx*amp));
        y1 = min(y + h - 1, max(y, cy - wqMn*amp));
        pm >= 0 ? ( y0 = min(y0, pm); y1 = max(y1, pm); ) : 0;
        pm = min(y + h - 1, max(y, cy - (wqMx + wqMn)*0.5*amp));
        y1 < y0 + 1 ? ( y1 = y0 + 1; ) : 0;
        xline(x + k + 0.5, y0, x + k + 0.5, y1);
      ) : ( pm = -1; );
      k += 1;
    );
  ) : 0;
);

// Summen-Peak des vorderen Puffers (linear, vor dem Master)
function wvPeak() ( wvMb[2]; );

// Kettenabbildung Frame <-> Designraster-x (Box-Innenraum wmX..wmX+wmW zeigt [wmF0, wmF1))
function wvMap(x, w, f0, f1) ( wmX = x; wmW = w; wmF0 = f0; wmF1 = max(f0 + 1, f1); );
function wvFx(f) ( wmX + (f - wmF0)/(wmF1 - wmF0)*wmW; );
function wvXf(px) ( wmF0 + (px - wmX)/max(1, wmW)*(wmF1 - wmF0); );

// Kettenwerte je Lane aus fusBuild (gfx-Spiegel von trigKick): Start, Dauer, Einblend-, Ausblendlaenge in Frames
function fusSt(s) ( s == 0 ? fuSt0 : s == 1 ? fuSt1 : fuSt2; );
function fusDu(s) ( s == 0 ? fuDu0 : s == 1 ? fuDu1 : fuDu2; );
function fusFi(s) ( s == 0 ? fuFi0 : s == 1 ? fuFi1 : fuFi2; );
function fusFo(s) ( s == 0 ? fuFo0 : s == 1 ? fuFo1 : fuFo2; );
// Vorgaenger von s in der Kette (-1 = s ist der Kettenkopf) und letzte Lane der Kette
function fusPrev(s) local(p, i) ( p = -1; i = 0; loop(s, fusOk(i) ? ( p = i; ) : 0; i += 1; ); p; );
function fusLast() local(p, i) ( p = -1; i = 0; loop(3, fusOk(i) ? ( p = i; ) : 0; i += 1; ); p; );

// Naechster Kick des Players in Frames (RATE 1/1..1/8 beim Host-Tempo, 120 BPM ohne Tempo)
function wvBeatF() ( 4/2^floor(M_GEN[PG_RATE] + 0.5)*60/(bpmNow > 10 ? bpmNow : 120)*srate; );

// Kettenhintergrund der Box mit der aktuellen Abbildung: Zeitraster, Lane-Baender (gewaehlte heller, Strich oben),
// Crossfade-Zonen (Ueberlappung), lab = 1: Lane-Namen oben in die Baender, sofern sie hineinpassen.
function wvBands(x, y, w, h, lab) local(s, a, b, sx, ex, tw, th) (
  drawTimeGrid(x + 1, y + 1, w - 2, h - 2, wmF0*1000/srate, wmF1*1000/srate);
  s = 0;
  loop(3,
    fusOk(s) ? (
      sx = max(x + 1, wvFx(fusSt(s))); ex = min(x + w - 1, wvFx(fusSt(s) + fusDu(s)));
      ex > sx ? (
        wvCol(s, M_GEN[PG_SEGSEL] == s ? 0.10 : 0.045); xrect(sx, y + 1, ex - sx, h - 2);
        M_GEN[PG_SEGSEL] == s ? ( wvCol(s, 0.9); xrect(sx, y + 1, ex - sx, 2); ) : 0;
        lab ? (
          gfx_setfont(5);
          s == 0 ? strcpy(#wvLb, "S1") : s == 1 ? strcpy(#wvLb, "S2 BODY") : strcpy(#wvLb, "S3 TAIL");
          gfx_measurestr(#wvLb, tw, th);
          // gestaffelt (eine Zeile je Lane): bei XF 100 ms beginnen S2 und S3 oft am selben Punkt (REAPER-Bild 18.10.2026)
          ex - sx > tw/SC + 8 && h > 60 ? ( wvCol(s, 1); xstr(sx + 4, y + 5 + s*12, #wvLb); ) : 0;
        ) : 0;
      ) : 0;
      fusPrev(s) >= 0 ? (
        a = max(x + 1, wvFx(fusSt(s))); b = min(x + w - 1, wvFx(fusSt(s) + fusFi(s)));
        b > a ? ( colAcid(0.09); xrect(a, y + 2, b - a, h - 4); ) : 0;
      ) : 0;
    ) : 0;
    s += 1;
  );
);

// Linie des naechsten Kicks (RATE des Players) mit Beschriftung; ausserhalb rechts ein Hinweis am Rand.
function wvBeat(x, y, w, h) local(bx, ri, tw, th) (
  bx = wvFx(wvBeatF());
  ri = floor(M_GEN[PG_RATE] + 0.5);
  strcpy(#wvBt, ri == 0 ? "NEXT 1/1" : ri == 1 ? "NEXT 1/2" : ri == 2 ? "NEXT 1/4" : "NEXT 1/8");
  gfx_setfont(5);
  bx >= x + 1 && bx <= x + w - 2 ? (
    gfx_set(1, 0.24, 0.22, 0.9); xrect(bx, y + 1, 2, h - 2);
    gfx_measurestr(#wvBt, tw, th);
    xstr(max(x + 3, bx - 4 - tw/SC), y + 17, #wvBt);
  ) : bx > x + w - 2 ? (
    strcat(#wvBt, " >");
    gfx_measurestr(#wvBt, tw, th);
    gfx_set(1, 0.24, 0.22, 0.75); xstr(x + w - 4 - tw/SC, y + 17, #wvBt);
  ) : 0;
);

// 1 = ein Griff der Kette wird gezogen (70..75 Flagge/Rauten, 78 OFFSET-Griff, v1.1.0): die Abbildung bleibt dann eingefroren.
function wvFz() ( (dragId >= 70 && dragId <= 75) || dragId == 78; );

// Griffe der Kette: END-Flagge je Lane (Laenge), Raute an jeder Grenze (Crossfade: setzt XF-OUT des Vorgaengers und XF-IN
// der Lane gleich, 0..100 ms), Raute am Ende (Endfade der letzten Lane). Zeile y/h; only >= 0: nur diese Lane (STACK).
// Drag-IDs 70..72 Flagge, 73/74 Grenzraute Lane 1/2, 75 Endraute, 78 OFFSET-Griff am Fuss des Lane-Starts (v1.1.0; die Lane steht in
// wvDgS; System-Reserve 70..79, PLAN.md § 4.2). Beim Greifen
// friert die Abbildung ein (wvFz*), damit die Achse nicht unter der Maus wegwandert. STRG+Klick = Vorgabe.
// Rueckgabe 1 = ein Klick wurde von einem Griff verbraucht.
function wvHandles(x, w, y, h, only, vid) local(s, p, l, xe, xd, xo, ht, hit, hs, sm, fm, nv, stS, xs, hb, gb) (
  l = fusLast();
  ht = mY >= y - 2 && mY < y + 17 && mX >= x - 6 && mX < x + w + 6;
  hit = 0; hs = -1;
  s = 0;
  loop(3,
    fusOk(s) && (only < 0 || only == s) ? (
      p = fusPrev(s);
      xe = wvFx(fusSt(s) + fusDu(s));
      xe >= x - 4 && xe <= x + w + 4 ? (
        dragId == 70 + s || (dragId < 0 && abs(mX - xe) < 4 && inBox(x, y, w, h)) ? wvCol(s, 1) : wvCol(s, 0.5);
        xline(xe, y, xe, y + h - 1); xrect(xe - 3, y, 7, 4);
        !hit && dragId < 0 && abs(mX - xe) < 4 && inBox(x, y, w, h) ? ( hit = 70 + s; hs = s; ) : 0;
      ) : 0;
      p >= 0 ? (
        xd = wvFx(fusSt(s) + fusFi(s));
        xd >= x - 6 && xd <= x + w + 6 ? (
          xfMark(xd, y + 9, dragId == 72 + s || (dragId < 0 && ht && abs(mX - xd) < 6));
          dragId < 0 && ht && abs(mX - xd) < 6 ? ( hit = 72 + s; hs = s; ) : 0;
        ) : 0;
      ) : 0;
      // v1.1.0: OFFSET-Griff, ein kleines Dreieck am Fuss des Lane-Starts (die Lanes danach rutschen mit)
      xs = wvFx(fusSt(s));
      xs >= x - 4 && xs <= x + w + 4 ? (
        // Die Griffe der drei Lanes sitzen in drei Stufen uebereinander (S1 unten): bei den Vorgaben beginnt S2 am selben
        // Punkt wie S1 (S1 ist kuerzer als der Crossfade), die Stufen halten sie getrennt greifbar. In einer STACK-Zeile
        // (only >= 0) steht der Griff immer unten.
        gb = y + h - 2 - (only >= 0 ? 0 : 6*s);
        hb = mY >= gb - 7 && mY < gb + 1 && abs(mX - xs) < 5 && inBox(x, y, w, h);
        dragId == 78 && wvDgS == s || (dragId < 0 && hb) ? wvCol(s, 1) : wvCol(s, 0.6);
        xline(xs - 4, gb, xs, gb - 6); xline(xs, gb - 6, xs + 4, gb); xline(xs - 4, gb, xs + 4, gb);
        !hit && dragId < 0 && hb ? ( hit = 78; hs = s; ) : 0;
      ) : 0;
      s == l ? (
        xo = wvFx(fusSt(s) + fusDu(s) - fusFo(s));
        xo >= x - 6 && xo <= x + w + 6 ? (
          xfMark(xo, y + 9, dragId == 75 || (dragId < 0 && ht && abs(mX - xo) < 6));
          dragId < 0 && ht && abs(mX - xo) < 6 ? ( hit = 75; hs = s; ) : 0;
        ) : 0;
      ) : 0;
    ) : 0;
    s += 1;
  );
  // Tooltip des Griffs unter der Maus
  hit >= 70 && hit <= 72 ? tip("END flag: length of this lane - drag sideways|The lanes after it move with it|CTRL+click: reset")
  : hit >= 73 && hit <= 74 ? tip("XF diamond: crossfade between this lane and the one before, 0-100 ms|Sets the XF-OUT of the previous lane and the XF-IN of this one|CTRL+click: reset")
  : hit == 75 ? tip("END diamond: fade-out at the end of the kick, 0-100 ms|Same as XF-OUT of the last lane|CTRL+click: reset")
  : hit == 78 ? tip(hs == 0 ? "OFFSET grip: drag sideways to delay the whole kick, 0..+100 ms|The lanes after it move with it|Double-click or CTRL+click: reset"
                           : "OFFSET grip: drag sideways to move the start of this lane, -100..+100 ms|Right = a gap, left = more overlap; the lanes after it move with it|Double-click or CTRL+click: reset") : 0;
  // Greifen
  uiClick && hit ? (
    M_GEN[PG_SEGSEL] = hs;
    hit == 78 && (mouse_cap & 4) == 0 && clickId == 78 && clickWait > 0 && wvOfL == hs ? (
      sm = M_SEG + hs*64; sm[SG_OFF] = 0; clickWait = 0;      // Doppelklick auf den Griff: OFFSET 0
    ) : (mouse_cap & 4) ? (
      hit == 78 ? ( sm = M_SEG + hs*64; sm[SG_OFF] = 0; )
      : hit <= 72 ? ( sm = M_SEG + hs*64; sm[SG_LEN] = min(lenDef(hs, sm[SG_MODE]), max(1, 1000 - (sm[SG_MODE] == 1 ? sm[SG_START] : 0))); )
      : hit <= 74 ? ( p = fusPrev(hs); sm = M_SEG + p*64; sm[SG_XF] = ctlDef(26 + p); sm = M_SEG + hs*64; sm[SG_XFI] = ctlDef(28 + hs); )
      : ( sm = M_SEG + hs*64; sm[SG_XF] = ctlDef(26 + hs); );
    ) : (
      dragId = hit; wvDgV = vid; wvDgS = hs; wvDgX0 = mX;
      wvFzX = wmX; wvFzW = wmW; wvFzF0 = wmF0; wvFzF1 = wmF1;
      sm = M_SEG + hs*64;
      wvDgSt = fusSt(hs); wvDgDu = fusDu(hs); wvDgLn = sm[SG_LEN];
      wvDgP = fusPrev(hs);
      wvDgEp = wvDgP >= 0 ? fusSt(wvDgP) + fusDu(wvDgP) : 0;
      wvDgEn = fusSt(hs) + fusDu(hs);
      wvDgO0 = sm[SG_OFF];
      // Review 30.10.2026 (4): XF-Eintrittswert beim Greifen sichern, wie den OFFSET-Wert.
      wvDgXf = sm[SG_XFI];
      hit == 78 ? ( clickId = 78; clickWait = 12; wvOfL = hs; ) : 0;
    );
  ) : 0;
  // Ziehen (Abbildung ist eingefroren, siehe wvBig/wvStack). Erst ab der ersten Mausbewegung: ein Klick ohne Zug laesst den
  // Wert bitgleich stehen (sonst koennte die Rueckrechnung ueber die Promille-Rundung einen Schritt verschieben).
  wvFz() && wvDgV == vid && uiLmb && abs(mX - wvDgX0) > 0.25 ? (
    fm = wvXf(mX);
    dragId == 78 ? (
      // v1.1.0: OFFSET = Wert beim Greifen + Verschiebung der Maus auf der (eingefrorenen) Zeitachse, Raster 0,1 ms
      sm = M_SEG + wvDgS*64;
      nv = wvDgO0 + (fm - wvXf(wvDgX0))*1000/srate;
      sm[SG_OFF] = floor(min(100, max(wvDgS == 0 ? 0 : -100, nv))*10 + 0.5)*0.1;
    ) : dragId <= 72 ? (
      sm = M_SEG + wvDgS*64;
      stS = sm[SG_MODE] == 1 ? sm[SG_START] : 0;
      nv = floor(wvDgLn*(fm - wvDgSt)/max(1, wvDgDu) + 0.5);
      sm[SG_LEN] = min(max(10, nv), 1000 - stS);
    ) : dragId <= 74 ? (
      wvDgP >= 0 ? (
        // Review 30.10.2026 (4): nur Mausdelta anwenden; links vergroessert den Fade.
        // Historie: nv = floor(min(100, max(0, (wvDgEp - fm)*1000/srate)) + 0.5);
        nv = floor(min(100, max(0, wvDgXf + (wvXf(wvDgX0) - fm)*1000/srate)) + 0.5);
        sm = M_SEG + wvDgP*64; sm[SG_XF] = nv;
        sm = M_SEG + wvDgS*64; sm[SG_XFI] = nv;
      ) : 0;
    ) : (
      sm = M_SEG + wvDgS*64;
      sm[SG_XF] = floor(min(100, max(0, (wvDgEn - fm)*1000/srate)) + 0.5);
    );
  ) : 0;
  uiClick && hit;
);

// Grosse Kettenansicht in der Box (x, y, w, h), Kettenframes [f0, f1). lay = 1: die drei Lane-Wellen uebereinander
// (LAYERS), sonst die Summe in der Farbe der lautesten Lane. fl: Bit 0 Griffe + Klick (Lane waehlen, Kick spielen per
// Drag-ID 77, ausgeloest beim Loslassen ohne Bewegung), Bit 1 Linie des naechsten Kicks, Bit 2 Lane-Namen.
// vid = Ansicht (eingefrorene Abbildung beim Ziehen). Lupe-Rechteck wvLpX/Y/W/H (W = 0: keine) faengt keine Klicks.
function wvBig(x, y, w, h, f0, f1, lay, fl, vid) local(amp, pk, t, used, fm, sel, s) (
  kTb(0.042, 0.048, 0.042, 1); xrect(x, y, w, h);
  gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1); xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
  wvFz() && wvDgV == vid ? wvMap(wvFzX, wvFzW, wvFzF0, wvFzF1) : wvMap(x + 1, w - 2, f0, f1);
  wvBands(x, y, w, h, fl & 4);
  tth_tn(0.10, 0.13, 0.08, 1); xline(x + 1, y + h*0.5, x + w - 2, y + h*0.5);
  pk = max(1, wvPeak());
  lay ? ( t = 0; loop(3, wvTrk(t) && wtSo < 0.5 ? ( pk = max(pk, wtPk); ) : 0; t += 1; ); ) : 0;
  amp = (h - 4)*0.46/pk;
  lay ? (
    t = 0;
    loop(3,
      wvTrk(t) && wtSo < 0.5 ? ( wvCol(t, 0.8); wvDrawT(t, wmX, y + 2, wmW, h - 4, wmF0 - wtSt, wmF1 - wtSt, amp, 0); ) : 0;
      t += 1;
    );
  ) : wvDrawT(3, wmX, y + 2, wmW, h - 4, wmF0, wmF1, amp, 1);
  !wvOk ? ( gfx_setfont(3); colInk(0.6); xctr(x, y, w, h, "PREVIEW IS BEING RENDERED ..."); )
  : wvMb[1] < 1 ? ( gfx_setfont(3); colInk(0.6); xctr(x, y, w, h, "NO LANE PLAYS - CHECK MUTE / SOLO / SLOTS"); ) : 0;
  fl & 2 ? wvBeat(x, y, w, h) : 0;
  used = 0;
  fl & 1 ? (
    used = wvHandles(x, w, y, h, -1, vid);
    !used && uiClick && inBox(x, y, w, h) && !(wvLpW > 0 && inBox(wvLpX, wvLpY, wvLpW, wvLpH)) ? (
      fm = wvXf(mX);
      sel = -1; s = 0;
      loop(3, fusOk(s) && fm >= fusSt(s) && fm < fusSt(s) + fusDu(s) ? ( sel = s; ) : 0; s += 1; );
      sel >= 0 ? ( M_GEN[PG_SEGSEL] = sel; ) : 0;
      dragId = 77; wvDgV = vid; dragX = mX; dragMv = 0;
    ) : 0;
  ) : 0;
);

// Lupe: die ersten 20 ms der Summe in einer eigenen Box (der Transient ist auf der ganzen Kette nur wenige Pixel breit).
// Die Abbildung wm* wird gesichert und danach zurueckgesetzt.
function wvLupe(x, y, w, h) local(s0, s1, s2, s3, f1, s, a, b) (
  s0 = wmX; s1 = wmW; s2 = wmF0; s3 = wmF1;
  f1 = 0.02*srate;
  kTb(0.030, 0.034, 0.030, 1); xrect(x, y, w, h);
  wvCol(0, 0.85); xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1); xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
  wvMap(x + 1, w - 2, 0, f1);
  drawTimeGrid(x + 1, y + 1, w - 2, h - 2, 0, 20);
  s = 0;
  loop(3,
    fusOk(s) && fusPrev(s) >= 0 ? (
      a = max(x + 1, wvFx(fusSt(s))); b = min(x + w - 1, wvFx(fusSt(s) + fusFi(s)));
      b > a ? ( colAcid(0.12); xrect(a, y + 2, b - a, h - 4); ) : 0;
    ) : 0;
    s += 1;
  );
  tth_tn(0.10, 0.13, 0.08, 1); xline(x + 1, y + h*0.5, x + w - 2, y + h*0.5);
  wvDrawT(3, x + 1, y + 2, w - 2, h - 4, 0, f1, (h - 4)*0.46/max(1, wvPeak()), 1);
  gfx_setfont(5); wvCol(0, 1); xstr(x + 5, y + 4, "LUPE 0-20 MS");
  wvMap(s0, s1, s2, s3);
);

// STACK: Zeilen S1/S2/S3 (jede Lane an ihrer echten Stelle der Kette) und die Summe, gemeinsame Zeitachse [0, Kette].
// big = 1 (EXPAND): hohe Zeilen mit Griffen, Klick auf eine Zeile = Lane waehlen + anhoeren (50 + s wie die Lane-Box),
// Klick auf die Summe = Kick spielen (77). big = 0: schmale Zeilen, reine Anzeige. Zeilengeometrie in wsY0..2/wsH/wsSY/wsSH.
function wvStack(x, y, w, h, big, vid) local(gp, lh, sh, s, ry, pk, amp, t, ok, used, a, b) (
  gp = big ? 8 : 1;
  sh = big ? 170 : max(24, h - 3*16 - 3);
  lh = floor((h - sh - 3*gp)/3);
  wvFz() && wvDgV == vid ? wvMap(wvFzX, wvFzW, wvFzF0, wvFzF1)
  : wvMap(x + 1, w - 2, 0, max(64, fuTot)*1.02);
  pk = max(1, wvPeak());
  t = 0; loop(3, wvTrk(t) && wtSo < 0.5 ? ( pk = max(pk, wtPk); ) : 0; t += 1; );
  used = 0;
  s = 0;
  loop(3,
    ry = y + s*(lh + gp);
    s == 0 ? ( wsY0 = ry; ) : s == 1 ? ( wsY1 = ry; ) : ( wsY2 = ry; );
    kTb(0.042, 0.048, 0.042, 1); xrect(x, ry, w, lh);
    M_GEN[PG_SEGSEL] == s ? wvCol(s, 0.7) : gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
    xrect(x, ry, w, 1); xrect(x, ry + lh - 1, w, 1); xrect(x, ry, 1, lh); xrect(x + w - 1, ry, 1, lh);
    big ? drawTimeGrid(x + 1, ry + 1, w - 2, lh - 2, wmF0*1000/srate, wmF1*1000/srate) : 0;
    ok = wvTrk(s) && wtSo < 0.5;
    fusOk(s) ? (
      a = max(x + 1, wvFx(fusSt(s))); b = min(x + w - 1, wvFx(fusSt(s) + fusDu(s)));
      b > a ? ( wvCol(s, 0.07); xrect(a, ry + 1, b - a, lh - 2); ) : 0;
    ) : 0;
    tth_tn(0.10, 0.13, 0.08, 1); xline(x + 1, ry + lh*0.5, x + w - 2, ry + lh*0.5);
    ok ? (
      wvCol(s, 0.95);
      wvDrawT(s, wmX, ry + 1, wmW, lh - 2, wmF0 - wtSt, wmF1 - wtSt, (lh - 2)*0.46/pk, 0);
    ) : big ? (
      gfx_setfont(5); colInk(0.5);
      xctr(x, ry, w, lh, fusGated(s) ? "MUTED - NOT IN THE CHAIN" : "LANE DOES NOT PLAY (EMPTY SLOT OR TOO SHORT)");
    ) : 0;
    big ? ( used = wvHandles(x, w, ry, lh, s, vid) || used; ) : 0;
    big && !used && uiClick && inBox(x, ry, w, lh) ? (
      M_GEN[PG_SEGSEL] = s; dragId = 50 + s; dragX = mX; dragMv = 0; used = 1;
    ) : 0;
    s += 1;
  );
  // Summe
  ry = y + 3*(lh + gp);
  wsH = lh; wsSY = ry; wsSH = h - (ry - y);
  kTb(0.042, 0.048, 0.042, 1); xrect(x, ry, w, wsSH);
  gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  xrect(x, ry, w, 1); xrect(x, ry + wsSH - 1, w, 1); xrect(x, ry, 1, wsSH); xrect(x + w - 1, ry, 1, wsSH);
  drawTimeGrid(x + 1, ry + 1, w - 2, wsSH - 2, wmF0*1000/srate, wmF1*1000/srate);
  tth_tn(0.10, 0.13, 0.08, 1); xline(x + 1, ry + wsSH*0.5, x + w - 2, ry + wsSH*0.5);
  wvDrawT(3, wmX, ry + 1, wmW, wsSH - 2, wmF0, wmF1, (wsSH - 2)*0.46/pk, 1);
  // Crossfade-Zonen durch alle Zeilen
  s = 1;
  loop(2,
    fusOk(s) && fusPrev(s) >= 0 ? (
      a = max(x + 1, wvFx(fusSt(s))); b = min(x + w - 1, wvFx(fusSt(s) + fusFi(s)));
      b > a ? ( colAcid(0.08); xrect(a, y, b - a, h); ) : 0;
    ) : 0;
    s += 1;
  );
  big && !used && uiClick && inBox(x, ry, w, wsSH) ? ( dragId = 77; wvDgV = vid; dragX = mX; dragMv = 0; ) : 0;
  !wvOk ? ( gfx_setfont(3); colInk(0.6); xctr(x, y, w, h, "PREVIEW IS BEING RENDERED ..."); ) : 0;
);

// Lane-Box (Ansicht A): die gerechnete Welle der Lane s im Fenster [x0, x1] der Box (bx, by, bw, bh). Spalte c zeigt den
// Fensteranteil u = (c - x0)/(x1 - x0) -> Output-Frame u*Frames (REV: (1 - u)*Frames, die Lane spielt das Fenster
// rueckwaerts). Hoehe wie die Sample-Welle mit SKEW (Vertikalzoom). Von M/S ausgeschlossen (einzeln gerechnet): gedimmt.
function wvLaneWave(s, bx, by, bw, bh, x0, x1, a) local(sm, amp, c0, c1, f0, f1, nf) (
  wvTrk(s) && x1 > x0 + 1 ? (
    sm = M_SEG + s*64;
    amp = (bh - 4)*0.46*2^(sm[SG_SKEW]*0.004);
    nf = wtNf;
    c0 = max(bx + 2, x0); c1 = min(bx + bw - 2, x1);
    c1 > c0 + 1 ? (
      f0 = (c0 - x0)/(x1 - x0)*nf; f1 = (c1 - x0)/(x1 - x0)*nf;
      sm[SG_REV] > 0.5 ? ( f0 = nf - f0; f1 = nf - f1; ) : 0;
      wtSo > 0.5 ? colInk(0.5*a) : wvCol(s, a);
      wvDrawT(s, c0, by + 2, c1 - c0, bh - 4, f0, f1, amp, 0);
    ) : 0;
  ) : 0;
);


// DUR-Kennzeichnung einer Lane: "DUR 60 MS (REC 0-30)". DUR in Acid
// (innerhalb des empfohlenen Bereichs) bzw. Warn-Orange (ausserhalb),
// REC dim. Bereiche aus PLAN § 3: TRANSIENT 0-30, BODY 5-150,
// TAIL 10-1500 ms - Synth und Sample gleichermassen gegen die
// effektive Output-Dauer (Sample: Fenster / Rate). Verglichen wird der
// angezeigte, gerundete Wert - Anzeige und Farbe widersprechen sich nie.
// v0.9.0: die Ausgabe sitzt in der Engine-Stats-Zeile (ly + 92) rechts
// neben dem XF-Wert: "... XF 26 MS | DUR 60 MS (REC 0-30)". Rechtsbuendig
// an xr, links begrenzt durch xmin (Ende des Stats-Textes + Luft). Reicht
// der Platz nicht, schrumpft der REC-Zusatz erst auf " (0-30)", dann
// entfaellt er (gemessen mit gfx_measurestr, Font 5 muss gesetzt sein).
function durLabel(xr, xmin, y, s) local(lo, hi, ms, ok, tw0, tw1, tw2, th, x) (
  lo = s == 0 ? 0 : s == 1 ? 5 : 10;
  hi = s == 0 ? 30 : s == 1 ? 150 : 1500;
  ok = fusOwnOk(s);      // v0.9.1: Eigenwerte - auch gemutete Lanes zeigen DUR
  ms = ok ? floor(fusDur(s)*1000/srate + 0.5) : 0;
  ok ? sprintf(#durstr, "DUR %d MS", ms) : sprintf(#durstr, "DUR -");
  sprintf(#recstr, " (REC %d-%d)", lo, hi);
  gfx_measurestr("| ", tw0, th);
  gfx_measurestr(#durstr, tw1, th);
  gfx_measurestr(#recstr, tw2, th);
  x = xr - (tw0 + tw1 + tw2)/SC;
  x < xmin ? (
    sprintf(#recstr, " (%d-%d)", lo, hi);
    gfx_measurestr(#recstr, tw2, th);
    x = xr - (tw0 + tw1 + tw2)/SC;
  ) : 0;
  x < xmin ? (
    strcpy(#recstr, "");
    x = xr - (tw0 + tw1)/SC;
  ) : 0;
  // P26 (Schriftstufen, p26_fontcheck.py): vierte Stufe ohne Trenner "| " (grosse Schrift, schmale Lane).
  x < xmin ? (
    x = xr - tw1/SC;
    xat(x, y);
  ) : (
    colInk(0.6); xat(x, y); gfx_drawstr("| ");
  );
  // v0.9.1: von M/S ausgeschlossene Lane (zaehlt nicht zur Kette) gedimmt
  ok ? ( fusGated(s) ? colInk(0.35) : ms >= lo && ms <= hi ? colAcid(1) : colWarn(1); ) : colInk(0.6);
  gfx_drawstr(#durstr);
  colInk(0.6);
  gfx_drawstr(#recstr);
);

// ----------------------------------------------------------------------
// Grundzustand
// ----------------------------------------------------------------------
// v0.9.2: Designraster 900 x 700. Lane-Geometrie:
// Lane 149 hoch, Abstand 8, Raster 157; drei Lanes
// belegen 76..539, FUSION darunter. Maximiert: die gewaehlte Lane fuellt den
// ganzen Lane-Bereich (395 px), die beiden anderen werden 26-px-Streifen.
UI_W = 900; UI_H = 700;
LN_Y0 = 76; LN_H = 149; LN_GAP = 8; LN_STR = 26;
LN_MAXH = 3*LN_H + 2*LN_GAP - 2*LN_STR - 2*LN_GAP;      // = 395
FU_Y = LN_Y0 + 3*LN_H + 2*LN_GAP + 8;                    // = 547
                                                         // FUSION und OUT SCOPE schliessen bei y 668 buendig ab
gfx_ext_retina = 1;

kickVer  = 9;                       // v8 (v0.9.1): SG 17..21 + PG_EXP (+10). v9 (v1.1.0): SG_OFF (25).
KK_MAGIC = 1263424331;              // 'KICK'

// Werkszustand nur bei erster Inbetriebnahme - @init laeuft bei jedem
// Transportstart erneut und @serialize stellt die Regionen wieder her.
// psetMod nur bei echter Erstinitialisierung loeschen (v0.7.1, Finding
// 11): ein spaeterer @init-Durchlauf (Transportstart) wuerde das
// Dirty-Sternchen sonst flackernd zuruecksetzen; der Lesemodus-Reset
// steht in @serialize.
kickInit != 1 ? ( writeDefaults(); kickInit = 1; psetMod = 0; );

// needDefaults bewusst NICHT hier zuruecksetzen: @serialize kann vor
// @init laufen (frische Instanz) und das Flag fuer @block vorbereitet
// haben (PHALYX-Muster).

// Capture (v0.8.2): Runtime-Zustand NUR beim allerersten Init nullen -
// @init laeuft auch bei Transportstart, und genau dann spielt der Nutzer
// seine Quelle ein: eine scharfe/laufende Aufnahme muss ihn ueberleben.
// Nur der Samplerate-Zweig unten (capReset) verwirft sie.
capInit != 1 ? (
  capInit = 1;
  capSt = 0; capLane = 0; capReq = 0; capIdx = 0; capLim = 0;
  capHi = 0; capSil = 0; capX1 = 0; capX2 = 0; capBlink = 0;
  capIn0 = 0; capIn1 = 0;
);
// Erreichbarkeit der CAP-Region pruefen: schreibt/liest das letzte Wort
// des 16-M-Speichers (ausserhalb der Banks). Greift maxmem nicht, bleibt
// der Button gesperrt statt still ins Leere aufzunehmen.
capPr = CAP_END - 1;
capPr[0] = 0.25;
capOk = capPr[0] == 0.25 ? 1 : 0;
capPr[0] = 0;

// P25 (Harmonisierung Punkt 9, Review A12/A16, _shared A2): @init laeuft bei JEDEM Transportstart erneut. Was
// laufender Bedien- oder Signalzustand ist, wird nur beim ersten Lauf (kkFirst) bzw. bei echtem Samplerate-
// Wechsel (kkSrCh) vorbelegt. kkIni1 wird nie zurueckgesetzt; kkSrCh wird VOR der lastSrate-Zuweisung unten
// ausgewertet (erster Lauf: lastSrate = 0 -> 1).
kkFirst = kkIni1 != 1;
kkIni1 = 1;
kkSrCh = srate != lastSrate;

// Ablauf / Datei-Scan
smplPos = 0; evN = 0; evRd = 0;
// Scan nur beim ersten Lauf vorspulen: ein Transportstart setzt filesDirty nicht (ohne laufenden Audio-Thread bliebe es
// stehen, DETECT meldete dann dauerhaft LOADING). Ein Slot mit Ladefehler (SM_FLAG = 2, z. B. Laufwerk beim Projektstart
// nicht da) wird bei jedem Transportstart neu versucht: Hash verwerfen -> sampleScan laedt neu (das schaltet laufende
// Stimmen ab - nur im Fehlerfall). kqLast = -1: der erste kitReq() sieht den geladenen slider70-Wert als "neu",
// uebernimmt aber nur eine noch nicht quittierte Anfrage mit derselben Nummer in gmem.
// v1.0.1: lqLast = -1 ebenso fuer den Lane-Kanal (laneReq, slider71), nur beim ersten Lauf.
kkFirst ? ( lqLast = -1; );
kkFirst ? ( filesDirty = 1; kqLast = -1; ) : (
  i = 0;
  loop(3, mt = M_GEN + 32 + i*16; mt[SM_FLAG] == 2 ? ( mt[SM_HASH] = -1; filesDirty = 1; ); i += 1; );
);
// Echter Samplerate-Wechsel: VOR der Zuweisung an lastSrate
// vergleichen (v0.7.1, P0-Finding 2) - der fruehere Check im @block
// war Totcode, weil @init den Wert bereits auf die NEUE Rate zog und
// der Vergleich dort nie mehr feuern konnte. Bei Aenderung:
// resamplete Daten + Hashes verwerfen, Stimmen aus, Neu-Load
// erzwingen. Transportstart (Rate unveraendert) laeuft still durch;
// der erste Durchlauf (lastSrate uninitialisiert) triggert harmlos.
srate != lastSrate ? (
  allVoicesOff();
  i = 0;
  loop(3, mt = M_GEN + 32 + i*16; mt[SM_LEN] = 0; mt[SM_FLAG] = 0; mt[SM_HASH] = -1; i += 1; );
  capReset();      // v0.8.2: Aufnahmen tragen die alte Rate -> verwerfen
  // Laufenden Scheiben-Scan abbrechen (Handle zu, Zustand zurueck) - der Preplauf danach baut bei neuer Rate neu.
  scFh > 0 ? file_close(scFh); scFh = 0; scPh = 0;
  filesDirty = 1;
) : 0;
topUse = 0; lastSrate = srate;
// Scan-Zustandsmaschine (Review kick-R017): scPh 0 bereit / 1 laden, scOwn 1 = @gfx / 2 = @block-Fallback.
// gfxAge startet "tot" - vor dem ersten geoeffneten Fenster laedt der Block selbst (in Scheiben).
// @init laeuft bei Transportstart erneut: ein mitten im Scan abgebrochenes Handle wird geschlossen
// (Handle-Leck), alle nicht fest geladenen nicht-CAP Slots bekommen SH = -1 -> sauberer Neuversuch
// statt halb geschriebener Daten (CAP-Slots zeigen in die CAP-Region und bleiben unberuehrt).
scFh > 0 ? file_close(scFh);
scPh == 1 ? (
  // Scan war mitten drin: der gerade beschriebene Slot kann noch FLAG=1 tragen
  // (alt) - alle nicht-CAP Slots zur Sicherheit neu laden (Rebuild ist ohnehin
  // komplett, siehe sampleScan).
  i = 0;
  loop(3, mt = M_GEN + 32 + i*16; mt[SM_CAP] < 0.5 ? mt[SM_HASH] = -1; i += 1; );
  filesDirty = 1;
);
scPh = 0; scS = 0; scFh = 0; scOwn = 2; scN = 4096;
gfxBeat = 0; gfxSeen = 0; gfxAge = 9999;
scopePos = 0; scopeDiv = 0;

// Player-Lauf (Runtime, liegt in Skalaren; Params stehen in M_GEN)
plRun = 0; plPos = 0; lastEi = -1; plSync = 1; plWant = 0;
lastFire = 0;                        // v0.13.3 (Review A2): 1 = das zuletzt verarbeitete Achtel (lastEi) hat einen Kick ausgeloest
hostPlay = 0; bpmNow = 120; eInc = 0; eSamps = 0; divN = 2;
swFrac = 0;                          // Swing-Versatz in Achteln (M5)

// Root-Detect-Anzeige (M5, Runtime): detSt 0 idle / 1 ok /
// 2 Fenster zu kurz / 3 kein Body-Signal (inkl. CONF < 0.3 seit
// v0.7.1) / 4 Reload laeuft; detSrc 1 Sample / 2 Synth. detHold =
// Handshake-Flag gegen den Loader im @block (der Scratch liegt
// seit v0.7.1 ueber den Slot-Enden - abgeleitet, nicht topUse).
// P25: nur beim ersten Lauf - detectRoot laeuft im @gfx-Thread; ein Transportstart mitten in der Analyse
// setzte sonst den Handshake detHold auf 0, und das Ergebnis verschwand bei jedem Play.
kkFirst ? (
  detSt = 0; detHz = 0; detCt = 0; detCf = 0; detNote = -1; detSrc = 0;
  detHold = 0;
);

// HUD: Trig-LED, Quelle (1 MIDI, 2 Player, 3 Lane-Audition), letzte Note
// P25: audReq (Anforderung aus dem @gfx) nur beim ersten Lauf - ein Transportstart verwarf sonst einen Lane-Klick.
trigLed = 0; trigSrc = 0; trigNote = -1;
kkFirst ? ( audReq = 0; );

// Mirror-Slider: im ersten Block nach diesem Init kein
// slider_automate (Finding 19) - der Sync nach Laden/Restore ist
// keine Nutzer-Automation.
mirBoot = 1;

// Master-Kette (M4): gedaempfte Zustaende direkt auf die Zielwerte
// snappen - ein Transportstart faedelt den Ausgang NICHT erst ueber
// die ~20-ms-Lerps ein, der erste Schlag bliebe sonst leiser.
// (M_SLI ist an dieser Stelle immer gueltig: frische Instanz bekam
// oben writeDefaults, ein laufender Restore hat die Region schon.)
masterTargets();
wFlt = tFlt;   fcSm = tFcHz;  resSm = tResQ;  fbSm   = tBeefF;
wDrv = tDrv;   dBfSm = tBfW;  dGlSm = tGlW;   protSm = tProt;
wClip = tClip; hardSm = tHard; ceilSm = tCeil; outSm = tOutG;
fcPrev = -1; resPrev = -1; fbPrev = -1;   // Koeffizienten erzwingen
// Lane-Filter (v0.9.1): dieselbe Logik - Zustaende auf die Ziele snappen,
// Koeffizienten erzwingen (SG_FCUT/SG_FRES sind hier bereits gueltig).
lfSnap();
// Filter-/Meterzustaende: Skalare, gehen bewusst NICHT in die
// Speicherkarte (Runtime, Regel "Zustaende in Skalaren")
// P25 (Review A16): nur beim ersten Lauf und bei Samplerate-Wechsel nullen (Muster kickInit). Ein Transportstart,
// waehrend noch ein Tail durch FILTER (Resonanz) oder DRIVE klingt, setzte die Zustaende mitten im Signal auf 0
// (Sprung = Pop). Die Stimmen bleiben ohnehin erhalten.
(kkFirst || kkSrCh) ? (
  sv1a = 0; sv2a = 0; sv1b = 0; sv2b = 0; bpY = 0;
  mPeak = 0; mRms = 0;
);

// Oberflaeche
// P25 (Harmonisierung Punkt 9, _shared A2): Bedienzustand nur beim ersten Lauf. Ein Transportstart bei gedrueckter
// Taste setzte lmbPrev = 0 -> im Folgeframe eine Klickflanke (Phantomklick), dragId/kbDrag = -1 brach einen
// laufenden Zug ab, undArm = 0 verwarf die Undo-Klammer des laufenden Edits, SC/OX/OY mitten in einem @gfx-Frame
// (Rack-Versatz MOFF) verschob eine Zeichnung.
kkFirst ? (
  SC = 1; OX = 0; OY = 0; mX = -1; mY = -1;
  dragId = -1; lmbPrev = 0; rmbPrev = 0;
  kbDrag = -1; kbCh = 0; kbY0 = 0; kbN0 = 0; kbMv = 0; kbFine = 0;   // Poti-Zustand (v0.9.1)
  kbWacc = 0;                                                       // P25: Mausrad-Rest der EXPERT-Potis
  expOn = 0;
);
// v0.9.2: maximierte Lane (-1 = keine). Reine Ansicht, nicht serialisiert; nur
// beim allerersten Init gesetzt, damit ein Transportstart (@init) die Ansicht
// nicht zuruecksetzt.
maxInit != 1 ? ( maxLane = -1; maxInit = 1; );

// Undo + Presets (M6, Runtime-Skalare; der Ring selbst liegt im
// M_TOP-Kopf und ueberlebt @init): undArm = Pending-Snapshot scharf,
// undPset = naechster Commit kam von einem Preset-Apply (kein "*"),
// psetMod = Front-Marker "Zustand weicht vom geladenen Preset ab".
// wie oben nur beim ersten Lauf (Undo-Arm, Pan-Anker, Schrift-Probe).
kkFirst ? (
  undArm = 0; undPset = 0;   // psetMod bleibt erhalten (Finding 11)
  dragX = 0; dragMv = 0;             // Pan-Anker / "wurde gezogen" (Audition-Schutz)
  fontChk = 0; sansSel = -1; monoSel = -1; bigSel = 0;
  fBigP = -1; fMedP = -1; fSmlP = -1;
);

/* ============================================================
   @serialize — Segment-Parameter, Pfade, Player-Params und die
   Master-Regler (M_SLI) gehen ins Projekt und in Presets.
   Runtime-Felder von M_GEN (Slot-Meta, Stimmen, Player-Lauf)
   wandern bewusst NICHT in den Blob - nach einem Restore erzwingt
   der Hash-Vergleich den Neu-Load.
   ============================================================ */
@serialize

// v0.8.2 Capture: Aufnahmen sind VOLATIL - weder Slot-Meta (SM_CAP) noch
// die CAP-Region gehen in den Blob. Nach einem Projekt-Reload (neue
// Instanz) ist der Slot leer; ein Restore in eine laufende Instanz
// laesst die Aufnahme dagegen stehen (REAPER-Undo ruft @serialize).
// Frische Instanz: @serialize kann vor @init laufen - dann nur das
// Defaults-Flag setzen (PHALYX-Muster).
kickInit != 1 ? (
  needDefaults = 1;
) : (
  // Vor dem Lesen die Blob-Laenge pruefen: file_avail(0) liefert nur
  // im Lesemodus die Restworte (Schreibmodus < 0 -> Check aus).
  // Erwartet: 2 + 192 + 768 + 16 + 16 = 994 Worte (v4..v8 - die
  // belegen im M_GEN-Kopf +6 PG_KTRK, +7 PG_PSET, +8 PG_PAGE, +9 PG_TIPS
  // und +10 PG_EXP; M_SEG traegt seit v8 die Felder 17..21 - das Layout
  // waechst nicht); v1..v3-Blobs enden bei 978 und laden
  // weiter (Master bekommt Defaults).
  // v0.10.1 FIX (gemessen in echtem REAPER, Chunk-Rundreise): file_avail(0)
  // liefert im Lesemodus nur 1 (Daten da) bzw. 0 (leer), NICHT die Wortzahl -
  // die alte Laengenpruefung (>= 978 / >= 994) schlug beim Laden immer fehl,
  // Projekt-/Track-Chunk-/Preset-Zustand wurde still verworfen. Jetzt:
  // Blob vorhanden = serAvail != 0; ob der Master-Block (M_SLI, ab v4) folgt,
  // entscheidet die gelesene Blob-Version plus file_avail(0) nach dem GEN-Block.
  serAvail = file_avail(0);
  serAvail != 0 ? (
    smagic = KK_MAGIC;
    file_var(0, smagic);
    serVer = kickVer;                // Schreibmodus: immer aktuelles Format
    file_var(0, serVer);             // Lesemodus: Blob-Version
    // Review 30.10.2026 (2): jede Pflichtlesung zaehlen; Schreiben und Blob-Layout bleiben unveraendert.
    // Historie: file_mem(0, M_SEG, 192); file_mem(0, M_PATH, 768); ohne Rueckgabepruefung.
    kkSerOk = 1;
    kkSerN = file_mem(0, M_SEG, 192);
    serAvail > 0 && kkSerN != 192 ? kkSerOk = 0;
    kkSerN = file_mem(0, M_PATH, 768);
    serAvail > 0 && kkSerN != 768 ? kkSerOk = 0;
    // P25 (Harmonisierung Punkt 3): EIN Tooltip-Schalter (OPTIONS > TOOLTIPS, tth_tipoff). PG_TIPS (+9) bleibt im
    // Format und wird beim SCHREIBEN aus tth_tipoff abgeleitet (1 = an), damit aeltere Versionen denselben Zustand
    // sehen; beim Lesen wird es unten auf tth_tipoff abgebildet. Die Zuweisung vor file_mem wirkt nur im Schreib-
    // modus - im Lesemodus ueberschreibt file_mem sie sofort mit dem Blob-Wert.
    serAvail < 0 ? ( M_GEN[PG_TIPS] = tth_tipoff > 0.5 ? 0 : 1; );
    // Historie: file_mem(0, M_GEN, 16); ohne Rueckgabepruefung.
    kkSerN = file_mem(0, M_GEN, 16);  // nur der serialisierte Kopf +0..15
    serAvail > 0 && kkSerN != 16 ? kkSerOk = 0;
    // v4 (v0.5): +16 Worte M_SLI (Master-Kette). Blobs der Laenge 978
    // enden nach M_GEN -> Master-Werkswerte nachziehen. Aeltere Blobs
    // (v1/v2/v3) waren identisch lang, ihre unbeschriebenen Felder
    // klemmt validateState in den Rahmen bzw. fuettert die Defaults.
    // Review 30.10.2026 (2): ab v4 ist M_SLI Pflicht, auch wenn file_avail bereits 0 meldet.
    // Historie: serAvail < 0 || (floor(serVer + 0.5) >= 4 && file_avail(0) != 0) ? file_mem(0, M_SLI, 16)
    //                                   : masterDefaults();
    (serAvail < 0 || floor(serVer + 0.5) >= 4) ? (
      kkSerN = file_mem(0, M_SLI, 16);
      serAvail > 0 && kkSerN != 16 ? kkSerOk = 0;
    ) : masterDefaults();
    // v0.10.1: KK_MAGIC = 1263424331 ist in float32 nicht exakt (Abstand 128) -
    // der Blob liefert den gerundeten Wert; exakter Vergleich scheiterte immer.
    // Historie: abs(smagic - KK_MAGIC) < 256 && floor(serVer + 0.5) >= 1 && floor(serVer + 0.5) <= 9 ? (
    kkSerOk && abs(smagic - KK_MAGIC) < 256 && floor(serVer + 0.5) >= 1 && floor(serVer + 0.5) <= 9 ? (
      // Blobs <= v4 kannten PG_KTRK (M_GEN+6) noch nicht - das Feld
      // traegt dort Reservemuell -> Default AN erzwingen (Keytrack
      // war bisher immer aktiv; 0 wuerde alte Projekte still auf
      // ROOT pinnen). Schreibmodus setzt serVer=kickVer -> nie < 5.
      floor(serVer + 0.5) < 5 ? ( M_GEN[PG_KTRK] = 1; ) : 0;
      // v6 (v0.7): PG_PSET (+7) und PG_PAGE (+8) fahren im vorhandenen
      // Kopf mit; Blobs < 6 tragen dort Reserve/0 -> auf INIT/MAIN
      // ziehen (auch Schreibmodus-sicher: 0 ist der Default).
      floor(serVer + 0.5) < 6 ? ( M_GEN[PG_PSET] = 0; M_GEN[PG_PAGE] = 0; ) : 0;
      // v7 (v0.9.0): PG_TIPS (+9); Blobs < 7 tragen dort Reserve 0 ->
      // Default AN (sonst wuerden alte Projekte ohne Hinweise starten).
      floor(serVer + 0.5) < 7 ? ( M_GEN[PG_TIPS] = 1; ) : 0;
      // v8 (v0.9.1): SG_XFI/MUTE/SOLO/FCUT/FRES (M_SEG 17..21) und PG_EXP
      // (+10) tragen in Blobs < 8 Nullen/Reserve. Migration HIER (nicht in
      // validateState - dort wuerde jeder Restore sie ueberschreiben):
      // XFI[s] = XF[s-1] gibt die v0.9.0-Kette exakt wieder (dort las die
      // Eintrittsseite SG_XF[s-1]; Lane 0 hat keinen Vorgaenger -> XF[0],
      // wirkungslos), Mute/Solo aus, Lane-Filter offen, EXPERT aus.
      floor(serVer + 0.5) < 8 ? (
        mgi = 0;
        loop(3,
          mgb = M_SEG + mgi*64;
          mgp = M_SEG + max(0, mgi - 1)*64;
          mgb[SG_XFI]  = mgp[SG_XF];
          mgb[SG_MUTE] = ctlDef(118);
          mgb[SG_SOLO] = ctlDef(119);
          mgb[SG_FCUT] = ctlDef(120);
          mgb[SG_FRES] = ctlDef(121);
          mgi += 1;
        );
        M_GEN[PG_EXP] = ctlDef(210);
      ) : 0;
      // v9 (v1.1.0): SG_OFF (M_SEG 25). Blobs < 9 tragen dort Reserve -> OFFSET 0 (Migration hier, wie v8; auch Schreibmodus-
      // sicher: dort ist serVer = kickVer). Ein v9-Blob mit Muellwert klemmt validateState.
      floor(serVer + 0.5) < 9 ? (
        mgi = 0;
        loop(3, mgb = M_SEG + mgi*64; mgb[SG_OFF] = 0; mgi += 1; );
      ) : 0;
      // P25 (Review A13): die Lese-Nachbehandlung nur im LESEMODUS (serAvail > 0). REAPER ruft @serialize auch zum
      // Speichern und fuer jeden Undo-Schnappschuss; dort schrieb validateState in den Zustand, waehrend @gfx
      // bearbeitete, psetMod = 0 loeschte den "*" der SYS-Seite nach jedem Speichern, und filesDirty = 1 liess
      // DETECT kurz "LOADING" melden.
      // REAPER-Undo spielt den Zustand ueber diesen Zweig in die LAUFENDE Instanz zurueck: abgeleitet wird danach
      // alles neu (Master-/Lane-Filter-Ziele je @block, Sterne je Frame, Pfade per Hash in sampleScan); die Stimmen
      // sind One-Shots auf eingefrorenen Spans (nichts haengt), und es wird kein Werks-Preset nachgeladen.
      serAvail > 0 ? (
        validateState();
        needDefaults = 0;              // valider Blob -> keine Defaults
        filesDirty = 1;                // wiederhergestellte Pfade neu laden
        psetMod = 0;                   // Zustand == Blob -> kein "*"
        kkTipLd = M_GEN[PG_TIPS] < 0.5 ? 1 : 0;   // P25: Alt-Schalter aus dem Blob (1 = aus)
      );
      // v0.11.0 (P17): Anwender-Preset-Bank NACH dem 994-Worte-Blob (Format/kickVer unveraendert). Alte Projekte
      // enden hier (file_avail = 0): die Bank bleibt leer. Nur bei gueltigem Blob; Leiste auf das Werks-Preset
      // aus PG_PSET stellen, wenn keine Bank-Auswahl gespeichert war.
      // P25 (Punkt 3, Tooltip-Schalter): vor dem Lesen der Bank tth_tipoff auf den Waechter -1 setzen. Das Modul
      // ueberschreibt ihn nur, wenn eine gueltige Bank folgt (Vorgabe 0, ein Stil-Block v2 liefert den gespeicherten
      // Wert). Danach: tth_tipoff = 1, wenn der Stil-Block AUS geladen hat, sonst der Alt-Schalter PG_TIPS. Ein Stil-
      // Block v1 / fehlender Block (Vorgabe 0) und v2 mit "an" sind von aussen nicht unterscheidbar; in beiden Faellen
      // gilt PG_TIPS - seit v0.12.3 wird PG_TIPS gleich mitgeschrieben, die Ergebnisse stimmen also ueberein; der
      // einzige Unterschied ist der v0.12.3-Randfall (Alt-Projekt mit PG_TIPS = 0 ohne geoeffnete Front erneut
      // gespeichert): dort zaehlt jetzt PG_TIPS = AUS - genau das, was v0.12.3 beim Oeffnen gezeigt haette. Damit
      // entfaellt kkTipSync samt der Ersatz-Idee "serAvail > 0 ? kkTipInit = 0;" (LOGBUCH P25).
      tt_pb_ready == 1 ? (
        kkBk = file_avail(0);        // < 0 Schreiben | 0 Lesen ohne Bank (Altprojekt) | > 0 Bank folgt
        serAvail > 0 ? ( tth_tipoff = -1; );
        tt_pb_serialize();
        serAvail > 0 ? ( tth_tipoff = tth_tipoff > 0.5 ? 1 : kkTipLd; );
        // v0.13.3 (Review B1): ein aus dem Chunk gelesener Aenderungsstern (tt_pb_stk) ueberlebt nur, wenn kein tt_pb_reset
        // mehr ansteht. tt_pb_init (@init) setzt tt_pb_reset = 1, und beim Projekt-Laden kommt @serialize vor dem ersten
        // @gfx-Frame: das erste tt_pb_track() loeschte den Stern ("tt_pb_reset ? tt_pb_stk = 0"). Die Referenz wird nach
        // dem Lesen ohnehin neu genommen (tt_pb_chkok = 0), also kann der Reset entfallen. Seit Modul 1.5.2 erledigt das
        // tt_pb_serialize selbst (Ende des Lesezweigs: "tt_pb_stk ? tt_pb_reset = 0;").
        // der Stern ging bei jedem Projekt-Laden verloren.
        kkBk == 0 ? tt_pb_select(1, min(44, max(0, floor(M_GEN[PG_PSET] + 0.5))));
      );
    ) : (
      needDefaults = 1;
    );
  ) : (
    needDefaults = 1;                // abgeschnittener/leerer Blob
  );
);

// einzige JSFX-Slider (slider1 = provisorischer OUT-Gain) wurde vom
// Front-Regler MS_OUTG abgeloest. Ohne sliderN-Definitionen gibt es
// keine Sektion mehr.
// P26 (Kit-Option 2): wieder eine @slider-Sektion, nur fuer den Anfrage-Kanal slider70. Setzt ein Lua-Lader den
// Parameter, laeuft @slider und uebernimmt die Anfrage sofort (auch ohne laufenden Block). Die Mirror 63/64 schreibt
// weiterhin der @block; ihr Setzen per Host loest hier nur einen kitReq()-Lauf ohne Wirkung aus.
// v1.0.1: ebenso der Lane-Kanal slider71 (laneReq).
@slider
kitReq();
laneReq();

/* ============================================================
   @block — Datei-Scan, Player-Clock, MIDI einsammeln
   ============================================================ */
@block

// Herzschlag-Verfolgung des @gfx (Review kick-R017): gfxBeat zaehlt im UI-Thread jeden Frame hoch;
// gfxAge = Bloecke seit dem letzten Frame und entscheidet in sampleScan den Loader-Owner
// (laufendes @gfx laedt im UI-Thread, totes @gfx -> Scheiben-Fallback hier im Block).
gfxBeat != gfxSeen ? ( gfxSeen = gfxBeat; gfxAge = 0; ) : ( gfxAge += 1; );

needDefaults ? ( writeDefaults(); needDefaults = 0; filesDirty = 1; );

// Master-Kette (M4): Reglerwerte aus M_SLI in die Zielgroessen
// uebersetzen - die Einpol-Lerps im @sample laufen darauf zu.
masterTargets();
lfTargets();       // v0.9.1: Lane-Filter-Ziele aus SG_FCUT/SG_FRES

// Samplerate-Wechsel (Fallback): der eigentliche Check steht seit
// v0.7.1 im @init VOR der lastSrate-Zuweisung (P0-Finding 2) - dieser
// Zweig bleibt als Deckung, falls ein Host @init nicht neu feuert.
srate != lastSrate ? (
  lastSrate = srate;
  allVoicesOff();
  topUse = 0;
  i = 0;
  loop(3, mt = M_GEN + 32 + i*16; mt[SM_LEN] = 0; mt[SM_FLAG] = 0; mt[SM_HASH] = -1; i += 1; );
  capReset();      // v0.8.2 (Deckung, s. @init)
  filesDirty = 1;
);

filesDirty ? sampleScan();

// Kit-Anfragen kommen ueber slider70 + gmem an genau diese Instanz (kitReq, auch in @slider); kein Datei-I/O im
// Audio-Thread fuer die Kit-Zuweisung.
kitReq();
laneReq();       // v1.0.1: Lane-Klaenge ueber slider71 + gmem (falls @slider sie nicht schon genommen hat)

// v1.0.0 (Wellenansicht): Wellen-Vorschau nachfuehren (wvTick, Budget je Block) und den Klick in die Welle der
// WAVE-Seite bzw. die SUM-Zeile von FUSION ausloesen (kickReq aus dem gfx-Thread; ganze Kick mit Player-Velocity 100).
wvTick();
kickReq > 0 ? (
  trigKick(M_GEN[PG_ROOT], 100);
  trigSrc = 3;
  kickReq = 0;
) : 0;

// Lane-Audition aus dem gfx-Thread (Klick auf die Welle) hier
// ausloesen - Stimmen werden nur im Audio-Kontext beschrieben.
audReq > 0 ? (
  trigAudition(audReq - 1);
  trigSrc = 3;
  audReq = 0;
);

// Capture-Anforderung aus dem gfx-Thread (CAP-Klick, v0.8.2): arm/abbrechen
// gehoert in den Audio-Kontext - der Automat laeuft im @sample.
capReq > 0 ? (
  capRequest(capReq - 1);
  capReq = 0;
);

// --- 4/4-Player-Clock (TT-303-Erbe, Position in Achteln) ---
bpmNow = tempo > 10 ? tempo : 120;
eSamps = max(16, srate*30/bpmNow);        // eine 1/8 in Samples
eInc = 1/eSamps;
pgb = M_GEN;
divN = floor(8 / 2^floor(pgb[PG_RATE] + 0.5) + 0.5);   // 8/4/2/1
divN < 1 ? divN = 1 : 0;
// Swing-Versatz in Achtel-Bruchteilen (TT-303: swFrac = %/200;
// 66,7 % = Triolenpunkt, 100 % = halbe Achtel = Maximum)
swFrac = pgb[PG_SWING]*0.005;

hostPlay = play_state & 1;
plSync = pgb[PG_SYNC] > 0.5;
plWant = pgb[PG_ON] > 0.5 && (plSync ? hostPlay : 1);
plWant != plRun ? (
  plRun = plWant;
  plRun ? (
    plSync && hostPlay ? ( plPos = beat_position*2; ) : ( plPos = 0; );
    lastEi = floor(plPos) - 1;             // der Schlag unter dem Cursor feuert
    lastFire = 0;
  ) : 0;
);
// An der Timeline haengen, aber NICHT jeden Block hart resetten -
// beat_position rundet, ein gerade uebersprungener Schlag wuerde sonst
// doppelt feuern. Neu-Andocken nur bei echtem Versatz (Loop, Positions-
// oder Tempo-Sprung). 0,02 Achtel sind ~2,3 ms bei 130 BPM. Beim
// Nachjustieren im Lauf gilt das Achtel unter dem Cursor bereits als
// erledigt (lastEi = floor, KEIN -1) - das -1 (Schlag feuert sofort)
// gehoert nur zum Anlauf-/Neu-Andock-Pfad oben.
// P25 (Review A4): liegt das neue Ziel GENAU auf einer Achtelgrenze N (Loop-Start auf dem Takt, Seek mit
// Snap), muss N noch feuern - mit lastEi = floor(N) = N war die Bedingung ei != lastEi im ersten Sample falsch
// und der Schlag fiel aus. ceil(x) - 1 ist gleich floor(x) ausser bei ganzzahligem x. N gilt trotzdem als
// erledigt (kein Doppelschlag), wenn (a) der Player im selben Achtel nur VOR dem Host liegt (lastEi == N,
// tgt < plPos < N + 1) oder (b) eben erst (< 0,02 Achtel) eine Achtelgrenze ueberquert wurde: am Loop-Ende
// erreicht plPos die Grenze "8" oft im letzten Sample vor dem Sprung (der Schlag feuert ein Sample frueh) - das
// ist derselbe Schlag wie die Loopgrenze "0". Ob plPos dort 8,0 erreicht oder bei 7,99999 bleibt, haengt an der
// Gleitkommasumme der eInc - beide Faelle rechnet p25_orakel.py A4 nach (je Umlauf genau ein Downbeat).
// v0.13.3 (Review A2): Ausnahme (b) gilt nur, wenn das eben ueberquerte Achtel (lastEi) WIRKLICH einen Kick
// ausgeloest hat (lastFire, im @sample gesetzt) und dieselbe Akzentklasse hat wie N (Taktanfang 118 oder 100: nur
// dann ist es derselbe musikalische Uebergang, am Loop-Ende "8" -> "0"). Vorher genuegte plPos - lastEi < 0.02:
// lastEi wird auch fuer Achtel gesetzt, die wegen RATE (1/4: nur gerade Achtel) gar nichts spielen; ein Seek
// unmittelbar nach dem Achtel 1 auf den Takt schluckte so den Kick bei N = 0. Rechenprobe: p27_orakel.py A2.
plRun && plSync && hostPlay ? (
  tgt = beat_position*2;
  abs(tgt - plPos) > 0.02 ? (
    kkEi = ceil(tgt) - 1;
    kkSup = 0;                             // 1 = N gilt als schon ausgegeben (lastFire bleibt dann erhalten)
    kkEi < floor(tgt) ? (
      ((lastEi == floor(tgt) && plPos > tgt && plPos < floor(tgt) + 1)
        || (plPos - lastEi < 0.02 && lastFire && (((lastEi & 7) == 0) == ((floor(tgt) & 7) == 0)))) ? ( kkEi = floor(tgt); kkSup = 1; );
    );
    plPos = tgt; lastEi = kkEi;
    kkSup ? 0 : ( lastFire = 0; );
  );
);

// MIDI mit Offset in die Queue, Ausloesung sample-genau im @sample
evN = 0; evRd = 0; smplPos = 0;
while (midirecv(offs, m1, m2, m3)) (
  evN < 128 ? (
    // Offsets hinter dem Blockrand waeren im @sample nie erreichbar
    // und wuerden im naechsten Block still verworfen -> clampen
    M_EVT[evN*4]   = min(samplesblock - 1, max(0, offs));
    M_EVT[evN*4+1] = m1;
    M_EVT[evN*4+2] = m2;   M_EVT[evN*4+3] = m3;
    evN += 1;
  ) : 0;   // Ueberlauf verwerfen: synchrones Sofort-Feuern hier haette
           // keinen Sample-Offset und kaeme vor eingereihten Events
  // Instrument: Noten werden verbraucht, CC/PB/Clock laufen durch
  stThru = m1 & 0xF0;
  stThru != 0x80 && stThru != 0x90 ? midisend(offs, m1, m2, m3) : 0;
);

// Versteckte Mirror-Parameter (M6): slider63/64 fuehren ROOT und das
// zuletzt geladene Werks-Preset nach aussen - ReaScripts lesen sie
// ("TT-KICK Export Kick.lua" benennt damit das Render-Item). Nur
// schreiben, die Front liest sie nie; Sync gehoert in den @block,
// weil @gfx bei geschlossener Oberflaeche nicht laeuft.
// v0.7.1 (Finding 19): slider_automate wird im ersten Block nach dem
// Laden/Restoren unterdrueckt (mirBoot) - der Init-Sync duerfte
// sonst als Automation auf der Host-Lane landen. Gemeldet wird nur,
// was sich danach tatsaechlich aendert.
slider63 != pgb[PG_ROOT] ? (
  slider63 = pgb[PG_ROOT];
  !mirBoot ? slider_automate(slider63) : 0;
) : 0;
slider64 != pgb[PG_PSET] ? (
  slider64 = pgb[PG_PSET];
  !mirBoot ? slider_automate(slider64) : 0;
) : 0;
mirBoot = 0;

/* ============================================================
   @sample — Stimmen, Player, Ausgang
   ============================================================ */
@sample

// --- Capture (v0.8.2): Eingang am Eintritt, VOR jeder Verarbeitung.
//     Die Ausgabe unten ueberschreibt spl0/spl1, also vorher sichern
//     (capIn0/1 werden am Ende durchgereicht).
capIn0 = spl0; capIn1 = spl1;
capSt > 0 ? capStep((capIn0 + capIn1)*0.5);

// --- faellige MIDI-Ereignisse
while (evRd < evN && M_EVT[evRd*4] <= smplPos) (
  handleMidi(M_EVT[evRd*4+1], M_EVT[evRd*4+2], M_EVT[evRd*4+3]);
  evRd += 1;
);

// --- 4/4-Player: Raster in Achteln, Schlag auf den Rate-Teilen;
//     Downbeat (Taktanfang) bekommt Accent-Velocity.
//     Swing (M5, exakt die TT-303-Shuffle-Konvention, dort Z.1067ff:
//     "(stepIdx & 1) ? sFrac >= swFrac : 1"): GERADE Achtel feuern
//     sofort an der Rastergrenze, UNGERADE erst ab sFr >= swFrac -
//     also um swFrac Achtel verzoegert. plPos selbst bleibt
//     ungeschwungen: SYNC-Anker, Re-Sync und BAR-Anzeige rechnen
//     weiter im strengen Raster. Wirkt in SYNC und FREE RUN
//     identisch (beide fuettern dieselbe eInc-Schleife); bei Rate
//     1/1..1/4 liegen alle Schlaeger auf geraden Achteln -> Swing
//     hat dort bewusst keine hoerbare Wirkung (kein Off-Grid).
plRun ? (
  plPos += eInc;
  ei = floor(plPos);
  sFr = plPos - ei;
  ((ei & 1) ? sFr >= swFrac : 1) && ei != lastEi ? (
    lastEi = ei;
    lastFire = (ei % divN) == 0;           // v0.13.3 (Review A2): hat dieses Achtel einen Kick ausgeloest?
    (ei % divN) == 0 ? (
      // 0.14.2: alle Player-Kicks gleich laut (Velocity 100) - der Accent machte in SYNC/FREE RUN den ersten von vier Kicks lauter
      trigKick(M_GEN[PG_ROOT], 100);
      trigSrc = 2;
    ) : 0;
  );
);

// --- Stimmen: jeder Span laeuft sein Fenster mit eigener Rate,
//     Equal-Power-Huelle sitzt in spanRead(). Die aktuelle Position
//     wird erst gerendert und DANN weitergeschaltet - Frame 0 und das
//     letzte Fensterende bleiben hoerbar. Ausserhalb [0,LEN) ist die
//     Stimme im Vorlauf (schweigt, zaehlt weiter) - erst beim
//     Verlassen auf der Spielfeld-Seite stirbt sie.
// v0.9.1: Lane-Filter-Lerps/Koeffizienten einmal je Sample VOR der Schleife;
// laneFilt() wirkt danach je Stimme auf ihr eigenes Signal (vor sumL).
lfSmooth();
sumL = 0;
vi = 0;
// P26: VX_N Stimmen ab VX_POOL.
loop(VX_N,
  vb = VX_POOL + vi*VX_STR;
  vb[VX_ON] > 0.5 ? (
    rt = vb[VX_RATE];
    ps = vb[VX_POS];
    ln = vb[VX_LEN];
    // Steal-Fade (v0.8.1): sin-Multiplikator 64 -> 1 Frames, danach
    // stirbt die Stimme. Position und Phase laufen normal weiter.
    // P25 (Review A1): Fassung vor P22 wiederhergestellt. VX_DIE ist ganzzahlig (64 .. 1) und wird nur bei > 0
    // betreten - nach dem Dekrement ist es >= 0, die P22-Bedingung "< -0.5" war unerreichbar: der Fade lief auf
    // 0,0245 herunter, sprang danach auf vollen Pegel zurueck, und der Slot blieb belegt (Pool lief voll).
    // Jetzt: Gain sin(64..1 * pi/128) = 1 .. 0,0245 streng fallend, der letzte Fade-Frame (DIE 1 -> 0) rendert
    // noch und schaltet die Stimme aus - Slot frei. Rechenprobe: p25_orakel.py A1.
    stlG = 1;
    vb[VX_DIE] > 0 ? (
      stlG = sin(vb[VX_DIE]*0.0245436926);
      vb[VX_DIE] -= 1;
      vb[VX_DIE] < 0.5 ? ( vb[VX_ON] = 0; );
    );
    rt > 0 ? (
      ps >= ln ? ( vb[VX_ON] = 0; )
      : ( ps >= 0 ? ( sumL += laneFilt(vb, spanRead(vb, ps, ln)*stlG); ); vb[VX_POS] = ps + rt; )
    ) : (
      ps < 0 ? ( vb[VX_ON] = 0; )
      : ( ps < ln ? ( sumL += laneFilt(vb, spanRead(vb, ps, ln)*stlG); ); vb[VX_POS] = ps + rt; )
    );
  );
  vi += 1;
);

/* ---------- MASTER-KETTE (M4): LP -> DRIVE -> CLIP -> OUT ----------
   Jeder Regler wirkt ueber einen Einpol-Lerp (~20 ms, slewK) auf sein
   Ziel - kein Sprung greift je direkt ins Audiosignal (klickfreies
   Bypass, TT-303-Muster "Zustaende gedaempft mitfuehren"). Alle
   Stufen rechnen auch im Bypass weiter auf dem laufenden Signal:
   ihre internen Filterzustaende folgen dem Eingang, ein Zuschalten
   kommt so ohne Zustandssprung aus. Bypass = Wet-Lerp gegen das
   unveraenderte Eingangssignal -> bei Wet 0 bitgenau transparent. */

// --- LP: zwei kaskadierte TPT-SVF. Stufe A traegt die Resonanz und
//     sitzt auf fpk = fc * 2^(-3*Beef) - "Beef" senkt den Reso-Peak
//     bis drei Oktaven UNTER den Cutoff (basslastige Anhebung),
//     Stufe B liegt am echten Cutoff (Butterworth, k = sqrt(2))
//     und haelt den HF-Rolloff. Koeffizienten nur bei Bewegung neu
//     (relativer Schwellwert wie im TT-303 - absolute Hz-Grenzen
//     quantisieren tiefe Cutoffs hoerbar).
wFlt   += (tFlt   - wFlt  )*slewK;
fcSm   += (tFcHz  - fcSm  )*slewK;
resSm  += (tResQ  - resSm )*slewK;
fbSm   += (tBeefF - fbSm  )*slewK;
abs(fcSm - fcPrev) > fcSm*0.0005
 || abs(resSm - resPrev) > resSm*0.0005
 || abs(fbSm - fbPrev) > 0.0002 ? (
  fcPrev = fcSm; resPrev = resSm; fbPrev = fbSm;
  fpk = min(0.45*srate, max(20, fcSm*2^(-3*fbSm)));
  fcc = min(0.45*srate, max(20, fcSm));
  gR  = tan(3.1415927*fpk/srate);
  a1R = 1/(1 + gR*(gR + 1/max(0.5, resSm)));
  a2R = gR*a1R; a3R = gR*a2R;
  gT  = tan(3.1415927*fcc/srate);
  a1T = 1/(1 + gT*(gT + 1.4142136));
  a2T = gT*a1T; a3T = gT*a2T;
);
// v0.7.4: Kettensignal heisst mSig (vorher 'mx'). EEL2-Namen sind NICHT
// case-sensitiv - 'mx' war dieselbe Variable wie die gfx-Mausposition
// 'mX': @sample zerschoss die Trefferpruefung der Front (Klicks landeten
// bei x ~ 0), und ein gfx-Frame konnte mitten in der Kette eine Maus-
// koordinate (~0..900) ins Audio schreiben -> Vollausschlag-Knall.
// Prueft jetzt tt-kick_eelcheck.py (Klasse I, Gross/Klein-Kollision).
mSig = sumL;
fv3 = mSig - sv2a;
fv1 = a1R*sv1a + a2R*fv3;   fv2 = sv2a + a2R*sv1a + a3R*fv3;
sv1a = 2*fv1 - sv1a;        sv2a = 2*fv2 - sv2a;
fv3 = fv2 - sv2b;           // Stufe B: festes Butterworth-k am Cutoff
fv1 = a1T*sv1b + a2T*fv3;   fv2 = sv2b + a2T*sv1b + a3T*fv3;
sv1b = 2*fv1 - sv1b;        sv2b = 2*fv2 - sv2b;
// Denormal-Flush (v0.7.1, Finding 13): Filter-, Band- und Meter-
// Zustaende unter 1e-18 hart auf 0 - Denormale kosten auf den
// meisten CPUs ein Mehrfaches, ohne dass etwas davon hoerbar waere.
// (Dezimal statt 1e-18: wissenschaftliche Notation ist in EEL2
// ungueltig - PHALYX-Lektion 5.)
abs(sv1a) < 0.000000000000000001 ? sv1a = 0 : 0;
abs(sv2a) < 0.000000000000000001 ? sv2a = 0 : 0;
abs(sv1b) < 0.000000000000000001 ? sv1b = 0 : 0;
abs(sv2b) < 0.000000000000000001 ? sv2b = 0 : 0;
mSig += wFlt*(fv2 - mSig);

// --- DRIVE: Beef = paralleler Band-Drive (TT-303-Stufe-3-Muster).
//     Der Einpol-Split bei ~140 Hz schickt das Bassband in den
//     Shaper; dRest = mSig - band bleibt als Trockenanteil bitgenau
//     erhalten (PUNCH PROTECT - der Punch/die Mitten kommen nie in
//     die Saettigung). PROT aus: das Band morph't auf das Voll-
//     signal -> klassischer Drive ueber alles. Glue = Summen-
//     Saettigung dahinter (Mixform, bei 0 bitgenau transparent).
wDrv   += (tDrv   - wDrv  )*slewK;
dBfSm  += (tBfW   - dBfSm )*slewK;
dGlSm  += (tGlW   - dGlSm )*slewK;
protSm += (tProt  - protSm)*slewK;
bpY += bpG*(mSig - bpY);
abs(bpY) < 0.000000000000000001 ? bpY = 0 : 0;   // Denormal-Flush
band = mSig + (bpY - mSig)*protSm;   // PROT 1 = Bassband, 0 = Vollsignal
// Beef-Menge: Vorverstaerkung in den Softclip (bis ~+27 dB),
// pegelnormiert mit preG^-0.35 (TT-303 distPostG-Exponent)
drvPre = 1 + dBfSm*23;
// v0.7.4: Exponent geklammert - 'x^-c' (unaeres Minus direkt hinter ^)
// ist in keiner Referenzdatei belegt; x^(-c) ist semantisch identisch.
dd = mSig + dBfSm*(softClip(band*drvPre)*drvPre^(-0.35) - band);
glPre = 1 + dGlSm*11;
dd += dGlSm*(softClip(dd*glPre)*glPre^(-0.3) - dd);
mSig += wDrv*(dd - mSig);

// --- CLIP: SOFT (softClip-Knie, Grenze = Ceiling) / HARD (min/max).
//     hardSm morpht zwischen den Kurven -> Umschalter klickfrei.
//     v0.7.2: explizite Ceiling-Klemme hinter dem Soft-Anteil.
//     Mathematisch ein No-op (softClip <= 1 haelt das Ceiling schon),
//     aber sie macht die Invariante lokal sichtbar und schiesst gegen
//     Rundung; Gate-Review #3: "praktisch Rundungsschutz" - bewusst
//     drin, kostet nichts.
wClip  += (tClip  - wClip )*slewK;
hardSm += (tHard  - hardSm)*slewK;
ceilSm += (tCeil  - ceilSm)*slewK;
cl = softClip(mSig/ceilSm)*ceilSm;
cl += hardSm*(min(ceilSm, max(-ceilSm, mSig)) - cl);
cl = min(ceilSm, max(-ceilSm, cl));
mSig += wClip*(cl - mSig);

// --- OUT: Gain (Front-Regler, ersetzt slider1) + Peak/RMS-Meter
//     mit ~300 ms Release. Kein zusaetzlicher Endbegrenzer - Obere
//     Grenze ist Sache des Clippers, der Meter zeigt Overs an.
outSm += (tOutG - outSm)*slewK;
mOut = mSig*outSm;
// v0.8.2, verfeinert: der Eingang wird NUR waehrend Armed/Aufnahme
// durchgereicht (Monitoring zum Zielen) - sonst ist das Instrument
// bitgleich zu v0.8.1 (reines Kick-Signal). Slew gegen Klick beim
// Commit; auf reinen MIDI-Spuren bleibt der Eingang 0. Meter und
// Oszi messen weiterhin nur mOut.
monG += ((capSt > 0 ? 1 : 0) - monG)*slewK;
abs(monG) < 0.000000000000000001 ? monG = 0 : 0;   // Denormal-Flush
spl0 = mOut + capIn0*monG;
spl1 = mOut + capIn1*monG;
mAbs = abs(mOut);
mPeak = max(mAbs, mPeak*metRel);
mPeak < 0.000000000000000001 ? mPeak = 0 : 0;   // Denormal-Flush
// RMS als symmetrischer Einpol-Integrator ueber x^2 (asymmetrisch
// wuerde sich bei Wechselanteilen ueber den Sollwert aufladen)
mRms += metRms*(mAbs*mAbs - mRms);
mRms < 0.000000000000000001 ? mRms = 0 : 0;     // Denormal-Flush

// Oszi (jedes 2. Sample reicht bei gfx_hz = 45)
scopeDiv ? (
  M_SCOPE[scopePos] = mOut;
  scopePos += 1;
  scopePos >= 512 ? ( scopePos = 0; );
);
scopeDiv = 1 - scopeDiv;

// Blockposition erst hier weiterschalten: solange Sample n laeuft,
// steht smplPos auf n und Event-Offsets stimmen sample-genau.
smplPos += 1;

/* ============================================================
   @gfx — Geraetefront nach dem Tim-Techlor-Designkit
   Core Black als Grund, Acid Green als einzige Akzentfarbe,
   Core White fuer Zeiger. Gezeichnet wird im 900 x 560-Raster,
   SC skaliert auf die Fenstergroesse.

   Vergabene Drag-IDs (dragId), Registry PLAN.md § 4.2:
     1..7    Master-Fader (M4): 1 CUT / 2 RES / 3 BEEF (Filter),
             4 BEEF / 5 GLUE (Drive), 6 CEIL (Clip), 7 GAIN (Out)
     8       DETECT ROOT-Button (M5) - Klick-One-Shot, kein Drag
     9       KEYTRACK-Toggle    (M5) - Klick-One-Shot, kein Drag
     10..15  Master-Reserve     (M4)
     20..22  Startflagge Segment 0..2         (M2)
     23..25  Endflagge  Segment 0..2          (M2)
     26..28  Crossfade-Austritt Segment 0..2  (26/27 = Grenzen 1->2,
             2->3, 28 = Endfade auf TAIL)     (M2)
     29..30  Crossfade-Eintritt Lane 1..2     (M2)
     31..33  Gain-Fader Segment 0..2          (M2)
     34..39  Segment-Reserve                  (M2)
     50..52  Lane-Interaktion (50+s = Lane s: Auswahl, Pan-Drag;
             Loslassen ohne Bewegung = Audition)
     53      SWING-Fader im Player-Panel      (M5)
     54..60  Player-Reserve                   (M5)
     70..79  System-Reserve                   (M6)
             v1.0.0 (Wellenansicht): 70..72 END-Flagge Lane 0..2, 73/74 Grenz-
             Raute vor Lane 1/2, 75 End-Raute (Kettenansichten WAVE und FUSION
             EXPAND), 76 Uebersichtsleiste WAVE, 77 Klick/Zug in die Kettenwelle
     80..82  Rollbalken des Lane-Zooms Lane 0..2 (23.10.2026)
   Die M6-Bedienelemente (Preset-Stepper/-Box, UNDO, MAIN|SYS und
   die Werks-Preset-Reihe) sind reine Klicks via btn()/inBox() und
   belegen KEINE Drag-IDs - Reserve bleibt Reserve.
   v0.9.1: EXPERT, M und S sind ebenfalls reine Klicks; die EXPERT-Potis
   belegen KEINE Drag-ID, sondern haben eigenen Zustand (kbDrag/kbY0/kbN0,
   Hit-Logik bei knob()) - die Registry bleibt unveraendert.
   ============================================================ */
@gfx 1125 875

/* ============================================================
   v0.12.0 (P21): Front auf das gemeinsame UI-Kit v2 umgestellt
   (_shared/tt-uikit.jsfx-inc, UKIT_VER 2, in @init gespleisst):
   uikit_begin liefert Massstab/Maus/Fonts (Slots 1..5) und die
   Maus-Kanten, uikit_ground2 den gecachten Grund mit Verlauf +
   Vignette, panel2 die Panels mit Titelzeile, knob2/hslider/
   toggle/combo die Bedien-Widgets. Kopfzeile wie die Drum-Synth-Familie
   (Wortmarke, Untertitel, Preset-Leiste + OPTIONS oben rechts,
   Schrauben in den Ecken). Alle Bedienfunktionen und Drag-IDs
   sind unveraendert; neu belegte Kit-IDs: 10 = CLIP MODE (Combo)
   und 11 = RATE (Combo) aus der Master-Reserve 10..15.
   ============================================================ */

// v0.12.3 (P23): echte Maus VOR den Masken von tth_pre/tt_pb_pre merken (Position des Tooltip-Panels, Tooltips der Leiste/des OPTIONS-Buttons)
kkRmx = mouse_x; kkRmy = mouse_y;

// Review kick-R017: Frame-Herzschlag + Sample-Scan im UI-Thread. Der @block vergibt scOwn = 1 an
// diesen Thread, solange gfxBeat schlaegt; scOwn == 2 (Fenster zu) laesst die Front aussen vor.
gfxBeat += 1;
scPh == 1 && scOwn == 1 && !detHold ? scanStep();
// v0.10.0 (P14): Options-Box - Maus maskieren, solange sie offen ist; Schema aus dem Slider
tth_pre(); tt_pb_pre(); tth_sync(slider65);   // v0.11.0 (P17): Preset-Leiste maskiert die Maus wie die OPTIONS-Box
// nur noch den OPTIONS-Schalter tth_tipoff; PG_TIPS wird nur noch in @serialize gelesen (Abbildung) und geschrieben.

// ---------- Freigaben VOR uikit_begin ----------
// uikit_begin setzt dragId auf -1, sobald keine Maustaste haengt - die
// Loslass-Logik (Lane-Audition, Undo-Commit) liest dragId deshalb vorher.
relLmb = mouse_cap & 1;
// Lane-Klick (50+s): Audition erst beim Loslassen ohne Bewegung -
// ein Pan-Drag darf nicht zuerst feuern und dann schieben.
!relLmb && dragId >= 50 && dragId <= 52 ? (
  !dragMv ? ( audReq = dragId - 50 + 1; ) : 0;
) : 0;
// v1.0.0 (Wellenansicht): Klick in die Welle (WAVE-Seite, FUSION EXPAND) ohne Bewegung = ganze Kick spielen
!relLmb && dragId == 77 && !dragMv ? ( kickReq = 1; wvKickN += 1; ) : 0;   // wvKickN: Zaehler fuer den Test (Q 32)
!relLmb && lmbPrev ? undoCommit() : 0;   // Drag-Ende -> Push
!relLmb ? ( dragMv = 0; );               // dragId selbst raeumt uikit_begin weg
!relLmb ? ( kbDrag = -1; );              // v0.9.1: Poti losgelassen

// P26 (Schriftstufen): die Front hat feste Zeilen. Nachgemessen (p26_fontcheck.py, Segoe UI/Consolas/Zilap Orion, alle
// Lane-Zustaende mit/ohne EXPERT) ist sie nach den P26-Korrekturen von FONT SIZE -4 bis +2 ueberlappungsfrei, ab +3 laufen
// Texte in Nachbarn (bei +8 rund 120 Stellen). Deshalb zeichnet diese Front hoechstens mit Stufe +2: seit 0.13.2 (P26-Abschluss 5b)
// ueber die Produkt-Obergrenze des Kits, uk_fsmax = 2 (UI-Kit v6, wirksame Stufen uk_e1/uk_e2 in uikit_begin). Der gespeicherte Stil
// (tth_f1sz/tth_f2sz), die OPTIONS-Anzeige und Undo sehen weiter den eingestellten Wert; OPTIONS-Box und Preset-Leiste folgen der
// gewaehlten Stufe, Kit-Widgets und Tooltips der Kappung. Groesser: OPTIONS > UI SIZE. uk_fsmax = 0 (oder die Zeile entfernen) = keine Kappung.
//   uikit_begin(900, 700); tth_f1sz = kkF1u; tth_f2sz = kkF2u;   (Stufen NUR fuer uikit_begin gekappt, danach zurueckgeschrieben; Kit 5 ohne uk_fsmax)
uk_fsmax = 2;                            // P26 (5b): Schriftstufen-Obergrenze des Kits (FONT 1 und FONT 2 <= +2)
uikit_begin(900, 700);                   // Massstab, Fonts, Maus-Kanten (Kit)
uikit_ground2();                         // v2: Grund mit Verlauf + Vignette (Bildpuffer-Cache)
// v1.0.0 (Wellenansicht): vorderen Vorschau-Puffer fuer diesen Frame festhalten (der Audio-Thread schreibt nur den
// hinteren), Segmentfarben aus dem Akzent ableiten, Lupe-Rechteck zuruecksetzen (setzt nur die WAVE-Seite).
wvFr = wvFront; wvMb = WV_META + wvFr*64; wvOk = wvMb[0] > 0.5;
wvColsUpd();
wvLpW = 0;

// v0.9.5: Lane-Preset-Menue offen -> dieser Klick ist modal. Treffer in der
// Liste = Auswahl uebernehmen (Index aus der Y-Position), sonst nur schliessen.
// Der Klick wird geschluckt (uiClick = 0), damit dahinterliegende Kontrollen
// nicht doppelt feuern. Drags laufen weiter (nur uiClick ist geschluckt).
// P25 (Review A3): das Rad nur schlucken, solange das Menue offen ist (P22 wollte genau das, schrieb die Zeile
// aber ohne Bedingung - seit v0.12.2 war das Mausrad in der ganzen Front tot). Unverbrauchtes Rad verwirft
// uikit_end am Frameende (kein Stau).
lpMenu > 0 ? ( mouse_wheel = 0; );
// P25: Mausrad-Klammer fuer das eigene Undo. Ein Rad-Edit (Kit-Regler, Combos, Lane-Preset-Stepper, EXPERT-Potis)
// hat keine Klickflanke - ohne Klammer landete er weder im eigenen Undo noch beim Host. Mark hier, Commit am Ende
// der Front (undoCommit schreibt nur bei echtem Unterschied; Zoom/Skew/Pan sind aus dem Diff ausgenommen). Nur
// ohne gedrueckte Taste (sonst laeuft schon die Klick-Klammer) und nur in Frames mit Rad - kein Pfad je Frame.
kkWhUnd = mouse_wheel != 0 && !relLmb;
kkWhUnd ? undoMark() : 0;
lpMenu > 0 && uiClick ? (
  // P25: der Auswahl-Klick bekommt eine eigene Undo-Klammer. Er wird unten geschluckt (uiClick = 0), die
  // allgemeine Klammer "uiClick ? undoMark()" sah ihn deshalb nie - ein Lane-Preset aus der Liste war entgegen dem
  // Tooltip nicht per UNDO rueckgaengig zu machen. Commit wie immer beim Loslassen.
  undoMark();
  inBox(lpMX, lpMY, lpMW, lpMH) ? (
    lpPick = floor((mY - lpMY - 24)/17);
    lpPick >= 0 && lpPick <= LP_N ? laneApply(lpMenu - 1, lpPick) : 0;
  ) : 0;
  lpMenu = 0;
  uiClick = 0;
) : 0;
// Undo-Klammer (M6): JEDER Klick markiert den Ist-Zustand
// (Pending-Snapshot, 224 Worte); beim Loslassen entscheidet der
// Diff, ob ein Ring-Eintrag entsteht. So pushen Drags genau einmal
// (Drag-Ende) und unveraenderte Klicks gar nicht. undoPop() und
// applyPatch() disarmen/markieren selbst innerhalb der Klammer.
uiClick ? undoMark() : 0;

trigLed *= 0.90;
pgb = M_GEN;
strcpy(#tTipTxt, "");     // v0.9.0: Hover-Text pro Frame neu sammeln (tip())

// ---------- Kopf (v2-Optik wie die Drum-Synth-Familie) ----------
screw(8, 10); screw(892, 10); screw(8, 690); screw(892, 690);
gfx_setfont(1);
colWhite(0.96);
xstr(18, 4, APP_NAME);
gfx_measurestr(APP_NAME, hdrTW, hdrTH);
gfx_setfont(5);
// P25 (Harmonisierung Punkt 6): die Version kommt aus #tt_ver (einmal in @init gesetzt), Position und Schrift
// unveraendert.
gfx_measurestr(#tt_ver, hdrVW, hdrVH);
colInk(0.9);
gfx_x = OX + 22*SC + hdrTW;
gfx_y = OY + 24*SC;
gfx_drawstr(#tt_ver);

gfx_setfont(5);
colDim(1);
// P26 (Schriftstufen, p26_fontcheck.py): kuerzer (46 Zeichen erreichten ab +2 die Preset-Leiste bei 350); "KICK" steht im
// Wordmark.
xstr(20, 44, "SEGMENT FUSION // TIM TECHLOR");

// Trig-Anzeige + letzte Note
colInk(1); xstr(640, 12, "TRIG");
kTb(0.11, 0.13, 0.11, 1); xrect(676, 12, 64, 8);
gfx_set(accR*trigLed, accG*trigLed, accB*trigLed, 1);
trigLed > 0.01 ? xrect(677, 13, 62*trigLed, 6) : 0;
trigNote >= 0 ? (
  noteStr(trigNote);
  colAcid(1); xstr(748, 10, #vstr);
) : 0;
// Quelle des letzten Triggers
gfx_setfont(3); colInk(0.9);
trigSrc == 1 ? xstr(748, 26, "MIDI") : trigSrc == 2 ? xstr(748, 26, "PLAYER") : trigSrc == 3 ? xstr(748, 26, "LANE") : 0;
// Keytrack-aus-Indikator (M5): wenn aus, klingt jede Note wie ROOT
M_GEN[PG_KTRK] < 0.5 ? ( gfx_setfont(5); colInk(0.9); xstr(640, 26, "KTRK OFF"); ) : 0;

// Kit-Status rechts oben
kitN = 0;
gi = 0;
loop(3, qmt = M_GEN + 32 + gi*16; qmt[SM_FLAG] == 1 ? kitN += 1 : 0; gi += 1; );
gfx_setfont(3);
colInk(1); sprintf(#vstr, "KIT %d/3", kitN);
xstr(826, 12, #vstr);
kitN < 3 ? ( colInk(0.7); xstr(826, 26, "LOAD KIT.LUA"); ) : 0;
// v0.12.3 (P23): Tooltips der reinen Anzeigen im Kopf (TRIG-LED mit Note/Quelle, KTRK-OFF-Hinweis, Kit-Status)
tipAt(638, 8, 154, 30, "TRIG: lights on every kick - from MIDI, the player or a lane click|Right of it: the last trigger note and its source");
M_GEN[PG_KTRK] < 0.5 ? tipAt(638, 24, 56, 12, "KTRK OFF: keytrack is off, every note sounds at the ROOT pitch|Switch it back on in the PLAYER panel");
// P26: Kit je Instanz - der Tooltip sagt, welche Instanz ein Lader trifft.
tipAt(822, 8, 70, 32, "KIT: how many of the 3 sample slots hold a WAV|Synth lanes need no kit - TT-KICK Load Kit.lua loads into the focused TT-KICK window,|else into the first TT-KICK on the selected track");

// ---------- Kopf: UNDO + Seitenwechsel (M6) ----------
// v0.11.0 (P17): Der alte Werks-Preset-Stepper (PRESET < NAME > mit Klick auf die SYS-Seite, (300..528, 8))
// ist durch die gemeinsame Preset-Leiste ersetzt (Zeile 2, links neben OPTIONS, s. u.).
//   btn(510, 8, 18, 18, 0, ">") ? applyPatch((pset + 1) % 45); Namensbox 374..506 mit psetName + "*".
pset = floor(pgb[PG_PSET] + 0.5);
gfx_setfont(2);

undN = M_TOP[1];
// v0.11.0: UNDO rueckt an die Stelle des alten Steppers
btn(352, 8, 64, 18, undN > 0, "UNDO") ? undoPop();
tipAt(352, 8, 64, 18, "UNDO: step back one edit (20 states)|Drags and button edits count as one step each");

// Seitenwechsel MAIN|SYSTEM (PHALYX-Tab-Muster, zwei Zustaende)
// v1.0.0 (Wellenansicht): vierter Reiter WAVE; MAIN/SYS/EXPERT ruecken zusammen (Kit-btn passt den Text ein).
//           btn(756, 42, 58, 16, pgb[PG_PAGE] > 0.5, "SYS")  ? ( pgb[PG_PAGE] = 1; );
//           EXPERT sass bei (820, 42, 64, 16), die Tooltips von MAIN/SYS/EXPERT bei 692/756/820.
btn(686, 42, 46, 16, pgb[PG_PAGE] < 0.5, "MAIN") ? ( pgb[PG_PAGE] = 0; );
btn(736, 42, 46, 16, pgb[PG_PAGE] > 1.5, "WAVE") ? ( pgb[PG_PAGE] = 2; );
btn(786, 42, 40, 16, pgb[PG_PAGE] > 0.5 && pgb[PG_PAGE] < 1.5, "SYS")  ? ( pgb[PG_PAGE] = 1; );
// v0.9.1: EXPERT (PG_EXP, serialisiert): Poti-Reihe unter jeder Lane.
// STRG+Klick = Default (aus). Reiner Klick, keine Drag-ID.
btn(830, 42, 54, 16, pgb[PG_EXP] > 0.5, "EXPERT")
  ? ( (mouse_cap & 4) ? ( pgb[PG_EXP] = ctlDef(210); ) : ( pgb[PG_EXP] = 1 - pgb[PG_EXP]; ); );
expOn = pgb[PG_EXP] > 0.5;
tipAt(830, 42, 54, 16, "EXPERT: knob row under each lane (engine, PITCH, LEN, XF, lane filter)|Compact view when off - saved with the project|CTRL+click: reset");
tipAt(686, 42, 46, 16, "MAIN: lanes, player and master rack");
tipAt(736, 42, 46, 16, "WAVE: the whole kick on one time line - S1, S2 and S3 in colour|Drag lengths and crossfades in the wave, zoom with the wheel, edit the selected lane below");
tipAt(786, 42, 40, 16, "SYS: presets, undo, status and TOOLTIPS switch");

colDim(1); xline(0, 66, UI_W, 66);
colAcid(1); xrect(0, 66, 232, 1);

// ---------- Capture-Nachlauf (v0.8.2) ----------
// Frisch aufgenommene Lanes: Peak-Cache hier rechnen (unabhaengig von der
// Seite - die FUSION-Zeile liest ihn ebenfalls). Blink-Takt der Anzeige:
// Frame-Zaehler statt Uhr (45 gfx_hz -> Phase alle 10 Frames = ~0,22 s).
cgi = 0;
loop(3,
  cmt = M_GEN + 32 + cgi*16;
  cmt[SM_PKD] > 0.5 && cmt[SM_FLAG] == 1 ? capPeaksG(cgi);
  cgi += 1;
);
capBlink += 1;
capBlkOn = floor(capBlink/10) & 1;

// ---------- Segment-Lanes (nur Seite 0) ----------
// v1.0.0 (Wellenansicht): MAIN (0) und WAVE (2) teilen die rechte Spalte (Player, Master, Scope) und die Lane-Preset-Liste;
// links zeichnet MAIN die Lanes und FUSION, WAVE die ganze Kick.
pgb[PG_PAGE] < 0.5 || pgb[PG_PAGE] > 1.5 ? (
// v0.8.0: Kettenlayout der FUSION-Zeile + DUR-Werte je Lane einmal
// pro Frame berechnen (Spiegel von trigKick, nur Anzeige)
fusBuild();
// v1.0.0 (Wellenansicht): FUSION-Ansicht (PG_WVUI Bit 6 STACK, Bit 7 EXPAND) einmal je Frame festhalten
fuExpF = wvUi(7, 1); fuStkF = wvUi(6, 1);
pgb[PG_PAGE] < 0.5 ? (
// v0.9.2: Lane-Ansicht einmal pro Frame einfrieren (mxL) - ein Klick auf
// MAX/Streifen schreibt maxLane und wirkt ab dem naechsten Frame, alle drei
// Lanes eines Frames rechnen also mit derselben Geometrie. laneY = Oberkante
// der laufenden Lane (Kette: Streifen 26, normal 149, maximiert 395, Abstand 8).
mxL = maxLane;
laneY = LN_Y0;
// v1.0.0 (Wellenansicht): bei FUSION EXPAND liegt FUSION ueber dem Lane-Bereich - die Lanes werden dann nicht gezeichnet.
!fuExpF ? (
s = 0;
loop(3,
  // Lanehoehe 149, Raster 157; maximiert 395 / Streifen 26 (siehe LN_* oben).
  isMax = mxL == s;
  isCol = mxL >= 0 && !isMax;
  lnH = isMax ? LN_MAXH : isCol ? LN_STR : LN_H;
  ly = laneY;
  laneY += lnH + LN_GAP;
  sm = M_SEG + s*64;
  // gmt statt mt (Finding 4): @gfx teilt sonst ein Global mit dem
  // Slot-Reset-Loop im @block/@init - Audio-Pfad unangetastet.
  gmt = M_GEN + 32 + s*16;
  // v0.12.0 (P21): panel2 mit Titelzeile (Schatten, Verlauf, Bevel) - der
  // Lane-Titel bleibt manuell (farbig je MUTE-Zustand), die Kopfleisten-
  // Bedienelemente ruecken auf ly + 3 (die Titel-Trennlinie liegt bei ly + 20).
  panel2(16, ly, 620, lnH, "");
  // Auswahlrahmen (Editor-Ziel)
  pgb[PG_SEGSEL] == s ? ( colAcid(0.55); xrect(16, ly, 620, 2); xrect(16, ly + lnH - 2, 620, 2); ) : 0;
  // Streifen-Tooltip ZUERST: die Tooltips der Knoepfe darunter kommen spaeter
  // und ueberschreiben ihn (tip() nimmt den letzten Treffer).
  isCol ? tipAt(16, ly, 620, lnH, "Restore/switch to this lane|Click: maximize this lane, the others stay collapsed");

  gfx_setfont(3);
  laneOnG(s) ? colAcid(1) : colInk(0.45);     // v0.9.1: von M/S ausgeschlossen = gedimmt
  s == 0 ? xstr(28, ly + 6, "S1  TRANSIENT")
  : s == 1 ? xstr(28, ly + 6, "S2  BODY")
  : xstr(28, ly + 6, "S3  TAIL");
  // v0.12.3 (P23): Lane-Titel erklaert die Rolle (Soll-Bereiche wie durLabel); auf dem Streifen gilt der Streifen-Tooltip
  !isCol ? tipAt(28, ly + 4, 96, 16,
      s == 0 ? "S1 TRANSIENT: the click at the start of the kick, recommended 0-30 ms|The three lanes play one after another and crossfade"
    : s == 1 ? "S2 BODY: the pitched body of the kick, recommended 5-150 ms|The three lanes play one after another and crossfade"
    : "S3 TAIL: the decaying tail of the kick, recommended 10-1500 ms|The three lanes play one after another and crossfade") : 0;
  // MUTE / SOLO (v0.9.1): in der Kopfzeile der Lane - die Knopfzeile bei
  // ly + 56 ist mit REV/CAP/RAND voll. Reine Klicks (keine Drag-ID);
  // STRG+Klick setzt den Default (aus). SOLO leuchtet warn-orange.
  btn(128, ly + 3, 22, 16, sm[SG_MUTE] > 0.5, "M")
    ? ( (mouse_cap & 4) ? ( sm[SG_MUTE] = ctlDef(118); ) : ( sm[SG_MUTE] = 1 - sm[SG_MUTE]; ); );
  // SOLO faerbt den Akzent fuer den Aufruf auf die Warnfarbe um (der Kit-btn kennt nur den Akzent).
  // Review 14.10.2026 (Kit 7, Codex F1): Sichern und Zuruecksetzen haengen am Zustand VOR dem Klick (kkSoW). Vorher pruefte die
  // Ruecksetzung den schon umgeschalteten Zustand: Einschalten setzte den Akzent auf alte/leere swAc*, Ausschalten liess die
  // Warnfarbe stehen (bis zum naechsten Schemawechsel).
  kkSoW = sm[SG_SOLO] > 0.5;
  kkSoW ? ( swAcR = accR; swAcG = accG; swAcB = accB;
            accR = tth_alR; accG = tth_alG; accB = tth_alB; ) : 0;
  btn(154, ly + 3, 22, 16, sm[SG_SOLO] > 0.5, "S")
    ? ( (mouse_cap & 4) ? ( sm[SG_SOLO] = ctlDef(119); ) : ( sm[SG_SOLO] = 1 - sm[SG_SOLO]; ); );
  kkSoW ? ( accR = swAcR; accG = swAcG; accB = swAcB; ) : 0;
  tipAt(128, ly + 3, 22, 16, "MUTE: take this lane out of the kick chain|The chain closes without it - CAP and lane audition still work|CTRL+click: reset");
  tipAt(154, ly + 3, 22, 16, "SOLO: only soloed lanes play in the kick chain|The others drop out like muted lanes|CTRL+click: reset");
  // MAX (v0.9.2): maximiert diese Lane bzw. (auf der maximierten Lane) zurueck
  // zur Dreier-Ansicht; auf einem Streifen schaltet der Knopf auf diese Lane
  // um. Reiner Klick (btn, keine Drag-ID), maxLane ist reine Ansicht.
  gfx_setfont(3);
  btn(182, ly + 3, 34, 16, isMax, "MAX")
    ? ( maxLane = isMax ? -1 : s; pgb[PG_SEGSEL] = s; );
  tipAt(182, ly + 3, 34, 16, isMax ? "MAX: back to the three-lane view" : "Maximize this lane for detailed editing|The other two lanes collapse to strips");
  // v1.0.0 (Wellenansicht, Konzept A): Anzeige der Wellen-Box ENV / WAVE / BOTH (PG_WVUI Bits 2s..2s+1, reine Ansicht).
  // ENV = Huellkurven wie bisher, WAVE = die gerechnete Welle der Lane, BOTH = beides uebereinander (Vorgabe).
  lvM = wvUi(s*2, 3);
  !isCol ? (
    gfx_setfont(5);
    btn(322, ly + 3, 30, 16, lvM == 2, "ENV") ? wvUiSet(s*2, 3, 2);
    btn(354, ly + 3, 34, 16, lvM == 1, "WAVE") ? wvUiSet(s*2, 3, 1);
    btn(390, ly + 3, 32, 16, lvM == 0, "BOTH") ? wvUiSet(s*2, 3, 0);
    tipAt(322, ly + 3, 30, 16, "ENV: show the pitch and level curves of this lane (SYNTH) or the sample (SAMPLE)");
    tipAt(354, ly + 3, 34, 16, "WAVE: show the rendered wave of this lane, as it sounds in the kick|Before the master section, at velocity 127");
    tipAt(390, ly + 3, 32, 16, "BOTH: the rendered wave with the curves on top|Saved per instance");
  ) : 0;
  // ---------- Lane-Preset-Browser (v0.9.5): < INIT/BANK-NAME > je Lane.
  // Sandbox: laneApply setzt nur die 16 Klang-Parameter (MODE=0), Start-
  // fenster/Ansicht/MUTE/SOLO bleiben. Eintraege im Labor QA-gruen
  // (tt-kick_lanebank.py, 42/42). Klick auf den Namen = Liste (Overlay),
  // CTRL+Klick = Lane auf INIT, Mausrad = steppen.
  lpIdx  = floor(sm[SG_LP] + 0.5);
  // P25 (Review A10): Toleranz 0,01 statt 0,0001. SG_LPS wird als float32 serialisiert; Summen um 2000..8000
  // runden dort auf Schritte bis 4,9e-4 (bis 32768: 2e-3) - 47 der 177 Lane-Zustaende zeigten nach Speichern/Laden
  // faelschlich einen "*". Jede Parameteraenderung um >= 1 Einheit verschiebt die Summe um >= 1 (Gewichte 1..1,49),
  // Rundungsrauschen bleibt weit darunter. Rechenprobe: p25_orakel.py A10.
  lpStar = abs(chkLane(s) - sm[SG_LPS]) > 0.01;
  lpName(s, lpIdx);
  isCol ? (
    gfx_setfont(5);
    btn(290, ly + 3, 16, 16, 0, "<") ? laneApply(s, (lpIdx + LP_N) % (LP_N + 1));
    tipAt(290, ly + 3, 16, 16, "LANE PRESET <: previous lane preset|Steps this lane's own bank (undoable)");
    btn(434, ly + 3, 16, 16, 0, ">") ? laneApply(s, (lpIdx + 1) % (LP_N + 1));
    tipAt(434, ly + 3, 16, 16, "LANE PRESET >: next lane preset|Steps this lane's own bank (undoable)");
    lpBoxX = 310; lpBoxW = 120;
  ) : (
    gfx_setfont(2);
    btn(424, ly + 3, 16, 16, 0, "<") ? laneApply(s, (lpIdx + LP_N) % (LP_N + 1));
    tipAt(424, ly + 3, 16, 16, "LANE PRESET <: previous lane preset|Steps this lane's own bank (undoable)");
    btn(600, ly + 3, 16, 16, 0, ">") ? laneApply(s, (lpIdx + 1) % (LP_N + 1));
    tipAt(600, ly + 3, 16, 16, "LANE PRESET >: next lane preset|Steps this lane's own bank (undoable)");
    lpBoxX = 444; lpBoxW = 152;
  );
  lpHot = inBox(lpBoxX, ly + 3, lpBoxW, 16);
  lpHot && uiClick ? (
    mouse_cap & 4 ? laneReset(s) : (
      lpMenu = s + 1;
      lpMW = 170;
      lpMH = 24 + (LP_N + 1)*17 + 6;
      lpMX = 444;
      lpMY = min(ly + 23, 700 - lpMH - 6);
    );
  );
  // Scroll-Step ("click again"-Prinzip, XO): Rad ueber der Box steppt.
  // mouse_wheel = 0 danach, damit der Zoom der Wellen-Box nicht doppelt zieht.
  lpHot && mouse_wheel != 0 ? (
    laneApply(s, (lpIdx + (mouse_wheel > 0 ? LP_N : 1)) % (LP_N + 1));
    mouse_wheel = 0;
  );
  lpHot ? tth_tn(0.10, 0.14, 0.09, 1) : gfx_set(tth_pnR, tth_pnG, tth_pnB, 1);
  xrect(lpBoxX, ly + 3, lpBoxW, 16);
  gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  xrect(lpBoxX, ly + 3, lpBoxW, 1); xrect(lpBoxX, ly + 19, lpBoxW, 1);
  xrect(lpBoxX, ly + 3, 1, 16); xrect(lpBoxX + lpBoxW - 1, ly + 3, 1, 16);
  !isCol ? (
    // Index "5/14" links innen (Orientierung beim Steppen), Name daneben
    gfx_setfont(5); colInk(0.7);
    sprintf(#vstr, "%d/%d", lpIdx, LP_N);
    xstr(lpBoxX + 5, ly + 6, #vstr);
  ) : 0;
  lpStar ? colInk(1) : colAcid(1);
  !isCol ? xctr(lpBoxX + 26, ly + 3, lpBoxW - 34, 16, #lpstr)
         : xctr(lpBoxX, ly + 3, lpBoxW, 16, #lpstr);
  !isCol && lpStar ? ( gfx_setfont(5); colInk(1); xstr(lpBoxX + lpBoxW - 9, ly + 6, "*"); ) : 0;
  sprintf(#psTip, "Lane preset: %s%s|Click: list this lane's bank - wheel: step - CTRL+click: reset lane|Sets the lane's 16 engine params only (sample window, view, MUTE/SOLO stay)",
    #lpstr, lpStar ? " *" : "");
  tipAt(lpBoxX, ly + 3, lpBoxW, 16, #psTip);
  // Kompaktansicht: ein aktiver Lane-Filter ist sonst unsichtbar
  // (v0.9.2: x 186 -> 226, der MAX-Knopf sitzt jetzt davor)
  !isCol && !expOn && (sm[SG_FCUT] < 999.5 || sm[SG_FRES] > 0.5) ? (
    gfx_setfont(5); colWarn(0.85);
    // P26 (Schriftstufen, p26_fontcheck.py): kuerzer - "LANE FILTER ACTIVE - SEE EXPERT" lief schon bei Stufe 0 6 Einheiten in den
    // Lane-Preset-Browser (<  bei 424).
    // v1.0.0 (Wellenansicht): kuerzer, ab x 322 sitzt der Schalter ENV / WAVE / BOTH.
    xstr(226, ly + 6, "FILTER ON");
    tipAt(226, ly + 4, 92, 14, "LANE FILTER ACTIVE: this lane's CUT / RES are away from the bypass position|Switch EXPERT on to see or reset them");
  ) : 0;
  // "10 ms-1.5 s" (colInk(0.8), ly + 116) sind in die farbige
  // DUR-Zeile (durLabel, unten) aufgegangen.

  // v0.9.2: Streifen (die Lane ist eingeklappt): Kurzinfo + Klick = diese
  // Lane maximieren. Der Klick zaehlt nur ausserhalb von M / S / MAX
  // (x 126..218), die Knoepfe behalten ihre eigenen Klicks.
  isCol ? (
    gfx_setfont(5); colInk(0.7);
    sm[SG_MODE] == 0 ? xstr(226, ly + 6, "SYNTH") : xstr(226, ly + 6, "SAMPLE");
    // P26 (Schriftstufen, p26_fontcheck.py): linke Grenze 456 (hinter dem Browser-">" 434..450) statt 290: der REC-Zusatz faellt weg,
    // bevor DUR in den Browser laeuft (ab Stufe +1 sonst bis 14 Einheiten).
    durLabel(628, 456, ly + 6, s);
    uiClick && inBox(16, ly, 620, lnH) && !inBox(126, ly + 3, 92, 20) && !inBox(284, ly + 3, 172, 20)
      ? ( maxLane = s; pgb[PG_SEGSEL] = s; ) : 0;
  ) : (

  // v0.9.2: Positionen der Bedienelemente. Normal: Spalte links (x 28..164).
  // Maximiert: Werkzeugleiste ueber der Box (ly + 28), die Box nimmt dann die
  // volle Breite (x 28..624).
  mdY  = isMax ? ly + 28 : ly + 34;
  rcX0 = isMax ? 176 : 28;
  rcX1 = isMax ? 226 : 78;
  rcX2 = isMax ? 276 : 128;
  rcY  = isMax ? ly + 29 : ly + 64;
  gLx  = isMax ? 330 : 28;
  gx0  = isMax ? 362 : 58;
  gy0  = isMax ? ly + 31 : ly + 94;
  // v0.9.2: normal 78 statt 86 px - der Wert ("100%") endet sonst ~5 px in der
  // Wellen-Box (x 170); maximiert bleibt 86
  // P26 (Schriftstufen, p26_fontcheck.py): normal 78 -> 76 und der Wert 4 statt 5 hinter dem Regler: "200%" erreichte ab +2 die
  // Wellen-Box (x 170).
  gw0  = isMax ? 86 : 76;

  // SYNTH|SAMPLE-Umschalter
  gfx_setfont(2);
  btn(28, mdY, 60, 18, sm[SG_MODE] == 0, "SYNTH") ? ( sm[SG_MODE] = 0; );
  btn(96, mdY, 66, 18, sm[SG_MODE] == 1, "SAMPLE") ? ( sm[SG_MODE] = 1; );
  tipAt(28, mdY, 60, 18, "SYNTH: this lane renders the built-in engine|No sample needed");
  tipAt(96, mdY, 66, 18, "SAMPLE: this lane plays a loaded or captured WAV|Assign files with TT-KICK Load Kit.lua");

  // REV-Toggle + Gain-Mini-Fader (DragID 31+s)
  btn(rcX0, rcY, 44, 16, sm[SG_REV] > 0.5, "REV") ? ( sm[SG_REV] = 1 - sm[SG_REV]; );
  tipAt(rcX0, rcY, 44, 16, "REV: play the lane window backwards");
  // CAP (v0.8.2): Live-Aufnahme in den Slot dieser Lane. Armed blinkt,
  // Aufnahme leuchtet dauerhaft; Klick auf die aktive Lane = Abbruch.
  // Reiner Klick (btn), keine Drag-ID - die Anforderung geht ueber capReq
  // in den @block. Ohne erreichbare CAP-Region (capOk = 0): gesperrt.
  btn(rcX1, rcY, 44, 16,
      capSt > 0 && capLane == s && (capSt == 2 || capBlkOn),
      capOk ? "CAP" : "N/A")
    ? ( capOk ? ( capReq = s + 1; ) : 0; );
  tipAt(rcX1, rcY, 44, 16, "CAP: record the audio input into this lane's slot|VOLATILE: not saved, gone after a project reload|Click again while armed = abort");
  // RAND (v0.9.0): frische Zufallswerte in musikalischen Grenzen. Reiner
  // Klick (btn, keine Drag-ID); die Undo-Klammer kommt vom globalen
  // Klick-Mark/Commit, filesDirty bleibt unberuehrt (Pfade aendern sich
  // nicht). CTRL+Klick: Lane auf INIT.
  gfx_setfont(3);
  btn(rcX2, rcY, 36, 16, 0, "RAND")
    ? ( (mouse_cap & 4) ? laneReset(s) : randLane(s); );
  tipAt(rcX2, rcY, 36, 16, "Randomize this lane's parameters (musical ranges)|CTRL+click: reset to INIT");
  gfx_setfont(3); colInk(1); xstr(gLx, gy0 + 2, "GAIN");
  // v0.12.0 (P21): Kit-hslider statt Hand-Fader (Drag-ID 31+s unveraendert);
  // CTRL-/Rechts-/Doppelklick = Default 100 % (= ctlDef(31+s)) eingebaut,
  // Shift = fein, Rad. Skala 0..200 % -> 0..1.
  gtv = hslider(31 + s, gx0, gy0 + 1, gw0, 11, sm[SG_GAIN]*0.005, 0, 1, 0.5);
  // Review zcode 17.10.2026 (B2): Rueckschreibung nur bei echter Aenderung (Float-Roundtrip x*0.005*200 war ungenau)
  abs(gtv*200 - sm[SG_GAIN]) > 0.001 ? ( sm[SG_GAIN] = min(200, max(0, gtv*200)); );
  tipAt(gx0 - 4, gy0 - 3, gw0 + 8, 16, "GAIN: level of this lane, 0-200%|CTRL+click: reset");
  gfx_setfont(5); colInk(1); xat(gx0 + gw0 + 4, gy0 + 2);
  gfx_printf("%d%%", floor(sm[SG_GAIN] + 0.5));

  // Wellen-Box
  // v0.9.1: im EXPERT-Modus schrumpft die Wellen-Box auf 32 px und die
  // Statuszeile rueckt von ly + 92 nach ly + 61 hoch - darunter (ly + 77
  // bis ly + 121) sitzt die Poti-Reihe. Aus = Layout bitgleich zu v0.9.0.
  // v0.9.2: Box, Statuszeile und Poti-Reihe haengen an der Lanehoehe lnH:
  //   Poti-Reihe lnKT = ly + lnH - 47 (44-px-Zellen, 3 px Rand unten),
  //   Statuszeile stY = lnKT - 16 (EXPERT) bzw. ly + lnH - 35,
  //   Box endet 3 px (EXPERT) bzw. 4 px ueber der Statuszeile.
  // Normal 149: Box 84 px (EXPERT 57), Status ly + 114 (ly + 86), Potis
  // ly + 102. Maximiert 395: Box 302 px (EXPERT 275) in voller Breite.
  wgx = isMax ? 28 : 170;
  wgy = isMax ? ly + 54 : ly + 26;
  wgw = isMax ? 596 : 452;
  lnKT = ly + lnH - 47;
  stY = expOn ? lnKT - 16 : ly + lnH - 35;
  // 23.10.2026 (Lane-Zoom): Box 7 Einheiten flacher, in der Luecke darunter liegt der Rollbalken (wgy + wgh + 2, 4 hoch).
  wgh = stY - (expOn ? 3 : 4) - 7 - wgy;
  kTb(0.042, 0.048, 0.042, 1); xrect(wgx, wgy, wgw, wgh);
  gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
  xrect(wgx, wgy, wgw, 1); xrect(wgx, wgy + wgh - 1, wgw, 1);
  xrect(wgx, wgy, 1, wgh); xrect(wgx + wgw - 1, wgy, 1, wgh);

  // Geometrie: Fenster in Slot-Anteilen, Rueckrechnung ueber die
  // View (gZ_off/gZ_span aus laneView) auf Raster-Koordinaten.
  // Bei SYNTH gibt es kein Sample-Fenster - SG_START ist unbelegt,
  // die Box zeigt die Dauer-Fensterung [0, SG_LEN].
  laneView(s);
  stF  = sm[SG_MODE] == 1 ? sm[SG_START]*0.001 : 0;
  enF  = min(1, stF + sm[SG_LEN]*0.001);
  lenF = max(0.001, enF - stF);
  stX  = wgx + (stF - gZ_off)/gZ_span*wgw;
  enX  = wgx + (enF - gZ_off)/gZ_span*wgw;
  wlenS = 0; zxX = enX; zeX = stX;
  sm[SG_MODE] == 1 ? (
    gmt[SM_FLAG] == 1 ? ( segWinG(s); wlenS = gWG_LEN; ) : 0;
  ) : (
    wlenS = synthFramesG(s);     // Dauer in Output-Frames
  );
  // Crossfade-Zonen (modusunabhaengig, Fensterlaenge in Frames):
  // Austritt SG_XF[s] am Fensterende, Eintritt SG_XF[s-1] am Anfang
  wlenS > 0 ? (
    zx = min(1, sm[SG_XF]*0.001*srate/max(1, wlenS));
    zxX = wgx + (enF - zx*lenF - gZ_off)/gZ_span*wgw;
    s > 0 ? (
      // v0.9.1: Eintritt = SG_XFI der Lane selbst
      ze = min(1, sm[SG_XFI]*0.001*srate/max(1, wlenS));
      zeX = wgx + (stF + ze*lenF - gZ_off)/gZ_span*wgw;
    ) : 0;
  ) : 0;

  sm[SG_MODE] == 1 ? (
    gmt[SM_FLAG] == 1 ? (
      // v1.0.0 (Wellenansicht): ENV = Sample-Peaks wie bisher, BOTH = Peaks + gerechnete Welle im Fenster, WAVE = nur die
      // gerechnete Welle (Raster und Mittellinie wie drawWaveZ).
      lvM != 1 ? drawWaveZ(wgx + 2, wgy + 2, wgw - 4, wgh - 4, s, stF, enF)
      : (
        tth_tn(0.10, 0.13, 0.08, 1);
        xline(wgx + 2, wgy + wgh*0.5, wgx + wgw - 2, wgy + wgh*0.5);
        gmt[SM_LEN] > 0 ? drawTimeGrid(wgx + 2, wgy + 2, wgw - 4, wgh - 4, gZ_off*gmt[SM_LEN]/srate*1000, (gZ_off + gZ_span)*gmt[SM_LEN]/srate*1000) : 0;
      );
      lvM != 2 ? wvLaneWave(s, wgx, wgy, wgw, wgh, stX, enX, 0.95) : 0;
    ) : (
      tth_tn(0.10, 0.13, 0.08, 1);
      xline(wgx, wgy + wgh*0.5, wgx + wgw, wgy + wgh*0.5);
      colInk(0.85);
      gmt[SM_FLAG] == 2 ? xstr(wgx + 10, wgy + 32, "LOAD ERROR - NOT A READABLE WAV/AIFF")
      : xstr(wgx + 10, wgy + 32, "EMPTY SLOT - ASSIGN WITH TT-KICK Load Kit.lua");
    );
  ) : (
    // Synth-Vorschau (M3): f0-Verlauf + interne Huelle aus denselben
    // Parametern wie die Engine - kein Sample noetig. Die Kurve
    // sitzt im Fenster [stX..enX] und folgt damit Zoom/Pan/Flags.
    tth_tn(0.10, 0.13, 0.08, 1);
    xline(wgx, wgy + wgh*0.5, wgx + wgw, wgy + wgh*0.5);
    // v1.0.0 (Wellenansicht): WAVE/BOTH zeichnen zuerst die gerechnete Welle ins Fenster [stX, enX] (BOTH gedaempft, damit
    // die Kurven lesbar bleiben); WAVE laesst die Kurven danach weg (lvW = 0), ENV zeichnet nur die Kurven.
    lvM != 2 ? wvLaneWave(s, wgx, wgy, wgw, wgh, stX, enX, lvM == 1 ? 0.95 : 0.45) : 0;
    lvW = lvM != 1;
    f0h = max(1, sm[SG_F0]);
    f1h = max(1, sm[SG_F1]);
    fmx = max(f0h, f1h);
    pp  = synthPG(s);
    plo = max(wgx + 3, stX);
    phx = min(wgx + wgw - 4, enX);
    psp = max(1, floor(phx - plo));
    // interne Amplituden-Huelle als dimme Unterkuve
    tth_tn(0.17, 0.44, 0.12, 0.9);
    k = 0;
    // v1.0.0 (Wellenansicht): in WAVE entfallen beide Kurven (lvW = 0).
    loop(lvW ? psp + 1 : 0,
      ku = min(1, k/psp);
      evv = s == 0 ? (1 - ku)*(1 - ku)
        : s == 1 ? (1 - ku)^0.6 : (1 - ku)^0.45;
      px = plo + ku*psp;
      py = wgy + wgh - 5 - evv*(wgh - 12);
      k == 0 ? ( gfx_x = OX + px*SC; gfx_y = OY + py*SC; )
             : gfx_lineto(OX + px*SC, OY + py*SC, 1);
      k += 1;
    );
    // Frequenztrajektorie f(u) = f1 + (f0-f1)*(1-u)^p, auf fmax normiert
    colAcid(0.95);
    k = 0;
    loop(lvW ? psp + 1 : 0,                  // v1.0.0 (Wellenansicht),
      ku = min(1, k/psp);
      fh = f1h + (f0h - f1h)*(1 - ku)^pp;
      px = plo + ku*psp;
      py = wgy + wgh - 5 - (fh/fmx)*(wgh - 12);
      k == 0 ? ( gfx_x = OX + px*SC; gfx_y = OY + py*SC; )
             : gfx_lineto(OX + px*SC, OY + py*SC, 1);
      k += 1;
    );
    gfx_setfont(3); colInk(0.9);
    s == 0 ? xstr(wgx + 10, wgy + 6, "CLICK OSC + NOISE BURST")
    : s == 1 ? xstr(wgx + 10, wgy + 6, "PITCH-ENV OSCILLATOR")
    : xstr(wgx + 10, wgy + 6, "SINE + DRIFT + ROOM");
    gfx_setfont(5); colAcid(0.85);
    xat(wgx + 10, wgy + wgh - 14);
    noteStr(hzNote(sm[SG_F0])); strcpy(#kkN0, #vstr);
    noteStr(hzNote(sm[SG_F1])); strcpy(#kkN1, #vstr);
    sprintf(#kkSy, "%d>%d HZ  %s>%s  %d MS  PHASE LINK",
      floor(sm[SG_F0] + 0.5), floor(sm[SG_F1] + 0.5), #kkN0, #kkN1,
      floor(wlenS*1000/srate + 0.5));
    gfx_drawstr(#kkSy);
  );

  // Capture-Anzeige (v0.8.2): ueberdeckt die Wellen-Box dieser Lane.
  // ARMED blinkt; bei laufender Aufnahme Fortschrittsfuellung + Zeit
  // relativ zum Aufnahmelimit (8 s bzw. Bankgroesse bei sehr hohen Raten).
  capSt > 0 && capLane == s ? (
    kTb(0.042, 0.048, 0.042, 1); xrect(wgx + 1, wgy + 1, wgw - 2, wgh - 2);
    gfx_setfont(2);
    capSt == 1 ? (
      capBlkOn ? ( colAcid(1); xctr(wgx, wgy, wgw, wgh, "REC ARMED - PLAY YOUR SOURCE"); ) : 0;
    ) : (
      colAcid(0.22);
      xrect(wgx + 1, wgy + 1, (wgw - 2)*min(1, capIdx/max(1, capLim)), wgh - 2);
      colAcid(1);
      sprintf(#vstr, "CAPTURE %.1f/%.1f S", capIdx/srate, capLim/srate);
      xctr(wgx, wgy, wgw, wgh, #vstr);
    );
  ) : 0;

  // Fade-Zonen schattiert hinter den Griffen (beide Modi)
  wlenS > 0 ? (
    zx > 0.002 ? (
      zw = min(enX, wgx + wgw) - max(wgx, zxX);
      zw > 0 ? ( colAcid(0.09); xrect(max(wgx, zxX), wgy + 2, zw, wgh - 4); ) : 0;
    ) : 0;
    s > 0 ? (
      ze > 0.002 ? (
        zw = min(zeX, wgx + wgw) - max(wgx, stX);
        zw > 0 ? ( colAcid(0.09); xrect(max(wgx, stX), wgy + 2, zw, wgh - 4); ) : 0;
      ) : 0;
    ) : 0;
  ) : 0;

  // Playheads laufender Spans dieser Lane (Vorlauf: kein Zeiger) -
  // spanLane dekodiert Synth-Segmente ueber VX_INC, Sample ueber BASE
  wlenS > 0 ? (
    gvi = 0;
    // P26: VX_N Stimmen ab VX_POOL.
    loop(VX_N,
      gqv = VX_POOL + gvi*VX_STR;
      gqv[VX_ON] > 0.5 && gqv[VX_LEN] > 0 && spanLane(gqv) == s ? (
        pr = gqv[VX_POS]/gqv[VX_LEN];
        gqv[VX_RATE] < 0 ? pr = 1 - pr : 0;
        pr >= 0 && pr <= 1 ? (
          colWhite(0.55);
          px = stX + pr*(enX - stX);
          px >= wgx && px <= wgx + wgw ? (
            xline(px, wgy + 2, px, wgy + wgh - 2);
          ) : 0;
        ) : 0;
      ) : 0;
      gvi += 1;
    );
  ) : 0;

  sm[SG_MODE] == 1 && gmt[SM_FLAG] == 1 ? (
    // Zoom-Anzeige in der Boxecke
    sm[SG_ZOOM] > 0.5 || sm[SG_SKEW] > 0.5 ? (
      gfx_setfont(5); colDim(1);
      xat(wgx + wgw - 58, wgy + 4);
      gfx_printf("Z%.0f SK%.0f", 2^(sm[SG_ZOOM]*0.006), 2^(sm[SG_SKEW]*0.004));
    ) : 0;
  ) : 0;

  // --- Flaggen + Crossfade-Rauten zeichnen (mit lesbarer Fenster-
  //     laenge - bei SYNTH die Dauer; Griffe bei leerem Slot aus).
  //     Die Start-Flagge bleibt SAMPLE vorbehalten (SG_START ist bei
  //     SYNTH unbelegt), LEN-Flagge setzt dort die Fensterdauer.
  hotTop = mY >= wgy - 2 && mY < wgy + 15;      // Griffzone oben
  flagsOk = wlenS > 0;
  flagsOk && sm[SG_MODE] == 1 && stX >= wgx - 4 && stX <= wgx + wgw + 4 ? (
    dragId == 20 + s || (abs(mX - stX) < 4 && inBox(wgx, wgy, wgw, wgh))
      ? colAcid(1) : tth_tn(0.20, 0.52, 0.14, 1);
    xline(stX, wgy, stX, wgy + wgh);
    xrect(stX - 3, wgy, 7, 4);
  ) : 0;
  flagsOk && enX >= wgx - 4 && enX <= wgx + wgw + 4 ? (
    dragId == 23 + s || (abs(mX - enX) < 4 && inBox(wgx, wgy, wgw, wgh))
      ? colAcid(1) : tth_tn(0.20, 0.52, 0.14, 1);
    xline(enX, wgy, enX, wgy + wgh);
    xrect(enX - 3, wgy, 7, 4);
  ) : 0;
  // Austritts-Raute: Fadezone beginnt bei zxX (bei XF 0 auf dem Flag)
  flagsOk && zxX >= wgx - 6 && zxX <= wgx + wgw + 6 ? (
    xfMark(zxX, wgy + 7, dragId == 26 + s || (hotTop && abs(mX - zxX) < 6));
  ) : 0;
  // Eintritts-Raute auf Lane 1+2 (Grenze s-1 -> s, Param SG_XF[s-1])
  flagsOk && s > 0 && zeX >= wgx - 6 && zeX <= wgx + wgw + 6 ? (
    xfMark(zeX, wgy + 7, dragId == 28 + s || (hotTop && abs(mX - zeX) < 6));
  ) : 0;
  // Tooltips der Griffe - Prioritaet wie beim Klick (Rauten vor Flaggen,
  // sonst die Lane selbst). tip() schweigt waehrend eines Drags.
  inBox(wgx, wgy, wgw, wgh) ? (
    flagsOk && hotTop && abs(mX - zxX) < 6 ?
      tip("XF diamond (exit): crossfade into the next lane, 0-100 ms|Drag sideways to set the length|CTRL+click: reset")
    : flagsOk && s > 0 && hotTop && abs(mX - zeX) < 6 ?
      tip("XF diamond (entry): crossfade from the previous lane, 0-100 ms|Drag sideways to set the length|CTRL+click: reset")
    : flagsOk && sm[SG_MODE] == 1 && abs(mX - stX) < 4 ?
      tip("START flag: where the sample window begins|Drag to trim; the length stays|CTRL+click: reset")
    : flagsOk && abs(mX - enX) < 4 ?
      tip("END flag: where the lane window ends (= LEN)|Drag to trim the length|CTRL+click: reset")
    : tip("Click: audition this lane and select it|Drag the background: pan the zoomed view|Wheel: zoom - CTRL+wheel: scroll - SHIFT+wheel: skew");
  ) : 0;

  // --- Laufende Drags dieses Segments aktualisieren
  dragId == 20 + s && uiLmb && sm[SG_MODE] == 1 ? (
    nv = floor((gZ_off + (mX - wgx)/wgw*gZ_span)*1000 + 0.5);
    sm[SG_START] = min(max(0, nv), max(0, 1000 - sm[SG_LEN]));
  ) : 0;
  // P25 (Review A6): stS = Fensteranfang nur bei SAMPLE (die Anzeige rechnet bei SYNTH mit stF = 0). Vorher sprang
  // die END-Flagge einer SYNTH-Lane beim Greifen um einen veralteten SG_START, und die Dauer war auf 1000 - START
  // begrenzt.
  stS = sm[SG_MODE] == 1 ? sm[SG_START] : 0;
  dragId == 23 + s && uiLmb ? (
    nv = floor((gZ_off + (mX - wgx)/wgw*gZ_span)*1000 + 0.5);
    sm[SG_LEN] = min(max(10, nv - stS), 1000 - stS);
  ) : 0;
  dragId == 26 + s && uiLmb && wlenS > 0 ? (
    // Austritt: Abstand der Maus zum Fensterende -> Fade in ms
    nv = (enF - (gZ_off + (mX - wgx)/wgw*gZ_span))/lenF*wlenS*1000/srate;
    sm[SG_XF] = min(100, max(0, nv));
  ) : 0;
  dragId == 28 + s && uiLmb && wlenS > 0 && s > 0 ? (
    // Eintritt: Abstand der Maus zum Fensteranfang -> Fade in ms,
    // geschrieben wird SG_XFI dieser Lane
    nv = ((gZ_off + (mX - wgx)/wgw*gZ_span) - stF)/lenF*wlenS*1000/srate;
    sm[SG_XFI] = min(100, max(0, nv));
  ) : 0;
  dragId == 50 + s && uiLmb ? (
    abs(mX - dragX) > 2 ? dragMv = 1 : 0;
    dragMv ? (
      gZ_span < 0.999 ? laneScroll(s, gZ_off - (mX - dragX)/wgw*gZ_span) : 0;
      dragX = mX;
    ) : 0;
  ) : 0;

  // --- Frischer Klick in die Wellen-Box: Griffe zuerst testen
  //     (Rauten vor den Flaggen - an der Oberkante liegen sie nah
  //     zusammen), danach die Flaggen, sonst Pan/Audition auf 50+s.
  uiClick && inBox(wgx, wgy, wgw, wgh) ? (
    pgb[PG_SEGSEL] = s;
    ok = 0;
    wlenS > 0 && hotTop && abs(mX - zxX) < 6 ? ( dragId = 26 + s; ok = 1; ) : 0;
    !ok && wlenS > 0 && s > 0 && hotTop && abs(mX - zeX) < 6 ? ( dragId = 28 + s; ok = 1; ) : 0;
    !ok && wlenS > 0 && sm[SG_MODE] == 1 && abs(mX - stX) < 4 ? ( dragId = 20 + s; ok = 1; ) : 0;
    !ok && wlenS > 0 && abs(mX - enX) < 4 ? ( dragId = 23 + s; ok = 1; ) : 0;
    !ok ? ( dragId = 50 + s; dragX = mX; dragMv = 0; ) : 0;
    // v0.9.0: CTRL+Klick auf einen Griff (Flaggen 20..25, Rauten 26..30)
    // setzt den INIT-Wert aus ctlDef statt zu ziehen. END = LEN bleibt
    // im Fenster (START + LEN <= 1000); die Eintritts-Raute (29/30)
    // schreibt (seit v0.9.1) SG_XFI dieser Lane.
    (mouse_cap & 4) && dragId >= 20 && dragId <= 30 ? (
      dragId < 23 ? ( sm[SG_START] = ctlDef(dragId); )
      // P25 (A6): stS wie bei der END-Flagge (SYNTH: 0).
      : dragId < 26 ? ( sm[SG_LEN] = min(lenDef(s, sm[SG_MODE]), max(1, 1000 - stS)); )
      : dragId < 29 ? ( sm[SG_XF] = ctlDef(dragId); )
      : ( sm[SG_XFI] = ctlDef(dragId); );     // v0.9.1: Eintritt der Lane selbst
      dragId = -1;
    ) : 0;
  );

  // --- Zoom/Skew: Rad ueber der Welle, Shift = Vertikalzoom.
  //     Gezoomt wird auf den Zeiger hin (Anker-Anteil bleibt fix).
  //     Undo (v0.7.1, Finding 6): die View-Felder ZOOM/SKEW/VOFF sind
  //     aus dem Undo-Diff ausgenommen - das Rad ruft weder Mark noch
  //     Commit auf (sonst ein Eintrag je Raste). Waehrend eines Drags
  //     ist das Rad komplett inert: ein undoMark() hier wuerde den
  //     Pending-Snapshot des laufenden Drags ueberschreiben.
  dragId >= 0 ? ( mouse_wheel = 0; ) : 0;
  kbDrag >= 0 ? ( mouse_wheel = 0; ) : 0;     // v0.9.1: auch waehrend eines Poti-Drags inert
  mouse_wheel != 0 && inBox(wgx, wgy, wgw, wgh) ? (
    (mouse_cap & 8) ? (
      sm[SG_SKEW] = min(1000, max(0, sm[SG_SKEW] + mouse_wheel*1.25));
    ) : (mouse_cap & 4) ? (
      laneScroll(s, gZ_off - mouse_wheel/120*gZ_span*0.1);     // STRG + Rad: rollen
    ) : (
      laneZoomBy(s, mouse_wheel*1.25, (mX - wgx)/wgw);         // Anker = Zeiger
    );
    mouse_wheel = 0;
  ) : 0;

  // --- Zoom-Leiste (23.10.2026, Muster Mover): - / + zoomen um die Mitte (Faktor 1,41), FIT = ZOOM FIT (der
  //     Ausschnitt folgt dem Lane-Fenster, bis - / +, Rad, Pan oder Rollbalken ihn verstellen), daneben der Zoomfaktor.
  //     Normal links unter GAIN, maximiert rechts in der Werkzeugleiste. Reine Klicks, Ansicht: kein Undo-Schritt.
  laneView(s);
  zbY = isMax ? ly + 29 : ly + lnH - 35;
  zbX = isMax ? 540 : 28;
  gfx_setfont(5);
  btn(zbX, zbY, 22, 16, 0, "-") ? laneZoomBy(s, -83.333, 0.5);
  btn(zbX + 24, zbY, 22, 16, 0, "+") ? laneZoomBy(s, 83.333, 0.5);
  btn(zbX + 48, zbY, 36, 16, sm[SG_ZFIT] > 0.5, "FIT") ? ( sm[SG_ZFIT] = 1; laneView(s); );
  tipAt(zbX, zbY, 22, 16, "Zoom out: show more of the slot around the middle|Wheel over the wave zooms at the pointer");
  tipAt(zbX + 24, zbY, 22, 16, "Zoom in: show less, more detail around the middle|Wheel over the wave zooms at the pointer");
  tipAt(zbX + 48, zbY, 36, 16, "ZOOM FIT: the view follows the lane window (lit = on)|Zoom, wheel, pan or the scroll bar switch it off - saved with presets");
  sprintf(#vstr, "%.1fX", gZ_fac);
  gfx_measurestr(#vstr, zbTw, zbTh);
  colInk(0.7);
  isMax ? xstr(zbX - 6 - zbTw/SC, zbY + 4, #vstr) : xstr(zbX + 90, zbY + 4, #vstr);
  isMax ? tipAt(zbX - 40, zbY, 38, 16, "Zoom factor of this lane's view, 1-64x") : tipAt(zbX + 88, zbY, 40, 16, "Zoom factor of this lane's view, 1-64x");
  // Rollbalken (nur gezoomt): Klick springt, Daumen ziehen rollt (Drag-ID 80 + s); schaltet FIT aus.
  sbY = wgy + wgh + 2;
  gZ_span < 0.999 ? (
    zbTw = max(14, gZ_span*wgw);
    zbTx = wgx + gZ_off/max(0.001, 1 - gZ_span)*(wgw - zbTw);
    gfx_set(0.03, 0.04, 0.03, 1); xrect(wgx, sbY, wgw, 4);
    dragId == 80 + s || inBox(zbTx, sbY - 1, zbTw, 7) ? colAcid(0.9) : colAcid(0.45);
    xrect(zbTx, sbY, zbTw, 4);
    uiClick && inBox(wgx, sbY - 1, wgw, 7) ? (
      pgb[PG_SEGSEL] = s;
      inBox(zbTx, sbY - 1, zbTw, 7) ? ( dragId = 80 + s; dragX = mX; zSbO = gZ_off; )
      : laneScroll(s, (mX - wgx - zbTw*0.5)/max(1, wgw - zbTw)*(1 - gZ_span));
    ) : 0;
    dragId == 80 + s && uiLmb ? laneScroll(s, zSbO + (mX - dragX)/max(1, wgw - zbTw)*(1 - gZ_span)) : 0;
    tipAt(wgx, sbY - 1, wgw, 7, "Scroll the zoomed view along the slot|CTRL+wheel over the wave does the same");
  ) : 0;

  // Statuszeile: Dateiname + Fensterwerte + Frames (SAMPLE) bzw.
  // Engine-Parameter (SYNTH)
  // v0.8.0: Statuszeile rueckt von ly + 114 auf ly + 92 (Box schmaler),
  // darunter (ly + 106) die DUR-Zeile mit Soll-Bereich.
  // v0.9.0: DUR wandert in die Statuszeile (rechts neben XF); ly + 106
  // ist frei. Der Frame-Zaehler "%d SMP" (SAMPLE) sass rechts an der
  // Stelle und zieht in die linke obere Ecke der Wellen-Box um.
  gfx_setfont(3);
  statEnd = wgx + 160;
  sm[SG_MODE] == 0 ? (
    colInk(1); xstr(wgx, stY,
      s == 0 ? "ENGINE: CLICK+NZ" : s == 1 ? "ENGINE: PITCH-ENV" : "ENGINE: SINE+DRIFT");
    gfx_setfont(5); colAcid(0.85);
    xat(wgx + 160, stY);
    // P26 (Schriftstufen, p26_fontcheck.py): einfache Abstaende (ab +2 lief DUR in die Werte).
    gfx_printf("F %d>%d C %d XF %d MS",
      floor(sm[SG_F0] + 0.5), floor(sm[SG_F1] + 0.5),
      floor(sm[SG_CRVE] + 0.5), floor(sm[SG_XF] + 0.5));
    statEnd = (gfx_x - OX)/SC;
  ) : gmt[SM_FLAG] == 1 ? (
    pathBase(s);
    colInk(1); xstr(wgx, stY, #nmstr);
    gfx_setfont(5); colAcid(0.85);
    xat(wgx + 160, stY);
    gfx_printf("S %04d L %04d XF %d MS",
      floor(sm[SG_START] + 0.5), floor(sm[SG_LEN] + 0.5),
      floor(sm[SG_XF] + 0.5));
    statEnd = (gfx_x - OX)/SC;
    colInk(0.7);
    xat(wgx + 6, wgy + 4);
    gfx_printf("%d SMP", floor(gmt[SM_LEN] + 0.5));
    gfx_setfont(5);
  ) : 0;
  gfx_setfont(5);
  durLabel(wgx + wgw + 6, statEnd + 6, stY, s);   // v0.9.2: rechtsbuendig 628 (normal) / 630 (maximiert)
// v0.12.3 (P23): Tooltip der Statuszeile (links Fensterwerte, rechts DUR/REC)
tipAt(wgx, stY - 1, wgw, 13, sm[SG_MODE] == 0
  ? "Lane readout: engine, F0 > F1 in Hz, C = curve, XF = exit crossfade|DUR: rendered length - acid inside the REC range, orange outside, dim = muted"
  : "Lane readout: file name, S = window start, L = window length (permille of the slot), XF = exit crossfade|DUR: rendered length - acid inside the REC range, orange outside, dim = muted");
  // Poti-Reihe (Zelle 44 px) bei lnKT = ly + lnH - 47 (normal ly + 102)
  expOn ? knobRow(s, lnKT) : 0;

  );   // Ende Vollansicht (nicht eingeklappt)

  s += 1;
);
);   // Ende !fuExpF (v1.0.0)

// ---------- FUSION-Zeile (v0.8.0): die entstehende Kick ----------
// Passive Anzeige, keine Drag-IDs. Zeitachse = Output-Zeit der Kette
// (Segmente sequenziell, Crossfades als Ueberlappung); die Wellenbox
// nutzt dieselben Spalten wie die Lane-Boxen (x 170..622).
// v0.9.2: die Zeile sitzt unter den Lanes bei FU_Y = 547.
// die Lane-Kette reicht in jeder Ansicht (normal / maximiert) bis 539.
// v0.12.0 (P21): panel2 - die Gesamtdauer steht in der Titelzeile, das
// Fusion-Feld in der Nutzflaeche ab FU_Y + 24 (Panel 48 -> 64 hoch).
// v1.0.0 (Wellenansicht, Konzept A + C): FUSION zeigt die gerechnete Welle statt der Huellkurven-Balken. SUM = die Summe in
// der Farbe der lautesten Lane, STACK = je Lane eine Zeile an ihrer Stelle in der Kette plus die Summe. EXPAND legt FUSION
// ueber den ganzen Lane-Bereich (fuY = LN_Y0): dann mit Griffen fuer Laenge und Crossfade, Klick spielt (siehe wvBig /
// wvStack). Solange noch keine Vorschau da ist, zeichnet SUM die alte Balkenanzeige (fusDraw).
fuY = fuExpF ? LN_Y0 : FU_Y;
fuHH = 668 - fuY;
fuTot > 0 ? sprintf(#vstr, "FUSION - %.1f MS", fuTot*1000/srate)
          : strcpy(#vstr, "FUSION");
panel2(16, fuY, 620, fuHH, #vstr);
// v0.12.3 (P23): FUSION ist eine reine Anzeige - seit v1.0.0 (Wellenansicht) nur noch ohne EXPAND
fuExpF ? tipAt(16, fuY, 620, fuHH, "FUSION (expanded): the finished kick, rendered from the lanes before the master section|Drag the flags (length) and diamonds (crossfade) in the wave - click plays")
       : tipAt(16, fuY, 620, fuHH, "FUSION: the finished kick, rendered from the lanes before the master section|SUM: one wave coloured by the loudest lane - STACK: one row per lane plus the sum|Display only - EXPAND makes it big and editable");
gfx_setfont(5);
btn(170, fuY + 3, 32, 16, !fuStkF, "SUM") ? wvUiSet(6, 1, 0);
btn(204, fuY + 3, 40, 16, fuStkF, "STACK") ? wvUiSet(6, 1, 1);
btn(248, fuY + 3, 48, 16, fuExpF, "EXPAND") ? wvUiSet(7, 1, fuExpF ? 0 : 1);
tipAt(170, fuY + 3, 32, 16, "SUM: the finished kick as one wave, coloured by the lane that is loudest at each moment");
tipAt(204, fuY + 3, 40, 16, "STACK: one row per lane at its real place in the kick, the sum below|Shows how S1, S2 and S3 overlap in the crossfades");
tipAt(248, fuY + 3, 48, 16, fuExpF ? "EXPAND: back to the three lanes" : "EXPAND: FUSION fills the lane area - big wave with flags and diamonds to edit|Saved per instance");
fuStkF ? (
  wvStack(170, fuY + 24, 452, fuHH - 30, fuExpF, 2);
  // Bedienspalte links neben den Zeilen
  s = 0;
  loop(3,
    sm = M_SEG + s*64;
    fuRy = s == 0 ? wsY0 : s == 1 ? wsY1 : wsY2;
    fuExpF ? (
      gfx_setfont(3);
      laneOnG(s) ? wvCol(s, 1) : colInk(0.45);
      xstr(28, fuRy + 4, s == 0 ? "S1  TRANSIENT" : s == 1 ? "S2  BODY" : "S3  TAIL");
      btn(28, fuRy + 22, 22, 16, sm[SG_MUTE] > 0.5, "M")
        ? ( (mouse_cap & 4) ? ( sm[SG_MUTE] = ctlDef(118); ) : ( sm[SG_MUTE] = 1 - sm[SG_MUTE]; ); );
      kkSoW = sm[SG_SOLO] > 0.5;
      kkSoW ? ( swAcR = accR; swAcG = accG; swAcB = accB;
                accR = tth_alR; accG = tth_alG; accB = tth_alB; ) : 0;
      btn(54, fuRy + 22, 22, 16, sm[SG_SOLO] > 0.5, "S")
        ? ( (mouse_cap & 4) ? ( sm[SG_SOLO] = ctlDef(119); ) : ( sm[SG_SOLO] = 1 - sm[SG_SOLO]; ); );
      kkSoW ? ( accR = swAcR; accG = swAcG; accB = swAcB; ) : 0;
      btn(80, fuRy + 22, 52, 16, 0, "OPEN") ? ( wvUiSet(7, 1, 0); maxLane = s; pgb[PG_SEGSEL] = s; );
      tipAt(28, fuRy + 22, 22, 16, "MUTE: take this lane out of the kick chain|CTRL+click: reset");
      tipAt(54, fuRy + 22, 22, 16, "SOLO: only soloed lanes play in the kick chain|CTRL+click: reset");
      tipAt(80, fuRy + 22, 52, 16, "OPEN: leave EXPAND and show this lane maximized in MAIN");
      gfx_setfont(5);
      fusOwnOk(s) ? (
        colInk(0.85); xat(28, fuRy + 46); gfx_printf("DUR %d MS", floor(fusDur(s)*1000/srate + 0.5));
        xat(28, fuRy + 60); gfx_printf("GAIN %d%%", floor(sm[SG_GAIN] + 0.5));
        fusGated(s) ? ( colWarn(0.9); xstr(28, fuRy + 74, "MUTED"); ) : 0;
      ) : ( colInk(0.5); xstr(28, fuRy + 46, "DOES NOT PLAY"); );
    ) : (
      gfx_setfont(5);
      laneOnG(s) && fusOwnOk(s) ? wvCol(s, 1) : colInk(0.45);
      xstr(28, fuRy + wsH*0.5 - 5, s == 0 ? "S1 TRANSIENT" : s == 1 ? "S2 BODY" : "S3 TAIL");
    );
    s += 1;
  );
  gfx_setfont(fuExpF ? 3 : 5); colInk(0.9);
  xstr(28, wsSY + 4, "SUM");
  fuExpF ? (
    gfx_setfont(5); colInk(0.7);
    xstr(28, wsSY + 22, "CLICK: PLAY");
    xstr(28, wsSY + 36, "COLOUR: LOUDEST");
    wvOk && wvMb[1] > 0 ? (
      wvPd = 20*log(max(0.00001, wvPeak()))*0.43429448;
      wvPd > 0 ? colWarn(0.9) : colInk(0.85);
      xat(28, wsSY + 54);
      wvPd >= 0 ? gfx_printf("PEAK +%.1f DB", wvPd) : gfx_printf("PEAK %.1f DB", wvPd);
      colInk(0.6); xstr(28, wsSY + 68, "PRE-MASTER");
    ) : 0;
  ) : 0;
) : (
  fuExpF ? (
    wvBig(28, fuY + 24, 596, fuHH - 30, 0, max(max(64, fuTot), wvBeatF())*1.04, 0, 7, 2);
  ) : (
    gfx_setfont(5); colInk(0.6); xstr(28, fuY + 28, "EQ-POWER XFADES");
    s = 0;
    loop(3,
      laneOnG(s) && fusOwnOk(s) ? wvCol(s, 1) : colInk(0.45);
      xrect(28, fuY + 50 + s*14, 10, 3);
      xstr(44, fuY + 46 + s*14, s == 0 ? "S1 TRANSIENT" : s == 1 ? "S2 BODY" : "S3 TAIL");
      s += 1;
    );
    wvOk ? wvBig(170, fuY + 24, 452, fuHH - 30, 0, max(64, fuTot)*1.02, 0, 4, 1)
         : fusDraw(170, fuY + 24, 452, fuHH - 30);
  );
);

// FIT (length) (v0.14.1): Kick einmalig auf eine Notenlaenge bringen (Muster FIT TO aus a sibling product). Die Auswahl gilt je
// Sitzung (nicht gespeichert); gespeichert wird das Ergebnis, die Lane-Laengen. Keine Drag-ID (reine Klicks).
// v1.0.0 (Wellenansicht): Zeile haengt an fuY (FU_Y bzw. LN_Y0 bei EXPAND).
kkFitN1 < 1 ? ( kkFitN1 = 3; );   // Vorgabe 1/4 (gespeichert als Index + 1)
gfx_setfont(3); colInk(1); xstr(386, fuY + 5, "FIT LENGTH TO");
strcpy(#cmb_txt, kkFitN1 == 1 ? "1/1" : kkFitN1 == 2 ? "1/2" : kkFitN1 == 3 ? "1/4" : kkFitN1 == 4 ? "1/4T"
                 : kkFitN1 == 5 ? "1/8" : kkFitN1 == 6 ? "1/8T" : "1/16");
nv = combo(54, 488, fuY + 3, 70, 16, kkFitN1 - 1, 7);
nv != kkFitN1 - 1 ? ( kkFitN1 = nv + 1; kkFitLen(nv); ) : 0;   // Auswahl wendet sofort an (wie FIT TO)
// v1.0.0: AUTO = nach jedem Preset-Laden automatisch auf die gewaehlte Laenge fitten (gespeichert je Instanz, PG_FAUT)
gfx_setfont(5);
toggle(330, fuY + 3, 50, 16, pgb[PG_FAUT] > 0.5, "AUTO") ? ( pgb[PG_FAUT] = 1 - pgb[PG_FAUT]; tt_undo(); ) : 0;
tipAt(330, fuY + 3, 50, 16, "AUTO: whenever a preset is loaded (arrows, list, user slot) the kick is fitted to the FIT LENGTH note at the current tempo|Not the OPTIONS > AUTO FIT zoom|Saved per instance");
gfx_setfont(3);
btn(564, fuY + 3, 64, 16, 0, "FIT NOW") ? kkFitLen(kkFitN1 - 1);
tipAt(386, fuY + 3, 98, 16, "FIT LENGTH TO: scales the lengths of all playing lanes once so the whole kick lasts one note at the current tempo|The proportions between the lanes stay the same|Limits: synth lanes max 60 / 500 / 2000 ms, samples their slot");
tipAt(488, fuY + 3, 70, 16, "FIT NOTE: 1/1, 1/2, 1/4, 1/4T, 1/8, 1/8T or 1/16 - the length the kick is fitted to|Arrows, click or wheel step; a new value is applied at once|The choice is not saved, the resulting lane lengths are");
tipAt(564, fuY + 3, 64, 16, "FIT NOW: apply the selected note length again|Use it after editing lanes or changing the tempo|Lanes that are muted stay untouched");

) : (

// ---------- Seite WAVE (v1.0.0, Wellenansicht, Konzept B): die ganze Kick auf einer Zeitachse ----------
// Oben die Kette als eine Welle (S1/S2/S3 farbig hinterlegt, SUM oder LAYERS), Griffe fuer Laenge und Crossfade, rote
// Linie = naechster Kick des Players, Lupe fuer die ersten 20 ms, Rad = Zoom, SHIFT+Rad = Scrollen, darunter die Uebersicht.
// Unten die Segmentleiste der gewaehlten Lane: dieselben Parameter wie in MAIN (die Knopfreihe ist die EXPERT-Reihe).
// Der Ausschnitt (wvV0/wvV1, wvVMan) gilt je Sitzung; LAYERS und LUPE stehen in PG_WVUI (Bits 8/9).
wvBf = wvBeatF();
wvFitE = max(max(64, fuTot), wvBf)*1.04;               // FIT: Kette und naechster Kick
wvVMan && wvV1 - wvV0 >= wvFitE ? ( wvVMan = 0; ) : 0;
!wvVMan ? ( wvV0 = 0; wvV1 = wvFitE; ) : (
  wvV1 - wvV0 < 0.002*srate ? ( wvV1 = wvV0 + 0.002*srate; ) : 0;
  wvV0 < 0 ? ( wvV1 -= wvV0; wvV0 = 0; ) : 0;
  wvV1 > wvFitE ? ( wvV0 = max(0, wvV0 - (wvV1 - wvFitE)); wvV1 = wvFitE; ) : 0;
);
wvLay = wvUi(8, 1);
wvLup = wvUi(9, 1) < 0.5;
fuTot > 0 ? sprintf(#vstr, "WAVE - %.1f MS", fuTot*1000/srate) : strcpy(#vstr, "WAVE");
panel2(16, 76, 620, 372, #vstr);
gfx_setfont(5);
btn(442, 79, 36, 16, !wvLay, "SUM") ? wvUiSet(8, 1, 0);
btn(480, 79, 52, 16, wvLay, "LAYERS") ? wvUiSet(8, 1, 1);
btn(538, 79, 44, 16, wvLup, "LUPE") ? wvUiSet(9, 1, wvLup ? 1 : 0);
btn(588, 79, 36, 16, !wvVMan, "FIT") ? ( wvVMan = 0; );
tipAt(442, 79, 36, 16, "SUM: the finished kick as one wave, coloured by the lane that is loudest at each moment");
tipAt(480, 79, 52, 16, "LAYERS: S1, S2 and S3 as three waves on top of each other|Shows how the lanes overlap in the crossfades");
tipAt(538, 79, 44, 16, "LUPE: magnifier for the first 20 ms (the transient)|Hidden while zoomed in closer than 60 ms - saved per instance");
tipAt(588, 79, 36, 16, "FIT: show the whole kick and the next player hit|Wheel zooms in, SHIFT+wheel scrolls");
wvVMan ? (
  sprintf(#vstr, "ZOOM %.1fX", wvFitE/max(1, wvV1 - wvV0));
  gfx_measurestr(#vstr, wvTw, wvTh);
  colInk(0.8); xstr(436 - wvTw/SC, 82, #vstr);
  tipAt(436 - wvTw/SC, 79, wvTw/SC, 16, "ZOOM: how far the wave is magnified against FIT|FIT or zooming out all the way returns to the whole kick");
) : 0;
// Rechnet die Vorschau laenger als ~0,15 s (lange Kick, grosser Puffer), steht ein Hinweis in der Titelzeile.
wvSt > 0.5 ? ( wvBusy += 1; ) : ( wvBusy = 0; );
wvBusy > 6 ? ( colInk(0.6); xstr(176, 82, "UPDATING"); ) : 0;

// Welle (Ansicht 3). Lupe oben rechts; ihr Rechteck faengt keine Klicks der Welle.
wvLup && wvV1 - wvV0 > 0.06*srate ? ( wvLpX = 452; wvLpY = 110; wvLpW = 166; wvLpH = 72; ) : ( wvLpW = 0; );
tipAt(28, 102, 596, 300, "Click: select the lane under the mouse and play the kick|Drag: scroll (when zoomed) - wheel: zoom - SHIFT+wheel: scroll|Red line: next player hit at the PLAYER RATE");
wvBig(28, 102, 596, 300, wvV0, wvV1, wvLay, 7, 3);
wvLpW > 0 ? (
  wvLupe(wvLpX, wvLpY, wvLpW, wvLpH);
  tipAt(wvLpX, wvLpY, wvLpW, wvLpH, "LUPE: the first 20 ms of the kick, magnified|The transient and the S1 > S2 crossfade - switch it off with LUPE");
) : 0;

// Zoom und Scrollen mit dem Rad (nicht waehrend eines Zugs); Zug im Hintergrund = Scrollen
dragId < 0 && kbDrag < 0 && mouse_wheel != 0 && inBox(28, 102, 596, 300) ? (
  (mouse_cap & 8) ? (
    wvD = (wvV1 - wvV0)*0.1*(mouse_wheel > 0 ? -1 : 1);
    wvV0 += wvD; wvV1 += wvD;
  ) : (
    wvA = wvXf(mX);
    wvZ = 0.8^(mouse_wheel/120);
    wvV0 = wvA - (wvA - wvV0)*wvZ;
    wvV1 = wvA + (wvV1 - wvA)*wvZ;
  );
  wvVMan = 1;
  mouse_wheel = 0;
) : 0;
dragId == 77 && wvDgV == 3 && uiLmb ? (
  abs(mX - dragX) > 2 ? ( dragMv = 1; ) : 0;
  dragMv && wvVMan ? (
    wvD = (mX - dragX)/596*(wvV1 - wvV0);
    wvV0 -= wvD; wvV1 -= wvD;
    dragX = mX;
  ) : 0;
) : 0;

// Uebersicht: die ganze FIT-Spanne klein, der sichtbare Ausschnitt als Rahmen. Klick/Zug (ID 76) verschiebt den Ausschnitt.
kTb(0.042, 0.048, 0.042, 1); xrect(28, 408, 596, 14);
gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
xrect(28, 408, 596, 1); xrect(28, 421, 596, 1); xrect(28, 408, 1, 14); xrect(623, 408, 1, 14);
colDim(0.9);
wvDrawT(3, 29, 409, 594, 12, 0, wvFitE, 12*0.46/max(1, wvPeak()), 0);
wvOx0 = 29 + wvV0/wvFitE*594; wvOx1 = 29 + wvV1/wvFitE*594;
colAcid(0.16); xrect(wvOx0, 409, max(2, wvOx1 - wvOx0), 12);
colAcid(0.9);
xrect(wvOx0, 408, max(2, wvOx1 - wvOx0), 1); xrect(wvOx0, 421, max(2, wvOx1 - wvOx0), 1);
xrect(wvOx0, 408, 1, 14); xrect(max(wvOx0 + 1, wvOx1 - 1), 408, 1, 14);
uiClick && dragId < 0 && inBox(28, 406, 596, 18) ? ( dragId = 76; ) : 0;
dragId == 76 && uiLmb && wvVMan ? (
  wvA = (mX - 29)/594*wvFitE; wvD = wvV1 - wvV0;
  wvV0 = wvA - wvD*0.5; wvV1 = wvA + wvD*0.5;
) : 0;
tipAt(28, 406, 596, 18, "OVERVIEW: the whole kick and the next hit - the frame is the visible part|Click or drag to move the zoomed view");

// Hinweiszeile und Peak der Vorschau (vor dem Master)
gfx_setfont(5); colInk(0.7);
xstr(28, 428, "CLICK: PLAY  //  WHEEL: ZOOM");
wvOk && wvMb[1] > 0 ? (
  wvPd = 20*log(max(0.00001, wvPeak()))*0.43429448;
  wvPd >= 0 ? sprintf(#vstr, "PEAK +%.1f DB PRE-MASTER", wvPd) : sprintf(#vstr, "PEAK %.1f DB PRE-MASTER", wvPd);
  gfx_measurestr(#vstr, wvTw, wvTh);
  wvPd > 0 ? colWarn(0.9) : colInk(0.85);
  xstr(624 - wvTw/SC, 428, #vstr);
  tipAt(624 - wvTw/SC, 426, wvTw/SC, 12, "PEAK: highest level of the rendered kick (velocity 127) before the master section|Above 0 dB the master clipper or ceiling will catch it");
) : 0;

// ---------- Segmentleiste der gewaehlten Lane ----------
wvS = min(2, max(0, floor(pgb[PG_SEGSEL] + 0.5)));
sm = M_SEG + wvS*64;
gmt = M_GEN + 32 + wvS*16;
panel2(16, 456, 620, 212, "");
s = 0;
loop(3,
  gfx_setfont(3);
  btn(28 + s*118, 460, 114, 18, wvS == s, s == 0 ? "S1  TRANSIENT" : s == 1 ? "S2  BODY" : "S3  TAIL") ? ( pgb[PG_SEGSEL] = s; );
  wvCol(s, laneOnG(s) ? 1 : 0.35); xrect(28 + s*118, 479, 114, 2);
  tipAt(28 + s*118, 460, 114, 20, s == 0 ? "S1 TRANSIENT: edit the click lane below|Its colour marks it in the wave above"
    : s == 1 ? "S2 BODY: edit the body lane below|Its colour marks it in the wave above"
    : "S3 TAIL: edit the tail lane below|Its colour marks it in the wave above");
  s += 1;
);
// MUTE / SOLO der gewaehlten Lane (wie im Lane-Kopf)
gfx_setfont(3);
btn(386, 461, 22, 16, sm[SG_MUTE] > 0.5, "M")
  ? ( (mouse_cap & 4) ? ( sm[SG_MUTE] = ctlDef(118); ) : ( sm[SG_MUTE] = 1 - sm[SG_MUTE]; ); );
kkSoW = sm[SG_SOLO] > 0.5;
kkSoW ? ( swAcR = accR; swAcG = accG; swAcB = accB;
          accR = tth_alR; accG = tth_alG; accB = tth_alB; ) : 0;
btn(410, 461, 22, 16, sm[SG_SOLO] > 0.5, "S")
  ? ( (mouse_cap & 4) ? ( sm[SG_SOLO] = ctlDef(119); ) : ( sm[SG_SOLO] = 1 - sm[SG_SOLO]; ); );
kkSoW ? ( accR = swAcR; accG = swAcG; accB = swAcB; ) : 0;
tipAt(386, 461, 22, 16, "MUTE: take this lane out of the kick chain|CTRL+click: reset");
tipAt(410, 461, 22, 16, "SOLO: only soloed lanes play in the kick chain|CTRL+click: reset");
// Lane-Preset-Browser der gewaehlten Lane (Liste = dasselbe Overlay wie in MAIN)
lpIdx  = floor(sm[SG_LP] + 0.5);
lpStar = abs(chkLane(wvS) - sm[SG_LPS]) > 0.01;
lpName(wvS, lpIdx);
gfx_setfont(5);
btn(440, 461, 16, 16, 0, "<") ? laneApply(wvS, (lpIdx + LP_N) % (LP_N + 1));
btn(608, 461, 16, 16, 0, ">") ? laneApply(wvS, (lpIdx + 1) % (LP_N + 1));
tipAt(440, 461, 16, 16, "LANE PRESET <: previous lane preset|Steps this lane's own bank (undoable)");
tipAt(608, 461, 16, 16, "LANE PRESET >: next lane preset|Steps this lane's own bank (undoable)");
lpHot = inBox(460, 461, 144, 16);
lpHot && uiClick ? (
  mouse_cap & 4 ? laneReset(wvS) : (
    lpMenu = wvS + 1;
    lpMW = 170;
    lpMH = 24 + (LP_N + 1)*17 + 6;
    lpMX = 444;
    lpMY = min(484, 700 - lpMH - 6);
  );
) : 0;
lpHot && mouse_wheel != 0 ? (
  laneApply(wvS, (lpIdx + (mouse_wheel > 0 ? LP_N : 1)) % (LP_N + 1));
  mouse_wheel = 0;
) : 0;
lpHot ? tth_tn(0.10, 0.14, 0.09, 1) : gfx_set(tth_pnR, tth_pnG, tth_pnB, 1);
xrect(460, 461, 144, 16);
gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
xrect(460, 461, 144, 1); xrect(460, 476, 144, 1); xrect(460, 461, 1, 16); xrect(603, 461, 1, 16);
lpStar ? colInk(1) : colAcid(1);
xctr(460, 461, 144, 16, #lpstr);
lpStar ? ( gfx_setfont(5); colInk(1); xstr(596, 464, "*"); ) : 0;
sprintf(#psTip, "Lane preset: %s%s|Click: list this lane's bank - wheel: step - CTRL+click: reset lane|Sets the lane's 16 engine params only", #lpstr, lpStar ? " *" : "");
tipAt(460, 461, 144, 16, #psTip);

// Linke Spalte: Modus, REV/CAP/RAND, GAIN (wie die Lane), darunter die Lage in der Kette
gfx_setfont(2);
btn(28, 488, 60, 18, sm[SG_MODE] == 0, "SYNTH") ? ( sm[SG_MODE] = 0; );
btn(96, 488, 66, 18, sm[SG_MODE] == 1, "SAMPLE") ? ( sm[SG_MODE] = 1; );
tipAt(28, 488, 60, 18, "SYNTH: this lane renders the built-in engine|No sample needed");
tipAt(96, 488, 66, 18, "SAMPLE: this lane plays a loaded or captured WAV|Assign files with TT-KICK Load Kit.lua");
btn(28, 514, 44, 16, sm[SG_REV] > 0.5, "REV") ? ( sm[SG_REV] = 1 - sm[SG_REV]; );
tipAt(28, 514, 44, 16, "REV: play the lane window backwards");
btn(76, 514, 44, 16, capSt > 0 && capLane == wvS && (capSt == 2 || capBlkOn), capOk ? "CAP" : "N/A")
  ? ( capOk ? ( capReq = wvS + 1; ) : 0; );
tipAt(76, 514, 44, 16, "CAP: record the audio input into this lane's slot|VOLATILE: not saved, gone after a project reload|Click again while armed = abort");
gfx_setfont(3);
btn(124, 514, 38, 16, 0, "RAND") ? ( (mouse_cap & 4) ? laneReset(wvS) : randLane(wvS); );
tipAt(124, 514, 38, 16, "Randomize this lane's parameters (musical ranges)|CTRL+click: reset to INIT");
gfx_setfont(3); colInk(1); xstr(28, 542, "GAIN");
gtv = hslider(31 + wvS, 58, 543, 72, 11, sm[SG_GAIN]*0.005, 0, 1, 0.5);
abs(gtv*200 - sm[SG_GAIN]) > 0.001 ? ( sm[SG_GAIN] = min(200, max(0, gtv*200)); ) : 0;
tipAt(54, 540, 80, 16, "GAIN: level of this lane, 0-200%|CTRL+click: reset");
gfx_setfont(5); colInk(1); xat(134, 544);
gfx_printf("%d%%", floor(sm[SG_GAIN] + 0.5));
gfx_setfont(5);
fusOk(wvS) ? (
  colInk(0.85);
  xat(28, 566); gfx_printf("START %.1f MS", fusSt(wvS)*1000/srate);
  xat(28, 580); gfx_printf("END %.1f MS", (fusSt(wvS) + fusDu(wvS))*1000/srate);
  xat(28, 594); gfx_printf("XF %d / %d MS", floor(sm[SG_XFI] + 0.5), floor(sm[SG_XF] + 0.5));
) : fusGated(wvS) ? ( colWarn(0.9); xstr(28, 566, "MUTED"); colInk(0.7); xstr(28, 580, "NOT IN THE KICK"); )
  : ( colInk(0.6); xstr(28, 566, "DOES NOT PLAY"); );
wvTrk(wvS) ? (
  wvPd = 20*log(max(0.00001, wtPk))*0.43429448;
  colInk(0.85); xat(28, 608);
  wvPd >= 0 ? gfx_printf("PEAK +%.1f DB", wvPd) : gfx_printf("PEAK %.1f DB", wvPd);
) : 0;
tipAt(28, 562, 140, 60, "Where this lane sits in the kick (START / END), its crossfades (XF-IN / XF-OUT) and its own peak|START/END follow the edits at once, the peak comes from the rendered preview at velocity 127");

// Kopfzeile rechts: Engine bzw. Datei, Werte, DUR (wie die Statuszeile der Lane)
gfx_setfont(3);
wvSe = 340;
sm[SG_MODE] == 0 ? (
  colInk(1); xstr(180, 490, wvS == 0 ? "ENGINE: CLICK+NZ" : wvS == 1 ? "ENGINE: PITCH-ENV" : "ENGINE: SINE+DRIFT");
  gfx_setfont(5); colAcid(0.85); xat(340, 490);
  gfx_printf("F %d>%d C %d", floor(sm[SG_F0] + 0.5), floor(sm[SG_F1] + 0.5), floor(sm[SG_CRVE] + 0.5));
  wvSe = (gfx_x - OX)/SC;
) : gmt[SM_FLAG] == 1 ? (
  pathBase(wvS);
  colInk(1); xstr(180, 490, #nmstr);
  gfx_setfont(5); colAcid(0.85); xat(340, 490);
  gfx_printf("S %04d L %04d", floor(sm[SG_START] + 0.5), floor(sm[SG_LEN] + 0.5));
  wvSe = (gfx_x - OX)/SC;
) : ( colInk(0.7); xstr(180, 490, "EMPTY SLOT - ASSIGN WITH TT-KICK Load Kit.lua"); wvSe = 470; );
gfx_setfont(5);
durLabel(624, wvSe + 6, 490, wvS);
tipAt(180, 487, 444, 14, "Lane readout: engine or file, F0 > F1 in Hz and curve (SYNTH) or window start / length (SAMPLE)|DUR: rendered length - acid inside the REC range, orange outside");

// Knopfreihe = die EXPERT-Reihe der Lane (Engine, PITCH, LEN, XF-IN, XF-OUT, CUT, RES), immer sichtbar
knobRow(wvS, 506);

// Die Lane allein auf ihrer eigenen Zeitachse (normiert auf ihren Peak)
kTb(0.042, 0.048, 0.042, 1); xrect(180, 556, 444, 106);
gfx_set(tth_bdR, tth_bdG, tth_bdB, 1);
xrect(180, 556, 444, 1); xrect(180, 661, 444, 1); xrect(180, 556, 1, 106); xrect(623, 556, 1, 106);
wvTrk(wvS) ? (
  drawTimeGrid(181, 557, 442, 104, 0, wtNf*1000/srate);
  tth_tn(0.10, 0.13, 0.08, 1); xline(181, 609, 622, 609);
  wtSo > 0.5 ? colInk(0.55) : wvCol(wvS, 1);
  wvDrawT(wvS, 181, 558, 442, 102, 0, wtNf, 102*0.46/max(0.00001, wtPk), 0);
  gfx_setfont(5); wvCol(wvS, 1);
  xstr(186, 560, wvS == 0 ? "S1 ALONE - OWN TIME SCALE, NORMALISED" : wvS == 1 ? "S2 ALONE - OWN TIME SCALE, NORMALISED" : "S3 ALONE - OWN TIME SCALE, NORMALISED");
) : (
  gfx_setfont(5); colInk(0.6); xctr(180, 556, 444, 106, wvOk ? "NO WAVE - THIS LANE DOES NOT PLAY" : "PREVIEW IS BEING RENDERED ...");
);
capSt > 0 && capLane == wvS ? (
  kTb(0.042, 0.048, 0.042, 1); xrect(181, 557, 442, 104);
  gfx_setfont(2);
  capSt == 1 ? (
    capBlkOn ? ( colAcid(1); xctr(180, 556, 444, 106, "REC ARMED - PLAY YOUR SOURCE"); ) : 0;
  ) : (
    colAcid(0.22); xrect(181, 557, 442*min(1, capIdx/max(1, capLim)), 104);
    colAcid(1); sprintf(#vstr, "CAPTURE %.1f/%.1f S", capIdx/srate, capLim/srate);
    xctr(180, 556, 444, 106, #vstr);
  );
) : 0;
tipAt(180, 556, 444, 106, "The selected lane alone on its own time scale, normalised to its peak|The same wave sits coloured in the kick above");

);   // Ende MAIN | WAVE (v1.0.0)

// ---------- Lane-Preset-Liste (v0.9.5): Overlay NACH FUSION/Spielfeld.
// Die Klickverarbeitung passiert oben im Modal-Schluckblock - hier nur
// zeichnen. Bewusst nach der FUSION-Zeile: das Menue der S3-Lane reicht
// bis y ~688 und wuerde sonst von der FUSION-Box (ab 547) ueberdeckt.
lpMenu > 0 ? (
  lm = lpMenu - 1;
  panel2(lpMX, lpMY, lpMW, lpMH, "");   // v0.12.0: Overlay als panel2, Titel manuell (farbig)
  gfx_setfont(3); colAcid(1);
  lm == 0 ? xstr(lpMX + 10, lpMY + 6, "S1 TRANSIENT")
  : lm == 1 ? xstr(lpMX + 10, lpMY + 6, "S2 BODY")
  : xstr(lpMX + 10, lpMY + 6, "S3 TAIL");
  gfx_setfont(2);
  lsm = M_SEG + lm*64;
  li = 0;
  loop(15,
    ley = lpMY + 24 + li*17;
    lpHov = inBox(lpMX + 4, ley, lpMW - 8, 17);
    lpCur = floor(lsm[SG_LP] + 0.5) == li;
    lpHov || lpCur ? (
      lpCur ? tth_tn(0.17, 0.44, 0.12, 1) : tth_tn(0.10, 0.14, 0.09, 1);
      xrect(lpMX + 4, ley, lpMW - 8, 17);
    ) : 0;
    li < 1 ? strcpy(#lpstr, "INIT") : lpName(lm, li);
    lpHov ? colAcid(1) : colInk(0.95);
    xstr(lpMX + 10, ley + 2, #lpstr);
    lpHov ? ( sprintf(#psTip, "%s|Sets this lane's engine params (undoable)", #lpstr); tipMenu(#psTip); ) : 0;
    li += 1;
  );
) : 0;

// ---------- Player-Panel ----------
// v0.8.0: Panel 150 -> 184 hoch (BPM->ms-Referenz unter der Statuszeile).
// v0.9.2: Panel 184 -> 224 hoch (76..300), Zeilen luftiger verteilt.
// v0.12.0 (P21): panel2 mit Titelzeile; ON/SYNC/FREE als Kit-toggles,
// RATE als Kit-combo (ID 11, Master-Reserve), Tasten y 98 -> 100.
panel2(652, 76, 232, 224, "PLAYER 4/4");
plRun ? colAcid(1) : tth_tn(0.16, 0.19, 0.15, 1);
xcirc(820, 88, 5, 1);
gfx_setfont(5); colInk(1); xat(830, 82);
plRun ? gfx_printf("RUN") : gfx_printf("STOP");
tipAt(812, 79, 54, 16, "RUN / STOP: state of the built-in 4/4 player");

gfx_setfont(2);
toggle(664, 100, 64, 20, pgb[PG_ON] > 0.5, pgb[PG_ON] > 0.5 ? "ON" : "OFF")
  ? ( pgb[PG_ON] = 1 - pgb[PG_ON]; );
toggle(736, 100, 62, 20, pgb[PG_SYNC] > 0.5, "SYNC")
  ? ( pgb[PG_SYNC] = 1; );
toggle(806, 100, 68, 20, pgb[PG_SYNC] < 0.5, "FREE")
  ? ( pgb[PG_SYNC] = 0; );
tipAt(664, 100, 64, 20, "PLAYER ON/OFF: built-in 4/4 player plays the kick|on the grid, using the ROOT note");
tipAt(736, 100, 62, 20, "SYNC: player follows the project timeline|Runs while the transport runs");
tipAt(806, 100, 68, 20, "FREE: player runs on its own clock at the host tempo|Ignores the transport");

// Player-Zeilen: RATE 130, ROOT 164, KEYTRK 186, Detect 204, Laufstatus 215, Trenner 229, BPM 233/246.
gfx_setfont(3); colInk(1); xstr(664, 130, "RATE");
// v0.12.0 (P21): Combo statt vier Einzeltasten (Pfeile, Klick = naechster,
// Rechtsklick = vorheriger, Rad); INDEX = PG_RATE 0..3 unveraendert.
ri = floor(pgb[PG_RATE] + 0.5);
strcpy(#cmb_txt, ri == 0 ? "1/1" : ri == 1 ? "1/2" : ri == 2 ? "1/4" : "1/8");
nv = combo(11, 664, 144, 210, 18, ri, 4);
nv != ri ? ( pgb[PG_RATE] = nv; ) : 0;
tipAt(664, 144, 210, 18, "RATE: one kick per grid step|1/1, 1/2, 1/4 (four on the floor) or 1/8|Arrows, click or wheel step");

// ROOT-Note (Keytrack-Basis) mit -/+ und DETECT (ID 8, One-Shot:
// Analyse laeuft im gfx-Thread, Ergebniszeile darunter)
gfx_setfont(3); colInk(1); xstr(664, 179, "ROOT");
gfx_setfont(2);
btn(706, 175, 20, 18, 0, "-") ? ( pgb[PG_ROOT] = max(0, floor(pgb[PG_ROOT] + 0.5) - 1); );
btn(772, 175, 20, 18, 0, "+") ? ( pgb[PG_ROOT] = min(127, floor(pgb[PG_ROOT] + 0.5) + 1); );
noteStr(floor(pgb[PG_ROOT] + 0.5));
gfx_setfont(4); colAcid(1); xat(732, 178); gfx_drawstr(#vstr);
tipAt(728, 175, 44, 18, "ROOT note: the pitch at which the kick plays unchanged (keytrack base)|Set it with -/+ or DETECT");
btn(800, 175, 74, 18, 0, "DETECT") ? detectRoot() : 0;
tipAt(706, 175, 20, 18, "ROOT -: keytrack base note down one semitone");
tipAt(772, 175, 20, 18, "ROOT +: keytrack base note up one semitone");
tipAt(800, 175, 74, 18, "DETECT: finds the BODY pitch and sets ROOT to it|Writes only from CONF >= 30%");

// KEYTRACK global (ID 9) + SWING-Fader (ID 53, Player-Sektion)
gfx_setfont(3); colInk(1); xstr(664, 209, "KEYTRK");
gfx_setfont(5);
toggle(702, 205, 42, 16, pgb[PG_KTRK] > 0.5, pgb[PG_KTRK] > 0.5 ? "ON" : "OFF")
  ? ( pgb[PG_KTRK] = 1 - pgb[PG_KTRK]; );
tipAt(702, 205, 42, 16, "KEYTRK: played notes transpose the kick relative to ROOT|OFF = every note sounds at the ROOT pitch");
gfx_setfont(3); colInk(1); xstr(752, 209, "SWING");
// v0.12.0 (P21): Kit-hslider (ID 53, Player-Sektion 50..60) statt Hand-Fader;
// CTRL-/Rechts-/Doppelklick = 0 % (= ctlDef(53)), Shift = fein, Rad eingebaut
nv = hslider(53, 786, 203, 60, 11, pgb[PG_SWING]*0.01, 0, 1, 0);
// Review zcode 17.10.2026 (B2): Schreibschutz gegen Float-Roundtrip x*0.01*100
abs(nv*100 - pgb[PG_SWING]) > 0.001 ? ( pgb[PG_SWING] = min(100, max(0, nv*100)); );
tipAt(782, 202, 68, 16, "SWING: delays the off-grid eighths, 0-100%|66.7% lands on the triplet point|CTRL+click: reset");
gfx_setfont(5); colInk(1); xat(850, 207);
gfx_printf("%d%%", floor(pgb[PG_SWING] + 0.5));

// Detect-Ergebniszeile: Quelle (SMP/SYN), erkannte Note, Cent-
// Abstand (+-50 zum Halbtonraster), Hz, Konfidenz = Peakhoehe
gfx_setfont(5);
detSt == 1 ? (
  colInk(0.9); xat(664, 226);
  detSrc == 1 ? gfx_printf("SMP") : gfx_printf("SYN");
  noteStr(detNote);
  colAcid(1); xat(690, 226); gfx_drawstr(#vstr);
  colInk(0.9); xat(716, 226);
  ctR = detCt >= 0 ? floor(detCt + 0.5) : -floor(0.5 - detCt);
  ctR >= 0 ? gfx_printf("+%dCT", ctR) : gfx_printf("%dCT", ctR);
  xat(760, 226); gfx_printf("%dHZ", floor(detHz + 0.5));
  xat(800, 226); gfx_printf("CONF %d%%", floor(detCf*100 + 0.5));
) : detSt == 2 ? ( colInk(0.9); xstr(664, 226, "DETECT: BODY TOO SHORT"); )   // P26 (Schriftstufen): kuerzer, ab +2 ueber den Panelrand.
  : detSt == 3 ? ( colInk(0.9); xstr(664, 226, "DETECT: NO BODY SIGNAL"); )
  : detSt == 4 ? ( colInk(0.9); xstr(664, 226, "DETECT: LOADING - TRY AGAIN"); )
  : 0;
detSt > 0 ? tipAt(664, 224, 210, 13, "DETECT result: source (SMP sample / SYN synth), note, cents, Hz and CONF = confidence|ROOT is only written from CONF >= 30%");

// Laufstatus
gfx_setfont(5);
pgb[PG_ON] > 0.5 ? (
  plSync ? (
    plRun ? (
      colAcid(1);
      sprintf(#vstr, "SYNCED  BAR %d.%d", floor(plPos*0.125) + 1,
              floor(plPos*0.5) - floor(plPos*0.125)*4 + 1);
      xstr(664, 240, #vstr);
    ) : ( colInk(1); xstr(664, 240, "SYNC - WAITING FOR TRANSPORT"); );
  ) : (
    colAcid(1);
    sprintf(#vstr, "FREE RUN  %d BPM", floor(bpmNow + 0.5));
    xstr(664, 240, #vstr);
  );
// P26 (Schriftstufen, p26_fontcheck.py): 28 statt 32 Zeichen (ab +1 ueber den Panelrand 884).
) : ( colInk(1); xstr(664, 240, "STOPPED - KICK ON THE GRID"); );

// BPM -> ms-Referenz (v0.8.0, Mini-"bpm2ms"): live mit dem Host-Tempo
// (bpmNow aus @block, Fallback 120). Viertel = 60000/BPM ms; reine
// Anzeige ohne Regler und Drag-IDs.
bpmR = bpmNow > 10 ? bpmNow : 120;
tipAt(664, 236, 210, 14, "Player status: SYNCED BAR n.m, FREE RUN n BPM, or waiting for the transport");
tipAt(664, 261, 210, 36, "BPM reference: note lengths in ms at the host tempo (120 BPM if none is reported)|Handy for lane lengths and crossfades");
colDim(1); xline(664, 257, 872, 257);
gfx_setfont(5);
colAcid(1); xat(664, 266);
gfx_printf("1/4 @ %.1f = %.1f MS", bpmR, 60000/bpmR);
colInk(0.6); xat(664, 283);
gfx_printf("1/2 = %.1f   1/8 = %.1f MS", 120000/bpmR, 30000/bpmR);

/* ---------- Master-Rack (M4): vier echte Reglergruppen ----------
   Drag-IDs 1..15 laut Registry (PLAN.md § 4.2), belegt:
     1 = FILTER CUT   2 = FILTER RES   3 = FILTER BEEF
     4 = DRIVE BEEF   5 = DRIVE GLUE   6 = CLIP CEIL   7 = OUT GAIN
     8 = DETECT (M5)  9 = KEYTRK (M5)  10 = CLIP MODE (Combo, v0.12.0)
     11 = RATE (Combo, Player)  12..15 Master-Reserve.
   v0.12.0 (P21): Regler als Kit-knob2 in Drum-Synth-Zellen (Label Font 5
   ueber dem Regler, Wert in Acid darunter), ON/PROT als Kit-toggle,
   SOFT/HARD als Kit-combo. Schalter sind Klicks; die M5-Klicks sitzen im
   Player-Panel. Alle Werte leben in M_SLI (msb) - die gedaempfte
   Audio-Wirkung uebernimmt im @sample der Zielwert-Lerp, hier wird nur
   geschrieben (Promille-Quantisierung weiter ueber mPm, OUT-Gain auf der
   exakten 1/48-Skala). */
// v0.8.0: Der Player-Block ist um 34 px gewachsen (Rack rueckt 32 nach unten, 8 px Abstand). Statt ~60 Y-Literale
// im Rack umzuschreiben, wird das Raster fuer den Rack-Block um MOFF
// nach unten verschoben (Zeichnen ueber OY, Maus ueber mY) - alle
// Koordinaten unten bleiben die Eigenkoordinaten des Racks (Panel bei
// 236, Registry unveraendert). Zurueckgesetzt nach dem Meterbalken.
// v0.9.2: Rack 236 -> 308 (MOFF 72) und 190 -> 212 hoch.
// Werte rechts, Regler x 700..824) - jetzt zwei knob2-Zellenreihen.
MOFF = 72;
OY += MOFF*SC; mY -= MOFF;
panel2(652, 236, 232, 212, "MASTER");
msb = M_SLI;
mpd = 20*log(max(0.00001, mPeak))*0.43429448;      // Peak dBFS
mrd = 20*log(max(0.00001, sqrt(mRms)))*0.43429448; // RMS dBFS
// Peak/RMS in die Titelzeile
gfx_setfont(5); colInk(1);
mpd >= 0 ? gfx_printf("PK +%.1f", mpd) : gfx_printf("PK %.1f", mpd);
// P26 (Schriftstufen, p26_fontcheck.py): x 820 -> 806: "RMS -100.0" endete bei Stufe 0 bei 886 (Panel 884).
xat(806, 241); gfx_printf("RMS %.1f", mrd);
tipAt(652, 237, 232, 21, "MASTER readout: PK = peak, RMS = average level of the output, in dBFS|The meter bar at the bottom of the rack shows the same values");

// --- Schalterzeile: FILTER ON / DRIVE ON / PROT (Klicks)
gfx_setfont(5);
toggle(664, 262, 76, 16, msb[MS_FON] > 0.5, "FILTER ON")
  ? ( msb[MS_FON] = 1 - msb[MS_FON]; );
toggle(746, 262, 68, 16, msb[MS_DON] > 0.5, "DRIVE ON")
  ? ( msb[MS_DON] = 1 - msb[MS_DON]; );
toggle(820, 262, 58, 16, msb[MS_DPROT] > 0.5, "PROT")
  ? ( msb[MS_DPROT] = 1 - msb[MS_DPROT]; );
tipAt(664, 262, 76, 16, "FILTER ON/OFF: resonant low-pass on the summed kick");
tipAt(746, 262, 68, 16, "DRIVE ON/OFF: bass-band drive + sum saturation");
tipAt(820, 262, 58, 16, "PROT (punch protect): BEEF drives only the bass band|Off = the drive hits the full signal");

// --- FILTER: CUT/RES/BEEF (IDs 1..3) als knob2-Zellen (cy 308, r 13)
nv = knob2(1, 686, 308, 13, msb[MS_FCUT]*0.001, 0, 1, ctlDef(1)*0.001);
msb[MS_FCUT] = mPm(nv, msb[MS_FCUT]);
nv = knob2(2, 754, 308, 13, msb[MS_FRES]*0.001, 0, 1, ctlDef(2)*0.001);
msb[MS_FRES] = mPm(nv, msb[MS_FRES]);
nv = knob2(3, 822, 308, 13, msb[MS_FBEEF]*0.001, 0, 1, ctlDef(3)*0.001);
msb[MS_FBEEF] = mPm(nv, msb[MS_FBEEF]);
gfx_setfont(5);
fcv = 40*exp(msb[MS_FCUT]*0.0059914645);
fcv < 1000 ? sprintf(#vstr, "%dHZ", floor(fcv + 0.5)) : sprintf(#vstr, "%.1fK", fcv*0.001);
colInk(0.9); xctr(657, 280, 58, 12, "CUT"); colAcid(1); xctr(657, 324, 58, 12, #vstr);
sprintf(#vstr, "%d%%", floor(msb[MS_FRES]*0.1 + 0.5));
colInk(0.9); xctr(725, 280, 58, 12, "RES"); colAcid(1); xctr(725, 324, 58, 12, #vstr);
sprintf(#vstr, "%d%%", floor(msb[MS_FBEEF]*0.1 + 0.5));
colInk(0.9); xctr(793, 280, 58, 12, "BEEF"); colAcid(1); xctr(793, 324, 58, 12, #vstr);
tipAt(657, 276, 58, 64, "FILTER CUT: low-pass cutoff, 40 Hz - 16 kHz|Lower = darker kick|CTRL+click: reset");
tipAt(725, 276, 58, 64, "FILTER RES: resonance at the cutoff, 0-100%|Adds a ringing peak that can tune the boom|CTRL+click: reset");
tipAt(793, 276, 58, 64, "FILTER BEEF: moves the resonance peak up to|3 octaves below the cutoff - more low weight|CTRL+click: reset");

// --- CLIP: MODE (Combo 10) + ON; die Regler DRIVE/CLIP/OUT folgen unten
gfx_setfont(5);
strcpy(#cmb_txt, msb[MS_CMODE] < 0.5 ? "SOFT" : "HARD");
nv = combo(10, 664, 342, 72, 16, floor(msb[MS_CMODE] + 0.5), 2);
nv != floor(msb[MS_CMODE] + 0.5) ? ( msb[MS_CMODE] = nv; ) : 0;
msb[MS_CON] > 0.5 ? 0 : ( gfx_set(0, 0, 0, 0.55); xrrect(664, 342, 72, 16, 3, 1); );   // CLIP aus: SOFT/HARD wirkt nicht -> abgedunkelt, bleibt bedienbar
gfx_setfont(5);                       // combo stellt Font 4 (Kit-Seiteneffekt)
toggle(742, 342, 66, 16, msb[MS_CON] > 0.5, "CLIP ON")
  ? ( msb[MS_CON] = 1 - msb[MS_CON]; );
msb[MS_CON] > 0.5
  ? tipAt(664, 342, 72, 16, "SOFT: rounded tanh clipping at the ceiling|HARD: hard clipping - louder and edgier")
  : tipAt(664, 342, 72, 16, "SOFT/HARD clip curve - no effect while CLIP is off (dimmed)|Switch CLIP ON to hear it");
tipAt(742, 342, 66, 16, "CLIP ON/OFF: ceiling clipper at the end of the chain");

// --- Reglerreihe 2 (cy 392, r 13): DRIVE BEEF/GLUE (4/5), CLIP CEIL (6), OUT GAIN (7)
nv = knob2(4, 681, 392, 13, msb[MS_DBEEF]*0.001, 0, 1, ctlDef(4)*0.001);
msb[MS_DBEEF] = mPm(nv, msb[MS_DBEEF]);
nv = knob2(5, 739, 392, 13, msb[MS_DGLUE]*0.001, 0, 1, ctlDef(5)*0.001);
msb[MS_DGLUE] = mPm(nv, msb[MS_DGLUE]);
nv = knob2(6, 797, 392, 13, msb[MS_CCEIL]*0.001, 0, 1, ctlDef(6)*0.001);
msb[MS_CCEIL] = mPm(nv, msb[MS_CCEIL]);
nv = knob2(7, 855, 392, 13, (msb[MS_OUTG] + 24)/48, 0, 1, 0.5);
// Nur bei tatsaechlicher Aenderung schreiben (v0.7.1, Finding 3):
// ungeschuetzt schrieb der Fader pro Frame Rundungsmuell (~-0,6 dB/
// Std Drift, 0 dB nie exakt, jede Klick-Klammer unterschied mark und
// commit -> Undo-Flut). Exakte 1/48-Skala: nv*48-24 ist in der
// Mittenraste bitgenau 0 dB.
nv*48 - 24 != msb[MS_OUTG] ? ( msb[MS_OUTG] = nv*48 - 24; ) : 0;
gfx_setfont(5);
sprintf(#vstr, "%d%%", floor(msb[MS_DBEEF]*0.1 + 0.5));
colInk(0.9); xctr(652, 364, 58, 12, "BEEF"); colAcid(1); xctr(652, 408, 58, 12, #vstr);
sprintf(#vstr, "%d%%", floor(msb[MS_DGLUE]*0.1 + 0.5));
colInk(0.9); xctr(710, 364, 58, 12, "GLUE"); colAcid(1); xctr(710, 408, 58, 12, #vstr);
sprintf(#vstr, "%.1fDB", (msb[MS_CCEIL]*0.001 - 1)*36);
colInk(0.9); xctr(768, 364, 58, 12, "CEIL"); colAcid(1); xctr(768, 408, 58, 12, #vstr);
msb[MS_OUTG] >= 0 ? sprintf(#vstr, "+%.1fDB", msb[MS_OUTG])
                  : sprintf(#vstr, "%.1fDB", msb[MS_OUTG]);
colInk(0.9); xctr(826, 364, 58, 12, "GAIN"); colAcid(1); xctr(826, 408, 58, 12, #vstr);
tipAt(652, 360, 58, 64, "DRIVE BEEF: saturates the bass band (~140 Hz), 0-100%|Thickens the body, the top stays clean|CTRL+click: reset");
tipAt(710, 360, 58, 64, "DRIVE GLUE: saturates the whole sum, 0-100%|Also touches the punch - glues the tail|CTRL+click: reset");
tipAt(768, 360, 58, 64, "CLIP CEIL: clipper ceiling, -36 to 0 dBFS|Lower = louder, flatter peaks|CTRL+click: reset");
tipAt(826, 360, 58, 64, "OUT GAIN: final level, -24 to +24 dB|The knob resets to 0 dB|CTRL+click: reset");

// Meter: RMS-Fuellbalken (dim) + Peak-Tick (hell), 0 dBFS am Rand
pkF  = min(1, max(0, (mpd + 60)*0.01666667));
rmsF = min(1, max(0, (mrd + 60)*0.01666667));
kTb(0.092, 0.097, 0.092, 1); xrect(664, 428, 208, 6);
rmsF > 0 ? ( tth_tn(0.14, 0.36, 0.10, 1); xrect(664, 428, 208*rmsF, 6); ) : 0;
mpd > -0.1 ? gfx_set(0.9, 0.15, 0.08, 1) : colAcid(1);
xrect(min(870, 664 + pkF*208), 425, 2, 12);
tipAt(664, 425, 208, 12, "METER: RMS fill with a peak tick, -60 to 0 dBFS|The tick turns red when the peak reaches 0 dBFS");
OY -= MOFF*SC; mY += MOFF;      // Rack-Raster zurueck

// ---------- Ausgangs-Oszi (hinter der Kette, post OUT-Gain) ----------
// v0.8.0: Panel 430..520 (h 90) -> 462..520 (h 58), Box 56 -> 34 hoch,
// Mittellinie 480 -> 497, Amplitude 24 -> 15 px.
//           xline(664, 480, 872, 480); syp = OY + (480 - ... *24)*SC
// v0.9.2: Panel 528..640 (h 112), Box 546..632 (86 hoch), Mittellinie 589,
// Amplitude 15 -> 38 px.
// 208, 34); Mittellinie 497; Amplitude 15.
// v0.12.0 (P21): panel2 mit Titelzeile; Box 550..632 (82 hoch), Mittellinie 591.
// v1.0.0: Panel bis 668 (h 140), Box 550..660 (h 110), Mittellinie 605, Amplitude 50 - buendig mit FUSION
panel2(652, 528, 232, 140, "OUT SCOPE");
kTb(0.042, 0.048, 0.042, 1); xrect(664, 550, 208, 110);
tth_tn(0.10, 0.13, 0.08, 1); xline(664, 605, 872, 605);
tipAt(652, 528, 232, 140, "OUT SCOPE: waveform of the output after the whole chain, post OUT GAIN|Display only");
colAcid(1);
gi = 0;
loop(128,
  sxp = OX + (665 + 206*gi/127)*SC;
  sv  = M_SCOPE[(scopePos + gi*4) % 512];
  syp = OY + (605 - max(-1.1, min(1.1, sv))*50)*SC;
  gi == 0 ? ( gfx_x = sxp; gfx_y = syp; ) : gfx_lineto(sxp, syp, 1);
  gi += 1;
);

) : (

// ---------- SYSTEM-Seite (M6) ----------
// PHALYX-Tab-Muster: gleiche Kopfzeile, der Content wechselt.
// Links: Werks-Presets + Undo + Export-Hinweis; rechts: Status,
// Navigationshinweis und Build-Info.

// SYS-Seite auf die 700er Flaeche verteilt; panel2-Panels mit Titelzeile.
panel2(16, 76, 430, 164, "FACTORY PRESETS");
gfx_setfont(2);
// 44 Werks-Presets -> Tabs (INIT + 8 Kategorien) plus Liste der gewaehlten Kategorie;
// die Panelgeometrie bleibt (76 / 164).
// psCat = gewaehlte Kategorie (reiner UI-Zustand, nicht serialisiert); folgt
// dem geladenen Preset, sobald sich dieses aendert (Stepper, Klick, Undo).
psCat < 1 ? ( psCat = 1; ) : 0;
pset != psCatP ? ( psCatP = pset; pset > 0 ? ( psCat = psetCat(pset); ); ) : 0;
gfx_setfont(3);
psTab(28,  40, 0, "INIT");
psTab(70,  33, 1, "909");
psTab(105, 33, 2, "808");
psTab(140, 40, 3, "HARD");
psTab(182, 54, 4, "RUMBLE");
psTab(238, 61, 5, "MINIMAL");
psTab(301, 40, 6, "DEEP");
psTab(343, 40, 7, "ROLL");
psTab(385, 40, 8, "CHAR");
tipAt(28, 108, 40, 20, "INIT: factory state, pure synth on all lanes|Undoable, kit paths stay");
tipAt(70, 108, 33, 20, "909: short click, punchy body, little tail|Click to list its presets");
tipAt(105, 108, 33, 20, "808: soft body, long almost pure sine tail|Click to list its presets");
tipAt(140, 108, 40, 20, "HARD: driven and clipped, loud|Click to list its presets");
tipAt(182, 108, 54, 20, "RUMBLE: long, low-tuned tails with room|Click to list its presets");
tipAt(238, 108, 61, 20, "MINIMAL: naked club kicks, short and dry|Click to list its presets");
tipAt(301, 108, 40, 20, "DEEP: sub-focused, melodic, soft|Click to list its presets");
tipAt(343, 108, 40, 20, "ROLL: very short kicks for rolling patterns|Click to list its presets");
tipAt(385, 108, 40, 20, "CHAR: characters - glide, reverse, warehouse, classic|Click to list its presets");
gfx_setfont(2);
psSl = 0; psI = 1;
loop(44,
  psetCat(psI) == psCat ? (
    psX = 28 + (psSl % 2)*205;
    psY = 134 + floor(psSl*0.5)*24;
    psetName(psI);
    btn(psX, psY, 201, 20, pset == psI, #pstr) ? kkLoadF(psI);
    inBox(psX, psY, 201, 20) ? (
      sprintf(#psTip, "%s|Loads the full state (undoable), kit paths stay", #pstr);
      tip(#psTip);
    );
    psSl += 1;
  );
  psI += 1;
);

panel2(16, 252, 430, 110, "UNDO");
btn(28, 284, 96, 26, undN > 0, "UNDO") ? undoPop();
tipAt(28, 284, 96, 26, "UNDO: step back one edit (20 states)|No redo");
tipAt(136, 286, 150, 18, "SAVED: undo states held in the ring, 20 at most");
gfx_setfont(4);
undN > 0 ? colAcid(1) : colInk(1);
xat(140, 292); gfx_printf("%d / %d SAVED", floor(undN), UND_N);
gfx_setfont(5); colInk(0.85);
xstr(28, 322, "SNAPSHOT RING - PUSHED WHEN A DRAG OR AN EDIT BUTTON");
xstr(28, 335, "ENDS. PRESET CHANGES AND THIS UNDO ARE UNDOABLE.");

panel2(16, 374, 430, 100, "EXPORT");
gfx_setfont(5); colInk(0.85);
xstr(28, 406, "RENDER THE KICK TO AN ITEM: ACTIONS -> RUN");
xstr(28, 420, "'TT-KICK Export Kick.lua' - 4 BARS AT CURSOR (OR THE");
xstr(28, 434, "TIME SELECTION) -> TTKICK_<PRESET>.WAV ON THIS TRACK");
tipAt(16, 374, 430, 100, "EXPORT: no button here - run the action TT-KICK Export Kick.lua|Renders 4 bars at the cursor (or the time selection) to a WAV item on this track");

// v0.9.0: Oberflaechen-Schalter. TOOLTIPS (PG_TIPS, serialisiert) -
// Klick-Stil wie die anderen Schalter; reine UI, kein Undo-Eintrag.
panel2(16, 486, 430, 110, "INTERFACE");
// P25 (Harmonisierung Punkt 3): der zweite Schalter ist aus der Front entfernt - massgeblich ist allein OPTIONS >
// TOOLTIPS (tth_tipoff). Hier steht nur noch der Zustand als Anzeige (kein Klick).
gfx_setfont(2);
tth_tipoff ? colInk(1) : colAcid(1);
xstr(28, 520, tth_tipoff ? "TOOLTIPS OFF" : "TOOLTIPS ON");
gfx_setfont(5); colInk(0.85);
xstr(28, 538, "SET IN OPTIONS");
tipAt(28, 516, 150, 34, "TOOLTIPS: state of the hover hints - switch them in OPTIONS (header) > TOOLTIPS ON / OFF|Saved per instance with the project");
gfx_setfont(5); colInk(0.85);
xstr(190, 518, "HOVER A CONTROL FOR A HINT.");
xstr(190, 534, "CTRL+CLICK: RESET TO DEFAULT.");
xstr(190, 550, "RAND: ROLL A LANE (CTRL = INIT).");
xstr(190, 566, "MAX: BLOW UP ONE LANE (VIEW ONLY).");

panel2(458, 76, 426, 520, "STATUS");
tipAt(458, 76, 426, 520, "STATUS: read-only readout of sample rate, state format, sample RAM, kit, last trigger, player, swing, keytrack and preset|Nothing on this panel is clickable");
gfx_setfont(4); colInk(1);
xat(470, 108); gfx_printf("SAMPLE RATE  %d HZ", floor(srate));
xat(470, 126); gfx_printf("SERIALIZE    'KICK' V%d - 994 WORDS", kickVer);
ramW = 0;
gi = 0;
loop(3, qmt = M_GEN + 32 + gi*16; ramW += qmt[SM_LEN]; gi += 1; );
xat(470, 144); gfx_printf("SAMPLE RAM   %d W (+UNDO HEAD %d W)",
  floor(ramW), UNDSZ);
xat(470, 162); gfx_printf("KIT          %d / 3 SLOTS", kitN);
xat(470, 180);
trigSrc == 1 ? gfx_printf("LAST TRIG    MIDI")
: trigSrc == 2 ? gfx_printf("LAST TRIG    PLAYER")
: trigSrc == 3 ? gfx_printf("LAST TRIG    LANE")
: gfx_printf("LAST TRIG    -");
trigNote >= 0 ? (
  noteStr(trigNote);
  colAcid(1); xat(610, 180); gfx_drawstr(#vstr); colInk(1);
) : 0;
xat(470, 198);
pgb[PG_ON] > 0.5 ? (
  plSync ? (
    plRun ? gfx_printf("PLAYER       SYNCED  BAR %d.%d",
      floor(plPos*0.125) + 1,
      floor(plPos*0.5) - floor(plPos*0.125)*4 + 1)
    : gfx_printf("PLAYER       SYNC - WAITING FOR TRANSPORT");
  ) : gfx_printf("PLAYER       FREE RUN  %d BPM", floor(bpmNow + 0.5));
) : gfx_printf("PLAYER       OFF");
xat(470, 216); gfx_printf("SWING        %d %%", floor(pgb[PG_SWING] + 0.5));
xat(470, 234); gfx_printf("KEYTRACK     ");
pgb[PG_KTRK] > 0.5 ? ( colAcid(1); gfx_drawstr("ON"); )
                 : ( colInk(1); gfx_drawstr("OFF"); );
colInk(1);
xat(470, 252); gfx_printf("PRESET       ");
psetName(pset);
psetMod ? colInk(1) : colAcid(1);
gfx_drawstr(#pstr);
psetMod ? gfx_drawstr("*") : 0;

colDim(1); xline(470, 274, 872, 274);
gfx_setfont(3); colAcid(1); xstr(470, 286, "NAVIGATION");
gfx_setfont(5); colInk(0.85);
xstr(470, 302, "TABS MAIN / WAVE / SYS IN THE HEADER");
xstr(470, 315, "SHIFT+SPACE TYPES A BLANK IN NAME BOXES");

colDim(1); xline(470, 336, 872, 336);
gfx_setfont(3); colAcid(1); xstr(470, 348, "BUILD");
gfx_setfont(5); colInk(0.85);
// P25 (Punkt 6): Version aus #tt_ver (kein zweites Literal; das "v" ist jetzt klein - EEL2 hat kein strupper)
sprintf(#vstr, "TT-KICK %s - MIT LICENSE", #tt_ver);
xstr(470, 364, #vstr);
xstr(470, 377, "REAPER 7.X - JSFX");
xstr(470, 390, "MIRRORS: SLIDER 63 = ROOT NOTE, 64 = PRESET INDEX (LUA)");

colDim(1); xline(470, 412, 872, 412);
gfx_setfont(3); colAcid(1); xstr(470, 424, "MIDI / SYNC");
gfx_setfont(4); colInk(1);
xat(470, 442); gfx_printf("GRID         4/4 - RATE ");
pgb[PG_RATE] < 0.5 ? gfx_drawstr("1/1")
: pgb[PG_RATE] < 1.5 ? gfx_drawstr("1/2")
: pgb[PG_RATE] < 2.5 ? gfx_drawstr("1/4")
: gfx_drawstr("1/8");
xat(470, 460); gfx_printf("MIDI         NOTES IN = TRIGGER, CC/PB/CLK = THRU");
gfx_setfont(5); colInk(0.6);
xat(470, 482); gfx_printf("SWING SHIFTS OFF-GRID 8THS - RATES 1/1..1/4 STAY ON-GRID");

colDim(1); xline(470, 500, 872, 500);
gfx_setfont(3); colAcid(1); xstr(470, 510, "FACTORY KICKS");
gfx_setfont(5); colInk(0.85);
xstr(470, 526, "ALL FACTORY KICKS ARE PURE SYNTH (SG_MODE=0) -");
xstr(470, 539, "LICENSE-FREE, NO SAMPLES REQUIRED.");
colInk(0.6);
xstr(470, 556, "USER PRESETS: REAPER FX-CHAIN PRESETS (.RPL) -");
xstr(470, 569, "THE FULL STATE RIDES IN @SERIALIZE (LINE PATTERN)");
// v0.9.5: Hinweis auf den Lane-Preset-Browser
colInk(0.85);
xstr(470, 586, "LANE PRESETS: < > STEPPER + NAME-CLICK LIST IN EVERY LANE HEADER");

);   // Seitenende

// ---------- Fusszeile ----------
// v0.9.2: Fusszeile am unteren Rand
colDim(1); xline(0, 672, UI_W, 672);
gfx_setfont(3);
colAcid(0.9); xstr(16, 680, "KICK MACHINE");
colInk(0.8);
// P26 (Schriftstufen, p26_fontcheck.py): ohne "PHASE-LOCKED SYNTH" (lief ab +2 in die Versionsangabe bei 660).
// v1.0.0 (Wellenansicht): auf der Seite WAVE scrollt SHIFT+Rad und ein Klick spielt die ganze Kick
pgb[PG_PAGE] > 1.5 ? xstr(170, 680, "DRAG FLAGS + DIAMONDS  //  WHEEL ZOOM  SHIFT SCROLL  //  CLICK PLAYS")
                   : xstr(170, 680, "DRAG FLAGS + DIAMONDS  //  WHEEL ZOOM  SHIFT SKEW  //  CLICK AUDITION");
// P25 (Punkt 6): Version aus #tt_ver, Position und Schrift unveraendert
sprintf(#vstr, "TT-KICK %s", #tt_ver);
colInk(0.6); xstr(660, 680, #vstr);

// P25: Commit der Mausrad-Klammer (Mark oben nach dem Modal-Schluckblock). undoCommit schreibt nur bei echtem
// Unterschied und meldet dann den Host (tt_undo).
kkWhUnd ? undoCommit() : 0;

// Tooltip-Panel (v0.9.0): allerletzte Zeichnung, damit es ueber allem
// liegt. Nur bei aktivem Schalter, gesetztem Text und ohne laufenden Drag.
// v0.9.1: waehrend eines Poti-Drags kein Tooltip (die Potis nutzen kein
// dragId, das tip()/tipDraw sonst stumm schaltet) - der Text der laufenden
// Frames wird hier verworfen, die Werte stehen ja im Poti selbst.
// v0.12.3 (P23): Preset-Leiste und OPTIONS-Button (Maus dort maskiert) per echter Maus; tipDraw schweigt bei tth_tipoff
// P25 (Punkt 2/3): EIN Schalter (tth_tipoff); die Kopfzeile (Preset-Leiste je Element, OPTIONS) uebernimmt das Kit:
// tt_modtips() + tt_tipflush() direkt danach.
kbDrag >= 0 ? strcpy(#tTipTxt, "") : 0;
// Review 14.10.2026 (Kit 7, Codex F3/F4): das Panel zeichnet jetzt nach Preset-Leiste und OPTIONS (unten, vor tt_modtips),
// damit die Kopfzeile es nicht ueberdeckt; offene Overlays maskieren die Maus der Front, dann gibt es keinen Text.
// Verweilzeit 0,35 s wie tt_tipflush: Zeitpunkt merken, wenn sich der Text aendert.
strcmp(#tTipTxt, #kkTipLst) != 0 ? ( strcpy(#kkTipLst, #tTipTxt); kkTipT0 = time_precise(); );

// P25 (Harmonisierung Punkt 2): Sollform des Frameendes - Kit-Tooltips der Kopfzeile, dann Preset-Leiste, dann
// OPTIONS, uikit_end zuletzt. tt_tipflush zeichnet nur, wenn tt_modtips etwas gemeldet hat (die Front meldet ihre
// Tooltips ueber das eigene Panel oben, nicht ueber tt_hov).
 

// v0.11.0 (P17): Preset-Leiste (Zeile 2 der Kopfzeile, links neben OPTIONS), vor tth_post.
kkPbA = tt_pb_post(OX + KK_PBX*SC, OY + 41*SC, SC);
kkPbA == 1 ? ( undoMark(); applyPatch(tt_pb_arg); kkFitAfter(); undoCommit(); )
: kkPbA == 2 ? ( tt_pb_fetch(tt_pb_arg) > 0 ? ( undoMark(); kkPbApply(); kkFitAfter(); undoCommit(); ); )
: kkPbA == 3 ? ( kkPbCapture(); tt_pb_commit(tt_pb_arg, KK_PSW); );
// Review 30.10.2026 (3): armierte Klick-Klammer behaelt den Zustand VOR dem SYS-Preset.
// Historie: kkFitReq > 0 ? ( undoMark(); kkFitAfter(); undoCommit(); );
kkFitReq > 0 ? ( undArm != 1 ? undoMark(); kkFitAfter(); undoCommit(); );   // v1.0.0: Ladewege ausserhalb der Leiste (SYS-Seite, Test-Queue)
tt_pb_track(kkPbSum(0));

// Test-Schnittstelle (versteckte Slider 66..69), Auswertung und Ausgabe im @gfx-Thread (@block/@sample bleiben unberuehrt):
// 11 Belegung / aktuelles Preset (Kind*1000 + Index), 12 Slot-Pruefsumme (Q IDX = Slot) / belegt, 13 Zustandssumme (float32) / Stern,
// 14 speichern (Slot Q IDX), 15 Slot laden, 16 Werks-Preset laden (Q IDX), 17 INIT, 18 Namenssumme (Slot),
// 19 Abweichungen Zustand <-> Slot (Q IDX), 20 lebendes Zustandswort (Pufferindex Q IDX, 1..63 nur bis 63), 21 Bank-Adressen,
// P26: 22 Player-Kopf setzen, 23 Stimmen zaehlen, 24 Kit-Slot lesen (siehe unten).
// P25 (Harmonisierung Punkt 7, Review A14): die schreibenden/zerstoerenden Kommandos 14..17 (Slot speichern, Slot
// laden, Werks-Preset laden, INIT) laufen nur mit Test-Freigabe tt_testok() (gmem[5189] = 20261001 im Namespace
// ttkk, Theme-Modul). Ohne Freigabe wird das Kommando verworfen: Ausgaenge 0, Q CMD auf 0 (Quittung wie bisher) -
// eine Automation, Modulation oder ein MIDI-Learn auf Q CMD kann so weder Bank noch Klang aendern. Die lesenden
// Kommandos bleiben frei (kein Nutzerzustand). tth_test gibt es in TT-KICK nicht (die Theme-Testbefehle laufen im
// Modul ebenfalls nur mit tt_testok()).
slider66 != 0 ? (
  kkQc = floor(slider66); kkQi = floor(slider67) & 31; kkQa = 0; kkQb = 0;
  // P26: 22 (Player-Kopf setzen) schreibt ebenfalls und braucht die Freigabe (v0.13.1: ebenso 25, ROOT setzen).
  // v1.0.0 (Wellenansicht): 28 (Ansichtsschalter) und 29 (Seite) schreiben ebenfalls.
  (((kkQc >= 14 && kkQc <= 17) || kkQc == 22 || kkQc == 25 || kkQc == 28 || kkQc == 29) && !tt_testok()) ? ( kkQc = 0; );
  kkQc == 11 ? ( kkQa = tt_pb_count(); kkQb = tt_pb_curKind*1000 + tt_pb_cur; )
  : kkQc == 12 ? (
      kkQs = 0; kkQj = 0; kkQd = tt_pb_data + kkQi*KK_PSW;
      loop(KK_PSW, kkQs += kkQd[kkQj]*(kkQj + 1); kkQj += 1; );
      kkQa = kkQs; kkQb = tt_pb_used[kkQi];
    )
  : kkQc == 13 ? ( kkQa = kkPbSum(1); kkQb = tt_pb_mod; )
  : kkQc == 14 ? ( kkPbCapture(); tt_pb_defname(kkQi); tt_pb_commit(kkQi, KK_PSW); )
  // Review 30.10.2026 (3): Queue laeuft NACH dem zentralen Fit; Laden und Fit hier gemeinsam klammern.
  // Historie: : kkQc == 15 ? ( tt_pb_fetch(kkQi) > 0 ? ( undoMark(); kkPbApply(); undoCommit(); tt_pb_select(2, kkQi); ); )
  // Historie: : kkQc == 16 ? ( kkLoadF(min(44, floor(slider67))); )
  // Historie: : kkQc == 17 ? ( kkLoadF(0); )
  : kkQc == 15 ? ( tt_pb_fetch(kkQi) > 0 ? ( undoMark(); kkPbApply(); kkFitAfter(); undoCommit(); tt_pb_select(2, kkQi); ); )
  : kkQc == 16 ? ( undoMark(); kkLoadF(min(44, floor(slider67))); kkFitAfter(); undoCommit(); )
  : kkQc == 17 ? ( undoMark(); kkLoadF(0); kkFitAfter(); undoCommit(); )
  : kkQc == 18 ? (
      kkQs = 0; kkQj = 0; kkQd = tt_pb_names + (tt_pb_nfac + kkQi)*TTPB_NW;
      loop(TTPB_NW, kkQs += kkQd[kkQj]*(kkQj + 1); kkQj += 1; );
      kkQa = kkQs;
    )
  : kkQc == 19 ? (
      kkPbCapture(); kkQs = 0; kkQj = 1; kkQd = tt_pb_data + kkQi*KK_PSW;
      loop(224, kkPbSkip(kkQj) ? 0 : ( tt_pb_q(tt_pb_buf[kkQj]) != kkQd[kkQj] ? kkQs += 1; ); kkQj += 1; );
      kkQa = kkQs; kkQb = tt_pb_used[kkQi];
    )
  : kkQc == 20 ? ( kkQa = kkPbWord(max(1, min(224, floor(slider67)))); )
  : kkQc == 21 ? ( kkQa = tt_pb_data; kkQb = tt_pb_end; )
  // P26 (Tests p26_test.lua): 22 Player-Kopf setzen (Q IDX Bit 0 = ON, Bit 1..2 = RATE 0..3, Bit 3 = SYNC; mit Freigabe),
  // 23 klingende/belegte Stimmen (Q A = VX_ON-Zaehlung, Q B = VX_N), 24 Kit-Slot Q IDX (0..2): Q A = Pfadlaenge, Q B = SM_FLAG.
  // Q IDX wird hier ungekuerzt gelesen (kkQi ist auf 0..31 maskiert).
  : kkQc == 22 ? ( kkQj = floor(slider67); M_GEN[PG_ON] = kkQj & 1; M_GEN[PG_RATE] = (kkQj >> 1) & 3; M_GEN[PG_SYNC] = (kkQj >> 3) & 1;
                   kkQa = M_GEN[PG_ON]; kkQb = M_GEN[PG_RATE]; )
  // v0.13.1: 25 ROOT setzen (Q IDX = Note 0..127, mit Freigabe) - Test fuer "Werks-Preset behaelt ROOT"; Q A = ROOT
  : kkQc == 25 ? ( M_GEN[PG_ROOT] = min(127, max(0, floor(slider67 + 0.5))); kkQa = M_GEN[PG_ROOT]; )
  : kkQc == 23 ? ( kkQs = 0; kkQj = 0; loop(VX_N, kkQd = VX_POOL + kkQj*VX_STR; kkQd[VX_ON] > 0.5 ? kkQs += 1; kkQj += 1; ); kkQa = kkQs; kkQb = VX_N; )
  : kkQc == 24 ? ( kkQd = M_PATH + min(2, kkQi)*256; kkQs = 0; loop(255, kkQd[kkQs] > 0 ? kkQs += 1; ); kkQa = kkQs;
                   kkQd = M_GEN + 32 + min(2, kkQi)*16; kkQb = kkQd[SM_FLAG]; )
  // v1.0.0 (Wellenansicht, Tests wv_test.lua): 26 Spur Q IDX (0..2 Lane, 3 Summe) des vorderen Vorschau-Puffers: Q A = Frames,
  // Q B = Peak x 1000. 27 Zustand: Q A = Lauf-Nr (wvVer), Q B = gueltig*10 + laufend (wvSt). 28 Ansichtsschalter setzen (Q IDX
  // = PG_WVUI 0..1023, mit Freigabe), Q A = PG_WVUI. 29 Seite setzen (Q IDX 0 MAIN / 1 SYS / 2 WAVE, mit Freigabe). 30 Spur Q IDX:
  // Q A = Start in der Kette (Frames), Q B = Frames je Bucket. 31 Spur Q IDX: Q A = Summe |max| + |min| je Bucket x 1000 (Inhaltsprobe),
  // Q B = Bucket-Anzahl.
  : kkQc == 26 ? ( kkQd = WV_META + wvFront*64 + 8 + min(3, kkQi)*8; kkQa = kkQd[1]; kkQb = floor(kkQd[5]*1000 + 0.5); )
  : kkQc == 27 ? ( kkQd = WV_META + wvFront*64; kkQa = wvVer; kkQb = (kkQd[0] > 0.5)*10 + wvSt; )
  : kkQc == 28 ? ( M_GEN[PG_WVUI] = floor(slider67) & 1023; kkQa = M_GEN[PG_WVUI]; )
  : kkQc == 29 ? ( M_GEN[PG_PAGE] = min(2, max(0, floor(slider67 + 0.5))); kkQa = M_GEN[PG_PAGE]; )
  : kkQc == 30 ? ( kkQd = WV_META + wvFront*64 + 8 + min(3, kkQi)*8; kkQa = kkQd[0]; kkQb = kkQd[2]; )
  : kkQc == 31 ? (
      kkQd = WV_META + wvFront*64 + 8 + min(3, kkQi)*8; kkQb = kkQd[3];
      kkQe = WV_DAT + wvFront*WV_BUF + min(3, kkQi)*WV_TRK; kkQs = 0; kkQj = 0;
      loop(kkQb, kkQs += abs(kkQe[2*kkQj + 1]) + abs(kkQe[2*kkQj]); kkQj += 1; );
      kkQa = floor(kkQs*1000 + 0.5);
    )
  // v1.0.0 (Wellenansicht): 32 Klick in die Welle: Q A = Zahl der ausgeloesten Kick-Anforderungen (wvKickN), Q B = offene Anforderung
  // (kickReq, 0 = vom @block schon abgeholt).
  : kkQc == 32 ? ( kkQa = wvKickN; kkQb = kickReq; );
  // Ergebnis + Quittung (Schreibweg wie slider65): Ausgaenge setzen, Kommando auf 0
  slider68 = kkQa; sliderchange(slider68); slider_automate(slider68);
  slider69 = kkQb; sliderchange(slider69); slider_automate(slider69);
  slider66 = 0; sliderchange(slider66); slider_automate(slider66);
) : 0;

// v0.10.0 (P14): OPTIONS-Button (Kopfzeile, links neben MAIN) + Farbbox als allerletzte Zeichnung.
// Button 70x17 im Designraster bei (610, 41); Fensterpixel = OX + x*SC.
tthC = tth_post(OX + 610*SC, OY + 41*SC, SC);
tthC >= 0 ? ( slider65 = tthC; sliderchange(slider65); slider_automate(slider65); ) : 0;

// Review 14.10.2026: eigenes Tooltip-Panel nach den Overlays, erst nach 0,35 s Verweilen (siehe oben bei kkTipLst)
!tth_tipoff && dragId < 0 && strlen(#tTipTxt) > 0 && time_precise() - kkTipT0 >= 0.35 ? tipDraw() : 0;
tt_modtips(); tt_tipflush(); // 02.10.2026: nach allen Overlays
uikit_end();      // v0.12.0 (P21): schliesst die Maus-Kanten (lmbPrev/rmbPrev)
// P25 (Punkt 2): uikit_end verwirft unverbrauchtes Rad selbst (UKIT_VER 4).
