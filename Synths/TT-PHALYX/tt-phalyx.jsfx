desc:TT-PHALYX Drum Sampler v1.03
// @description TT-PHALYX Drum Sampler
// @author TimTechlor
// @version 1.03
// @license MIT
// @tags sampler instrument drums phalanx 16 pads techno
// @provides
//   front.png
//   tt-phalyx-manual.html
// @about
//   # TT-PHALYX Drum Sampler v1.03
//
//   16-pad sample player for Reaper with the feature depth of Vengeance
//   Phalanx, in the Tim-Techlor design (sibling of the TT-303 Acid
//   Machine). Triggering is MIDI only - no internal sequencer.
//
//   == THE FRONT ==
//   Top: 16 slim pads. Click selects the pad, M = mute, S = solo, the
//   fader sets the pad volume, the LED shows active voices. Center: the
//   full panel of the selected pad. A/B chooses the slot the two knob
//   rows act on (transpose, fine, gain, start, rnd offset, delay,
//   LPF/HPF/LoFi/Spike). A -> B copies slot A to slot B, PHASE inverts,
//   REV plays backwards, SCR arms the scratcher. The fader below mixes
//   A and B (crossfade). Right: the INPUT box - KIT note (kit mode,
//   channel 1) or MIDI channel 1-16 (multitrack, tonal with keytrack -
//   base = ROOT), killnote (choke), voices, one-shot vs sustain,
//   envelopes -> init, PB range.
//
//   == LOADING A KIT ==
//   The front has no file dialogs. Load a kit with the Lua script
//   "TT-PHALYX Load Kit.lua" (Actions -> Load ReaScript): pick any WAV
//   from the kit folder - the folder is sorted across the 16 pads
//   (entries 1-16 = sample A pads P01-P16, 17-32 = sample B) and
//   written to tt-phalyx-kit.bin, which the FX adopts automatically
//   every ~0.5 s. tt-phalyx-kit.txt is the readable reference. Kit
//   mode listens on channel 1 and uses the GM map (36 kick, 38 snare,
//   42/46 hats, 41/45/48 toms, ...).
//
//   == THE TABS ==
//   AMP       Amp envelope over the waveform (drag the points),
//             timescale, retrig keytrack/fade, one-shot/sustain.
//   FILTER    Type (LP/HP/BP/notch, 6/12/24 dB), cutoff, reso, env
//             mod with draggable filter ADSR, drive clean/dirty.
//   PITCH     Pitch envelope (drag the points), range in semitones,
//             step quantise, flip; portamento OFF/POLY/LEGATO.
//   FX        Master chain: 4-band EQ (band type per click +1 /
//             R-click -1, live response curve) -> 4 insert slots (each
//             type + 4 parameters + mix): DELAY, CHORUS, FLANGER,
//             PHASER, DISTORT, CRUSH, COMP, LIMIT, ROOM, TRASH, GATE,
//             STEREO.
//   LOOP      Loop editor of the selected slot: LOOP on/off, drag the
//             start/end flags, NRM/PING/XFD, ZERO (zero-crossing
//             search against clicks), XFADE length.
//   MOD       Mod matrix 8 rows (click source > target, drag amount;
//             sources VEL/KEY/G1-G3/M-X/M-Y/LFO1/LFO2/MENV/RND,
//             targets VOL/PAN/PITCH/CUTOFF/RESO/LFO1/2-RATE/XFADE),
//             2 LFOs, mod envelope, velocity depth + curve with
//             sketch, panorama per slot, GUI modifiers G1-G3.
//   MIDI/ARP  Drum kit matrix: click a key to assign it to the pad.
//             Right: the arpeggiator - mode (R-click back), shuffle
//             (drag the number = swing), octaves +/-, rate, gate.
//             Modes UP/DOWN/UP-DN/RND/ROLL (ROLL = retrigger wall,
//             e.g. for hat rolls).
//   SYSTEM    Readouts, interpolation LIN/AA (anti-alias Hermite, more
//             CPU but cleaner upshifting), IN TRANSPOSE +/-24 st
//             (in kit mode remaps the whole kit - like Phalanx),
//             POLYPHONY 4-64, SNAP/UNDO, BANKS B1-B8 (load), SYNC
//             (tempo sync: delay time and/or arp rate follow the
//             project tempo - delay 1/16 to 1/1, arp 1/4 to 1/32).
//
//   == SCRATCHER ==
//   Arm the pad with the SCR button, hold a note, grab the waveform
//   and drag - the playhead of both slots follows the position. The
//   same position is automation slider 53 (MIDI learn/modulator).
//
//   == BANKS & UNDO ==
//   A bank stores ALL pad parameters plus the FX chain; samples come
//   from the kit. Saving: Lua script "TT-PHALYX Save Bank.lua" (asks
//   for slot 1-8, writes tt-phalyx-bankN.bin). Loading: B1-B8 in the
//   SYSTEM tab. UNDO restores the pad's last state; a snapshot is also
//   taken automatically on every pad switch.
//
//   == MIDI LEARN ==
//   All parameters sit as hidden automation sliders 1-63 behind the
//   front: 3-52 mirror the selected pad, 53-63 scratch/system/arp/
//   root/PB/shuffle/sync; the FX knobs in the FX tab are separate.
//   Learn as usual via Reaper (Param -> MIDI learn / modulator).
//
//   == LIMITS VS. PHALANX ==
//   1 stereo output (Phalanx: 16 - workaround: multiple instances),
//   64 voices global (1-16 per pad), no convolution reverbs, bank
//   saving via Lua (JSFX file access is read-only), undo is one level
//   per pad.
//
// @changelog
//   1.03 (English UI)
//   - UI language: all on-screen text, the built-in manual (@about)
//     and the Lua helpers translated to English; helper scripts
//     renamed to "TT-PHALYX Load Kit" / "TT-PHALYX Save Bank"
//     (re-add them once in the action list)
//   1.02 (polish package)
//   - NEW: tempo sync (SYSTEM tab, slider 63): delay time and/or arp
//     rate follow the project tempo - delay grid 1/16 to 1/1, arp
//     grid 1/4 to 1/32 (each including triplets)
//   - NEW: slim pads draw sample B as a dark ghost contour behind
//     sample A
//   - TONE: chorus with a second voice per channel (quarter-phase
//     offset, medium mod depth); flanger feedback with HF damping
//     (~2.5 kHz one-pole)
//   1.01 (improvement package)
//   - NEW: arp shuffle 0-50 % (off-beats swing late, SHUF field in
//     the MIDI/ARP tab, automation slider 62)
//   - NEW: pitch bend with per-pad range 0-24 st (smoothed, INPUT
//     box; affects the playback rate in both trigger modes, slider 61)
//   - NEW: root note control (multitrack keytrack base, INPUT box,
//     slider 60)
//   - NEW: MIDI monitor in the status line (pitch bend/CC readout +
//     hit velocity bars per pad)
//   - NEW: predelay 0-250 ms for ROOM/TRASH/GATE (4th parameter)
//   - NEW: clip LED in the header, scratch playhead line, arp markers
//     on the slim pads
//   - FIX: debug counters no longer written into the serialized blobs
//   1.00 (release)
//   - Manual: @about with a chapter per tab (front, kit, tabs,
//     scratcher, banks/undo, MIDI learn, limits vs. Phalanx)
//   - CPU: the arp scheduler in @sample is skipped while no arp is
//     active (arpAct flag, maintained on start/stop/kill)
//   0.6.0
//   - NEW: arpeggiator per pad (UP/DOWN/UP-DN/RND/ROLL, rate 20 ms to
//     2 s, 1-4 octaves, gate 5-100 %, sample-accurate in @sample)
//   - NEW: scratcher per pad (SCR button + dragging on the waveform
//     while a note is held, or automation slider 53)
//   - NEW: system page (anti-alias Hermite interpolation, incoming
//     transpose +/-24 st, working polyphony limit), preset banks as
//     files (8 slots, load B1-B8), per-pad undo (SNAP/UNDO)
//   - FIX: ROOM reverb was near full scale - output 0.02 -> 0.011,
//     room feedback base 0.78 -> 0.72
//   0.5.0
//   - NEW: FX page as master chain: EQ -> 4 insert slots; 4-band EQ
//     (PEAK/LO-SHELF/HI-SHELF/LO-CUT/HI-CUT, RBJ biquads, live
//     response curve); inserts DELAY, CHORUS, FLANGER, PHASER,
//     DISTORT, CRUSH, COMP, LIMIT, ROOM, TRASH, GATE, STEREO
//   0.4.0
//   - NEW: 8-row mod matrix, 2 LFOs per pad, mod envelope, GUI
//     modifiers, velocity depth + curve, per-slot panorama
//   0.3.x
//   - NEW: filter page (LP/HP/BP/notch, 6/12/24 dB, drive
//     clean/dirty), pitch envelope with portamento (OFF/POLY/LEGATO),
//     loop editor (normal/ping-pong/crossfade, zero-cross snap)
//   - FIX: crackle artefacts of the early build removed
//   0.2.0
//   - NEW: sample B + crossfade, reverse, start/random offsets,
//     sample delay, phase invert, per-slot LPF/HPF/LoFi/Spike,
//     retrigger, amp envelope editor over the waveform
//   0.1.x
//   - First playable version: loader (file_riff, resample to project
//     rate, peak cache), 64-voice pool, amp envelope, kit note map,
//     multitrack channels, killnote, crossfade, mute/solo,
//     transpose/fine, slim-pad UI, full panel, tab bar, scope
//
in_pin:none
out_pin:TT-PHALYX L
out_pin:TT-PHALYX R

options:gfx_hz=45

// Alle Slider verborgen — die Geraetefront ist die einzige Oberflaeche.
// Samples kommen ueber die Kit-Datei (tt-phalyx-kit.bin, siehe @about)
// Mechanismus (Projekt speichert die Pfade, Parameterliste bleibt nutzbar).
slider1:90<0,100,0.1>-Master Volume
slider2:1<1,16,1>-Selected Pad
slider3:80<0,100,0.1>-Pad Volume
slider4:0<-100,100,0.1>-Pad Pan
slider5:0<-24,24,1>-Transpose A
slider6:0<-50,50,1>-Fine A
slider7:0<-24,24,1>-Transpose B
slider8:0<-50,50,1>-Fine B
slider9:0<0,100,0.1>-Crossfade A/B
slider10:0<0,1,1{Off,On}>-Pad Mute
slider11:0<0,1,1{Off,On}>-Pad Solo
slider12:0<0,16,1>-Pad Input (0=Kit, 1..16=MIDI-Ch)
slider13:36<0,127,1>-Kit Note
slider14:-1<-1,127,1>-Kill Note (-1=Off)
// verborgene Spiegel-Slider des ausgewaehlten Pads (Automation,
// MIDI-Learn, ReaScript). Feld 72..109 = Slider-Nr + 57.
slider15:0<0,11,1>-Mod Row 1 Source
slider16:0<0,8,1>-Mod Row 1 Target
slider17:0<-100,100,0.1>-Mod Row 1 Amount
slider18:0<0,11,1>-Mod Row 2 Source
slider19:0<0,8,1>-Mod Row 2 Target
slider20:0<-100,100,0.1>-Mod Row 2 Amount
slider21:0<0,11,1>-Mod Row 3 Source
slider22:0<0,8,1>-Mod Row 3 Target
slider23:0<-100,100,0.1>-Mod Row 3 Amount
slider24:0<0,11,1>-Mod Row 4 Source
slider25:0<0,8,1>-Mod Row 4 Target
slider26:0<-100,100,0.1>-Mod Row 4 Amount
slider27:0<0,11,1>-Mod Row 5 Source
slider28:0<0,8,1>-Mod Row 5 Target
slider29:0<-100,100,0.1>-Mod Row 5 Amount
slider30:0<0,11,1>-Mod Row 6 Source
slider31:0<0,8,1>-Mod Row 6 Target
slider32:0<-100,100,0.1>-Mod Row 6 Amount
slider33:0<0,11,1>-Mod Row 7 Source
slider34:0<0,8,1>-Mod Row 7 Target
slider35:0<-100,100,0.1>-Mod Row 7 Amount
slider36:0<0,11,1>-Mod Row 8 Source
slider37:0<0,8,1>-Mod Row 8 Target
slider38:0<-100,100,0.1>-Mod Row 8 Amount
slider39:0<0,5,1>-LFO 1 Shape
slider40:0<0,100,0.1>-LFO 1 Rate
slider41:1<0,1,1{Free,Retrig}>-LFO 1 Phase
slider42:0<0,5,1>-LFO 2 Shape
slider43:0<0,100,0.1>-LFO 2 Rate
slider44:1<0,1,1{Free,Retrig}>-LFO 2 Phase
slider45:0.003<0,2,0.001>-Mod Env Attack (s)
slider46:0.25<0,2,0.001>-Mod Env Decay (s)
slider47:0<0,1,0.01>-Mod Env Sustain
slider48:0.12<0,2,0.001>-Mod Env Release (s)
slider49:100<0,200,0.1>-Velocity Depth
slider50:0<0,4,1{LIN,EXP2,EXP4,LOG,S-CURVE}>-Velocity Curve
slider51:0<-100,100,0.1>-Pan Sample A
slider52:0<-100,100,0.1>-Pan Sample B
// System + Scratcher (Automation/MIDI-Learn ueber Reaper)
slider53:0<0,100,0.1>-Scratch Position
slider54:0<0,1,1{Lin,AA}>-Interpolation (System)
slider55:0<-24,24,1>-Incoming Transpose
slider56:0<0,5,1{Off,Up,Down,Up-Dn,Rnd,Roll}>-Arp Mode
slider57:0<0,100,0.1>-Arp Rate
slider58:1<1,4,1>-Arp Octaves
slider59:80<5,100,0.1>-Arp Gate
slider60:36<0,127,1>-Root Note (Keytrack)
slider61:2<0,24,1>-Pitchbend Range (st)
slider62:0<0,50,0.1>-Arp Shuffle %
slider63:0<0,3,1{Aus,Delay,Arp,Delay+Arp}>-Tempo Sync (System)

/* ============================================================
   @init — Speicherkarte, Funktionen, Grundzustand.
   Alles, was @init ueberleben muss (Pad-Daten, Namen, Peaks,
   Slot-Metadaten, Sample-RAM), liegt in memset-Luecken.
   ============================================================ */
@init

// ---------- Speicherkarte ----------
M_SCOPE = 0;      // 512   Oszilloskop-Ringpuffer            [volatile]
M_PAD   = 1024;   // 16x128 Pad-Parameter                   [bleibt]
M_NAME  = 3072;   // 32x96 Sample-Basisnamen (Anzeige)      [bleibt]
M_PEAK  = 6144;   // 32x128 Waveform-Peaks je Slot          [bleibt]
M_ST    = 10240;  // 2112  16x128 Pad-State + Globals [2048] [bleibt]
M_SLI   = 12704;  // 32x10 Slot-Meta (Base,Len,Hash,Flag,Loop) [bleibt]
M_PATH  = 13024;  // 32x128 Sample-Pfade (Chars; 128 statt 96,
                  // damit Pfade bis 127 Zeichen + Terminator passen)
M_EVT   = 17120;  // 256x4 MIDI-Queue                       [volatile]
M_VOX   = 18144;  // 64x112 Voice-Pool                      [volatile]
M_GP    = 25312;  // 16    Pad-Gain-Cache                   [volatile]
M_MTX   = 25328;  // 16x24  kompilierte Mod-Matrix (SRC,DST,AMT) [volatile]
M_MRA   = 25712;  // 16    aktive Mod-Rows je Pad           [volatile]
M_MFL   = 25728;  // 16    Mod-Benutzungs-Flags (LFO1/LFO2/MENV) [volatile]
M_LASTN = 25744;  // 16    letzte Note je Pad (Portamento)  [volatile]
M_LSL   = 25760;  // 64    Slider-Spiegel (Sync-Schutz)     [bleibt]
// System/Arp/Monitor/Undo (oberhalb der memset-Luecken)
M_SYS   = 25824;  // 16    System: AA, Transpose, Bank      [bleibt]
M_ARP   = 25840;  // 16x16 Arp-Runtime je Pad               [volatile]
M_MON   = 26096;  // 16    Pad-Hit-Velocity (Anzeige)       [volatile]
M_UND   = 26112;  // 128   Undo-Snapshot eines Pads         [volatile]
M_TOP   = 26240;  // ab hier FX-Pufferpool + Sample-RAM     [bleibt]

// Master-FX-State (Parameter + EQ-Koeffizienten; nur 0..95 serialisiert)
M_FX    = 12352;  // 352  s. FXP_-Feldbelegung unten        [bleibt]

// Pad-Felder (Nutzer-Einheiten, 64er-Stride)
PF_VOL = 0; PF_PAN = 1; PF_TRNA = 2; PF_FINA = 3; PF_TRNB = 4; PF_FINB = 5;
PF_XF = 6; PF_MUTE = 7; PF_SOLO = 8; PF_MODE = 9; PF_NOTE = 10; PF_KILL = 11;
PF_VOI = 12; PF_ATK = 13; PF_DEC = 14; PF_SUS = 15; PF_REL = 16;
PF_1SHOT = 17; PF_ROOT = 18;
// Soundformung je Slot (A/B) + Kanal
PF_GAINA = 19; PF_LPF_A = 20; PF_HPF_A = 21; PF_LOFI_A = 22; PF_SPIKE_A = 23;
PF_DLY_A = 24; PF_PHINV_A = 25; PF_START_A = 26; PF_RNDA = 27; PF_REV_A = 28;
PF_GAINB = 29; PF_LPF_B = 30; PF_HPF_B = 31; PF_LOFI_B = 32; PF_SPIKE_B = 33;
PF_DLY_B = 34; PF_PHINV_B = 35; PF_START_B = 36; PF_RNDB = 37; PF_REV_B = 38;
PF_RT_RATE = 39; PF_RT_KTRK = 40; PF_RT_FADE = 41; PF_TIMESC = 42;
// Filterseite + Pitch-Env + Portamento + Loop (je Pad)
FLT_TYPE = 43; FLT_CUT = 44; FLT_RES = 45; FLT_ENV = 46; FLT_DRV = 47; FLT_MODE = 48;
FEA_ATK = 49; FEA_DEC = 50; FEA_SUS = 51; FEA_REL = 52;
PEN_RANGE = 53; PEN_STEPS = 54; PEN_FLIP = 55;
PORTA_MODE = 56; PORTA_TIME = 57;
LON_A = 58; LSTA_A = 59; LEN_A = 60; LTYPE_A = 61; LXFD_A = 62;
LON_B = 63; LSTA_B = 64; LEN_B = 65; LTYPE_B = 66; LXFD_B = 67;
// Pitch-Env-Zeiten (Fix 0.4.0 — vorher undeklariert!)
PEA_ATK = 68; PEA_DEC = 69; PEA_SUS = 70; PEA_REL = 71;
// Mod-Matrix, 8 Rows (Row r: MM_SRC + r*3 / MM_DST + r*3 / MM_AMT + r*3)
// Quellen: 0 OFF 1 VEL 2 KEY 3 G1 4 G2 5 G3 6 MAUS-Y 7 MAUS-X 8 LFO1 9 LFO2
//          10 MODENV 11 RND
// Ziele:   0 OFF 1 VOL 2 PAN 3 PITCH (Halbton) 4 CUTOFF (2 Okt) 5 RESO
//          6 LFO1-RATE 7 LFO2-RATE 8 XFADE
MM_SRC = 72; MM_DST = 73; MM_AMT = 74;
// LFOs + Mod-Env + Velocity + Panorama je Slot
L1_SHAPE = 96; L1_RATE = 97; L1_RETRIG = 98;   // Rate 0..100 -> 30*(v/100)^2 Hz
L2_SHAPE = 99; L2_RATE = 100; L2_RETRIG = 101;
MEN_ATK = 102; MEN_DEC = 103; MEN_SUS = 104; MEN_REL = 105;
VEL_DEPTH = 106; VEL_CURVE = 107;              // Tiefe 0..200 %, Kurve 0..4
PANA = 108; PANB = 109;                        // Slot-Panorama, Pad-Pan als Offset
// Arpeggiator je Pad + Scratcher
ARP_MODE = 110; ARP_RATE = 111; ARP_OCT = 112; ARP_GATE = 113;
SCR_ON = 114;                                  // Playhead folgt Scratch-Regler
// Pitchbend-Range + Arp-Shuffle
PBR = 115;                                     // Pitchbend-Weite 0..24 st
SHUF = 116;                                    // Arp-Shuffle 0..50 %

// Master-FX (M_FX, 352 Woerter). 0..44 Parameter [serialisiert],
// 48..67 EQ-Koeffizienten-Cache [serialisiert], 80..95 frei,
// 96.. Runtime-States je Insert-Slot (Stride 64) [nicht serialisiert].
FXP_ON = 0;                                    // 1 = FX-Kette aktiv
// EQ: Band b (0..3): FXP_EQT+4b TYPE / EQF FREQ / EQG GAIN / EQQ Q
// TYPE: 0 PEAK 1 LO-SHELF 2 HI-SHELF 3 LO-CUT (HP) 4 HI-CUT (LP)
FXP_EQT = 1;
function EQT(b) ( 1 + b*4; );                  // TYPE-Feld je Band
function EQF(b) ( 2 + b*4; );
function EQG(b) ( 3 + b*4; );
function EQQ(b) ( 4 + b*4; );
// Insert s (0..3): TYPE / P1..P4 / MIX
// TYPE: 0 OFF 1 DELAY 2 CHORUS 3 FLANGER 4 PHASER 5 DIST 6 CRUSH 7 COMP
//       8 LIMITER 9 ROOM 10 TRASH 11 GATE 12 STEREO
function ISL_TYPE(s) ( 17 + s*7; );
function ISL_P(s, p) ( 18 + s*7 + p; );
function ISL_MIX(s) ( 22 + s*7; );
function FXC(b) ( 48 + b*5; );                 // EQ-Koeffizienten {b0,b1,b2,a1,a2}
function FXT(s) ( M_FX + 96 + s*64; );         // Runtime-State je Slot (absolute Adresse!)
FXQST = 240;                                     // EQ-State: FXQST + b*8 + c*4 {x1,x2,y1,y2}

SYS_AA = 0; SYS_TRANS = 1; SYS_BANK = 2;
SYS_SYNC = 3;                                  // 0 AUS 1 DELAY 2 ARP 3 DELAY+ARP
ARP_ON = 0; ARP_CNT = 1; ARP_STEP = 2; ARP_DIR = 3;
ARP_VOX = 4; ARP_GAT = 5; ARP_VEL = 6; ARP_NOTE = 7;
ARP_FLIP = 8;                                  // On-/Off-Beat-Schalter (Shuffle)

// FX-Pufferpool im Sample-RAM (feste Adressen, einmalig reserviert)
FXDLYN = 96100;                                // 1 s je Kanal @ 96k
FXMODN = 10000;
FXVRBN = 40000;
FXPDN = 24576;                                 // Predelay (250 ms @ 96k)
FXSLOTN = 2*FXDLYN + 2*FXMODN + 2*FXVRBN + 2*FXPDN;  // je Insert-Slot
FXPOOL = 4*FXSLOTN;                            // GROESSE ab M_TOP

// Voice-Felder (112er-Stride)
VA = 0; VP = 1; VN = 2; VG = 3; VS = 4; VAMP = 5; VATT = 6; VDEC = 7;
VREL = 8; VPEAK = 9; VPA = 10; VPB = 11; VRA = 12; VRB = 13; VGA = 14;
VGB = 15; VGL = 16; VGR = 17; VSUS = 18; V1SH = 19;
VDLYA = 20; VDLYB = 21;
VLPFGA = 22; VLPYA = 23; VLPFGB = 24; VLPYB = 25;
VHPFA = 26; VHPXA = 27; VHPYA = 28; VHPFB = 29; VHPXB = 30; VHPYB = 31;
VLOFA = 32; VLOFFA = 33; VLOFB = 34; VLOFFB = 35; VLOFC = 36; VLOFQ = 37;
VSPKE = 38; VSPKD = 39; VSPKA = 40; VSPKB = 41; VPRVA = 42; VPRVB = 43;
VRTC = 44; VFADEC = 45; VFADET = 46; VPHIA = 47; VPHIB = 48; VPA0 = 49; VPB0 = 50;
VRTW = 51;
// Hauptfilter, Filter-Env, Pitch-Env, Portamento, PingPong-Richtung
VFS11 = 52; VFS12 = 53; VFS21 = 54; VFS22 = 55;
VFVAL = 56; VFSTG = 57; VFATTC = 58; VFDECC = 59; VFRELC = 60; VFSUS = 61;
VPENV = 62; VPSTG = 63; VPATTC = 64; VPDECC = 65; VPRELC = 66; VPPEAK = 67; VPSUS = 68;
VGLOG = 69; VGCO = 70; VGON = 71;
VPDIR = 72;                                    // PingPong-Richtung Slot A (1 = rueckwaerts)
VFTYPE = 73; VFCUT = 74; VFRESN = 75; VFEOCT = 76; VFDRVN = 77; VFMD = 78;
VPRNG = 79; VPSTN = 80; VPFLP = 81;
// Modulation je Stimme
VL1PH = 82; VL2PH = 83;                        // LFO-Phasen 0..1
VMSTG = 84; VMVAL = 85;                        // Mod-Env Stage/Wert
VMATTC = 86; VMDECC = 87; VMRELC = 88; VMSUS = 89;
VVEL = 90; VKEY = 91; VRND = 92;               // eingefrorene Trigger-Quellen
VL1F = 93; VL1S = 94; VL2F = 95; VL2S = 96;    // S&H-Flanken + Werte
VL1M = 104; VL2M = 105;                        // LFO-Ratenmod des letzten Samples
VGLA = 97; VGRA = 98; VGLB = 99; VGRB = 100;   // Slot-Pan-Paare (Eichenleistung)
VGA0 = 101; VGB0 = 102;                        // Basis-Slot-Gains (Fix 0.4.0: je Stimme!)
VPDRB = 103;                                   // PingPong-Richtung Slot B
VPBR = 106;                                    // Pitchbend-Range je Stimme (st)

// Slot-Meta-Felder (4er-Stride)
SB = 0; SL = 1; SH = 2; SF = 3;

// Layout der Front im Designraster
UI_W = 1020; UI_H = 744;
gfx_ext_retina = 1;

phxVer = 5;

/* ---------- kleine Helfer ---------- */

function min2(a, b) ( a < b ? a : b; );
function max2(a, b) ( a > b ? a : b; );

// tanh-Ersatz (nicht jeder REAPER-Build hat tanh als Builtin)
function fastTanh(x) local(a) (
  a = min2(30, max2(-30, 6*x));
  (1 - exp(-a))/(1 + exp(-a));
);

// 4-Punkt-Hermite (Catmull-Rom) fuer den AA-Modus
function herm4(a, b, c, d, t) (
  b + 0.5*t*(c - a + t*(2*a - 5*b + 4*c - d + t*(3*(b - c) + d - a)));
);

// Weiche Ausgangs-Sättigung: bis 0.7 linear-transparent,
// oben tanh-Knie mit stetiger Steigung, Grenzwert exakt 1.0
function softOut(x) local(a) (
  a = abs(x);
  a <= 0.7 ? x : (x >= 0 ? 1 : -1)*(0.7 + 0.3*fastTanh((a - 0.7)*3.3333));
);



function PF(f, p) ( M_PAD[p*128 + f]; );
function PF_SET(f, p, v) ( M_PAD[p*128 + f] = v; );

// Hash ueber einen Datei-Slider-String (Aenderungserkennung)
function strHash(str) local(i, n, h) (
  h = 0; n = strlen(str); i = 0;
  loop(n, h = (h*31 + str_getchar(str, i)) % 1000000007; i += 1; );
  h;
);

// Sample-Pfade je Slot als Char-Array in M_PATH (0..31: A = 0..15,
// B = 16..31); M_NAME haelt den Basisnamen fuer die Anzeige.
function pathFill(s) local(b, i, L) (
  b = M_PATH + s*128;
  L = 0;
  loop(127, b[L] > 0 ? L += 1 : 0; );
  #pthstr = "";
  str_setlen(#pthstr, L);
  i = 0;
  loop(L, str_setchar(#pthstr, i, b[i]); i += 1; );
);

// Sample A des Pads nach B kopieren (Pfad + Anzeigename, Auto-Reload)
function copyAtoB(p) local(i, pa, pb) (
  pa = M_PATH + p*128; pb = M_PATH + (p + 16)*128;
  i = 0; loop(128, pb[i] = pa[i]; i += 1; );
  pa = M_NAME + p*96; pb = M_NAME + (p + 16)*96;
  i = 0; loop(96, pb[i] = pa[i]; i += 1; );
  filesDirty = 1;
);

/* ---------- Kit-Datei ----------
   tt-phalyx-kit.bin: fuer jeden der 32 Slots (1-16 = SampleA P01-P16,
   17-32 = SampleB) ein float32-Wort je Zeichen: erst die Laenge L,
   dann L Byte-Werte (Pfad in UTF-8). L = 0 = Slot leer. JSFX kann
   keine Textzeilen lesen (file_gets existiert nicht), daher dieser
   Byte-Stream — file_var ist die bewaehrte primitive.
   Geschrieben wird die Datei vom Lua-Skript "TT-PHALYX Kit laden.lua"
   (WAV-Ordner -> 16 Pads); Aenderungen uebernimmt die Maschine
   automatisch alle ~0,5 s. Analog liegt kit.txt als lesbare Referenz.
   Belegte Slots werden vom Poll NICHT ueberschrieben, wenn die Zeile
   leer ist — so ueberlebt eine A->B-Kopie das Pollen. */

function kitOpen() local(fh) (
  fh = file_open("tt-phalyx-kit.bin");
  fh ? fh : file_open("C:/Users/micro/AppData/Roaming/REAPER/Effects/TimTechlor/TT-PHALYX/tt-phalyx-kit.bin");
);

// Kit-Datei lesen und direkt nach M_PATH/M_NAME mappen
function parseKit() local(fh, i, j, k2, L, v, c, mp, bn, bl, last, ks) (
  fh = kitOpen();
  kitOk = fh ? 1 : 0;
  kitLines = 0;
  fh ? (
    i = 0;
    loop(32,
      file_var(fh, v);
      L = floor(v + 0.5);
      L > 0 ? (
        L > 120 ? L = 120;
        // Kit-Vertrag: Eintrag 0-15 = SampleA der Pads 1-16, 16-31 =
        // SampleB -> Speicher-Slots sind aber interleaved (A = pad*2,
        // B = pad*2+1). Fix 0.4.0: Mapping korrigieren, sonst hoerte
        // Pad n Slot 2n (Pads 8-15 blieben stumm, falsche Samples).
        ks = i < 16 ? i*2 : (i - 16)*2 + 1;
        mp = M_PATH + ks*128;
        bn = M_NAME + ks*96;
        j = 0; last = -1;
        loop(L,
          file_var(fh, v); c = floor(v + 0.5);
          mp[j] = c;
          (c == 47 || c == 92) ? last = j;
          j += 1;
        );
        mp[j] = 0;
        // Padding bis 128 Woerter ueberlesen (Dateizeiger am Slot-Ende halten)
        j = 1 + L;
        loop(127 - L, file_var(fh, v); j += 1; );
        // Basisname (nach dem letzten Slash) fuer die Anzeige
        bl = j - last - 1;
        bl > 94 ? bl = 94;
        j = 0;
        loop(bl, bn[j] = mp[last + 1 + j]; j += 1; );
        bn[bl] = 0;
        k2 = bl + 1;
        loop(95 - bl, bn[k2] = 0; k2 += 1; );
        kitLines += 1;
      );
      i += 1;
    );
    file_close(fh);
    filesDirty = 1;
  );
);

// Namen aus M_NAME in #nmstr aufbauen (fuer gfx_drawstr)
function nameFill(s) local(b, i, L) (
  b = M_NAME + s*96;
  L = 0;
  loop(95, b[L] > 0 ? L += 1 : 0; );
  #nmstr = "";
  str_setlen(#nmstr, L);
  i = 0;
  loop(L, str_setchar(#nmstr, i, b[i]); i += 1; );
);

// Notenname in #vstr, z. B. "C#2"
function noteStr(n) local(k, o) (
  k = n - 12*floor(n/12); o = floor(n/12) - 1;
  k == 0 ? sprintf(#vstr, "C%d", o) : k == 1 ? sprintf(#vstr, "C#%d", o)
  : k == 2 ? sprintf(#vstr, "D%d", o) : k == 3 ? sprintf(#vstr, "D#%d", o)
  : k == 4 ? sprintf(#vstr, "E%d", o) : k == 5 ? sprintf(#vstr, "F%d", o)
  : k == 6 ? sprintf(#vstr, "F#%d", o) : k == 7 ? sprintf(#vstr, "G%d", o)
  : k == 8 ? sprintf(#vstr, "G#%d", o) : k == 9 ? sprintf(#vstr, "A%d", o)
  : k == 10 ? sprintf(#vstr, "A#%d", o) : sprintf(#vstr, "B%d", o);
);

// GM-Default-Notenmap der 16 Pads
function gmNote(p) (
  p == 0 ? 36 : p == 1 ? 38 : p == 2 ? 42 : p == 3 ? 46
  : p == 4 ? 39 : p == 5 ? 37 : p == 6 ? 51 : p == 7 ? 49
  : p == 8 ? 41 : p == 9 ? 45 : p == 10 ? 48 : p == 11 ? 70
  : p == 12 ? 56 : p == 13 ? 54 : p == 14 ? 63 : 40;
);

function defaultPadName(p) (
  p == 0 ? "KICK" : p == 1 ? "SNARE" : p == 2 ? "CL HH" : p == 3 ? "OP HH"
  : p == 4 ? "CLAP" : p == 5 ? "RIM" : p == 6 ? "RIDE" : p == 7 ? "CRASH"
  : p == 8 ? "TOM LO" : p == 9 ? "TOM MD" : p == 10 ? "TOM HI" : p == 11 ? "SHAKER"
  : p == 12 ? "COWBELL" : p == 13 ? "TAMB" : p == 14 ? "PERC" : "SNAP";
);

// Filtertyp-Name
function fltTypeName(t) (
  t == 0 ? "LP 6" : t == 1 ? "LP 12" : t == 2 ? "LP 24"
  : t == 3 ? "HP 6" : t == 4 ? "HP 12" : t == 5 ? "HP 24"
  : t == 6 ? "BP 12" : t == 7 ? "BP 24"
  : t == 8 ? "NO 12" : "NO 24";
);

// Mod-Matrix-Namen (Kurzformen fuer den MOD-Tab)
function modSrcName(s) (
  s == 1 ? "VEL" : s == 2 ? "KEY" : s == 3 ? "G1" : s == 4 ? "G2"
  : s == 5 ? "G3" : s == 6 ? "M-Y" : s == 7 ? "M-X" : s == 8 ? "LFO1"
  : s == 9 ? "LFO2" : s == 10 ? "MENV" : s == 11 ? "RND" : "OFF";
);
function modDstName(d) (
  d == 1 ? "VOL" : d == 2 ? "PAN" : d == 3 ? "PITCH" : d == 4 ? "CUTOFF"
  : d == 5 ? "RESO" : d == 6 ? "LFO1 RT" : d == 7 ? "LFO2 RT"
  : d == 8 ? "XFADE" : "OFF";
);
function lfoShapeName(s) (
  s == 0 ? "SIN" : s == 1 ? "TRI" : s == 2 ? "SAW-" : s == 3 ? "SAW+"
  : s == 4 ? "SQR" : "S&H";
);
function velCurveName(c) (
  c == 0 ? "LIN" : c == 1 ? "EXP2" : c == 2 ? "EXP4" : c == 3 ? "LOG" : "S-CR"
);
// Arp-Modi
function arpModeName(m) (
  m == 1 ? "UP" : m == 2 ? "DOWN" : m == 3 ? "UP-DN" : m == 4 ? "RND" : m == 5 ? "ROLL" : "OFF"
);
// Velocity-Kurve (Engine + Skizze nutzen dieselbe Funktion)
function velCurve(v, c) (
  c == 1 ? v*v : c == 2 ? v*v*v*v : c == 3 ? v^0.5
  : c == 4 ? v*v*(3 - 2*v) : v;
);

// Naechste Nullstelle fuer den Loop-Schnitt (sucht vorwaerts)
function snapZero(sl, frac) local(base, len, pos, i, lim, a, bb) (
  base = M_SLI[sl*10+SB]; len = M_SLI[sl*10+SL];
  gZero = frac;
  len > 2 ? (
    pos = floor(frac*0.001*len);
    pos > len - 2 ? pos = len - 2;
    lim = min2(4000, len - 2 - pos);
    i = 0;
    loop(lim,
      a = base[pos + i]; bb = base[pos + i + 1];
      ((a <= 0 && bb > 0) || (a >= 0 && bb < 0)) ? (
        gZero = 1000*(pos + i + 1)/len; i = lim;
      );
      i += 1;
    );
  );
  gZero;
);

/* ---------- Sample-Loader ---------- */

// Einen Slot laden: file_riff resampled auf Projekt-Rate (Hint 'rqsr'),
// Mono-Mix, Peak-Cache fuer die Waveform-Anzeige. Cap 20 s je Slot.
function loadSlot(s) local(fh, nch, sr, frames, base, cap, i, v, v2, bi, a) (
  M_SLI[s*10+SF] = 0;
  M_SLI[s*10+SL] = 0;
  pathFill(s);
  fh = file_open(#pthstr);
  fh ? (
    nch = 'rqsr'; sr = srate;
    file_riff(fh, nch, sr) > 0 && nch > 0 ? (
      cap = floor(20*srate);
      frames = min2(cap, floor(file_avail(fh)/nch));
      frames > 0 ? (
        base = M_TOP + topUse;
        topUse += frames + 16;
        i = 0;
        loop(frames,
          file_var(fh, v);
          nch > 1 ? (
            file_var(fh, v2);
            v = (v + v2)*0.5;
            nch > 2 ? loop(nch-2, file_var(fh, v2); );
          );
          base[i] = v;
          i += 1;
        );
        M_SLI[s*10+SB] = base;
        M_SLI[s*10+SL] = frames;
        M_SLI[s*10+SF] = 1;
        // Peak-Cache (128 Buckets)
        i = 0; loop(128, M_PEAK[s*128+i] = 0; i += 1; );
        i = 0;
        loop(frames,
          a = abs(base[i]);
          bi = s*128 + floor(i*128/frames);
          a > M_PEAK[bi] ? M_PEAK[bi] = a;
          i += 1;
        );
      ) : ( M_SLI[s*10+SF] = 2; );
    ) : ( M_SLI[s*10+SF] = 2; );   // RIFF-Kopf unlesbar (kein WAV/AIFF)
    file_close(fh);
  );  // file_open fehlgeschlagen (nichts gewaehlt) → Flag bleibt 0
);

// Alle 32 Slots gegen die Kit-Pfade abgleichen (Hash-Vergleich)
function sampleScan() local(s, h) (
  s = 0;
  loop(32,
    pathFill(s);
    h = strHash(#pthstr);
    h != M_SLI[s*10+SH] ? (
      M_SLI[s*10+SH] = h;
      loadSlot(s);
    );
    s += 1;
  );
  filesDirty = 0;
);

/* ---------- Stimmen ---------- */

function killVoiceAt(i) local(vb) (
  vb = M_VOX + i*112;
  vb[VS] = 3; vb[VG] = 0;
  vb[VREL] = exp(-1/(0.002*srate));
);

function killPad(p) local(i, vb, k2) (
  M_ARP[p*16+ARP_ON] = 0;
  arpAct = 0; k2 = 0;
  loop(16, M_ARP[k2*16+ARP_ON] > 0.5 ? arpAct = 1 : 0; k2 += 1; );
  i = 0;
  loop(64, vb = M_VOX + i*112; vb[VP] == p && vb[VA] > 0 ? killVoiceAt(i); i += 1; );
);

function allNotesOff() local(i) (
  arpAct = 0;
  i = 0;
  loop(16, M_ARP[i*16+ARP_ON] = 0; i += 1; );
  i = 0; loop(64, killVoiceAt(i); i += 1; );
);

function killOldestOfPad(p) local(i, vb, best, ba) (
  best = -1; ba = 2; i = 0;
  loop(64,
    vb = M_VOX + i*112;
    vb[VA] > 0 && vb[VP] == p && vb[VAMP] < ba ? ( ba = vb[VAMP]; best = i; );
    i += 1;
  );
  best >= 0 ? killVoiceAt(best);
);

// globale Leiseste opfern (System-Polyphonie, wirksam ab Poly < 64)
function killQuietest() local(i, vb, best, ba) (
  best = -1; ba = 2; i = 0;
  loop(64,
    vb = M_VOX + i*112;
    vb[VA] > 0 && vb[VAMP] < ba ? ( ba = vb[VAMP]; best = i; );
    i += 1;
  );
  best >= 0 ? killVoiceAt(best);
);

function allocVoice() local(i, vb, cand) (
  cand = -1; i = 0;
  loop(64, vb = M_VOX + i*112; vb[VA] <= 0 && cand < 0 ? cand = i; i += 1; );
  cand < 0 ? ( cand = voxRR; voxRR = (voxRR + 1) % 64; );
  voxRR = (cand + 1) % 64;
  gLastVox = cand;
  M_ST[2062] += 1;                             // Debug: Voice-Allocs
  M_VOX + cand*112;
);

// Laeuft auf dem Pad eine Stimme? (Legato-Takeover)
function findPadVoice(p) local(i, vb, res) (
  res = 0; i = 0;
  loop(64, vb = M_VOX + i*112; res == 0 && vb[VA] > 0 && vb[VP] == p ? res = vb; i += 1; );
  res;
);

// Pad triggern (Kit-Note oder Kanalnote)
function trigPad(p, note, vel) local(vb, lv, i, cnt, gv, keym, xf, ga, gb, pn, pnA, pnB, vpk, atk, dec, rel, ts, pm,
                                     sa, ra, fa, sb, rb, fb, lenA, lenB, lpT, hpT, lofi, rtHz,
                                     velN, vc, vd) (
  gLastVox = -1;
  // Pad-Stimmenlimit: aelteste/leiseste Stimme des Pads opfern
  cnt = 0; gv = 0; i = 0;
  loop(64,
    vb = M_VOX + i*112;
    vb[VA] > 0 ? ( vb[VP] == p ? cnt += 1 : 0; gv += 1; );
    i += 1;
  );
  cnt >= max2(1, floor(PF(PF_VOI, p) + 0.5)) ? killOldestOfPad(p);
  gv >= polyMax ? killQuietest();
  // LEGATO: laeuft auf diesem Pad schon eine Stimme, gleitet sie zur
  // neuen Note (keine neue Stimme, keine neue Huellkurve)
  lv = floor(PF(PORTA_MODE, p) + 0.5) == 2 ? findPadVoice(p) : 0;
  lv ? (
    lv[VGLOG] = lv[VN] - note;
    lv[VN] = note;
    lv[VGCO] = 1 - exp(-1/(max2(0.002, PF(PORTA_TIME, p))*0.001*srate));
    lv[VGON] = 1;
    M_LASTN[p] = note;
    accentLed = 1;
  );
  lv ? 0 : (
  vb = allocVoice();
  vb ? (
    keym = floor(PF(PF_MODE, p) + 0.5) > 0 ? 2^((note - PF(PF_ROOT, p))/12) : 1;
    vb[VRA] = keym*2^((PF(PF_TRNA, p) + PF(PF_FINA, p)*0.01 + arpXp)/12);
    vb[VRB] = keym*2^((PF(PF_TRNB, p) + PF(PF_FINB, p)*0.01 + arpXp)/12);
    vc = floor(PF(VEL_CURVE, p) + 0.5);
    vd = PF(VEL_DEPTH, p)*0.01;
    velN = min2(1, velCurve(vel*0.0078740157, vc)*vd);
    vb[VVEL] = velN;
    vb[VKEY] = min2(1, max2(-1, (note - PF(PF_ROOT, p))/24));
    vb[VRND] = rand(1)*2 - 1;
    vb[VPBR] = PF(PBR, p);                       // PB-Weite einfrieren
    // Start-/Random-Offset und Reverse (Phalanx-Logik: Rnd startet
    // irgendwo zwischen Start-Offset und Sample-Ende)
    lenA = M_SLI[(p*2)*10+SL]; lenB = M_SLI[(p*2+1)*10+SL];
    sa = PF(PF_START_A, p)*0.01; ra = PF(PF_RNDA, p)*0.01;
    fa = sa + rand(1)*ra*(1 - sa);
    sb = PF(PF_START_B, p)*0.01; rb = PF(PF_RNDB, p)*0.01;
    fb = sb + rand(1)*rb*(1 - sb);
    vb[VPA0] = fa*max2(0, lenA - 1); vb[VPB0] = fb*max2(0, lenB - 1);
    PF(PF_REV_A, p) > 0.5 && lenA > 0 ? ( vb[VRA] = -vb[VRA]; vb[VPA0] = (lenA - 1) - vb[VPA0]; );
    PF(PF_REV_B, p) > 0.5 && lenB > 0 ? ( vb[VRB] = -vb[VRB]; vb[VPB0] = (lenB - 1) - vb[VPB0]; );
    vb[VPA] = vb[VPA0]; vb[VPB] = vb[VPB0];
    // Sample Delay je Slot
    vb[VDLYA] = floor(PF(PF_DLY_A, p)*0.001*srate);
    vb[VDLYB] = floor(PF(PF_DLY_B, p)*0.001*srate);
    // Crossfade: 0 = nur A, 50 = beide, 100 = nur B
    xf = PF(PF_XF, p)*0.01;
    ga = 1 - min2(1, max2(0, (xf - 0.5)*2));
    gb = 1 - min2(1, max2(0, (0.5 - xf)*2));
    M_SLI[(p*2)*10+SL]   <= 0 ? ga = 0;
    M_SLI[(p*2+1)*10+SL] <= 0 ? gb = 0;
    // Gain je Slot (0..200 %)
    ga *= PF(PF_GAINA, p)*0.01; gb *= PF(PF_GAINB, p)*0.01;
    vb[VGA0] = ga; vb[VGB0] = gb;
    vb[VGA] = ga; vb[VGB] = gb;
    pnA = (min2(100, max2(-100, PF(PF_PAN, p) + PF(PANA, p)))*0.01 + 1)*0.25*$pi;
    vb[VGLA] = cos(pnA); vb[VGRA] = sin(pnA);
    pnB = (min2(100, max2(-100, PF(PF_PAN, p) + PF(PANB, p)))*0.01 + 1)*0.25*$pi;
    vb[VGLB] = cos(pnB); vb[VGRB] = sin(pnB);
    // Statische kombinierte Pan-Paare (falls die Matrix nicht moduliert)
    vb[VGL] = ga*vb[VGLA] + gb*vb[VGLB];
    vb[VGR] = ga*vb[VGRA] + gb*vb[VGRB];
    // Amp-Huellkurve (TIMESC skaliert alle Zeiten)
    ts = max2(0.25, PF(PF_TIMESC, p)*0.01);
    vpk = 0.5 + 0.5*velN;
    atk = max2(0.0002, PF(PF_ATK, p))/ts;
    vb[VATT] = vpk/max2(1, atk*srate);
    dec = max2(0.002, PF(PF_DEC, p))/ts;
    vb[VDEC] = exp(-1/(dec*srate));
    rel = max2(0.002, PF(PF_REL, p))/ts;
    vb[VREL] = exp(-1/(rel*srate));
    vb[VPEAK] = vpk; vb[VAMP] = 0;
    vb[VSUS] = PF(PF_SUS, p); vb[V1SH] = PF(PF_1SHOT, p);
    vb[VS] = 1; vb[VG] = 1;
    // Filter-Env (eigene ADSR, TIMESCALE wirkt mit)
    vb[VFATTC] = 1/max2(1, max2(0.0002, PF(FEA_ATK, p))/ts*srate);
    vb[VFDECC] = exp(-1/(max2(0.002, PF(FEA_DEC, p))/ts*srate));
    vb[VFRELC] = exp(-1/(max2(0.002, PF(FEA_REL, p))/ts*srate));
    vb[VFSUS] = PF(FEA_SUS, p);
    vb[VFVAL] = 0; vb[VFSTG] = 1;
    // Pitch-Env
    vb[VPATTC] = 1/max2(1, max2(0.0002, PF(PEA_ATK, p))/ts*srate);
    vb[VPDECC] = exp(-1/(max2(0.002, PF(PEA_DEC, p))/ts*srate));
    vb[VPRELC] = exp(-1/(max2(0.002, PF(PEA_REL, p))/ts*srate));
    vb[VPSUS] = PF(PEA_SUS, p);
    vb[VPENV] = 0; vb[VPSTG] = 1;
    vb[VPRNG] = PF(PEN_RANGE, p); vb[VPSTN] = PF(PEN_STEPS, p)*0.01; vb[VPFLP] = PF(PEN_FLIP, p);
    vb[VMATTC] = 1/max2(1, max2(0.0002, PF(MEN_ATK, p))/ts*srate);
    vb[VMDECC] = exp(-1/(max2(0.002, PF(MEN_DEC, p))/ts*srate));
    vb[VMRELC] = exp(-1/(max2(0.002, PF(MEN_REL, p))/ts*srate));
    vb[VMSUS] = PF(MEN_SUS, p);
    vb[VMVAL] = 0; vb[VMSTG] = 1;
    vb[VL1PH] = PF(L1_RETRIG, p) > 0.5 ? 0 : rand(1);
    vb[VL2PH] = PF(L2_RETRIG, p) > 0.5 ? 0 : rand(1);
    vb[VL1F] = 1; vb[VL2F] = 1; vb[VL1S] = 0; vb[VL2S] = 0;
    vb[VL1M] = 0; vb[VL2M] = 0;
    // Hauptfilter-Cache
    vb[VFTYPE] = floor(PF(FLT_TYPE, p) + 0.5);
    vb[VFCUT] = PF(FLT_CUT, p)*0.01;
    vb[VFRESN] = PF(FLT_RES, p)*0.01;
    vb[VFEOCT] = PF(FLT_ENV, p)*0.04;
    vb[VFDRVN] = PF(FLT_DRV, p)*0.01;
    vb[VFMD] = PF(FLT_MODE, p);
    // Portamento (Glide von der letzten Note des Pads)
    floor(PF(PORTA_MODE, p) + 0.5) > 0 ? (
      vb[VGLOG] = M_LASTN[p] - note;
      vb[VGCO] = 1 - exp(-1/(max2(0.002, PF(PORTA_TIME, p))*0.001*srate));
      vb[VGON] = 1;
    ) : ( vb[VGLOG] = 0; vb[VGON] = 0; );
    M_LASTN[p] = note;
    // Filter je Slot (One-Pol; 100 % LPF = offen, 0 % HPF = zu)
    lpT = PF(PF_LPF_A, p)*0.01;
    vb[VLPFGA] = lpT >= 0.999 ? 1 : 1 - exp(-2*$pi*(200*100^lpT)/srate);
    hpT = PF(PF_HPF_A, p)*0.01;
    vb[VHPFA] = hpT <= 0.001 ? 1 : exp(-2*$pi*(10*800^hpT)/srate);
    vb[VLPYA] = 0; vb[VHPXA] = 0; vb[VHPYA] = 0;
    lpT = PF(PF_LPF_B, p)*0.01;
    vb[VLPFGB] = lpT >= 0.999 ? 1 : 1 - exp(-2*$pi*(200*100^lpT)/srate);
    hpT = PF(PF_HPF_B, p)*0.01;
    vb[VHPFB] = hpT <= 0.001 ? 1 : exp(-2*$pi*(10*800^hpT)/srate);
    vb[VLPYB] = 0; vb[VHPXB] = 0; vb[VHPYB] = 0;
    // LoFi je Slot (Halte-Intervall + Quantisierungsstufen)
    lofi = PF(PF_LOFI_A, p)*0.01;
    vb[VLOFC] = lofi <= 0.001 ? 1 : 1 + floor(lofi^1.5*32);
    vb[VLOFQ] = 2^(11 - lofi*8);
    vb[VLOFA] = 0; vb[VLOFFA] = 0; vb[VLOFB] = 0; vb[VLOFFB] = 0;
    // Spike (Transienten-Betonoung, ~15 ms Decoy)
    vb[VSPKA] = PF(PF_SPIKE_A, p)*0.01; vb[VSPKB] = PF(PF_SPIKE_B, p)*0.01;
    vb[VSPKD] = exp(-1/(0.015*srate)); vb[VSPKE] = 1;
    vb[VPRVA] = 0; vb[VPRVB] = 0;
    // Phase Invert je Slot
    vb[VPHIA] = PF(PF_PHINV_A, p) > 0.5 ? -1 : 1;
    vb[VPHIB] = PF(PF_PHINV_B, p) > 0.5 ? -1 : 1;
    // Retrigger (Rate 0 = aus; Keytrack skaliert mit der Note)
    PF(PF_RT_RATE, p) > 0.5 ? (
      rtHz = 2^(0.3 + PF(PF_RT_RATE, p)*0.043);
      rtHz *= 2^(PF(PF_RT_KTRK, p)*0.01*(note - PF(PF_ROOT, p))/12);
      vb[VRTW] = max2(4, srate/max2(0.5, rtHz));
      vb[VFADET] = floor(PF(PF_RT_FADE, p)*0.001*srate);
      vb[VFADEC] = vb[VFADET];
    ) : (
      vb[VRTW] = 0; vb[VFADET] = 0; vb[VFADEC] = 0;
    );
    vb[VRTC] = vb[VRTW];
    // PingPong-Startrichtung: Reverse startet rueckwaerts
    vb[VPDIR] = PF(PF_REV_A, p) > 0.5 && lenA > 0 ? 1 : 0;
    vb[VPDRB] = PF(PF_REV_B, p) > 0.5 && lenB > 0 ? 1 : 0;
    vb[VP] = p; vb[VN] = note; vb[VA] = 1;
    accentLed = 1;
    M_LASTN[p] = note;
    evDspP = p;
  );
  );
);

// Tempo-Sync. beatSamples = Viertel-Laenge in Samples; die Sync-
// Raster sind Bruchteile eines Beats (1/8T = 1/3, 1/4T = 2/3 Beat).
function beatSamples() ( srate*60/(tempo < 10 ? 120 : tempo); );
function arpPeriod(p) local(ri) (
  M_SYS[SYS_SYNC] == 2 || M_SYS[SYS_SYNC] == 3 ? (
    ri = floor(PF(ARP_RATE, p)*0.06); ri < 0 ? ri = 0; ri > 5 ? ri = 5;
    max2(32, floor(beatSamples()*(ri == 0 ? 1 : ri == 1 ? 2/3 : ri == 2 ? 0.5
      : ri == 3 ? 1/3 : ri == 4 ? 0.25 : 0.125)));
  ) : (
    max2(32, floor(20*100^(PF(ARP_RATE, p)*0.01)*0.001*srate));
  );
);
function dlyDivSamples(p0) local(di) (
  di = floor(p0*0.0799); di < 0 ? di = 0; di > 7 ? di = 7;
  floor(beatSamples()*(di == 0 ? 0.25 : di == 1 ? 1/3 : di == 2 ? 0.5
    : di == 3 ? 2/3 : di == 4 ? 1 : di == 5 ? 2 : di == 6 ? 3 : 4));
);
function dlyDivName(di) (
  di <= 0 ? "1/16" : di == 1 ? "1/8T" : di == 2 ? "1/8" : di == 3 ? "1/4T"
  : di == 4 ? "1/4" : di == 5 ? "1/2" : di == 6 ? "3/4" : "1/1"
);

// Note-On inkl. Arp-Start. Die weiteren Arp-Steps feuern sample-genau
// im @sample (M_ARP, Stride 8 je Pad) und transponieren ueber arpXp.
function noteOnPad(p, note, vel) local(am, ab, prd) (
  arpXp = 0;
  trigPad(p, note, vel);
  am = floor(PF(ARP_MODE, p) + 0.5);
  am > 0 ? (
    ab = M_ARP + p*16;
    prd = arpPeriod(p);
    ab[ARP_ON] = 1; ab[ARP_NOTE] = note; ab[ARP_VEL] = vel;
    ab[ARP_STEP] = am == 2 ? 0 : (floor(PF(ARP_OCT, p) + 0.5) > 1 ? 1 : 0);
    ab[ARP_DIR] = 0;
    ab[ARP_FLIP] = 0;
    ab[ARP_CNT] = max2(32, floor(prd*(1 + PF(SHUF, p)*0.01)));
    ab[ARP_GAT] = 0; ab[ARP_VOX] = 0;
    arpAct = 1;                                // @sample-Scheduler freischalten
  );
);

// Note-Off: Gate frei geben (wirkt nur bei Sustain-Envs)
function releaseNote(note, ch) local(vi, vb, md, p) (
  vi = 0;
  loop(64,
    vb = M_VOX + vi*112;
    vb[VA] > 0 ? (
      md = floor(PF(PF_MODE, vb[VP]) + 0.5);
      (md == 0 || md == ch) && vb[VN] == note ? vb[VG] = 0;
    );
    vi += 1;
  );
  p = 0; arpAct = 0;
  loop(16,
    M_ARP[p*16+ARP_ON] > 0.5 && floor(M_ARP[p*16+ARP_NOTE] + 0.5) == note ? (
      md = floor(PF(PF_MODE, p) + 0.5);
      md == 0 ? ( ch == 1 ? M_ARP[p*16+ARP_ON] = 0 : 0; )
              : ( md == ch ? M_ARP[p*16+ARP_ON] = 0 : 0; );
    );
    M_ARP[p*16+ARP_ON] > 0.5 ? arpAct = 1 : 0;
    p += 1;
  );
  evDspN = note; evDspOn = 0; evDspCnt += 1;
);

/* ---------- Pad-Gains (Mute/Solo-Logik, Block-Cache) ---------- */

function padGainRecalc() local(i, g, solo) (
  solo = 0; i = 0;
  loop(16, PF(PF_SOLO, i) > 0.5 ? solo = 1; i += 1; );
  i = 0;
  loop(16,
    g = PF(PF_VOL, i)*0.01;
    solo ? ( PF(PF_SOLO, i) > 0.5 ? 0 : g = 0; )
         : ( PF(PF_MUTE, i) > 0.5 ? g = 0; );
    M_GP[i] = g;
    i += 1;
  );
);

/* ---------- Loop-Punkte (Promille -> Samples, Block-Cache) ---------- */

function loopRecalc() local(p, slenA, slenB) (
  p = 0;
  loop(16,
    slenA = M_SLI[(p*2)*10+SL]; slenB = M_SLI[(p*2+1)*10+SL];
    M_SLI[(p*2)*10+4]   = PF(LON_A, p);
    M_SLI[(p*2)*10+5]   = floor(PF(LSTA_A, p)*0.001*slenA);
    M_SLI[(p*2)*10+6]   = floor(PF(LEN_A, p)*0.001*slenA);
    M_SLI[(p*2)*10+7]   = floor(PF(LTYPE_A, p) + 0.5);
    M_SLI[(p*2)*10+8]   = floor(PF(LXFD_A, p)*0.001*srate);
    M_SLI[(p*2+1)*10+4] = PF(LON_B, p);
    M_SLI[(p*2+1)*10+5] = floor(PF(LSTA_B, p)*0.001*slenB);
    M_SLI[(p*2+1)*10+6] = floor(PF(LEN_B, p)*0.001*slenB);
    M_SLI[(p*2+1)*10+7] = floor(PF(LTYPE_B, p) + 0.5);
    M_SLI[(p*2+1)*10+8] = floor(PF(LXFD_B, p)*0.001*srate);
    p += 1;
  );
);

/* ---------- Mod-Matrix kompilieren (Block-Cache) ----------
   Nur aktive Rows (SRC und DST != 0) wandern nach M_MTX; M_MFL
   merkt, ob ein Pad LFO1/LFO2/ModEnv ueberhaupt benutzt — Stimmen
   ohne Modulation zahlen dafuer keinen einzigen Takt. */

function modRecalc() local(p, r, s, d, n, fl) (
  p = 0;
  loop(16,
    n = 0; fl = 0; r = 0;
    loop(8,
      s = floor(PF(MM_SRC + r*3, p) + 0.5);
      d = floor(PF(MM_DST + r*3, p) + 0.5);
      s > 0 && d > 0 ? (
        M_MTX[p*24 + n*3] = s;
        M_MTX[p*24 + n*3 + 1] = d;
        M_MTX[p*24 + n*3 + 2] = PF(MM_AMT + r*3, p)*0.01;
        n += 1;
        s == 8 || d == 6 ? fl = fl | 1 : 0;
        s == 9 || d == 7 ? fl = fl | 2 : 0;
        s == 10 ? fl = fl | 4 : 0;
      );
      r += 1;
    );
    M_MRA[p] = n;
    M_MFL[p] = fl;
    p += 1;
  );
);

/* ---------- Master-FX (4-Band-EQ + 4 Insert-Slots) ----------
   Kette: Summe -> EQ -> Insert 1..4 -> Master. Parameter in M_FX
   (0..44, serialisiert), EQ-Koeffizienten gecacht (48..67, bei
   fxDirty/Samplerate neu), Runtime-States ab 96 (nicht serialisiert). */

function fxDefaults() local(bb, ss) (
  M_FX[FXP_ON] = 1;
  bb = 0;
  loop(4,
    M_FX[EQT(bb)] = 0;
    M_FX[EQF(bb)] = 25 + bb*25;
    M_FX[EQG(bb)] = 50;
    M_FX[EQQ(bb)] = 40;
    bb += 1;
  );
  ss = 0;
  loop(4,
    M_FX[ISL_TYPE(ss)] = ss == 0 ? 1 : 0;    // Slot 1 werkseitig DELAY
    M_FX[ISL_P(ss,0)] = 50;
    M_FX[ISL_P(ss,1)] = 50;
    M_FX[ISL_P(ss,2)] = 50;
    M_FX[ISL_P(ss,3)] = 50;
    M_FX[ISL_MIX(ss)] = ss == 0 ? 50 : 35;
    ss += 1;
  );
  fxDirty = 1;
  fxReady = 1;
);

function fxFreq(v) ( 30*(20000/30)^(v*0.01); );
function fxQk(v) ( 0.3*(8/0.3)^(v*0.01); );
function fxGain(v) ( (v - 50)*0.30; );

function pushFX(f, v) ( M_FX[f] = v; fxDirty = 1; );

function eqTypeName(t) (
  t == 1 ? "LO-SHELF" : t == 2 ? "HI-SHELF" : t == 3 ? "LO-CUT" : t == 4 ? "HI-CUT" : "PEAK";
);

function fxEqRecalc() local(bb, ty, amp, w0, cw, sw, al, sq, b0, b1, b2, a0, a1, a2, cc) (
  bb = 0;
  loop(4,
    cc = FXC(bb);
    ty = floor(M_FX[EQT(bb)] + 0.5);
    amp = 10^(fxGain(M_FX[EQG(bb)])/40);
    w0 = 2*$pi*fxFreq(M_FX[EQF(bb)])/srate;
    cw = cos(w0); sw = sin(w0);
    ty == 0 ? (
      al = sw/(2*fxQk(M_FX[EQQ(bb)]));
      b0 = 1 + al*amp; b1 = -2*cw; b2 = 1 - al*amp;
      a0 = 1 + al/amp; a1 = -2*cw; a2 = 1 - al/amp;
    ) : ty >= 3 ? (
      al = sw/(2*fxQk(M_FX[EQQ(bb)]));
      ty == 3 ? (
        b0 = (1 + cw)*0.5; b1 = -(1 + cw); b2 = (1 + cw)*0.5;
      ) : (
        b0 = (1 - cw)*0.5; b1 = 1 - cw; b2 = (1 - cw)*0.5;
      );
      a0 = 1 + al; a1 = -2*cw; a2 = 1 - al;
    ) : (
      sq = 0.70710678*sw;
      ty == 1 ? (
        b0 = amp*((amp+1) - (amp-1)*cw + 2*sq*sqrt(amp));
        b1 = 2*amp*((amp-1) - (amp+1)*cw);
        b2 = amp*((amp+1) - (amp-1)*cw - 2*sq*sqrt(amp));
        a0 = (amp+1) + (amp-1)*cw + 2*sq*sqrt(amp);
        a1 = -2*((amp-1) + (amp+1)*cw);
        a2 = (amp+1) + (amp-1)*cw - 2*sq*sqrt(amp);
      ) : (
        b0 = amp*((amp+1) + (amp-1)*cw + 2*sq*sqrt(amp));
        b1 = -2*amp*((amp-1) + (amp+1)*cw);
        b2 = amp*((amp+1) + (amp-1)*cw - 2*sq*sqrt(amp));
        a0 = (amp+1) - (amp-1)*cw + 2*sq*sqrt(amp);
        a1 = 2*((amp-1) - (amp+1)*cw);
        a2 = (amp+1) - (amp-1)*cw - 2*sq*sqrt(amp);
      );
    );
    M_FX[cc] = b0/a0; M_FX[cc+1] = b1/a0; M_FX[cc+2] = b2/a0;
    M_FX[cc+3] = a1/a0; M_FX[cc+4] = a2/a0;
    bb += 1;
  );
  fxDirty = 0;
);

function fxEQ() local(bb, cc, qq, x1, x2, y1, y2, cb0, cb1, cb2, ca1, ca2, y) (
  bb = 0;
  loop(4,
    cc = FXC(bb); qq = FXQST + bb*8;
    cb0 = M_FX[cc]; cb1 = M_FX[cc+1]; cb2 = M_FX[cc+2];
    ca1 = M_FX[cc+3]; ca2 = M_FX[cc+4];
    x1 = M_FX[qq]; x2 = M_FX[qq+1]; y1 = M_FX[qq+2]; y2 = M_FX[qq+3];
    y = cb0*fxL + cb1*x1 + cb2*x2 - ca1*y1 - ca2*y2;
    M_FX[qq] = fxL; M_FX[qq+1] = x1; M_FX[qq+2] = y; M_FX[qq+3] = y1;
    fxL = y;
    x1 = M_FX[qq+4]; x2 = M_FX[qq+5]; y1 = M_FX[qq+6]; y2 = M_FX[qq+7];
    y = cb0*fxR + cb1*x1 + cb2*x2 - ca1*y1 - ca2*y2;
    M_FX[qq+4] = fxR; M_FX[qq+5] = x1; M_FX[qq+6] = y; M_FX[qq+7] = y1;
    fxR = y;
    bb += 1;
  );
);

function fxDelay(s) local(st, bl, br, w, dL, dR, pL, pR, oL, oR, yl, yr, fb, gd, mix) (
  st = FXT(s);
  bl = M_TOP + s*FXSLOTN; br = bl + FXDLYN;
  w = st[0]; w >= FXDLYN ? ( w = 0; );
  M_SYS[SYS_SYNC] == 1 || M_SYS[SYS_SYNC] == 3 ? (
    dL = dlyDivSamples(M_FX[ISL_P(s,0)]);
    dR = floor(dL*(1 + M_FX[ISL_P(s,2)]*0.005));
  ) : (
    dL = floor(M_FX[ISL_P(s,0)]*0.01*srate);
    dR = floor(M_FX[ISL_P(s,0)]*(1 + M_FX[ISL_P(s,2)]*0.005)*0.01*srate);
  );
  dL < 1 ? ( dL = 1; );
  dL > FXDLYN - 2 ? ( dL = FXDLYN - 2; );
  dR < 1 ? ( dR = 1; );
  dR > FXDLYN - 2 ? ( dR = FXDLYN - 2; );
  pL = w - dL; pL < 0 ? ( pL += FXDLYN; );
  pR = w - dR; pR < 0 ? ( pR += FXDLYN; );
  oL = bl[pL]; oR = br[pR];
  dbgOL = oL; dbgW = w; dbgBL = bl; dbgP = pL;
  fb = M_FX[ISL_P(s,1)]*0.01;
  gd = 1 - exp(-2*$pi*(100*180^(M_FX[ISL_P(s,3)]*0.01))/srate);
  yl = st[7]; yl += gd*(oL - yl); st[7] = yl;
  yr = st[8]; yr += gd*(oR - yr); st[8] = yr;
  bl[w] = fxL + fb*yl; br[w] = fxR + fb*yr;
  st[0] = w + 1;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + oL*mix;
  fxR = fxR*(1 - mix) + oR*mix;
);

function fxChorus(s) local(st, bl, br, w, ph, offL, offR, off2L, off2R, i0, fr, rpL, rpR, rp2L, rp2R, oL, oR, mix) (
  st = FXT(s);
  bl = M_TOP + s*FXSLOTN + 2*FXDLYN; br = bl + FXMODN;
  w = st[0]; w >= FXMODN ? ( w = 0; );
  bl[w] = fxL; br[w] = fxR;
  st[0] = w + 1;
  ph = st[1] + 0.1*80^(M_FX[ISL_P(s,0)]*0.01)/srate;
  ph >= 1 ? ( ph -= 1; );
  st[1] = ph;
  // mittlere Tiefe (0.00008) — duennt weniger aus, combt weniger.
  offL = (5 + M_FX[ISL_P(s,2)]*0.25)*0.001*srate
       + M_FX[ISL_P(s,1)]*0.0001*srate*(0.5 - 0.5*cos(2*$pi*ph));
  offR = (5 + M_FX[ISL_P(s,2)]*0.25)*0.001*srate
       + M_FX[ISL_P(s,1)]*0.0001*srate*(0.5 - 0.5*cos(2*$pi*(ph + M_FX[ISL_P(s,3)]*0.004)));
  off2L = (5 + M_FX[ISL_P(s,2)]*0.25)*0.001*srate
        + M_FX[ISL_P(s,1)]*0.00008*srate*(0.5 - 0.5*cos(2*$pi*(ph + 0.25)));
  off2R = (5 + M_FX[ISL_P(s,2)]*0.25)*0.001*srate
        + M_FX[ISL_P(s,1)]*0.00008*srate*(0.5 - 0.5*cos(2*$pi*(ph + 0.25 + M_FX[ISL_P(s,3)]*0.004)));
  offL = min2(FXMODN - 2, max2(1, offL));
  offR = min2(FXMODN - 2, max2(1, offR));
  off2L = min2(FXMODN - 2, max2(1, off2L));
  off2R = min2(FXMODN - 2, max2(1, off2R));
  rpL = w - offL; rpL < 0 ? ( rpL += FXMODN; );
  i0 = floor(rpL); fr = rpL - i0;
  oL = bl[i0]*(1 - fr) + bl[(i0 + 1) % FXMODN]*fr;
  rp2L = w - off2L; rp2L < 0 ? ( rp2L += FXMODN; );
  i0 = floor(rp2L); fr = rp2L - i0;
  oL = oL*0.5 + bl[i0]*(1 - fr)*0.5 + bl[(i0 + 1) % FXMODN]*fr*0.5;
  rpR = w - offR; rpR < 0 ? ( rpR += FXMODN; );
  i0 = floor(rpR); fr = rpR - i0;
  oR = br[i0]*(1 - fr) + br[(i0 + 1) % FXMODN]*fr;
  rp2R = w - off2R; rp2R < 0 ? ( rp2R += FXMODN; );
  i0 = floor(rp2R); fr = rp2R - i0;
  oR = oR*0.5 + br[i0]*(1 - fr)*0.5 + br[(i0 + 1) % FXMODN]*fr*0.5;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + oL*mix;
  fxR = fxR*(1 - mix) + oR*mix;
);

function fxFlanger(s) local(st, bl, br, w, ph, offL, offR, fb, fdL, fdR, i0, fr, rpL, rpR, oL, oR, mix) (
  st = FXT(s);
  bl = M_TOP + s*FXSLOTN + 2*FXDLYN; br = bl + FXMODN;
  w = st[0]; w >= FXMODN ? ( w = 0; );
  ph = st[1] + 0.05*80^(M_FX[ISL_P(s,0)]*0.01)/srate;
  ph >= 1 ? ( ph -= 1; );
  st[1] = ph;
  offL = M_FX[ISL_P(s,3)]*0.0001*srate + M_FX[ISL_P(s,1)]*0.00006*srate*(0.5 - 0.5*cos(2*$pi*ph));
  offR = M_FX[ISL_P(s,3)]*0.0001*srate + M_FX[ISL_P(s,1)]*0.00006*srate*(0.5 - 0.5*cos(2*$pi*(ph + 0.25)));
  offL = min2(FXMODN - 2, max2(1, offL));
  offR = min2(FXMODN - 2, max2(1, offR));
  rpL = w - offL; rpL < 0 ? ( rpL += FXMODN; );
  i0 = floor(rpL); fr = rpL - i0;
  oL = bl[i0]*(1 - fr) + bl[(i0 + 1) % FXMODN]*fr;
  rpR = w - offR; rpR < 0 ? ( rpR += FXMODN; );
  i0 = floor(rpR); fr = rpR - i0;
  oR = br[i0]*(1 - fr) + br[(i0 + 1) % FXMODN]*fr;
  fb = M_FX[ISL_P(s,2)]*0.0095;
  // scharf, ohne zu kratzen; Zustand st[7]/st[8] ist slot-lokal.
  fdL = st[7]; fdL += 0.33*(oL - fdL); st[7] = fdL;
  fdR = st[8]; fdR += 0.33*(oR - fdR); st[8] = fdR;
  bl[w] = fxL + fb*fdL; br[w] = fxR + fb*fdR;
  st[0] = w + 1;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + oL*mix;
  fxR = fxR*(1 - mix) + oR*mix;
);

function fxPhaser(s) local(st, ph, fc, wq, aa, fbk, xinL, xinR, apL, apR, y, mix) (
  st = FXT(s);
  ph = st[1] + 0.05*80^(M_FX[ISL_P(s,0)]*0.01)/srate;
  ph >= 1 ? ( ph -= 1; );
  st[1] = ph;
  fc = 300 + 2400*M_FX[ISL_P(s,1)]*0.01*(0.5 - 0.5*cos(2*$pi*ph));
  wq = tan(min2(1.5, $pi*fc/srate));
  aa = (1 - wq)/(1 + wq);
  fbk = M_FX[ISL_P(s,2)]*0.009;
  xinL = fxL + fbk*st[18];
  y = aa*xinL + st[11] - aa*st[12]; st[11] = xinL; st[12] = y;
  y = aa*y + st[13] - aa*st[14]; st[13] = st[12]; st[14] = y;
  y = aa*y + st[15] - aa*st[16]; st[15] = st[14]; st[16] = y;
  y = aa*y + st[17] - aa*st[18]; st[17] = st[16]; st[18] = y;
  apL = y;
  fc = 300 + 2400*M_FX[ISL_P(s,1)]*0.01*(0.5 - 0.5*cos(2*$pi*(ph + M_FX[ISL_P(s,3)]*0.004)));
  wq = tan(min2(1.5, $pi*fc/srate));
  aa = (1 - wq)/(1 + wq);
  xinR = fxR + fbk*st[26];
  y = aa*xinR + st[19] - aa*st[20]; st[19] = xinR; st[20] = y;
  y = aa*y + st[21] - aa*st[22]; st[21] = st[20]; st[22] = y;
  y = aa*y + st[23] - aa*st[24]; st[23] = st[22]; st[24] = y;
  y = aa*y + st[25] - aa*st[26]; st[25] = st[24]; st[26] = y;
  apR = y;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + (xinL + apL)*0.5*mix;
  fxR = fxR*(1 - mix) + (xinR + apR)*0.5*mix;
);

function fxDist(s) local(st, dg, yl, yr, gd, mix) (
  st = FXT(s);
  dg = 1 + (M_FX[ISL_P(s,0)]*0.01)^2*40;
  yl = fastTanh(fxL*dg)/(dg^0.6);
  yr = fastTanh(fxR*dg)/(dg^0.6);
  gd = 1 - exp(-2*$pi*min2(18000, 500*80^(M_FX[ISL_P(s,1)]*0.01))/srate);
  st[7] += gd*(yl - st[7]); yl = st[7];
  st[8] += gd*(yr - st[8]); yr = st[8];
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + yl*mix;
  fxR = fxR*(1 - mix) + yr*mix;
);

function fxCrush(s) local(st, q, hn, wl, wr, mix) (
  st = FXT(s);
  q = 2^(1 + M_FX[ISL_P(s,0)]*0.15);
  hn = 1 + floor((M_FX[ISL_P(s,1)]*0.01)^2*200);
  st[6] += 1;
  st[6] >= hn ? (
    st[6] = 0;
    st[4] = floor(fxL*q + 0.5)/q;
    st[5] = floor(fxR*q + 0.5)/q;
  );
  wl = st[4]; wr = st[5];
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + wl*mix;
  fxR = fxR*(1 - mix) + wr*mix;
);

function fxDyn(s, lim) local(st, thr, ratio, env, tgt, as2, rs, mix) (
  st = FXT(s);
  thr = 10^((-48 + 0.48*M_FX[ISL_P(s,0)])/20);
  ratio = 1 + M_FX[ISL_P(s,1)]*0.19;
  env = max2(abs(fxL), abs(fxR));
  st[2] = env > st[2] ? env : st[2]*0.99995;
  tgt = env > thr ? (thr + (env - thr)/ratio)/max2(0.000000001, env) : 1;
  lim > 0.5 ? ( tgt = min2(tgt, thr/max2(0.000000001, env)); );
  as2 = lim > 0.5 ? 4 : max2(1, M_FX[ISL_P(s,2)]*0.0001*srate);
  rs = max2(1, M_FX[ISL_P(s,3)]*0.01*srate);
  st[3] += (tgt - st[3])*(tgt < st[3] ? 1/as2 : 1/rs);
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + fxL*st[3]*mix;
  fxR = fxR*(1 - mix) + fxR*st[3]*mix;
);

function fxReverb(s, fbk, dmp, size, pred) local(st, vl, vr, sc, k, tl, len, len2, p, y, d1, d2, pdl, pdr, pw, rd2, xin, inn) (
  st = FXT(s);
  vl = M_TOP + s*FXSLOTN + 2*FXDLYN + 2*FXMODN; vr = vl + FXVRBN;
  pdl = vr + FXVRBN; pdr = pdl + FXPDN;
  pw = st[60]; pw >= FXPDN ? ( pw = 0; );
  pdl[pw] = fxL; pdr[pw] = fxR;
  st[60] = pw + 1;
  pred = floor(pred*0.001*srate);
  pred > FXPDN - 2 ? ( pred = FXPDN - 2; );
  pred < 0 ? ( pred = 0; );
  rd2 = pw - pred; rd2 < 0 ? ( rd2 += FXPDN; );
  xin = pdl[rd2]; inn = pdr[rd2];
  sc = srate/44100;
  d1 = 1 - dmp*0.5; d2 = dmp*0.5;
  gWL = 0; gWR = 0;
  k = 0;
  loop(6,
    tl = k == 0 ? 1116 : k == 1 ? 1188 : k == 2 ? 1277 : k == 3 ? 1356 : k == 4 ? 1422 : 1491;
    len = floor(tl*sc*size);
    len < 8 ? ( len = 8; );
    len > FXVRBN - 2 ? ( len = FXVRBN - 2; );
    len2 = len + floor(23*sc*size);
    len2 > FXVRBN - 2 ? ( len2 = FXVRBN - 2; );
    p = st[27 + k]; p >= len ? ( p = 0; );
    y = vl[p];
    st[39 + k] = y*d1 + st[39 + k]*d2;
    vl[p] = xin + st[39 + k]*fbk;
    gWL += st[39 + k];
    st[27 + k] = p + 1;
    p = st[33 + k]; p >= len2 ? ( p = 0; );
    y = vr[p];
    st[45 + k] = y*d1 + st[45 + k]*d2;
    vr[p] = inn + st[45 + k]*fbk;
    gWR += st[45 + k];
    st[33 + k] = p + 1;
    k += 1;
  );
  k = 0;
  loop(4,
    tl = k == 0 ? 556 : k == 1 ? 441 : k == 2 ? 341 : 225;
    len = floor(tl*sc*size);
    len < 4 ? ( len = 4; );
    p = st[51 + k]; p >= len ? ( p = 0; );
    y = vl[p];
    vl[p] = gWL + y*0.5;
    gWL = y - gWL;
    st[51 + k] = p + 1;
    p = st[55 + k]; p >= len ? ( p = 0; );
    y = vr[p];
    vr[p] = gWR + y*0.5;
    gWR = y - gWR;
    st[55 + k] = p + 1;
    k += 1;
  );
  gWL *= 0.011; gWR *= 0.011;  // Nutzer-Tuning; Eingang zusaetzlich 0.5x gegen Resonanz-Aufbau
);

function fxRoom(s) local(wl, wr, w2, mix) (
  fxReverb(s, 0.72 + M_FX[ISL_P(s,0)]*0.0014, M_FX[ISL_P(s,1)]*0.01, 0.5 + M_FX[ISL_P(s,0)]*0.015, M_FX[ISL_P(s,3)]*2.5);
  M_ST[2069] = max2(M_ST[2069], max2(abs(fxL), abs(fxR)));    // Debug: Dry-Peak in Verb
  M_ST[2070] = max2(M_ST[2070], abs(gWL));                    // Debug: Wet-Peak
  w2 = M_FX[ISL_P(s,2)]*0.005;
  wl = gWL*(1 - w2) + gWR*w2;
  wr = gWR*(1 - w2) + gWL*w2;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + wl*mix;
  fxR = fxR*(1 - mix) + wr*mix;
);

function fxTrash(s) local(q, wl, wr, mix) (
  fxReverb(s, 0.80 + M_FX[ISL_P(s,0)]*0.0015, 0.35, 0.7 + M_FX[ISL_P(s,0)]*0.018, M_FX[ISL_P(s,3)]*2.5);
  q = 2^(1 + M_FX[ISL_P(s,1)]*0.14);
  gWL = floor(gWL*q + 0.5)/q;
  gWR = floor(gWR*q + 0.5)/q;
  wl = fastTanh(gWL*(1 + (M_FX[ISL_P(s,2)]*0.01)^2*24));
  wr = fastTanh(gWR*(1 + (M_FX[ISL_P(s,2)]*0.01)^2*24));
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + wl*mix;
  fxR = fxR*(1 - mix) + wr*mix;
);

function fxGate(s) local(st2, wl, wr, thr, tgt, rs, mix) (
  fxReverb(s, 0.70 + M_FX[ISL_P(s,0)]*0.0025, 0.25, 0.6 + M_FX[ISL_P(s,0)]*0.012, M_FX[ISL_P(s,3)]*2.5);
  thr = (M_FX[ISL_P(s,2)]*0.01)^2*0.3;
  tgt = max2(abs(fxL), abs(fxR)) > thr ? 1 : 0;
  rs = max2(1, M_FX[ISL_P(s,1)]*0.01*srate);
  st2 = FXT(s);
  st2[3] += (tgt - st2[3])*(tgt > st2[3] ? 0.002 : 1/rs);
  wl = gWL*st2[3]; wr = gWR*st2[3];
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + wl*mix;
  fxR = fxR*(1 - mix) + wr*mix;
);

function fxStereo(s) local(mid, side, gl2, gr2, ol, orr, pn, mix) (
  mid = (fxL + fxR)*0.5;
  side = (fxL - fxR)*0.5*M_FX[ISL_P(s,0)]*0.02;
  pn = M_FX[ISL_P(s,2)]*0.01;
  gl2 = min2(1, 1 - pn); gr2 = min2(1, 1 + pn);
  ol = (mid + side)*gl2; orr = (mid - side)*gr2;
  mix = M_FX[ISL_MIX(s)]*0.01;
  fxL = fxL*(1 - mix) + ol*mix;
  fxR = fxR*(1 - mix) + orr*mix;
);

function fxTypeName(t) (
  t == 1 ? "DELAY" : t == 2 ? "CHORUS" : t == 3 ? "FLANGER" : t == 4 ? "PHASER"
  : t == 5 ? "DISTORT" : t == 6 ? "CRUSH" : t == 7 ? "COMP" : t == 8 ? "LIMIT"
  : t == 9 ? "ROOM" : t == 10 ? "TRASH" : t == 11 ? "GATE" : t == 12 ? "STEREO" : "OFF";
);

function fxLabels(t) (
  t == 1 ? "TIME  FEEDB  SPREAD  DAMP"
  : t == 2 ? "RATE  DEPTH  BASE  SPREAD"
  : t == 3 ? "RATE  DEPTH  FEEDB  BASE"
  : t == 4 ? "RATE  DEPTH  FEEDB  SPREAD"
  : t == 5 ? "DRIVE  TONE  -  -"
  : t == 6 ? "BITS  SRR  -  -"
  : t == 7 ? "THRESH  RATIO  ATTACK  RELEASE"
  : t == 8 ? "THRESH  RELEASE  -  -"
  : t == 9 ? "SIZE  DAMP  WIDTH  PRE"
  : t == 10 ? "DECAY  CRUSH  DRIVE  PRE"
  : t == 11 ? "DECAY  HOLD  THRESH  PRE"
  : t == 12 ? "WIDTH  PAN  -  -" : "-  -  -  -";
);

function fxVals(t, s) (
  t == 1 ? (
    M_SYS[SYS_SYNC] == 1 || M_SYS[SYS_SYNC] == 3 ? (
      dvN = floor(M_FX[ISL_P(s,0)]*0.0799); dvN < 0 ? dvN = 0; dvN > 7 ? dvN = 7;
      sprintf(#n2str, "%s", dlyDivName(dvN));
    ) : ( sprintf(#n2str, "%dms", floor(M_FX[ISL_P(s,0)])*10); );
    sprintf(#vstr, "%s %d%% %d%% %d%%", #n2str, floor(M_FX[ISL_P(s,1)]), floor(M_FX[ISL_P(s,2)]), floor(M_FX[ISL_P(s,3)]));
  )
  : t == 2 || t == 3 || t == 4 ? sprintf(#vstr, "%.1fHz %d%% %d%% %d%%", 0.1*80^(M_FX[ISL_P(s,0)]*0.01), floor(M_FX[ISL_P(s,1)]), floor(M_FX[ISL_P(s,2)]), floor(M_FX[ISL_P(s,3)]))
  : t == 5 ? sprintf(#vstr, "%d%% %dHz", floor(M_FX[ISL_P(s,0)]), floor(min2(18000, 500*80^(M_FX[ISL_P(s,1)]*0.01))))
  : t == 6 ? sprintf(#vstr, "%dbit %d%%", 1 + floor(M_FX[ISL_P(s,0)]*0.15), floor(M_FX[ISL_P(s,1)]))
  : t == 7 ? sprintf(#vstr, "%ddB %.1f:1 %dms %dms", floor(-48 + 0.48*M_FX[ISL_P(s,0)]), 1 + M_FX[ISL_P(s,1)]*0.19, floor(M_FX[ISL_P(s,2)]*0.1), floor(M_FX[ISL_P(s,3)]*10))
  : t == 8 ? sprintf(#vstr, "%ddB %dms", floor(-48 + 0.48*M_FX[ISL_P(s,0)]), floor(M_FX[ISL_P(s,3)]*10))
  : t == 11 ? sprintf(#vstr, "%d%% %dms %d%%", floor(M_FX[ISL_P(s,0)]), floor(M_FX[ISL_P(s,1)]*10), floor(M_FX[ISL_P(s,2)]))
  : t == 12 ? sprintf(#vstr, "%d%% %s", floor(M_FX[ISL_P(s,0)]*2), M_FX[ISL_P(s,2)] < -2 ? "L" : M_FX[ISL_P(s,2)] > 2 ? "R" : "C")
  : sprintf(#vstr, "%d%% %d%% %d%% %dms", floor(M_FX[ISL_P(s,0)]), floor(M_FX[ISL_P(s,1)]), floor(M_FX[ISL_P(s,2)]), floor(M_FX[ISL_P(s,3)]));
);


/* FX-Preset-Datei tt-phalyx-fx.bin: 45 float32-Worte = M_FX[0..44]
   (ON + EQ 4x4 + 4 Slots a 7). Wird wie kit.bin alle ~0,5 s gelesen —
   Presets sind damit einfache Dateien (Lua/PHP schreibt sie). */

function fxScan() local(fh, i, v2) (
  fh = file_open("tt-phalyx-fx.bin");
  fh ? fh : file_open("C:/Users/micro/AppData/Roaming/REAPER/Effects/TimTechlor/TT-PHALYX/tt-phalyx-fx.bin");
  fh ? (
    i = 0;
    loop(45, file_var(fh, v2); M_FX[i] = v2; i += 1; );
    file_close(fh);
    fxDirty = 1;
    fxFileOk = 1;
  ) : ( fxFileOk = 0; );
);


/* ---------- MIDI ---------- */

// Instrument: Noten werden verbraucht, CC/Pitchbend gehen durch.
// Kit-Modus hoert auf Kanal 1 (wie Phalanx), Multitrack auf dem
// eigenen Kanal.
function handleMidi(m1, m2, m3) local(st, p, md, ch) (
  st = m1 & 0xF0;
  st == 0x90 || st == 0x80 ? (
    m2 = min2(127, max2(0, m2 + floor(M_SYS[SYS_TRANS] + 0.5)));
  ) : 0;
  st == 0xE0 ? ( pbT = ((m2 + m3*128) - 8192)*0.0001220703125; ) : 0;
  st == 0xB0 && m2 < 120 ? ( ccN = m2; ccV = m3; ) : 0;
  st == 0x90 && m3 > 0 ? (
    M_ST[2061] += 1;                           // Debug: Note-Ons
    ch = (m1 & 0x0F) + 1;
    // Killnoten zuerst: diese Note schaltet Pads hart ab
    p = 0;
    loop(16, floor(PF(PF_KILL, p) + 0.5) == m2 ? killPad(p); p += 1; );
    p = 0;
    loop(16,
      md = floor(PF(PF_MODE, p) + 0.5);
      md == 0 ? ( ch == 1 && floor(PF(PF_NOTE, p) + 0.5) == m2 ? ( noteOnPad(p, m2, m3); M_MON[p] = m3*0.0078740157; evDspP = p; ); )
              : ( md == ch ? ( noteOnPad(p, m2, m3); M_MON[p] = m3*0.0078740157; evDspP = p; ); );
      p += 1;
    );
    evDspN = m2; evDspV = m3; evDspOn = 1; evDspCnt += 1;
  )
  : (st == 0x80 || (st == 0x90 && m3 == 0)) ? releaseNote(m2, (m1 & 0x0F) + 1)
  : st == 0xB0 && (m2 == 120 || m2 == 123) ? allNotesOff()
  : 0;
);

/* ---------- Slider-Spiegel (Automation + gfx) ----------
   Slider 34..46 spiegeln das ausgewaehlte Pad. M_LSL verhindert
   Echos; die push-Funktionen schreiben Array + Slider.        */

function pullSliders() (
  slider3 = PF(PF_VOL,  selPad); M_LSL[3] = slider3;
  slider4 = PF(PF_PAN,  selPad); M_LSL[4] = slider4;
  slider5 = PF(PF_TRNA, selPad); M_LSL[5] = slider5;
  slider6 = PF(PF_FINA, selPad); M_LSL[6] = slider6;
  slider7 = PF(PF_TRNB, selPad); M_LSL[7] = slider7;
  slider8 = PF(PF_FINB, selPad); M_LSL[8] = slider8;
  slider9 = PF(PF_XF,   selPad); M_LSL[9] = slider9;
  slider10 = PF(PF_MUTE, selPad); M_LSL[10] = slider10;
  slider11 = PF(PF_SOLO, selPad); M_LSL[11] = slider11;
  slider12 = PF(PF_MODE, selPad); M_LSL[12] = slider12;
  slider13 = PF(PF_NOTE, selPad); M_LSL[13] = slider13;
  slider14 = PF(PF_KILL, selPad); M_LSL[14] = slider14;
  slider15 = PF(MM_SRC,     selPad); M_LSL[15] = slider15;
  slider16 = PF(MM_DST,     selPad); M_LSL[16] = slider16;
  slider17 = PF(MM_AMT,     selPad); M_LSL[17] = slider17;
  slider18 = PF(MM_SRC + 3, selPad); M_LSL[18] = slider18;
  slider19 = PF(MM_DST + 3, selPad); M_LSL[19] = slider19;
  slider20 = PF(MM_AMT + 3, selPad); M_LSL[20] = slider20;
  slider21 = PF(MM_SRC + 6, selPad); M_LSL[21] = slider21;
  slider22 = PF(MM_DST + 6, selPad); M_LSL[22] = slider22;
  slider23 = PF(MM_AMT + 6, selPad); M_LSL[23] = slider23;
  slider24 = PF(MM_SRC + 9, selPad); M_LSL[24] = slider24;
  slider25 = PF(MM_DST + 9, selPad); M_LSL[25] = slider25;
  slider26 = PF(MM_AMT + 9, selPad); M_LSL[26] = slider26;
  slider27 = PF(MM_SRC + 12, selPad); M_LSL[27] = slider27;
  slider28 = PF(MM_DST + 12, selPad); M_LSL[28] = slider28;
  slider29 = PF(MM_AMT + 12, selPad); M_LSL[29] = slider29;
  slider30 = PF(MM_SRC + 15, selPad); M_LSL[30] = slider30;
  slider31 = PF(MM_DST + 15, selPad); M_LSL[31] = slider31;
  slider32 = PF(MM_AMT + 15, selPad); M_LSL[32] = slider32;
  slider33 = PF(MM_SRC + 18, selPad); M_LSL[33] = slider33;
  slider34 = PF(MM_DST + 18, selPad); M_LSL[34] = slider34;
  slider35 = PF(MM_AMT + 18, selPad); M_LSL[35] = slider35;
  slider36 = PF(MM_SRC + 21, selPad); M_LSL[36] = slider36;
  slider37 = PF(MM_DST + 21, selPad); M_LSL[37] = slider37;
  slider38 = PF(MM_AMT + 21, selPad); M_LSL[38] = slider38;
  slider39 = PF(L1_SHAPE, selPad); M_LSL[39] = slider39;
  slider40 = PF(L1_RATE,  selPad); M_LSL[40] = slider40;
  slider41 = PF(L1_RETRIG, selPad); M_LSL[41] = slider41;
  slider42 = PF(L2_SHAPE, selPad); M_LSL[42] = slider42;
  slider43 = PF(L2_RATE,  selPad); M_LSL[43] = slider43;
  slider44 = PF(L2_RETRIG, selPad); M_LSL[44] = slider44;
  slider45 = PF(MEN_ATK, selPad); M_LSL[45] = slider45;
  slider46 = PF(MEN_DEC, selPad); M_LSL[46] = slider46;
  slider47 = PF(MEN_SUS, selPad); M_LSL[47] = slider47;
  slider48 = PF(MEN_REL, selPad); M_LSL[48] = slider48;
  slider49 = PF(VEL_DEPTH, selPad); M_LSL[49] = slider49;
  slider50 = PF(VEL_CURVE, selPad); M_LSL[50] = slider50;
  slider51 = PF(PANA, selPad); M_LSL[51] = slider51;
  slider52 = PF(PANB, selPad); M_LSL[52] = slider52;
  slider54 = M_SYS[SYS_AA]; M_LSL[54] = slider54;
  slider55 = M_SYS[SYS_TRANS]; M_LSL[55] = slider55;
  slider56 = PF(ARP_MODE, selPad); M_LSL[56] = slider56;
  slider57 = PF(ARP_RATE, selPad); M_LSL[57] = slider57;
  slider58 = PF(ARP_OCT, selPad); M_LSL[58] = slider58;
  slider59 = PF(ARP_GATE, selPad); M_LSL[59] = slider59;
  slider60 = PF(PF_ROOT, selPad); M_LSL[60] = slider60;
  slider61 = PF(PBR, selPad); M_LSL[61] = slider61;
  slider62 = PF(SHUF, selPad); M_LSL[62] = slider62;
  slider63 = M_SYS[SYS_SYNC]; M_LSL[63] = slider63;
);

function pushVol(v)  ( PF_SET(PF_VOL,  selPad, v); slider3 = v; M_LSL[3] = v; slider_automate(slider3); paramsDirty = 1; );
function pushPan(v)  ( PF_SET(PF_PAN,  selPad, v); slider4 = v; M_LSL[4] = v; slider_automate(slider4); paramsDirty = 1; );
function pushTrA(v)  ( PF_SET(PF_TRNA, selPad, v); slider5 = v; M_LSL[5] = v; slider_automate(slider5); );
function pushFinA(v) ( PF_SET(PF_FINA, selPad, v); slider6 = v; M_LSL[6] = v; slider_automate(slider6); );
function pushTrB(v)  ( PF_SET(PF_TRNB, selPad, v); slider7 = v; M_LSL[7] = v; slider_automate(slider7); );
function pushFinB(v) ( PF_SET(PF_FINB, selPad, v); slider8 = v; M_LSL[8] = v; slider_automate(slider8); );

// Allgemeines Pad-Feld schreiben; Felder mit Slider-Spiegel synchronisieren
// diesen gleich mit (Automation bleibt konsistent)
function pushF(f, v) (
  f == PF_TRNA ? (PF_SET(f, selPad, v); slider5 = v; M_LSL[5] = v; slider_automate(slider5);)
  : f == PF_FINA ? (PF_SET(f, selPad, v); slider6 = v; M_LSL[6] = v; slider_automate(slider6);)
  : f == PF_VOL ? (PF_SET(f, selPad, v); slider3 = v; M_LSL[3] = v; slider_automate(slider3); paramsDirty = 1;)
  : f == PF_PAN ? (PF_SET(f, selPad, v); slider4 = v; M_LSL[4] = v; slider_automate(slider4); paramsDirty = 1;)
  : PF_SET(f, selPad, v);
);

// Slot-abhaengige Felder (A/B-Schalter uebernimmt die Reglerziele)
function sfTRN()   ( slotSel == 0 ? PF_TRNA : PF_TRNB );
function sfFIN()   ( slotSel == 0 ? PF_FINA : PF_FINB );
function sfGAIN()  ( slotSel == 0 ? PF_GAINA : PF_GAINB );
function sfSTART() ( slotSel == 0 ? PF_START_A : PF_START_B );
function sfRND()   ( slotSel == 0 ? PF_RNDA : PF_RNDB );
function sfDLY()   ( slotSel == 0 ? PF_DLY_A : PF_DLY_B );
function sfLPF()   ( slotSel == 0 ? PF_LPF_A : PF_LPF_B );
function sfHPF()   ( slotSel == 0 ? PF_HPF_A : PF_HPF_B );
function sfLOFI()  ( slotSel == 0 ? PF_LOFI_A : PF_LOFI_B );
function sfSPIKE() ( slotSel == 0 ? PF_SPIKE_A : PF_SPIKE_B );
function sfPHINV() ( slotSel == 0 ? PF_PHINV_A : PF_PHINV_B );
function sfREV()   ( slotSel == 0 ? PF_REV_A : PF_REV_B );
function pushXf(v)   ( PF_SET(PF_XF,   selPad, v); slider9 = v; M_LSL[9] = v; slider_automate(slider9); );
function pushMute(v) ( PF_SET(PF_MUTE, selPad, v); slider10 = v; M_LSL[10] = v; slider_automate(slider10); paramsDirty = 1; );
function pushSolo(v) ( PF_SET(PF_SOLO, selPad, v); slider11 = v; M_LSL[11] = v; slider_automate(slider11); paramsDirty = 1; );
function pushMode(v) ( v = min2(16, max2(0, floor(v + 0.5))); PF_SET(PF_MODE, selPad, v); slider12 = v; M_LSL[12] = v; slider_automate(slider12); );
function pushNote(v) ( v = min2(127, max2(0, floor(v + 0.5))); PF_SET(PF_NOTE, selPad, v); slider13 = v; M_LSL[13] = v; slider_automate(slider13); );
function pushKill(v) ( v = min2(127, max2(-1, floor(v + 0.5))); PF_SET(PF_KILL, selPad, v); slider14 = v; M_LSL[14] = v; slider_automate(slider14); );
function pushVoi(v)  ( PF_SET(PF_VOI, selPad, min2(16, max2(1, floor(v + 0.5)))); );
// Root (Multitrack-Keytrack-Basis) + Pitchbend-Range
function pushRoot(v) ( v = min2(127, max2(0, floor(v + 0.5))); PF_SET(PF_ROOT, selPad, v); slider60 = v; M_LSL[60] = v; slider_automate(slider60); );
function pushPbr(v)  ( v = min2(24, max2(0, floor(v + 0.5))); PF_SET(PBR, selPad, v); slider61 = v; M_LSL[61] = v; slider_automate(slider61); );
function push1shot(v)( PF_SET(PF_1SHOT, selPad, v > 0.5 ? 1 : 0); );
function pushAtk(v) ( PF_SET(PF_ATK, selPad, v); );
function pushDec(v) ( PF_SET(PF_DEC, selPad, v); );
function pushSus(v) ( PF_SET(PF_SUS, selPad, v); );
function pushRel(v) ( PF_SET(PF_REL, selPad, v); );
function pushTsc(v) ( PF_SET(PF_TIMESC, selPad, min2(200, max2(25, floor(v + 0.5)))); );

// Die Spiegel-Slider 15..52 (Feld 72..109 = Slider-Nr + 57) werden
// bewusst NICHT zurueckgeschrieben: sie sind Einbahnstrasse Host ->
// Engine (Automation/MIDI-Learn), pullSliders haelt sie aktuell.
function pushM(f, v) ( PF_SET(f, selPad, v); paramsDirty = 1; );

// Undo: Snapshot eines Pads (beim Padwechsel automatisch, sonst per SNAP)
function undoSnap(p) local(k) (
  k = 0;
  loop(128, M_UND[k] = M_PAD[p*128+k]; k += 1; );
  undoPad = p;
);
function undoRest() local(k) (
  undoPad >= 0 ? (
    k = 0;
    loop(128, M_PAD[undoPad*128+k] = M_UND[k]; k += 1; );
    paramsDirty = 1;
    // Inline-Selektion (selectPad ist hier noch nicht definiert und
    // wuerde zudem einen frischen Snapshot ueber den Undo-Stand schreiben)
    selPad = undoPad;
    slider2 = selPad + 1; M_LSL[2] = slider2; slider_automate(slider2);
    pullSliders();
  ) : 0;
);

function selectPad(i) (
  selPad != i ? undoSnap(selPad) : 0;
  selPad = i;
  slider2 = i + 1; M_LSL[2] = slider2; slider_automate(slider2);
  pullSliders();
);

/* ---------- Preset-Banks ----------
   Bank-Dateien tt-phalyx-bank1..8.bin: gleiche Struktur wie der
   Serialize-Blob (magic, phxVer, 2112 Worte State, 96 Worte FX).
   Samples kommen weiterhin aus dem Kit — eine Bank sichert die
   komplette Parameter- und FX-Seite.
   Lesen kann JSFX (B1-B8 im SYSTEM-Tab); SCHREIBEN kann die Sandbox
   nicht (file_open hat hier nur 1 Parameter, rein lesend) — speichern
   tut das Lua-Skript "TT-PHALYX Bank speichern.lua" (Scripts-Ordner):
   es legt den JS_SER-Blob des Projekts als Bankdatei ab. */

function bankLoad(n) local(fh, mg, vr, p, k) (
  sprintf(#bkstr, "C:/Users/micro/AppData/Roaming/REAPER/Effects/TimTechlor/TT-PHALYX/tt-phalyx-bank%d.bin", floor(n));
  fh = file_open(#bkstr);
  fh ? (
    file_var(fh, mg); file_var(fh, vr);
    mg == 1480923721 && floor(vr + 0.5) == phxVer ? (
      file_mem(fh, M_ST, 2112);
      file_mem(fh, M_FX, 96);
      p = 0; loop(16, k = 0; loop(128, M_PAD[p*128+k] = M_ST[p*128+k]; k += 1; ); p += 1; );
      polyMax = floor(M_ST[2048] + 0.5);
      polyMax < 4 ? polyMax = 4; polyMax > 64 ? polyMax = 64;
      gmod1 = M_ST[2049]; gmod2 = M_ST[2050]; gmod3 = M_ST[2051];
      M_SYS[SYS_AA] = M_ST[2052]; M_SYS[SYS_TRANS] = M_ST[2053]; M_SYS[SYS_SYNC] = M_ST[2054];
      paramsDirty = 1; fxDirty = 1;
      allNotesOff();
      pullSliders();
      bankOk = 2;
    ) : ( bankOk = 3; );
    file_close(fh);
  ) : ( bankOk = 3; );
);

/* ---------- Oberflaechen-Bausteine
   Designraster 1020 x 744; SC skaliert, Maus zurueckgerechnet.

   Vergebene Zieh-IDs (dragId):
     1..8       Drehregler Pad (Transpose/Fine A+B, Volume, Pan)
     30         Master · 31 Polyphonie
     100        Crossfade-Fader
     110..125   Slim-Pad-Fader
     200..203   Env-Dots (Phase 2) · 300+ Loop-Flags (Phase 3)
     400..407   Mod-Matrix-Amounts · 410 ARP-Shuffle
     120        Scratch-Fahne auf der Wellenform                  */

function xrect(x, y, w, h) (
  gfx_rect(OX + x*SC, OY + y*SC, max2(1, w*SC), max2(1, h*SC), 1);
);
function xline(x1, y1, x2, y2) (
  gfx_line(OX + x1*SC, OY + y1*SC, OX + x2*SC, OY + y2*SC, 1);
);
function xcirc(x, y, r, f) (
  gfx_circle(OX + x*SC, OY + y*SC, max2(1, r*SC), f, 1);
);
function xat(x, y) ( gfx_x = OX + x*SC; gfx_y = OY + y*SC; );
function xstr(x, y, s) ( xat(x, y); gfx_drawstr(s); );
function xctr(x, y, w, h, s) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = OX + x*SC + (w*SC - tw)*0.5;
  gfx_y = OY + y*SC + (h*SC - th)*0.5;
  gfx_drawstr(s);
);
function inBox(bx, by, bw, bh) (
  mX >= bx && mX < bx + bw && mY >= by && mY < by + bh;
);

function colAcid(a)  ( gfx_set(0.224, 1.000, 0.078, a); );   // #39FF14
function colDim(a)   ( gfx_set(0.130, 0.340, 0.090, a); );
function colWhite(a) ( gfx_set(1, 1, 1, a); );
function colInk(a)   ( gfx_set(0.75, 0.81, 0.75, a); );

function pad(x, y, r) (
  colAcid(1); xcirc(x, y, r, 1);
  gfx_set(0, 0, 0, 1); xcirc(x, y, r*0.40, 1);
);

function trace(x1, y1, x2, y2) local(kx) (
  kx = x2 - abs(y2 - y1);
  colDim(1);
  xline(x1, y1, kx, y1);
  xline(kx, y1, x2, y2);
);

function panelBox(x, y, w, h) (
  gfx_set(0.072, 0.077, 0.072, 1); xrect(x, y, w, h);
  gfx_set(0.125, 0.155, 0.115, 1);
  xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
  xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
);

function btn(x, y, w, h, on, s) local(hit, hov) (
  hov = inBox(x, y, w, h);
  hit = uiClick && hov;
  on ? (
    colAcid(0.88); xrect(x, y, w, h);
    gfx_set(0, 0, 0, 1);
  ) : (
    gfx_set(0.098, 0.103, 0.098, 1); xrect(x, y, w, h);
    hov ? gfx_set(0.30, 0.46, 0.26, 1) : gfx_set(0.15, 0.20, 0.14, 1);
    xrect(x, y, w, 1); xrect(x, y + h - 1, w, 1);
    xrect(x, y, 1, h); xrect(x + w - 1, y, 1, h);
    hov ? gfx_set(0.85, 0.95, 0.82, 1) : gfx_set(0.78, 0.84, 0.76, 1);
  );
  xctr(x, y, w, h, s);
  hit;
);

function knobDef(id) (
  id == 1 ? 0 : id == 2 ? 0 : id == 3 ? 0 : id == 4 ? 0
  : id == 5 ? 80 : id == 6 ? 0
  : id == 7 ? 0                                   // RETRIG (0 = aus)
  : id == 30 ? 90 : id == 31 ? 64
  : id == 40 ? 0 : id == 41 ? 0 : id == 42 ? 100 : id == 43 ? 0
  : id == 44 ? 0 : id == 45 ? 0
  : id == 46 ? 100 : id == 47 ? 0 : id == 48 ? 0 : id == 49 ? 0
  : id == 32 ? 100 : id == 33 ? 100 : id == 34 ? 0
  : id == 35 ? 1 : id == 36 ? 100 : id == 37 ? 0 : id == 38 ? 0
  : id == 39 ? 0 : id == 50 ? 0 : id == 51 ? 0 : id == 52 ? 0
  : id == 53 ? 10
  : id == 54 ? 0 : id == 55 ? 0 : id == 56 ? 0    // GUI-Modifier G1-G3
  : id == 60 ? 0 : id == 61 ? 0                   // LFO1/LFO2 Rate
  : id == 62 ? 0.003 : id == 63 ? 0.25 : id == 64 ? 0 : id == 65 ? 0.12  // Mod-Env
  : id == 66 ? 100 : id == 67 ? 0 : id == 68 ? 0  // Vel-Depth, Pan A/B
  : id == 106 ? 40 : id == 107 ? 80 : id == 108 ? 0 // ARP Rate/Gate, Sys-Transpose
  : id >= 70 && id <= 101 ? 50                    // EQ- + FX-Regler (Mitten)
  : 0;
);

function knob(id, cx, cy, r, val, vmn, vmx)
  local(t, i, a, ri, ro, nv, dv, hot, sh, def, nTick) (
  nv = val;
  def = knobDef(id);
  sh = (mouse_cap & 8) ? 1 : 0;
  hot = (mX - cx)*(mX - cx) + (mY - cy)*(mY - cy) <= (r + 7)*(r + 7);
  uiRClk && hot ? ( nv = def; )
  : uiClick && hot ? (
      clickId == id && clickWait > 0 ? ( nv = def; dragId = -1; clickWait = 0; )
      : ( dragId = id; dragY = mY; dragV = val; dragSh = sh; clickId = id; clickWait = 12; );
    );
  dragId == id && uiLmb ? (
    sh != dragSh ? ( dragSh = sh; dragY = mY; dragV = val; );
    dv = (dragY - mY)/(sh ? 900 : 170);
    nv = min2(vmx, max2(vmn, dragV + dv*(vmx - vmn)));
  );
  hot && mouse_wheel != 0 ? (
    nv = min2(vmx, max2(vmn, val + (mouse_wheel/120)*(vmx - vmn)*0.02));
    mouse_wheel = 0;
  );
  t = (nv - vmn)/(vmx - vmn);
  gfx_set(0.105, 0.110, 0.105, 1); xcirc(cx, cy, r - 5, 1);
  hot || dragId == id ? gfx_set(0.26, 0.40, 0.24, 1) : gfx_set(0.15, 0.19, 0.14, 1);
  xcirc(cx, cy, r - 5, 0);
  nTick = (hot || dragId == id) ? 24 : 12;
  i = 0;
  loop(nTick + 1,
    a = (-225 + 270*i/nTick)*$pi/180;
    ri = r - 3; ro = r + 1;
    i/nTick <= t ? colAcid(1) : gfx_set(0.16, 0.18, 0.15, 1);
    xline(cx + cos(a)*ri, cy + sin(a)*ri, cx + cos(a)*ro, cy + sin(a)*ro);
    i += 1;
  );
  a = (-225 + 270*t)*$pi/180;
  colWhite(1);
  xline(cx + cos(a)*(r - 16), cy + sin(a)*(r - 16), cx + cos(a)*(r - 7), cy + sin(a)*(r - 7));
  gfx_set(0.30, 0.34, 0.30, 1); xcirc(cx, cy, 2, 1);
  nv;
);

// Zeichenkette in #vstr zentriert bei (cx, y) — Schrift vorher setzen
function drawCentered(cx, y) local(w, h) (
  gfx_measurestr(#vstr, w, h);
  xat(cx - w*0.5, y); gfx_drawstr(#vstr);
);

// Vertikale Waveform (Slim-Pad, 64 Punkte aus dem 128er-Peak-Cache)
function drawWaveV(x, y, w, h, sl, bright) local(k, amp, a2) (
  gfx_set(0.10, 0.13, 0.08, 1);
  xline(x + w*0.5, y + 1, x + w*0.5, y + h - 1);
  bright > 1.5 ? colAcid(0.85) : bright > 0.5 ? colAcid(0.40) : colAcid(0.18);
  k = 0;
  loop(64,
    amp = M_PEAK[sl*128 + k*2];
    amp > 1 ? amp = 1 : 0;
    a2 = amp*w*0.46;
    a2 < 0.75 ? a2 = 0.75 : 0;
    xline(x + w*0.5 - a2, y + h - (k + 1)*h/64, x + w*0.5 + a2, y + h - (k + 1)*h/64);
    k += 1;
  );
);

// Horizontale Waveform (Full-Panel/Editor, 128 Punkte)
function drawWaveH(x, y, w, h, sl, rr, gg, bb) local(k, amp, sx) (
  gfx_set(0.10, 0.13, 0.08, 1);
  xline(x, y + h*0.5, x + w, y + h*0.5);
  gfx_set(rr, gg, bb, 1);
  k = 0;
  loop(128,
    amp = M_PEAK[sl*128 + k];
    amp > 1 ? amp = 1 : 0;
    amp < 0.008 ? amp = 0.008 : 0;
    sx = x + k*w/127;
    xline(sx, y + h*0.5 - amp*h*0.46, sx, y + h*0.5 + amp*h*0.46);
    k += 1;
  );
);

// Pad-Namen zeichnen (Dateiname oder Default-Label)
function drawPadName(s, p, x, y) (
  M_SLI[s*10+SF] == 1 ? ( nameFill(s); gfx_drawstr(#nmstr); )
                     : gfx_drawstr(defaultPadName(p));
);

/* ---------- Grundzustand ---------- */

// Werks-Parameter aller Pads schreiben (Init + Serialize-Reset)
function writeDefaults() local(p, mr2) (
  p = 0;
  loop(16,
    PF_SET(PF_VOL, p, 80); PF_SET(PF_PAN, p, 0);
    PF_SET(PF_TRNA, p, 0); PF_SET(PF_FINA, p, 0);
    PF_SET(PF_TRNB, p, 0); PF_SET(PF_FINB, p, 0);
    PF_SET(PF_XF, p, 0); PF_SET(PF_MUTE, p, 0); PF_SET(PF_SOLO, p, 0);
    PF_SET(PF_MODE, p, 0);
    PF_SET(PF_NOTE, p, gmNote(p));
    PF_SET(PF_KILL, p, p == 3 ? 42 : -1);   // Closed HH (42) killt Open HH
    PF_SET(PF_VOI, p, 8);
    PF_SET(PF_ATK, p, 0.001); PF_SET(PF_DEC, p, 0.8);
    PF_SET(PF_SUS, p, 0); PF_SET(PF_REL, p, 0.05);
    PF_SET(PF_1SHOT, p, 1); PF_SET(PF_ROOT, p, 36);
    PF_SET(PF_GAINA, p, 100); PF_SET(PF_LPF_A, p, 100); PF_SET(PF_HPF_A, p, 0);
    PF_SET(PF_LOFI_A, p, 0); PF_SET(PF_SPIKE_A, p, 0); PF_SET(PF_DLY_A, p, 0);
    PF_SET(PF_PHINV_A, p, 0); PF_SET(PF_START_A, p, 0); PF_SET(PF_RNDA, p, 0);
    PF_SET(PF_REV_A, p, 0);
    PF_SET(PF_GAINB, p, 100); PF_SET(PF_LPF_B, p, 100); PF_SET(PF_HPF_B, p, 0);
    PF_SET(PF_LOFI_B, p, 0); PF_SET(PF_SPIKE_B, p, 0); PF_SET(PF_DLY_B, p, 0);
    PF_SET(PF_PHINV_B, p, 0); PF_SET(PF_START_B, p, 0); PF_SET(PF_RNDB, p, 0);
    PF_SET(PF_REV_B, p, 0);
    PF_SET(PF_RT_RATE, p, 0); PF_SET(PF_RT_KTRK, p, 100); PF_SET(PF_RT_FADE, p, 0);
    PF_SET(PF_TIMESC, p, 100);
    PF_SET(FLT_TYPE, p, 1); PF_SET(FLT_CUT, p, 100); PF_SET(FLT_RES, p, 0);
    PF_SET(FLT_ENV, p, 0); PF_SET(FLT_DRV, p, 0); PF_SET(FLT_MODE, p, 0);
    PF_SET(FEA_ATK, p, 0.003); PF_SET(FEA_DEC, p, 0.25); PF_SET(FEA_SUS, p, 0.4);
    PF_SET(FEA_REL, p, 0.12);
    PF_SET(PEN_RANGE, p, 0); PF_SET(PEN_STEPS, p, 0); PF_SET(PEN_FLIP, p, 0);
    PF_SET(PORTA_MODE, p, 0); PF_SET(PORTA_TIME, p, 60);
    PF_SET(LON_A, p, 0); PF_SET(LSTA_A, p, 0); PF_SET(LEN_A, p, 1000);
    PF_SET(LTYPE_A, p, 0); PF_SET(LXFD_A, p, 10);
    PF_SET(LON_B, p, 0); PF_SET(LSTA_B, p, 0); PF_SET(LEN_B, p, 1000);
    PF_SET(LTYPE_B, p, 0); PF_SET(LXFD_B, p, 10);
    PF_SET(PEA_ATK, p, 0.003); PF_SET(PEA_DEC, p, 0.25);
    PF_SET(PEA_SUS, p, 0.4); PF_SET(PEA_REL, p, 0.12);
    mr2 = 0;
    loop(8,
      PF_SET(MM_SRC + mr2*3, p, 0); PF_SET(MM_DST + mr2*3, p, 0);
      PF_SET(MM_AMT + mr2*3, p, 0);
      mr2 += 1;
    );
    PF_SET(L1_SHAPE, p, 0); PF_SET(L1_RATE, p, 0); PF_SET(L1_RETRIG, p, 1);
    PF_SET(L2_SHAPE, p, 0); PF_SET(L2_RATE, p, 0); PF_SET(L2_RETRIG, p, 1);
    PF_SET(MEN_ATK, p, 0.003); PF_SET(MEN_DEC, p, 0.25);
    PF_SET(MEN_SUS, p, 0); PF_SET(MEN_REL, p, 0.12);
    PF_SET(VEL_DEPTH, p, 100); PF_SET(VEL_CURVE, p, 0);
    PF_SET(PANA, p, 0); PF_SET(PANB, p, 0);
    PF_SET(ARP_MODE, p, 0); PF_SET(ARP_RATE, p, 40); PF_SET(ARP_OCT, p, 1);
    PF_SET(ARP_GATE, p, 80); PF_SET(SCR_ON, p, 0);
    PF_SET(PBR, p, 2); PF_SET(SHUF, p, 0);
    p += 1;
  );
);
padInit != 1 ? ( writeDefaults(); fxDefaults(); padInit = 1; );
polyMax < 4 ? polyMax = 64;
polyMax > 64 ? polyMax = 64;

// Zwei memsets: M_PAD/M_NAME/M_PEAK/M_ST/M_SLI/M_PATH/M_LSL/Sample-RAM
// bleiben erhalten; M_LSL bewusst ausgespart (Pad-Auswahl ueberlebt
// den Transportstart).
memset(0, 0, 1024);
memset(M_EVT, 0, M_LSL - M_EVT);

// Stimmen und Ablauf
voxRR = 0; smplPos = 0; evN = 0; evRd = 0; paramsDirty = 1;
accentLed = 0; scopePos = 0; scopeDiv = 0;
fxDirty = 1;
evDspN = -1; evDspV = 0; evDspP = -1; evDspOn = 0; evDspCnt = 0;

// Datei-Scan anstossen (auch nach Samplerate-Wechsel); Kit beim ersten
// Block einlesen (kitPoll vorgespult)
srate != lastSrate ? (
  lastSrate = srate;
  i = 0; loop(32, M_SLI[i*10+SL] = 0; M_SLI[i*10+SF] = 0; M_SLI[i*10+4] = 0; i += 1; );
  topUse = 0;
  allNotesOff();
  fxDirty = 1;
);
// FX-Pufferpool liegt an festen Adressen ab M_TOP, Sample-RAM darueber
topUse < FXPOOL ? ( topUse = FXPOOL; );
filesDirty = 1;
kitPoll = 24; kitOk = 0; kitLines = 0;
// needDefaults bewusst NICHT hier zuruecksetzen: @serialize kann vor
// @init laufen (frische Instanz) und das Flag fuer @block vorbereitet haben.
fxReady = 0;
// System/Arp/Undo-Regionen initialisieren (liegen oberhalb der
// memset-Luecken; @serialize-Restore schreibt sie danach wieder voll).
// M_SYS nur bei erster Inbetriebnahme nullen — @init laeuft bei jedem
// Geraete-(Re)Open erneut und wuerde AA/Transpose sonst zuruecksetzen.
padInit != 1 ? (
  i = 0; loop(16, M_SYS[i] = 0; i += 1; );
) : 0;
i = 0; loop(256, M_ARP[i] = 0; i += 1; );
i = 0; loop(128, M_UND[i] = 0; i += 1; );
// Monitor + Pitchbend + Clip
i = 0; loop(16, M_MON[i] = 0; i += 1; );
pbT = 0; pbS = 0; ccN = -1; ccV = 0; clipPk = 0; clipLed = 0;
arpXp = 0; gLastVox = -1; undoPad = -1; bankOk = -1; arpAct = 0;

// Oberflaeche
SC = 1; OX = 0; OY = 0; mX = -1; mY = -1;
dragId = -1; dragX = 0; dragY = 0; dragV = 0; dragSh = 0;
lmbPrev = 0; rmbPrev = 0; clickId = -1; clickWait = 0;
fontChk = 0; sansSel = 0; monoSel = 0; bigSel = 0;
fBigP = -1; fMedP = -1; fSmlP = -1;
slInit != 1 ? ( selPad = 0; );
tabSel = 0; slotSel = 0;
// GUI-Modifier leben in der M_ST-Luecke (ueberleben Transport/Reset),
// Maus-Quellen startet neutral
gmod1 = M_ST[2049]; gmod2 = M_ST[2050]; gmod3 = M_ST[2051];
gmx = 0; gmy = 0;

/* ============================================================
   @serialize — saemtliche Pad-Felder + Globals ins Projekt
   (seit 0.4.0: alle 128 Felder je Pad, damit auch Volume/Pan/
   Matrix/Einstellungen aller Pads den Reload ueberleben)
   ============================================================ */
@serialize

// Ist @init noch nicht gelaufen (frische Instanz: Reihenfolge ist
// @serialize -> @init), sind M_ST/M_PAD/M_FX noch 0 — dann nur das
// Defaults-Flag setzen und nichts in halbe Speicher schreiben.
padInit != 1 ? (
  needDefaults = 1;
) : (
  p = 0; loop(16, k = 0; loop(128, M_ST[p*128+k] = M_PAD[p*128+k]; k += 1; ); p += 1; );
  M_ST[2048] = polyMax;
  M_ST[2049] = gmod1; M_ST[2050] = gmod2; M_ST[2051] = gmod3;
  M_ST[2052] = M_SYS[SYS_AA]; M_ST[2053] = M_SYS[SYS_TRANS]; M_ST[2054] = M_SYS[SYS_SYNC];
  k = 2060; loop(11, M_ST[k] = 0; k += 1; );   // Debug-Zaehler nicht in Blobs
  smagic = 1480923721;
  file_var(0, smagic);
  file_var(0, phxVer);
  file_mem(0, M_ST, 2112);
  fxReady != 0 ? ( file_mem(0, M_FX, 96); );
  smagic == 1480923721 && floor(phxVer + 0.5) == 5 ? (
    p = 0; loop(16, k = 0; loop(128, M_PAD[p*128+k] = M_ST[p*128+k]; k += 1; ); p += 1; );
    polyMax = floor(M_ST[2048] + 0.5);
    gmod1 = M_ST[2049]; gmod2 = M_ST[2050]; gmod3 = M_ST[2051];
    M_SYS[SYS_AA] = M_ST[2052]; M_SYS[SYS_TRANS] = M_ST[2053]; M_SYS[SYS_SYNC] = M_ST[2054];
    // Plausibilitaets-Guard: leerer Blob (frische Instanz) hinterlaesst
    // Nullen — VOICES < 1 ist ungueltig -> Defaults. Echter Blob: 1..16.
    floor(M_ST[12] + 0.5) < 1 ? ( needDefaults = 1; );
    padInit = 1;
  ) : (
    needDefaults = 1;
  );
  padInit = 1;
);


/* ============================================================
   @slider
   ============================================================ */
@slider

slInit != 1 ? (
  // Erster Lauf (frische Instanz oder Projekt geladen): Slider sind
  // die Wahrheit, das Pad-Array wird aus ihnen befuellt.
  slInit = 1;
  M_LSL[2] = slider2;
  selPad = min2(15, max2(0, floor(slider2 + 0.5) - 1));
  M_LSL[3] = slider3; PF_SET(PF_VOL,  selPad, slider3);
  M_LSL[4] = slider4; PF_SET(PF_PAN,  selPad, slider4);
  M_LSL[5] = slider5; PF_SET(PF_TRNA, selPad, slider5);
  M_LSL[6] = slider6; PF_SET(PF_FINA, selPad, slider6);
  M_LSL[7] = slider7; PF_SET(PF_TRNB, selPad, slider7);
  M_LSL[8] = slider8; PF_SET(PF_FINB, selPad, slider8);
  M_LSL[9] = slider9; PF_SET(PF_XF,   selPad, slider9);
  M_LSL[10] = slider10; PF_SET(PF_MUTE, selPad, slider10);
  M_LSL[11] = slider11; PF_SET(PF_SOLO, selPad, slider11);
  M_LSL[12] = slider12; PF_SET(PF_MODE, selPad, slider12);
  M_LSL[13] = slider13; PF_SET(PF_NOTE, selPad, slider13);
  M_LSL[14] = slider14; PF_SET(PF_KILL, selPad, slider14);
  paramsDirty = 1;
) : (
  // Inkrementell: nur geaenderte Slider uebernehmen (Automation)
  slider2 != M_LSL[2] ? (
    M_LSL[2] = slider2;
    selPad = min2(15, max2(0, floor(slider2 + 0.5) - 1));
    pullSliders();
  );
  slider3 != M_LSL[3] ? ( M_LSL[3] = slider3; PF_SET(PF_VOL,  selPad, slider3); paramsDirty = 1; );
  slider4 != M_LSL[4] ? ( M_LSL[4] = slider4; PF_SET(PF_PAN,  selPad, slider4); paramsDirty = 1; );
  slider5 != M_LSL[5] ? ( M_LSL[5] = slider5; PF_SET(PF_TRNA, selPad, slider5); );
  slider6 != M_LSL[6] ? ( M_LSL[6] = slider6; PF_SET(PF_FINA, selPad, slider6); );
  slider7 != M_LSL[7] ? ( M_LSL[7] = slider7; PF_SET(PF_TRNB, selPad, slider7); );
  slider8 != M_LSL[8] ? ( M_LSL[8] = slider8; PF_SET(PF_FINB, selPad, slider8); );
  slider9 != M_LSL[9] ? ( M_LSL[9] = slider9; PF_SET(PF_XF,   selPad, slider9); );
  slider10 != M_LSL[10] ? ( M_LSL[10] = slider10; PF_SET(PF_MUTE, selPad, slider10); paramsDirty = 1; );
  slider11 != M_LSL[11] ? ( M_LSL[11] = slider11; PF_SET(PF_SOLO, selPad, slider11); paramsDirty = 1; );
  slider12 != M_LSL[12] ? ( M_LSL[12] = slider12; PF_SET(PF_MODE, selPad, slider12); );
  slider13 != M_LSL[13] ? ( M_LSL[13] = slider13; PF_SET(PF_NOTE, selPad, slider13); );
  slider14 != M_LSL[14] ? ( M_LSL[14] = slider14; PF_SET(PF_KILL, selPad, slider14); );
  slider15 != M_LSL[15] ? ( M_LSL[15] = slider15; PF_SET(MM_SRC,     selPad, floor(slider15 + 0.5)); paramsDirty = 1; );
  slider16 != M_LSL[16] ? ( M_LSL[16] = slider16; PF_SET(MM_DST,     selPad, floor(slider16 + 0.5)); paramsDirty = 1; );
  slider17 != M_LSL[17] ? ( M_LSL[17] = slider17; PF_SET(MM_AMT,     selPad, slider17); paramsDirty = 1; );
  slider18 != M_LSL[18] ? ( M_LSL[18] = slider18; PF_SET(MM_SRC + 3, selPad, floor(slider18 + 0.5)); paramsDirty = 1; );
  slider19 != M_LSL[19] ? ( M_LSL[19] = slider19; PF_SET(MM_DST + 3, selPad, floor(slider19 + 0.5)); paramsDirty = 1; );
  slider20 != M_LSL[20] ? ( M_LSL[20] = slider20; PF_SET(MM_AMT + 3, selPad, slider20); paramsDirty = 1; );
  slider21 != M_LSL[21] ? ( M_LSL[21] = slider21; PF_SET(MM_SRC + 6, selPad, floor(slider21 + 0.5)); paramsDirty = 1; );
  slider22 != M_LSL[22] ? ( M_LSL[22] = slider22; PF_SET(MM_DST + 6, selPad, floor(slider22 + 0.5)); paramsDirty = 1; );
  slider23 != M_LSL[23] ? ( M_LSL[23] = slider23; PF_SET(MM_AMT + 6, selPad, slider23); paramsDirty = 1; );
  slider24 != M_LSL[24] ? ( M_LSL[24] = slider24; PF_SET(MM_SRC + 9, selPad, floor(slider24 + 0.5)); paramsDirty = 1; );
  slider25 != M_LSL[25] ? ( M_LSL[25] = slider25; PF_SET(MM_DST + 9, selPad, floor(slider25 + 0.5)); paramsDirty = 1; );
  slider26 != M_LSL[26] ? ( M_LSL[26] = slider26; PF_SET(MM_AMT + 9, selPad, slider26); paramsDirty = 1; );
  slider27 != M_LSL[27] ? ( M_LSL[27] = slider27; PF_SET(MM_SRC + 12, selPad, floor(slider27 + 0.5)); paramsDirty = 1; );
  slider28 != M_LSL[28] ? ( M_LSL[28] = slider28; PF_SET(MM_DST + 12, selPad, floor(slider28 + 0.5)); paramsDirty = 1; );
  slider29 != M_LSL[29] ? ( M_LSL[29] = slider29; PF_SET(MM_AMT + 12, selPad, slider29); paramsDirty = 1; );
  slider30 != M_LSL[30] ? ( M_LSL[30] = slider30; PF_SET(MM_SRC + 15, selPad, floor(slider30 + 0.5)); paramsDirty = 1; );
  slider31 != M_LSL[31] ? ( M_LSL[31] = slider31; PF_SET(MM_DST + 15, selPad, floor(slider31 + 0.5)); paramsDirty = 1; );
  slider32 != M_LSL[32] ? ( M_LSL[32] = slider32; PF_SET(MM_AMT + 15, selPad, slider32); paramsDirty = 1; );
  slider33 != M_LSL[33] ? ( M_LSL[33] = slider33; PF_SET(MM_SRC + 18, selPad, floor(slider33 + 0.5)); paramsDirty = 1; );
  slider34 != M_LSL[34] ? ( M_LSL[34] = slider34; PF_SET(MM_DST + 18, selPad, floor(slider34 + 0.5)); paramsDirty = 1; );
  slider35 != M_LSL[35] ? ( M_LSL[35] = slider35; PF_SET(MM_AMT + 18, selPad, slider35); paramsDirty = 1; );
  slider36 != M_LSL[36] ? ( M_LSL[36] = slider36; PF_SET(MM_SRC + 21, selPad, floor(slider36 + 0.5)); paramsDirty = 1; );
  slider37 != M_LSL[37] ? ( M_LSL[37] = slider37; PF_SET(MM_DST + 21, selPad, floor(slider37 + 0.5)); paramsDirty = 1; );
  slider38 != M_LSL[38] ? ( M_LSL[38] = slider38; PF_SET(MM_AMT + 21, selPad, slider38); paramsDirty = 1; );
  slider39 != M_LSL[39] ? ( M_LSL[39] = slider39; PF_SET(L1_SHAPE, selPad, floor(slider39 + 0.5)); paramsDirty = 1; );
  slider40 != M_LSL[40] ? ( M_LSL[40] = slider40; PF_SET(L1_RATE,  selPad, slider40); paramsDirty = 1; );
  slider41 != M_LSL[41] ? ( M_LSL[41] = slider41; PF_SET(L1_RETRIG, selPad, floor(slider41 + 0.5)); paramsDirty = 1; );
  slider42 != M_LSL[42] ? ( M_LSL[42] = slider42; PF_SET(L2_SHAPE, selPad, floor(slider42 + 0.5)); paramsDirty = 1; );
  slider43 != M_LSL[43] ? ( M_LSL[43] = slider43; PF_SET(L2_RATE,  selPad, slider43); paramsDirty = 1; );
  slider44 != M_LSL[44] ? ( M_LSL[44] = slider44; PF_SET(L2_RETRIG, selPad, floor(slider44 + 0.5)); paramsDirty = 1; );
  slider45 != M_LSL[45] ? ( M_LSL[45] = slider45; PF_SET(MEN_ATK, selPad, slider45); paramsDirty = 1; );
  slider46 != M_LSL[46] ? ( M_LSL[46] = slider46; PF_SET(MEN_DEC, selPad, slider46); paramsDirty = 1; );
  slider47 != M_LSL[47] ? ( M_LSL[47] = slider47; PF_SET(MEN_SUS, selPad, slider47); paramsDirty = 1; );
  slider48 != M_LSL[48] ? ( M_LSL[48] = slider48; PF_SET(MEN_REL, selPad, slider48); paramsDirty = 1; );
  slider49 != M_LSL[49] ? ( M_LSL[49] = slider49; PF_SET(VEL_DEPTH, selPad, slider49); paramsDirty = 1; );
  slider50 != M_LSL[50] ? ( M_LSL[50] = slider50; PF_SET(VEL_CURVE, selPad, floor(slider50 + 0.5)); paramsDirty = 1; );
  slider51 != M_LSL[51] ? ( M_LSL[51] = slider51; PF_SET(PANA, selPad, slider51); paramsDirty = 1; );
  slider52 != M_LSL[52] ? ( M_LSL[52] = slider52; PF_SET(PANB, selPad, slider52); paramsDirty = 1; );
  slider54 != M_LSL[54] ? ( M_LSL[54] = slider54; M_SYS[SYS_AA] = slider54 > 0.5 ? 1 : 0; );
  slider55 != M_LSL[55] ? ( M_LSL[55] = slider55; M_SYS[SYS_TRANS] = floor(slider55 + 0.5); );
  slider56 != M_LSL[56] ? ( M_LSL[56] = slider56; PF_SET(ARP_MODE, selPad, floor(slider56 + 0.5)); paramsDirty = 1; );
  slider57 != M_LSL[57] ? ( M_LSL[57] = slider57; PF_SET(ARP_RATE, selPad, slider57); paramsDirty = 1; );
  slider58 != M_LSL[58] ? ( M_LSL[58] = slider58; PF_SET(ARP_OCT, selPad, floor(slider58 + 0.5)); paramsDirty = 1; );
  slider59 != M_LSL[59] ? ( M_LSL[59] = slider59; PF_SET(ARP_GATE, selPad, slider59); paramsDirty = 1; );
  slider60 != M_LSL[60] ? ( M_LSL[60] = slider60; PF_SET(PF_ROOT, selPad, floor(slider60 + 0.5)); );
  slider61 != M_LSL[61] ? ( M_LSL[61] = slider61; PF_SET(PBR, selPad, floor(slider61 + 0.5)); paramsDirty = 1; );
  slider62 != M_LSL[62] ? ( M_LSL[62] = slider62; PF_SET(SHUF, selPad, slider62); paramsDirty = 1; );
  slider63 != M_LSL[63] ? ( M_LSL[63] = slider63; M_SYS[SYS_SYNC] = floor(slider63 + 0.5); );
);

// Jeder @slider-Durchlauf koennte auch eine Dateiauswahl gewesen sein:
// der Slot-Scan ist billig (32 String-Hashes) und stellt sicher, dass
// neu gewaehlte WAVs tatsaechlich geladen werden.
filesDirty = 1;
/* ============================================================
   @block — MIDI einsammeln, Pad-Gains, Datei-Scan
   ============================================================ */
@block

smplPos = 0;

M_ST[2060] += 1;                               // @block-Durchlaeufe
M_FX[FXP_ON] > 0.5 ? M_ST[2066] += 1 : 0;      // FX-Kette aktiv

paramsDirty ? ( paramsDirty = 0; padGainRecalc(); loopRecalc(); modRecalc(); );
M_ST[2067] = M_GP[4]*100;                      // Debug: Pad-5-Gain-Cache
M_ST[2068] = M_SYS[SYS_TRANS];                 // Debug: Incoming Transpose
fxDirty ? fxEqRecalc();   // EQ-Koeffizienten (auch bei Samplerate-Wechsel)
needDefaults ? ( writeDefaults(); fxDefaults(); needDefaults = 0; filesDirty = 1; );

// Samplerate-Wechsel: resampled Daten verwerfen, neu laden
srate != lastSrate ? (
  lastSrate = srate;
  allNotesOff();
  i = 0; loop(32, M_SLI[i*10+SL] = 0; M_SLI[i*10+SF] = 0; M_SLI[i*10+4] = 0; i += 1; );
  topUse = 0;
  filesDirty = 1;
);

// FX-Pufferpool liegt an festen Adressen ab M_TOP, Sample-RAM darueber
topUse < FXPOOL ? ( topUse = FXPOOL; );

filesDirty ? sampleScan();

// Kit-Datei ueberwachen (alle ~0,5 s neu lesen; Zuweisung mit gleichem
// Inhalt kostet nur die Hash-Erkennung und laedt nicht neu)
kitPoll += 1;
kitPoll >= 24 ? ( kitPoll = 0; parseKit(); );
// FX-Preset-Datei ueberwachen (nur lesen, wenn sie existiert)
fxPoll += 1;
fxPoll >= 24 ? ( fxPoll = 0; fxScan(); M_ST[2064] += 1; M_ST[2065] = M_FX[FXP_ON]; );

// MIDI mit Offset in die Queue, Ausloesung sample-genau im @sample
evN = 0; evRd = 0;
while (midirecv(offs, m1, m2, m3)) (
  evN < 256 ? (
    M_EVT[evN*4] = offs;   M_EVT[evN*4+1] = m1;
    M_EVT[evN*4+2] = m2;   M_EVT[evN*4+3] = m3;
    evN += 1;
  ) : handleMidi(m1, m2, m3);
  (m1 & 0xF0) == 0x80 || (m1 & 0xF0) == 0x90 ? 0 : midisend(offs, m1, m2, m3);
);

/* ============================================================
   @sample — Voice-Pool
   ============================================================ */
@sample

// Faellige MIDI-Ereignisse
while (evRd < evN && M_EVT[evRd*4] <= smplPos) (
  handleMidi(M_EVT[evRd*4+1], M_EVT[evRd*4+2], M_EVT[evRd*4+3]);
  evRd += 1;
);

// --- Arpeggiator (sample-genau, vor dem Voice-Pool abarbeiten)
// der 16er-Scan laeuft nur, solange mindestens ein Arp aktiv ist
arpAct > 0 ? (
ap = 0;
loop(16,
  ab = M_ARP + ap*16;
  ab[ARP_ON] > 0.5 ? (
    // Gate: laufenden Arp-Step ausklingen lassen (Release)
    ab[ARP_GAT] > 0 ? (
      ab[ARP_GAT] -= 1;
      ab[ARP_GAT] <= 0 ? (
        avx = floor(ab[ARP_VOX] + 0.5) - 1;
        avx >= 0 ? ( avb = M_VOX + avx*112; avb[VA] > 0 ? avb[VG] = 0 : 0; );
        ab[ARP_VOX] = 0;
      );
    ) : 0;
    ab[ARP_CNT] <= 0 ? (
      ao = floor(PF(ARP_MODE, ap) + 0.5);
      aoN = floor(PF(ARP_OCT, ap) + 0.5); aoN < 1 ? aoN = 1; aoN > 4 ? aoN = 4;
      stp = floor(ab[ARP_STEP] + 0.5);
      ao == 2 ? (
        stp -= 1; stp < 0 ? stp = aoN - 1;          // DOWN
      ) : ao == 3 ? (
        ab[ARP_DIR] < 0.5 ? ( stp += 1; stp >= aoN - 1 ? ab[ARP_DIR] = 1 : 0; )
                         : ( stp -= 1; stp <= 0 ? ab[ARP_DIR] = 0 : 0; );  // UP-DN
      ) : ao == 4 ? (
        stp = floor(rand(1)*aoN);                    // RND
      ) : ao == 5 ? (
        stp = 0;                                     // ROLL (immer Basis)
      ) : (
        stp += 1; stp >= aoN ? stp = 0;              // UP
      );
      ab[ARP_STEP] = stp;
      prd2 = arpPeriod(ap);
      ab[ARP_CNT] = max2(32, floor(prd2*(ab[ARP_FLIP] > 0.5
        ? (1 - PF(SHUF, ap)*0.01) : (1 + PF(SHUF, ap)*0.01))));
      ab[ARP_FLIP] = 1 - ab[ARP_FLIP];
      arpXp = stp*12;
      trigPad(ap, floor(ab[ARP_NOTE] + 0.5), floor(ab[ARP_VEL] + 0.5));
      gLastVox >= 0 ? (
        ab[ARP_VOX] = gLastVox + 1;
        ab[ARP_GAT] = floor(prd2*min2(1, max2(0.05, PF(ARP_GATE, ap)*0.01)));
      ) : 0;
    ) : ( ab[ARP_CNT] -= 1; );
  ) : 0;
  ap += 1;
);
) : 0;

// Pitchbend von MIDI-Rate auf Audio-Rate glaetten (~11 ms)
pbS += (pbT - pbS)*0.002;

sumL = 0; sumR = 0;
vi = 0;
loop(64,
  vb = M_VOX + vi*112;
  vb[VA] > 0 ? (
    // --- Sample Delay: Huellkurve und Samples warten gemeinsam
    (vb[VDLYA] > 0 || vb[VDLYB] > 0) ? (
      vb[VDLYA] > 0 ? ( vb[VDLYA] -= 1; );
      vb[VDLYB] > 0 ? ( vb[VDLYB] -= 1; );
      vb[VS] == 3 && vb[VAMP] < 0.00001 ? ( vb[VAMP] = 0; vb[VS] = 0; vb[VA] = 0; );
    ) : (
      // --- Note-Off: Sustain-Stufen aller Envs in Release ueberfuehren
      //     (Fix 0.4.0 — das Gate wurde gesetzt, aber nie ausgewertet)
      vb[VG] < 0.5 ? (
        vb[VS] == 2 ? ( vb[VS] = 3; );
        vb[VFSTG] == 2 ? ( vb[VFSTG] = 3; );
        vb[VPSTG] == 2 ? ( vb[VPSTG] = 3; );
        vb[VMSTG] == 2 ? ( vb[VMSTG] = 3; );
      ) : 0;
      // --- Amp-Huellkurve
      vb[VS] == 1 ? (
        vb[VAMP] += vb[VATT];
        vb[VAMP] >= vb[VPEAK] ? ( vb[VAMP] = vb[VPEAK]; vb[VS] = 2; );
      );
      vb[VS] == 2 ? (
        vb[VAMP] *= vb[VDEC];
        vb[VAMP] <= vb[VPEAK]*vb[VSUS] + 0.00001 ? (
          vb[V1SH] > 0.5 ? ( vb[VS] = 3; ) : 0;
        );
        vb[VS] == 2 && vb[VAMP] < 0.00005 ? ( vb[VS] = 3; );
      );
      vb[VS] == 3 ? (
        vb[VAMP] *= vb[VREL];
        vb[VAMP] < 0.00001 ? ( vb[VAMP] = 0; vb[VS] = 0; );
      );
      // --- Filter-Env (eigene ADSR, One-Shot folgt dem Pad-Modus)
      vb[VFSTG] == 1 ? (
        vb[VFVAL] += vb[VFATTC];
        vb[VFVAL] >= 1 ? ( vb[VFVAL] = 1; vb[VFSTG] = 2; );
      );
      vb[VFSTG] == 2 ? (
        vb[VFVAL] *= vb[VFDECC];
        (vb[VFVAL] <= vb[VFSUS] + 0.00001 || vb[VFVAL] < 0.00005) ? (
          vb[V1SH] > 0.5 ? ( vb[VFSTG] = 3; ) : 0;
        );
        vb[VFSTG] == 2 && vb[VFVAL] < 0.00002 ? ( vb[VFSTG] = 3; );
      );
      vb[VFSTG] == 3 ? (
        vb[VFVAL] *= vb[VFRELC];
        vb[VFVAL] < 0.00002 ? ( vb[VFVAL] = 0; vb[VFSTG] = 0; );
      );
      // --- Pitch-Env
      vb[VPSTG] == 1 ? (
        vb[VPENV] += vb[VPATTC];
        vb[VPENV] >= 1 ? ( vb[VPENV] = 1; vb[VPSTG] = 2; );
      );
      vb[VPSTG] == 2 ? (
        vb[VPENV] *= vb[VPDECC];
        (vb[VPENV] <= vb[VPSUS] + 0.00001 || vb[VPENV] < 0.00005) ? (
          vb[V1SH] > 0.5 ? ( vb[VPSTG] = 3; ) : 0;
        );
        vb[VPSTG] == 2 && vb[VPENV] < 0.00005 ? ( vb[VPSTG] = 3; );
      );
      vb[VPSTG] == 3 ? (
        vb[VPENV] *= vb[VPRELC];
        vb[VPENV] < 0.00002 ? ( vb[VPENV] = 0; vb[VPSTG] = 0; );
      );
      // --- Portamento (Glide zur eigenen Zielnote)
      vb[VGON] > 0 ? (
        vb[VGLOG] += (0 - vb[VGLOG])*vb[VGCO];
        vb[VGLOG] < 0 ? ( -vb[VGLOG] < 0.003 ? ( vb[VGLOG] = 0; vb[VGON] = 0; ) : 0 )
                       : ( vb[VGLOG] < 0.003 ? ( vb[VGLOG] = 0; vb[VGON] = 0; ) : 0 );
      );
      // --- LFOs (laufen nur, wenn das Pad sie benutzt). Die
      //     Ratenmodulation kommt vom VORherigen Sample (Stimmen-Feld),
      //     damit keine Matrix-Reihenfolge Cross-Talk erzeugt.
      l1v = 0; l2v = 0;
      M_MFL[vb[VP]] & 1 ? (
        l1h = 30*(PF(L1_RATE, vb[VP])*0.01)^2*(1 + max2(-0.99, vb[VL1M]));
        l1h > 0.0005 ? (
          vb[VL1PH] += l1h/srate;
          vb[VL1PH] >= 1 ? ( vb[VL1PH] -= 1; vb[VL1F] = 1; );
          l1p = vb[VL1PH];
          ms = floor(PF(L1_SHAPE, vb[VP]) + 0.5);
          ms == 0 ? l1v = sin(2*$pi*l1p)
          : ms == 1 ? l1v = l1p < 0.5 ? 4*l1p - 1 : 3 - 4*l1p
          : ms == 2 ? l1v = 1 - 2*l1p
          : ms == 3 ? l1v = 2*l1p - 1
          : ms == 4 ? l1v = l1p < 0.5 ? 1 : -1
          : ( vb[VL1F] > 0.5 ? ( vb[VL1S] = rand(1)*2 - 1; vb[VL1F] = 0; ); l1v = vb[VL1S]; );
        );
      );
      M_MFL[vb[VP]] & 2 ? (
        l2h = 30*(PF(L2_RATE, vb[VP])*0.01)^2*(1 + max2(-0.99, vb[VL2M]));
        l2h > 0.0005 ? (
          vb[VL2PH] += l2h/srate;
          vb[VL2PH] >= 1 ? ( vb[VL2PH] -= 1; vb[VL2F] = 1; );
          l2p = vb[VL2PH];
          ms = floor(PF(L2_SHAPE, vb[VP]) + 0.5);
          ms == 0 ? l2v = sin(2*$pi*l2p)
          : ms == 1 ? l2v = l2p < 0.5 ? 4*l2p - 1 : 3 - 4*l2p
          : ms == 2 ? l2v = 1 - 2*l2p
          : ms == 3 ? l2v = 2*l2p - 1
          : ms == 4 ? l2v = l2p < 0.5 ? 1 : -1
          : ( vb[VL2F] > 0.5 ? ( vb[VL2S] = rand(1)*2 - 1; vb[VL2F] = 0; ); l2v = vb[VL2S]; );
        );
      );
      // --- Mod-Matrix auswerten (nur aktive Rows, vorberechnet)
      mmN = M_MRA[vb[VP]];
      mVol = 0; mPan = 0; mPit = 0; mCut = 0; mRes = 0; mL1 = 0; mL2 = 0; mXf = 0;
      mmN > 0 ? (
        q1 = vb[VVEL]; q2 = vb[VKEY]; q3 = gmod1*0.01; q4 = gmod2*0.01;
        q5 = gmod3*0.01; q6 = gmy; q7 = gmx; q8 = l1v; q9 = l2v;
        q10 = vb[VMVAL]; q11 = vb[VRND];
        mr = 0;
        loop(mmN,
          mb = vb[VP]*24 + mr*3;
          ms = M_MTX[mb];
          mv = M_MTX[mb + 2]*(ms == 1 ? q1 : ms == 2 ? q2 : ms == 3 ? q3
             : ms == 4 ? q4 : ms == 5 ? q5 : ms == 6 ? q6 : ms == 7 ? q7
             : ms == 8 ? q8 : ms == 9 ? q9 : ms == 10 ? q10 : q11);
          md = M_MTX[mb + 1];
          md == 1 ? mVol += mv : md == 2 ? mPan += mv : md == 3 ? mPit += mv
          : md == 4 ? mCut += mv : md == 5 ? mRes += mv : md == 6 ? mL1 += mv
          : md == 7 ? mL2 += mv : mXf += mv;
          mr += 1;
        );
        vb[VL1M] = mL1; vb[VL2M] = mL2;
      ) : ( vb[VL1M] = 0; vb[VL2M] = 0; );
      // --- Mod-Env (Note-Off-Release passiert oben am Gate)
      M_MFL[vb[VP]] & 4 ? (
        vb[VMSTG] == 1 ? (
          vb[VMVAL] += vb[VMATTC];
          vb[VMVAL] >= 1 ? ( vb[VMVAL] = 1; vb[VMSTG] = 2; );
        );
        vb[VMSTG] == 2 ? (
          vb[VMVAL] *= vb[VMDECC];
          (vb[VMVAL] <= vb[VMSUS] + 0.00001 || vb[VMVAL] < 0.00005) ? (
            vb[V1SH] > 0.5 ? ( vb[VMSTG] = 3; ) : 0;
          );
          vb[VMSTG] == 2 && vb[VMVAL] < 0.00005 ? ( vb[VMSTG] = 3; );
        );
        vb[VMSTG] == 3 ? (
          vb[VMVAL] *= vb[VMRELC];
          vb[VMVAL] < 0.00002 ? ( vb[VMVAL] = 0; vb[VMSTG] = 0; );
        );
      );
      // --- Pitch-Env-Semitoene + Glide + Matrix-Pitch -> Rate-Faktor
      pnS = vb[VPFLP] > 0.5 ? (1 - vb[VPENV]) : vb[VPENV];
      vb[VPRNG] > 0.01 && vb[VPSTN] > 0.001 ? (
        qN = max2(1, floor(vb[VPSTN]*24 + 0.5));
        pnS = floor(pnS*qN + 0.5)/qN;
      );
      pnS *= vb[VPRNG];
      prF = 2^((pnS + vb[VGLOG] + mPit + pbS*vb[VPBR])/12);
      erA = vb[VRA]*prF; erB = vb[VRB]*prF;
      // --- Retrigger: Zaehlen und Sample neu starten
      vb[VRTC] > 0 ? (
        vb[VRTC] -= 1;
        vb[VRTC] <= 0 ? (
          vb[VPA] = vb[VPA0]; vb[VPB] = vb[VPB0];
          vb[VGA] = vb[VGA0]; vb[VGB] = vb[VGB0];
          vb[VFADEC] = vb[VFADET];
          vb[VRTC] = vb[VRTW];
        );
      );
      // --- Retrig-Fade
      fga = 1; fgb = 1;
      vb[VFADET] > 0 && vb[VFADEC] > 0 ? (
        vb[VFADEC] -= 1;
        fg2 = 1 - vb[VFADEC]/vb[VFADET];
        fga = fg2; fgb = fg2;
      );
      // --- Slot A lesen (Loop/Reverse/LoFi/Spike/Phase/Filter)
      oa = 0;
      vb[VGA] > 0 ? (
        slA = vb[VP]*2;
        M_SLI[slA*10+SL] > 0 ? (
          bsA = M_SLI[slA*10+SB];
          lnA = M_SLI[slA*10+SL];
          PF(SCR_ON, vb[VP]) > 0.5 ? (
            ps = slider53*0.01*max2(0, lnA - 2);
            i0 = floor(ps); fr = ps - i0;
            oa = bsA[i0]*(1 - fr) + bsA[i0+1]*fr;
          ) : (
          ps = vb[VPA] + erA;
          M_SLI[slA*10+4] > 0 ? (
            lst = M_SLI[slA*10+5]; lle = M_SLI[slA*10+6];
            xfd = M_SLI[slA*10+8];
            lle > lst + 32 ? (
              M_SLI[slA*10+7] == 1 ? (
                // PingPong: an den Grenzen umkehren (Fix 0.4.0)
                vb[VPDIR] < 0.5 ? (
                  ps > lle ? ( ps = max2(lst, 2*lle - ps); vb[VPDIR] = 1; ) : 0;
                ) : (
                  ps < lst ? ( ps = min2(lle, 2*lst - ps); vb[VPDIR] = 0; ) : 0;
                );
                xfd > 0 ? ( ps > lle - xfd ? fga = (lle - ps)/xfd
                                          : ps < lst + xfd ? fga = (ps - lst)/xfd : 0; );
              ) : (
                erA > 0 ? (
                  ps > lle ? ( ps -= (lle - lst); );
                  xfd > 0 && ps > lle - xfd ? ( fga = (lle - ps)/xfd; ) : 0;
                ) : (
                  ps < lst ? ( ps += (lle - lst); );
                );
              );
            );
          );
          ps < 0 || ps > lnA - 1 ? (
            oa = erA < 0 ? bsA[0] : bsA[lnA - 1]; vb[VGA] = 0;
          ) : (
            i0 = floor(ps); fr = ps - i0;
            M_SYS[SYS_AA] > 0.5 ?
              oa = herm4(bsA[max2(0, i0 - 1)], bsA[i0], bsA[i0+1], bsA[min2(lnA - 1, i0 + 2)], fr)
            : oa = bsA[i0]*(1 - fr) + bsA[i0+1]*fr;
            vb[VPA] = ps;
          );
          );   // Scratch-Zweig zu
          oa *= fga;
          // --- LoFi (Halte-Intervall + Bit-Quantisierung)
          vb[VLOFC] > 1 ? (
            vb[VLOFA] -= 1;
            vb[VLOFA] <= 0 ? ( vb[VLOFFA] = oa; vb[VLOFA] = vb[VLOFC]; );
            oa = vb[VLOFFA];
            oa = floor(oa*vb[VLOFQ] + 0.5)/vb[VLOFQ];
          );
          // --- Spike (kurzer Transienten-Zuschlag)
          vb[VSPKA] > 0 ? (
            da = oa - vb[VPRVA]; vb[VPRVA] = oa;
            oa += vb[VSPKA]*vb[VSPKE]*da;
            vb[VSPKE] < 0.000001 ? ( vb[VSPKE] = 0; );
          );
          vb[VPHIA] < 0 ? ( oa = -oa; );
          // --- Slot-Filter (HP vor LP)
          vb[VHPFA] < 1 ? (
            ya = vb[VHPFA]*(vb[VHPYA] + oa - vb[VHPXA]);
            vb[VHPXA] = oa; vb[VHPYA] = ya; oa = ya;
          );
          vb[VLPFGA] < 0.999 ? ( vb[VLPYA] += vb[VLPFGA]*(oa - vb[VLPYA]); oa = vb[VLPYA]; );
        );
      );
      // --- Slot B
      ob = 0;
      vb[VGB] > 0 ? (
        slB = vb[VP]*2 + 1;
        M_SLI[slB*10+SL] > 0 ? (
          bsB = M_SLI[slB*10+SB];
          lnB = M_SLI[slB*10+SL];
          PF(SCR_ON, vb[VP]) > 0.5 ? (
            ps = slider53*0.01*max2(0, lnB - 2);
            i0 = floor(ps); fr = ps - i0;
            ob = bsB[i0]*(1 - fr) + bsB[i0+1]*fr;
          ) : (
          ps = vb[VPB] + erB;
          M_SLI[slB*10+4] > 0 ? (
            lst = M_SLI[slB*10+5]; lle = M_SLI[slB*10+6];
            xfd = M_SLI[slB*10+8];
            lle > lst + 32 ? (
              M_SLI[slB*10+7] == 1 ? (
                // PingPong: an den Grenzen umkehren (Fix 0.4.0)
                vb[VPDRB] < 0.5 ? (
                  ps > lle ? ( ps = max2(lst, 2*lle - ps); vb[VPDRB] = 1; ) : 0;
                ) : (
                  ps < lst ? ( ps = min2(lle, 2*lst - ps); vb[VPDRB] = 0; ) : 0;
                );
                xfd > 0 ? ( ps > lle - xfd ? fgb = (lle - ps)/xfd
                                          : ps < lst + xfd ? fgb = (ps - lst)/xfd : 0; );
              ) : (
                erB > 0 ? (
                  ps > lle ? ( ps -= (lle - lst); );
                  xfd > 0 && ps > lle - xfd ? ( fgb = (lle - ps)/xfd; ) : 0;
                ) : (
                  ps < lst ? ( ps += (lle - lst); );
                );
              );
            );
          );
          ps < 0 || ps > lnB - 1 ? (
            ob = erB < 0 ? bsB[0] : bsB[lnB - 1]; vb[VGB] = 0;
          ) : (
            i0 = floor(ps); fr = ps - i0;
            M_SYS[SYS_AA] > 0.5 ?
              ob = herm4(bsB[max2(0, i0 - 1)], bsB[i0], bsB[i0+1], bsB[min2(lnB - 1, i0 + 2)], fr)
            : ob = bsB[i0]*(1 - fr) + bsB[i0+1]*fr;
            vb[VPB] = ps;
          );
          );   // Scratch-Zweig zu
          ob *= fgb;
          vb[VLOFC] > 1 ? (
            vb[VLOFB] -= 1;
            vb[VLOFB] <= 0 ? ( vb[VLOFFB] = ob; vb[VLOFB] = vb[VLOFC]; );
            ob = vb[VLOFFB];
            ob = floor(ob*vb[VLOFQ] + 0.5)/vb[VLOFQ];
          );
          vb[VSPKB] > 0 ? (
            db = ob - vb[VPRVB]; vb[VPRVB] = ob;
            ob += vb[VSPKB]*vb[VSPKE]*db;
          );
          vb[VPHIB] < 0 ? ( ob = -ob; );
          vb[VHPFB] < 1 ? (
            yb = vb[VHPFB]*(vb[VHPYB] + ob - vb[VHPXB]);
            vb[VHPXB] = ob; vb[VHPYB] = yb; ob = yb;
          );
          vb[VLPFGB] < 0.999 ? ( vb[VLPYB] += vb[VLPFGB]*(ob - vb[VLPYB]); ob = vb[VLPYB]; );
        );
      );
      // --- Mischen (A/B-Loops haben eigene Fade-Faktoren)
      (vb[VGA] <= 0 || M_SLI[(vb[VP]*2)*10+SL] <= 0)
        && (vb[VGB] <= 0 || M_SLI[(vb[VP]*2+1)*10+SL] <= 0)
        && vb[VS] == 0 ? (
        vb[VA] = 0;
      ) : (
        mx = (oa*vb[VGA] + ob*vb[VGB])*vb[VAMP];
        // --- Hauptfilter (Phalanx-Filterseite) mit Drive + Matrix-Zielen
        vb[VFTYPE] > 0.5 ? (
          tt = floor(vb[VFTYPE] + 0.5);
          // Offener Cutoff (100 %) = Filter ganz umgehen (LP/Notch); der
          // TPT-SVF bei fc 20 kHz (g > 6) daempft sonst den Onset um ~5 dB
          vb[VFCUT] > 0.995 && (tt <= 2 || tt >= 8) ? 0 : (
          fct = 20*1000^vb[VFCUT]*2^(vb[VFEOCT]*vb[VFVAL] + mCut*0.02);
          fct = min2(20000, max2(20, fct));
          vb[VFMD] < 0.5 && vb[VFDRVN] > 0.001 ? (
            dg = 1 + vb[VFDRVN]^2*9;
            mx = fastTanh(mx*dg)/(dg^0.6);
          );
          tt == 0 || tt == 3 ? (
            // 6 dB: Ein-Pol
            g1 = min2(1, $pi*fct/srate);
            tt == 0 ? ( vb[VFS11] += g1*(mx - vb[VFS11]); mx = vb[VFS11]; )
                    : ( hpa = 1 - g1;
                        y1 = hpa*(vb[VFS11] + mx - vb[VFS12]);
                        vb[VFS12] = mx; vb[VFS11] = y1; mx = y1; );
          ) : (
            // 12/24 dB: TPT-SVF (24 dB = zwei Kaskaden)
            g1 = tan(min2(1.5, $pi*fct/srate));
            kk = 2 - 1.9*min2(1, vb[VFRESN] + mRes);
            a1 = 1/(1 + g1*(g1 + kk)); a2 = g1*a1;
            v3 = mx - vb[VFS12];
            w1 = a1*vb[VFS11] + a2*v3;
            w2 = vb[VFS12] + a2*(vb[VFS11] + a1*w1);
            vb[VFS11] = 2*w1 - vb[VFS11]; vb[VFS12] = 2*w2 - vb[VFS12];
            tt >= 6 ? ( tt >= 8 ? mx = mx - kk*w1 : mx = w1; )
                    : ( tt >= 3 ? mx = mx - kk*w1 - w2 : mx = w2; );
            tt == 2 || tt == 5 || tt == 7 || tt == 9 ? (
              v3 = mx - vb[VFS22];
              w1 = a1*vb[VFS21] + a2*v3;
              w2 = vb[VFS22] + a2*(vb[VFS21] + a1*w1);
              vb[VFS21] = 2*w1 - vb[VFS21]; vb[VFS22] = 2*w2 - vb[VFS22];
              tt >= 6 ? ( tt == 9 ? mx = mx - kk*w1 - w2 : mx = w1; ) : mx = w2;
            );
          );
          // Drive Dirty: nach dem Filter
          vb[VFMD] > 0.5 && vb[VFDRVN] > 0.001 ? (
            dg = 1 + vb[VFDRVN]^2*9;
            mx = fastTanh(mx*dg)/(dg^0.6);
          );
          );   // Cutoff-Bypass-Zweig schliessen
        );
        mx != 0 ? (
          pg = M_GP[vb[VP]];
          pg != 0 ? (
            gm2 = 2^mVol;
            mPan != 0 || mXf != 0 ? (
              mga2 = vb[VGA]; mgb2 = vb[VGB];
              mXf != 0 ? (
                xfm = min2(100, max2(0, PF(PF_XF, vb[VP]) + mXf));
                mga2 = vb[VGA0]*(1 - min2(1, max2(0, (xfm - 0.5)*2)));
                mgb2 = vb[VGB0]*(1 - min2(1, max2(0, (0.5 - xfm)*2)));
              );
              gl2 = mga2*vb[VGLA] + mgb2*vb[VGLB];
              gr2 = mga2*vb[VGRA] + mgb2*vb[VGRB];
              mPan != 0 ? (
                gl2 *= max2(0, 1 - mPan);
                gr2 *= max2(0, 1 + mPan);
              );
            ) : ( gl2 = vb[VGL]; gr2 = vb[VGR]; );
            sumL += mx*gl2*pg*gm2;
            sumR += mx*gr2*pg*gm2;
          );
        );
      );
    );
  );
  vi += 1;
);

// --- Master-FX-Kette (EQ -> Insert 1..4) vor Master/Softclip
M_FX[FXP_ON] > 0.5 ? (
  fxL = sumL; fxR = sumR;
  fxEQ();
  s5i = 0;
  loop(4,
    ty5 = floor(M_FX[ISL_TYPE(s5i)] + 0.5);
    ty5 == 1 ? fxDelay(s5i) : ty5 == 2 ? fxChorus(s5i) : ty5 == 3 ? fxFlanger(s5i)
    : ty5 == 4 ? fxPhaser(s5i) : ty5 == 5 ? fxDist(s5i) : ty5 == 6 ? fxCrush(s5i)
    : ty5 == 7 ? fxDyn(s5i, 0) : ty5 == 8 ? fxDyn(s5i, 1) : ty5 == 9 ? fxRoom(s5i)
    : ty5 == 10 ? fxTrash(s5i) : ty5 == 11 ? fxGate(s5i) : ty5 == 12 ? fxStereo(s5i) : 0;
    s5i += 1;
  );
  sumL = fxL; sumR = fxR;
);

masterG = slider1*0.01;
masterG = masterG*masterG;
// Weiche Saettigung: bis 0.7 transparent, darunter tanh-Knie —
// verhindert hartes Digitales Clipping wenn mehrere Pads summen
spl0 = softOut(sumL*masterG);
spl1 = softOut(sumR*masterG);
spl0 != spl0 || spl1 != spl1 ? M_ST[2063] += 1 : 0;   // Debug: NaN-Output
clipPk = max2(clipPk*0.9996, max2(abs(spl0), abs(spl1)));  // Clip-LED-Quelle

// Oszilloskop (jedes 2. Sample reicht bei 45 Hz)
scopeDiv ? (
  M_SCOPE[scopePos] = (spl0 + spl1)*0.5;
  scopePos += 1; scopePos >= 512 ? ( scopePos = 0; );
);
scopeDiv = 1 - scopeDiv;

smplPos += 1;
/* ============================================================
   @gfx — Geraetefront nach dem Tim-Techlor-Designkit
   ============================================================ */
@gfx 1120 740

// ---------- Massstab ----------
SC = min(gfx_w/UI_W, gfx_h/UI_H);
SC = max2(0.25, SC);
OX = (gfx_w - UI_W*SC)*0.5;
OY = (gfx_h - UI_H*SC)*0.5;
mX = (mouse_x - OX)/SC;
mY = (mouse_y - OY)/SC;
// Mausposition als Mod-Quellen M-X/M-Y (-1..1, oben/rechts positiv)
gmx = min2(1, max2(-1, mX/UI_W*2 - 1));
gmy = min2(1, max2(-1, (1 - mY/UI_H)*2 - 1));

/* ---------- Schriften (Probing wie TT-303) ---------- */
fontChk == 0 ? (
  fontChk = 1;
  gfx_setfont(9, "TT303NoSuchFace", 16);
  gfx_measurestr("HAMBURGEFONSIV", refW, refH);
  gfx_measurestr("M", refM, refH2);

  sansSel = -1;
  sansSel < 0 ? ( gfx_setfont(9, "Segoe UI", 16);        gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? ( sansSel = 0; ); );
  sansSel < 0 ? ( gfx_setfont(9, "Helvetica Neue", 16);  gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? ( sansSel = 1; ); );
  sansSel < 0 ? ( gfx_setfont(9, "DejaVu Sans", 16);     gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? ( sansSel = 2; ); );
  sansSel < 0 ? ( gfx_setfont(9, "Liberation Sans", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
                  (tw1 != refW || th1 != refH) ? ( sansSel = 3; ); );
  sansSel < 0 ? ( sansSel = 4; );

  monoSel = -1;
  monoSel < 0 ? ( gfx_setfont(9, "Consolas", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? ( monoSel = 0; ); );
  monoSel < 0 ? ( gfx_setfont(9, "DejaVu Sans Mono", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? ( monoSel = 1; ); );
  monoSel < 0 ? ( gfx_setfont(9, "Menlo", 16);
                  gfx_measurestr("M", tw1, th1); gfx_measurestr("i", tw2, th2);
                  (tw1 == tw2 && tw1 != refM) ? ( monoSel = 2; ); );
  monoSel < 0 ? ( monoSel = 3; );

  gfx_setfont(9, "Zilap Orian", 16); gfx_measurestr("HAMBURGEFONSIV", tw1, th1);
  bigSel = (tw1 != refW || th1 != refH);
);

fBig = max2(12, floor(34*SC));
fMed = max2(10, floor(15*SC));
fSml = max2(9,  floor(12*SC));

(fBig != fBigP || fMed != fMedP || fSml != fSmlP) ? (
  fBigP = fBig; fMedP = fMed; fSmlP = fSml;
  bigSel ? ( gfx_setfont(1, "Zilap Orian", fBig, 'b'); )
  : sansSel == 0 ? ( gfx_setfont(1, "Segoe UI", fBig, 'b'); )
  : sansSel == 1 ? ( gfx_setfont(1, "Helvetica Neue", fBig, 'b'); )
  : sansSel == 2 ? ( gfx_setfont(1, "DejaVu Sans", fBig, 'b'); )
  : sansSel == 3 ? ( gfx_setfont(1, "Liberation Sans", fBig, 'b'); )
  : ( gfx_setfont(1, "Arial", fBig, 'b'); );
  sansSel == 0 ? ( gfx_setfont(2, "Segoe UI", fMed);        gfx_setfont(3, "Segoe UI", fSml); )
  : sansSel == 1 ? ( gfx_setfont(2, "Helvetica Neue", fMed);  gfx_setfont(3, "Helvetica Neue", fSml); )
  : sansSel == 2 ? ( gfx_setfont(2, "DejaVu Sans", fMed);     gfx_setfont(3, "DejaVu Sans", fSml); )
  : sansSel == 3 ? ( gfx_setfont(2, "Liberation Sans", fMed); gfx_setfont(3, "Liberation Sans", fSml); )
  : ( gfx_setfont(2, "Arial", fMed); gfx_setfont(3, "Arial", fSml); );
  monoSel == 0 ? ( gfx_setfont(4, "Consolas", fMed);           gfx_setfont(5, "Consolas", fSml); )
  : monoSel == 1 ? ( gfx_setfont(4, "DejaVu Sans Mono", fMed); gfx_setfont(5, "DejaVu Sans Mono", fSml); )
  : monoSel == 2 ? ( gfx_setfont(4, "Menlo", fMed);            gfx_setfont(5, "Menlo", fSml); )
  : ( gfx_setfont(4, "Courier New", fMed); gfx_setfont(5, "Courier New", fSml); );
);

// Mauszustand: Klick als Flanke
uiLmb   = mouse_cap & 1;
uiClick = uiLmb && !lmbPrev;
uiRClk  = (mouse_cap & 2) && !rmbPrev;
!uiLmb ? ( dragId = -1; );
clickWait > 0 ? ( clickWait -= 1; );

accentLed *= 0.88;

// ---------- Grund ----------
gfx_set(0.050, 0.054, 0.050, 1);
gfx_rect(0, 0, gfx_w, gfx_h, 1);

// ---------- Kopfzeile ----------
gfx_setfont(1);
colAcid(1);
xstr(24, 8, "TT-PHALYX");
gfx_measurestr("TT-PHALYX", hdrTW, hdrTH);
gfx_setfont(3);
gfx_measurestr("v1.03", hdrVW, hdrVH);
colInk(1);
gfx_x = OX + 24*SC + hdrTW + 10*SC;
gfx_y = OY + 8*SC + hdrTH - hdrVH - 1*SC;
gfx_drawstr("v1.03");
gfx_setfont(3);
colInk(1);
xstr(26, 46, "DRUM SAMPLER // 16 PADS // TIM TECHLOR");

trace(390, 16, 470, 54);
trace(470, 16, 560, 54);
pad(390, 16, 4); pad(470, 16, 4);
pad(470, 54, 3); pad(560, 54, 3);
colDim(1); xline(0, 70, UI_W, 70);
colAcid(1); xrect(0, 70, 232, 1);

// Aktiv-LED
colInk(1); xstr(580, 14, "ACTIVE");
gfx_set(0.11, 0.13, 0.11, 1); xrect(580, 28, 64, 8);
ledA = max2(0, accentLed);
ledA > 0.01 ? ( gfx_set(0.224*ledA, 1*ledA, 0.078*ledA, 1); xrect(581, 29, 62*ledA, 6); );

// Clip-LED — leuchtet, wenn der Ausgang in die Saettigungszone geht
colInk(1); xstr(664, 14, "CLIP");
gfx_set(0.11, 0.13, 0.11, 1); xrect(664, 28, 40, 8);
clipLed = max2(clipLed*0.92, clipPk > 0.95 ? 1 : 0);
clipLed > 0.01 ? ( gfx_set(0.224*clipLed, 1*clipLed, 0.078*clipLed, 1); xrect(665, 29, 38*clipLed, 6); );

// Stimmen + Tempo
gfx_setfont(5);
vOn = 0; vi = 0;
loop(64, vb = M_VOX + vi*112; vb[VA] > 0 ? ( vOn += 1; ); vi += 1; );
vOn > polyMax ? ( vOn = polyMax; );
colInk(1); xat(580, 44);
gfx_printf("VOICES %02d/%02d  |  %.1f BPM", vOn, floor(polyMax), tempo > 10 ? tempo : 120);

// Master
gfx_setfont(3); colInk(1); xctr(850, 30, 60, 12, "MASTER");
nv = knob(30, 940, 36, 18, slider1, 0, 100);
nv != slider1 ? ( slider1 = nv; slider_automate(slider1); );
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%d %%", floor(slider1)); drawCentered(940, 58);

/* ---------- Panel SAMPLE PADS (16 Slim-Pads) ---------- */
panelBox(14, 78, 992, 238);
gfx_setfont(3);
colAcid(1); xstr(26, 82, "SAMPLE PADS");
colInk(1);  xstr(150, 82, "A/B CROSSFADE - KIT/MULTITRACK - KILLNOTE");
// Kit-Status rechts
kitOk ? (
  kOn = 0; ki2 = 0;
  loop(32, M_SLI[ki2*10+SF] == 1 ? ( kOn += 1; ); ki2 += 1; );
  kOn > 0 ? ( colAcid(1); xat(760, 82); gfx_printf("KIT ACTIVE - %d SAMPLES LOADED", kOn); )
          : ( colDim(1); xat(760, 82); gfx_drawstr("KIT: NO VALID FILES"); );
) : (
  colDim(1); xat(760, 82);
  gfx_drawstr("NO KIT - LUA SCRIPT TT-PHALYX LOAD KIT");
);
colDim(1); xline(146, 86, 146, 96);

pi = 0;
loop(16,
  px = 26 + pi*60;
  selP = pi == selPad;
  vAct = 0; vi = 0;
  loop(64, vb = M_VOX + vi*112; vb[VA] > 0 && vb[VP] == pi ? ( vAct += 1; ); vi += 1; );

  // Pad-Grundflaeche
  selP ? ( gfx_set(0.085, 0.100, 0.082, 1); )
       : (inBox(px, 92, 56, 214) ? ( gfx_set(0.082, 0.088, 0.080, 1); ) : ( gfx_set(0.072, 0.077, 0.072, 1); ));
  xrect(px, 92, 56, 214);
  selP ? ( colAcid(1);
    xrect(px, 92, 56, 1); xrect(px, 305, 56, 1);
    xrect(px, 92, 1, 214); xrect(px + 55, 92, 1, 214);
  ) : (
    gfx_set(0.125, 0.155, 0.115, 1);
    xrect(px, 92, 56, 1); xrect(px, 305, 56, 1);
    xrect(px, 92, 1, 214); xrect(px + 55, 92, 1, 214);
  );

  // Nummer + Aktiv-LED
  gfx_setfont(5);
  selP || vAct > 0 ? ( colAcid(1); ) : ( colInk(1); );
  xat(px + 3, 94); gfx_printf("%02d", pi + 1);
  vAct > 0 ? ( colAcid(1); ) : ( gfx_set(0.11, 0.13, 0.11, 1); );
  xcirc(px + 49, 99, 2.5, 1);
  M_ARP[pi*16+ARP_ON] > 0.5 ? ( colAcid(1); xrect(px + 39, 96, 4, 7); )
                             : ( gfx_set(0.11, 0.13, 0.11, 1); xrect(px + 39, 96, 4, 7); );

  M_SLI[(pi*2+1)*10+SF] == 1 ? drawWaveV(px + 3, 108, 40, 130, pi*2 + 1, 0) : 0;
  drawWaveV(px + 3, 108, 40, 130, pi*2, M_SLI[(pi*2)*10+SF] == 1 ? 2 : 1);
  gfx_set(0.092, 0.097, 0.092, 1); xrect(px + 45, 108, 8, 130);
  ft = PF(PF_VOL, pi)*0.01;
  colAcid(0.55); xrect(px + 46, 108 + 130*(1 - ft), 6, 130*ft);
  fhY = 108 + 130*(1 - ft) - 3;
  colAcid(1); xrect(px + 44, fhY, 10, 6);
  fadHot = inBox(px + 44, 108, 10, 130);
  uiClick && fadHot ? ( dragId = 110 + pi; dragY = mY; );
  dragId == 110 + pi && uiLmb ? (
    nvf = floor(min2(1, max2(0, (108 + 130 - mY)/130))*100 + 0.5);
    nvf != PF(PF_VOL, pi) ? ( PF_SET(PF_VOL, pi, nvf); pi == selPad ? ( pushVol(nvf); ); paramsDirty = 1; );
  );

  // Mute/Solo
  gfx_setfont(5);
  btn(px + 2, 244, 26, 14, PF(PF_MUTE, pi) > 0.5, "M") ? ( PF_SET(PF_MUTE, pi, 1 - PF(PF_MUTE, pi)); pi == selPad ? ( pushMute(PF(PF_MUTE, pi)); ); paramsDirty = 1; );
  btn(px + 30, 244, 26, 14, PF(PF_SOLO, pi) > 0.5, "S") ? ( PF_SET(PF_SOLO, pi, 1 - PF(PF_SOLO, pi)); pi == selPad ? ( pushSolo(PF(PF_SOLO, pi)); ); paramsDirty = 1; );

  // Input-Anzeige + Name
  gfx_setfont(5);
  colInk(1); xat(px + 3, 262);
  floor(PF(PF_MODE, pi) + 0.5) == 0 ? (
    gfx_printf("K:");
    noteStr(floor(PF(PF_NOTE, pi) + 0.5)); gfx_drawstr(#vstr);
  ) : ( gfx_printf("CH %02d", floor(PF(PF_MODE, pi) + 0.5)); );
  colDim(1); xat(px + 3, 276);
  drawPadName(pi*2, pi, px + 3, 276);

  // Auswahl per Klick (Fader/M/S ausgenommen)
  uiClick && inBox(px, 92, 56, 214)
    && !inBox(px + 44, 108, 10, 130)
    && !inBox(px + 2, 244, 54, 14) ? (
    pi != selPad ? ( selectPad(pi); );
  );
  pi += 1;
);

/* ---------- Panel FULL (ausgewaehltes Pad) ----------
   Die Regler der beiden oberen Reihen editieren den gewaehlten
   Slot (A oder B) — wie in Phalanx schaltet der A/B-Schalter die
   Reglerziele um. RETRIG wirkt kanalweit. */
panelBox(14, 324, 992, 232);
gfx_setfont(3);
colAcid(1); xat(26, 330);
gfx_printf("PAD %02d", selPad + 1);
colInk(1);
xat(80, 330);
drawPadName(selPad*2, selPad, 80, 330);

// A/B-Slotwahl + Slot-Buttons + grosse Waveform
gfx_setfont(2);
btn(26, 344, 40, 18, slotSel == 0, "A") ? ( slotSel = 0; );
btn(70, 344, 40, 18, slotSel == 1, "B") ? ( slotSel = 1; );
btn(114, 344, 64, 18, 0, "A -> B") ? ( copyAtoB(selPad); );
btn(182, 344, 56, 18, PF(sfPHINV(), selPad) > 0.5, "PHASE") ? ( pushF(sfPHINV(), 1 - PF(sfPHINV(), selPad)); );
btn(242, 344, 44, 18, PF(sfREV(), selPad) > 0.5, "REV") ? ( pushF(sfREV(), 1 - PF(sfREV(), selPad)); );
btn(290, 344, 30, 18, PF(SCR_ON, selPad) > 0.5, "SCR") ? ( pushF(SCR_ON, 1 - PF(SCR_ON, selPad)); );
gfx_set(0.042, 0.048, 0.042, 1); xrect(26, 368, 320, 104);
M_SLI[(selPad*2 + slotSel)*10+SF] == 1 ?
  drawWaveH(28, 370, 316, 100, selPad*2 + slotSel, 0.224, 1.0, 0.078)
  : (
    gfx_setfont(5); colDim(1);
    xctr(26, 410, 320, 14, slotSel == 0 ? "NO SAMPLE - LOAD KIT (KIT.TXT OR LUA SCRIPT)" : "NO SAMPLE (SLOT B)");
  );
// Slot-Info
gfx_setfont(5); colInk(1); xat(26, 476);
M_SLI[(selPad*2 + slotSel)*10+SL] > 0 ? (
  gfx_printf("%.2f s  |  %d SR", M_SLI[(selPad*2 + slotSel)*10+SL]/srate, floor(srate));
) : ( gfx_drawstr("EMPTY"); );
M_SLI[(selPad*2 + slotSel)*10+SF] == 2 ? ( colDim(1); xat(220, 476); gfx_drawstr("LADEN FEHLGESCHLAGEN (WAV/AIFF?)"); );
// Scratcher — bei aktivem SCR die Wellenform durchreiben (Note halten!)
PF(SCR_ON, selPad) > 0.5 ? (
  uiClick && inBox(26, 368, 320, 104) ? ( dragId = 120; );
  colWhite(0.85); xline(26 + 320*slider53*0.01, 370, 26 + 320*slider53*0.01, 470);
  gfx_setfont(5); colAcid(1); xat(230, 476);
  sprintf(#vstr, "SCR %03d %%", floor(slider53 + 0.5)); gfx_drawstr(#vstr);
);
dragId == 120 && uiLmb ? (
  nv2 = floor(min2(100, max2(0, (mX - 26)/320*100)) + 0.5);
  nv2 != slider53 ? ( slider53 = nv2; M_LSL[53] = nv2; slider_automate(slider53); );
);

// Crossfade-Fader
gfx_setfont(3); colInk(1); xstr(26, 490, "A");
gfx_setfont(3); colInk(1); xstr(336, 490, "B");
gfx_set(0.092, 0.097, 0.092, 1); xrect(40, 496, 292, 10);
xv = PF(PF_XF, selPad);
colAcid(0.35); xrect(41, 497, 290*xv*0.01, 8);
colAcid(1); xrect(40 + 292*xv*0.01 - 3, 494, 6, 14);
uiClick && inBox(40, 492, 292, 18) ? ( dragId = 100; );
dragId == 100 && uiLmb ? (
  nvx = floor(min2(1, max2(0, (mX - 40)/292))*100 + 0.5);
  nvx != PF(PF_XF, selPad) ? ( pushXf(nvx); );
);

// --- Slot-Regler Reihe 1: Transpose/Fine/Gain/Start/Rnd/Delay
nv = floor(knob(40, 380, 410, 20, PF(sfTRN(), selPad), -24, 24) + 0.5);
nv != PF(sfTRN(), selPad) ? ( pushF(sfTRN(), nv); );
nv = floor(knob(41, 442, 410, 20, PF(sfFIN(), selPad), -50, 50) + 0.5);
nv != PF(sfFIN(), selPad) ? ( pushF(sfFIN(), nv); );
nv = knob(42, 504, 410, 20, PF(sfGAIN(), selPad), 0, 200);
nv != PF(sfGAIN(), selPad) ? ( pushF(sfGAIN(), nv); );
nv = knob(43, 566, 410, 20, PF(sfSTART(), selPad), 0, 100);
nv != PF(sfSTART(), selPad) ? ( pushF(sfSTART(), nv); );
nv = knob(44, 628, 410, 20, PF(sfRND(), selPad), 0, 100);
nv != PF(sfRND(), selPad) ? ( pushF(sfRND(), nv); );
nv = floor(knob(45, 690, 410, 20, PF(sfDLY(), selPad), 0, 50) + 0.5);
nv != PF(sfDLY(), selPad) ? ( pushF(sfDLY(), nv); );

gfx_setfont(3); colInk(1);
xctr(332, 436, 96, 12, "TRANSPOSE");
xctr(394, 436, 96, 12, "FINE TUNE");
xctr(456, 436, 96, 12, "GAIN");
xctr(518, 436, 96, 12, "START");
xctr(580, 436, 96, 12, "RND OFF");
xctr(642, 436, 96, 12, "DELAY");
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%+d st", floor(PF(sfTRN(), selPad) + 0.5)); drawCentered(380, 450);
sprintf(#vstr, "%+d ct", floor(PF(sfFIN(), selPad) + 0.5)); drawCentered(442, 450);
sprintf(#vstr, "%d %%", floor(PF(sfGAIN(), selPad) + 0.5)); drawCentered(504, 450);
sprintf(#vstr, "%d %%", floor(PF(sfSTART(), selPad) + 0.5)); drawCentered(566, 450);
sprintf(#vstr, "%d %%", floor(PF(sfRND(), selPad) + 0.5)); drawCentered(628, 450);
sprintf(#vstr, "%d ms", floor(PF(sfDLY(), selPad) + 0.5)); drawCentered(690, 450);

// --- Slot-Regler Reihe 2: LPF/HPF/LoFi/Spike + Kanal Volume/Pan/Retrig
nv = knob(46, 380, 486, 20, PF(sfLPF(), selPad), 0, 100);
nv != PF(sfLPF(), selPad) ? ( pushF(sfLPF(), nv); );
nv = knob(47, 442, 486, 20, PF(sfHPF(), selPad), 0, 100);
nv != PF(sfHPF(), selPad) ? ( pushF(sfHPF(), nv); );
nv = knob(48, 504, 486, 20, PF(sfLOFI(), selPad), 0, 100);
nv != PF(sfLOFI(), selPad) ? ( pushF(sfLOFI(), nv); );
nv = knob(49, 566, 486, 20, PF(sfSPIKE(), selPad), 0, 100);
nv != PF(sfSPIKE(), selPad) ? ( pushF(sfSPIKE(), nv); );
nv = knob(5, 628, 486, 20, PF(PF_VOL, selPad), 0, 100);
nv != PF(PF_VOL, selPad) ? ( pushVol(nv); );
nv = floor(knob(6, 690, 486, 20, PF(PF_PAN, selPad), -100, 100) + 0.5);
nv != PF(PF_PAN, selPad) ? ( pushPan(nv); );
nv = knob(7, 752, 486, 20, PF(PF_RT_RATE, selPad), 0, 100);
nv != PF(PF_RT_RATE, selPad) ? ( pushF(PF_RT_RATE, nv); );

gfx_setfont(3); colInk(1);
xctr(332, 512, 96, 12, "LPF");
xctr(394, 512, 96, 12, "HPF");
xctr(456, 512, 96, 12, "LOFI");
xctr(518, 512, 96, 12, "SPIKE");
xctr(580, 512, 96, 12, "VOLUME");
xctr(642, 512, 96, 12, "PAN L/R");
xctr(704, 512, 96, 12, "RETRIG");
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%d %%", floor(PF(sfLPF(), selPad) + 0.5)); drawCentered(380, 526);
sprintf(#vstr, "%d %%", floor(PF(sfHPF(), selPad) + 0.5)); drawCentered(442, 526);
sprintf(#vstr, "%d %%", floor(PF(sfLOFI(), selPad) + 0.5)); drawCentered(504, 526);
sprintf(#vstr, "%d %%", floor(PF(sfSPIKE(), selPad) + 0.5)); drawCentered(566, 526);
sprintf(#vstr, "%d %%", floor(PF(PF_VOL, selPad) + 0.5));  drawCentered(628, 526);
pnc = PF(PF_PAN, selPad);
pnc < -2 ? sprintf(#vstr, "L %d", -floor(pnc + 0.5))
: pnc > 2 ? sprintf(#vstr, "R %d", floor(pnc + 0.5))
: sprintf(#vstr, "C");
drawCentered(690, 526);
rtp = PF(PF_RT_RATE, selPad);
rtp > 0.5 ? sprintf(#vstr, "%.1f Hz", 2^(0.3 + rtp*0.043)) : sprintf(#vstr, "OFF");
drawCentered(752, 526);

// --- INPUT-Box rechts
panelBox(826, 338, 172, 204);
gfx_setfont(3);
colAcid(1); xstr(834, 344, "INPUT");
mdS = floor(PF(PF_MODE, selPad) + 0.5);
gfx_setfont(2);
btn(834, 358, 52, 18, mdS == 0, "KIT") ? ( pushMode(0); );
btn(890, 358, 52, 18, mdS > 0, "CH")  ? ( mdS == 0 ? ( pushMode(1); ) : ( pushMode(mdS); ); );
gfx_setfont(5);
mdS == 0 ? (
  btn(834, 380, 20, 16, 0, "-") ? ( pushNote(PF(PF_NOTE, selPad) - 1); );
  btn(916, 380, 20, 16, 0, "+") ? ( pushNote(PF(PF_NOTE, selPad) + 1); );
  gfx_setfont(4); colAcid(1);
  noteStr(floor(PF(PF_NOTE, selPad) + 0.5)); xctr(856, 380, 60, 16, #vstr);
  gfx_setfont(3); colInk(1); xstr(834, 400, "KIT NOTE");
) : (
  btn(834, 380, 20, 16, 0, "-") ? ( pushMode(mdS - 1); );
  btn(916, 380, 20, 16, 0, "+") ? ( pushMode(mdS + 1); );
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "CH %02d", mdS); xctr(856, 380, 60, 16, #vstr);
  gfx_setfont(3); colInk(1); xstr(834, 400, "MULTITRACK: TONAL + KEYTRACK");
);
// Killnote
gfx_setfont(2);
klS = floor(PF(PF_KILL, selPad) + 0.5);
btn(834, 416, 20, 16, 0, "-") ? ( pushKill(klS - 1); );
btn(916, 416, 20, 16, 0, "+") ? ( pushKill(klS + 1); );
gfx_setfont(4); klS >= 0 ? ( colAcid(1); ) : ( colInk(1); );
klS >= 0 ? ( noteStr(klS); ) : ( sprintf(#vstr, "OFF"); );
xctr(856, 416, 60, 16, #vstr);
gfx_setfont(3); colInk(1); xstr(834, 436, "KILLNOTE (CHOKES THIS PAD)");
// Voices
gfx_setfont(2);
btn(834, 452, 20, 16, 0, "-") ? ( pushVoi(PF(PF_VOI, selPad) - 1); );
btn(916, 452, 20, 16, 0, "+") ? ( pushVoi(PF(PF_VOI, selPad) + 1); );
gfx_setfont(4); colAcid(1);
sprintf(#vstr, "%d", floor(PF(PF_VOI, selPad) + 0.5)); xctr(856, 452, 60, 16, #vstr);
gfx_setfont(3); colInk(1); xstr(834, 472, "VOICES MAX");
btn(834, 484, 78, 14, PF(PF_1SHOT, selPad) > 0.5, "ONE SHOT") ? ( push1shot(1 - PF(PF_1SHOT, selPad)); );
btn(916, 484, 74, 14, 0, "ENVS -> INIT") ? (
  pushAtk(0.001); pushDec(0.8); pushSus(0); pushRel(0.05); push1shot(1);
);
// Root (Multitrack-Keytrack-Basis) + Pitchbend-Range
gfx_setfont(2);
btn(834, 502, 18, 15, 0, "-") ? ( pushRoot(floor(PF(PF_ROOT, selPad) + 0.5) - 1); );
btn(898, 502, 18, 15, 0, "+") ? ( pushRoot(floor(PF(PF_ROOT, selPad) + 0.5) + 1); );
gfx_setfont(4); colAcid(1);
noteStr(floor(PF(PF_ROOT, selPad) + 0.5)); xctr(876, 502, 44, 15, #vstr);
btn(920, 502, 16, 15, 0, "-") ? ( pushPbr(floor(PF(PBR, selPad) + 0.5) - 1); );
btn(982, 502, 16, 15, 0, "+") ? ( pushPbr(floor(PF(PBR, selPad) + 0.5) + 1); );
sprintf(#vstr, "%d st", floor(PF(PBR, selPad) + 0.5)); xctr(959, 502, 40, 15, #vstr);
gfx_setfont(5); colInk(1); xstr(834, 520, "ROOT (KEYTRACK)");
colDim(1); xstr(920, 520, "PB-RANGE");

/* ---------- Tab-Leiste ---------- */
ti = 0;
loop(8,
  btn(14 + ti*122, 564, 120, 22, tabSel == ti,
      ti == 0 ? "AMP" : ti == 1 ? "FILTER" : ti == 2 ? "PITCH" : ti == 3 ? "FX"
      : ti == 4 ? "LOOP" : ti == 5 ? "MOD" : ti == 6 ? "MIDI/ARP" : "SYSTEM") ? ( tabSel = ti; );
  ti += 1;
);

/* ---------- Editor-Flaeche ---------- */
panelBox(14, 594, 992, 104);

tabSel == 0 ? (
  // --- AMP: Huellkurve ueber der Waveform, Punkte sind ziehbar
  M_SLI[(selPad*2 + slotSel)*10+SF] == 1 ?
    drawWaveH(26, 598, 700, 96, selPad*2 + slotSel, 0.16, 0.30, 0.12) : 0;
  atkMs = PF(PF_ATK, selPad)*1000; decMs = PF(PF_DEC, selPad)*1000;
  susP = PF(PF_SUS, selPad); relMs = PF(PF_REL, selPad)*1000;
  ex0 = 26; ey0 = 690; eH = 84; EW = 700;
  aW = min2(1, atkMs/20)*0.30*EW;
  dW = min2(1, decMs/2000)*0.40*EW;
  sW = 0.12*EW;
  rW = max2(0.02, min2(1, relMs/1000))*0.15*EW;
  x1 = ex0 + aW; x2 = x1 + dW; x3 = x2 + sW; x4 = x3 + rW;
  ytop = ey0 - eH; ysus = ey0 - susP*eH;
  colAcid(1);
  xline(ex0, ey0, x1, ytop);
  xline(x1, ytop, x2, ysus);
  xline(x2, ysus, x3, ysus);
  xline(x3, ysus, x4, ey0);
  colWhite(1);
  xcirc(x1, ytop, 4, 1);
  xcirc(x2, ysus, 4, 1);
  xcirc(x3, ysus, 4, 1);
  xcirc(x4, ey0, 4, 1);
  uiClick && abs(mX - x1) < 9 && abs(mY - ytop) < 12 ? ( dragId = 200; );
  uiClick && abs(mX - x2) < 9 && abs(mY - ysus) < 12 ? ( dragId = 201; );
  uiClick && abs(mX - x3) < 9 && abs(mY - ysus) < 12 ? ( dragId = 202; );
  uiClick && abs(mX - x4) < 9 && abs(mY - ey0) < 12 ? ( dragId = 203; );
  dragId == 200 && uiLmb ? ( pushAtk(max2(0.0002, min2(1, max2(0, mX - ex0)/(0.30*EW)))*0.02); );
  dragId == 201 && uiLmb ? ( pushDec(min2(1, max2(0, mX - x1)/(0.40*EW))*2); );
  dragId == 202 && uiLmb ? ( pushSus(min2(1, max2(0, (ey0 - mY)/eH))); );
  dragId == 203 && uiLmb ? ( pushRel(min2(1, max2(0, mX - x3)/(0.15*EW))); );
  // Readouts
  gfx_setfont(3); colInk(1);
  xstr(744, 600, "ATTACK");  xstr(744, 614, "DECAY");
  xstr(744, 628, "SUSTAIN"); xstr(744, 642, "RELEASE");
  xstr(744, 656, "MODE");
  gfx_setfont(4); colAcid(1);
  xat(812, 600); gfx_printf("%.1f ms", atkMs);
  xat(812, 614); gfx_printf("%d ms", floor(decMs + 0.5));
  xat(812, 628); gfx_printf("%d %%", floor(susP*100 + 0.5));
  xat(812, 642); gfx_printf("%d ms", floor(relMs + 0.5));
  PF(PF_1SHOT, selPad) > 0.5 ? ( gfx_drawstr("ONE-SHOT"); ) : ( gfx_drawstr("SUSTAIN"); );
  // Timescale + Retrig-Feinwerte
  nv = floor(knob(32, 760, 672, 13, PF(PF_TIMESC, selPad), 25, 200) + 0.5);
  nv != PF(PF_TIMESC, selPad) ? ( pushTsc(nv); );
  nv = floor(knob(33, 840, 672, 13, PF(PF_RT_KTRK, selPad), 0, 100) + 0.5);
  nv != PF(PF_RT_KTRK, selPad) ? ( pushF(PF_RT_KTRK, nv); );
  nv = floor(knob(34, 920, 672, 13, PF(PF_RT_FADE, selPad), 0, 20) + 0.5);
  nv != PF(PF_RT_FADE, selPad) ? ( pushF(PF_RT_FADE, nv); );
  gfx_setfont(5); colInk(1);
  xctr(736, 688, 48, 10, "T.SC");
  xctr(816, 688, 48, 10, "RTRG-KTRK");
  xctr(896, 688, 48, 10, "RTRG-FADE");
);

tabSel == 1 ? (
  // --- FILTER: Typ/Cutoff/Reso/Env/Drive + Filter-Env-Editor
  gfx_set(0.042, 0.048, 0.042, 1); xrect(26, 600, 320, 96);
  fta = PF(FEA_ATK, selPad)*1000; ftd = PF(FEA_DEC, selPad)*1000;
  fts = PF(FEA_SUS, selPad); ftr = PF(FEA_REL, selPad)*1000;
  fx0 = 26; fy0 = 690; fH = 84; FW = 320;
  faW = min2(1, fta/50)*0.30*FW;
  fdW = min2(1, ftd/2000)*0.40*FW;
  fsW = 0.12*FW;
  frW = max2(0.02, min2(1, ftr/1000))*0.15*FW;
  fx1 = fx0 + faW; fx2 = fx1 + fdW; fx3 = fx2 + fsW; fx4 = fx3 + frW;
  fysus = fy0 - fts*fH; fytop = fy0 - fH;
  colAcid(1);
  xline(fx0, fy0, fx1, fytop);
  xline(fx1, fytop, fx2, fysus);
  xline(fx2, fysus, fx3, fysus);
  xline(fx3, fysus, fx4, fy0);
  colWhite(1);
  xcirc(fx1, fytop, 4, 1); xcirc(fx2, fysus, 4, 1);
  xcirc(fx3, fysus, 4, 1); xcirc(fx4, fy0, 4, 1);
  uiClick && abs(mX - fx1) < 9 && abs(mY - fytop) < 12 ? ( dragId = 210; );
  uiClick && abs(mX - fx2) < 9 && abs(mY - fysus) < 12 ? ( dragId = 211; );
  uiClick && abs(mX - fx3) < 9 && abs(mY - fysus) < 12 ? ( dragId = 212; );
  uiClick && abs(mX - fx4) < 9 && abs(mY - fy0) < 12 ? ( dragId = 213; );
  dragId == 210 && uiLmb ? ( pushF(FEA_ATK, max2(0.0002, min2(1, max2(0, mX - fx0)/(0.30*FW)))*0.05); );
  dragId == 211 && uiLmb ? ( pushF(FEA_DEC, min2(1, max2(0, mX - fx1)/(0.40*FW))*2); );
  dragId == 212 && uiLmb ? ( pushF(FEA_SUS, min2(1, max2(0, (fy0 - mY)/fH))); );
  dragId == 213 && uiLmb ? ( pushF(FEA_REL, min2(1, max2(0, mX - fx3)/(0.15*FW))); );
  gfx_setfont(5); colDim(1);
  xstr(26, 694, "FILTER ENV (DRAG POINTS) - CUTOFF MOD IN OCTAVES OF ENV");
  // Regler
  nv = floor(knob(35, 420, 640, 20, PF(FLT_TYPE, selPad), 0, 9) + 0.5);
  nv != PF(FLT_TYPE, selPad) ? ( pushF(FLT_TYPE, nv); );
  nv = knob(36, 490, 640, 20, PF(FLT_CUT, selPad), 0, 100);
  nv != PF(FLT_CUT, selPad) ? ( pushF(FLT_CUT, nv); );
  nv = knob(37, 560, 640, 20, PF(FLT_RES, selPad), 0, 100);
  nv != PF(FLT_RES, selPad) ? ( pushF(FLT_RES, nv); );
  nv = knob(38, 630, 640, 20, PF(FLT_ENV, selPad), 0, 100);
  nv != PF(FLT_ENV, selPad) ? ( pushF(FLT_ENV, nv); );
  nv = knob(39, 700, 640, 20, PF(FLT_DRV, selPad), 0, 100);
  nv != PF(FLT_DRV, selPad) ? ( pushF(FLT_DRV, nv); );
  gfx_setfont(3); colInk(1);
  xctr(372, 666, 96, 12, "TYPE");
  xctr(442, 666, 96, 12, "CUTOFF");
  xctr(512, 666, 96, 12, "RESO");
  xctr(582, 666, 96, 12, "ENV");
  xctr(652, 666, 96, 12, "DRIVE");
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "%s", fltTypeName(floor(PF(FLT_TYPE, selPad) + 0.5))); drawCentered(420, 680);
  sprintf(#vstr, "%d Hz", floor(20*1000^(PF(FLT_CUT, selPad)*0.01) + 0.5)); drawCentered(490, 680);
  sprintf(#vstr, "%d %%", floor(PF(FLT_RES, selPad) + 0.5)); drawCentered(560, 680);
  sprintf(#vstr, "%.1f okt", PF(FLT_ENV, selPad)*0.04); drawCentered(630, 680);
  sprintf(#vstr, "%d %%", floor(PF(FLT_DRV, selPad) + 0.5)); drawCentered(700, 680);
  gfx_setfont(2);
  btn(770, 630, 96, 18, PF(FLT_MODE, selPad) < 0.5, "CLEAN") ? ( pushF(FLT_MODE, 0); );
  btn(770, 652, 96, 18, PF(FLT_MODE, selPad) > 0.5, "DIRTY") ? ( pushF(FLT_MODE, 1); );
);

tabSel == 2 ? (
  // --- PITCH: Pitch-Env-Editor + Range/Steps/Flip + Portamento
  gfx_set(0.042, 0.048, 0.042, 1); xrect(26, 600, 320, 96);
  pna = PF(PEA_ATK, selPad)*1000; pnd = PF(PEA_DEC, selPad)*1000;
  pns = PF(PEA_SUS, selPad); pnr = PF(PEA_REL, selPad)*1000;
  px0 = 26; py0 = 690; pH = 84; PW = 320;
  paW = min2(1, pna/50)*0.30*PW;
  pdW = min2(1, pnd/2000)*0.40*PW;
  psW = 0.12*PW;
  prW = max2(0.02, min2(1, pnr/1000))*0.15*PW;
  px1 = px0 + paW; px2 = px1 + pdW; px3 = px2 + psW; px4 = px3 + prW;
  pysus = py0 - pns*pH; pytop = py0 - pH;
  colAcid(1);
  xline(px0, py0, px1, pytop);
  xline(px1, pytop, px2, pysus);
  xline(px2, pysus, px3, pysus);
  xline(px3, pysus, px4, py0);
  colWhite(1);
  xcirc(px1, pytop, 4, 1); xcirc(px2, pysus, 4, 1);
  xcirc(px3, pysus, 4, 1); xcirc(px4, py0, 4, 1);
  uiClick && abs(mX - px1) < 9 && abs(mY - pytop) < 12 ? ( dragId = 220; );
  uiClick && abs(mX - px2) < 9 && abs(mY - pysus) < 12 ? ( dragId = 221; );
  uiClick && abs(mX - px3) < 9 && abs(mY - pysus) < 12 ? ( dragId = 222; );
  uiClick && abs(mX - px4) < 9 && abs(mY - py0) < 12 ? ( dragId = 223; );
  dragId == 220 && uiLmb ? ( pushF(PEA_ATK, max2(0.0002, min2(1, max2(0, mX - px0)/(0.30*PW)))*0.05); );
  dragId == 221 && uiLmb ? ( pushF(PEA_DEC, min2(1, max2(0, mX - px1)/(0.40*PW))*2); );
  dragId == 222 && uiLmb ? ( pushF(PEA_SUS, min2(1, max2(0, (py0 - mY)/pH))); );
  dragId == 223 && uiLmb ? ( pushF(PEA_REL, min2(1, max2(0, mX - px3)/(0.15*PW))); );
  gfx_setfont(5); colDim(1);
  xstr(26, 694, "PITCH ENV (DRAG POINTS) - RANGE SCALED IN SEMITONES");
  // Regler
  nv = floor(knob(50, 420, 640, 20, PF(PEN_RANGE, selPad), 0, 24) + 0.5);
  nv != PF(PEN_RANGE, selPad) ? ( pushF(PEN_RANGE, nv); );
  nv = knob(51, 490, 640, 20, PF(PEN_STEPS, selPad), 0, 100);
  nv != PF(PEN_STEPS, selPad) ? ( pushF(PEN_STEPS, nv); );
  nv = floor(knob(52, 560, 640, 20, PF(PORTA_TIME, selPad), 0, 500) + 0.5);
  nv != PF(PORTA_TIME, selPad) ? ( pushF(PORTA_TIME, nv); );
  gfx_setfont(3); colInk(1);
  xctr(372, 666, 96, 12, "RANGE");
  xctr(442, 666, 96, 12, "STEPS");
  xctr(512, 666, 96, 12, "PORTA TIME");
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "%d st", floor(PF(PEN_RANGE, selPad) + 0.5)); drawCentered(420, 680);
  sprintf(#vstr, "%d %%", floor(PF(PEN_STEPS, selPad) + 0.5)); drawCentered(490, 680);
  sprintf(#vstr, "%d ms", floor(PF(PORTA_TIME, selPad) + 0.5)); drawCentered(560, 680);
  gfx_setfont(2);
  pmo = floor(PF(PORTA_MODE, selPad) + 0.5);
  btn(630, 630, 56, 18, pmo == 0, "OFF") ? ( pushF(PORTA_MODE, 0); );
  btn(690, 630, 56, 18, pmo == 1, "POLY") ? ( pushF(PORTA_MODE, 1); );
  btn(750, 630, 62, 18, pmo == 2, "LEGATO") ? ( pushF(PORTA_MODE, 2); );
  gfx_setfont(4); colAcid(1);
  pmo > 0 ? ( gfx_drawstr("GLIDE ON"); ) : ( gfx_drawstr("GLIDE OFF"); );
  xat(630, 656);
);

tabSel == 3 ? (
  // --- FX: 4-Band-EQ + 4 Insert-Slots (Master-Kette)
  gfx_setfont(3); colAcid(1); xstr(26, 598, "FX-CHAIN");
  gfx_setfont(2);
  fxon = M_FX[FXP_ON] > 0.5;
  btn(100, 598, 40, 14, fxon, fxon ? "ON" : "OFF") ? ( M_FX[FXP_ON] = fxon ? 0 : 1; );
  gfx_setfont(5); colDim(1); xstr(148, 601, "EQ -> INSERT 1-4 -> MASTER · TYPE: L-CLICK +1 / R-CLICK -1");
  // 4-Band-EQ: Response-Kurve + Band-Strips
  gfx_set(0.042, 0.048, 0.042, 1); xrect(26, 614, 190, 42);
  gfx_set(0.10, 0.13, 0.08, 1); xline(26, 635, 216, 635);
  colAcid(1);
  eqk = 0;
  loop(64,
    eqfv = 30*(20000/30)^(eqk/63);
    eqw = 2*$pi*eqfv/srate;
    eqdb = 0; eqb = 0;
    loop(4,
      cbc = FXC(eqb);
      cc = cos(eqw); ss = sin(eqw); c22 = cos(2*eqw); s22 = sin(2*eqw);
      nre = M_FX[cbc] + M_FX[cbc+1]*cc + M_FX[cbc+2]*c22;
      nim = -(M_FX[cbc+1]*ss + M_FX[cbc+2]*s22);
      dre = 1 + M_FX[cbc+3]*cc + M_FX[cbc+4]*c22;
      dim = -(M_FX[cbc+3]*ss + M_FX[cbc+4]*s22);
      eqdb += 8.6858896*log(max2(0.000000000001, (nre*nre + nim*nim))/max2(0.000000000001, dre*dre + dim*dim));
      eqb += 1;
    );
    eqy = 635 - min2(15, max2(-15, eqdb))*1.18;
    eqx = 27 + eqk*188/63;
    eqk == 0 ? ( eqpx = eqx; eqpy = eqy; ) : ( xline(eqpx, eqpy, eqx, eqy); eqpx = eqx; eqpy = eqy; );
    eqk += 1;
  );
  eb = 0;
  loop(4,
    ebx = 226 + eb*192;
    ety = floor(M_FX[EQT(eb)] + 0.5);
    gfx_setfont(2);
    btn(ebx, 614, 72, 13, ety > 0, eqTypeName(ety)) ? ( pushFX(EQT(eb), (ety + 1) % 5); );
    uiRClk && inBox(ebx, 614, 72, 13) ? ( pushFX(EQT(eb), (ety + 4) % 5); );
    nv = knob(70 + eb*3, ebx + 94, 639, 8, M_FX[EQF(eb)], 0, 100);
    nv != M_FX[EQF(eb)] ? ( pushFX(EQF(eb), nv); );
    nv = knob(71 + eb*3, ebx + 126, 639, 8, M_FX[EQG(eb)], 0, 100);
    nv != M_FX[EQG(eb)] ? ( pushFX(EQG(eb), nv); );
    nv = knob(72 + eb*3, ebx + 158, 639, 8, M_FX[EQQ(eb)], 0, 100);
    nv != M_FX[EQQ(eb)] ? ( pushFX(EQQ(eb), nv); );
    gfx_setfont(4); colAcid(1);
    sprintf(#vstr, "%d Hz  %+d dB  Q%.1f", floor(fxFreq(M_FX[EQF(eb)]) + 0.5),
            floor(fxGain(M_FX[EQG(eb)]) + 0.5), fxQk(M_FX[EQQ(eb)]));
    xctr(ebx, 648, 190, 9, #vstr);
    eb += 1;
  );
  // 4 Insert-Slots
  s5u = 0;
  loop(4,
    sx = 26 + s5u*245;
    ty2 = floor(M_FX[ISL_TYPE(s5u)] + 0.5);
    gfx_setfont(2);
    btn(sx, 658, 92, 13, ty2 > 0, fxTypeName(ty2)) ? (
      nt2 = (ty2 + 1) % 13;
      pushFX(ISL_TYPE(s5u), nt2);
      pushFX(ISL_MIX(s5u), nt2 == 0 ? 0 : nt2 == 12 ? 100 : (nt2 >= 5 && nt2 <= 8) ? 100 : 35);
      pushFX(ISL_P(s5u,0), 50); pushFX(ISL_P(s5u,1), 50);
      pushFX(ISL_P(s5u,2), 50); pushFX(ISL_P(s5u,3), 50);
    );
    uiRClk && inBox(sx, 658, 92, 13) ? (
      nt2 = (ty2 + 12) % 13;
      pushFX(ISL_TYPE(s5u), nt2);
      pushFX(ISL_MIX(s5u), nt2 == 0 ? 0 : nt2 == 12 ? 100 : (nt2 >= 5 && nt2 <= 8) ? 100 : 35);
      pushFX(ISL_P(s5u,0), 50); pushFX(ISL_P(s5u,1), 50);
      pushFX(ISL_P(s5u,2), 50); pushFX(ISL_P(s5u,3), 50);
    );
    gfx_setfont(5); colDim(1); xctr(sx + 94, 658, 152, 13, fxLabels(ty2));
    gfx_setfont(4); ty2 > 0 ? ( colAcid(1); ) : ( colInk(1); );
    xctr(sx, 671, 246, 9, fxVals(ty2, s5u));
    nv = knob(82 + s5u*5, sx + 22, 689, 8, M_FX[ISL_P(s5u,0)], 0, 100);
    nv != M_FX[ISL_P(s5u,0)] ? ( pushFX(ISL_P(s5u,0), nv); );
    nv = knob(83 + s5u*5, sx + 70, 689, 8, M_FX[ISL_P(s5u,1)], 0, 100);
    nv != M_FX[ISL_P(s5u,1)] ? ( pushFX(ISL_P(s5u,1), nv); );
    nv = knob(84 + s5u*5, sx + 118, 689, 8, M_FX[ISL_P(s5u,2)], 0, 100);
    nv != M_FX[ISL_P(s5u,2)] ? ( pushFX(ISL_P(s5u,2), nv); );
    nv = knob(85 + s5u*5, sx + 166, 689, 8, M_FX[ISL_P(s5u,3)], 0, 100);
    nv != M_FX[ISL_P(s5u,3)] ? ( pushFX(ISL_P(s5u,3), nv); );
    nv = knob(86 + s5u*5, sx + 214, 689, 8, M_FX[ISL_MIX(s5u)], 0, 100);
    nv != M_FX[ISL_MIX(s5u)] ? ( pushFX(ISL_MIX(s5u), nv); );
    s5u += 1;
  );
);

tabSel == 4 ? (
  // --- LOOP-EDITOR (Slot folgt der A/B-Wahl im Vollpanel)
  gfx_setfont(3); colAcid(1); xstr(26, 600, "LOOP");
  colInk(1); xstr(80, 600, slotSel == 0 ? "SLOT A - LOOP BETWEEN THE FLAGS, XFADE AGAINST CLICKS" : "SLOT B - LOOP BETWEEN THE FLAGS, XFADE AGAINST CLICKS");
  gfx_setfont(2);
  btn(26, 614, 52, 18, PF(LON_A + slotSel, selPad) > 0.5, "LOOP") ? ( pushF(LON_A + slotSel, 1 - PF(LON_A + slotSel, selPad)); );
  btn(82, 614, 52, 18, PF(LTYPE_A + slotSel, selPad) < 0.5, "NRM") ? ( pushF(LTYPE_A + slotSel, 0); );
  btn(138, 614, 52, 18, PF(LTYPE_A + slotSel, selPad) == 1, "PING") ? ( pushF(LTYPE_A + slotSel, 1); );
  btn(194, 614, 52, 18, PF(LTYPE_A + slotSel, selPad) == 2, "XFD") ? ( pushF(LTYPE_A + slotSel, 2); );
  btn(250, 614, 64, 18, 0, "ZERO") ? (
    pushF(LSTA_A + slotSel, snapZero(selPad*2 + slotSel, PF(LSTA_A + slotSel, selPad)));
    pushF(LEN_A + slotSel, snapZero(selPad*2 + slotSel, PF(LEN_A + slotSel, selPad)));
    loopRecalc();
  );
  // Wellenform mit Loop-Region
  gfx_set(0.042, 0.048, 0.042, 1); xrect(26, 638, 900, 40);
  M_SLI[(selPad*2 + slotSel)*10+SF] == 1 ? (
    drawWaveH(28, 640, 896, 36, selPad*2 + slotSel, 0.224, 1.0, 0.078);
    // Loop-Region
    lstx = 28 + PF(LSTA_A + slotSel, selPad)*0.001*896;
    lenx = 28 + PF(LEN_A + slotSel, selPad)*0.001*896;
    colAcid(0.13); xrect(lstx, 638, lenx - lstx, 40);
    colAcid(1);
    xrect(lstx - 1, 638, 2, 40); xrect(lenx - 1, 638, 2, 40);
    // Fahnen ziehen
    uiClick && inBox(26, 638, 900, 40) ? (
      dragId = abs(mX - lstx) < abs(mX - lenx) ? 300 : 301;
    );
    dragId == 300 && uiLmb ? (
      nv = floor(min2(PF(LEN_A + slotSel, selPad) - 10, max2(0, (mX - 28)/896*1000)));
      nv != PF(LSTA_A + slotSel, selPad) ? ( pushF(LSTA_A + slotSel, nv); loopRecalc(); );
    );
    dragId == 301 && uiLmb ? (
      nv = floor(min2(1000, max2(PF(LSTA_A + slotSel, selPad) + 10, (mX - 28)/896*1000)));
      nv != PF(LEN_A + slotSel, selPad) ? ( pushF(LEN_A + slotSel, nv); loopRecalc(); );
    );
  ) : (
    gfx_setfont(5); colDim(1); xctr(26, 654, 900, 12, "NO SAMPLE IN THE SELECTED SLOT");
  );
  // Xfade-Regler + Zeiten
  nv = floor(knob(53, 950, 652, 14, PF(LXFD_A + slotSel, selPad), 0, 100) + 0.5);
  nv != PF(LXFD_A + slotSel, selPad) ? ( pushF(LXFD_A + slotSel, nv); );
  gfx_setfont(5); colInk(1); xctr(926, 668, 60, 10, "XFADE ms");
  gfx_setfont(5); colAcid(1); xat(26, 684);
  gfx_printf("START %d PERMILLE  |  END %d PERMILLE", floor(PF(LSTA_A + slotSel, selPad) + 0.5), floor(PF(LEN_A + slotSel, selPad) + 0.5));
);

tabSel == 5 ? (
  // --- MOD: Matrix, LFOs, Mod-Env, Velocity, Panorama, GUI-Modifier
  gfx_setfont(3); colAcid(1); xstr(26, 600, "MOD-MATRIX");
  colInk(1); xstr(110, 600, "SOURCE > TARGET · L-CLICK +1 · R-CLICK -1 · MOUSE X/Y = MOD SOURCES M-X/M-Y");
  mmI = 0;
  loop(8,
    mmX = 26 + floor(mmI/4)*214;
    mmY = 614 + (mmI - floor(mmI/4)*4)*20;
    mmS = floor(PF(MM_SRC + mmI*3, selPad) + 0.5);
    mmD = floor(PF(MM_DST + mmI*3, selPad) + 0.5);
    mmA = PF(MM_AMT + mmI*3, selPad);
    gfx_setfont(5); colInk(1);
    xat(mmX - 12, mmY + 3); gfx_printf("%d", mmI + 1);
    gfx_setfont(2);
    btn(mmX, mmY, 46, 16, mmS > 0, modSrcName(mmS)) ? ( pushM(MM_SRC + mmI*3, (mmS + 1) % 12); );
    uiRClk && inBox(mmX, mmY, 46, 16) ? ( pushM(MM_SRC + mmI*3, (mmS + 11) % 12); );
    gfx_setfont(5); colInk(1); xctr(mmX + 46, mmY, 12, 16, ">");
    btn(mmX + 58, mmY, 58, 16, mmD > 0, modDstName(mmD)) ? ( pushM(MM_DST + mmI*3, (mmD + 1) % 9); );
    uiRClk && inBox(mmX + 58, mmY, 58, 16) ? ( pushM(MM_DST + mmI*3, (mmD + 8) % 9); );
    // Amount: Zahl ziehen (vertikal)
    gfx_set(0.092, 0.097, 0.092, 1); xrect(mmX + 122, mmY, 46, 16);
    mmS > 0 && mmD > 0 ? ( colAcid(1); ) : ( colInk(1); );
    gfx_setfont(4);
    sprintf(#vstr, "%+d", floor(mmA + 0.5));
    xctr(mmX + 122, mmY, 46, 16, #vstr);
    uiClick && inBox(mmX + 122, mmY, 46, 16) ? ( dragId = 400 + mmI; dragY = mY; dragV = mmA; );
    dragId == 400 + mmI && uiLmb ? (
      mmNv = min2(100, max2(-100, floor(dragV + (dragY - mY)*1.2 + 0.5)));
      mmNv != mmA ? ( pushM(MM_AMT + mmI*3, mmNv); );
    );
    mmI += 1;
  );
  // LFO 1+2
  gfx_setfont(3); colAcid(1); xstr(448, 600, "LFO");
  lfoI = 0;
  loop(2,
    lfoBase = lfoI == 0 ? L1_SHAPE : L2_SHAPE;
    lfoY = 616 + lfoI*24;
    gfx_setfont(4); colInk(1); xstr(448, lfoY + 2, lfoI == 0 ? "1" : "2");
    gfx_setfont(2);
    lfoSh = floor(PF(lfoBase, selPad) + 0.5);
    btn(462, lfoY, 48, 16, PF(L1_RATE + lfoI*3, selPad) > 0.5, lfoShapeName(lfoSh)) ? ( pushM(lfoBase, (lfoSh + 1) % 6); );
    uiRClk && inBox(462, lfoY, 48, 16) ? ( pushM(lfoBase, (lfoSh + 5) % 6); );
    nv = knob(60 + lfoI, 536, lfoY + 8, 11, PF(L1_RATE + lfoI*3, selPad), 0, 100);
    nv != PF(L1_RATE + lfoI*3, selPad) ? ( pushM(L1_RATE + lfoI*3, nv); );
    gfx_setfont(4); colAcid(1);
    PF(L1_RATE + lfoI*3, selPad) > 0.5 ?
      sprintf(#vstr, "%.1f Hz", 30*(PF(L1_RATE + lfoI*3, selPad)*0.01)^2)
      : sprintf(#vstr, "OFF");
    xctr(566, lfoY, 52, 16, #vstr);
    gfx_setfont(2);
    btn(624, lfoY, 46, 16, PF(L1_RETRIG + lfoI*3, selPad) > 0.5, "RETRIG") ?
      ( pushM(L1_RETRIG + lfoI*3, 1 - PF(L1_RETRIG + lfoI*3, selPad)); );
    lfoI += 1;
  );
  // Mod-Env
  gfx_setfont(4); colInk(1); xstr(448, 666, "M-ENV");
  nv = knob(62, 484, 676, 10, PF(MEN_ATK, selPad), 0, 2);
  nv != PF(MEN_ATK, selPad) ? ( pushM(MEN_ATK, nv); );
  nv = knob(63, 518, 676, 10, PF(MEN_DEC, selPad), 0, 2);
  nv != PF(MEN_DEC, selPad) ? ( pushM(MEN_DEC, nv); );
  nv = knob(64, 552, 676, 10, PF(MEN_SUS, selPad), 0, 1);
  nv != PF(MEN_SUS, selPad) ? ( pushM(MEN_SUS, nv); );
  nv = knob(65, 586, 676, 10, PF(MEN_REL, selPad), 0, 2);
  nv != PF(MEN_REL, selPad) ? ( pushM(MEN_REL, nv); );
  gfx_setfont(5); colInk(1);
  xctr(460, 688, 48, 10, "ATK"); xctr(494, 688, 48, 10, "DEC");
  xctr(528, 688, 48, 10, "SUS"); xctr(562, 688, 48, 10, "REL");
  gfx_setfont(5); colAcid(1); xat(618, 684);
  gfx_printf("%.0f/%.0f/%d/%.0f ms", PF(MEN_ATK, selPad)*1000, PF(MEN_DEC, selPad)*1000,
             floor(PF(MEN_SUS, selPad)*100 + 0.5), PF(MEN_REL, selPad)*1000);
  // Velocity: Tiefe + Kurve + Skizze
  gfx_setfont(3); colAcid(1); xstr(720, 600, "VELOCITY");
  nv = knob(66, 752, 630, 14, PF(VEL_DEPTH, selPad), 0, 200);
  nv != PF(VEL_DEPTH, selPad) ? ( pushM(VEL_DEPTH, nv); );
  gfx_setfont(5); colInk(1); xctr(726, 648, 52, 10, "TIEFE");
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "%d %%", floor(PF(VEL_DEPTH, selPad) + 0.5)); drawCentered(752, 650);
  gfx_setfont(2);
  vcs = floor(PF(VEL_CURVE, selPad) + 0.5);
  btn(788, 616, 54, 16, vcs > 0, velCurveName(vcs)) ? ( pushM(VEL_CURVE, (vcs + 1) % 5); );
  uiRClk && inBox(788, 616, 54, 16) ? ( pushM(VEL_CURVE, (vcs + 4) % 5); );
  gfx_setfont(5); colDim(1); xstr(788, 636, "CLICK = CURVE");
  gfx_set(0.042, 0.048, 0.042, 1); xrect(860, 606, 140, 56);
  gfx_set(0.10, 0.13, 0.08, 1); xline(862, 660, 998, 660);
  colAcid(1);
  vk2 = 0;
  loop(29,
    vkX = 862 + vk2*4.8;
    vkY = 660 - velCurve(vk2/28, vcs)*46;
    vk2 == 0 ? ( pvX = vkX; pvY = vkY; ) : ( xline(pvX, pvY, vkX, vkY); pvX = vkX; pvY = vkY; );
    vk2 += 1;
  );
  // Panorama je Slot + GUI-Modifier
  gfx_setfont(3); colAcid(1); xstr(720, 658, "PAN A/B + GUI-MOD");
  nv = floor(knob(67, 752, 682, 11, PF(PANA, selPad), -100, 100) + 0.5);
  nv != PF(PANA, selPad) ? ( pushM(PANA, nv); );
  nv = floor(knob(68, 796, 682, 11, PF(PANB, selPad), -100, 100) + 0.5);
  nv != PF(PANB, selPad) ? ( pushM(PANB, nv); );
  nv = floor(knob(54, 866, 682, 11, gmod1, -100, 100) + 0.5);
  nv != gmod1 ? ( gmod1 = nv; M_ST[2049] = nv; );
  nv = floor(knob(55, 910, 682, 11, gmod2, -100, 100) + 0.5);
  nv != gmod2 ? ( gmod2 = nv; M_ST[2050] = nv; );
  nv = floor(knob(56, 954, 682, 11, gmod3, -100, 100) + 0.5);
  nv != gmod3 ? ( gmod3 = nv; M_ST[2051] = nv; );
  gfx_setfont(5); colInk(1);
  xstr(722, 678, "A"); xstr(766, 678, "B");
  xstr(838, 678, "G1"); xstr(882, 678, "G2"); xstr(926, 678, "G3");
  gfx_setfont(5); colDim(1); xat(860, 666);
  gfx_printf("MOUSE %+d / %+d", floor(gmx*100 + 0.5), floor(gmy*100 + 0.5));
);

tabSel == 6 ? (
  // --- MIDI/ARP: Keyboard mit Kit-Noten (Klick weist zu)
  gfx_setfont(3); colAcid(1); xstr(26, 600, "DRUMKIT MATRIX");
  colInk(1); xstr(160, 600, "CLICK A KEY = KIT NOTE OF THE SELECTED PAD (KIT MODE LISTENS ON CHANNEL 1)");
  kw = 36; kx0 = 26; ky0 = 614; kh = 68;
  ki = 0;
  loop(37,
    kn = 36 + ki;
    ks = kn - 12*floor(kn/12);
    (ks == 1 || ks == 3 || ks == 6 || ks == 8 || ks == 10) ? 0 : (
      kAs = -1; kp = 0;
      loop(16, floor(PF(PF_NOTE, kp) + 0.5) == kn ? ( kAs = kp; ); kp += 1; );
      kAs >= 0 ? ( kAs == selPad ? ( colAcid(1); ) : ( gfx_set(0.30, 0.62, 0.24, 1); ); )
               : ( gfx_set(0.88, 0.88, 0.88, 1); );
      inBox(kx0, ky0, kw, kh) ? ( gfx_set(0.55, 1.0, 0.45, 1); );
      xrect(kx0, ky0, kw - 1, kh);
      gfx_set(0.10, 0.10, 0.10, 1);
      ks == 0 ? ( gfx_setfont(5); xat(kx0 + 3, ky0 + kh - 12); gfx_printf("C%d", floor(kn/12) - 1); );
      uiClick && inBox(kx0, ky0, kw, kh) ? ( pushNote(kn); );
      kx0 += kw;
    );
    ki += 1;
  );
  kx0 = 26; ki = 0;
  loop(37,
    kn = 36 + ki;
    ks = kn - 12*floor(kn/12);
    (ks == 1 || ks == 3 || ks == 6 || ks == 8 || ks == 10) ? (
      kAs = -1; kp = 0;
      loop(16, floor(PF(PF_NOTE, kp) + 0.5) == kn ? ( kAs = kp; ); kp += 1; );
      kAs >= 0 ? ( kAs == selPad ? ( colAcid(1); ) : ( gfx_set(0.30, 0.62, 0.24, 1); ); )
               : ( gfx_set(0.04, 0.05, 0.04, 1); );
      xrect(kx0 - 11, ky0, 22, kh*0.62);
      uiClick && inBox(kx0 - 11, ky0, 22, kh*0.62) ? ( pushNote(kn); );
    ) : ( kx0 += kw; );
    ki += 1;
  );
  gfx_setfont(3); colAcid(1); xstr(830, 600, "ARP");
  apM = floor(PF(ARP_MODE, selPad) + 0.5);
  gfx_setfont(2);
  btn(830, 614, 56, 16, apM > 0, arpModeName(apM)) ? ( pushM(ARP_MODE, (apM + 1) % 6); );
  uiRClk && inBox(830, 614, 56, 16) ? ( pushM(ARP_MODE, (apM + 5) % 6); );
  gfx_set(0.092, 0.097, 0.092, 1); xrect(890, 614, 34, 16);
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "S%d", floor(PF(SHUF, selPad) + 0.5));
  xctr(890, 614, 34, 16, #vstr);
  uiClick && inBox(890, 614, 34, 16) ? ( dragId = 410; dragY = mY; dragV = PF(SHUF, selPad); );
  dragId == 410 && uiLmb ? (
    shv = min2(50, max2(0, floor(dragV + (dragY - mY)*0.5 + 0.5)));
    shv != PF(SHUF, selPad) ? ( pushM(SHUF, shv); );
  );
  btn(928, 614, 26, 16, 0, "-") ? ( pushM(ARP_OCT, max2(1, floor(PF(ARP_OCT, selPad) + 0.5) - 1)); );
  btn(956, 614, 26, 16, 0, "+") ? ( pushM(ARP_OCT, min2(4, floor(PF(ARP_OCT, selPad) + 0.5) + 1)); );
  nv = knob(106, 862, 656, 13, PF(ARP_RATE, selPad), 0, 100);
  nv != PF(ARP_RATE, selPad) ? ( pushM(ARP_RATE, nv); );
  nv = knob(107, 936, 656, 13, PF(ARP_GATE, selPad), 5, 100);
  nv != PF(ARP_GATE, selPad) ? ( pushM(ARP_GATE, nv); );
  gfx_setfont(5); colInk(1);
  xctr(838, 674, 48, 10, "RATE"); xctr(912, 674, 48, 10, "GATE");
  gfx_setfont(4); colAcid(1);
  apM > 0 ? (
    M_SYS[SYS_SYNC] == 2 || M_SYS[SYS_SYNC] == 3 ? (
      an2 = floor(PF(ARP_RATE, selPad)*0.06); an2 > 5 ? an2 = 5; an2 < 0 ? an2 = 0;
      sprintf(#vstr, "%s", an2 == 0 ? "1/4" : an2 == 1 ? "1/8T" : an2 == 2 ? "1/8"
        : an2 == 3 ? "1/16T" : an2 == 4 ? "1/16" : "1/32");
    ) : sprintf(#vstr, "%.0fms", 20*100^(PF(ARP_RATE, selPad)*0.01));
    drawCentered(862, 670);
    sprintf(#vstr, "%d%%", floor(PF(ARP_GATE, selPad) + 0.5)); drawCentered(936, 670);
  ) : (
    sprintf(#vstr, "OFF"); drawCentered(862, 670);
  );
  gfx_setfont(5); colInk(1); xat(26, 688);
  mdS = floor(PF(PF_MODE, selPad) + 0.5);
  gfx_printf("PAD %02d  ", selPad + 1);
  M_SLI[(selPad*2)*10+SF] == 1 ? ( nameFill(selPad*2); gfx_drawstr(#nmstr); )
                              : ( gfx_drawstr(defaultPadName(selPad)); );
  gfx_printf("  |  KIT NOTE ");
  noteStr(floor(PF(PF_NOTE, selPad) + 0.5)); gfx_drawstr(#vstr);
  gfx_printf("  |  %s  |  ARP OCT %d", mdS == 0 ? "KIT MODE (CH 1)" : "MULTITRACK",
            floor(PF(ARP_OCT, selPad) + 0.5));
);

tabSel == 7 ? (
  // --- SYSTEM: Interpolation, Transpose, Polyphonie, Banks, Undo
  gfx_setfont(3); colAcid(1); xstr(26, 598, "SYSTEM");
  gfx_setfont(4); colInk(1);
  xat(26, 616); gfx_printf("SAMPLE RATE     %d Hz", floor(srate));
  xat(26, 632); gfx_printf("VOICES ACTIVE   %02d / %02d", vOn, floor(polyMax));
  xat(26, 648); gfx_printf("OUTPUTS         1 x STEREO (JSFX) - PHALANX: 16 x STEREO");
  xat(26, 664); gfx_printf("MIDI LEARN      VIA REAPER (AUTOMATION SLIDERS 1-63)");
  xat(26, 680); gfx_printf("BANKS           PARAMETER + FX, 8 SLOTS EACH - SAMPLES COME FROM THE KIT");
  // Interpolation (Anti-Alias) + Undo
  gfx_setfont(2);
  btn(470, 612, 96, 16, M_SYS[SYS_AA] > 0.5, M_SYS[SYS_AA] > 0.5 ? "AA (HERMITE)" : "LINEAR") ? (
    M_SYS[SYS_AA] = M_SYS[SYS_AA] > 0.5 ? 0 : 1;
    slider54 = M_SYS[SYS_AA]; M_LSL[54] = slider54; slider_automate(slider54);
  );
  btn(572, 612, 46, 16, 0, "SNAP") ? ( undoSnap(selPad); );
  btn(622, 612, 46, 16, undoPad >= 0, "UNDO") ? ( undoRest(); );
  gfx_setfont(5); colDim(1); xstr(470, 632, "SAMPLE INTERPOLATION (AA = CLEANER, MORE CPU) - SNAP/UNDO PER PAD");
  // Incoming Transpose
  nv = floor(knob(108, 740, 618, 13, M_SYS[SYS_TRANS], -24, 24) + 0.5);
  nv != M_SYS[SYS_TRANS] ? (
    M_SYS[SYS_TRANS] = nv; slider55 = nv; M_LSL[55] = nv; slider_automate(slider55);
  );
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "%+d st", floor(M_SYS[SYS_TRANS] + 0.5)); drawCentered(740, 634);
  gfx_setfont(5); colInk(1); xctr(716, 648, 96, 10, "IN TRANSPOSE");
  // Polyphonie
  nv = floor(knob(31, 860, 618, 16, polyMax, 4, 64) + 0.5);
  nv != polyMax ? ( polyMax = nv; );
  gfx_setfont(4); colAcid(1);
  sprintf(#vstr, "%d", floor(polyMax)); drawCentered(860, 638);
  gfx_setfont(5); colInk(1); xctr(836, 652, 96, 10, "POLYPHONY");
  // Bank-Slots: B = laden (Speichern ueber das Lua-Skript)
  bkx = 470; bkn = 1;
  loop(8,
    gfx_setfont(5);
    sprintf(#vstr, "B%d", bkn);
    btn(bkx, 668, 29, 15, 0, #vstr) ? ( bankLoad(bkn); );
    bkx += 33; bkn += 1;
  );
  gfx_setfont(5);
  bankOk == 2 ? ( colAcid(1); xat(470, 686); gfx_drawstr("BANK LOADED"); )
  : bankOk == 3 ? ( colDim(1); xat(470, 686); gfx_drawstr("BANK EMPTY OR WRONG VERSION"); )
  : ( colDim(1); xat(470, 686); gfx_drawstr("B1-B8 = LOAD - SAVE VIA LUA 'SAVE BANK'"); );
  gfx_setfont(2);
  snv = floor(M_SYS[SYS_SYNC] + 0.5);
  btn(740, 668, 96, 16, snv > 0, snv == 0 ? "SYNC: OFF" : snv == 1 ? "SYNC: DELAY"
    : snv == 2 ? "SYNC: ARP" : "SYNC: DLY+ARP") ? (
    M_SYS[SYS_SYNC] = (snv + 1)%4;
    slider63 = M_SYS[SYS_SYNC]; M_LSL[63] = slider63; slider_automate(slider63);
  );
  gfx_setfont(5); colDim(1); xstr(740, 686, "TEMPO SYNC DELAY TIME / ARP RATE");
);

/* ---------- Statuszeile: Event-Log + Scope ---------- */
gfx_set(0.042, 0.048, 0.042, 1); xrect(14, 706, 600, 30);
gfx_setfont(5);
evDspN >= 0 ? (
  evDspOn ? ( colAcid(1); ) : ( colInk(1); );
  xat(22, 714);
  noteStr(evDspN);
  evDspOn ? gfx_printf("NOTE ON  %s  VEL %03d  ->  PAD %02d  (#%d)", #vstr, evDspV, evDspP + 1, evDspCnt)
          : gfx_printf("NOTE OFF %s  (#%d)", #vstr, evDspCnt);
) : ( colInk(1); xat(22, 714); gfx_drawstr("MIDI: NO EVENTS"); );

// MIDI-Monitor — Pitchbend/CC-Readout + Hit-Velocity je Pad
colDim(1); xat(300, 714);
sprintf(#vstr, "PB %+.2f  CC %d:%d", pbS*max2(1, PF(PBR, selPad)), ccN, ccV);
gfx_drawstr(#vstr);
mi = 0;
loop(16,
  gfx_set(0.11, 0.13, 0.11, 1); xrect(448 + mi*9.5, 710, 7, 22);
  M_MON[mi] > 0.03 ? ( colAcid(0.9); xrect(448 + mi*9.5, 732 - M_MON[mi]*22, 7, M_MON[mi]*22); );
  M_MON[mi] *= 0.93;
  mi += 1;
);

// Scope
gfx_set(0.042, 0.048, 0.042, 1); xrect(622, 706, 384, 30);
gfx_set(0.10, 0.13, 0.08, 1); xline(624, 721, 1004, 721);
colAcid(1);
gi = 0;
loop(256,
  sxp = OX + (624 + 380*gi/255)*SC;
  sv = M_SCOPE[(scopePos + gi*2) % 512];
  syp = OY + (721 - max2(-1.1, min2(1.1, sv))*13)*SC;
  gi == 0 ? ( gfx_x = sxp; gfx_y = syp; ) : ( gfx_lineto(sxp, syp, 1); );
  gi += 1;
);

lmbPrev = uiLmb;
rmbPrev = mouse_cap & 2;
mouse_wheel = 0;

// ---------- Notbremse: zu kleine GFX-Flaeche ----------
gfx_h < 330 ? (
  gfx_set(0.050, 0.054, 0.050, 0.94);
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_setfont(2);
  colAcid(1);
  gfx_x = 14; gfx_y = gfx_h*0.5 - 34;
  gfx_drawstr("TT-PHALYX: AREA TOO SMALL FOR THE FRONT PANEL");
  gfx_set(0.75, 0.81, 0.75, 1);
  gfx_x = 14; gfx_y = gfx_h*0.5 - 10;
  gfx_drawstr("PLEASE ENLARGE THE FX WINDOW");
  gfx_x = 14; gfx_y = gfx_h*0.5 + 14;
  gfx_drawstr("SAMPLES: LOAD A KIT VIA 'TT-PHALYX LOAD KIT.LUA' (FROM A WAV FOLDER)");
);
