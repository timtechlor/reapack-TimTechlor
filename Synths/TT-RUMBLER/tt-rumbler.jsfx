    (click && tth_inbox(bx1, ry, 20*sc, 16*sc)) ? ( tth_f1sz = max(-4, tth_f1sz - 1); );
    tth_hint(bx1,ry,20*sc,16*sc,"Decrease title font size; range -4 to +8 steps.");
    gfx_set(0.92, 0.95, 0.92, 1);
