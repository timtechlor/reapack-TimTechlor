  par[PM_FLC ] = 243;   // LC ~35 Hz
  par[PM_FHC ] = 452;   // HC ~200 Hz
  par[PM_FCHR] = 2;   // CUT DIRTY
  par[PM_FDRV] = 450;   // DRIVE 45 %
  par[PM_MRMB] = 800;   // 80 %
);

// 20 OFFBEAT SUB [PITCH/TIGHT] - PITCH -12 st, TIGHT, START 70: Kick frei, Sub antwortet: ATT 60, HLD 70, REL 150 ms
function pstOffbeatSub() (
  writeDefaults();   // INIT-Basis, dann nur die Deltas
  par[PM_ESTA] = 70.000000000000; // ms
  par[PM_EATT] = 60.000000000000; // ms
  par[PM_EHLD] = 70.000000000000; // ms
  par[PM_EREL] = 150.000000000000; // ms
  par[PM_ENG ] = 2;   // PITCH
  par[PM_CHR ] = 0;   // TIGHT
  par[PM_PSEM] = 500;   // PITCH -12.0 st
  par[PM_FLC ] = 176;   // LC ~30 Hz
  par[PM_FHC ] = 309;   // HC ~110 Hz
  par[PM_MRMB] = 850;   // 85 %
);

// 21 TONAL 41    [PITCH/DEEP] - PITCH -24 st, DEEP + COMB, tonaler Sub: ATT 100, HLD 120, REL 240 ms
function pstTonal41() (
  writeDefaults();   // INIT-Basis, dann nur die Deltas
  par[PM_ESTA] = 15.000000000000; // ms
  par[PM_EATT] = 100.000000000000; // ms
  par[PM_EHLD] = 120.000000000000; // ms
  par[PM_EREL] = 240.000000000000; // ms
  par[PM_ENG ] = 2;   // PITCH
  par[PM_CHR ] = 1;   // DEEP
  par[PM_PSEM] = 1000;   // PITCH -24.0 st
  par[PM_FLC ] = 97;   // LC ~25 Hz
  par[PM_FHC ] = 262;   // HC ~90 Hz
  par[PM_FCHR] = 1;   // CUT COMB
  par[PM_MRMB] = 900;   // 90 %
);

// 26.10.2026 (1.1.0): Techno-Bass-Hoerprobe freigegeben, angehaengt (Quelle tt-rumbler_lab.py, QA gruen)
// 22 FAST 148    [VERB/MODAL] - MODAL, T60 2 s, HC 120, fuer 148 BPM: START 8, ATT 45, HLD 60, REL 120 ms
function pstFast148() (
  writeDefaults();   // INIT-Basis, dann nur die Deltas
  par[PM_ENG ] = 0;   // VERB
  par[PM_CHR ] = 0;   // MODAL
  par[PM_VDEC] = 624;   // T60 ~2.00 s
  par[PM_VFOC] = 176;   // FOCUS ~60 Hz
  par[PM_VDEN] = 700;   // DENSE 70 %
  par[PM_ESTA] = 8.000000000000;   // 8.0 ms
  par[PM_EATT] = 45.000000000000;   // 45.0 ms
  par[PM_EHLD] = 60.000000000000;   // 60.0 ms
  par[PM_EREL] = 120.000000000000;   // 120.0 ms
  par[PM_FLC ] = 176;   // LC ~30 Hz
  par[PM_FHC ] = 330;   // HC ~120 Hz
  par[PM_MRMB] = 900;   // 90 %
);

// p = Preset-Index (0 INIT, 1..21 Werks-Presets, 1.0.0). Laufzeit-Einstellungen
// der Front (TIPS/PAGE) ueberleben den Patchwechsel - PLAN S.10.
// P25 (A12): writeDefaults/pst*() schreiben nur noch die 28 Klangworte - Farbe, TIPS/PAGE und die Mute-Schalter
// werden nicht mehr beruehrt, das Sichern/Zurueckschreiben entfaellt.
function applyPatch(p) (
  p == 0 ? writeDefaults()
  : p == 1 ? pstRolling()
  : p == 2 ? pstHypnosis()
  : p == 3 ? pstTightPulse()
  : p == 4 ? pstOffbeat()
  : p == 5 ? pstIndustrial()
  : p == 6 ? pstRaw135()
  : p == 7 ? pstPeakTime()
  : p == 8 ? pstSubCloud()
  : p == 9 ? pstBoomE1()
  : p == 10 ? pstNoiseBed()
  : p == 11 ? pstGritMid()
  : p == 12 ? pstCombMetal()
  : p == 13 ? pstHypnoNoise()
  : p == 14 ? pstTriplet()
  : p == 15 ? pstDirtySub()
  : p == 16 ? pstSubOctave()
  : p == 17 ? pstDeepSea()
  : p == 18 ? pstFifthDown()
  : p == 19 ? pstHardDrop()
  : p == 20 ? pstOffbeatSub()
  : p == 21 ? pstTonal41()
  : pstFast148();   // letzter = Fallback wie bei Kick
  // Review 30.10.2026 (3): Werks-Presets ersetzen alle Zeiten durch ms; Chunk-Migration verwerfen.
  rmbTimeMigrate = 0;
  validateState();
  par[PG_PSET] = min2(PSET_N, max2(0, floor(p + 0.5)));
  undPset = 1;               // Preset-Apply -> Commit setzt kein '*'
  psetMod = 0;
);

// Kurzname des Presets (PSET-Stepper/Anzeige; <= 11 Zeichen, Uppercase).
function psetName(p) (
  p == 0 ? sprintf(#pstr, "INIT")
  : p == 1 ? sprintf(#pstr, "ROLLING")
  : p == 2 ? sprintf(#pstr, "HYPNOSIS")
  : p == 3 ? sprintf(#pstr, "TIGHT PULSE")
  : p == 4 ? sprintf(#pstr, "OFFBEAT")
  : p == 5 ? sprintf(#pstr, "INDUSTRIAL")
  : p == 6 ? sprintf(#pstr, "RAW 135")
  : p == 7 ? sprintf(#pstr, "PEAK TIME")
  : p == 8 ? sprintf(#pstr, "SUB CLOUD")
  : p == 9 ? sprintf(#pstr, "BOOM E1")
  : p == 10 ? sprintf(#pstr, "NOISE BED")
  : p == 11 ? sprintf(#pstr, "GRIT MID")
  : p == 12 ? sprintf(#pstr, "COMB METAL")
  : p == 13 ? sprintf(#pstr, "HYPNO NOISE")
  : p == 14 ? sprintf(#pstr, "TRIPLET")
  : p == 15 ? sprintf(#pstr, "DIRTY SUB")
  : p == 16 ? sprintf(#pstr, "SUB OCTAVE")
  : p == 17 ? sprintf(#pstr, "DEEP SEA")
  : p == 18 ? sprintf(#pstr, "FIFTH DOWN")
  : p == 19 ? sprintf(#pstr, "HARD DROP")
  : p == 20 ? sprintf(#pstr, "OFFBEAT SUB")
  : p == 21 ? sprintf(#pstr, "TONAL 41")
  : sprintf(#pstr, "FAST 148");   // letzter = Fallback
);

// ----------------------------------------------------------------------
// P17: Preset-Leiste (Modul tt_pb_*) - Zustand, Capture/Apply/Summe
// Anwender-Preset = die 28 klangrelevanten Parameter par[0..27] (PM_ENG..PM_TSRC),
// exakt das, was auch die Werks-Presets setzen. NICHT: PM_KON/PM_RON (Mute),
// PG_PSET/PG_TIPS/PG_PAGE (Front), PG_COLOR (Farbe). buf[0] = Layoutversion 1,
// buf[1..28] = par[0..27], Rest Reserve (PBK_PSW = 32 Worte, darf nur wachsen).
// Anwenden im @gfx-Thread wie beim alten Stepper (applyPatch lief dort auch).
// ----------------------------------------------------------------------
PBK_NF   = PSET_N + 1;  // Werks-Eintraege: 0 = INIT, 1..PSET_N = Kuren (= applyPatch-Index); fix Review Runde 6: vorher fest 25 -> Phantom-Eintraege nach der 1.0.0er-Bank
PBK_PSW  = 32;       // Worte je Anwender-Preset
PBK_BANK = 110000;   // Bank ab hier (M_TOP + 106496 = 108544 = Ende der Puffer)
PBK_N    = 28;       // Zahl der Parameter im Preset-Zustand

function rmbPbCapture() local(i) (
  memset(tt_pb_buf, 0, PBK_PSW);
  tt_pb_buf[0] = 2; // Millisekunden
  i = 0; loop(PBK_N, tt_pb_buf[1 + i] = par[i]; i += 1; );
);

function rmbPbApply() local(i) (
  i = 0; loop(PBK_N, par[i] = tt_pb_buf[1 + i]; i += 1; );
  tt_pb_buf[0] == 1 ? rmbLegacyTimes(M_PAR, g_bpm);
  // Review 30.10.2026 (3): Layout 1 ist hier bereits umgerechnet, Layout 2 liefert direkt ms.
  rmbTimeMigrate = 0;
  validateState();          // klemmt alles in gueltige Grenzen (auch Fremd-/Altdaten)
  undPset = 1;              // Preset-Apply -> kein Undo-Stern
);

// Anwender-Slot laden (mit Undo-Klammer: die Maus ist waehrend der Leiste maskiert,
// die Klick-Klammer des @gfx sieht den Klick deshalb nicht)
function rmbPbLoad(slot) (
  tt_pb_fetch(slot) > 0 && (tt_pb_buf[0] == 1 || tt_pb_buf[0] == 2) ? (
    undoMark(); rmbPbApply(); undoCommit();
  );
);

function rmbPbFactory(p) (
  undoMark(); applyPatch(p); undoCommit();
);

function rmbPbNames() local(i) (
  i = 0; loop(PBK_NF, psetName(i); tt_pb_fname(i, #pstr); i += 1; );
);

// Pruefsumme des Preset-Zustands (Stern in der Leiste)
function rmbPbSum() local(i, s) (
  s = 0; i = 0;
  loop(PBK_N, s += (par[i] + 2000)*(i*3 + 1); i += 1; );
  s;
);

// ----------------------------------------------------------------------
// Engine-Reset: dynamische Puffer + EC-Laufzustand sauber, Undo-Kopf
// (EC_UNW/EC_UNN ab 62) bleibt stehen - @init + srate-Deckung.
// ----------------------------------------------------------------------
function engReset() local(ag) (
  // QA-FIX v0.1.0 (M5-F9): gelernten AutoGain ueber Transport-/srate-
  // Resets behalten - sonst startet AGV nach jedem Play bei 1.0 und die
  // ersten Beats peaken im Extremfall +3.8..+5.6 dBFS vor dem Clipper.
  ag = eng[EC_AGV];
  memset(vb, 0, 65536);
  memset(ap, 0, 4096);
  memset(pb, 0, 32768);
  memset(cb, 0, 4096);
  memset(eng, 0, 62);        // EC 0..61; Undo-Kopf 62/63 ueberlebt
  eng[EC_LTT]  = -1000000000;
  eng[EC_CLPL] = -1000000000;
  eng[EC_PTD]  = -1;
  eng[EC_ARM]  = 1;
  eng[EC_NSE]  = 22222;      // LCG-Seed ungleich 0 (Park-Miller: 0 = Fixpunkt)
  eng[EC_AGV]  = ag > 0.0001 ? ag : 1;   // AutoGain: gelernt halten
  eng[EC_SECT] = ESC_IDL;
  glo_engSel   = -1;         // Engine-Eintritt im naechsten @block
  glo_vkCh     = -1;         // SPEC-DEVIATION: Kern-verbCoeff prueft nur
                           // Parameter - ein srate-Wechsel wuerde die
                           // Comb-Laengen stale lassen -> Snap erzwingen.
  rmbBridgeReady = 0; rmbBridgePending = 0;
  rmbBridgePos = rmbBridgeLen; rmbBridgeOff = 0; rmbBridgePrev = 0;
  rmbDrvLast = -1; rmbDrvTrim = 1;
);

// ----------------------------------------------------------------------
// Front-Bausteine (P21, Designraster 900 x 700): das gemeinsame Kit
// _shared/tt-uikit.jsfx-inc (oben eingespleist) liefert xrect/xline/xcirc/xat/xstr/xctr/inBox, colAcid/colDim/colWhite/colInk,
// pad/trace/panelBox/led, btn sowie die v2-Widgets (knob2, hslider, combo, toggle, panel2, meterH/V, tt_tip, ...).
// Ferner entfallen mit der Front: das Zellen-Knob-System kbArc/knob/
// kbTxtDraw/kbTipCell/kbHzTxt (45x44-Zellen, Drag-Anker kbY0/kbN0/kbMv/
// kbFine ueber kbDrag) und der Vertikalfader vFade samt Hotbox-Helfer
// tipF (Anker fdY0/fdV0/fdFine). Bedienkonventionen blieben identisch:
// CTRL+Klick = ctlDef-Reset, SHIFT = Fine, Mausrad, Rechtsklick/
// Doppelklick = Default (in knob2/hslider eingebaut); die Promille-
// Quantisierung macht mPm() an jedem Regler.
// Produkt-eigen geblieben: colWarn (Zweitfarbe, CLIP-LED), die Tooltip-
// Kette tip/tipAt/tipLn/tipDraw (TIPS-Toggle, P15-Mustertexte) sowie
// mPm/lenName/chrName/envV (unten).
// ----------------------------------------------------------------------
// Warnfarbe = Zweitfarbe des Schemas (P14), fuer die CLIP-LED
function colWarn(a) ( gfx_set(tth_alR, tth_alG, tth_alB, a); );

// ----------------------------------------------------------------------
// Tooltips: tip(t) merkt pro Frame den Hover-Text in #tTipTxt (leer =
// kein Hover; @gfx loescht ihn am Frameanfang), tipDraw() zeichnet das
// schwebende Panel am Ende von @gfx. "|" = neue Zeile (max. 4), Zeilen
// mit "CTRL" am Anfang in Acid. Waehrend eines Drags wird nichts gesetzt.
// Das Kit regelt Drags allein ueber dragId.
// ----------------------------------------------------------------------
function tip(t) ( dragId < 0 && !tth_tipoff ? strcpy(#tTipTxt, t); );   // P23: bei OPTIONS > TOOLTIPS OFF kein Text
function tipAt(x, y, w, h, t) ( inBox(x, y, w, h) ? tip(t); );

// P25 (Punkt 3): EIN Tooltip-Schalter - OPTIONS > TOOLTIPS (tth_tipoff, Theme-Modul, Stil-Block des Preset-Moduls: 1 = aus).
// Das Blob-Wort par[PG_TIPS] (1 = an) bleibt im Format und wird nur noch in @serialize gepflegt (Schreiben aus tth_tipoff, Lesen bildet es ab).

function tipLn(s, x, y) (
  str_getchar(s, 0) == 67 && str_getchar(s, 1) == 84 ? colAcid(0.8) : colInk(1);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(s);
);

// Schwebendes Panel nahe der Maus (+16 px), ins Fenster geclampt; passt
// es unten nicht mehr hin, klappt es ueber den Zeiger. Bildschirmpixel,
// nicht Designraster - die Schrift (Font 3) skaliert selbst mit SC.
function tipDraw() local(n, i, st, nl, tw, th, w, lh, bw, bh, px, py, pad) (
  tth_tipoff ? 0 : (     // P23: OPTIONS > TOOLTIPS OFF - nichts zeichnen
  n = strlen(#tTipTxt);
  nl = 0; st = 0; i = 0;
  loop(n + 1,
    i >= n || str_getchar(#tTipTxt, i) == 124 ? (
      // P25 (A8): vier Zeilen statt drei - ENGINE, Huellkurven-Display und CUT TYPE verloren ihre vierte
      nl < 4 ? (
        nl == 0 ? strcpy_substr(#tipL0, #tTipTxt, st, i - st)
        : nl == 1 ? strcpy_substr(#tipL1, #tTipTxt, st, i - st)
        : nl == 2 ? strcpy_substr(#tipL2, #tTipTxt, st, i - st)
        : strcpy_substr(#tipL3, #tTipTxt, st, i - st);
        nl += 1;
      );
      st = i + 1;
    );
    i += 1;
  );
  gfx_setfont(3);
  gfx_measurestr(#tipL0, tw, th); w = tw; lh = th;
  nl > 1 ? ( gfx_measurestr(#tipL1, tw, th); w = max2(w, tw); ) : 0;
  nl > 2 ? ( gfx_measurestr(#tipL2, tw, th); w = max2(w, tw); ) : 0;
  nl > 3 ? ( gfx_measurestr(#tipL3, tw, th); w = max2(w, tw); ) : 0;   // P25 (A8)
  pad = max2(4, 5*SC);
  bw = w + 2*pad;
  bh = nl*lh + 2*pad;
  px = tt_pb_rmx + 16;     // P23: rohe Maus (mouse_x ist ueber Kopfzeilen-Modulen maskiert)
  py = tt_pb_rmy + 16;
  px + bw > gfx_w - 2 ? ( px = gfx_w - 2 - bw; );
  px < 2 ? ( px = 2; );
  py + bh > gfx_h - 2 ? ( py = tt_pb_rmy - bh - 8; );
  py < 2 ? ( py = 2; );
  tth_tn(0.030, 0.035, 0.030, 0.97);
  gfx_rect(px, py, bw, bh, 1);
  colAcid(0.9);
  gfx_rect(px, py, bw, 1, 1);      gfx_rect(px, py + bh - 1, bw, 1, 1);
  gfx_rect(px, py, 1, bh, 1);      gfx_rect(px + bw - 1, py, 1, bh, 1);
  tipLn(#tipL0, px + pad, py + pad);
  nl > 1 ? tipLn(#tipL1, px + pad, py + pad + lh) : 0;
  nl > 2 ? tipLn(#tipL2, px + pad, py + pad + 2*lh) : 0;
  nl > 3 ? tipLn(#tipL3, px + pad, py + pad + 3*lh) : 0;   // P25 (A8)
  );
);

// Promille-Schreibwert eines Regler-Ergebnisses (Kick-Lektion):
// unveraendert heisst Toleranz 0.001 Promille -> cur bleibt bitgenau;
// sonst exakte Ganzzahl (kein Rundungsmuell Frame fuer Frame).
function mPm(nv, cur) (
  abs(nv*1000 - cur) > 0.001 ? floor(nv*1000 + 0.5) : cur;
);


// ----------------------------------------------------------------------
// RUMBLE-spezifische UI-Helfer (M3)
// ----------------------------------------------------------------------
// LENGTH-Name (Tabelle PLAN S.4, Reihenfolge frozen)
// v0.7.0: Scope-Spalte schreiben (ein Aufruf je Sample). ph = Position im Takt 0..1 -> Spalte; je Spalte min/max der drei Spuren
// und der Gate-Wert. Beim Betreten einer Spalte wird sie neu begonnen (der Cursor ueberschreibt die alte Spur).
// 0.9.3: Verzoegerte Zeile lesen (linear, d <= 8190 Samples). d = 0 liefert das eben geschriebene Sample bitgleich.
function rmbPdcRd(base, d) local(p, i0, i1, fr) (
  p = rmbPdcW - d;
  p < 0 ? p += PDCN;
  // 0.9.3: knapp unter 0 rundet p += PDCN auf exakt PDCN (Index 16384 = ein Wort hinter dem Ring) -> erneut wickeln (PDCN = 16384, wie beim Pitch-Tap).
  p >= PDCN ? p -= PDCN;
  i0 = floor(p); fr = p - i0;
  i1 = i0 + 1; i1 >= PDCN ? i1 = 0;
  base[i0] + fr*(base[i1] - base[i0]);
);

function rmbScopeTick(kv, rv, sv) local(ph, ci, p) (
  // 0.9.3: die Signale sind um rmbDk verzoegert, die Spalte gehoert zur Zeit der ankommenden Kick (Takt-Raster stimmt wieder).
  ph = (scBeat - rmbDk*scInc)*scInvB;
  ph -= floor(ph);
  ci = min2(SCN - 1, floor(ph*SCN));
  p = M_SCQ + ci*8;
  ci != scCi ? (
    scCi = ci;
    p[0] = kv; p[1] = kv; p[2] = rv; p[3] = rv; p[4] = sv; p[5] = sv;
  ) : (
    kv < p[0] ? p[0] = kv;
    kv > p[1] ? p[1] = kv;
    rv < p[2] ? p[2] = rv;
    rv > p[3] ? p[3] = rv;
    sv < p[4] ? p[4] = sv;
    sv > p[5] ? p[5] = sv;
  );
  p[6] = rmbGtD;
  scBeat += scInc;
);

// Eigener Zeit-Wrapper: UI-Kit unveraendert; feine Aufloesung auch nahe 0 ms.
function rmbTimeKnob(id, cx, cy, val, def) local(nv, pos, hot) (
  nv = val;
  hot = (mX - cx)*(mX - cx) + (mY - cy)*(mY - cy) <= 400;
  hot && mouse_wheel != 0 ? (
    nv = min2(24000, max2(0, floor((val + mouse_wheel/120*((mouse_cap & 8) ? 0.1 : 1))*10 + 0.5)*0.1));
    mouse_wheel = 0;
  );
  pos = log(1 + nv/10)/log(2401);
  rmbTimePos = knob2(id, cx, cy, 13, pos, 0, 1, log(1 + def/10)/log(2401));
  rmbTimePos != pos ? nv = floor(10*(10*(exp(rmbTimePos*log(2401)) - 1)) + 0.5)*0.1;
  min2(24000, max2(0, nv));
);

function lenName(nd) (
  nd == 0 ? strcpy(#lstr, "1/1")
  : nd == 1 ? strcpy(#lstr, "1/2")
  : nd == 2 ? strcpy(#lstr, "1/4")
  : nd == 3 ? strcpy(#lstr, "1/4T")
  : nd == 4 ? strcpy(#lstr, "1/8")
  : nd == 5 ? strcpy(#lstr, "1/8T")
  : strcpy(#lstr, "1/16");
);

// CHARACTER-Label je Engine -> #cstr (PLAN S.6)
function chrName(e, c) (
  e == 0 ? ( c == 0 ? strcpy(#cstr, "MODAL")
           : c == 1 ? strcpy(#cstr, "WALL")
           : strcpy(#cstr, "BLOOM"); )
  : e == 1 ? ( c == 0 ? strcpy(#cstr, "CLASSIC")
             : c == 1 ? strcpy(#cstr, "GRIT")
             : strcpy(#cstr, "RUBBLE"); )
  : ( c == 0 ? strcpy(#cstr, "TIGHT")
    : c == 1 ? strcpy(#cstr, "DEEP")
    : strcpy(#cstr, "GRAIN"); );
);

// Idealisierte Env-Kurve fuer das Display: fp = Anteil in Promille,
// s1..s4 = die bereits proportional skalierten Sektions-Anteile
// (Summe > 1000 ist vorher gestaucht), ep = CURVE-Exponent.
// Gleiche Formel wie envTick (A3) - aber reine Anzeige, kein Zustand.
function envV(fp, s1, s2, s3, s4, ep) (
  fp < s1 ? 0
  : fp < s1 + s2 ? pow(min2(1, max2(0, (fp - s1)/max2(s2, 0.001))), ep)
  : fp < s1 + s2 + s3 ? 1
  : fp < s1 + s2 + s3 + s4
    ? pow(max2(1 - (fp - s1 - s2 - s3)/max2(s4, 0.001), 0), ep)
  : 0;
);

// ----------------------------------------------------------------------
// P26 (Nacharbeit "Ueberlappungen bei grossen Schriftstufen", Nutzerfreigabe 02.10.2026): OPTIONS > FONT SIZE
// vergroessert Slot 1 (Titel) und die Slots 2..5 bis +8 (~1,85x). Die Front hat feste Plaetze (Designraster
// 900 x 700); nachgerechnet (p26_orakel.py FONT, Consolas-/Zilap-Metrik) liefen ab FONT 2 +3 Infozeilen ueber
// den Panelrand, Beschriftungen ueber Combos/Leisten darunter in diese hinein, der Fusstext in die
// Versionsangabe, Schalterbeschriftungen ueber ihre LED, und ab FONT 1 +4 die Wortmarke in den Untertitel.
// Loesung im Produkt (Module unberuehrt): diese Texte bekommen ihren Platz als Hoechstmass mw x mh
// (Designraster; mh = Zeilenhoehe laut gfx_measurestr). Passt der Text in der gewaehlten Stufe, zeichnet die
// Front wie bisher in Slot 5 - Bild und Farben unveraendert. Sonst zeichnet sie ihn eine oder mehrere 8-%-
// Stufen kleiner (dasselbe Raster wie die OPTIONS-Stufen) in derselben Mono-Schrift aus einem Pool freier
// Slots 6, 7, 8, 12, 13, 14 (belegt: Kit 1..5 und 9, OPTIONS-Box 10, Preset-Leiste 11, Theme 16; Slot 15 =
// Wortmarke). gfx_setfont mit Namen erzeugt die Schrift neu - der Pool legt jede Groesse einmal an.
// Nicht im Produkt loesbar (Modul tt-uikit): panel2-Titel kreuzen ab FONT 2 +6 ihre Akzentlinie (y + 20).
// ----------------------------------------------------------------------
function rmbMonoSet(sl, sz) (
  monoSel == 0 ? gfx_setfont(sl, "Consolas", sz)
  : monoSel == 1 ? gfx_setfont(sl, "DejaVu Sans Mono", sz)
  : monoSel == 2 ? gfx_setfont(sl, "Menlo", sz)
  : gfx_setfont(sl, "Courier New", sz);
);

// Slot mit der Mono-Schrift in Groesse sz (Pixel); fehlt die Groesse, reihum einen Pool-Slot neu belegen.
function rmbPool(sz) local(s) (
  s = rmbP6 == sz ? 6 : (rmbP7 == sz ? 7 : (rmbP8 == sz ? 8
    : (rmbP12 == sz ? 12 : (rmbP13 == sz ? 13 : (rmbP14 == sz ? 14 : 0)))));
  s == 0 ? (
    rmbPn = (rmbPn + 1) % 6;
    s = rmbPn < 3 ? 6 + rmbPn : 9 + rmbPn;      // 0..2 -> 6..8, 3..5 -> 12..14
    s == 6 ? ( rmbP6 = sz; ) : s == 7 ? ( rmbP7 = sz; ) : s == 8 ? ( rmbP8 = sz; )
    : s == 12 ? ( rmbP12 = sz; ) : s == 13 ? ( rmbP13 = sz; ) : ( rmbP14 = sz; );
    rmbMonoSet(s, sz);
  );
  s;
);

// Schrift fuer s im Platz mw x mh (Designraster) waehlen und setzen. Rueckgabe: Slot (5 = passt wie gewaehlt).
// Erste Stufe aus dem Messwert geschaetzt (Mono: Breite ~ Groesse), dann gemessen, notfalls eine Stufe weiter.
// Untergrenze 9 px wie die Kit-Klemme von Slot 5 (fSml >= 9): bei sehr kleiner UI SIZE steht die Schrift schon
// auf 9 px - dort bleibt alles wie bisher (keine unlesbar kleine Ersatzschrift).
function rmbFit(s, mw, mh) local(tw, th, sl, i, sz, ok) (
  gfx_setfont(5); sl = 5;
  gfx_measurestr(s, tw, th);
  (tw > mw*SC || th > mh*SC) && fSml > 9 ? (
    i = max(1, ceil(log(max(tw/max(1, mw*SC), th/max(1, mh*SC)))/log(1.08) - 0.000001));
    ok = 0;
    loop(6,
      ok == 0 ? (
        sz = max(9, floor(fSml/(1.08^i)));
        sl = rmbPool(sz); gfx_setfont(sl);
        gfx_measurestr(s, tw, th);
        ((tw <= mw*SC && th <= mh*SC) || sz <= 9) ? ( ok = 1; ) : ( i += 1; );
      );
    );
  );
  sl;
);

// Textfarbe wie uk_txt(): die eigene FONT-2-Farbe der OPTIONS gilt auch fuer Pool-Slots (tth_txt kennt nur 1..5).
function rmbTxt(sl) (
  sl == 5 ? uk_txt() : ( tth_f2on ? gfx_set(tth_f2R, tth_f2G, tth_f2B, gfx_a); );
);

// wie xstr / xctr (Kit), mit Hoechstmass; danach ist wieder Slot 5 gewaehlt.
function xstrF(x, y, mw, mh, s) local(sl) (
  sl = rmbFit(s, mw, mh);
  xat(x, y); rmbTxt(sl); gfx_drawstr(s);
  gfx_setfont(5);
);
function xctrF(x, y, w, h, mw, mh, s) local(sl, tw, th) (
  sl = rmbFit(s, mw, mh);
  gfx_measurestr(s, tw, th);
  gfx_x = OX + x*SC + (w*SC - tw)*0.5;
  gfx_y = OY + y*SC + (h*SC - th)*0.5;
  rmbTxt(sl); gfx_drawstr(s);
  gfx_setfont(5);
);
// wie xat + gfx_printf (ohne uk_txt - so zeichneten die Messzeilen LVL/THR, ENV LAG, T =, AG bisher)
function xrawF(x, y, mw, mh, s) (
  rmbFit(s, mw, mh);
  xat(x, y); gfx_drawstr(s);
  gfx_setfont(5);
);

// Schalter wie toggle() (Kit). Passt die Beschriftung nicht rechts neben die LED, zeichnet das Produkt sie selbst
// eingepasst (Farben wie im Kit, toggle mit leerem Text). Sonst unveraendert der Kit-Weg.
function rmbTgl(x, y, w, h, on, s) local(sl, hit, hov, tw, th) (
  sl = rmbFit(s, w - h*0.85 - 2, h + 8);
  sl == 5 ? ( hit = toggle(x, y, w, h, on, s); ) : (
    hit = toggle(x, y, w, h, on, "");
    hov = inBox(x, y, w, h);
    on ? colWhite(0.96) : ( hov ? tth_tn(0.85, 0.95, 0.82, 1) : tth_tn(0.72, 0.78, 0.70, 1); );
    gfx_setfont(sl);
    gfx_measurestr(s, tw, th);
    gfx_x = OX + (x + h*0.85)*SC + ((w - h*0.85)*SC - tw)*0.5;
    gfx_y = OY + y*SC + (h*SC - th)*0.5;
    rmbTxt(sl); gfx_drawstr(s);
  );
  gfx_setfont(5);
  hit;
);

// ----------------------------------------------------------------------
// v0.7.0: Dual-Trace-Scope (Variante D). Daten: M_SCQ-Spalten aus rmbScopeTick (@sample). FIXED (scMode 0): die Spalte i steht
// fest an der Taktposition i/SCN, der Cursor (scCi) ueberschreibt die alte Spur; ROLL (scMode 1): Spalten ab scCi+1, links = aelteste.
// Spuren: SUMME grau (duenn), RUMBLE Akzent (breit), KICK weiss (duenn, oben), GATE gepunktet. Alles Designraster ausser den
// Spalten-Schleifen (dort Geraetepixel ueber OX/OY/SC, eine gfx_line je Spalte und Spur).
// ----------------------------------------------------------------------

// Rechteck auf der Takt-Achse: u = Anteil 0..1 ab linkem Rand, wf = Breite als Anteil; laeuft ueber den rechten Rand hinaus um.
// Review 14.10.2026 (Kit 7, Codex F2): wf auf eine Schirmbreite begrenzt. Ein Gate-Band laenger als der Takt (z. B. Taktart 1/4,
// LENGTH 1/1, HOLD 100 %: Lf = 4) zeichnete das zweite Rechteck sonst mehrere Schirmbreiten ueber den rechten Rand hinaus.
function rmbRectU(px, pw, u, wf, y, h) local(e) (
  wf = min(wf, 1);
  u -= floor(u);
  e = u + wf;
  e <= 1 ? xrect(px + u*pw, y, wf*pw, h)
  : ( xrect(px + u*pw, y, (1 - u)*pw, h); xrect(px, y, (e - 1)*pw, h); );
);

// Eine Spur (Min/Max-Spalten): omn/omx = Wortindex im 8er-Block, ex = Verdickung in Pixeln (0 = duenn)
function rmbScopeTr(gx0, gcw, gy0, gamp, ci, c0, omn, omx, ex) local(i, c, d, p, xs, y1, y2) (
  i = 0;
  loop(SCN,
    c = i + c0; c >= SCN ? c -= SCN;
    d = i - ci; d < 0 ? d += SCN;
    (scMode > 0.5 || d == 0 || d > 6) ? (          // FIXED: kleine Luecke vor dem Cursor
      p = M_SCQ + c*8;
      xs = gx0 + (i + 0.5)*gcw;
      y1 = gy0 - min2(1.1, max2(-1.1, p[omx]))*gamp - ex;
      y2 = gy0 - min2(1.1, max2(-1.1, p[omn]))*gamp + ex;
      y2 - y1 < 1 ? y2 = y1 + 1;
      gfx_line(xs, y1, xs, y2, 0);
      ex > 0.5 ? gfx_line(xs + 1, y1, xs + 1, y2, 0);
    ) : 0;
    i += 1;
  );
);

// GATE (Huellkurvenwert 0..1, 1.0 liegt auf der 0-dB-Linie), gepunktet
function rmbScopeGate(gx0, gcw, gy0, gamp, ci, c0) local(i, c, d, p, xs, ys, lx, ly, ok) (
  i = 0; ok = 0; lx = 0; ly = 0;
  loop(SCN,
    c = i + c0; c >= SCN ? c -= SCN;
    d = i - ci; d < 0 ? d += SCN;
    p = M_SCQ + c*8;
    xs = gx0 + (i + 0.5)*gcw;
    ys = gy0 - min2(1, max2(0, p[6]))*gamp;
    ((scMode > 0.5 || d == 0 || d > 6) && ok && (i & 3) != 3) ? gfx_line(lx, ly, xs, ys, 0);
    lx = xs; ly = ys; ok = 1;
    i += 1;
  );
);

function rmbScopeDraw(x0, y0, w, h) local(px, py, pw, ph, mid, amp, ci, off, c0, k, ncy, Lf, f0, a, b2, u, nb, tw, th, ms, tt, xx, ltop) (
  gfx_setfont(5);
  // Schirmglas + Rahmen
  tth_tn(0.020, 0.028, 0.020, 1); xrect(x0, y0, w, h);
  colDim(0.9); xrect(x0, y0, w, 1); xrect(x0, y0 + h - 1, w, 1); xrect(x0, y0, 1, h); xrect(x0 + w - 1, y0, 1, h);
  px = x0 + 34; pw = w - 34 - 12; py = y0 + 22; ph = h - 22 - 24;
  mid = py + ph*0.5; amp = ph*0.46;
  ci  = scCi < 0 ? 0 : scCi;
  off = scMode > 0.5 ? (ci + 1)/SCN : 0;
  c0  = scMode > 0.5 ? ci + 1 : 0;

  // Gate-Fenster der Huellkurve (A..R) ueber jeden Zyklus des Taktes, Grenzen A|H und H|R, Buchstaben bei wenigen Zyklen
  Lf  = emult*scInvB;
  ncy = ceil(scBarB/emult - 0.0001);
  tt = max2(0.001, rmbNoteMs(ndE, g_bpm));
  a = par[PM_ESTA]/tt; b2 = (par[PM_EATT] + par[PM_EHLD] + par[PM_EREL])/tt;
  k = 0;
  loop(ncy,
    f0 = k*Lf - off;
    colAcid(0.075); rmbRectU(px, pw, f0 + a*Lf, b2*Lf, py, ph);
    colDim(0.5);
    rmbRectU(px, pw, f0 + (a + (par[PM_EATT]/tt))*Lf, 0.0006, py, ph);
    rmbRectU(px, pw, f0 + (a + ((par[PM_EATT] + par[PM_EHLD])/tt))*Lf, 0.0006, py, ph);
    ncy <= 8 ? (
      colInk(0.55);
      (par[PM_EATT]/tt)*Lf*pw >= 14 ? ( u = f0 + (a + (par[PM_EATT]*0.5/tt))*Lf; u -= floor(u); xctr(px + u*pw - 10, py + 2, 20, 10, "A"); );
      (par[PM_EHLD]/tt)*Lf*pw >= 14 ? ( u = f0 + (a + ((par[PM_EATT] + par[PM_EHLD]*0.5)/tt))*Lf; u -= floor(u); xctr(px + u*pw - 10, py + 2, 20, 10, "H"); );
      (par[PM_EREL]/tt)*Lf*pw >= 14 ? ( u = f0 + (a + ((par[PM_EATT] + par[PM_EHLD] + par[PM_EREL]*0.5)/tt))*Lf; u -= floor(u); xctr(px + u*pw - 10, py + 2, 20, 10, "R"); );
    ) : 0;
    k += 1;
  );

  // Raster: 0 dB / -6 dB / Mitte, Zaehlzeiten
  colDim(0.28);
  xline(px, mid - amp, px + pw, mid - amp); xline(px, mid + amp, px + pw, mid + amp);
  xline(px, mid - amp*0.5, px + pw, mid - amp*0.5); xline(px, mid + amp*0.5, px + pw, mid + amp*0.5);
  colDim(0.6); xline(px, mid, px + pw, mid);
  nb = ceil(scBarB - 0.0001);
  k = 0;
  loop(nb,
    // 0.9.3: Viertel-Unterteilungen (1/16 bei 4/4) zwischen den vollen Schlaegen, abgeschwaecht
    rmbQj = 1;
    loop(3,
      u = (k + rmbQj*0.25)*scInvB - off; u -= floor(u);
      k + rmbQj*0.25 < scBarB ? ( colDim(0.34); xline(px + u*pw, py, px + u*pw, py + ph); ) : 0;
      rmbQj += 1;
    );
    u = k*scInvB - off; u -= floor(u);
    colDim(k == 0 ? 0.8 : 0.55); xline(px + u*pw, py, px + u*pw, py + ph);
    colInk(0.5); sprintf(#scs, "%d", k + 1); xstr(px + u*pw + 3, py + ph - 11, #scs);
    k += 1;
  );

  // Spuren: SUMME, RUMBLE, KICK (oben); Geraetepixel, eine Linie je Spalte
  scShS > 0.5 ? ( gfx_set(0.62, 0.66, 0.62, 0.75); rmbScopeTr(OX + px*SC, pw*SC/SCN, OY + mid*SC, amp*SC, ci, c0, 4, 5, 0); ) : 0;
  scShR > 0.5 ? ( colAcid(0.95); rmbScopeTr(OX + px*SC, pw*SC/SCN, OY + mid*SC, amp*SC, ci, c0, 2, 3, 1); ) : 0;
  scShK > 0.5 ? ( gfx_set(1, 1, 1, 0.92); rmbScopeTr(OX + px*SC, pw*SC/SCN, OY + mid*SC, amp*SC, ci, c0, 0, 1, 0); ) : 0;
  scShG > 0.5 ? ( colAcid(0.9); rmbScopeGate(OX + px*SC, pw*SC/SCN, OY + mid*SC, amp*SC, ci, c0); ) : 0;

  // Cursor (FIXED) bzw. Rand "jetzt" (ROLL)
  scMode < 0.5 ? ( colWhite(0.55); xx = px + (ci + 0.5)*pw/SCN; xline(xx, py, xx, py + ph); )
  : ( colWhite(0.4); xrect(px + pw - 1, py, 1, ph); );

  // dB-Skala links
  gfx_setfont(5); colInk(0.6);
  xstr(x0 + 8, py - 11, "DB");
  xstr(x0 + 8, mid - amp - 5, "0"); xstr(x0 + 8, mid - amp*0.5 - 5, "-6"); xstr(x0 + 8, mid - 5, "-INF");
  xstr(x0 + 8, mid + amp*0.5 - 5, "-6"); xstr(x0 + 8, mid + amp - 5, "0");
  // Zeitachse unten (ms ab Taktanfang bzw. vor "jetzt")
  ms = scBarB*60000/max2(g_bpm, 1);
  k = 0;
  loop(5,
    tt = scMode > 0.5 ? -ms*(4 - k)/4 : ms*k/4;
    sprintf(#scs, scMode > 0.5 ? (k == 0 ? "%d MS" : "%d") : (k == 4 ? "%d MS" : "%d"), floor(tt + 0.5));
    gfx_measurestr(#scs, tw, th);
    xx = px + pw*k/4 - tw/SC*0.5;
    xx = max2(px, min2(px + pw - tw/SC, xx));
    xstr(xx, py + ph + 6, #scs);
    k += 1;
  );

  // Legende (Linienmuster = Spur, abgeschaltete Spuren gedimmt) und Statuszeile
  scShK > 0.5 ? gfx_set(1, 1, 1, 1) : gfx_set(1, 1, 1, 0.3);
  xline(x0 + 8, y0 + 10, x0 + 24, y0 + 10); xstr(x0 + 30, y0 + 4, "CH1 KICK IN");
  scShR > 0.5 ? colAcid(1) : colAcid(0.3);
  xrect(x0 + 118, y0 + 9, 16, 3); xstr(x0 + 140, y0 + 4, "CH2 RUMBLE");
  scShS > 0.5 ? gfx_set(0.62, 0.66, 0.62, 1) : gfx_set(0.62, 0.66, 0.62, 0.3);
  xline(x0 + 236, y0 + 10, x0 + 252, y0 + 10); xstr(x0 + 258, y0 + 4, "SUM");
  scShG > 0.5 ? colAcid(0.9) : colAcid(0.3);
  xrect(x0 + 300, y0 + 10, 3, 1); xrect(x0 + 306, y0 + 10, 3, 1); xrect(x0 + 312, y0 + 10, 3, 1); xstr(x0 + 322, y0 + 4, "GATE");
  colInk(0.8);
  scMode > 0.5 ? strcpy(#scs, "ROLL // 1 BAR // LEFT = OLDEST")
  : sprintf(#scs, "FIXED // 1 BAR = %d BEATS // %d BPM // %d MS", floor(scBarB + 0.5), floor(g_bpm + 0.5), floor(ms + 0.5));
  gfx_measurestr(#scs, tw, th);
  xstr(x0 + 570 - tw/SC*0.5, y0 + 4, #scs);   // zwischen Legende (bis x0+370) und Status rechts
  lvDb > -60 + 60*par[PM_TTHR]*0.001 ? ( colAcid(1); strcpy(#scs, "ABOVE THR"); ) : ( colInk(0.55); strcpy(#scs, "BELOW THR"); );
  gfx_measurestr(#scs, tw, th);
  xstr(x0 + w - 10 - tw/SC, y0 + 4, #scs);
);

// Wortmarke (Slot 1, FONT 1): passt sie nicht in mw x mh, zeichnet Slot 15 dieselbe Schrift kleiner. Ergebnis je
// Schriftlage gemerkt (rmbWkey), damit Slot 15 nicht jeden Frame neu entsteht.
function rmbWordSet(sz) (
  bigSel ? gfx_setfont(15, "Zilap Orion", sz, 'b')
  : sansSel == 0 ? gfx_setfont(15, "Segoe UI", sz, 'b')
  : sansSel == 1 ? gfx_setfont(15, "Helvetica Neue", sz, 'b')
  : sansSel == 2 ? gfx_setfont(15, "DejaVu Sans", sz, 'b')
  : sansSel == 3 ? gfx_setfont(15, "Liberation Sans", sz, 'b')
  : gfx_setfont(15, "Arial", sz, 'b');
);
function rmbWord(x, y, mw, mh, s) local(tw, th, i, sz, ok, k) (
  k = fBig + 1000*fSml + 1000000*floor(SC*1000 + 0.5);
  k != rmbWkey ? (
    rmbWkey = k; rmbWsl = 1;
    gfx_setfont(1);
    gfx_measurestr(s, tw, th);
    (tw > mw*SC || th > mh*SC) && fBig > 12 ? (     // Untergrenze 12 px wie die Kit-Klemme von Slot 1
      i = max(1, ceil(log(max(tw/max(1, mw*SC), th/max(1, mh*SC)))/log(1.08) - 0.000001));
      ok = 0;
      loop(6,
        ok == 0 ? (
          sz = max(12, floor(fBig/(1.08^i)));
          rmbWordSet(sz); gfx_setfont(15); rmbWsl = 15;
          gfx_measurestr(s, tw, th);
          ((tw <= mw*SC && th <= mh*SC) || sz <= 12) ? ( ok = 1; ) : ( i += 1; );
        );
      );
    );
  );
  gfx_setfont(rmbWsl);
  xat(x, y);
  rmbWsl == 1 ? uk_txt() : ( tth_f1on ? gfx_set(tth_f1R, tth_f1G, tth_f1B, gfx_a); );
  gfx_drawstr(s);
);

// ======================================================================
// Laufzustand: Basiszeiger, Trigger-Hardware, gedaempfte Zustaende.
// Reihenfolge: Defaults/Restore schlagen zu (writeDefaults nutzt par),
// danach Engine-Reset, dann Koeffizienten - sonst laege Muell in par[].
// P26 (Nutzerfreigabe 02.10.2026, Review "Transportstart"): @init laeuft bei JEDEM Transportstart. Bis v0.5.5
// leerte engReset() dabei Hall-/Pitch-/Comb-Puffer, Huellkurve, Follower und LED - ein beim Start noch
// klingender Tail brach ab (Klick moeglich). Jetzt laeuft der Zustand durch wie bei einem Hardware-Geraet:
// den harten Reset (Puffer, g_pos, Slew-Snap, Filter-Erstwerte) gibt es nur beim ersten @init (Laden/
// Kompilieren, rmbIni1 noch 0) und bei einem Samplerate-Wechsel. Kein ext_noinit (der Samplerate-Weg ueber
// @init bleibt). Weich (Transportstart) laufen nur Konstanten/Ziele neu; die Play-Erkennung im @block
// entwaffnet einen anstehenden PITCH-Trigger wie bisher.
// Bekannte Folge: rechnet REAPER das FX im Stopp nicht (Projekteinstellung), steht ein Tail eingefroren
// und klingt beim naechsten Start zu Ende - wie bei jedem Hall-Plugin.
rmbHard = rmbIni1 != 1 || srate != lastSrate;   // 1 = harter Reset (vor lastSrate = srate unten)
rmbInitN += 1; rmbHard ? rmbHardN += 1;          // P26: Zaehler fuer die Testdiagnose (@block, gmem 6000/6001)
rmbHard ? ( g_pos = 0; );   // globaler Sample-Zaehler (Trigger-Debounce, LED, AGT)
smplPos = 0;    // Position im aktuellen Block (MIDI-Queue-Vergleich)
pdc_bot_ch = 0; pdc_top_ch = 2;   // 0.9.3: Latenz (pdc_delay) gilt fuer beide Kanaele
rmbBR = M_PDC + PDCN; rmbBM = M_PDC + 2*PDCN; rmbBG = M_PDC + 3*PDCN;
evN = 0;        // MIDI-Queue-Fuellstand
evRd = 0;       // MIDI-Queue-Leseposition
g_bpm = 120;    // Ersatz, bis updTargets() tempo liest

srateConsts();

// Werkswerte nur bei Erst-Init schreiben - @serialize kann VOR @init
// laufen. QA-FIX v0.1.0 (M5-F4a): hat der Serialize davor einen gueltigen
// Blob gelesen (needValidate = 1), darf writeDefaults ihn NICHT
// ueberschreiben - validateState holt der erste @block nach.
// P25 (A12): voller Grundzustand ueber rmbDefaultsAll (writeDefaults setzt nur noch die 28 Klangworte).
rmbInit != 1 ? ( needValidate ? 0 : rmbDefaultsAll(); rmbInit = 1; psetMod = 0; );
// 0.9.1: erst im ersten @block nach updTargets mit dem tatsaechlichen Hosttempo umrechnen.
// Review 30.10.2026 (2): Konstanten sind jetzt belegt; Blob vor DSP-Zielen/Slew-Seeds klemmen.
// Legacy-Promille 0..1000 bleiben innerhalb der ms-Klemmen; Migration weiterhin erst im @block.
// Das Flag bleibt gesetzt: der @block loescht es nach seiner Klemmung selbst (A9-Invariante).
needValidate ? validateState() : 0;

tth_sync(par[PG_COLOR]);   // P14: Farbschema aus dem serialisierten Reservewort

// P17: Preset-Leiste - Speicher + Werks-Namen (Re-@init behaelt die Bank)
tt_pb_init(PBK_NF, 32, PBK_BANK, PBK_PSW);
tt_pb_hasinit = 0;           // INIT ist Werks-Eintrag 0 der Liste
rmbPbNames();

// P26: Puffer/Engine nur beim harten Reset leeren.
rmbHard ? (
  engReset();
  verbInit(M_VTAB);          // Tabelle zeigen, Flush, Snap der Koeffs
);
updTargets();
trigCoeff();
envCoeff();
// P25 (A10): @init laeuft auch bei Samplerate-Wechsel (und leert hier per engReset den Pitch-Ring) - das
// Fenster-Ziel sofort uebernehmen wie im @block-Zweig srate != lastSrate. Vorher blieb glo_pWc/glo_pHlf bis
// zum ersten PTD-Feuer auf dem alten Wert (erster PITCH-Treffer nach dem Wechsel zu frueh, teils stumm).
// P26: nur beim harten Reset - beim Transportstart gilt das P22-Prinzip (Fensterwechsel erst am naechsten Trigger,
// kein Lesesprung im weiterklingenden Tail).
rmbHard ? ( glo_pWc = 0; );
pitchCoeff();

// gedaempfte Zustaende auf die Ziele snappen - kein Einfaedeln am
// Anlauf (geloest per direktem Zuweisen, Slew bleibt nur fuer Edits)
// P26: nur beim harten Reset; beim Transportstart laufen Slews, Filterzustaende und Koeffizienten weiter
// (ein Snap mitten im Tail koennte springen).
rmbHard ? (
  wKck = tKck; wRmb = tRmb; outSm = tOutG; ceilSm = tCeil; wClip = tClip;
  mKon = tKon; mRon = tRon;   // P15
  dDrv = tDrv;
  lcFcS = tLcF; lcQS = tLcQ; lcFcP = -1; lcQP = -1;
  hcMpS = tHcMap; hcDpS = tHcDep; hcKS = tHcK;
  ntFcS = tNtF; ntDrS = tNtDrv; ntFcP = -1;
  glo_hcA1 = 1; glo_hcA2 = 0; glo_hcA3 = 0;   // SVF = Durchlass, bis (g_pos&3)==0
  lcA1 = 1; lcA2 = 0; lcA3 = 0;
  lcK = 1/max2(0.5, lcQS);        // QA-FIX v0.1.0 (agy F7): deterministischer Erstwert
  glo_cbD = 480;
  scopePos = 0; scopeDiv = 0;     // P26: Scope-Ring laeuft beim Transportstart weiter
  memset(M_SCQ, 0, SCN*8);        // v0.7.0: Scope-Spalten leeren (nur harter Reset: der Takt laeuft beim Transportstart weiter)
  scCi = -1; scBeat = 0; scBarB = 4; scInvB = 0.25; scInc = 0.00004;
  hcDiv = 0;                      // QA-FIX (M5-F10): HC-Koeffizienten-Subsample-Zaehler (P26: hierher)
  memset(M_PDC, 0, 4*PDCN); rmbPdcW = 0; rmbPdcIni = 0; rmbPdcRep = -1; rmbDk = 0; rmbDr = 0;   // 0.9.3: Latenzringe
);

// P25 (Punkt 9): Undo-Arm nur beim ersten @init (siehe UI-Laufzustand unten).
lastSrate = srate;
lastPlayPos = 0;     // QA-FIX (agy F10): Transport-Ruecklauf-Detektion
lastPlayState = 0;   // QA-FIX (M5-F2): Play-Status-Wechsel-Detektion
// P25 (A9): ersatzlos gestrichen. @serialize setzt needValidate = 1, wenn es VOR dem ersten @init einen
// gueltigen Blob gelesen hat; die Zeile hier loeschte das Flag, bevor der erste @block validateState()
// nachholen konnte (ungeklemmte Blob-Werte blieben stehen). Vorgabe 0 gilt ohne Zuweisung; der @block
// loescht es nach dem Nachzug selbst.

// UI-Laufzustand (P21): Designraster + Drag-/Mauszustand + Font-Cache.
// dragId traegt die knob2/hslider-Drags (Registry am @gfx-Kopf);
// SC/OX/OY/mX/mY, uiLmb/uiClick/uiRClk, lmbPrev/rmbPrev und fontChk
// setzt das Kit (uikit_begin/uikit_end) pro Frame neu.
// P25 (Punkt 9): @init laeuft bei jedem Transportstart erneut. Laufender Bedienzustand darf dabei nicht
// verloren gehen: lmbPrev = 0 bei gedrueckter Taste ergab im Folgeframe eine Klickflanke (neuer undoMark +
// Phantomklick an der Mausposition), undArm = 0 mitten im Zug liess einen leeren Snapshot im Ring stehen.
// Deshalb nur beim ersten @init vorbelegen (rmbIni1 wird nie zurueckgesetzt).
UI_W = 900; UI_H = 700;      // Konstanten
rmbIni1 != 1 ? (
  rmbIni1 = 1;
  // v0.7.0: Scope-Ansicht (nicht gespeichert, je Sitzung): scMode 0 = FIXED (Takt steht, Cursor laeuft), 1 = ROLL (Rolle, links = aelteste)
  scMode = 0; scShK = 1; scShR = 1; scShS = 0; scShG = 1;
  SC = 1; OX = 0; OY = 0; mX = -1; mY = -1;
  dragId = -1;
  uiLmb = 0; uiClick = 0; uiRClk = 0; lmbPrev = 0; rmbPrev = 0;
  fontChk = 0;
  undArm = 0; undPset = 0;
);

// ======================================================================
@serialize

// Blob: Magic(1) + Version(1) + M_PAR(64) = 66 Worte (PLAN S.9).
// file_avail < 0 bedeutet Schreibmodus - Checks dann aus.
// QA-FIX v0.1.0 (agy P0#2): Lesen/Schreiben passiert JEDESMAL, unabhaengig
// von rmbInit - ein Serialize vor @init darf die Projektdaten NICHT
// verwerfen. Da die @init-Konstanten (RMB_MAGIC/rmbVer) vor @init 0
// waeren, stehen hier Literale; M_PAR = 0 gilt in beiden Faellen.
// validateState vor @init ist unmoeglich (PM_* alle 0) -> needValidate
// verschiebt die Klemmung in den ersten @block (Konstanten existieren).
serAvail = file_avail(0);
rmbTipOk = 0;                             // P25: 1 = Lesemodus mit gueltigem RMBL-Blob (Tooltip-Abbildung unten)
// QA-FIX v0.1.0 (M5-F4b): Schreiben VOR @init wuerde Magic + 64 Nullen
// als gueltigen Blob ablegen (beim naechsten Laden: alle Parameter 0,
// aber magic/version valid) - in dem Fall gar nichts serialisieren.
serAvail < 0 && rmbInit != 1 ? 0 : (
// P15 (gemessen in echtem REAPER, Projekt-Rundreise 2026-09-30): file_avail(0)
// liefert im Lesemodus nur 1 (Daten vorhanden) bzw. 0 (leer), NICHT die Wortzahl -
// die alte Pruefung ">= 66" schlug beim Laden immer fehl (Blob wurde verworfen,
// jedes Projekt startete mit Werkswerten).
serAvail != 0 ? (
  // Muster: erst den ERWARTETEN Wert zuweisen. Schreibfall (avail < 0)
  // schreibt ihn; Lesefall ueberschreibt die Variable mit dem Dateiwert,
  // den der Vergleich danach prueft. Literale statt @init-Konstanten,
  // weil Serialize vor @init sonst 0 schreiben wuerde.
  smagic = 1380732226;                    // 'RMBL' (Vergleich unten)
  file_var(0, smagic);
  serVer = rmbTimeMigrate ? 2 : 3; // Rohdaten bleiben bis zum ersten @block als v2 gueltig.
  file_var(0, serVer);
  // P25 (Punkt 3): Schreibmodus haelt das Altwort PG_TIPS (33, 1 = an) gleich OPTIONS > TOOLTIPS - aeltere
  // Versionen lesen nur dieses Wort. Literal 33 wie unten (Serialize kann vor @init laufen).
  serAvail < 0 ? ( M_PAR[33] = tth_tipoff > 0.5 ? 0 : 1; );
  // 0.9.3: Rueckgabe = gelesene Worte (Muster wie tt_pb_rdone); Schreibfall liefert die geschriebene Zahl, geprueft wird nur beim Lesen.
  serRd = file_mem(0, M_PAR, 64);
  // P15: die Blob-Worte sind float32 - 1380732226 wird als 1380732288 gespeichert
    // (Spacing 128), der exakte Vergleich "smagic == 1380732226" scheiterte immer.
    abs(smagic - 1380732226) < 200 && (floor(serVer + 0.5) >= 1 && floor(serVer + 0.5) <= 3) ? (
    // Migrations-Hook: kuenftige Versionen hier per
    // switch(floor(serVer + 0.5))-Zweig nachziehen (v1 = Urformat)
    // QA-FIX (M5-F4c): validateState + Stern-Reset NUR im Lesemodus -
    // im Schreibmodus tilgte psetMod = 0 den Modifizierungs-Stern.
    // P15: v1-Blobs kennen +28/+29 nicht (dort 0 = Reserve) -> "an".
    serAvail >= 0 && floor(serVer + 0.5) == 1 ? (
      M_PAR[28] = 1;     // = PM_KON (Literal wie oben: Serialize kann vor @init laufen)
      M_PAR[29] = 1;     // = PM_RON
    ) : 0;
    // P22-F (Review): validateState() nur mit fertigen Konstanten - laeuft der
    // Lesepfad vor @init, sind PM_*/PSET_N noch 0 und par[0] (ENGINE) wird
    // korrumpiert (PITCH 2 -> NOISE 1). Im Vor-@init-Fall uebernimmt der
    // needValidate-Pfad die Klemmung im ersten @block.
    serAvail >= 0 ? (
      rmbTimeMigrate = floor(serVer + 0.5) < 3;
      // rmbTimeMigrate bleibt bis zum ersten @block gesetzt; Schreiben behaelt solange v2.
      // 25.10.2026 (Review R002/R011): validateState/psetMod/needDefaults nur im Lesemodus -
      // im Schreibmodus klemmte validateState die Parameter beim SPEICHERN und psetMod = 0
      // tilgte den Modifizierungs-Stern (der Kommentar zu M5-F4c behauptete das Gate bereits).
      rmbInit == 1 ? ( validateState(); psetMod = 0; ) : ( needValidate = 1; );
      needDefaults = 0;
    );
    // P25: Lesemodus - Altwort PG_TIPS merken (1 = aus) fuer die Abbildung auf tth_tipoff nach der Bank,
    // und (laufende Instanz, REAPER-Undo/-Redo) den eigenen Undo-Ring an den zurueckgespielten Zustand angleichen.
    serAvail >= 0 ? (
      rmbTipLd = M_PAR[33] < 0.5 ? 1 : 0;
      rmbTipOk = 1;
      rmbInit == 1 ? rmbSerUndo();
    );
    // 0.9.3: mitten im 64-Wort-Block abgeschnittener Chunk -> definierter Werkszustand statt Mischung aus Alt- und Dateiwerten.
    // Die Migration wird verworfen (sonst liefe sie im @block ueber die Werkswerte); rmbDefaultsAll() laeuft im ersten @block.
    serAvail >= 0 && serRd < 64 ? ( needDefaults = 1; rmbTimeMigrate = 0; ) : 0;
  ) : (
    needDefaults = 1;                     // fremder/unbekannter Blob
  );
) : (
  needDefaults = 1;                       // abgeschnittener/leerer Blob
);
);

// P17: Preset-Bank NACH dem 66-Wort-Blob (Blobformat unveraendert; alte Projekte enden vorher -> Bank bleibt leer).
// Historie: Vor @init (tt_pb_ready != 1) ist kein Bankspeicher da -> nichts tun.
// Review 30.10.2026 (1): Auch PBK_*/TTPB_* sind vor @init noch 0. Lese-Layout mit Literalen
// wie im Blob bereitstellen: 23 Werks-Eintraege (PSET_N + 1), 32 Slots, je 32 Worte, Namen je 25.
// Die Modulbereiche bleiben unveraendert; spaeteres tt_pb_init behaelt die gelesene Bank.
(serAvail >= 0) && (tt_pb_ready != 1) ? (
  TTPB_NW = 25; TTPB_MAGIC = 21584; TTPB_MAG2 = 22032; TTPB_MAG3 = 22288;
  tt_pb_init(23, 32, 110000, 32);
  // Stil-Defaults vor dem Lesen setzen und gegen das erste Theme-@init schuetzen.
  // Ohne Stil-Block gelten damit dieselben Vorgaben wie bei einer frischen Instanz.
  tth_styok != 1 ? (
    tth_styok = 1;
    tth_uisize = 125; tth_panx = 0; tth_pany = 0; tth_autooff = 0;
    tth_f1sz = 0; tth_f2sz = 0; tth_f1on = 0; tth_f2on = 0; tth_bgon = 0;
    tth_f1R = 0.92; tth_f1G = 0.95; tth_f1B = 0.92;
    tth_f2R = 0.92; tth_f2G = 0.95; tth_f2B = 0.92;
    tth_bgUR = 0.050; tth_bgUG = 0.054; tth_bgUB = 0.050;
    tth_ctgt = 0; tth_ch = 0.30; tth_cs = 0.85; tth_cv = 0.9; tth_cdrag = 0;
  );
);
// P25 (Punkt 3): EIN Tooltip-Schalter (tth_tipoff). Beim Lesen eines gueltigen RMBL-Blobs gilt: Tooltips AUS,
// wenn das Altwort PG_TIPS ODER der Stil-Block v2 "aus" sagt. Das Modul meldet nicht, ob es einen v2-Block
// gelesen hat (ohne Block bzw. mit v1-Block setzt es 0, ein v2-Block kann ebenfalls 0 liefern) - deshalb der
// Waechter -1: bleibt er stehen (keine Bank, Chunk vor P17, Lesen vor @init) oder liefert das Modul 0, entscheidet
// das Altwort. Chunks ab v0.5.4 tragen beide Werte gleich (Schreiben oben), v0.5.3 hielt sie per rmbTipSync gleich.
serAvail >= 0 && rmbTipOk ? ( tth_tipoff = -1; );
tt_pb_ready == 1 ? tt_pb_serialize();
serAvail >= 0 && rmbTipOk ? ( tth_tipoff = tth_tipoff > 0.5 ? 1 : rmbTipLd; rmbTipOk = 0; );

// ======================================================================
@block

needDefaults ? ( rmbDefaultsAll(); needDefaults = 0; );   // P25 (A12): voller Grundzustand
needValidate && !rmbTimeMigrate ? ( validateState(); needValidate = 0; );   // QA-FIX (agy P0#2): Nachzug aus Serialize-vor-@init

// Samplerate-Deckung: manche Hosts feuern kein @init bei srate-Wechsel
// (Kick-Muster). voller Reset + Koeffizienten neu + Slew-Snap.
srate != lastSrate ? (
  lastSrate = srate;
  srateConsts();
  engReset();
  glo_pWc = 0;                  // P22: Fenster-Ziel beim srate-Reset sofort uebernehmen lassen
  updTargets(); trigCoeff(); envCoeff(); pitchCoeff();
  wKck = tKck; wRmb = tRmb; outSm = tOutG; ceilSm = tCeil; wClip = tClip;
  mKon = tKon; mRon = tRon;   // P15
  dDrv = tDrv; lcFcS = tLcF; lcQS = tLcQ; hcMpS = tHcMap; hcDpS = tHcDep;
  hcKS = tHcK; ntFcS = tNtF; ntDrS = tNtDrv;
  lcFcP = -1; lcQP = -1; ntFcP = -1;
  g_pos = 0;                    // QA-FIX (agy F8): (g_pos&3)-Raster + Anker neu
  lastPlayPos = 0;
);

// QA-FIX v0.1.0 (M5-F2): nur bei Play-Status-WECHSEL oder Ruecklauf
// WAEHREND des Spiels entwauffen - ein hartes play_state==0-Fenster hat
// den PITCH-Latenztrigger (W/2 > Blocklaenge) bei Stopp/Anspiel gekillt
// (Regression des agy-F10-Fixes, gemessen: Env-Max 0.000 im Stopp).
(play_state != lastPlayState) || (play_state != 0 && play_position < lastPlayPos) ?
  eng[EC_PTD] = -1 : 0;
lastPlayState = play_state;
lastPlayPos = play_position;

// Letzten VERARBEITETEN Block merken: ein weiches @init (Transportstart)
// kann updTargets bereits aufgerufen haben; das darf den Wechsel nicht verdecken.
rmbOldChr = rmbBridgeChr; rmbOldCut = rmbBridgeCut;
updTargets();               // BPM + Regler-Ziele (Slew-Ziele fuer @sample)
// 0.9.1: erst hier ist g_bpm fuer dieses Projekt/Transportfenster verlaesslich.
// Alte Rohzeiten bis dahin als v2 serialisieren; danach UNDO-Snapshot in ms angleichen.
rmbTimeMigrate ? (
  rmbLegacyTimes(M_PAR, g_bpm); rmbTimeMigrate = 0;
  validateState(); needValidate = 0; rmbSerUndo();
);
rmbBridgeReady && (par[PM_ENG] != glo_engSel ||
  (glo_engSel != 2 && glo_chr != rmbOldChr) || glo_fchr != rmbOldCut) ? rmbBridgePending = 1;
rmbBridgeChr = glo_chr; rmbBridgeCut = glo_fchr;
// v0.7.0: Scope-Takt - Spaltenzuordnung nach der Position im Takt. Laeuft der Transport, rastet der Zaehler je Block auf die
// Projektposition ein; steht er, laeuft er frei mit dem Tempo weiter (das Plugin hoert auch bei Stopp auf sein Eingangssignal).
scBarB = (tsnum > 0 && tsdenom > 0) ? tsnum*4/tsdenom : 4;
scBarB = min2(64, max2(0.5, scBarB));
scInvB = 1/scBarB;
scInc  = g_bpm/(60*srate);
(play_state & 1) ? scBeat = beat_position;
trigCoeff();                // Threshold/Hysterese aus PM_TTHR
envCoeff();                 // Sektionsdauern direkt aus Millisekunden
verbCoeff(samplesblock);    // Verb-Slew ueber die Blocklaenge
pitchCoeff();               // Fenster/Rate (PITCH laeuft immer, kein Bypass)

// P26 (REAPER-Lauf 1): Testdiagnose fuer p26_test.lua - NUR mit Test-Freigabe (tt_testok: gmem[5189] = 20261001),
// nur lesend (schreibt Zustand nach gmem, aendert nichts am Klang). Ohne Freigabe kostet es einen gmem-Vergleich je Block.
// 6000 @init-Zahl, 6001 harte Resets, 6002 EC_SECT, 6003 EC_PHASE, 6004 EC_VAL, 6005 g_pos, 6006 g_bpm, 6007 EC_THLD,
// 6008 Trigger-Zahl (envRestart), 6009 play_state, 6010 play_position, 6011 Follower EC_FST, 6012 srate, 6013 Blockzaehler, 6014 gemeldete Latenz rmbLtot.
// Nur EINE RUMBLER-Instanz bei gesetzter Freigabe (gmem ist je Namespace geteilt).
tt_testok() ? (
  gmem[6000] = rmbInitN; gmem[6001] = rmbHardN; gmem[6002] = eng[EC_SECT]; gmem[6003] = eng[EC_PHASE];
  gmem[6004] = eng[EC_VAL]; gmem[6005] = g_pos; gmem[6006] = g_bpm; gmem[6007] = eng[EC_THLD];
  gmem[6008] = rmbTrgN; gmem[6009] = play_state; gmem[6010] = play_position; gmem[6011] = eng[EC_FST];
  gmem[6012] = srate; gmem[6013] += 1; gmem[6014] = rmbLtot;   // 6014: gemeldete Latenz (pdc_delay) in Samples
);

// Engine-Wechsel: Eintrittsaktionen statt Slew (Charakter-Switch wird
// in verbFlush ohnehin erkannt; hier nur Puffer-Hygiene)
eSel = min2(2, max2(0, floor(par[PM_ENG] + 0.5)));
eSel != glo_engSel ? (
  glo_engSel = eSel;
  eng[EC_PTD] = -1;            // QA-FIX (agy F5): kein Geist-Trigger nach Wechsel
  eSel == 0 ? verbFlush()      // alter Hall-Tail nicht wiederholen
  : eSel == 1 ? ( eng[EC_NP1] = 0; eng[EC_NP2] = 0; eng[EC_NP3] = 0;
                  eng[EC_NB1] = 0; eng[EC_NB2] = 0; )
  : 0;                          // PITCH: Ring laeuft ohnehin pro Sample mit
);

// 0.9.3: Latenzausgleich. Engine-Latenz = halbes Fenster (nur PITCH). AUTO: die Kick wird um genau diese Zeit verzoegert, der
// Rumble nicht (er ist von Natur aus so spaet). FIXED: immer ein Fenster, der Rumble bekommt die Differenz dazu.
// Die Wirkung ist ein ganzzahliger Offset der Leseposition; Aenderungen gleiten (0,25 Sample je Sample), kein Sprung.
rmbLeng = glo_engSel == 2 ? glo_pHlfT : 0;
rmbLtot = par[PG_LAT] > 0.5 ? min2(PDCN - 2, glo_pW) : rmbLeng;
rmbDrT  = max2(0, rmbLtot - rmbLeng);
rmbPdcIni != 1 ? ( rmbDk = rmbLtot; rmbDr = rmbDrT; rmbPdcIni = 1; );
rmbLtot != rmbPdcRep ? ( pdc_delay = rmbLtot; rmbPdcRep = rmbLtot; );

// MIDI einsammeln: die Queue M_EVQ haelt nur Note-Ons (Trigger-Quelle
// 1/2) als [offset, m1, m2, m3]; ALLES geht per midisend durch (FX).
evN = 0; evRd = 0; smplPos = 0;
while (midirecv(offs, m1, m2, m3)) (
  midisend(offs, m1, m2, m3);
  glo_tSrcM && (m1 & 0xF0) == 0x90 && m3 > 0 ? (
    evN < 24 ? (
      M_EVQ[evN*4]   = min2(samplesblock - 1, max2(0, offs));
      M_EVQ[evN*4+1] = m1; M_EVQ[evN*4+2] = m2; M_EVQ[evN*4+3] = m3;
      evN += 1;
    ) : 0;
  ) : 0;
);

// ======================================================================
@sample

// ---------- Eingang ----------
// QA-FIX v0.1.0 (M5-F6): NaN/Inf-Waechter - ein einziges nicht-endliches
// Sample vergiftet sonst Tank, SVF-Zustaende und Follower DAUERHAFT
// (abs(NaN) < eps ist false, die Denormal-Flushes greifen nicht).
inL  = spl0;
inR  = spl1;
!(inL > -64 && inL < 64) ? inL = 0;
!(inR > -64 && inR < 64) ? inR = 0;
midS = (inL + inR)*0.5;                    // Engines auf Mono-Mid (PLAN S.1)
glo_tAbs = max2(abs(inL), abs(inR));

// ---------- MIDI-Dispatch (Queue aus @block, sample-genau) ----------
while (evRd < evN && M_EVQ[evRd*4] <= smplPos) (
  handleMidi(M_EVQ[evRd*4+1], M_EVQ[evRd*4+2], M_EVQ[evRd*4+3]);
  evRd += 1;
);

// ---------- Audio-Trigger (Kern C: Follower/Hysterese/Debounce) ----------
glo_tF = eng[EC_FST];
glo_tF += (glo_tAbs > glo_tF ? glo_tAtk : glo_tRel) * (glo_tAbs - glo_tF);
glo_tF < 0.000000000000000001 ? glo_tF = 0;
eng[EC_FST] = glo_tF;
g_pos < eng[EC_LTT] ? eng[EC_LTT] = -1000000000;   // Transport-Sprung -> Reset
// QA-FIX v0.1.0 (M5-F3): MIDI-Hold - nach MIDI-Trigger bleibt der
// Audio-Follower 250 ms (oder bis unter die Hysterese) gesperrt; der
// 30-ms-Debounce allein ist kuerzer als das Follower-Release.
eng[EC_MHLD] == 1 && glo_tF > glo_tThr ? eng[EC_MHLD] = 2;
eng[EC_MHLD] == 2 && glo_tF < glo_tLo ? eng[EC_MHLD] = 0;
eng[EC_MHLD] == 1 && g_pos - eng[EC_LTT] > 0.25*srate ? eng[EC_MHLD] = 0;
glo_tF < glo_tLo && eng[EC_MHLD] == 0 ? eng[EC_ARM] = 1;
glo_tSrcA && eng[EC_ARM] && glo_tF > glo_tThr && (g_pos - eng[EC_LTT]) > glo_tDeb ? (
  eng[EC_ARM] = 0;
  trigCommon();
  // v0.6.1 (A1): wie im MIDI-Zweig mit dem Ziel-Fenster planen (Fensterwechsel erst beim Feuern, siehe unten)
  glo_engSel == 2 ? eng[EC_PTD] = g_pos + glo_pHlfT  // A4: Latenzausgleich W/2
                  : envRestart();
);
// Pending-Trigger (nur PITCH): Huellkurve feuert synchron zum Fahnenende
eng[EC_PTD] >= 0 && g_pos >= eng[EC_PTD] ? (
  eng[EC_PTD] = -1;
  rmbBridgeReady && glo_pWc != glo_pWcT ? rmbBridgePending = 1;
  glo_pWc = glo_pWcT; glo_pHlf = glo_pHlfT;   // P22: Fensterwechsel beim Trigger (kein Lesesprung im Tail)
  // Rate im SELBEN Sample nachziehen.
  // z. B. TIGHT -> GRAIN bei -12 st: bis Blockende Faktor -1 statt +0.5 (Rueckwaertssprung).
  glo_pInc = glo_pRate/glo_pWc;
  envRestart();
  // QA-FIX v0.1.0 (M5-F1): Fensterphase auf den Kick verriegeln -
  // ph = 0.5: Kopf A hat Gewicht 1 und Verzoegerung W/2 = exakt der
  // Kick-Onset. Frei laufende Phase liess den Sub-Pegel zufaellig um
  // bis zu 29 dB pro Beat schwanken (gemessen, audit_m5.md F1).
  eng[EC_PPH] = 0.5;
);
eng[EC_LED] > 0 ? eng[EC_LED] -= 1;
// Kick-Peak-Hold fuer AutoGain: laeuft "seit letztem Trigger" - das
// Update steht HINTER dem Feuer-Block, damit das Ausloese-Sample schon
// ins neue Messfenster faellt.
eng[EC_AGK] = max2(eng[EC_AGK], glo_tAbs);

// ---------- Slew-Cluster: langsame Parameter folgen ihren Zielen ----------
wKck  += (tKck   - wKck)*slewK;
wRmb  += (tRmb   - wRmb)*slewK;
// P15: Mute-Rampen. An = exakt 1.0 (bitgenau transparent), aus = exakt 0
// nach der Rampe (Snap gegen Denormale / endloses Ausklingen).
mKon += (tKon - mKon)*muteK;
mKon > 0.99999 ? mKon = 1 : ( mKon < 0.00001 ? mKon = 0 : 0 );
mRon += (tRon - mRon)*muteK;
mRon > 0.99999 ? mRon = 1 : ( mRon < 0.00001 ? mRon = 0 : 0 );
outSm += (tOutG  - outSm)*slewK;
ceilSm += (tCeil - ceilSm)*slewK;
wClip += (tClip  - wClip)*slewK;
// P25 (A11): Endschnapp wie bei mKon/mRon - ohne ihn lief der Clipper-Zweig nach CLIPPER OFF ~14 s weiter
// (CLIP-LED meldete trotz OFF, Ausgabe nicht bitgleich zu OFF, Denormal-Phase). Abweichung < -100 dB.
wClip < 0.00001 ? wClip = 0 : ( wClip > 0.99999 ? wClip = 1 : 0 );
dDrv  += (tDrv   - dDrv)*slewK;
dDrv < 0.00001 ? dDrv = 0 : 0;             // P25 (A11): DRIVE 0 -> exakt 0 (bitgenau, s. u.)
lcFcS += (tLcF   - lcFcS)*slewK;
lcQS  += (tLcQ   - lcQS)*slewK;
hcMpS += (tHcMap - hcMpS)*slewK;
hcDpS += (tHcDep - hcDpS)*slewK;
hcKS  += (tHcK   - hcKS)*slewK;
ntFcS += (tNtF   - ntFcS)*slewK;
ntDrS += (tNtDrv - ntDrS)*slewK;

// LowCut-Koeffizienten nur bei Bewegung neu (PLAN S.8.1)
abs(lcFcS - lcFcP) > lcFcS*0.0005 || abs(lcQS - lcQP) > lcQS*0.0005 ? (
  lcFcP = lcFcS; lcQP = lcQS;
  lcG  = tan(3.1415927*min2(0.45*srate, max2(10, lcFcS))/srate);
  lcK  = 1/max2(0.5, lcQS);
  lcA1 = 1/(1 + lcG*(lcG + lcK));
  lcA2 = lcG*lcA1;
  lcA3 = lcG*lcA2;
);
// Noise-TONE-Koeffizienten (CLASSIC-Kaskade + RUBBLE-BP)
abs(ntFcS - ntFcP) > ntFcS*0.0005 ? (
  ntFcP = ntFcS;
  glo_ntK  = 1 - exp(-6.283185307179586*ntFcS/srate);
  glo_ntG  = tan(3.1415927*min2(0.45*srate, max2(20, ntFcS))/srate);
  glo_nbA1 = 1/(1 + glo_ntG*(glo_ntG + 0.7142857));
  glo_nbA2 = glo_ntG*glo_nbA1;
  glo_nbA3 = glo_ntG*glo_nbA2;
);
glo_ntDrv = ntDrS;

// ---------- Engine-Eingang ----------
// Exciter-LP 200 Hz (VERB-Eingang) und der Pitch-Ring laufen IMMER mit:
// beide Puffer bleiben frisch, ein Engine-Wechsel braucht keinen Flush.
eng[EC_EXC] += glo_excK*(midS - eng[EC_EXC]);
abs(eng[EC_EXC]) < 0.000000000000000001 ? eng[EC_EXC] = 0;
pitchWrite(midS);

envTick();                          // AHDR -> EC_VAL (1.5 ms geglaettet)

// ---------- Engine ----------
// QA-FIX v0.1.0 (M5-F7): der -6-dB-Trim ist gestrichen - die gepitchte
// Kick-Fundamentale faellt grossteils unter den LOW CUT, PITCH lag damit
// 10-20 dB unter dem AutoGain-Ziel (AGV klebte bei 1.0). Pegelabstimmung
// macht jetzt den Preset-Lab (M4b) mit der F1-Phasenverriegelung.
engV = glo_engSel == 0 ? verbTick(eng[EC_EXC])
     : glo_engSel == 1 ? noiseTick()
     : pitchRead();

rmb = engV * eng[EC_VAL];           // AHDR-Gate

// ---------- LOW CUT (TPT-SVF Hochpass, mono) ----------
lcV3 = rmb - eng[EC_LC2];
lcV1 = lcA1*eng[EC_LC1] + lcA2*lcV3;
lcV2 = eng[EC_LC2] + lcA2*eng[EC_LC1] + lcA3*lcV3;
eng[EC_LC1] = 2*lcV1 - eng[EC_LC1];
eng[EC_LC2] = 2*lcV2 - eng[EC_LC2];
abs(eng[EC_LC1]) < 0.000000000000000001 ? eng[EC_LC1] = 0;
abs(eng[EC_LC2]) < 0.000000000000000001 ? eng[EC_LC2] = 0;
rmb = rmb - lcK*lcV1 - lcV2;        // HP-Zweig des TPT-SVF

// ---------- DRIVE (paralleler Band-Drive ~140 Hz Split) ----------
eng[EC_BPY] += glo_bpG*(rmb - eng[EC_BPY]);
abs(eng[EC_BPY]) < 0.000000000000000001 ? eng[EC_BPY] = 0;
// drv = 0 -> Addition ist exakt 0 -> bitgenau (PLAN S.8.2)
// Nur bitgenau gleiche Werte cachen (=== statt EEL2s toleranter Gleichheit).
dDrv > 0 ? (
  !(dDrv === rmbDrvLast) ? (
    drvPre = 1 + dDrv*23; rmbDrvTrim = drvPre^(-0.35); rmbDrvLast = dDrv;
  );
  rmb += dDrv*(softClip(eng[EC_BPY]*drvPre)*rmbDrvTrim - eng[EC_BPY]);
);

// ---------- HIGH CUT + ENV DEPTH + CUT TYPE ----------
// QA-FIX v0.1.0 (agy F6): der Comb-Ring speist sich JETZT aus dem SVF-
// Ausgang (PLAN S.8.3: "CLEAN-Ausgang + 35 % Kammfilter"). Die alte
// Eingangs-Zapfstelle liess Drive-Obertoene am Lowpass vorbeilecken.
// Das Schreiben steht deshalb HINTER dem SVF-Block (unten).

// Koeffizienten jedes 4. Sample neu, dazwischen gehalten (PLAN S.8.3)
// QA-FIX v0.1.0 (M5-F10): eigener Mod-4-Zaehler statt (g_pos & 3) -
// g_pos waechst unbegrenzt, ab 2^31 Samples (12 h @48k) kann das
// 32-bit-& abschneiden (CPU x4 ohne Klangfolge, niedrige Konfidenz).
hcDiv == 0 ? (
  glo_hcFc = hcMpS * exp(0.6931471805599453 * eng[EC_VAL] * hcDpS);
  glo_hcFc > glo_hcHi ? glo_hcFc = glo_hcHi;
  glo_hcFc < 30 ? glo_hcFc = 30;
  glo_hcG  = tan(3.141592653589793 * glo_hcFc * glo_hcInv);
  glo_hcA1 = 1/(1 + glo_hcG*(glo_hcG + hcKS));
  glo_hcA2 = glo_hcG*glo_hcA1;
  glo_hcA3 = glo_hcG*glo_hcA2;
  // Comb-Verzoegerung = Periode des Cutoffs, geklemmt (PLAN S.8.3)
  glo_cbD = srate/glo_hcFc;
  // P26 (A13): Grenzen aus srateConsts (48 kHz: 1200 / 48).
  //   glo_cbD < 48 ? glo_cbD = 48;
  glo_cbD > glo_cbMax ? glo_cbD = glo_cbMax;
  glo_cbD < glo_cbMin ? glo_cbD = glo_cbMin;
);
hcDiv = (hcDiv + 1) & 3;

glo_hcX = rmb;
glo_fchr == 2 ? (
  // DIRTY: NUR die stabilisierte tanh-Variante (Anhang A6, agy P0#4);
  // die instabile Urform aus dsp_kernels.md ist verboten.
  // SPEC-DEVIATION: fastTanh statt tanh-Builtin (Haus-Standard, selbe
  // Mathematik - nicht jeder REAPER-Build hat tanh).
  glo_hcI1 = eng[EC_S1];
  glo_hcI2 = eng[EC_S2];
  glo_hcS1 = fastTanh(glo_hcI1);
  glo_hcS2 = fastTanh(glo_hcI2);
  glo_hcV3 = glo_hcX - glo_hcS2;
  glo_hcV1 = glo_hcA1*glo_hcS1 + glo_hcA2*glo_hcV3;
  glo_hcV2 = glo_hcS2 + glo_hcA2*glo_hcS1 + glo_hcA3*glo_hcV3;
  eng[EC_S1] = 2*glo_hcV1 - glo_hcS1;
  eng[EC_S2] = 2*glo_hcV2 - glo_hcS2;
) : (
  // CLEAN + Basis fuer COMB: linearer TPT-SVF (Kern E, Variante LINEAR)
  glo_hcI1 = eng[EC_S1];
  glo_hcI2 = eng[EC_S2];
  glo_hcV3 = glo_hcX - glo_hcI2;
  glo_hcV1 = glo_hcA1*glo_hcI1 + glo_hcA2*glo_hcV3;
  glo_hcV2 = glo_hcI2 + glo_hcA2*glo_hcI1 + glo_hcA3*glo_hcV3;
  eng[EC_S1] = 2*glo_hcV1 - glo_hcI1;
  eng[EC_S2] = 2*glo_hcV2 - glo_hcI2;
);
abs(eng[EC_S1]) < 0.000000000000000001 ? eng[EC_S1] = 0;
abs(eng[EC_S2]) < 0.000000000000000001 ? eng[EC_S2] = 0;
glo_hcLp = glo_hcV2;
// Comb-Ring: gefilterter Ausgang, immer frisch gehalten (QA-FIX agy F6)
cbW = eng[EC_CBP];
cb[cbW] = abs(glo_hcLp) < 0.000000000000000001 ? 0 : glo_hcLp;
cbW += 1;
cbW >= 4096 ? cbW = 0;
eng[EC_CBP] = cbW;
glo_fchr == 1 ? (
  // COMB (PLAN S.8.3): CLEAN-Ausgang + 35 % Kammsignal, Delay = Cutoff-
  // Periode, linear interpoliert gegen Zipper bei Cutoff-Fahrten.
  rp = cbW - 1 - glo_cbD;
  rp < 0 ? rp += 4096;
  ri = floor(rp);
  rf = rp - ri;
  ri2 = ri + 1;
  ri2 >= 4096 ? ri2 = 0;
  glo_hcLp += 0.35*(cb[ri] + rf*(cb[ri2] - cb[ri]));
);
rmb = glo_hcLp;

// 5 ms Raised-Cosine-Korrektur nur bei diskreten Wechseln. Der erste Wert
// schliesst exakt an den letzten an, danach verschwindet der Offset mit
// waagrechter Endsteigung. Filter und neue Engine laufen dabei normal weiter.
// Kein Audio-Delay, keine Aenderung bei festen Einstellungen, kein Rest-DC.
rmbBridgePending ? (
  rmbBridgeOff = rmbBridgePrev - rmb;
  rmbBridgePos = 0; rmbBridgePending = 0;
);
rmbBridgePos < rmbBridgeLen ? (
  rmb += rmbBridgeOff*0.5*(1 + cos(3.141592653589793*rmbBridgePos/rmbBridgeLen));
  rmbBridgePos += 1;
) : rmbBridgeOff = 0;
rmbBridgePrev = rmb; rmbBridgeReady = 1;

// ---------- AUTO GAIN (Feed-Forward + Freeze, PLAN S.8.4) ----------
eng[EC_AGR] = max2(eng[EC_AGR], abs(rmb));   // Rumble-Peak pre-VCA
agFrz = (g_pos - eng[EC_AGT] > glo_agFr) || eng[EC_AGK] < 0.0056;
agTgt = eng[EC_AGV];                          // freeze/idle = hold
// QA-FIX v0.1.0 (agy F4): re-adjust ONLY while the gate is open. During
// the START delay phase rmb is 0 -> AGR ~ 0 -> the raw target would jump to
// 1.0 on every kick and then sag again (beat pumping). While the gate is
// closed EC_AGV holds its value.
glo_aut && !agFrz && eng[EC_VAL] > 0.03 ?
  agTgt = min2(1, eng[EC_AGK]*0.501/max2(eng[EC_AGR], 0.0001)) : 0;
!glo_aut ? agTgt = 1;                         // AUS -> Gain slewt auf 1
eng[EC_AGV] += glo_agK*(agTgt - eng[EC_AGV]);
abs(eng[EC_AGV]) < 0.000000000000000001 ? eng[EC_AGV] = 0;
rmb *= eng[EC_AGV];

// ---------- Mix: Dry stereo + Rumble mono ----------
rmb *= wRmb*mRon;            // P15: RUMBLE-Mute NACH AutoGain/Engine (laufen weiter)
mkF = wKck*mKon;             // P15: KICK-Mute nur auf dem durchgereichten Dry
// 0.9.3: Latenzausgleich - Kick (L/R) um rmbDk, Rumble und Gate um rmbDr verzoegert, so beginnen sie gemeinsam.
rmbDk += max2(-0.25, min2(0.25, rmbLtot - rmbDk));
rmbDr += max2(-0.25, min2(0.25, rmbDrT - rmbDr));
M_PDC[rmbPdcW] = inL; rmbBR[rmbPdcW] = inR;
rmbBM[rmbPdcW] = rmb; rmbBG[rmbPdcW] = eng[EC_VAL];
dkL = rmbPdcRd(M_PDC, rmbDk); dkR = rmbPdcRd(rmbBR, rmbDk);
rmbD = rmbPdcRd(rmbBM, rmbDr); rmbGtD = rmbPdcRd(rmbBG, rmbDr);
rmbPdcW += 1; rmbPdcW >= PDCN ? rmbPdcW = 0;
outL = dkL*mkF + rmbD;
outR = dkR*mkF + rmbD;

// ---------- Clipper auf der Summe (wet-Lerp, OFF -> bitgenau) ----------
wClip > 0 ? (
  clL = softClip(outL/ceilSm)*ceilSm;
  clR = softClip(outR/ceilSm)*ceilSm;
  // CLIP-LED: Eingang ueber dem Ceiling (Latch-Position, PLAN S.8.6)
  abs(outL) > ceilSm*0.999 || abs(outR) > ceilSm*0.999 ? eng[EC_CLPL] = g_pos;
  outL += wClip*(clL - outL);
  outR += wClip*(clR - outR);
) : 0;

// ---------- OUT + Safety-Clamp (PLAN S.8.7): Gain, dann +-2 hart ----------
moL = outL*outSm;
moR = outR*outSm;

// Meter/Scope messen VOR dem Clamp (PLAN S.8.6)
// v0.7.0: Dual-Trace - KICK IN (Mono-Mid vor dem KICK-Fader), RUMBLE (nach AUTO GAIN und RUMBLE-Fader), SUMME (vor dem Clamp).
rmbScopeTick((dkL + dkR)*0.5, rmbD, (moL + moR)*0.5);

spl0 = min2(2, max2(-2, moL));
spl1 = min2(2, max2(-2, moR));

smplPos += 1;
g_pos  += 1;

// ======================================================================
// @gfx (M3): komplette Geraetefront 900 x 700 nach PLAN S.10.
// Raster: Header 0..66 | TRIGGER (16,76,276,160) + ENGINE (16,244,276,316)
// | ENVELOPE (300,76,296,484) | FILTER (604,76,280,304) + MIX
// (604,388,280,172) | SCOPE (16,568,868,92) | Footer 672+.
//
// DRAG-ID-REGISTRY (PLAN S.10; knob() traegt kbDrag, vFade() dragId):
//   1..9   FILTER    1 LOW CUT | 2 LC RES | 3 HIGH CUT | 4 HC RESO |
//                    5 DRIVE | 6 ENV DEPTH
//   10     TRIGGER   THRESHOLD (PLAN laesst 10/20/25..30 frei - additiv)
//   11..19 ENVELOPE  11 START | 12 ATTACK | 13 HOLD | 14 RELEASE | 15 CURVE
//   21..24 MIX       21 OUT | 22 CEILING (23/24 Reserve)
//   31..34 ENGINE    31 Slot A: DECAY / TONE / PITCH (je Engine)
//                    32 FOCUS | 33 DENSE (34 Reserve)
//   41/42  FADER     41 KICK | 42 RUMBLE (dragId-Namensraum)
//   Buttons und Stepper sind click-only ohne ID; die Undo-Klammer
//   (uiClick -> undoMark, Release -> undoCommit) deckt sie mit ab.
//   CTRL+Klick = Reset auf ctlDef(), SHIFT = Fine-Drag.
// ======================================================================
// ======================================================================
// @gfx (P21): Geraetefront 900 x 700 auf dem v2-UI-Kit (UKIT_VER 2).
// Aufbau wie die anderen UI-Kit-Produkte: tth_pre/tt_pb_pre -> uikit_begin ->
// uikit_ground2 -> panel2-Panels mit Titelzeile -> knob2/hslider/combo/
// toggle-Widgets -> Overlays (Tooltip, Preset-Leiste, OPTIONS) ->
// uikit_end. Skalierung + Maus-Rueckrechnung macht uikit_begin
// (SC/OX/OY/mX/mY, Fonts 1..5, uiLmb/uiClick/uiRClk, dragId-Reset).
// Bedienfunktionen: alle Parameter, CTRL+Klick =
// ctlDef-Reset, SHIFT = Fine, Mausrad, Rechts-/Doppelklick = Default,
// Tooltips (TIPS-Toggle), UNDO, KICK/RUMBLE-Mute, Preset-Leiste
// (P17-Modul, neues Layout), OPTIONS/Theme (P14).
//
// DRAG-ID-REGISTRY (knob2/hslider ueber den id-Parameter; Combos sind
// Klickwidgets - ids nur der Form halber, wie im Kit ueblich):
//   1..6   FILTER   1 LOW CUT | 2 LC RES | 3 HIGH CUT | 4 HC RESO |
//                   5 DRIVE | 6 ENV DEPTH
//   10     TRIGGER   THRESHOLD
//   11..15 ENVELOPE  11 START | 12 ATTACK | 13 HOLD | 14 RELEASE |
//                   15 CURVE
//   21/22  MIX       21 OUT | 22 CEILING
//   31..33 ENGINE   31 DECAY/TONE/PITCH (je Modus) | 32 FOCUS |
//                   33 DENSE
//   41/42  FADER    41 KICK | 42 RUMBLE (hslider)
//   44..48 Combos    44 SRC | 45 ENGINE MODE | 46 CHARACTER |
//                   47 LENGTH | 48 CUT TYPE
//   CTRL+Klick / Rechtsklick / Doppelklick = Default (Kit), die
//   Undo-Klammer (uiClick -> undoMark, Release -> undoCommit) deckt
//   alles mit ab.
// ======================================================================
@gfx 1125 875

// P14/P17: Theme + Preset-Leiste - GANZ OBEN (maskieren die Maus,
// solange die OPTIONS-Box bzw. ein Leisten-Overlay offen ist)
tth_pre(); tt_pb_pre(); tth_sync(par[PG_COLOR]);
// 0.9.2: Modifier auch OHNE gedrueckte Maustaste verfolgen (SHIFT + Rad).
// SDK gfx_getchar: ein Aufruf aktiviert diesen Modus. 65536 fragt nur Fensterflags ab,
// verbraucht keine Taste der Preset-/OPTIONS-Eingabequeue und aendert kein Audio.
gfx_getchar(65536);

// P21: Kit-Frame-Start - Massstab, Fonts, Maus-Flanken (ersetzt die
// eigenen SC/OX/OY/mX/mY- und Font-Probing-Bloecke)
uikit_begin(UI_W, UI_H);
uikit_ground2();

// ---------- Undo-Klammer (Kick-Muster) ----------
// P25 (A2): die Klammer erfasste nur Edits, die mit einem Linksklick beginnen. Rechtsklick (Regler-Reset,
// Combo zurueck) und Mausrad aenderten par[] ohne Snapshot (und ohne Host-Meldung). Jetzt zusaetzlich eine
// Ein-Frame-Klammer wie in Kick ("Mausrad-Klammer"): in Frames mit Rad oder Rechtsklick und ohne gedrueckte
// linke Taste Mark hier, Commit direkt nach der Front (vor den Overlays). Commit poppt den Snapshot, wenn sich
// nichts geaendert hat (Rad ueber leerer Flaeche); sonst bleibt er und meldet den Host (tt_undo in undoCommit).
// mouse_wheel ist hier schon von tth_pre/tt_pb_pre maskiert (Kopfzeilen-Module, offene Overlays).
// Reihenfolge: erst das Drag-Ende schliessen, dann markieren (sonst schloesse ein Rad-Frame genau beim
// Loslassen den falschen Snapshot).
!uiLmb && lmbPrev ? undoCommit() : 0; // Drag-Ende: Push oder Pop
rmbOne = (uiRClk || mouse_wheel != 0) && !uiLmb;   // P25 (A2): Ein-Frame-Edit (Rechtsklick/Rad)
(uiClick || rmbOne) ? undoMark() : 0; // Edit-Beginn: Ist-Zustand pushen
strcpy(#tTipTxt, "");                 // Hover-Text pro Frame neu sammeln

// ===================================================================== Kopfzeile
// P26 (Schriftstufen): Wortmarke vor der Preset-Leiste (x 334) und ueber dem Untertitel halten - Unterkante der
// Grossbuchstaben (~0,80 Zeilenhoehe ab y 5) bleibt ueber der Oberkante des Untertitels (y 37 + ~0,24 Zeilenhoehe).
colWhite(0.96); rmbWord(18, 5, 316, (31 + 0.24*fSml/SC)/0.80, APP_NAME);
// P25 (A6): gfx_measurestr liefert Pixel, xstr erwartet Designraster - die Version stand nur bei SC = 1 und
// Schriftstufe 0 richtig (bei SC 1,15..1,5 auf dem UNDO-Knopf). Jetzt Breite / SC. Passt der lange Untertitel
// samt Version nicht vor den UNDO-Knopf (340, grosse FONT-2-Stufe), entfaellt sein zweiter Teil.
gfx_setfont(5);
strcpy(#hdrSub, "RUMBLE MACHINE  -  TECHNO LOWEND TOOLS");
gfx_measurestr(#hdrSub, uwt, uht);
gfx_measurestr(#tt_ver, vwt, uht);
20 + uwt/SC + 4 + vwt/SC > 334 ? ( strcpy(#hdrSub, "RUMBLE MACHINE"); gfx_measurestr(#hdrSub, uwt, uht); );
colDim(1); xstr(20, 37, #hdrSub);
colInk(0.55); xstr(24 + uwt/SC, 37, #tt_ver);
screw(8, 8); screw(892, 8); screw(8, 692); screw(892, 692);

// TRIG-LED (leuchtet, solange die 100-ms-Restzeit laeuft)
ledV = glo_tLed > 0 ? min2(1, eng[EC_LED]/glo_tLed) : 0;
gfx_setfont(5); colInk(1); xstrF(826, 6, 33, 40, "TRIG");   // P26: vor der LED (861) halten
ledV > 0.01 ? gfx_set(accR*ledV, accG*ledV, accB*ledV, 1)
            : tth_tn(0.10, 0.13, 0.10, 1);
xcirc(866, 12, 5, 1);
tipAt(820, 2, 56, 20, "TRIG LED: envelope triggered|Audio or MIDI, depending on SRC|100 ms latch");

// P17: Preset-Stepper < NAME > entfaellt weiterhin - die Preset-Leiste
// (tt_pb_post, unten im Block) sitzt jetzt im v2-Layout bei 340/4.
// OPTIONS 752/9.

// UNDO (Action-Button, QA-FIX v0.1.0 agy UI-F6: immer unselektiert
// zeichnen) - Muster der anderen UI-Kit-Produkte: unter der Preset-Leiste
gfx_setfont(5);
btn(340, 26, 64, 18, 0, "UNDO") ? undoPop();
// P25 (A2): Rad-Gesten und Rechtsklick-Resets zaehlen jetzt ebenfalls als Schritt
tipAt(340, 26, 64, 18, "UNDO: step back one edit (up to 19 edits)|20-slot ring, one slot reserved while clicking|Drags, wheel moves, resets and preset loads|count as one step each");

// P25 (Punkt 3): TIPS-Schalter entfaellt - EIN Schalter ist OPTIONS > TOOLTIPS ON / OFF (tth_tipoff).

// P25 (Punkt 3): Kopfzeilen-Tooltips der Module (Preset-Leiste, OPTIONS) kommen aus tt_modtips() am Ende von @gfx.
//   Luecke 2; OPTIONS 598/4, 70 breit) mit den Texten PREVIOUS / PRESET / NEXT / SAVE / MENU / OPTIONS.

// ===================================================================== v0.7.0: Variante D "Studio Analyzer"
// Nutzerauftrag 09.10.2026: das Scope ist das Hero-Element (Dual-Trace KICK IN + RUMBLE, FIXED/ROLL), darunter fuenf
// Bedienfelder in einer Reihe. Alle Regler, IDs (Registry am @gfx-Kopf), Wertformeln, Tooltips und Undo-Wege sind
// unveraendert; nur Lage und Zuschnitt der Panels aendern sich.

// Laenge der Huellkurve (LENGTH) und Sektions-Anteile (PLAN S.7: Summe > 100 % wird proportional gestaucht) - vom Scope
// (Gate-Baender) und vom ENVELOPE-Panel gemeinsam gebraucht.
ndE = min2(6, max2(0, floor(par[PM_ELEN] + 0.5)));
lenName(ndE);
emult = ndE < 0.5 ? 4 : ndE < 1.5 ? 2 : ndE < 2.5 ? 1 : ndE < 3.5 ? 0.6666667
      : ndE < 4.5 ? 0.5 : ndE < 5.5 ? 0.3333333 : 0.25;
s1v = max2(0, par[PM_ESTA]); s2v = max2(0, par[PM_EATT]);
s3v = max2(0, par[PM_EHLD]); s4v = max2(0, par[PM_EREL]);
esum = s1v + s2v + s3v + s4v;
// Nur die kleine Kurvengrafik normieren, niemals die DSP-Zeiten.
escl = 1000/max2(esum, 0.001);
s1v *= escl; s2v *= escl; s3v *= escl; s4v *= escl;

// ===================================================================== SCOPE
panel2(8, 56, 884, 296, "SCOPE  //  KICK IN + RUMBLE");
lvDb = 20*log(max2(0.000001, eng[EC_FST]))*0.43429448;   // Follower-Pegel in dBFS (Scope-Status, LEVEL-Leiste, Anzeigen)
rmbScopeDraw(16, 80, 868, 220);
tipAt(16, 80, 868, 220, "SCOPE: KICK IN (white) and RUMBLE (accent) on one scale|FIXED: one bar stands still, a cursor redraws it - ROLL: left = oldest, right = now|Bands = gate window of the envelope, dotted line = GATE");

// Softkeys: Spuren ein/aus, Ansicht. Reine Anzeigeeinstellungen (nicht im Projekt gespeichert, kein Undo-Punkt).
gfx_setfont(5);
rmbTgl(16, 306, 78, 18, scShK > 0.5, "KICK") ? scShK = 1 - scShK : 0;
rmbTgl(98, 306, 92, 18, scShR > 0.5, "RUMBLE") ? scShR = 1 - scShR : 0;
rmbTgl(194, 306, 68, 18, scShS > 0.5, "SUM") ? scShS = 1 - scShS : 0;
rmbTgl(266, 306, 72, 18, scShG > 0.5, "GATE") ? scShG = 1 - scShG : 0;
btn(354, 306, 66, 18, scMode < 0.5, "FIXED") ? scMode = 0 : 0;
btn(424, 306, 66, 18, scMode > 0.5, "ROLL") ? scMode = 1 : 0;
tipAt(16, 306, 78, 18, "KICK IN trace on/off|The incoming kick, mono mid, before the KICK fader");
tipAt(98, 306, 92, 18, "RUMBLE trace on/off|The rumble after AUTO GAIN and the RUMBLE fader");
tipAt(194, 306, 68, 18, "SUM trace on/off|The final output (after OUT and CLIPPER, before the safety clamp)");
tipAt(266, 306, 72, 18, "GATE line on/off|The envelope value that gates the engine, 1.0 = 0 dB line");
tipAt(354, 306, 66, 18, "FIXED: one bar stands still|A cursor sweeps from left to right and redraws the trace");
tipAt(424, 306, 66, 18, "ROLL: the trace scrolls|Left = oldest, right = now");

// Anzeigen unter dem Schirm: T, SUM, AG, CLIP, LVL/THR
gfx_setfont(5);
colInk(0.8);
sprintf(#vstr, "T = %dMS", floor(esum + 0.5));
xrawF(16, 332, 96, 16, #vstr);
tipAt(16, 330, 96, 16, "T: START + ATTACK + HOLD + RELEASE in ms|The four times are independent of tempo");
sprintf(#vstr, "GRID %dMS", floor(rmbNoteMs(ndE, g_bpm) + 0.5));
colInk(0.8);
xrawF(118, 332, 110, 16, #vstr);
tipAt(118, 330, 110, 16, "GRID: reference note duration at the current tempo|FIT TO scales the stages only when selected|Gate bands repeat on this reference grid");
colInk(0.8);
sprintf(#vstr, "AG %d%%", floor(eng[EC_AGV]*100 + 0.5));
xrawF(234, 332, 70, 16, #vstr);
tipAt(234, 330, 70, 16, "AG: current auto gain value|CLIP LED: signal exceeded the ceiling (100 ms latch)");
clpOn = eng[EC_CLPL] >= 0 && (g_pos - eng[EC_CLPL]) < 0.1*srate;
clpOn ? colWarn(0.95) : gfx_set(tth_alR*0.14, tth_alG*0.17094, tth_alB*0.24931, 1);
xcirc(316, 340, 4, 1);
colInk(0.9); xstrF(326, 332, 40, 16, "CLIP");
// 0.9.3: Tooltip fuer die CLIP-Anzeige (vorher Luecke zwischen AG und TEMPO).
tipAt(308, 330, 62, 16, "CLIP LED: lights for 100 ms when the signal exceeded the ceiling|Ceiling and CLIPPER are set in the MIX panel");
// Tempo-Umrechnung (v0.7.0, aus dem BPM2MS2HZ-Calculator): Host-BPM und die Laenge von 1/2, 1/4 und 1/8 in ms und Hz.
// Formeln wie dort: ms = 60000 / BPM * Schlaege (1/2 = 2, 1/4 = 1, 1/8 = 0,5), Hz = 1000 / ms. g_bpm = Host-Tempo (unter 10 BPM: 120).
gfx_setfont(5);
colAcid(1);
sprintf(#vstr, "%.1f BPM", g_bpm);
xrawF(388, 332, 72, 16, #vstr);
tpK = 0;
loop(3,
  tpBt = tpK == 0 ? 2 : tpK == 1 ? 1 : 0.5;
  tpMs = 60000/max2(g_bpm, 1)*tpBt;
  tpX  = 468 + tpK*136;
  colDim(0.5); xline(tpX - 5, 333, tpX - 5, 345);
  colInk(0.55); strcpy(#vstr, tpK == 0 ? "1/2" : tpK == 1 ? "1/4" : "1/8");
  xstrF(tpX, 332, 22, 16, #vstr);
  colInk(0.92); sprintf(#vstr, "%.1f MS", tpMs);
  xrawF(tpX + 22, 332, 58, 16, #vstr);
  colAcid(0.9); sprintf(#vstr, "%.3f HZ", 1000/tpMs);
  xrawF(tpX + 82, 332, 52, 16, #vstr);
  tpK += 1;
);
tipAt(388, 330, 488, 16, "TEMPO: host BPM and the length of 1/2, 1/4 and 1/8 notes in ms and Hz|ms = 60000 / BPM x beats, Hz = 1000 / ms|Same maths as the BPM2MS2HZ calculator");

// ===================================================================== TRIGGER
panel2(8, 360, 128, 298, "TRIGGER");

// THRESHOLD (ID 10), Anzeige in dBFS
nv = knob2(10, 72, 424, 13, par[PM_TTHR], 0, 1000, ctlDef(PM_TTHR));
nvw = floor(nv + 0.5);
nvw != par[PM_TTHR] ? ( par[PM_TTHR] = nvw; ) : 0;
// P26 (Schriftstufen): Beschriftung/Wert auf die Spaltenbreite halten.
gfx_setfont(5); colInk(0.85); xctrF(24, 394, 96, 12, 96, 24, "THRESHOLD");
sprintf(#vstr, "%.1f DB", -60 + 60*par[PM_TTHR]*0.001);
colAcid(1); xctrF(24, 440, 96, 12, 96, 24, #vstr);
tipAt(48, 396, 48, 64, "THRESHOLD: audio trigger level, -60 to 0 dBFS|Follower must drop ~3 dB under it to re-arm|CTRL+click: reset");

// SOURCE 3-stufig (PM_TSRC): AUDIO / AUDIO+MIDI / MIDI
gfx_setfont(5); colInk(0.85); xstrF(16, 466, 112, 14, "SOURCE");
tsrc = min2(2, max2(0, floor(par[PM_TSRC] + 0.5)));
strcpy(#cmb_txt, tsrc == 0 ? "AUDIO" : tsrc == 1 ? "AUDIO+MIDI" : "MIDI");
csel = combo(44, 16, 480, 112, 20, tsrc, 3);
csel != tsrc ? ( par[PM_TSRC] = csel; ) : 0;
tipAt(16, 466, 112, 34, "SOURCE: trigger source|AUDIO = input follower only|A+M = follower plus MIDI notes - MIDI = notes only");

// LEVEL-Leiste: Follower-Pegel log (-60..0 dBFS), helle Marke = Schwelle
gfx_setfont(5); colInk(0.85); xstrF(16, 512, 112, 14, "LEVEL");
lvF  = min2(1, max2(0, (lvDb + 60)*0.0166667));
thrF = min2(1, max2(0, par[PM_TTHR]*0.001));
tth_tn(0.092, 0.097, 0.092, 1); xrect(16, 526, 112, 12);
lvF > 0 ? (
  colDim(0.9); xrect(16, 528, 112*min2(lvF, thrF), 8);
  lvF > thrF ? ( colAcid(0.9); xrect(16 + 112*thrF, 528, 112*(lvF - thrF), 8); ) : 0;
) : 0;
colWhite(0.85); xrect(16 + 112*thrF, 523, 1, 18);
tipAt(16, 510, 112, 32, "LEVEL: input follower, log -60 to 0 dBFS|White line = THRESHOLD|Above the line the trigger can fire");

// Trennlinie, dann TRIG-LED gross + Pegelwerte
colDim(0.6); xline(16, 554, 128, 554);
ledV = glo_tLed > 0 ? min2(1, eng[EC_LED]/glo_tLed) : 0;
ledV > 0.01 ? gfx_set(accR*ledV, accG*ledV, accB*ledV, 1)
            : tth_tn(0.10, 0.13, 0.10, 1);
xcirc(32, 574, 6, 1);
ledV > 0.01 ? ( gfx_set(0, 0, 0, 0.55); xcirc(32, 574, 2.6, 1); ) : 0;
gfx_setfont(5); colInk(1); xstr(46, 568, "TRIG");
tipAt(22, 564, 52, 20, "TRIG LED: envelope triggered|100 ms latch");
// P26 (Schriftstufen): im Panel halten.
colInk(0.75);
sprintf(#vstr, "LVL %.0f  THR %.1f", max2(lvDb, -60), -60 + 60*par[PM_TTHR]*0.001);
xrawF(16, 592, 112, 16, #vstr);
tipAt(16, 590, 112, 16, "LVL: input follower level in dBFS|THR: the current THRESHOLD in dBFS");
colInk(0.45);
xstrF(16, 618, 112, 16, "FOLLOWER MUST FALL");
xstrF(16, 632, 112, 16, "3 DB TO RE-ARM");

// ===================================================================== ENGINE
panel2(144, 360, 180, 298, "ENGINE");

uiSel = min2(2, max2(0, floor(par[PM_ENG] + 0.5)));
chrI = min2(2, max2(0, floor(par[PM_CHR] + 0.5)));

// MODE (PM_ENG): VERB / NOISE / PITCH
gfx_setfont(5); colInk(0.85); xstrF(152, 388, 164, 14, "MODE");
strcpy(#cmb_txt, uiSel == 0 ? "VERB" : uiSel == 1 ? "NOISE" : "PITCH");
csel = combo(45, 152, 402, 164, 20, uiSel, 3);
csel != uiSel ? ( par[PM_ENG] = csel; ) : 0;
tipAt(152, 388, 164, 34, "ENGINE: rumble source|VERB = feedback-delay network on the kick|NOISE = colored noise bed|PITCH = the kick itself, shifted down");

// CHARACTER (PM_CHR): Label je Engine
gfx_setfont(5); colInk(0.85); xstrF(152, 432, 164, 14, "CHARACTER");
chrName(uiSel, chrI);
strcpy(#cmb_txt, #cstr);
csel = combo(46, 152, 446, 164, 20, chrI, 3);
csel != chrI ? ( par[PM_CHR] = csel; ) : 0;
uiSel == 0 ? tipAt(152, 432, 164, 34, "CHARACTER: MODAL rings tonal|WALL short and dense|BLOOM swells slow, T60 x1.5")
: uiSel == 1 ? tipAt(152, 432, 164, 34, "CHARACTER: CLASSIC dark cascade|GRIT clipped white noise|RUBBLE bandpass growl")
: tipAt(152, 432, 164, 34, "CHARACTER: window size of the pitch engine|TIGHT x0.5 fast - DEEP x1 - GRAIN x2 lo-fi");

// Engine-Knoepfe: nicht genutzte werden ausgeblendet (Registry 31..33)
uiSel == 0 ? (
  nv = knob2(31, 182, 526, 14, par[PM_VDEC], 0, 1000, ctlDef(PM_VDEC));
  nvw = floor(nv + 0.5);
  nvw != par[PM_VDEC] ? ( par[PM_VDEC] = nvw; ) : 0;
  gfx_setfont(5); colInk(0.85); xctrF(152, 497, 60, 12, 60, 24, "DECAY");
  sprintf(#vstr, "%.1f S", 0.2*pow(40, par[PM_VDEC]*0.001));
  colAcid(1); xctrF(152, 543, 60, 12, 60, 24, #vstr);
  tipAt(158, 500, 48, 52, "DECAY: reverb T60, 0.2-8 s|How long the rumble rings out|CTRL+click: reset");

  nv = knob2(32, 234, 526, 14, par[PM_VFOC], 0, 1000, ctlDef(PM_VFOC));
  nvw = floor(nv + 0.5);
  nvw != par[PM_VFOC] ? ( par[PM_VFOC] = nvw; ) : 0;
  colInk(0.85); xctrF(204, 497, 60, 12, 60, 24, "FOCUS");
  // QA-FIX v0.1.0 (agy UI-F3): Parameterwert anzeigen (40..400 Hz), nicht
  // die interne Doppel-Frequenz des Damping-LPs (2*FOCUS = 80..800 Hz).
  sprintf(#vstr, "%d HZ", floor(40*pow(10, par[PM_VFOC]*0.001) + 0.5));
  colAcid(1); xctrF(204, 543, 60, 12, 60, 24, #vstr);
  tipAt(210, 500, 48, 52, "FOCUS: damping pivot, 40-400 Hz|Lower = darker room (x2 inside the verb)|CTRL+click: reset");

  nv = knob2(33, 286, 526, 14, par[PM_VDEN], 0, 1000, ctlDef(PM_VDEN));
  nvw = floor(nv + 0.5);
  nvw != par[PM_VDEN] ? ( par[PM_VDEN] = nvw; ) : 0;
  colInk(0.85); xctrF(256, 497, 60, 12, 60, 24, "DENSE");
  sprintf(#vstr, "%d%%", floor(par[PM_VDEN]*0.1 + 0.5));
  colAcid(1); xctrF(256, 543, 60, 12, 60, 24, #vstr);
  tipAt(262, 500, 48, 52, "DENSE: diffusion of the verb, 0-100%|Low = sparser comb tails|CTRL+click: reset");
) : uiSel == 1 ? (
  nv = knob2(31, 234, 526, 14, par[PM_NTON], 0, 1000, ctlDef(PM_NTON));
  nvw = floor(nv + 0.5);
  nvw != par[PM_NTON] ? ( par[PM_NTON] = nvw; ) : 0;
  gfx_setfont(5); colInk(0.85); xctrF(204, 497, 60, 12, 60, 24, "TONE");
  sprintf(#vstr, "%d HZ", floor(40*pow(50, par[PM_NTON]*0.001) + 0.5));
  colAcid(1); xctrF(204, 543, 60, 12, 60, 24, #vstr);
  tipAt(210, 500, 48, 52, "TONE: noise colour, 40-2000 Hz|CLASSIC = filter freq, GRIT = drive, RUBBLE = band middle|CTRL+click: reset");
  // 0.9.3 (Nutzerwunsch 15.10.2026): TONE als Taste. Anzeige = naechste Note (MIDI 69 = A4 = 440 Hz); "-"/"+" setzen TONE
  // auf die naechstniedrigere/-hoehere Note (steht TONE schon auf einer Note, genau einen Halbton weiter), geklemmt 40..2000 Hz.
  rmbKyF = 40*pow(50, par[PM_NTON]*0.001);
  rmbKyN = 69 + 12*log(rmbKyF/440)/log(2);
  rmbKyR = floor(rmbKyN + 0.5);
  rmbKyC = floor((rmbKyN - rmbKyR)*100 + 0.5);
  rmbKyO = floor(rmbKyR/12) - 1;
  rmbKyI = rmbKyR - 12*floor(rmbKyR/12);
  strcpy(#rmbKy, abs(rmbKyC) > 8 ? "~" : "");
  strcat(#rmbKy, rmbKyI == 0 ? "C" : rmbKyI == 1 ? "C#" : rmbKyI == 2 ? "D" : rmbKyI == 3 ? "D#" : rmbKyI == 4 ? "E"
    : rmbKyI == 5 ? "F" : rmbKyI == 6 ? "F#" : rmbKyI == 7 ? "G" : rmbKyI == 8 ? "G#" : rmbKyI == 9 ? "A"
    : rmbKyI == 10 ? "A#" : "B");
  sprintf(#vstr, "%d", rmbKyO);
  strcat(#rmbKy, #vstr);
  gfx_setfont(5); colInk(0.9); xctrF(220, 558, 28, 14, 28, 14, #rmbKy);
  // TONE liegt auf 1-Promille-Raster (~0,056 Halbton): eine gesetzte Note kann bis 0,03 st daneben liegen. Toleranz 0,1 st, sonst
  // meint der naechste Tastendruck dieselbe Note und es passiert nichts (Nutzerbefund 15.10.2026).
  rmbKyD = 0;
  btn(204, 558, 16, 14, 0, "-") ? rmbKyD = ceil(rmbKyN - 0.1) - 1 : 0;
  btn(248, 558, 16, 14, 0, "+") ? rmbKyD = floor(rmbKyN + 0.1) + 1 : 0;
  rmbKyD != 0 ? (
    rmbKyF = min2(2000, max2(40, 440*pow(2, (rmbKyD - 69)/12)));
    nvw = floor(1000*log(rmbKyF/40)/log(50) + 0.5);
    nvw != par[PM_NTON] ? ( par[PM_NTON] = nvw; ) : 0;   // Undo ueber die Klick-Klammer wie bei den Auswahlfeldern
  ) : 0;
  tipAt(204, 556, 60, 18, "KEY: the note nearest to TONE (A4 = 440 Hz, ~ = more than 8 cents off)|- / +: TONE to the next lower / higher note");
) : (
  // P26 (Review A4 b, Nutzerfreigabe): PITCH rastet auf ganze Halbtoene - Schrittweite 1000/24 Promille (Kit-
  // knob2st: Ziehen rastet, eine Mausrad-Raste = 1 st). Ein Altwert ausserhalb des Rasters (z. B. 490 = -11,76 st
  // aus v0.5.5) bleibt beim Laden unveraendert und klingt wie bisher; erst die naechste Drehung zieht ihn auf
  // eine Raste. Ziehen liefert schon Rasterwerte; das Rad addiert vom Altwert aus (490 + 1 Raste = -12,76 st) -
  // dann zur ersten Raste in Drehrichtung (hoch: abrunden, runter: aufrunden; -11,76 -> -12 bzw. -11).
  // Gespeichert wird weiter die ganze Promille-Zahl (floor + 0,5): Restfehler <= 0,34 Promille = 0,8 Cent,
  // 500 bleibt exakt -12 st.
  nv = knob2st(31, 234, 526, 14, par[PM_PSEM], 0, 1000, ctlDef(PM_PSEM), 1000/24);
  nv != par[PM_PSEM] ? (
    psk = nv*0.024;                                  // Halbtoene (positiv = nach unten)
    // "auf dem Raster" mit Toleranz 0,02 st: gespeicherte Rasterwerte sind auf ganze Promille gerundet (83 =
    // 1,992 st) - ohne Toleranz blieb das Rad dort haengen (Orakel p26_orakel.py PITCH).
    abs(psk - floor(psk + 0.5)) < 0.02 ? ( psk = floor(psk + 0.5); )
    : ( psk = nv > par[PM_PSEM] ? floor(psk) : ceil(psk); );
    nv = psk/0.024;
  ) : 0;
  nvw = floor(nv + 0.5);
  nvw != par[PM_PSEM] ? ( par[PM_PSEM] = nvw; ) : 0;
  gfx_setfont(5); colInk(0.85); xctrF(204, 497, 60, 12, 60, 24, "PITCH");
  // P25 (A4): eine Nachkommastelle - der Regler spielte stufenlos (Promille, 0,024 st je Einheit), die alte
  // Ganzzahl-Anzeige verdeckte bis +-0,5 st. P26: Rastung umgesetzt; die Nachkommastelle bleibt, damit ein
  // Altwert ausserhalb des Rasters ehrlich angezeigt wird (gerastete Werte zeigen ".0").
  psv = 24*par[PM_PSEM]*0.001;
  psv < 0.05 ? strcpy(#vstr, "0.0 ST") : sprintf(#vstr, "-%.1f ST", psv);
  colAcid(1); xctrF(204, 543, 60, 12, 60, 24, #vstr);
  tipAt(210, 500, 48, 52, "PITCH: whole semitones down, 0..-24|One wheel notch = one semitone|0 passes through at equal latency|CTRL+click: reset");
);

// Engine-Kurzinfo (reine Anzeige)
// P26 (Schriftstufen): Infozeilen im Panel halten (x 152..316, Zeilenhoehe <= 20 bei 14er Abstand).
gfx_setfont(5); colInk(0.55);
uiSel == 0 ? (
  xstrF(152, 576, 164, 20, "FEEDBACK-DELAY NETWORK");
  xstrF(152, 590, 164, 20, "ON THE KICK");
  xstrF(152, 604, 164, 20, "EXCITER LOW-PASS 200 HZ");
  chrI == 0 ? xstrF(152, 618, 164, 20, "MODAL: COMBS RING TONAL")
  : chrI == 1 ? xstrF(152, 618, 164, 20, "WALL: SHORT AND DIFFUSE")
  : xstrF(152, 618, 164, 20, "BLOOM: T60 X1.5, SOFT ATTACK");
) : uiSel == 1 ? (
  xstrF(152, 576, 164, 20, "COLORED NOISE RUMBLE (LCG)");
  chrI == 0 ? xstrF(152, 590, 164, 20, "CLASSIC: 3X ONE-POLE CASCADE")
  : chrI == 1 ? xstrF(152, 590, 164, 20, "GRIT: CLIPPED WHITE NOISE")
  : xstrF(152, 590, 164, 20, "RUBBLE: BANDPASS, Q ~1.4");
) : (
  xstrF(152, 576, 164, 20, "THE KICK ITSELF, PITCHED DOWN");
  xstrF(152, 590, 164, 20, "DUAL READ HEADS, HANN XFADE");
  colInk(0.75);
  sprintf(#vstr, "ENV LAG ~%dMS (W/2)", floor(glo_pHlf*1000/srate + 0.5));
  xrawF(152, 604, 164, 20, #vstr);
);
colInk(0.45);
xstrF(152, 633, 164, 16, "ENGINE SWITCH FLUSHES BUFFERS");
// 0.9.3: LATENCY AUTO / FIXED + gemeldete Latenz in ms (PDC). Ausserhalb par[0..27] -> tt_undo() selbst.
gfx_setfont(5);
btn(152, 641, 78, 16, par[PG_LAT] > 0.5, par[PG_LAT] > 0.5 ? "LAT FIXED" : "LAT AUTO") ? ( par[PG_LAT] = par[PG_LAT] > 0.5 ? 0 : 1; tt_undo(); ) : 0;
colAcid(1); sprintf(#vstr, "%.1f MS", rmbLtot*1000/srate);
xctrF(234, 641, 82, 16, 82, 16, #vstr);
tipAt(152, 639, 164, 20, "LATENCY: delay reported to the host (PDC) so kick and rumble start together at START 0 ms|AUTO = PITCH delays the kick by half its window, VERB/NOISE 0 ms|FIXED = always one window, never changes when engine or character is switched");

// ===================================================================== ENVELOPE
panel2(332, 360, 200, 298, "ENVELOPE");

// Knoepfe obere Reihe (IDs 11..13)
nvw = rmbTimeKnob(11, 372, 424, par[PM_ESTA], ctlDef(PM_ESTA));
nvw != par[PM_ESTA] ? ( par[PM_ESTA] = nvw; ) : 0;
gfx_setfont(5); colInk(0.85); xctrF(342, 395, 60, 12, 60, 24, "START");
sprintf(#vstr, "%.1fms", par[PM_ESTA]);
colAcid(1); xctrF(342, 441, 60, 12, 60, 24, #vstr);
tipAt(348, 398, 48, 52, "START: delay before attack, 0-24000 ms|Wheel: 1 ms / SHIFT+wheel: 0.1 ms|CTRL+click: reset");

nvw = rmbTimeKnob(12, 432, 424, par[PM_EATT], ctlDef(PM_EATT));
nvw != par[PM_EATT] ? ( par[PM_EATT] = nvw; ) : 0;
colInk(0.85); xctrF(402, 395, 60, 12, 60, 24, "ATTACK");
sprintf(#vstr, "%.1fms", par[PM_EATT]);
colAcid(1); xctrF(402, 441, 60, 12, 60, 24, #vstr);
tipAt(408, 398, 48, 52, "ATTACK: swell time, 0-24000 ms|Wheel: 1 ms / SHIFT+wheel: 0.1 ms|CTRL+click: reset");

nvw = rmbTimeKnob(13, 492, 424, par[PM_EHLD], ctlDef(PM_EHLD));
nvw != par[PM_EHLD] ? ( par[PM_EHLD] = nvw; ) : 0;
colInk(0.85); xctrF(462, 395, 60, 12, 60, 24, "HOLD");
sprintf(#vstr, "%.1fms", par[PM_EHLD]);
colAcid(1); xctrF(462, 441, 60, 12, 60, 24, #vstr);
tipAt(468, 398, 48, 52, "HOLD: full-level time, 0-24000 ms|Wheel: 1 ms / SHIFT+wheel: 0.1 ms|CTRL+click: reset");

// Knoepfe untere Reihe (IDs 14/15)
nvw = rmbTimeKnob(14, 372, 506, par[PM_EREL], ctlDef(PM_EREL));
nvw != par[PM_EREL] ? ( par[PM_EREL] = nvw; ) : 0;
colInk(0.85); xctrF(342, 477, 60, 12, 60, 24, "RELEASE");
sprintf(#vstr, "%.1fms", par[PM_EREL]);
colAcid(1); xctrF(342, 523, 60, 12, 60, 24, #vstr);
tipAt(348, 480, 48, 52, "RELEASE: fall time, 0-24000 ms|Wheel: 1 ms / SHIFT+wheel: 0.1 ms|CTRL+click: reset");

nv = knob2(15, 432, 506, 13, par[PM_ECRV], -500, 500, ctlDef(PM_ECRV));
nvw = floor(nv + 0.5);
nvw != par[PM_ECRV] ? ( par[PM_ECRV] = nvw; ) : 0;
colInk(0.85); xctrF(402, 477, 60, 12, 60, 24, "CURVE");
cv = floor(par[PM_ECRV] + 0.5);
cv > 0 ? sprintf(#vstr, "+%d", cv) : sprintf(#vstr, "%d", cv);
colAcid(1); xctrF(402, 523, 60, 12, 60, 24, #vstr);
tipAt(408, 480, 48, 52, "CURVE: shapes attack + release|- sharp knee, long tail / + fast snap|CTRL+click: reset");

// LENGTH (PM_ELEN): v2-Combo - Pfeile = alter Stepper, Mittelklick = Umlauf
gfx_setfont(5); colInk(0.85); xstrF(460, 477, 64, 14, "FIT TO");
strcpy(#cmb_txt, #lstr);
csel = combo(47, 460, 491, 64, 20, ndE, 7);
csel != ndE ? ( rmbFitTimes(csel); ndE = csel; lenName(ndE); ) : 0;
tipAt(460, 477, 64, 34, "FIT TO: scale the four times once to a note|Uses the current tempo, 1/1 to 1/16|Tempo changes do not alter stored ms");

// T_total in Musikzeit (Anzeige); die Zahl steht auch unter dem Scope
// P26 (Schriftstufen): im Panel halten.
gfx_setfont(5); colInk(0.75);
sprintf(#vstr, "T = %dMS", floor(esum + 0.5));
btn(460, 518, 64, 20, 0, "FIT NOW") ? rmbFitTimes(ndE);
tipAt(460, 516, 64, 22, "FIT NOW: scale times to the selected note|Reapply after editing times or changing tempo|The proportions stay the same");

// Kurvenvorschau (idealisierte AHDR-Kurve aus envV(), Anzeige): Sektionsgrenzen + Kurve
tth_tn(0.042, 0.048, 0.042, 1); xrect(340, 550, 184, 70);
colDim(0.45);
xline(340, 585, 524, 585);
eb1 = 340 + s1v*0.184;
eb2 = 340 + (s1v + s2v)*0.184;
eb3 = 340 + (s1v + s2v + s3v)*0.184;
eb4 = 340 + (s1v + s2v + s3v + s4v)*0.184;
tth_tn(0.30, 0.55, 0.24, 1);
xline(eb1, 550, eb1, 620); xline(eb2, 550, eb2, 620);
xline(eb3, 550, eb3, 620); xline(eb4, 550, eb4, 620);
gfx_setfont(5); colInk(0.5);
s1v >= 80 ? xctr(340, 552, s1v*0.184, 10, "S") : 0;
s2v >= 80 ? xctr(eb1, 552, s2v*0.184, 10, "A") : 0;
s3v >= 80 ? xctr(eb2, 552, s3v*0.184, 10, "H") : 0;
s4v >= 80 ? xctr(eb3, 552, s4v*0.184, 10, "R") : 0;
ep = pow(2, 3*par[PM_ECRV]*0.002);
colAcid(1);
ek = 0;
gfx_x = OX + 340*SC;
gfx_y = OY + (618 - envV(0, s1v, s2v, s3v, s4v, ep)*64)*SC;
loop(92,
  ek += 1;
  efp = ek*2000/184;
  evv = envV(efp, s1v, s2v, s3v, s4v, ep);
  gfx_lineto(OX + (340 + ek*2)*SC, OY + (618 - evv*64)*SC, 1);
);
ek = 0;
gfx_x = OX + 340*SC;
gfx_y = OY + (619 - envV(0, s1v, s2v, s3v, s4v, ep)*64)*SC;
loop(92,
  ek += 1;
  efp = ek*2000/184;
  evv = envV(efp, s1v, s2v, s3v, s4v, ep);
  gfx_lineto(OX + (340 + ek*2)*SC, OY + (619 - evv*64)*SC, 1);
);
tipAt(340, 550, 184, 70, "AHDR curve over the whole LENGTH|START delay - ATTACK - HOLD - RELEASE (each in ms, 0-24000)|Times are independent of tempo; FIT TO scales them|Read-only display");
// Infozeile (P26: Schriftstufen)
gfx_setfont(5); colInk(0.45);
xstrF(340, 626, 184, 16, "START DELAYS THE ATTACK - THE");
xstrF(340, 639, 184, 16, "KICK PUNCH STAYS CLEAR");

// ===================================================================== FILTER
panel2(540, 360, 196, 298, "FILTER");

// Reihe 1 (IDs 1..3)
// P26 (Schriftstufen): Beschriftungen/Werte je Spalte begrenzt.
nv = knob2(1, 578, 424, 14, par[PM_FLC], 0, 1000, ctlDef(PM_FLC));
nvw = floor(nv + 0.5);
nvw != par[PM_FLC] ? ( par[PM_FLC] = nvw; ) : 0;
gfx_setfont(5); colInk(0.85); xctrF(548, 395, 60, 12, 60, 24, "LOW CUT");
sprintf(#vstr, "%d HZ", floor(20*pow(10, par[PM_FLC]*0.001) + 0.5));
colAcid(1); xctrF(548, 441, 60, 12, 60, 24, #vstr);
tipAt(554, 398, 48, 52, "LOW CUT: resonant high-pass, 20-200 Hz|Cleans kick-click from the rumble top|CTRL+click: reset");

nv = knob2(2, 638, 424, 14, par[PM_FLCR], 0, 1000, ctlDef(PM_FLCR));
nvw = floor(nv + 0.5);
nvw != par[PM_FLCR] ? ( par[PM_FLCR] = nvw; ) : 0;
colInk(0.85); xctrF(608, 395, 60, 12, 60, 24, "LC RES");
sprintf(#vstr, "Q%.1f", 0.5*pow(16, par[PM_FLCR]*0.001));
colAcid(1); xctrF(608, 441, 60, 12, 60, 24, #vstr);
tipAt(614, 398, 48, 52, "LC RES: resonance of the low cut, Q 0.5-8|A tuned bump that can sing|CTRL+click: reset");

nv = knob2(3, 698, 424, 14, par[PM_FHC], 0, 1000, ctlDef(PM_FHC));
nvw = floor(nv + 0.5);
nvw != par[PM_FHC] ? ( par[PM_FHC] = nvw; ) : 0;
colInk(0.85); xctrF(668, 395, 60, 12, 60, 24, "HIGH CUT");
sprintf(#vstr, "%d HZ", floor(30*pow(66.6667, par[PM_FHC]*0.001) + 0.5));
colAcid(1); xctrF(668, 441, 60, 12, 60, 24, #vstr);
tipAt(674, 398, 48, 52, "HIGH CUT: low-pass on the rumble, 30-2000 Hz|Typical techno spot is 40-120 Hz|CTRL+click: reset");

// Reihe 2 (IDs 4..6)
nv = knob2(4, 578, 506, 14, par[PM_FHCR], 0, 1000, ctlDef(PM_FHCR));
nvw = floor(nv + 0.5);
nvw != par[PM_FHCR] ? ( par[PM_FHCR] = nvw; ) : 0;
colInk(0.85); xctrF(548, 477, 60, 12, 60, 24, "HC RESO");
sprintf(#vstr, "Q%.1f", 0.5*pow(16, par[PM_FHCR]*0.001));
colAcid(1); xctrF(548, 523, 60, 12, 60, 24, #vstr);
tipAt(554, 480, 48, 52, "HC RESO: resonance of the high cut, Q 0.5-8|Adds a whistle edge to the sweep|CTRL+click: reset");

nv = knob2(5, 638, 506, 14, par[PM_FDRV], 0, 1000, ctlDef(PM_FDRV));
nvw = floor(nv + 0.5);
nvw != par[PM_FDRV] ? ( par[PM_FDRV] = nvw; ) : 0;
colInk(0.85); xctrF(608, 477, 60, 12, 60, 24, "DRIVE");
sprintf(#vstr, "%d%%", floor(par[PM_FDRV]*0.1 + 0.5));
colAcid(1); xctrF(608, 523, 60, 12, 60, 24, #vstr);
tipAt(614, 480, 48, 52, "DRIVE: parallel saturation band around 140 Hz|Thickens the rumble, 0 = bit-exact bypass|CTRL+click: reset");

nv = knob2(6, 698, 506, 14, par[PM_FDEP], 0, 1000, ctlDef(PM_FDEP));
nvw = floor(nv + 0.5);
nvw != par[PM_FDEP] ? ( par[PM_FDEP] = nvw; ) : 0;
colInk(0.85); xctrF(668, 477, 60, 12, 60, 24, "ENV DEPTH");
sprintf(#vstr, "%.1f OCT", 4*par[PM_FDEP]*0.001);
colAcid(1); xctrF(668, 523, 60, 12, 60, 24, #vstr);
tipAt(674, 480, 48, 52, "ENV DEPTH: envelope opens the high cut|0-4 octaves up with the swell|CTRL+click: reset");

// CUT TYPE (PM_FCHR): CLEAN / COMB / DIRTY
colInk(0.85); xstrF(548, 548, 180, 14, "CUT TYPE");
fchr = min2(2, max2(0, floor(par[PM_FCHR] + 0.5)));
strcpy(#cmb_txt, fchr == 0 ? "CLEAN" : fchr == 1 ? "COMB" : "DIRTY");
csel = combo(48, 548, 562, 180, 20, fchr, 3);
csel != fchr ? ( par[PM_FCHR] = csel; ) : 0;
tipAt(548, 548, 180, 34, "CUT TYPE: high-cut character|CLEAN = linear SVF|COMB adds a 35% delay line at the cutoff|DIRTY = stabilized tanh SVF");

// Infozeilen
// P26 (Schriftstufen): im Panel halten (x 548..728, letzte Zeile ueber dem Panelboden 658).
gfx_setfont(5); colInk(0.55);
xstrF(548, 592, 180, 20, "LC: RESONANT HP ON THE RUMBLE TOP");
xstrF(548, 606, 180, 20, "HC TRACKS THE ENVELOPE (ENV DEPTH)");
xstrF(548, 620, 180, 20, "COMB: +35% DELAY LINE AT THE CUTOFF");
colInk(0.45);
xstrF(548, 636, 180, 16, "CTRL+CLICK: RESET KNOB - SHIFT: FINE-DRAG");

// ===================================================================== MIX
panel2(744, 360, 148, 298, "MIX");

// KICK/RUMBLE: v2-hslider + Mute-Toggles (P15)
// btn-Schalter). Fader-Werte in Promille (mPm), gedimmt bei Mute.
// P25 (A1): die Mute-Schalter liegen ausserhalb des eigenen Undo-Rings (undoDiffers prueft nur 0..27) - ihre
// Aenderung meldet tt_undo() dem Host direkt (Undo-Punkt, Projekt geaendert).
// P26 (Schriftstufen): Schalter ueber rmbTgl (Beschriftung rechts der LED eingepasst).
rmbTgl(752, 392, 70, 18, par[PM_KON] > 0.5, "KICK")
  ? ( par[PM_KON] = 1 - par[PM_KON]; tt_undo(); ) : 0;
nv = hslider(41, 752, 418, 132, 14, par[PM_MKCK]*0.001, 0, 1, ctlDef(PM_MKCK)*0.001);
par[PM_MKCK] = mPm(nv, par[PM_MKCK]);
par[PM_KON] > 0.5 ? colAcid(1) : colInk(0.35);
sprintf(#vstr, "%d%%", floor(par[PM_MKCK]*0.1 + 0.5));
gfx_setfont(5); xrawF(826, 394, 58, 16, #vstr);
par[PM_KON] > 0.5 ? 0 : ( tth_tn(0.05, 0.055, 0.05, 0.62); xrect(748, 414, 140, 22); );
tipAt(826, 392, 58, 20, "KICK level readout in percent|Drag the fader below to change it");   // 0.9.3: Tooltip-Luecke der %-Anzeige
tipAt(752, 392, 70, 18, "KICK on/off: mutes the dry kick output|Trigger and engine keep running|Not part of presets");
tipAt(752, 414, 132, 22, "KICK: dry kick level, 0-100%|CTRL+click: reset");

rmbTgl(752, 446, 70, 18, par[PM_RON] > 0.5, "RUMBLE")
  ? ( par[PM_RON] = 1 - par[PM_RON]; tt_undo(); ) : 0;   // P25 (A1); P26: rmbTgl
nv = hslider(42, 752, 472, 132, 14, par[PM_MRMB]*0.001, 0, 1, ctlDef(PM_MRMB)*0.001);
par[PM_MRMB] = mPm(nv, par[PM_MRMB]);
par[PM_RON] > 0.5 ? colAcid(1) : colInk(0.35);
sprintf(#vstr, "%d%%", floor(par[PM_MRMB]*0.1 + 0.5));
xrawF(826, 448, 58, 16, #vstr);
par[PM_RON] > 0.5 ? 0 : ( tth_tn(0.05, 0.055, 0.05, 0.62); xrect(748, 468, 140, 22); );
tipAt(826, 446, 58, 20, "RUMBLE level readout in percent|Drag the fader below to change it");   // 0.9.3: Tooltip-Luecke der %-Anzeige
tipAt(752, 446, 70, 18, "RUMBLE on/off: mutes the rumble output|Engine and AUTO GAIN keep running|Not part of presets");
tipAt(752, 468, 132, 22, "RUMBLE: engine level, 0-100%|After AUTO GAIN in the chain|CTRL+click: reset");

// P25 (A7): Trennlinie erst unter den Fadern.
colDim(1); xline(752, 500, 884, 500);

// OUT + CEILING (IDs 21/22)
nv = knob2(21, 790, 548, 14, par[PM_MOUT], 0, 1000, ctlDef(PM_MOUT));
nvw = floor(nv + 0.5);
nvw != par[PM_MOUT] ? ( par[PM_MOUT] = nvw; ) : 0;
gfx_setfont(5); colInk(0.85); xctrF(756, 519, 68, 12, 68, 24, "OUT");
ov = -12 + 24*par[PM_MOUT]*0.001;
ov >= 0 ? sprintf(#vstr, "+%.1f DB", ov) : sprintf(#vstr, "%.1f DB", ov);
colAcid(1); xctrF(756, 565, 68, 12, 68, 24, #vstr);
tipAt(766, 522, 48, 52, "OUT: final level, -12 to +12 dB|Bipolar - middle is unity gain|CTRL+click: reset");

nv = knob2(22, 850, 548, 14, par[PM_MCEI], 0, 1000, ctlDef(PM_MCEI));
nvw = floor(nv + 0.5);
nvw != par[PM_MCEI] ? ( par[PM_MCEI] = nvw; ) : 0;
colInk(0.85); xctrF(816, 519, 68, 12, 68, 24, "CEILING");
sprintf(#vstr, "%.1f DB", -12 + 12*par[PM_MCEI]*0.001);
colAcid(1); xctrF(816, 565, 68, 12, 68, 24, #vstr);
tipAt(826, 522, 48, 52, "CEILING: clipper roof, -12 to 0 dBFS|Only active when CLIPPER is on|CTRL+click: reset");

// AUTO GAIN / CLIPPER + AG-Anzeige + CLIP-LED
gfx_setfont(5);
// P26: rmbTgl statt toggle (Schriftstufen).
rmbTgl(752, 590, 132, 18, par[PM_MAUT] > 0.5, "AUTO GAIN")
  ? ( par[PM_MAUT] = 1 - par[PM_MAUT]; ) : 0;
rmbTgl(752, 614, 132, 18, par[PM_MCLP] > 0.5, "CLIPPER")
  ? ( par[PM_MCLP] = 1 - par[PM_MCLP]; ) : 0;
tipAt(752, 590, 132, 18, "AUTO GAIN: holds the rumble ~6 dB under the kick|Feed-forward, freezes on breaks");
tipAt(752, 614, 132, 18, "CLIPPER: soft clip at the CEILING|Lights the CLIP LED on hits");
// P26 (Schriftstufen): vor der CLIP-LED halten.
colInk(0.75);
sprintf(#vstr, "AG %d%%", floor(eng[EC_AGV]*100 + 0.5));
xrawF(752, 638, 60, 16, #vstr);
clpOn ? colWarn(0.95) : gfx_set(tth_alR*0.14, tth_alG*0.17094, tth_alB*0.24931, 1);   // aus = dunkle Zweitfarbe (ACID: 0.14, 0.12, 0.09)
xcirc(830, 646, 4, 1);
colInk(0.9); xstrF(840, 638, 44, 16, "CLIP");
tipAt(752, 636, 132, 18, "AG: current auto gain value|CLIP LED: signal exceeded the ceiling (100 ms latch)");

// ===================================================================== Footer
colDim(1); xline(0, 664, UI_W, 664);
// P26 (Schriftstufen): rechts (Version) zuerst messen, der linke Text bekommt den Rest bis 10 Einheiten davor -
// bei grossen Stufen lief er in die Versionsangabe.
gfx_setfont(5);
sprintf(#vstr, "TT-RUMBLER %s // TIM TECHLOR", #tt_ver);   // P25 (Punkt 6): #tt_ver statt APP_VER
rmbFit(#vstr, 400, 24);
gfx_measurestr(#vstr, fw, fh);
colInk(0.6);
gfx_x = OX + 884*SC - fw;
gfx_y = OY + 674*SC;
gfx_drawstr(#vstr);
gfx_setfont(5); colInk(0.55);
xstrF(16, 674, 884 - 10 - fw/SC - 16, 24, "CTRL+CLICK: RESET // SHIFT: FINE-DRAG // R-CLICK: DEFAULT // HOVER: TIPS");

// P25 (A2): Rad-/Rechtsklick-Edit dieses Frames schliessen (Pop, wenn nichts geaendert wurde)
rmbOne ? undoCommit() : 0;

// Tooltip-Panel: letzte Front-Zeichnung, liegt ueber allem
// Review 14.10.2026 (Kit 7, Codex F1, wie Kick): das Panel zeichnet jetzt nach Preset-Leiste und OPTIONS (unten, vor
// tt_modtips), damit die Kopfzeile es nicht ueberdeckt; offene Overlays maskieren die Maus der Front, dann gibt es keinen Text.
// Verweilzeit 0,35 s wie tt_tipflush: Zeitpunkt merken, wenn sich der Text aendert.
strcmp(#tTipTxt, #rmbTipLst) != 0 ? ( strcpy(#rmbTipLst, #tTipTxt); rmbTipT0 = time_precise(); );

// P25 (Punkte 2/3): Ende von @gfx in Sollform. Kopfzeilen-Tooltips (Preset-Leiste je Element, OPTIONS-Knopf)
// liefert das Kit an der rohen Maus; ueber Leiste/Knopf ist mX maskiert, #tTipTxt bleibt dort leer (kein Doppel).
 

// P17: Preset-Leiste (Kopfzeile, Designraster 340/4, 250x17) links neben
// OPTIONS - vor tth_post. Verdrahtung unveraendert, nur das Layout neu.
pbA = tt_pb_post(OX + 340*SC, OY + 4*SC, SC);
pbA == 1 ? ( rmbPbFactory(tt_pb_arg); )
: pbA == 2 ? ( rmbPbLoad(tt_pb_arg); )
: pbA == 3 ? ( rmbPbCapture(); tt_pb_commit(tt_pb_arg, PBK_PSW); )
: pbA == 4 ? ( rmbPbFactory(0); );
tt_pb_track(rmbPbSum());

// P14: OPTIONS-Button + Farbbox (Kopfzeile, Designraster 598/4) - ganz unten
tthC = tth_post(OX + 598*SC, OY + 4*SC, SC);
// P25 (A1): die Farbe ist ein Blob-Wort, kein Slider - tt_undo() meldet die Wahl dem Host (Undo-Punkt im
// naechsten tth_post, sobald die Taste los ist). Stil-Aenderungen der Box (TOOLTIPS, Schriften) meldet das Modul.
tthC >= 0 ? ( par[PG_COLOR] = tthC; tt_undo(); );

// Review 14.10.2026: eigenes Tooltip-Panel nach den Overlays, erst nach 0,35 s Verweilen (siehe oben bei rmbTipLst)
!tth_tipoff && dragId < 0 && strlen(#tTipTxt) > 0 && time_precise() - rmbTipT0 >= 0.35 ? tipDraw() : 0;   // P23: tipDraw prueft tth_tipoff zusaetzlich selbst
tt_modtips(); tt_tipflush(); // 02.10.2026: nach allen Overlays
uikit_end();
// P25 (Punkt 2): uikit_end verwirft unverbrauchtes Rad selbst.
